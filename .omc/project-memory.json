  "build": {
    "buildCommand": "pnpm build",
    "testCommand": "gh pr create \\\n  --repo ellisapotheosis/Project-Nyra \\\n  --head feat/pre-commit-hooks-v2 \\\n  --base main \\\n  --title \"chore: add pre-commit hooks (husky + lint-staged + prettier)\" \\\n  --body \"$(cat <<'EOF'\n## Summary\n\n- Adds Husky v9 pre-commit hook via `prepare` script — auto-installs on `pnpm install`\n- Adds lint-staged to run Prettier on all staged files before commit\n- Adds `.prettierrc` with standard defaults (2-space, semi, trailing comma ES5)\n- Extends existing `.git/hooks/pre-commit` (container name + whitespace checks) to invoke Husky chain\n- Smoke test suite (28 tests, ~350ms) runs on every commit\n\n## Test plan\n\n- [x] `pnpm exec lint-staged` runs cleanly on staged files\n- [x] Full hook chain verified: container check → whitespace → lint-staged → vitest smoke\n- [x] `pnpm run prepare` installs Husky git hooks\n- [x] `.husky/pre-commit` is executable and tracked in version control\n- [x] Branch rebased onto current `main` — lockfile regenerated cleanly\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)\nEOF\n)\" 2>&1",
    "lintCommand": "pnpm lint",
    "devCommand": "pnpm dev",
    "scripts": {
      "dev": "turbo run dev --concurrency=30",
      "build": "turbo run build",
      "lint": "pnpm -r --if-present lint",
      "test": "pnpm exec vitest --config vitest.smoke.config.mjs run",
      "test:all": "pnpm exec vitest --config vitest.config.mjs run",
      "docker:up": "docker compose -f infra/docker-compose.yml up -d",
      "docker:down": "docker compose -f infra/docker-compose.yml down",
      "twenty:setup": "docker compose -f infra/docker-compose.twenty.yml up -d",
      "twenty:down": "docker compose -f infra/docker-compose.twenty.yml down",
      "twenty:dev": "turbo run dev --filter=twenty-crm",
      "admin:dev": "turbo run dev --filter=nyra-admin",
      "all:dev": "turbo run dev --parallel"
    }
  },
