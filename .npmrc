# pnpm Configuration - Performance Optimized
# Last Updated: 2026-01-16

# ===== CORE SETTINGS =====
# Enable strict peer dependencies for consistency
strict-peer-dependencies=false

# Use symlinks for faster installs
symlink=true

# Enable shallow clones for git dependencies
recursive-install=true

# ===== HOISTING STRATEGY =====
# Public hoisting pattern for better compatibility
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*typescript*
public-hoist-pattern[]=@types/*

# Shameful hoist for problematic packages
shamefully-hoist=false

# ===== PERFORMANCE OPTIMIZATIONS =====
# Parallel processing
child-concurrency=8
network-concurrency=16

# Enable side-effects cache for faster installs
side-effects-cache=true
side-effects-cache-readonly=false

# Use hard links when possible
package-import-method=auto

# ===== CACHING =====
# Store directory for better caching
store-dir=~/.pnpm-store

# Enable fetch timeout
fetch-timeout=60000
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# ===== WORKSPACE SETTINGS =====
# Link workspace packages
link-workspace-packages=true

# Prefer workspace packages
prefer-workspace-packages=true

# ===== BUILD OPTIMIZATIONS =====
# Only build dependencies
only-built-dependencies[]='@prisma/client'
only-built-dependencies[]='@prisma/engines'
only-built-dependencies[]='bcrypt'
only-built-dependencies[]='better-sqlite3'
only-built-dependencies[]='esbuild'
only-built-dependencies[]='sharp'

# ===== LOGGING =====
# Reduce noise in CI
loglevel=warn

# ===== NODE SETTINGS =====
# Node linker for compatibility
node-linker=isolated

# Use node version from package.json
use-node-version=20.18.0

# ===== REGISTRY =====
# Registry settings
registry=https://registry.npmjs.org/

# ===== RESOLUTION =====
# Auto install peers
auto-install-peers=true

# Dedupe injected deps
dedupe-injected-deps=true
