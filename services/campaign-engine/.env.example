# Campaign Engine Configuration
NODE_ENV=development
PORT=8020

# Database
DATABASE_URL=postgresql://twenty:twenty@localhost:5432/twenty

# n8n Integration
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
N8N_WEBHOOK_URL=http://localhost:5678/webhook/nyra/dispatch

# Activepieces Integration
ACTIVEPIECES_BASE_URL=http://localhost:8080
ACTIVEPIECES_API_KEY=

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/campaign-engine.log

# Campaign Settings
CAMPAIGN_TIMEZONE=America/Los_Angeles
CAMPAIGN_MAX_RETRIES=3
CAMPAIGN_RETRY_DELAY_MINUTES=30

# Compliance
ENABLE_GUARDRAILS=true
DNC_CHECK_ENABLED=true
CONSENT_REQUIRED=true
