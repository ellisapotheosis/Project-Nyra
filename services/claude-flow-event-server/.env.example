# Claude Flow Event Server Configuration

# WebSocket Server Configuration
EVENT_SERVER_HOST=0.0.0.0
EVENT_SERVER_PORT=3004
EVENT_SERVER_MAX_CONNECTIONS=100
EVENT_SERVER_REPLAY_BUFFER=1000
EVENT_SERVER_HEARTBEAT=30000

# Debugging
DEBUG=false

# Claude Flow Integration
CLAUDE_FLOW_MCP_HOST=localhost
CLAUDE_FLOW_MCP_PORT=8080

# Observability
LOGGING_LEVEL=info
METRICS_ENDPOINT=http://prometheus:9090/metrics