# Server Configuration
NEXUS_ROUTER_PORT=8000
NEXUS_ROUTER_MCP_PORT=4001
NODE_ENV=development
LOG_LEVEL=debug

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3333,http://localhost:3334

# Redis Configuration
# For Docker (shared with Claude Flow): Use redis:6379 with password and DB 0
# REDIS_URL=redis://:your-redis-password@redis:6379/0
# For local development: Use localhost without password
REDIS_URL=redis://localhost:6379

# Model Routing Configuration
MODEL_ROUTING_STRATEGY=cost-optimized
MODEL_ROUTING_PREFER_LOCAL=true
MODEL_ROUTING_FALLBACK_CLOUD=true
MODEL_ROUTING_COST_THRESHOLD=0.10

# Local GPU Workers
# Worker 1: RTX 5090 (48GB VRAM)
WORKER_5090_URL=http://worker-rtx5090.trex-fiordland.ts.net:8000
WORKER_5090_MODELS=Qwen/Qwen2.5-72B-Instruct-AWQ,deepseek-ai/DeepSeek-R1-Distill-Llama-70B,meta-llama/Llama-3.1-70B-Instruct-AWQ

# Worker 2: RTX 3090 (24GB VRAM)
WORKER_3090_URL=http://worker-rtx3090ti.trex-fiordland.ts.net:8001
WORKER_3090_MODELS=meta-llama/Llama-3.1-8B-Instruct,codellama/CodeLlama-34b-Instruct-hf,deepseek-ai/deepseek-coder-33b-instruct

# Worker 3: RTX 3060 (12GB VRAM)
WORKER_3060_URL=http://worker-rtx3060.trex-fiordland.ts.net:11434
WORKER_3060_MODELS=qwen2.5:7b-instruct,phi3:mini,nomic-embed-text

# Cloud Provider: OpenAI Codex
OPENAI_API_KEY=sk-xxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.2-codex
OPENAI_MAX_TOKENS=4096

# Cloud Provider: Gemini 2.5 Pro
GOOGLE_API_KEY=AIzaSyxxxxx
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1
GEMINI_MODEL=gemini-2.5-pro
GEMINI_MAX_TOKENS=8192

# Additional Cloud Provider: Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096

# Cloud Provider: OpenRouter
OPENROUTER_API_KEY=sk-or-xxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-r1

# Monitoring
NEXUS_MONITORING_ENABLED=true
