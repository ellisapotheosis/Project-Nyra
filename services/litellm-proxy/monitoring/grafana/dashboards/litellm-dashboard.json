{
  "dashboard": {
    "title": "LiteLLM Proxy - Cost Optimization Dashboard",
    "tags": ["litellm", "llm", "cost", "monitoring"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Request Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(litellm_requests_total[5m])",
            "legendFormat": "{{model}} - {{provider}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Local vs Cloud Requests",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum(litellm_requests_total{provider='local'})",
            "legendFormat": "Local GPU"
          },
          {
            "expr": "sum(litellm_requests_total{provider='openrouter'})",
            "legendFormat": "OpenRouter"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Response Latency (p95)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(litellm_request_duration_seconds_bucket[5m]))",
            "legendFormat": "{{model}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Token Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(litellm_tokens_total{type='input'}[5m])",
            "legendFormat": "Input - {{model}}"
          },
          {
            "expr": "rate(litellm_tokens_total{type='output'}[5m])",
            "legendFormat": "Output - {{model}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 5,
        "title": "Cost per Hour",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(litellm_cost_total[1h])",
            "legendFormat": "{{tenant}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
      },
      {
        "id": 6,
        "title": "Worker Health",
        "type": "stat",
        "targets": [
          {
            "expr": "litellm_worker_healthy",
            "legendFormat": "{{worker_id}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
      },
      {
        "id": 7,
        "title": "Cache Hit Rate",
        "type": "gauge",
        "targets": [
          {
            "expr": "rate(litellm_cache_hits[5m]) / rate(litellm_cache_total[5m])",
            "legendFormat": "Hit Rate"
          }
        ],
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 24}
      },
      {
        "id": 8,
        "title": "Error Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(litellm_errors_total[5m])",
            "legendFormat": "{{error_type}}"
          }
        ],
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 24}
      },
      {
        "id": 9,
        "title": "Budget Utilization",
        "type": "bargauge",
        "targets": [
          {
            "expr": "(litellm_budget_spent / litellm_budget_max) * 100",
            "legendFormat": "{{tenant}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}
      }
    ],
    "refresh": "10s",
    "schemaVersion": 27,
    "version": 1
  }
}
