# LiteLLM Proxy - Environment Configuration
# Copy this to .env and fill in your values

# ========================================
# LITELLM MASTER KEY (REQUIRED)
# ========================================
LITELLM_MASTER_KEY=sk-your-secure-master-key-here

# ========================================
# GPU WORKER CONFIGURATIONS
# ========================================
# Worker 1: RTX 5090 (48GB VRAM) - Large Models
WORKER_5090_URL=http://gpu-worker-5090:8000/v1
WORKER_5090_API_KEY=sk-worker-5090-key
WORKER_5090_MODELS=llama-3.1-405b,qwen-2.5-72b,deepseek-v3

# Worker 2: RTX 3090 (24GB VRAM) - Medium Models
WORKER_3090_URL=http://gpu-worker-3090:8000/v1
WORKER_3090_API_KEY=sk-worker-3090-key
WORKER_3090_MODELS=llama-3.1-70b,qwen-2.5-32b,mixtral-8x22b

# Worker 3: RTX 3060 (12GB VRAM) - Specialized Models
WORKER_3060_URL=http://gpu-worker-3060:8000/v1
WORKER_3060_API_KEY=sk-worker-3060-key
WORKER_3060_MODELS=llama-3.1-8b,qwen-2.5-7b,deepseek-coder-6.7b

# ========================================
# OPENROUTER CONFIGURATION (FALLBACK)
# ========================================
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ========================================
# ANTHROPIC CONFIGURATION (OPTIONAL)
# ========================================
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ========================================
# DATABASE CONFIGURATION (OPTIONAL)
# ========================================
DATABASE_URL=postgresql://litellm:litellm_secure_password@postgres:5432/litellm
POSTGRES_PASSWORD=litellm_secure_password

# ========================================
# REDIS CONFIGURATION
# ========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================================
# TENANT API KEYS
# ========================================
TENANT_ENGINEERING_KEY=sk-eng-your-key-here
TENANT_RESEARCH_KEY=sk-res-your-key-here
TENANT_PRODUCTION_KEY=sk-prod-your-key-here

# ========================================
# GRAFANA CONFIGURATION
# ========================================
GRAFANA_PASSWORD=admin

# ========================================
# MONITORING & ALERTING
# ========================================
# Slack webhook for alerts (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email alerts (optional)
ALERT_EMAIL_TO=team@project-nyra.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@project-nyra.com
SMTP_PASSWORD=your-smtp-password

# PagerDuty (optional)
PAGERDUTY_INTEGRATION_KEY=your-pagerduty-key

# ========================================
# FEATURE FLAGS
# ========================================
ENABLE_CACHING=true
ENABLE_MONITORING=true
ENABLE_COST_TRACKING=true
ENABLE_AUDIT_LOGGING=true

# ========================================
# DEVELOPMENT/PRODUCTION MODE
# ========================================
NODE_ENV=development
LITELLM_MODE=DEVELOPMENT
