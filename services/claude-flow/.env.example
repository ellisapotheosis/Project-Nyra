# ============================================================================
# Claude Flow Service Environment Configuration
# ============================================================================
# Copy to .env and configure for your environment

# Node Environment
NODE_ENV=production

# ============================================================================
# Port Configuration (3003-3005 for Claude Flow stack)
# ============================================================================
# Dashboard UI
CLAUDE_FLOW_DASHBOARD_PORT=3003

# Event Server WebSocket
EVENT_SERVER_WS_PORT=3004

# Event Server HTTP
EVENT_SERVER_HTTP_PORT=3005

# Brain MCP Server
CLAUDE_FLOW_MCP_PORT=8080

# Brain Metrics/Dashboard
CLAUDE_FLOW_METRICS_PORT=3333

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_PASSWORD=your-redis-password

# ============================================================================
# RuVector Configuration
# ============================================================================
RUVECTOR_POSTGRES_USER=claude
RUVECTOR_POSTGRES_PASSWORD=your-ruvector-password
RUVECTOR_POSTGRES_DB=claude_flow

# ============================================================================
# API Keys (Optional)
# ============================================================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ============================================================================
# Feature Flags
# ============================================================================
CLAUDE_FLOW_ENABLE_REASONING_BANK=true
CLAUDE_FLOW_ENABLE_AGENT_DB=true
CLAUDE_FLOW_ENABLE_RUVECTOR=true

# ============================================================================
# Dashboard Configuration
# ============================================================================
VITE_CLAUDE_FLOW_URL=http://localhost:8080
VITE_EVENT_SERVER_URL=ws://localhost:3004
VITE_EVENT_SERVER_HTTP_URL=http://localhost:3005

VITE_ENABLE_AGENT_MONITOR=true
VITE_ENABLE_TASK_TIMELINE=true
VITE_ENABLE_MEMORY_OPS=true
VITE_ENABLE_TOPOLOGY=true
VITE_ENABLE_METRICS=true

# WebSocket Performance
VITE_WEBSOCKET_RECONNECT_INTERVAL=3000
VITE_MAX_BUFFER_SIZE=10000

# Event Server
EVENT_SERVER_MAX_CONNECTIONS=100
EVENT_SERVER_REPLAY_BUFFER=1000
EVENT_SERVER_HEARTBEAT=30000
