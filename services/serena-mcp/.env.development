# Serena MCP - Codebase Analysis
NODE_ENV=development
PORT=8086
SERVICE_NAME=serena-mcp

# Anthropic Configuration
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# MCP Gateway
MCP_GATEWAY_URL=http://localhost:4001
REGISTER_WITH_GATEWAY=true

# Orchestrator Integration
CLAUDE_FLOW_URL=http://localhost:9000
ARCHON_OS_URL=http://localhost:9001

# Nexus Router
NEXUS_ROUTER_URL=http://localhost:8000

# Redis
REDIS_URL=redis://localhost:6379

# Codebase Analysis
WORKSPACE_ROOT=/workspace
ENABLE_AST_ANALYSIS=true
ENABLE_DEPENDENCY_GRAPH=true
ENABLE_SECURITY_SCAN=true

# Vector Database for Code Search
QDRANT_URL=http://localhost:6333
VECTOR_COLLECTION=codebase-embeddings

LOG_LEVEL=debug
