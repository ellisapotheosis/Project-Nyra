// Prisma Schema for Mortgage Assistant Application

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  LOAN_OFFICER
  CLIENT
}

enum LoanStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CLOSED
}

enum LoanType {
  CONVENTIONAL
  FHA
  VA
  USDA
  JUMBO
  REFINANCE
}

enum DocumentType {
  ID_PROOF
  INCOME_PROOF
  TAX_RETURN
  BANK_STATEMENT
  CREDIT_REPORT
  PROPERTY_APPRAISAL
  EMPLOYMENT_VERIFICATION
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  EMAIL
  SMS
  PUSH
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  role          UserRole @default(CLIENT)
  isActive      Boolean  @default(true)
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  clients              Client[]           @relation("UserClients")
  assignedLoans        Loan[]             @relation("LoanOfficerLoans")
  createdTasks         Task[]             @relation("CreatedTasks")
  assignedTasks        Task[]             @relation("AssignedTasks")
  appointments         Appointment[]
  sentNotifications    Notification[]     @relation("SentNotifications")
  receivedNotifications Notification[]    @relation("ReceivedNotifications")
  refreshTokens        RefreshToken[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model Client {
  id              String   @id @default(uuid())
  userId          String
  dateOfBirth     DateTime?
  ssn             String?  // Encrypted
  employmentStatus String?
  annualIncome    Decimal? @db.Decimal(12, 2)
  creditScore     Int?
  address         String?
  city            String?
  state           String?
  zipCode         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user         User           @relation("UserClients", fields: [userId], references: [id], onDelete: Cascade)
  loans        Loan[]
  documents    Document[]
  appointments Appointment[]

  @@index([userId])
  @@map("clients")
}

model Loan {
  id                String     @id @default(uuid())
  clientId          String
  loanOfficerId     String?
  loanType          LoanType
  status            LoanStatus @default(DRAFT)
  requestedAmount   Decimal    @db.Decimal(12, 2)
  approvedAmount    Decimal?   @db.Decimal(12, 2)
  interestRate      Decimal?   @db.Decimal(5, 3)
  termMonths        Int?
  propertyAddress   String?
  propertyValue     Decimal?   @db.Decimal(12, 2)
  downPayment       Decimal?   @db.Decimal(12, 2)
  submittedAt       DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?
  notes             String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Relations
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  loanOfficer  User?      @relation("LoanOfficerLoans", fields: [loanOfficerId], references: [id])
  documents    Document[]
  tasks        Task[]

  @@index([clientId])
  @@index([loanOfficerId])
  @@index([status])
  @@map("loans")
}

model Document {
  id           String       @id @default(uuid())
  clientId     String
  loanId       String?
  documentType DocumentType
  fileName     String
  filePath     String
  fileSize     Int
  mimeType     String
  description  String?
  uploadedBy   String
  isVerified   Boolean      @default(false)
  verifiedAt   DateTime?
  verifiedBy   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  loan   Loan?  @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([loanId])
  @@index([documentType])
  @@map("documents")
}

model Appointment {
  id          String            @id @default(uuid())
  clientId    String
  userId      String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  location    String?
  meetingLink String?
  status      AppointmentStatus @default(SCHEDULED)
  reminderSent Boolean          @default(false)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([clientId])
  @@index([userId])
  @@index([startTime])
  @@index([status])
  @@map("appointments")
}

model Task {
  id          String       @id @default(uuid())
  loanId      String?
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  createdById String
  assignedToId String?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  loan       Loan?  @relation(fields: [loanId], references: [id], onDelete: Cascade)
  createdBy  User   @relation("CreatedTasks", fields: [createdById], references: [id])
  assignedTo User?  @relation("AssignedTasks", fields: [assignedToId], references: [id])

  @@index([loanId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@map("tasks")
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  fromId    String?
  toId      String
  subject   String
  message   String
  isSent    Boolean          @default(false)
  isRead    Boolean          @default(false)
  sentAt    DateTime?
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Relations
  from User? @relation("SentNotifications", fields: [fromId], references: [id])
  to   User  @relation("ReceivedNotifications", fields: [toId], references: [id], onDelete: Cascade)

  @@index([toId])
  @@index([fromId])
  @@index([isSent])
  @@index([isRead])
  @@map("notifications")
}
