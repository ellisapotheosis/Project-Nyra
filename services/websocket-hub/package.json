    "uuid": "^14.0.0",
    "pino": "^8.16.2",
    "pino-pretty": "^13.1.3",
    "dotenv": "^16.3.1",
    "helmet": "^8.1.0",
    "cors": "^2.8.5",
    "zod": "^4.3.6",
    "eventemitter3": "^5.0.1",
    "rate-limiter-flexible": "^4.0.1",
    "prom-client": "^15.1.0"
