{
  "name": "@project-nyra/websocket-hub",
  "version": "1.0.0",
  "description": "Real-time WebSocket server for Project Nyra - Dashboard updates, MCP status, and agent coordination",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:product-events": "tsx src/events/productEvents.test.ts",
    "lint": "eslint src",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "websocket",
    "real-time",
    "mcp",
    "dashboard",
    "agent-coordination"
  ],
  "author": "Project Nyra",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.16.0",
    "express": "^5.2.1",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^14.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "dotenv": "^17.4.2",
    "helmet": "^8.1.0",
    "cors": "^2.8.5",
    "zod": "^4.4.3",
    "eventemitter3": "^5.0.1",
    "rate-limiter-flexible": "^4.0.1",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/uuid": "^9.0.7",
    "typescript": "^6.0.3",
    "tsx": "^4.22.4",
    "eslint": "^10.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^8.60.1",
    "jest": "^30.4.2",
    "@types/jest": "^30.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
