  "devDependencies": {
    "@types/ws": "^8.5.10",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.2",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "eslint": "^10.2.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.58.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11"
