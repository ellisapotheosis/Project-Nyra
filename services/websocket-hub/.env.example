# Server Configuration
NODE_ENV=development
PORT=8080
METRICS_PORT=9090

# Security
JWT_SECRET=your-jwt-secret-here-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Redis Configuration (for scaling)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# Rate Limiting
RATE_LIMIT_POINTS=10
RATE_LIMIT_DURATION=60

# Nexus Router Integration
NEXUS_ROUTER_URL=http://localhost:3100
NEXUS_ROUTER_API_KEY=

# Product event ingress for lead/quote/campaign/pipeline services.
# Required in production for POST /events.
EVENT_INGEST_API_KEY=

# Session Configuration
SESSION_TIMEOUT=3600
MAX_CONNECTIONS_PER_USER=5

# Logging
LOG_LEVEL=info

# Health Check
HEALTH_CHECK_INTERVAL=30000
