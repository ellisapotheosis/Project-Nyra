  "description": "TwentyCRM Integration Service with bidirectional sync, conflict resolution, and health monitoring",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "dev": "ts-node src/index.ts"
  },
  "keywords": [
