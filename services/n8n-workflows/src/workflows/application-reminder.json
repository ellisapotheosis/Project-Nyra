{
  "name": "Application Reminder Workflow",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 12
            }
          ]
        }
      },
      "name": "Schedule Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300],
      "id": "schedule-trigger"
    },
    {
      "parameters": {
        "url": "={{$env.API_BASE_URL}}/api/applications/incomplete",
        "method": "GET",
        "options": {}
      },
      "name": "Fetch Incomplete Applications",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [450, 300],
      "id": "fetch-incomplete"
    },
    {
      "parameters": {
        "functionCode": "const applications = items[0].json.applications;\nconst now = new Date();\n\nconst categorized = applications.map(app => {\n  const started = new Date(app.startedAt);\n  const hoursSinceStart = Math.floor((now - started) / (1000 * 60 * 60));\n  const lastActivity = new Date(app.lastActivityAt);\n  const hoursSinceActivity = Math.floor((now - lastActivity) / (1000 * 60 * 60));\n  \n  let reminderType = null;\n  let priority = 'low';\n  \n  if (hoursSinceActivity >= 72) {\n    reminderType = 'abandoned';\n    priority = 'high';\n  } else if (hoursSinceActivity >= 48) {\n    reminderType = 'followup';\n    priority = 'high';\n  } else if (hoursSinceActivity >= 24) {\n    reminderType = 'gentle';\n    priority = 'medium';\n  } else if (hoursSinceStart >= 6 && hoursSinceActivity >= 6) {\n    reminderType = 'initial';\n    priority = 'low';\n  }\n  \n  return {\n    json: {\n      ...app,\n      hoursSinceStart,\n      hoursSinceActivity,\n      reminderType,\n      priority,\n      completionPercentage: app.completedSteps / app.totalSteps * 100\n    }\n  };\n});\n\nreturn categorized.filter(app => app.json.reminderType !== null);"
      },
      "name": "Analyze Application Status",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [650, 300],
      "id": "analyze-status"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.reminderType}}",
              "operation": "equal",
              "value2": "initial"
            }
          ]
        }
      },
      "name": "Initial Reminder",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [850, 150],
      "id": "initial-reminder"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.reminderType}}",
              "operation": "equal",
              "value2": "gentle"
            }
          ]
        }
      },
      "name": "Gentle Reminder",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [850, 300],
      "id": "gentle-reminder"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.reminderType}}",
              "operation": "equal",
              "value2": "followup"
            }
          ]
        }
      },
      "name": "Follow-Up Reminder",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [850, 450],
      "id": "followup-reminder"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.reminderType}}",
              "operation": "equal",
              "value2": "abandoned"
            }
          ]
        }
      },
      "name": "Abandoned Application",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [850, 600],
      "id": "abandoned-reminder"
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "sendGridApi",
        "fromEmail": "mortgages@company.com",
        "toEmail": "={{$json.email}}",
        "subject": "Quick Reminder: Complete Your Mortgage Application",
        "emailType": "html",
        "message": "<h1>Hi {{$json.firstName}},</h1><p>We noticed you started your mortgage application. Great start! 🎉</p><p><strong>Your progress:</strong> {{$json.completionPercentage}}% complete</p><p>Next step: {{$json.nextStep}}</p><p>It only takes {{$json.estimatedMinutes}} minutes to finish.</p><p><a href='{{$json.applicationUrl}}'>Continue Application</a></p><p>Need help? Call us at (555) 123-4567</p>"
      },
      "name": "Send Initial Email",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "position": [1050, 150],
      "id": "send-initial"
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "sendGridApi",
        "fromEmail": "mortgages@company.com",
        "toEmail": "={{$json.email}}",
        "subject": "Don't Lose Your Progress! {{$json.completionPercentage}}% Done",
        "emailType": "html",
        "message": "<h1>{{$json.firstName}}, You're Almost There! 💪</h1><p>Your mortgage application is {{$json.completionPercentage}}% complete.</p><h3>What's left:</h3><ul>{{$json.remainingSteps}}</ul><p>Finishing your application keeps your place in line and locks in current rates.</p><p><a href='{{$json.applicationUrl}}'>Finish Now ({{$json.estimatedMinutes}} min)</a></p>"
      },
      "name": "Send Gentle Email",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "position": [1050, 300],
      "id": "send-gentle"
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "sendGridApi",
        "fromEmail": "mortgages@company.com",
        "toEmail": "={{$json.email}}",
        "subject": "We're Here to Help! Questions About Your Application?",
        "emailType": "html",
        "message": "<h1>{{$json.firstName}}, Need Assistance? 🤝</h1><p>We noticed your application has been on hold for a couple days. Is something blocking your progress?</p><h3>Common concerns we can help with:</h3><ul><li>Document questions</li><li>Credit score concerns</li><li>Down payment options</li><li>Income verification</li></ul><p><strong>Let's talk:</strong></p><ul><li><a href='{{$json.calendarUrl}}'>Schedule a call</a></li><li>Call: (555) 123-4567</li><li>Text: (555) 123-4567</li></ul><p><a href='{{$json.applicationUrl}}'>Or continue your application</a></p>"
      },
      "name": "Send Follow-Up Email",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "position": [1050, 450],
      "id": "send-followup"
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "sendGridApi",
        "fromEmail": "mortgages@company.com",
        "toEmail": "={{$json.email}}",
        "subject": "Last Chance: Your Application Will Expire Soon",
        "emailType": "html",
        "message": "<h1>{{$json.firstName}}, Don't Miss Out! ⚠️</h1><p>Your mortgage application will expire in <strong>{{$json.daysUntilExpiration}} days</strong>.</p><p>You've already completed {{$json.completionPercentage}}% - don't lose your progress!</p><h3>What happens if it expires:</h3><ul><li>❌ You'll need to restart from scratch</li><li>❌ Current rate locks will be lost</li><li>❌ Application fees may apply</li></ul><p><strong>Take 10 minutes to finish now:</strong></p><p><a href='{{$json.applicationUrl}}'>Complete Application</a></p><p>Or contact your loan officer:<br>{{$json.loanOfficer}}<br>(555) 123-4567</p>"
      },
      "name": "Send Urgency Email",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "position": [1050, 600],
      "id": "send-urgency"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.smsOptIn}}",
              "value2": true
            }
          ],
          "string": [
            {
              "value1": "={{$json.priority}}",
              "operation": "equal",
              "value2": "high"
            }
          ]
        }
      },
      "name": "Should Send SMS",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1250, 525],
      "id": "should-send-sms"
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "twilioApi",
        "fromPhoneNumber": "+15551234567",
        "toPhoneNumber": "={{$json.phoneNumber}}",
        "message": "Hi {{$json.firstName}}! Your mortgage application is {{$json.completionPercentage}}% done. Finish in {{$json.estimatedMinutes}} min: {{$json.applicationUrl}} Questions? Call (555) 123-4567"
      },
      "name": "Send SMS Reminder",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [1450, 525],
      "id": "send-sms"
    },
    {
      "parameters": {
        "url": "={{$env.API_BASE_URL}}/api/applications/{{$json.applicationId}}/reminder",
        "method": "POST",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={{ JSON.stringify({ reminderType: $json.reminderType, timestamp: new Date().toISOString(), channel: 'email' }) }}"
      },
      "name": "Log Reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [1250, 300],
      "id": "log-reminder"
    }
  ],
  "connections": {
    "Schedule Check": {
      "main": [[{ "node": "Fetch Incomplete Applications", "type": "main", "index": 0 }]]
    },
    "Fetch Incomplete Applications": {
      "main": [[{ "node": "Analyze Application Status", "type": "main", "index": 0 }]]
    },
    "Analyze Application Status": {
      "main": [
        [
          { "node": "Initial Reminder", "type": "main", "index": 0 },
          { "node": "Gentle Reminder", "type": "main", "index": 0 },
          { "node": "Follow-Up Reminder", "type": "main", "index": 0 },
          { "node": "Abandoned Application", "type": "main", "index": 0 }
        ]
      ]
    },
    "Initial Reminder": {
      "main": [[{ "node": "Send Initial Email", "type": "main", "index": 0 }]]
    },
    "Gentle Reminder": {
      "main": [[{ "node": "Send Gentle Email", "type": "main", "index": 0 }]]
    },
    "Follow-Up Reminder": {
      "main": [[{ "node": "Send Follow-Up Email", "type": "main", "index": 0 }]]
    },
    "Abandoned Application": {
      "main": [[{ "node": "Send Urgency Email", "type": "main", "index": 0 }]]
    },
    "Send Initial Email": {
      "main": [[{ "node": "Log Reminder", "type": "main", "index": 0 }]]
    },
    "Send Gentle Email": {
      "main": [[{ "node": "Log Reminder", "type": "main", "index": 0 }]]
    },
    "Send Follow-Up Email": {
      "main": [
        [
          { "node": "Log Reminder", "type": "main", "index": 0 },
          { "node": "Should Send SMS", "type": "main", "index": 0 }
        ]
      ]
    },
    "Send Urgency Email": {
      "main": [
        [
          { "node": "Log Reminder", "type": "main", "index": 0 },
          { "node": "Should Send SMS", "type": "main", "index": 0 }
        ]
      ]
    },
    "Should Send SMS": {
      "main": [[{ "node": "Send SMS Reminder", "type": "main", "index": 0 }]]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["mortgage", "application", "reminder", "abandoned-cart"]
}
