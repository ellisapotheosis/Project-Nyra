{
  "name": "WF_CAMPAIGN_EXECUTE",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger_campaign_execute",
      "name": "Execute Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "resource": "campaign",
        "operation": "get",
        "id": "={{ $json.campaignId }}"
      },
      "id": "get_campaign_steps",
      "name": "Get Campaign Steps",
      "type": "n8n-nodes-twenty.twenty",
      "typeVersion": 1,
      "position": [300, 300],
      "credentials": {
        "twentyApi": {
          "id": "twenty-api-id",
          "name": "Twenty CRM"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "={{ JSON.parse($json.steps) }}",
        "options": {}
      },
      "id": "split_steps",
      "name": "Split Steps",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 1,
      "position": [500, 300]
    }
,
    {
      "parameters": {
        "jsCode": "const step = $input.first().json;\nconst leadId = $node[\"Execute Trigger\"].json.leadId;\n\n// Logic to calculate delay based on step.day and step.offsetMinutes\nlet delayMinutes = 0;\nif (step.day === 0) {\n  delayMinutes = step.offsetMinutes || 0;\n} else {\n  // For simplicity in this mock, we calculate minutes until next scheduled day/time\n  // In real n8n, we might use a Wait node with a specific date\n  delayMinutes = step.day * 1440; \n}\n\nreturn { json: { ...step, leadId, delayMinutes } };"
      },
      "id": "calculate_delay",
      "name": "Calculate Delay",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [700, 300]
    },
    {
      "parameters": {
        "amount": "={{ $json.delayMinutes }}",
        "unit": "minutes"
      },
      "id": "wait_for_step",
      "name": "Wait for Step",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "resource": "mortgageLead",
        "operation": "get",
        "id": "={{ $json.leadId }}"
      },
      "id": "check_lead_status",
      "name": "Check Lead Status",
      "type": "n8n-nodes-twenty.twenty",
      "typeVersion": 1,
      "position": [1100, 300],
      "credentials": {
        "twentyApi": {
          "id": "twenty-api-id",
          "name": "Twenty CRM"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.campaignStatus }}",
              "value2": "ACTIVE"
            }
          ]
        }
      },
      "id": "is_active",
      "name": "Is Still Active?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1300, 300]
    },
    {
      "parameters": {
        "jsCode": "// Time-of-day restriction check (8 AM - 9 PM)\nconst now = new Date();\nconst hour = now.getHours();\nconst isAllowed = hour >= 8 && hour < 21;\n\nreturn { json: { isAllowed, currentHour: hour } };"
      },
      "id": "check_time_restriction",
      "name": "Check Time Restriction",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [1500, 200]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.isAllowed }}",
              "value2": true
            }
          ]
        }
      },
      "id": "time_allowed",
      "name": "Time Allowed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1700, 200]
    },
    {
      "parameters": {
        "amount": 1,\n        "unit": "hours"
      },
      "id": "wait_for_morning",
      "name": "Wait for Morning",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [1900, 100]
    },
    {
      "parameters": {
        "jsCode": "const step = $node[\"Calculate Delay\"].json;\nreturn { json: { channel: step.channel } };"
      },
      "id": "get_channel",
      "name": "Get Channel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [2100, 300]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.channel }}",
        "rules": {
          "rules": [
            {
              "operation": "equal",
              "value2": "sms"
            },
            {
              "operation": "equal",
              "value2": "email"
            },
            {
              "operation": "equal",
              "value2": "voice"
            }
          ]
        }
      },
      "id": "switch_channel",
      "name": "Switch Channel",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [2300, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "from": "+1234567890",
        "to": "={{ $('Check Lead Status').json.person.phoneNumber }}",
        "message": "={{ $node[\"Calculate Delay\"].json.templateId }}"
      },
      "id": "twilio_sms",
      "name": "Twilio SMS",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [2550, 200]
    },
    {
      "parameters": {
        "fromEmail": "mortgage@ratehunter.net",
        "toEmail": "={{ $('Check Lead Status').json.person.email }}",
        "subject": "Mortgage Update",
        "html": "={{ $node[\"Calculate Delay\"].json.templateId }}"
      },
      "id": "sendgrid_email",
      "name": "SendGrid Email",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "position": [2550, 350]
    },
    {
      "parameters": {
        "resource": "call",
        "operation": "create",
        "from": "+1234567890",
        "to": "={{ $('Check Lead Status').json.person.phoneNumber }}",
        "url": "http://twimlets.com/holdmusic?Bucket=com.twilio.music.classical"
      },
      "id": "twilio_voice",
      "name": "Twilio Voice",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [2550, 500]
    },
    {
      "parameters": {
        "resource": "activity",
        "operation": "create",
        "additionalFields": {
          "leadId": "={{ $('Check Lead Status').json.id }}",
          "type": "={{ $node[\"Calculate Delay\"].json.channel }}",
          "description": "Executed campaign step: {{ $node[\"Calculate Delay\"].json.templateId }}"
        }
      },
      "id": "log_activity",
      "name": "Log Activity",
      "type": "n8n-nodes-twenty.twenty",
      "typeVersion": 1,
      "position": [2800, 300],
      "credentials": {
        "twentyApi": {
          "id": "twenty-api-id",
          "name": "Twenty CRM"
        }
      }
    }
  ],
  "connections": {
    "Execute Trigger": {
      "main": [
        [
          {
            "node": "Get Campaign Steps",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Campaign Steps": {
      "main": [
        [
          {
            "node": "Split Steps",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Steps": {
      "main": [
        [
          {
            "node": "Calculate Delay",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calculate Delay": {
      "main": [
        [
          {
            "node": "Wait for Step",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for Step": {
      "main": [
        [
          {
            "node": "Check Lead Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Lead Status": {
      "main": [
        [
          {
            "node": "Is Still Active?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Still Active?": {
      "main": [
        [
          {
            "node": "Check Time Restriction",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Time Restriction": {
      "main": [
        [
          {
            "node": "Time Allowed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Time Allowed?": {
      "main": [
        [
          {
            "node": "Get Channel",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait for Morning",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for Morning": {
      "main": [
        [
          {
            "node": "Get Channel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Channel": {
      "main": [
        [
          {
            "node": "Switch Channel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Switch Channel": {
      "main": [
        [
          {
            "node": "Twilio SMS",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "SendGrid Email",
            "type": "main",
            "index": 1
          }
        ],
        [
          {
            "node": "Twilio Voice",
            "type": "main",
            "index": 2
          }
        ]
      ]
    },
    "Twilio SMS": {
      "main": [
        [
          {
            "node": "Log Activity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SendGrid Email": {
      "main": [
        [
          {
            "node": "Log Activity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Twilio Voice": {
      "main": [
        [
          {
            "node": "Log Activity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
