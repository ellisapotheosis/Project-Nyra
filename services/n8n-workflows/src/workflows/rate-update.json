{
  "name": "Rate Update Notification Workflow",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "name": "Hourly Rate Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300],
      "id": "schedule-trigger"
    },
    {
      "parameters": {
        "url": "={{$env.API_BASE_URL}}/api/rates/current",
        "method": "GET",
        "options": {}
      },
      "name": "Fetch Current Rates",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [450, 300],
      "id": "fetch-rates"
    },
    {
      "parameters": {
        "url": "={{$env.API_BASE_URL}}/api/rates/previous",
        "method": "GET",
        "options": {}
      },
      "name": "Fetch Previous Rates",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [450, 450],
      "id": "fetch-previous"
    },
    {
      "parameters": {
        "functionCode": "const current = items[0].json;\nconst previous = items[1].json;\n\nconst rates = {\n  rate30yr: {\n    current: current.rate30yr,\n    previous: previous.rate30yr,\n    change: current.rate30yr - previous.rate30yr,\n    changePercent: ((current.rate30yr - previous.rate30yr) / previous.rate30yr * 100).toFixed(2)\n  },\n  rate15yr: {\n    current: current.rate15yr,\n    previous: previous.rate15yr,\n    change: current.rate15yr - previous.rate15yr,\n    changePercent: ((current.rate15yr - previous.rate15yr) / previous.rate15yr * 100).toFixed(2)\n  },\n  rateARM: {\n    current: current.rateARM,\n    previous: previous.rateARM,\n    change: current.rateARM - previous.rateARM,\n    changePercent: ((current.rateARM - previous.rateARM) / previous.rateARM * 100).toFixed(2)\n  }\n};\n\nconst significantChange = Math.abs(rates.rate30yr.change) >= 0.125; // 1/8 point\nconst direction = rates.rate30yr.change < 0 ? 'dropped' : 'increased';\n\nreturn [{\n  json: {\n    rates,\n    significantChange,\n    direction,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "name": "Calculate Rate Changes",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [650, 375],
      "id": "calculate-changes"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.significantChange}}",
              "value2": true
            }
          ]
        }
      },
      "name": "Significant Change",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [850, 375],
      "id": "significant-check"
    },
    {
      "parameters": {
        "url": "={{$env.API_BASE_URL}}/api/leads/subscribed-to-rates",
        "method": "GET",
        "options": {}
      },
      "name": "Fetch Rate Subscribers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [1050, 375],
      "id": "fetch-subscribers"
    },
    {
      "parameters": {
        "functionCode": "const subscribers = items[1].json.subscribers;\nconst rateData = items[0].json;\n\nreturn subscribers.map(sub => ({\n  json: {\n    ...sub,\n    ...rateData,\n    monthlyPaymentChange: calculatePaymentChange(sub.loanAmount, rateData.rates.rate30yr.previous, rateData.rates.rate30yr.current)\n  }\n}));\n\nfunction calculatePaymentChange(loanAmount, oldRate, newRate) {\n  const n = 360; // 30 years\n  const oldMonthlyRate = oldRate / 100 / 12;\n  const newMonthlyRate = newRate / 100 / 12;\n  \n  const oldPayment = loanAmount * (oldMonthlyRate * Math.pow(1 + oldMonthlyRate, n)) / (Math.pow(1 + oldMonthlyRate, n) - 1);\n  const newPayment = loanAmount * (newMonthlyRate * Math.pow(1 + newMonthlyRate, n)) / (Math.pow(1 + newMonthlyRate, n) - 1);\n  \n  return (newPayment - oldPayment).toFixed(2);\n}"
      },
      "name": "Personalize for Subscribers",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1250, 375],
      "id": "personalize"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.direction}}",
              "operation": "equal",
              "value2": "dropped"
            }
          ]
        }
      },
      "name": "Rate Dropped",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [1450, 275],
      "id": "rate-dropped"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.direction}}",
              "operation": "equal",
              "value2": "increased"
            }
          ]
        }
      },
      "name": "Rate Increased",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [1450, 475],
      "id": "rate-increased"
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "sendGridApi",
        "fromEmail": "mortgages@company.com",
        "toEmail": "={{$json.email}}",
        "subject": "🎉 Great News! Mortgage Rates Just Dropped",
        "emailType": "html",
        "message": "<h1>{{$json.firstName}}, Rates Just Dropped! 📉</h1><p>This could save you money on your mortgage!</p><h2>Updated Rates:</h2><table style='width:100%; border-collapse: collapse;'><tr style='background-color: #f0f0f0;'><th style='padding: 10px; text-align: left;'>Loan Type</th><th style='padding: 10px;'>Previous Rate</th><th style='padding: 10px;'>New Rate</th><th style='padding: 10px;'>Change</th></tr><tr><td style='padding: 10px;'><strong>30-Year Fixed</strong></td><td style='padding: 10px; text-align: center;'>{{$json.rates.rate30yr.previous}}%</td><td style='padding: 10px; text-align: center; color: green;'><strong>{{$json.rates.rate30yr.current}}%</strong></td><td style='padding: 10px; text-align: center; color: green;'>{{$json.rates.rate30yr.change}}%</td></tr><tr style='background-color: #f9f9f9;'><td style='padding: 10px;'><strong>15-Year Fixed</strong></td><td style='padding: 10px; text-align: center;'>{{$json.rates.rate15yr.previous}}%</td><td style='padding: 10px; text-align: center; color: green;'><strong>{{$json.rates.rate15yr.current}}%</strong></td><td style='padding: 10px; text-align: center; color: green;'>{{$json.rates.rate15yr.change}}%</td></tr><tr><td style='padding: 10px;'><strong>5/1 ARM</strong></td><td style='padding: 10px; text-align: center;'>{{$json.rates.rateARM.previous}}%</td><td style='padding: 10px; text-align: center; color: green;'><strong>{{$json.rates.rateARM.current}}%</strong></td><td style='padding: 10px; text-align: center; color: green;'>{{$json.rates.rateARM.change}}%</td></tr></table>{{#if loanAmount}}<h3>Your Potential Savings:</h3><p>Based on your loan amount of <strong>${{$json.loanAmount}}</strong>:</p><p>Monthly payment change: <strong style='color: green;'>${{$json.monthlyPaymentChange}}/month</strong></p><p>That's <strong>${{multiply $json.monthlyPaymentChange 360}}</strong> over the life of your loan!</p>{{/if}}<p><a href='{{$json.portalUrl}}/rates' style='background-color: #28a745; color: white; padding: 12px 24px; text-decoration: none; border-radius: 4px; display: inline-block;'>Lock In This Rate</a></p><p><small>Rates are subject to change. Lock your rate to secure this offer.</small></p>"
      },
      "name": "Send Rate Drop Email",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "position": [1650, 275],
      "id": "send-drop-email"
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "sendGridApi",
        "fromEmail": "mortgages@company.com",
        "toEmail": "={{$json.email}}",
        "subject": "⚠️ Mortgage Rate Alert: Rates Increased",
        "emailType": "html",
        "message": "<h1>Rate Update: {{$json.firstName}} 📊</h1><p>Mortgage rates have increased. If you're considering a mortgage, now might be the time to act.</p><h2>Updated Rates:</h2><table style='width:100%; border-collapse: collapse;'><tr style='background-color: #f0f0f0;'><th style='padding: 10px; text-align: left;'>Loan Type</th><th style='padding: 10px;'>Previous Rate</th><th style='padding: 10px;'>New Rate</th><th style='padding: 10px;'>Change</th></tr><tr><td style='padding: 10px;'><strong>30-Year Fixed</strong></td><td style='padding: 10px; text-align: center;'>{{$json.rates.rate30yr.previous}}%</td><td style='padding: 10px; text-align: center; color: red;'><strong>{{$json.rates.rate30yr.current}}%</strong></td><td style='padding: 10px; text-align: center; color: red;'>+{{$json.rates.rate30yr.change}}%</td></tr><tr style='background-color: #f9f9f9;'><td style='padding: 10px;'><strong>15-Year Fixed</strong></td><td style='padding: 10px; text-align: center;'>{{$json.rates.rate15yr.previous}}%</td><td style='padding: 10px; text-align: center; color: red;'><strong>{{$json.rates.rate15yr.current}}%</strong></td><td style='padding: 10px; text-align: center; color: red;'>+{{$json.rates.rate15yr.change}}%</td></tr></table><h3>What This Means:</h3><ul><li>Starting your application now locks in current rates</li><li>Pre-approval protects you from further increases</li><li>Rates may continue to rise</li></ul><p><a href='{{$json.portalUrl}}/apply' style='background-color: #dc3545; color: white; padding: 12px 24px; text-decoration: none; border-radius: 4px; display: inline-block;'>Start Application Now</a></p>"
      },
      "name": "Send Rate Increase Email",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "position": [1650, 475],
      "id": "send-increase-email"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.smsOptIn}}",
              "value2": true
            }
          ],
          "string": [
            {
              "value1": "={{$json.direction}}",
              "operation": "equal",
              "value2": "dropped"
            }
          ]
        }
      },
      "name": "Send SMS for Drop",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1850, 275],
      "id": "sms-drop-check"
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "twilioApi",
        "fromPhoneNumber": "+15551234567",
        "toPhoneNumber": "={{$json.phoneNumber}}",
        "message": "🎉 Rate Alert! 30-yr mortgage rates dropped to {{$json.rates.rate30yr.current}}%. You could save ${{$json.monthlyPaymentChange}}/mo. Lock it in: {{$json.portalUrl}}"
      },
      "name": "Send Rate Drop SMS",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [2050, 275],
      "id": "send-drop-sms"
    },
    {
      "parameters": {
        "url": "={{$env.API_BASE_URL}}/api/rates/notification-log",
        "method": "POST",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={{ JSON.stringify({ timestamp: $json.timestamp, direction: $json.direction, rate30yr: $json.rates.rate30yr.current, subscribersNotified: items.length }) }}"
      },
      "name": "Log Rate Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [1850, 600],
      "id": "log-notification"
    }
  ],
  "connections": {
    "Hourly Rate Check": {
      "main": [
        [
          { "node": "Fetch Current Rates", "type": "main", "index": 0 },
          { "node": "Fetch Previous Rates", "type": "main", "index": 0 }
        ]
      ]
    },
    "Fetch Current Rates": {
      "main": [[{ "node": "Calculate Rate Changes", "type": "main", "index": 0 }]]
    },
    "Fetch Previous Rates": {
      "main": [[{ "node": "Calculate Rate Changes", "type": "main", "index": 1 }]]
    },
    "Calculate Rate Changes": {
      "main": [[{ "node": "Significant Change", "type": "main", "index": 0 }]]
    },
    "Significant Change": {
      "main": [[{ "node": "Fetch Rate Subscribers", "type": "main", "index": 0 }]]
    },
    "Fetch Rate Subscribers": {
      "main": [[{ "node": "Personalize for Subscribers", "type": "main", "index": 0 }]]
    },
    "Personalize for Subscribers": {
      "main": [
        [
          { "node": "Rate Dropped", "type": "main", "index": 0 },
          { "node": "Rate Increased", "type": "main", "index": 0 }
        ]
      ]
    },
    "Rate Dropped": {
      "main": [[{ "node": "Send Rate Drop Email", "type": "main", "index": 0 }]]
    },
    "Rate Increased": {
      "main": [[{ "node": "Send Rate Increase Email", "type": "main", "index": 0 }]]
    },
    "Send Rate Drop Email": {
      "main": [
        [
          { "node": "Send SMS for Drop", "type": "main", "index": 0 },
          { "node": "Log Rate Notification", "type": "main", "index": 0 }
        ]
      ]
    },
    "Send Rate Increase Email": {
      "main": [[{ "node": "Log Rate Notification", "type": "main", "index": 0 }]]
    },
    "Send SMS for Drop": {
      "main": [[{ "node": "Send Rate Drop SMS", "type": "main", "index": 0 }]]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["mortgage", "rates", "notification", "market-alert"]
}
