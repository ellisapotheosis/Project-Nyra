{
  "name": "@nyra/graphiti-knowledge",
  "version": "1.0.0",
  "description": "Temporal Knowledge Graph System with Graphiti and FalkorDB",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "docker:build": "docker build -t graphiti-knowledge .",
    "docker:run": "docker-compose up"
  },
  "keywords": [
    "knowledge-graph",
    "temporal",
    "graphiti",
    "falkordb",
    "entity-extraction",
    "nlp"
  ],
  "dependencies": {
    "express": "^4.18.2",
    "falkordb": "^6.4.1",
    "compromise": "^14.10.0",
    "natural": "^6.10.0",
    "node-nlp": "^4.27.0",
    "uuid": "^9.0.1",
    "date-fns": "^4.1.0",
    "winston": "^3.11.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0",
    "redis": "^4.6.11",
    "cytoscape": "^3.28.1",
    "d3": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "supertest": "^6.3.3"
  }
}
