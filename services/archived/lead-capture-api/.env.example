# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lead_capture_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=24h
API_KEY_HEADER=X-API-Key

# TwentyCRM Integration
TWENTY_CRM_API_URL=https://api.twentycrm.com/v1
TWENTY_CRM_API_KEY=your-twenty-crm-api-key
TWENTY_CRM_WORKSPACE_ID=your-workspace-id
TWENTY_CRM_SYNC_ENABLED=true
TWENTY_CRM_SYNC_INTERVAL=300000

# Lead Scoring Configuration
SCORING_ENABLED=true
SCORING_MIN_SCORE=0
SCORING_MAX_SCORE=100

# Lead Assignment
ASSIGNMENT_STRATEGY=round-robin
ASSIGNMENT_ENABLED=true

# Webhooks
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY=5000
WEBHOOK_TIMEOUT=30000

# Lead Enrichment
ENRICHMENT_ENABLED=true
ENRICHMENT_PROVIDER=clearbit
CLEARBIT_API_KEY=your-clearbit-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log
