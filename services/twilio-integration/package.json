{
  "name": "@nyra/twilio-integration",
  "version": "1.0.0",
  "description": "Twilio Voice/SMS Integration Service for Project Nyra",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["twilio", "sms", "voice", "ivr", "telephony"],
  "author": "Project Nyra",
  "license": "MIT",
  "dependencies": {
    "twilio": "^4.20.0",
    "express": "^5.2.1",
    "express-validator": "^7.0.1",
    "dotenv": "^16.3.1",
    "mongoose": "^9.7.1",
    "joi": "^18.2.1",
    "winston": "^3.11.0",
    "morgan": "^1.11.0",
    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "compression": "^1.7.4",
    "rate-limiter-flexible": "^11.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.2",
    "@types/jest": "^29.5.11",
    "@types/morgan": "^1.9.9",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "typescript": "^5.3.3",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.2.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.58.2"
  }
}
