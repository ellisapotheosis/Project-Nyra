# Soft-pull credit service local development configuration.
# Do not commit real provider credentials.

PORT=4025
NODE_ENV=development

# Provider selection: MOCK, CERTIFIED_CREDIT, EQUIFAX, OTHER_APPROVED.
SOFT_PULL_CREDIT_PROVIDER=MOCK

CERTIFIED_CREDIT_API_BASE_URL=
CERTIFIED_CREDIT_CLIENT_ID=
CERTIFIED_CREDIT_CLIENT_SECRET=
CERTIFIED_CREDIT_WEBHOOK_SECRET=

EQUIFAX_API_BASE_URL=
EQUIFAX_CLIENT_ID=
EQUIFAX_CLIENT_SECRET=
EQUIFAX_WEBHOOK_SECRET=

SOFT_PULL_CREDIT_SIGNING_KEY=
