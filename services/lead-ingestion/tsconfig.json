{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest"],
    "baseUrl": ".",
    "paths": {
      "@nyra/domain-models": ["../../packages/domain-models/src/index.ts"],
      "@nyra/integration-adapters": ["../../packages/integration-adapters/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "../../packages/domain-models/src/**/*.ts",
    "../../packages/integration-adapters/src/**/*.ts"
  ],
  "exclude": ["dist", "node_modules", "../../packages/integration-adapters/src/mock-server.ts"]
}
