// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id            String   @id @default(uuid())
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  email         String   @unique
  phone         String?
  loanAmount    Decimal  @map("loan_amount") @db.Decimal(12, 2)
  propertyValue Decimal  @map("property_value") @db.Decimal(12, 2)
  creditScore   String   @map("credit_score")
  propertyType  String   @map("property_type")
  loanType      String   @map("loan_type")
  zipCode       String   @map("zip_code")

  // Additional fields
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  source        String?  @default("website")
  status        String   @default("new")
  notes         String?

  // Timestamps
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  quotes        Quote[]

  @@index([email])
  @@index([createdAt])
  @@index([status])
  @@map("leads")
}

model Quote {
  id              String   @id @default(uuid())
  leadId          String   @map("lead_id")

  // Quote details
  interestRate    Decimal  @map("interest_rate") @db.Decimal(5, 3)
  loanTerm        Int      @map("loan_term")
  loanAmount      Decimal  @map("loan_amount") @db.Decimal(12, 2)
  monthlyPayment  Decimal  @map("monthly_payment") @db.Decimal(10, 2)
  totalInterest   Decimal  @map("total_interest") @db.Decimal(12, 2)
  totalPayment    Decimal  @map("total_payment") @db.Decimal(12, 2)
  apr             Decimal  @db.Decimal(5, 3)

  // Additional costs
  downPayment     Decimal? @map("down_payment") @db.Decimal(12, 2)
  closingCosts    Decimal? @map("closing_costs") @db.Decimal(10, 2)
  propertyTax     Decimal? @map("property_tax") @db.Decimal(10, 2)
  homeInsurance   Decimal? @map("home_insurance") @db.Decimal(10, 2)
  pmi             Decimal? @db.Decimal(10, 2)

  // Metadata
  loanType        String   @map("loan_type")
  creditScore     String   @map("credit_score")
  propertyType    String   @map("property_type")
  zipCode         String   @map("zip_code")

  // Status
  status          String   @default("active")
  expiresAt       DateTime @map("expires_at")

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([status])
  @@index([createdAt])
  @@map("quotes")
}

model RateHistory {
  id            String   @id @default(uuid())

  // Rate information
  loanType      String   @map("loan_type")
  loanTerm      Int      @map("loan_term")
  interestRate  Decimal  @map("interest_rate") @db.Decimal(5, 3)
  apr           Decimal  @db.Decimal(5, 3)

  // Market data
  creditScore   String   @map("credit_score")
  zipCode       String?  @map("zip_code")

  // Metadata
  source        String   @default("internal")
  effectiveDate DateTime @default(now()) @map("effective_date")

  // Timestamps
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([loanType, loanTerm])
  @@index([effectiveDate])
  @@map("rate_history")
}

model EmailLog {
  id          String   @id @default(uuid())

  // Email details
  recipient   String
  subject     String
  template    String
  status      String   @default("pending")

  // Error handling
  error       String?
  retryCount  Int      @default(0) @map("retry_count")

  // Relations
  leadId      String?  @map("lead_id")

  // Timestamps
  sentAt      DateTime? @map("sent_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([recipient])
  @@index([status])
  @@index([createdAt])
  @@map("email_logs")
}
