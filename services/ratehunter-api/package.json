{
  "name": "ratehunter-api",
  "version": "1.0.0",
  "description": "RateHunter Landing Page API - Mortgage Rate Quotes & Lead Capture",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config jest.e2e.config.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mortgage",
    "rates",
    "api",
    "express",
    "typescript"
  ],
  "author": "RateHunter Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "express": "^5.2.1",
    "express-validator": "^7.0.1",
    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.4.1",
    "redis": "^5.11.0",
    "nodemailer": "^9.0.3",
    "joi": "^18.2.1",
    "winston": "^3.11.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^8.3.2",
    "swagger-ui-express": "^5.0.0",
    "swagger-jsdoc": "^6.2.8"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/express": "^5.0.6",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/nodemailer": "^8.0.0",
    "@types/compression": "^1.7.5",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/jest": "^29.5.11",
    "@types/supertest": "^6.0.2",
    "typescript": "^7.0.2",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.4",
    "prisma": "^6.4.0",
    "eslint": "^10.2.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.58.2",
    "prettier": "^3.9.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
