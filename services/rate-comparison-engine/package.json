{
  "name": "mortgage-rate-comparison-engine",
  "version": "1.0.0",
  "description": "Comprehensive mortgage rate comparison engine with scraping, caching, and alerts",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:integration": "jest tests/integration",
    "migrate": "node migrations/run-migrations.js",
    "lint": "eslint src/**/*.js",
    "scraper:start": "node src/services/scraper/ScraperScheduler.js"
  },
  "keywords": ["mortgage", "rates", "comparison", "scraper", "api"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.11.3",
    "redis": "^5.11.0",
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "node-cron": "^3.0.3",
    "joi": "^17.11.0",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "bull": "^4.12.0",
    "helmet": "^8.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.1.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "nodemon": "^3.0.2",
    "eslint": "^10.0.3",
    "@types/jest": "^29.5.11"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
