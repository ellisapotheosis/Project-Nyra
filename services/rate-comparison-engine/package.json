    "rates",
    "comparison",
    "scraper",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "1.17.0",
    "bull": "^4.12.0",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "joi": "^18.2.1",
    "node-cron": "^3.0.3",
    "pg": "^8.20.0",
    "redis": "^5.11.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "eslint": "^10.2.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
