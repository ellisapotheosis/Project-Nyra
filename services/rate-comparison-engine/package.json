{
  "name": "mortgage-rate-comparison-engine",
  "version": "1.0.0",
  "description": "Comprehensive mortgage rate comparison engine with scraping, caching, and alerts",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:integration": "jest tests/integration",
    "migrate": "node migrations/run-migrations.js",
    "lint": "eslint src/**/*.js",
    "scraper:start": "node src/services/scraper/ScraperScheduler.js"
  },
  "keywords": [
