{
  "plugins": {
    "slots": {
      "memory": "openclaw-mem0"
    },
    "entries": {
      "openclaw-mem0": {
        "enabled": true,
        "config": {
          "mode": "open-source",
          "userId": "nyra",
          "autoRecall": true,
          "autoCapture": true,
          "enableGraph": true,
          "topK": 5,
          "searchThreshold": 0.3,
          "oss": {
            "embedder": {
              "provider": "openai",
              "config": {
                "model": "text-embedding-3-small",
                "api_key": "${OPENAI_API_KEY}",
                "base_url": "${OPENAI_BASE_URL:-https://api.openai.com/v1}"
              }
            },
            "vectorStore": {
              "provider": "memory",
              "config": { "dimension": 1536 }
            },
            "graphStore": {
              "provider": "falkordb",
              "config": {
                "host": "${FALKORDB_HOST:-falkordb}",
                "port": ${FALKORDB_PORT:-6379},
                "graphName": "mem0"
              }
            },
            "llm": {
              "provider": "openai",
              "config": {
                "model": "gpt-4o-mini",
                "api_key": "${OPENAI_API_KEY}",
                "base_url": "${OPENAI_BASE_URL:-https://api.openai.com/v1}"
              }
            }
          }
        }
      },
      "openclaw-open-webui-channels": {
        "enabled": true,
        "config": {
          "baseUrl": "http://open-webui:8080",
          "botEmail": "${OPEN_WEBUI_BOT_EMAIL}",
          "botPassword": "${OPEN_WEBUI_BOT_PASSWORD}"
        }
      }
    }
  }
}
