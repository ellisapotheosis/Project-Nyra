{
  "gateway": {
    "mode": "local"
  },
  "plugins": {
    "slots": {
      "memory": "openclaw-mem0"
    },
    "entries": {
      "openclaw-mem0": {
        "enabled": ${OPENCLAW_MEM0_ENABLED},
        "config": {
          "mode": "open-source",
          "userId": "nyra",
          "autoRecall": true,
          "autoCapture": true,
          "enableGraph": true,
          "topK": 5,
          "searchThreshold": 0.3,
          "oss": {
            "embedder": {
              "provider": "openai",
              "config": {
                "model": "${OPENCLAW_MEM0_EMBEDDING_MODEL}",
                "api_key": "${OPENAI_API_KEY}",
                "base_url": "${OPENAI_BASE_URL}"
              }
            },
            "vectorStore": {
              "provider": "memory",
              "config": { "dimension": 1536 }
            },
            "graphStore": {
              "provider": "falkordb",
              "config": {
                "host": "${FALKORDB_HOST}",
                "port": ${FALKORDB_PORT},
                "graphName": "mem0"
              }
            },
            "llm": {
              "provider": "openai",
              "config": {
                "model": "${OPENCLAW_MEM0_LLM_MODEL}",
                "api_key": "${OPENAI_API_KEY}",
                "base_url": "${OPENAI_BASE_URL}"
              }
            }
          }
        }
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "${OPENCLAW_AGENT_MODEL}"
      },
      "models": {
        "${OPENCLAW_AGENT_MODEL}": {}
      }
    }
  },
  "models": {
    "providers": {
      "litellm": {
        "api": "openai-completions",
        "baseUrl": "${OPENAI_BASE_URL}",
        "apiKey": "${OPENAI_API_KEY}",
        "models": [
          {
            "id": "local/qwen-coder-32b",
            "name": "local/qwen-coder-32b",
            "contextTokens": 32768
          },
          {
            "id": "local/gemma-4",
            "name": "local/gemma-4",
            "contextTokens": 32768
          }
        ]
      }
    }
  }
}
