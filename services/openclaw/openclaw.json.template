{
  "gateway": {
    "mode": "local"
  },
  "plugins": {
    "allow": ["openclaw-mem0"],
    "slots": {
      "memory": "${OPENCLAW_MEMORY_SLOT}"
    },
    "entries": {
      "openclaw-mem0": {
        "enabled": true,
        "hooks": {
          "allowConversationAccess": true
        },
        "config": {
          "mode": "open-source",
          "userId": "nyra",
          "autoRecall": true,
          "autoCapture": true,
          "enableGraph": true,
          "topK": 5,
          "searchThreshold": 0.3,
          "oss": {
            "embedder": {
              "provider": "openai",
              "config": {
                "model": "${MEM0_EMBEDDER_MODEL:-nomic-embed-text}",
                "api_key": "${MEM0_EMBEDDER_API_KEY:-not-needed}",
                "base_url": "${MEM0_EMBEDDER_BASE_URL:-http://100.64.0.12:11435/v1}"
              }
            },
            "vectorStore": {
              "provider": "memory",
              "config": { "dimension": 768 }
            },
            "graphStore": {
              "provider": "falkordb",
              "config": {
                "host": "${FALKORDB_HOST}",
                "port": ${FALKORDB_PORT},
                "graphName": "mem0"
              }
            },
            "llm": {
              "provider": "openai",
              "config": {
                "model": "${MEM0_LLM_MODEL:-llama3.2:3b}",
                "api_key": "${MEM0_LLM_API_KEY:-not-needed}",
                "base_url": "${MEM0_LLM_BASE_URL:-http://100.64.0.12:11435/v1}"
              }
            }
          }
        }
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "${OPENCLAW_AGENT_MODEL}"
      },
      "models": {
        "${OPENCLAW_AGENT_MODEL}": {}
      }
    }
  },
  "models": {
    "providers": {
      "litellm": {
        "api": "openai-completions",
        "baseUrl": "${OPENAI_BASE_URL}",
        "apiKey": "${OPENAI_API_KEY}",
        "models": [
          {
            "id": "local/qwen-coder-32b",
            "name": "local/qwen-coder-32b",
            "contextTokens": 131072
          },
          {
            "id": "local/gemma-4",
            "name": "local/gemma-4",
            "contextTokens": 131072
          }
        ]
      }
    }
  }
}
