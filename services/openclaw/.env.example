# OpenClaw + Mem0 integration for Webapp assistant
NODE_ENV=production
OPENCLAW_PORT=8099
OPENCLAW_PUBLIC_URL=https://assistant.ratehunter.net
OPENCLAW_LOG_LEVEL=info

# Core integrations
OPENCLAW_WEBAPP_ORIGIN=https://app.ratehunter.net
OPENCLAW_WEBHOOKS_URL=https://api.ratehunter.net/webhooks
OPENCLAW_QUOTE_API_URL=https://api.ratehunter.net/quote
OPENCLAW_ACTIVEPIECES_URL=http://activepieces:80
OPENCLAW_N8N_URL=http://n8n:5678

# LLM routing
OPENAI_API_KEY=REPLACE_ME_OPENAI_API_KEY
ANTHROPIC_API_KEY=REPLACE_ME_ANTHROPIC_API_KEY
OPENROUTER_API_KEY=REPLACE_ME_OPENROUTER_API_KEY
NEXUS_ROUTER_URL=http://nexus-router:7000

# Mem0 memory settings
MEM0_ENABLED=true
MEM0_BASE_URL=http://mem0-rest:8000
MEM0_API_KEY=REPLACE_ME_MEM0_API_KEY
MEM0_ORG_ID=REPLACE_ME_MEM0_ORG_ID
MEM0_PROJECT_ID=REPLACE_ME_MEM0_PROJECT_ID
MEM0_VECTOR_STORE=qdrant
MEM0_QDRANT_URL=http://qdrant:6333
MEM0_QDRANT_API_KEY=REPLACE_ME_MEM0_QDRANT_API_KEY

# Persistence + state
POSTGRES_URL=postgresql://nyra:REPLACE_ME_DB_PASS@postgres:5432/nyra
REDIS_URL=redis://:REPLACE_ME_REDIS_PASSWORD@redis:6379
SESSION_SECRET=REPLACE_ME_OPENCLAW_SESSION_SECRET
