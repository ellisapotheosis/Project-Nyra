{
  "name": "@nyra/ruvector-search",
  "version": "1.0.0",
  "description": "Distributed vector search service with Qdrant integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src tests --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["vector-search", "embeddings", "qdrant", "semantic-search", "hybrid-search"],
  "author": "Nyra Team",
  "license": "MIT",
  "dependencies": {
    "@qdrant/js-client-rest": "^1.9.0",
    "axios": "^1.6.2",
    "express": "^5.2.1",
    "openai": "^4.20.1",
    "cohere-ai": "^7.7.0",
    "@xenova/transformers": "^2.9.0",
    "bull": "^4.12.0",
    "redis": "^5.11.0",
    "zod": "^3.22.4",
    "pino": "^8.16.2",
    "pino-pretty": "^13.1.3",
    "dotenv": "^16.3.1",
    "lru-cache": "^11.3.0",
    "p-queue": "^9.1.0",
    "compression": "^1.7.4",
    "helmet": "^8.1.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.10.4",
    "@types/jest": "^29.5.10",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/bull": "^4.10.0",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
