{
  "server": {
    "port": 3001,
    "host": "0.0.0.0",
    "cors": {
      "enabled": true,
      "origins": ["*"]
    }
  },
  "qdrant": {
    "url": "http://localhost:6333",
    "apiKey": null,
    "timeout": 30000,
    "retries": 3,
    "poolSize": 10
  },
  "redis": {
    "host": "localhost",
    "port": 6379,
    "db": 0,
    "maxRetriesPerRequest": 3
  },
  "embedding": {
    "defaultProvider": "openai",
    "providers": {
      "openai": {
        "model": "text-embedding-3-small",
        "dimensions": 1536,
        "maxTokens": 8191,
        "batchSize": 100
      },
      "cohere": {
        "model": "embed-english-v3.0",
        "dimensions": 1024,
        "batchSize": 96
      },
      "local": {
        "model": "Xenova/all-MiniLM-L6-v2",
        "dimensions": 384,
        "batchSize": 32
      }
    }
  },
  "search": {
    "defaultLimit": 10,
    "maxLimit": 100,
    "hybridAlpha": 0.7,
    "cacheEnabled": true,
    "cacheTTL": 300
  },
  "batch": {
    "enabled": true,
    "concurrency": 5,
    "maxRetries": 3,
    "retryDelay": 1000
  },
  "analytics": {
    "enabled": true,
    "metricsInterval": 60000,
    "retentionDays": 30
  },
  "performance": {
    "enableCaching": true,
    "cacheSize": 1000,
    "enableCompression": true,
    "enableParallelProcessing": true,
    "maxParallelRequests": 10
  }
}
