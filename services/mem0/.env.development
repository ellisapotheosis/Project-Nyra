# Mem0 - User Personalization & Memory
NODE_ENV=development
PORT=8080
SERVICE_NAME=mem0

# Database
POSTGRES_URL=postgresql://nyra_user:nyra_secure_password@localhost:5432/nyra_db
REDIS_URL=redis://localhost:6379

# Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=user-memories

# AI Provider (via Nexus Router)
NEXUS_ROUTER_URL=http://localhost:8000
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}

# MCP Gateway
MCP_GATEWAY_URL=http://localhost:4001
REGISTER_WITH_GATEWAY=true

# Orchestrators
CLAUDE_FLOW_URL=http://localhost:9000
ARCHON_OS_URL=http://localhost:9001

# Memory Configuration
MEMORY_RETENTION_DAYS=365
ENABLE_CONVERSATION_CONTEXT=true
ENABLE_USER_PREFERENCES=true
MAX_CONTEXT_LENGTH=100000

# Personalization
ENABLE_LEARNING=true
ENABLE_PATTERN_RECOGNITION=true

LOG_LEVEL=debug
