{
  "name": "@nyra/letta-integration",
  "version": "1.0.0",
  "description": "Letta Agent Memory System integration for Project Nyra",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "jest --testPathPattern=tests/e2e",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "start:sync": "node dist/sync/service.js",
    "start:analytics": "node dist/analytics/server.js"
  },
  "keywords": [
    "letta",
    "memory",
    "agent",
    "ai",
    "learning"
  ],
  "author": "Project Nyra",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.16.0",
    "ws": "^8.16.0",
    "express": "^5.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "pg": "^8.21.0",
    "redis": "^6.0.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3",
    "winston": "^3.11.0",
    "bullmq": "^5.77.7",
    "ioredis": "^5.3.2",
    "date-fns": "^4.1.0",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/express": "^5.0.6",
    "@types/cors": "^2.8.17",
    "@types/ws": "^8.5.10",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^9.0.7",
    "@types/lodash": "^4.14.202",
    "@types/jest": "^29.5.11",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^10.2.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
