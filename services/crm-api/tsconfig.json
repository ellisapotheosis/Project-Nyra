{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "../..",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": [
    "src",
    "../../packages/domain-models/src/**/*.ts",
    "../../packages/crm-client/src/**/*.ts",
    "../../packages/integration-adapters/src/**/*.ts"
  ],
  "exclude": ["../../packages/integration-adapters/src/mock-server.ts"],
  "references": [
    { "path": "../../packages/crm-client" }
  ]
}
