{
  "name": "nyra-crm-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "REST API and webhook layer for Nyra’s TwentyCRM operations",
  "main": "dist/services/crm-api/src/server.js",
  "scripts": {
    "build": "tsc --build",
    "start": "node dist/services/crm-api/src/server.js",
    "dev": "ts-node-esm src/server.ts",
    "clean": "rm -rf dist",
    "test": "vitest run --config vitest.config.mjs"
  },
  "dependencies": {
    "@nyra/crm-client": "workspace:*",
    "@nyra/crm-types": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.5.4",
    "express": "^4.20.4",
    "express-rate-limit": "^8.3.2",
    "helmet": "^7.0.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.14.0",
    "winston": "^3.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.21",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/winston": "^2.4.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.4",
    "vitest": "4.1.0"
  }
}
