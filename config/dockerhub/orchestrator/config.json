{
  "environment": "orchestrator",
  "pcId": "orchestrator",
  "dockerhub": {
    "namespace": "projectnyra",
    "defaultVisibility": "public",
    "autoTagLatest": true
  },
  "repositories": {
    "backend": "nyra-backend",
    "frontend": "nyra-frontend",
    "worker": "nyra-worker",
    "orchestrator": "nyra-orchestrator",
    "mcp-servers": "nyra-mcp-servers"
  },
  "webhooks": {
    "enabled": true,
    "endpoints": {
      "ci": "https://ci.projectnyra.com/webhook/dockerhub",
      "slack": "https://hooks.slack.com/services/YOUR_WEBHOOK_URL"
    }
  },
  "buildAutomation": {
    "enabled": true,
    "branches": ["main", "develop"],
    "buildOnPush": true
  }
}
