{
  "contextFileName": [
    "AGENTS.md",
    "LLXPRT.md",
    "CONTEXT.md",
    "INSTRUCTIONS.md"
  ],
  "checkpointing": {
    "enabled": true
  },
  "lsp": true,
  "subagents": {
    "asyncEnabled": true,
    "maxAsync": 6
  },
  "summarizeToolOutput": {
    "run_shell_command": {
      "tokenBudget": 2000
    }
  },
  "excludedProjectEnvVars": ["DEBUG", "DEBUG_MODE", "NODE_ENV"],
  "fileFiltering": {
    "respectGitIgnore": true
  },
  "mcpServers": {
    "nyra-nexus": {
      "httpUrl": "https://nexus.trex-fiordland.ts.net/mcp",
      "description": "Project Nyra singular MCP endpoint: memory, Git/Gitea, Composio, browser, UI, and infra tools.",
      "timeout": 30000,
      "trust": true
    },
    "shadcn": {
      "command": "npx",
      "args": ["-y", "shadcn@canary", "mcp"],
      "env": {
        "REGISTRY_URL": "https://tweakcn.com/r/themes/registry.json"
      }
    }
  },
  "includeDirectories": ["."],
  "loadMemoryFromIncludeDirectories": true
}
