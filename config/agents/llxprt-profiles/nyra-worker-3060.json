{
  "version": 1,
  "provider": "openai",
  "model": "local-3060",
  "ephemeralSettings": {
    "auth-key-name": "nyra-worker",
    "base-url": "http://worker-rtx3060.trex-fiordland.ts.net:11434/v1",
