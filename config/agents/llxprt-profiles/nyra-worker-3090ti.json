{
  "version": 1,
  "provider": "openai",
  "model": "local-3090ti",
  "ephemeralSettings": {
    "auth-key-name": "nyra-worker",
    "base-url": "http://worker-rtx3090ti.trex-fiordland.ts.net:8000/v1",
    "context-limit": 96000,
    "compression-threshold": 0.74,
    "tool-output-max-items": 35,
    "tool-output-max-tokens": 30000,
    "tool-output-truncate-mode": "warn",
    "shell-default-timeout-seconds": 150,
    "shell-max-timeout-seconds": 900
  }
}
