# Project Nyra LLxprt/Wave/Letta environment contract.
# Do not put real secrets in this file. Store values in Infisical and keyrings.

# Infisical runtime used by Makefile docker-context compose launches.
INFISICAL_PROJECT_ID=8374cea9-e5e8-4050-bda4-b91f25ab30ef
AGENT_INFRA_ENV=prod
NYRA_INFISICAL_PATH=/machines/orchestrator

# Tailscale MagicDNS endpoints. Keep cross-node traffic on *.ts.net.
NYRA_ORCHESTRATOR_HOST=orchestrator.trex-fiordland.ts.net
NYRA_ORACLE_HOST=oracle-vps.trex-fiordland.ts.net
NYRA_WORKER_5090_HOST=worker-rtx5090.trex-fiordland.ts.net
NYRA_WORKER_3090TI_HOST=worker-rtx3090ti.trex-fiordland.ts.net
NYRA_WORKER_3060_HOST=worker-rtx3060.trex-fiordland.ts.net

# Router/orchestrator endpoints.
NYRA_NEXUS_BASE_URL=https://nexus.trex-fiordland.ts.net/v1
NYRA_NEXUS_MCP_URL=https://nexus.trex-fiordland.ts.net/mcp
NYRA_LITELLM_BASE_URL=http://orchestrator.trex-fiordland.ts.net:4000/v1
NYRA_OPENCLAW_GATEWAY_URL=http://orchestrator.trex-fiordland.ts.net:5678

# Letta memory-manager/orchestrator endpoints.
NYRA_LETTA_BASE_URL=http://oracle-vps.trex-fiordland.ts.net:8283
NYRA_LETTA_MCP_URL=http://oracle-vps.trex-fiordland.ts.net:8284/mcp

# Local LLxprt bridge. Letta/Nexus/LiteLLM consume this as an OpenAI-compatible
# upstream when subscription-powered CLI capacity is needed.
LLXPRT_BRIDGE_HOST=0.0.0.0
LLXPRT_BRIDGE_PORT=8090
LLXPRT_BRIDGE_WORKDIR=/home/ellisapotheosis/repos/project-nyra
LLXPRT_CODEX_PROVIDER=codex
LLXPRT_CODEX_MODEL=gpt-5.3-codex
LLXPRT_DEFAULT_PROFILE=nyra-cli-triad-ha

# LLxprt install/runtime paths.
NYRA_LLXPRT_PACKAGE=@vybestack/llxprt-code
NYRA_LLXPRT_NPM_PREFIX=/home/ellisapotheosis/.cache/nyra-llxprt-code
NYRA_LLXPRT_JEFE_DIR=/home/ellisapotheosis/repos/project-nyra/external/llxprt-jefe
LLXPRT_PROFILE_DIR=/home/ellisapotheosis/.llxprt/profiles
LLXPRT_USER_DIR=/home/ellisapotheosis/.llxprt
LLXPRT_CODE_SYSTEM_DEFAULTS_PATH=
LLXPRT_CODE_SYSTEM_SETTINGS_PATH=

# Cloudflare/Wrangler bridge variables pulled by scripts/llxprt-common.sh.
NYRA_CF_PROJECT_NAME=project-nyra
NYRA_CF_ENVIRONMENT=production
NYRA_CF_COMPATIBILITY_DATE=2026-03-06
CLOUDFLARE_COMPATIBILITY_DATE=2026-03-06
CF_PAGES_COMPATIBILITY_DATE=2026-03-06

# Secret names expected in Infisical and/or Wave secrets/keyrings.
# LLxprt OAuth providers: run these inside llxprt:
# /auth codex enable
# /auth anthropic enable
# /auth gemini enable
# /auth qwen enable
LLXPRT_BRIDGE_API_KEY=
NEXUS_MASTER_KEY=
NYRA_WORKER_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_KEY=
GROQ_API_KEY=
GROQ_KEY=
KIMI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Wave secrets should be set through Wave, not this file:
# wsh secret set LLXPRT_BRIDGE_API_KEY=...
# wsh secret set NEXUS_MASTER_KEY=...
# wsh secret set NYRA_WORKER_API_KEY=...
# wsh secret set OPENROUTER_KEY=...
# wsh secret set GROQ_KEY=...
