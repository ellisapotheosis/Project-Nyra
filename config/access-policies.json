{
  "orchestrator": {
    "description": "Main orchestrator node - full admin access",
    "permissions": [
      "admin",
      "coordination",
      "task-distribution",
      "monitoring",
      "worker-management",
      "health-checks",
      "metrics",
      "tunnels",
      "dns-management"
    ],
    "rateLimit": {
      "type": "api",
      "windowMs": 900000,
      "max": 2000
    },
    "networkAccess": "internal",
    "allowedEndpoints": ["*"],
    "security": {
      "requireHttps": true,
      "allowInsecureLocal": false,
      "sessionTimeout": 3600
    }
  },
  "worker1": {
    "description": "Alienware M15R7 (RTX 3060) - Mid-tier GPU worker",
    "permissions": [
      "compute",
      "health",
      "metrics",
      "task-execution",
      "gpu-status"
    ],
    "rateLimit": {
      "type": "gpu",
      "windowMs": 300000,
      "max": 200
    },
    "networkAccess": "internal",
    "allowedEndpoints": [
      "/api/v1/compute",
      "/health",
      "/metrics",
      "/status",
      "/gpu/info"
    ],
    "gpu": {
      "model": "RTX 3060",
      "vram": "12GB",
      "performance_tier": "mid",
      "max_concurrent_tasks": 4
    },
    "security": {
      "requireHttps": true,
      "allowInsecureLocal": true,
      "sessionTimeout": 1800
    }
  },
  "worker2": {
    "description": "Alienware Area-51 (RTX 5090) - High-performance GPU worker",
    "permissions": [
      "compute",
      "health",
      "metrics",
      "task-execution",
      "gpu-status",
      "high-performance"
    ],
    "rateLimit": {
      "type": "gpu",
      "windowMs": 300000,
      "max": 500
    },
    "networkAccess": "internal",
    "allowedEndpoints": [
      "/api/v1/compute",
      "/health",
      "/metrics",
      "/status",
      "/gpu/info",
      "/gpu/advanced"
    ],
    "gpu": {
      "model": "RTX 5090",
      "vram": "32GB",
      "performance_tier": "high",
      "max_concurrent_tasks": 8
    },
    "security": {
      "requireHttps": true,
      "allowInsecureLocal": true,
      "sessionTimeout": 1800
    }
  },
  "worker3": {
    "description": "Desktop PC (RTX 3090Ti) - High-performance GPU worker",
    "permissions": [
      "compute",
      "health",
      "metrics",
      "task-execution",
      "gpu-status",
      "high-performance"
    ],
    "rateLimit": {
      "type": "gpu",
      "windowMs": 300000,
      "max": 400
    },
    "networkAccess": "internal",
    "allowedEndpoints": [
      "/api/v1/compute",
      "/health",
      "/metrics",
      "/status",
      "/gpu/info",
      "/gpu/advanced"
    ],
    "gpu": {
      "model": "RTX 3090Ti",
      "vram": "24GB",
      "performance_tier": "high",
      "max_concurrent_tasks": 6
    },
    "security": {
      "requireHttps": true,
      "allowInsecureLocal": true,
      "sessionTimeout": 1800
    }
  },
  "external": {
    "description": "External access - limited read-only permissions",
    "permissions": [
      "health",
      "status",
      "public-metrics"
    ],
    "rateLimit": {
      "type": "auth",
      "windowMs": 900000,
      "max": 100
    },
    "networkAccess": "external",
    "allowedEndpoints": [
      "/health",
      "/status",
      "/api/v1/status",
      "/metrics/public"
    ],
    "security": {
      "requireHttps": true,
      "allowInsecureLocal": false,
      "sessionTimeout": 900
    }
  },
  "monitoring": {
    "description": "Monitoring and health check services",
    "permissions": [
      "health",
      "metrics",
      "monitoring",
      "status",
      "alerts"
    ],
    "rateLimit": {
      "type": "api",
      "windowMs": 60000,
      "max": 1000
    },
    "networkAccess": "internal",
    "allowedEndpoints": [
      "/health",
      "/metrics",
      "/status",
      "/api/v1/monitoring",
      "/alerts",
      "/logs"
    ],
    "security": {
      "requireHttps": false,
      "allowInsecureLocal": true,
      "sessionTimeout": 3600
    }
  },
  "load-balancer": {
    "description": "Cloudflare Load Balancer - traffic distribution",
    "permissions": [
      "health",
      "status",
      "routing"
    ],
    "rateLimit": {
      "type": "api",
      "windowMs": 60000,
      "max": 10000
    },
    "networkAccess": "external",
    "allowedEndpoints": [
      "/health",
      "/status",
      "/api/v1/compute"
    ],
    "security": {
      "requireHttps": true,
      "allowInsecureLocal": false,
      "sessionTimeout": 300
    }
  },
  "service-discovery": {
    "description": "Service discovery and registration",
    "permissions": [
      "discovery",
      "registration",
      "health",
      "metrics"
    ],
    "rateLimit": {
      "type": "api",
      "windowMs": 300000,
      "max": 500
    },
    "networkAccess": "internal",
    "allowedEndpoints": [
      "/api/v1/discovery",
      "/api/v1/register",
      "/health",
      "/metrics"
    ],
    "security": {
      "requireHttps": true,
      "allowInsecureLocal": true,
      "sessionTimeout": 7200
    }
  }
}