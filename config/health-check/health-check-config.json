{
  "version": 1,
  "description": "Default Project Nyra infra health inventory. Endpoints are private MagicDNS/Tailscale or localhost-facing service ports from infra/hosts/* compose files.",
  "external_commands": {
    "tailscale_status": true,
    "cloudflared_tunnels": true
  },
  "nodes": [
    {
      "name": "orchestrator",
      "role": "control-plane",
      "host": "orchestrator.trex-fiordland.ts.net",
      "ping": true,
      "gpu": false
    },
    {
      "name": "oracle-vps",
      "role": "cloud-control-services",
      "host": "oracle.trex-fiordland.ts.net",
      "ping": true,
      "gpu": false
    },
    {
      "name": "worker-rtx5090",
      "role": "primary-vllm",
      "host": "worker-rtx5090.trex-fiordland.ts.net",
      "ping": true,
      "gpu": true,
      "ssh": "worker-rtx5090.trex-fiordland.ts.net"
    },
    {
      "name": "worker-rtx3090ti",
      "role": "secondary-vllm",
      "host": "worker-rtx3090ti.trex-fiordland.ts.net",
      "ping": true,
      "gpu": true,
      "ssh": "worker-rtx3090ti.trex-fiordland.ts.net"
    },
    {
      "name": "worker-rtx3060",
      "role": "subscription-api-light-worker",
      "host": "worker-rtx3060.trex-fiordland.ts.net",
      "ping": true,
      "gpu": true,
      "ssh": "worker-rtx3060.trex-fiordland.ts.net"
    }
  ],
  "services": [
    {
      "name": "orchestrator-portainer",
      "host_name": "orchestrator",
      "type": "http",
      "endpoint": "http://orchestrator.trex-fiordland.ts.net:9000/",
      "expected_status": [200, 301, 302, 307, 308],
      "compose": "infra/hosts/orchestrator/docker-compose.yml"
    },
    {
      "name": "orchestrator-status-bridge",
      "host_name": "orchestrator",
      "type": "http",
