{
  "mcpServers": {
    "nexus-router": {
      "type": "sse",
      "url": "http://orchestrator.trex-fiordland.ts.net:6000/mcp/sse"
    },
    "ssh": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-ssh"],
      "env": {
        "SSH_ALLOWED_HOSTS": "*.trex-fiordland.ts.net,100.64.0.*,github.com,gitea.ratehunter.net"
      }
    },
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from", "git+https://github.com/oraios/serena",
        "serena", "start-mcp-server", "--transport", "stdio", "--log-level", "INFO"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "disabledMcpServers": []
}
