{
  "mcpServers": {
    "nexus-router": {
      "type": "sse",
      "url": "http://localhost:6000/mcp/sse"
    },
    "ORCHESTRATOR_SSH": {
      "type": "stdio",
      "command": "/home/ellisapotheosis/.local/mcp-tools/node_modules/.bin/mcp-ssh-server-tool",
      "env": {
        "MCP_SILENT": "true"
      }
    },

    "ORCHESTRATOR_DOCKER": {
      "type": "stdio",
      "command": "/home/ellisapotheosis/.local/mcp-tools/node_modules/.bin/docker-mcp",
      "env": {
        "DOCKER_HOST": "${ORCHESTRATOR_DOCKER_HOST}"
      }
    },

    "HOMEASSISTANT_SSH": {
      "type": "stdio",
      "command": "/home/ellisapotheosis/.local/mcp-tools/node_modules/.bin/mcp-ssh-server-tool",
      "env": {
        "MCP_SILENT": "true"
      }
    },

    "infisical-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@infisical/mcp@latest"
      ],
      "env": {
        "INFISICAL_TOKEN": "${INFISICAL_TOKEN}",
        "INFISICAL_PROJECT_ID": "8374cea9-e5e8-4050-bda4-b91f25ab30ef",
        "INFISICAL_ENVIRONMENT": "dev",
        "INFISICAL_FOLDER_PATH": "/shared"
      }
    },

    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from", "git+https://github.com/oraios/serena",
        "serena", "start-mcp-server", "--transport", "stdio", "--log-level", "INFO"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    "archon-os": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "archon-os", "mcp"]
    }
  },
  
  "disabledMcpServers": [
    "serena",
    "archon-os"
  ]
}
