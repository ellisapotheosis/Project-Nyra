{
  "mcpServers": {
    "nexus-router": {
      "type": "http",
      "url": "https://nexus.trex-fiordland.ts.net/mcp",
      "startup_timeout_sec": 90
    },
    "serena": {
      "command": "/home/ellisapotheosis/.local/bin/uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context=claude-code",
        "--enable-web-dashboard",
        "false",
        "--enable-gui-log-window",
        "false",
        "--open-web-dashboard",
        "false"
      ],
      "startup_timeout_sec": 60
    },
    "ssh": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-ssh"],
      "env": {
        "SSH_ALLOWED_HOSTS": "*.trex-fiordland.ts.net,100.64.0.*,github.com,gitea.projectnyra.com"
      }
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    }
  },
  "disabledMcpServers": []
}
