{
  "mcpServers": {
    "nexus-router": {
      "type": "sse",
      "url": "https://nexus.projectnyra.com/mcp",
      "headers": {
        "Authorization": "Bearer ${ORCHESTRATOR_TUNNEL_TOKEN}"
      },
      "startup_timeout_sec": 90
    },
    "serena": {
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--project-from-cwd",
        "--context=claude-code"
      ],
      "startup_timeout_sec": 60
    },
    "ssh": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-ssh"],
      "env": {
        "SSH_ALLOWED_HOSTS": "*.trex-fiordland.ts.net,100.64.0.*,github.com,gitea.projectnyra.com"
      }
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    }
  },
  "disabledMcpServers": []
}
