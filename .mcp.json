{
  "mcpServers": {
    "nexus-router": {
      "type": "sse",
      "url": "http://orchestrator.trex-fiordland.ts.net:6000/mcp/sse"
    },
    "ssh": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-ssh"],
      "env": {
        "SSH_ALLOWED_HOSTS": "*.trex-fiordland.ts.net,100.64.0.*,github.com,gitea.ratehunter.net"
      }
    },
    "infisical": {
      "command": "npx",
      "args": ["-y", "@infisical/mcp"],
      "env": {
        "INFISICAL_TOKEN": "${INFISICAL_TOKEN}",
        "INFISICAL_PROJECT_ID": "8374cea9-e5e8-4050-bda4-b91f25ab30ef",
        "INFISICAL_ENVIRONMENT": "dev",
        "INFISICAL_FOLDER_PATH": "/shared"
      }
    },
    "openmemory": {
      "type": "sse",
      "url": "http://100.64.0.3:8765/mcp/claude/sse/nyra"
    },
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from", "git+https://github.com/oraios/serena",
        "serena", "start-mcp-server", "--transport", "stdio", "--log-level", "INFO"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "disabledMcpServers": []
}
