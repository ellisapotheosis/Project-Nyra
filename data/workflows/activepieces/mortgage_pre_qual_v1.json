{
  "name": "Mortgage Pre-Qual Drip V1",
  "trigger": {
    "type": "WEBHOOK",
    "settings": {
      "path": "mortgage-pre-qual-v1"
    }
  },
  "actions": [
    {
      "name": "Send Welcome Email",
      "type": "SENDGRID_SEND_EMAIL",
      "settings": {
        "templateId": "d-welcome-prequal"
      }
    },
    {
      "name": "Wait 2 Days",
      "type": "DELAY",
      "settings": {
        "duration": 2,
        "unit": "DAYS"
      }
    },
    {
      "name": "Send Follow-up SMS",
      "type": "TWILIO_SEND_SMS",
      "settings": {
        "body": "Hi {{lead.firstName}}, just checking in to see if you have any questions about the pre-qual terms we sent over. - Project Nyra Assistant"
      }
    }
  ]
}
