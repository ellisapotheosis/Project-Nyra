{
  "name": "Quote Follow-Up Sequence",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10,14,18 * * *"
            }
          ]
        }
      },
      "id": "cron-three-times-daily",
      "name": "Trigger 3x Daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT l.*, q.rate, q.monthly_payment, q.created_at as quote_date FROM leads l JOIN quotes q ON l.id = q.lead_id WHERE l.status = 'quoted' AND q.created_at > NOW() - INTERVAL '7 days' AND l.follow_up_count < 3",
        "options": {}
      },
      "id": "postgres-get-quotes",
      "name": "Get Recent Quotes",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [450, 300],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "PostgreSQL - Letta"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = [];\n\nfor (const item of $input.all()) {\n  const quoteDays = Math.floor((Date.now() - new Date(item.json.quote_date)) / (1000 * 60 * 60 * 24));\n  \n  let emailTemplate = '';\n  let subject = '';\n  \n  if (quoteDays === 1) {\n    subject = 'Your Quote is Ready - Next Steps';\n    emailTemplate = 'day1';\n  } else if (quoteDays === 3) {\n    subject = 'Have Questions About Your Quote?';\n    emailTemplate = 'day3';\n  } else if (quoteDays === 5) {\n    subject = 'Last Chance to Lock Your Rate';\n    emailTemplate = 'day5';\n  }\n  \n  if (emailTemplate) {\n    items.push({\n      json: {\n        ...item.json,\n        quoteDays,\n        emailTemplate,\n        subject\n      }\n    });\n  }\n}\n\nreturn items;"
      },
      "id": "code-determine-template",
      "name": "Determine Email Template",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.emailTemplate}}",
              "operation": "equals",
              "value2": "day1"
            }
          ]
        }
      },
      "id": "switch-template",
      "name": "Switch on Template",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [850, 300]
    },
    {
      "parameters": {
        "fromEmail": "quotes@ratehunter.net",
        "toEmail": "={{$json.email}}",
        "subject": "={{$json.subject}}",
        "emailType": "html",
        "message": "<h2>Hi {{$json.firstName}},</h2><p>Your personalized mortgage quote is ready!</p><div style=\"background: #f5f5f5; padding: 20px; border-radius: 8px;\"><p><strong>Loan Amount:</strong> ${{$json.loanAmount}}</p><p><strong>Interest Rate:</strong> {{$json.rate}}%</p><p><strong>Monthly Payment:</strong> ${{$json.monthly_payment}}</p></div><p><a href=\"https://ratehunter.net/quote/{{$json.id}}\" style=\"background: #0284c7; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; display: inline-block;\">View Full Quote</a></p><p>What happens next?</p><ol><li>Review your quote details</li><li>Upload required documents</li><li>Lock in your rate (good for 60 days)</li></ol>"
      },
      "id": "email-day1",
      "name": "Day 1 Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1050, 200],
      "credentials": {
        "smtp": {
          "id": "2",
          "name": "SMTP - SendGrid"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "quotes@ratehunter.net",
        "toEmail": "={{$json.email}}",
        "subject": "={{$json.subject}}",
        "emailType": "html",
        "message": "<h2>{{$json.firstName}}, we're here to help!</h2><p>We noticed you received your quote a few days ago. Do you have any questions?</p><p><strong>Your Rate: {{$json.rate}}%</strong></p><p>Common questions we get:</p><ul><li>What documents do I need?</li><li>How long is the approval process?</li><li>Can I adjust my loan amount?</li></ul><p><a href=\"https://ratehunter.net/faq\">View Full FAQ</a></p><p>Or schedule a call with our mortgage specialists:</p><p><a href=\"https://ratehunter.net/schedule/{{$json.id}}\" style=\"background: #0284c7; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; display: inline-block;\">Schedule a Call</a></p>"
      },
      "id": "email-day3",
      "name": "Day 3 Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1050, 400],
      "credentials": {
        "smtp": {
          "id": "2",
          "name": "SMTP - SendGrid"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "quotes@ratehunter.net",
        "toEmail": "={{$json.email}}",
        "subject": "={{$json.subject}}",
        "emailType": "html",
        "message": "<h2>{{$json.firstName}}, Your Rate Won't Last Forever</h2><p>Mortgage rates change daily. Your quote at <strong>{{$json.rate}}%</strong> is still available, but not for long.</p><div style=\"background: #fef3c7; padding: 20px; border-radius: 8px; border-left: 4px solid #f59e0b;\"><p><strong>⏰ Rate Lock Expires Soon</strong></p><p>Lock in this rate today to guarantee your monthly payment of ${{$json.monthly_payment}}</p></div><p><a href=\"https://ratehunter.net/lock-rate/{{$json.id}}\" style=\"background: #dc2626; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; display: inline-block;\">Lock Your Rate Now</a></p><p>If you're not ready, that's okay. But rates could go up at any time.</p>"
      },
      "id": "email-day5",
      "name": "Day 5 Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1050, 600],
      "credentials": {
        "smtp": {
          "id": "2",
          "name": "SMTP - SendGrid"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE leads SET follow_up_count = follow_up_count + 1, last_follow_up = NOW() WHERE id = {{$json.id}}",
        "options": {}
      },
      "id": "postgres-update-followup",
      "name": "Update Follow-Up Count",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [1250, 300],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "PostgreSQL - Letta"
        }
      }
    },
    {
      "parameters": {
        "phoneNumber": "={{$json.phone}}",
        "message": "Hi {{$json.firstName}}! Your mortgage quote is ready. Check your email or visit https://ratehunter.net/quote/{{$json.id}} to view. - RateHunter Team"
      },
      "id": "sms-notification",
      "name": "Send SMS Notification",
      "type": "n8n-nodes-base.twilioSms",
      "typeVersion": 1,
      "position": [1250, 500],
      "credentials": {
        "twilioApi": {
          "id": "3",
          "name": "Twilio"
        }
      }
    }
  ],
