   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Neon rectangle frame with smoke on water surface</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Neon rectangle frame with smoke on water surface. Rectangular glowing border with magic light among soft clouds. Purple portal with bright sparkles and flares Realistic abstract 3d vector background</rdf:li>
    </rdf:Alt>
   </dc:description>
