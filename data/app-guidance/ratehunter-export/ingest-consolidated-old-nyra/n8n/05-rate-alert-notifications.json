          }
        ],
        [
          {
            "node": "Send Standard Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Major Drop Alert": {
      "main": [
        [
          {
            "node": "Send SMS Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Standard Alert": {
      "main": [
        [
          {
