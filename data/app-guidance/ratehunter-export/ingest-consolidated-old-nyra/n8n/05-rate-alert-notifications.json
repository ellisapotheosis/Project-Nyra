{
  "name": "Rate Alert Notifications",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */4 * * *"
            }
          ]
        }
      },
      "id": "cron-every-4-hours",
      "name": "Check Every 4 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "https://api.freddiemac.com/v1/rates/primary-mortgage",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "http-fetch-rates",
      "name": "Fetch Current Rates",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "4",
          "name": "Freddie Mac API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const currentRates = $input.first().json;\nconst rates = {\n  conventional30yr: parseFloat(currentRates.conventional_30yr),\n  conventional15yr: parseFloat(currentRates.conventional_15yr),\n  fha30yr: parseFloat(currentRates.fha_30yr),\n  va30yr: parseFloat(currentRates.va_30yr),\n  timestamp: new Date().toISOString()\n};\n\nreturn [{ json: rates }];"
      },
      "id": "code-parse-rates",
      "name": "Parse Rate Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "mortgage_rates",
        "columns": "conventional_30yr,conventional_15yr,fha_30yr,va_30yr,timestamp",
        "options": {}
      },
      "id": "postgres-save-rates",
      "name": "Save Current Rates",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [850, 300],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "PostgreSQL - Letta"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT l.*, q.rate as quoted_rate, q.loan_type FROM leads l JOIN quotes q ON l.id = q.lead_id WHERE l.status IN ('quoted', 'in_progress') AND l.rate_alerts_enabled = true",
        "options": {}
      },
      "id": "postgres-get-leads-alerts",
      "name": "Get Leads With Alerts",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [1050, 300],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "PostgreSQL - Letta"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const currentRates = $node['Parse Rate Data'].json;\nconst leads = $input.all();\nconst alerts = [];\n\nfor (const lead of leads) {\n  const leadData = lead.json;\n  let currentRate;\n  \n  // Match loan type to current rate\n  switch(leadData.loan_type) {\n    case 'conventional_30yr':\n      currentRate = currentRates.conventional30yr;\n      break;\n    case 'conventional_15yr':\n      currentRate = currentRates.conventional15yr;\n      break;\n    case 'fha_30yr':\n      currentRate = currentRates.fha30yr;\n      break;\n    case 'va_30yr':\n      currentRate = currentRates.va30yr;\n      break;\n    default:\n      currentRate = currentRates.conventional30yr;\n  }\n  \n  const rateDifference = leadData.quoted_rate - currentRate;\n  \n  // Alert if current rate is 0.125% or more below quoted rate\n  if (rateDifference >= 0.125) {\n    alerts.push({\n      json: {\n        ...leadData,\n        currentRate,\n        quotedRate: leadData.quoted_rate,\n        savings: rateDifference,\n        savingsPercent: ((rateDifference / leadData.quoted_rate) * 100).toFixed(2),\n        estimatedMonthlySavings: Math.round((leadData.loan_amount * rateDifference / 100) / 12)\n      }\n    });\n  }\n}\n\nreturn alerts;"
      },
      "id": "code-calculate-savings",
      "name": "Calculate Potential Savings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.savings}}",
              "operation": "larger",
              "value2": 0.25
            }
          ]
        }
      },
      "id": "if-significant-drop",
      "name": "Significant Rate Drop?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "fromEmail": "rates@ratehunter.net",
        "toEmail": "={{$json.email}}",
        "subject": "🎉 Great News! Rates Just Dropped - Save ${{$json.estimatedMonthlySavings}}/month",
        "emailType": "html",
        "message": "<h2 style=\"color: #15803d;\">Exciting Rate Drop Alert! 🎉</h2><p>Hi {{$json.firstName}},</p><p>Great news! Mortgage rates have dropped significantly since your quote.</p><div style=\"background: #f0fdf4; padding: 20px; border-radius: 8px; border-left: 4px solid #15803d; margin: 20px 0;\"><table style=\"width: 100%;\"><tr><td><strong>Your Quoted Rate:</strong></td><td style=\"text-align: right;\">{{$json.quotedRate}}%</td></tr><tr><td><strong>Current Rate:</strong></td><td style=\"text-align: right; color: #15803d; font-size: 1.2em;\">{{$json.currentRate}}%</td></tr><tr><td><strong>Rate Savings:</strong></td><td style=\"text-align: right; color: #15803d;\">{{$json.savings}}%</td></tr><tr style=\"border-top: 2px solid #15803d;\"><td><strong>Monthly Savings:</strong></td><td style=\"text-align: right; font-size: 1.3em; color: #15803d;\"><strong>${{$json.estimatedMonthlySavings}}</strong></td></tr></table></div><p>This could save you <strong>${{Math.round($json.estimatedMonthlySavings * 360)}}</strong> over the life of your loan!</p><p><a href=\"https://ratehunter.net/update-quote/{{$json.id}}\" style=\"background: #15803d; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; display: inline-block;\">Get Updated Quote</a></p><p><em>Rates change frequently. Lock in this rate before it goes up!</em></p>"
      },
      "id": "email-major-drop",
      "name": "Send Major Drop Alert",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1650, 200],
      "credentials": {
        "smtp": {
          "id": "2",
          "name": "SMTP - SendGrid"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "rates@ratehunter.net",
        "toEmail": "={{$json.email}}",
        "subject": "Rate Update: Save ${{$json.estimatedMonthlySavings}}/month",
        "emailType": "html",
        "message": "<h2>Rate Drop Alert</h2><p>Hi {{$json.firstName}},</p><p>Rates have dropped since your quote. You could save ${{$json.estimatedMonthlySavings}}/month.</p><p><strong>Your Rate:</strong> {{$json.quotedRate}}%<br/><strong>Current Rate:</strong> {{$json.currentRate}}%</p><p><a href=\"https://ratehunter.net/update-quote/{{$json.id}}\">Get Updated Quote</a></p>"
      },
      "id": "email-standard-drop",
      "name": "Send Standard Alert",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1650, 400],
      "credentials": {
        "smtp": {
          "id": "2",
          "name": "SMTP - SendGrid"
        }
      }
    },
    {
      "parameters": {
        "phoneNumber": "={{$json.phone}}",
        "message": "🎉 RATE DROP! Save ${{$json.estimatedMonthlySavings}}/mo on your mortgage. New rate: {{$json.currentRate}}% (was {{$json.quotedRate}}%). Update now: https://ratehunter.net/u/{{$json.id}} - RateHunter"
      },
      "id": "sms-rate-alert",
      "name": "Send SMS Alert",
      "type": "n8n-nodes-base.twilioSms",
      "typeVersion": 1,
      "position": [1850, 300],
      "credentials": {
        "twilioApi": {
          "id": "3",
          "name": "Twilio"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO rate_alerts (lead_id, old_rate, new_rate, savings, alert_sent_at) VALUES ({{$json.id}}, {{$json.quotedRate}}, {{$json.currentRate}}, {{$json.savings}}, NOW())",
        "options": {}
      },
      "id": "postgres-log-alert",
      "name": "Log Alert Sent",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [2050, 300],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "PostgreSQL - Letta"
        }
      }
    }
  ],
  "connections": {
    "Check Every 4 Hours": {
      "main": [
        [
          {
            "node": "Fetch Current Rates",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Current Rates": {
      "main": [
        [
          {
            "node": "Parse Rate Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Rate Data": {
      "main": [
        [
          {
            "node": "Save Current Rates",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Current Rates": {
      "main": [
        [
          {
            "node": "Get Leads With Alerts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Leads With Alerts": {
      "main": [
        [
          {
            "node": "Calculate Potential Savings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calculate Potential Savings": {
