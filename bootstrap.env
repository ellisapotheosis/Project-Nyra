# ===================================================================
# BOOTSTRAP ENVIRONMENT FILE
# ===================================================================
# This file contains ALL environment variables needed for project-nyra
# 
# INSTRUCTIONS:
# 1. Review each section below
# 2. Update values as needed for your environment
# 3. REQUIRED sections are marked with [REQUIRED]
# 4. Add missing/sensitive values to Infisical
# 5. Reference: infisical.json for path structure
# 
# CATEGORIES:
#   [BOOTSTRAP] - PC identification and bootstrap settings
#   [REQUIRED]  - Must be configured before deployment
#   [OPTIONAL]  - Can be left empty or use defaults
#   [SECRET]    - Should be stored in Infisical, not git
#   [SERVICE]   - Service-specific configuration
# ===================================================================

# ===================================================================
# [BOOTSTRAP] PC & ORCHESTRATION CONFIGURATION
# ===================================================================
# These are set by bootstrap installer
PC_NAME=orchestrator
PC_ROLE=orchestrator
PC_TYPE=orchestrator
LAN_IP=10.0.0.1
NODE_ENV=production
LOG_LEVEL=info

# ===================================================================
# [REQUIRED] DATABASE & PERSISTENCE
# ===================================================================
DATABASE_URL=postgresql://postgres:password@postgres:5432/nyra
REDIS_URL=redis://redis:6379/0
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_here
POSTGRES_DB=nyra
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
MONGODB_URI=mongodb://localhost:27017/nyra

# ===================================================================
# [REQUIRED] API KEYS & AUTHENTICATION
# ===================================================================
# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_ORG_ID=

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Other LLM Providers
GROQ_API_KEY=
COHERE_API_KEY=

# ===================================================================
# [REQUIRED] NETWORK & INFRASTRUCTURE
# ===================================================================
# Cloudflare
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMAIL=
CLOUDFLARE_ZONE_ID=

# Tailscale
TAILSCALE_AUTH_KEY=
TAILSCALE_HOSTNAME=

# Domain
DOMAIN=ratehunter.net
DOMAIN_EMAIL=admin@ratehunter.net

# ===================================================================
# [REQUIRED] SERVICE CREDENTIALS
# ===================================================================
# Dify
DIFY_API_KEY=
DIFY_API_URL=http://dify:5001

# n8n
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

# Activepieces
ACTIVEPIECES_API_KEY=

# TwentyCRM
TWENTYCRM_API_KEY=

# Nexus Router
NEXUS_API_KEY=
NEXUS_ROUTER_URL=http://nexus:8000

# LiteLLM
LITELLM_MASTER_KEY=sk-litellm-master
LITELLM_API_URL=http://litellm:8000

# ===================================================================
# [OPTIONAL] CLAUDE-FLOW & AGENTS
# ===================================================================
CLAUDE_FLOW_API_KEY=
CLAUDE_FLOW_MODEL=claude-3-5-sonnet-20241022
CLAUDE_FLOW_MAX_TOKENS=4096
CLAUDE_FLOW_TEMPERATURE=0.7
CLAUDE_FLOW_TIMEOUT=30

# Agent Configuration
AGENT_MEMORY_TYPE=redis
AGENT_CACHE_TTL=3600
AGENT_LOG_LEVEL=info

# ===================================================================
# [OPTIONAL] GPU & INFERENCE SETTINGS
# ===================================================================
# Ollama (Local LLM)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama2
OLLAMA_TEMPERATURE=0.7

# GPU Configuration
GPU_DEVICE=cuda
GPU_MEMORY_FRACTION=0.8
CUDA_VISIBLE_DEVICES=0
TORCH_HOME=/tmp/torch

# vLLM (if using)
VLLM_HOST=localhost
VLLM_PORT=8000
VLLM_MODEL=
VLLM_TENSOR_PARALLEL_SIZE=1

# ===================================================================
# [OPTIONAL] CACHE & VECTOR STORES
# ===================================================================
# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=nyra_embeddings

# Milvus Vector DB
MILVUS_HOST=milvus
MILVUS_PORT=19530

# FalkorDB
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379

# Embedding Service
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ===================================================================
# [OPTIONAL] MONITORING & OBSERVABILITY
# ===================================================================
# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

# Grafana
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

# Loki (Logging)
LOKI_HOST=loki
LOKI_PORT=3100

# Jaeger (Tracing)
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831

# ===================================================================
# [OPTIONAL] APPLICATION SETTINGS
# ===================================================================
# Nyra Admin
NYRA_ADMIN_PORT=3002
NYRA_ADMIN_API_URL=http://localhost:3000

# RateHunter
RATEHUNTER_PORT=3001
RATEHUNTER_API_URL=http://localhost:3000

# Nexus Dashboard
NEXUS_DASHBOARD_PORT=3003

# Landing Page
LANDING_PORT=3004

# ===================================================================
# [SECRET] SECURE CREDENTIALS (MOVE TO INFISICAL)
# ===================================================================
# These MUST be moved to Infisical and not committed to git
# Suggested Infisical paths:
#   /shared/api-keys/openai
#   /shared/api-keys/anthropic
#   /shared/database/postgres
#   /shared/cloudflare/tunnel
#   /shared/tailscale/auth
#   /machines/orchestrator/credentials

JWT_SECRET=your-super-secret-jwt-key-min-32-chars
SESSION_SECRET=your-super-secret-session-key
ENCRYPTION_KEY=your-super-secret-encryption-key

# ===================================================================
# [OPTIONAL] DEVELOPMENT OVERRIDES
# ===================================================================
# Uncomment these if running in development
# DEBUG=*
# MOCK_EXTERNAL_APIS=true
# DISABLE_AUTH=false
# VERBOSE_LOGGING=true

# ===================================================================
# [SERVICE] DOCKER COMPOSE CONFIGURATION
# ===================================================================
COMPOSE_PROJECT_NAME=nyra
COMPOSE_FILE=infra/docker-compose.yml

# ===================================================================
# [SERVICE] CI/CD CONFIGURATION
# ===================================================================
CI=false
GITHUB_TOKEN=
GITHUB_REPO=ellisapotheosis/project-nyra

# ===================================================================
# NOTES FOR INFISICAL MIGRATION
# ===================================================================
# Suggested folder structure in Infisical:
#
# /shared/
#   api-keys/
#     openai/
#       key: OPENAI_API_KEY
#       org_id: OPENAI_ORG_ID
#     anthropic/
#       key: ANTHROPIC_API_KEY
#     google/
#       client_id: GOOGLE_CLIENT_ID
#       client_secret: GOOGLE_CLIENT_SECRET
#
#   database/
#     postgres/
#       url: DATABASE_URL
#       user: POSTGRES_USER
#       password: POSTGRES_PASSWORD
#     redis/
#       url: REDIS_URL
#
#   cloudflare/
#     tunnel/
#       id: CLOUDFLARE_TUNNEL_ID
#       token: CLOUDFLARE_TOKEN
#     dns/
#       zone_id: CLOUDFLARE_ZONE_ID
#
#   security/
#     jwt_secret: JWT_SECRET
#     session_secret: SESSION_SECRET
#     encryption_key: ENCRYPTION_KEY
#
# /machines/
#   orchestrator/
#     credentials/
#       all PC-specific secrets
#   worker-rtx3060/
#     credentials/
#       gpu-specific secrets
#   worker-rtx3090ti/
#     credentials/
#       gpu-specific secrets
#   worker-rtx5090/
#     credentials/
#       gpu-specific secrets
#
# ===================================================================
