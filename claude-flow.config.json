{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "3.0.0",
  "enabled": true,

  "modelPreferences": {
    "default": "claude-sonnet-4-5",
    "routing": "claude-3-5-haiku-20241022",
    "fallback": "claude-3-5-sonnet-20241022"
  },

  "providers": [
    {
      "name": "anthropic",
      "type": "anthropic",
      "apiKey": "${ANTHROPIC_API_KEY}",
      "models": ["claude-opus-4-5-20251101", "claude-3-5-sonnet-20241022", "claude-3-5-haiku-20241022"]
    },
    {
      "name": "openai",
      "type": "openai",
      "apiKey": "${OPENAI_API_KEY}",
      "models": ["gpt-4", "gpt-4-turbo", "gpt-3.5-turbo"]
    },
    {
      "name": "gemini",
      "type": "google",
      "apiKey": "${GOOGLE_API_KEY}",
      "models": ["gemini-2.0-flash-001"]
    }
  ],

  "agents": {
    "defaultType": "coder",
    "maxConcurrent": 35
  },

  "swarm": {
    "topology": "hierarchical-mesh",
    "maxAgents": 35
  },

  "memory": {
    "backend": "hybrid",
    "cacheSize": 512
  },

  "mcp": {
    "transport": "stdio",
    "tools": "all"
  },

  "hooks": {
    "enabled": true
  },

  "daemon": {
    "autoStart": true
  },

  "neural": {
    "enabled": true
  },

  "security": {
    "autoScan": true
  },

  "performance": {
    "enabled": true
  },

  "logging": {
    "level": "INFO"
  }
}
