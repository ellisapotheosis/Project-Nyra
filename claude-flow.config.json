{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "3.0.0",

  "orchestrator": {
    "timeout": 180000,
    "retryAttempts": 3,
    "retryDelay": 3000
  },

  "terminal": {
    "emulateEnvironment": true,
    "defaultShell": "/bin/bash",
    "workingDirectory": "./",
    "maxOutputLength": 50000,
    "timeout": 120000
  },

  "memory": {
    "backend": "hybrid",
    "path": "./data",
    "maxEntries": 50000,
    "ttl": 604800,
    "hnsw": {
      "enabled": true,
      "efConstruction": 200,
      "m": 16
    },
    "quantization": {
      "enabled": true,
      "bits": 8
    },
    "encryption": {
      "enabled": false,
      "algorithm": "aes-256-gcm"
    }
  },

  "swarm": {
    "topology": "hierarchical-mesh",
    "maxAgents": 35,
    "strategy": "specialized",
    "consensus": "raft",
    "autoScale": true,
    "heartbeatInterval": 3000,
    "taskQueueSize": 200
  },

  "coordination": {
    "mode": "hub-spoke",
    "maxRetries": 5,
    "retryDelay": 5000,
    "circuitBreaker": {
      "enabled": true,
      "threshold": 5,
      "timeout": 30000,
      "resetTimeout": 180000
    }
  },

  "loadBalancing": {
    "strategy": "round-robin",
    "healthCheckInterval": 15000,
    "maxLoad": 0.85
  },

  "mcp": {
    "enabled": true,
    "transport": "stdio",
    "port": 3000,
    "host": "localhost"
  },

  "neural": {
    "enabled": true,
    "sona": {
      "enabled": true,
      "adaptationRate": 0.001
    },
    "ewc": {
      "enabled": true,
      "lambda": 0.5,
      "preventForgetting": true
    },
    "moe": {
      "enabled": true,
      "expertCount": 12,
      "topK": 3,
      "loadBalancing": true
    },
    "flashAttention": {
      "enabled": true,
      "targetSpeedup": 5.0,
      "memoryEfficient": true
    },
    "lora": {
      "enabled": true,
      "rank": 8,
      "alpha": 16
    }
  },

  "security": {
    "mode": "strict",
    "inputValidation": true,
    "pathValidation": true,
    "authentication": {
      "required": false,
      "method": "jwt"
    },
    "rateLimit": {
      "enabled": true,
      "maxRequests": 5000,
      "windowMs": 60000
    }
  },

  "logging": {
    "level": "warn",
    "format": "json",
    "destination": "file",
    "filePath": "./logs/claude-flow.log",
    "maxFileSize": "500MB",
    "maxFiles": 5
  },

  "monitoring": {
    "enabled": true,
    "metricsInterval": 30000,
    "alertThresholds": {
      "errorRate": 0.03,
      "responseTime": 3000,
      "memoryUsage": 0.85
    }
  },

  "providers": {
    "default": "anthropic",
    "fallback": ["openai", "google"],
    "anthropic": {
      "model": "claude-sonnet-4-5-20250929",
      "maxTokens": 16384
    },
    "openai": {
      "model": "gpt-4o",
      "maxTokens": 8192
    },
    "google": {
      "model": "gemini-2.0-flash-exp",
      "maxTokens": 8192
    }
  },

  "hooks": {
    "enabled": true,
    "learning": true,
    "pretrainOnStart": true,
    "preTask": true,
    "postTask": true,
    "preEdit": true,
    "postEdit": true,
    "route": true,
    "intelligence": true,
    "daemon": {
      "enabled": true,
      "port": 3001
    },
    "workers": {
      "enabled": true,
      "maxWorkers": 4
    }
  },

  "update": {
    "autoCheck": true,
    "checkInterval": 43200000,
    "allowPrerelease": true
  }
}
