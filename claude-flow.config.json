{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "3.0.0",
  "enabled": true,

  "modelPreferences": {
    "default": "claude-sonnet-4-5",
    "routing": "claude-3-5-haiku-20241022",
    "fallback": "claude-3-5-sonnet-20241022",
    "costOptimized": "gemini-2.0-flash-001"
  },

  "providers": [
    {
      "name": "anthropic",
      "type": "anthropic",
      "apiKey": "${ANTHROPIC_API_KEY}",
      "models": ["claude-opus-4-5-20251101", "claude-3-5-sonnet-20241022", "claude-3-5-haiku-20241022"]
    },
    {
      "name": "openai",
      "type": "openai",
      "apiKey": "${OPENAI_API_KEY}",
      "models": ["gpt-4", "gpt-4-turbo", "gpt-3.5-turbo"]
    },
    {
      "name": "gemini",
      "type": "google",
      "apiKey": "${GOOGLE_API_KEY}",
      "models": ["gemini-2.0-flash-001"]
    }
  ],

  "agents": {
    "defaultType": "coder",
    "maxConcurrent": 15,
    "pool": []
  },

  "mcpServers": [
    {
      "name": "claude-flow",
      "command": "npx",
      "args": ["-y", "@claude-flow/cli@latest", "mcp"],
      "enabled": true
    }
  ],

  "hooks": {
    "enabled": true,
    "preTask": true,
    "postTask": true,
    "preEdit": true,
    "postEdit": true,
    "preCommand": true,
    "postCommand": true
  },

  "swarm": {
    "topology": "hierarchical-mesh",
    "maxAgents": 15,
    "minAgents": 1,
    "coordinationStrategy": "priority-based",
    "loadBalancing": "adaptive",
    "failover": "auto-reassign",
    "autoScale": true,
    "scaleThreshold": {
      "cpu": 80,
      "memory": 85,
      "queueDepth": 20
    }
  },

  "memory": {
    "backend": "hybrid",
    "primaryStore": "letta",
    "secondaryStore": "mem0",
    "enableHNSW": true,
    "hnswConfig": {
      "efConstruction": 200,
      "m": 16,
      "efSearch": 100
    },
    "caching": true,
    "cacheSize": "512MB",
    "retention": {
      "shortTerm": "24h",
      "mediumTerm": "7d",
      "longTerm": "30d"
    },
    "compression": true,
    "encryption": true
  },

  "neural": {
    "enabled": true,
    "autoTrain": true,
    "modelOptimization": "flash-attention-2",
    "quantization": "int8",
    "batchSize": 32,
    "learningRate": 0.001,
    "patterns": [
      "coordination",
      "optimization",
      "prediction",
      "anomaly-detection"
    ]
  },

  "daemon": {
    "autoStart": true,
    "restartOnFailure": true,
    "maxRestarts": 3,
    "workers": [
      {
        "name": "map",
        "enabled": true,
        "priority": "normal",
        "schedule": "continuous"
      },
      {
        "name": "audit",
        "enabled": true,
        "priority": "critical",
        "schedule": "1h"
      },
      {
        "name": "optimize",
        "enabled": true,
        "priority": "high",
        "schedule": "30m"
      },
      {
        "name": "consolidate",
        "enabled": true,
        "priority": "low",
        "schedule": "2h"
      },
      {
        "name": "testgaps",
        "enabled": true,
        "priority": "normal",
        "schedule": "1h"
      },
      {
        "name": "ultralearn",
        "enabled": true,
        "priority": "normal",
        "schedule": "1h"
      },
      {
        "name": "deepdive",
        "enabled": true,
        "priority": "normal",
        "schedule": "4h",
        "triggers": ["complex-change"]
      },
      {
        "name": "document",
        "enabled": true,
        "priority": "normal",
        "schedule": "1h",
        "triggers": ["adr-update", "api-change"]
      },
      {
        "name": "refactor",
        "enabled": true,
        "priority": "low",
        "schedule": "6h"
      },
      {
        "name": "benchmark",
        "enabled": true,
        "priority": "normal",
        "schedule": "12h"
      }
    ]
  },

  "learning": {
    "enabled": true,
    "autoTrain": true,
    "patterns": [
      "coordination",
      "optimization",
      "prediction"
    ],
    "retention": {
      "shortTerm": "24h",
      "longTerm": "30d"
    },
    "feedbackLoop": true,
    "reinforcementLearning": true,
    "algorithms": [
      "decision-transformer",
      "q-learning",
      "actor-critic"
    ]
  },

  "adr": {
    "autoGenerate": true,
    "directory": "/docs/adr",
    "template": "madr",
    "trackChanges": true,
    "reviewRequired": true
  },

  "ddd": {
    "trackDomains": true,
    "validateBoundedContexts": true,
    "directory": "/docs/ddd",
    "enforcePatterns": true
  },

  "security": {
    "autoScan": true,
    "scanOnEdit": true,
    "cveCheck": true,
    "threatModel": true,
    "piiDetection": true,
    "aiDefense": true,
    "aimds": {
      "enabled": true,
      "monitorInputs": true,
      "monitorOutputs": true,
      "blockSuspicious": true
    },
    "encryption": {
      "atRest": true,
      "inTransit": true,
      "algorithm": "AES-256-GCM"
    }
  },

  "observability": {
    "enabled": true,
    "prometheus": {
      "enabled": true,
      "port": 9090,
      "scrapeInterval": "15s"
    },
    "grafana": {
      "enabled": true,
      "port": 3005
    },
    "loki": {
      "enabled": true,
      "port": 3100
    },
    "tracing": {
      "enabled": true,
      "sampler": "probabilistic",
      "samplingRate": 0.1
    }
  },

  "performance": {
    "optimization": {
      "flashAttention": true,
      "wasmSimd": true,
      "tokenOptimization": true,
      "targetReduction": 0.6
    },
    "caching": {
      "enabled": true,
      "strategy": "lru",
      "maxSize": "1GB",
      "ttl": "1h"
    },
    "parallelization": {
      "enabled": true,
      "maxParallel": 10,
      "batchSize": 5
    }
  },

  "networking": {
    "cluster": {
      "enabled": true,
      "discovery": "mdns",
      "coordinator": "orchestrator",
      "workers": ["worker1", "worker2", "worker3"]
    },
    "communication": {
      "protocol": "grpc",
      "compression": true,
      "encryption": true,
      "timeout": 30000
    }
  },

  "compliance": {
    "enforceValidation": true,
    "blockNonCompliant": true,
    "auditLogging": true,
    "regulations": [
      "TILA",
      "RESPA",
      "Fair-Housing-Act",
      "ECOA",
      "CFPB-Standards"
    ],
    "dataRetention": "7y",
    "rightToDelete": true
  },

  "integrations": {
    "llmGateway": {
      "service": "nexus-router",
      "url": "http://localhost:6000",
      "providers": ["anthropic", "openrouter", "gemini"],
      "fallbackChain": ["anthropic", "openrouter", "gemini"],
      "rateLimit": {
        "enabled": true,
        "requestsPerMinute": 60
      }
    },
    "memory": {
      "letta": {
        "url": "http://localhost:8283",
        "timeout": 5000
      },
      "mem0": {
        "url": "http://localhost:4321",
        "timeout": 5000
      }
    },
    "crm": {
      "twentycrm": {
        "url": "http://localhost:3000",
        "timeout": 10000
      }
    },
    "workflow": {
      "n8n": {
        "url": "http://localhost:5678",
        "timeout": 30000
      }
    }
  },

  "logging": {
    "level": "INFO",
    "format": "json",
    "output": "stdout",
    "file": "/var/log/claude-flow/main.log",
    "rotation": {
      "enabled": true,
      "maxSize": "100MB",
      "maxFiles": 10
    },
    "structured": true,
    "includeStack": true
  },

  "features": {
    "reasoningBank": true,
    "agentDB": true,
    "sublinearSolvers": true,
    "quantumResistant": true,
    "byzantineConsensus": true,
    "crdt": true,
    "vectorQuantization": true,
    "ewcPlusPlus": true
  }
}
