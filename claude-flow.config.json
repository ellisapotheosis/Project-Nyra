{
  "memory": {
    "retention": "30d",
    "maxSize": "1GB",
    "compression": "Enabled",
    "cacheSizeMB": 512,
    "indexingEnabled": true,
    "autoCleanup": true,
    "cacheSize": 512
  },
  "agents": {
    "cache": {
      "results": true,
      "ttl": 1800
    },
    "pooling": {
      "enabled": true,
      "idle-timeout": 300
    }
  },
  "github": {
    "cache": {
      "enabled": true,
      "ttl": 3600
    }
  },
  "orchestrator": {
    "maxConcurrentAgents": 50,
    "agentPoolSize": 20
  },
  "swarm": {
    "autoScaling": true,
    "minAgents": 5,
    "maxAgents": 100
  },
  "performance": {
    "cacheEnabled": true,
    "cacheStrategy": "aggressive"
  },
  "network": {
    "connectionPooling": true,
    "compressionEnabled": true
  },
  "terminal": {
    "poolSize": 30
  }
}