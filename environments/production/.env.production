# Project Nyra - Production Environment Configuration
# ⚠️ PRODUCTION ENVIRONMENT - Handle with care

# Node Configuration
NYRA_NODE_TYPE=production
NYRA_ENVIRONMENT=production
NYRA_NODE_ID=prod-01
COMPOSE_PROJECT_NAME=nyra-prod

# Deployment Information
# These will be updated automatically by CI/CD
DEPLOYMENT_VERSION=v1.0.0
DEPLOYMENT_DATE=2026-03-10T13:45:00Z
DEPLOYMENT_SHA=abc1234

# Docker Configuration
COMPOSE_PROFILES=core,monitoring,workflow,crm,backup

# Container Images (production tags)
NEXUS_ROUTER_IMAGE=gitea.local:3100/nyra/nexus-router:latest
CLAUDE_FLOW_IMAGE=gitea.local:3100/nyra/claude-flow:latest
QUOTE_ENGINE_IMAGE=gitea.local:3100/nyra/quote-engine:latest
CAMPAIGN_ENGINE_IMAGE=gitea.local:3100/nyra/campaign-engine:latest
BACKUP_AGENT_IMAGE=gitea.local:3100/nyra/backup-agent:latest

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nyra_production
POSTGRES_USER=nyra
# POSTGRES_PASSWORD - set via Gitea secrets

REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD - set via Gitea secrets

# Core Services Configuration (Internal ports only)
NEXUS_ROUTER_PORT=6000
LITELLM_PORT=4000
CLAUDE_FLOW_PORT=3010

# Monitoring Configuration
GRAFANA_PORT=3005
PROMETHEUS_PORT=9090
LOKI_PORT=3100
ALERTMANAGER_PORT=9093
# GRAFANA_ADMIN_PASSWORD - set via Gitea secrets

# Workflow Configuration
N8N_PORT=5678
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD, N8N_ENCRYPTION_KEY - set via Gitea secrets

ACTIVEPIECES_PORT=8082
# ACTIVEPIECES_JWT_SECRET, ACTIVEPIECES_ENCRYPTION_KEY - set via Gitea secrets

# CRM Configuration
TWENTYCRM_PORT=3000
# All TWENTY_* secrets set via Gitea secrets

# Memory Systems
LETTA_PORT=8283
MEM0_PORT=4321
AGENTDB_PORT=8080
GRAPHITI_PORT=8007
# LETTA_API_KEY, LETTA_SERVER_PASS - set via Gitea secrets

# Production Settings
LOG_LEVEL=warn
HOT_RELOAD_ENABLED=false
DEBUG_MODE=false
PROFILING_ENABLED=false
NODE_ENV=production

# Feature Flags
ENABLE_MONITORING=true
ENABLE_CRM=true
ENABLE_WORKFLOWS=true
ENABLE_GPU_WORKERS=false
ENABLE_COMPLIANCE_CHECKS=true
ENABLE_RATE_LIMITING=true

# Resource Limits (Production optimized)
POSTGRES_MEMORY_LIMIT=4096
POSTGRES_CPU_LIMIT=2.0
REDIS_MEMORY_LIMIT=1024
REDIS_CPU_LIMIT=1.0
GRAFANA_MEMORY_LIMIT=1024
NEXUS_MEMORY_LIMIT=2048
NEXUS_CPU_LIMIT=2.0

# API Keys (Production)
# All set via Gitea secrets:
# ANTHROPIC_API_KEY
# OPENAI_API_KEY
# GOOGLE_API_KEY
# OPENROUTER_API_KEY

# Security Configuration
CORS_ALLOWED_ORIGINS="https://ratehunter.net,https://app.ratehunter.net"
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
FAIL2BAN_ENABLED=true
UFW_ENABLED=true

# SSL/TLS Configuration
SSL_ENABLED=true
DOMAIN_NAME=ratehunter.net

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # 2 AM daily
BACKUP_RETENTION_DAYS=30

# External Services (Production)
# TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_PHONE_NUMBER - set via secrets
# SMTP_USER, SMTP_PASSWORD, SMTP_FROM_EMAIL - set via secrets

# Cloudflare Integration (if using tunnel)
# CLOUDFLARE_TUNNEL_TOKEN, CLOUDFLARE_ZONE_ID, CLOUDFLARE_API_TOKEN - set via secrets

# Performance Tuning
MAX_CONNECTIONS=200
CONNECTION_TIMEOUT=30
QUERY_TIMEOUT=60
BATCH_SIZE=1000

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000
REDIS_MAX_MEMORY=1gb

# Infisical (Production Secrets Management)
# INFISICAL_PROJECT_ID, INFISICAL_CLIENT_ID, INFISICAL_CLIENT_SECRET - set via secrets
INFISICAL_ENVIRONMENT=production