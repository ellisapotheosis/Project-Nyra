# Project Nyra - Oracle VPS Environment Configuration
# Optimized for Oracle Cloud Always Free Tier

# Node Configuration
NYRA_NODE_TYPE=oracle
NYRA_ENVIRONMENT=production
NYRA_NODE_ID=oracle-vps-01
COMPOSE_PROJECT_NAME=nyra-oracle

# Oracle Cloud Instance Details
ORACLE_REGION=us-phoenix-1
ORACLE_INSTANCE_TYPE=VM.Standard.A1.Flex  # ARM64 Always Free
ORACLE_INSTANCE_IP=YOUR_ORACLE_PUBLIC_IP_HERE

# Docker Configuration (ARM64 support)
COMPOSE_PROFILES=core,edge,monitoring,backup

# Container Images (ARM64 compatible)
NEXUS_ROUTER_IMAGE=gitea.local:3100/nyra/nexus-router:latest
CLAUDE_FLOW_IMAGE=gitea.local:3100/nyra/claude-flow:latest
QUOTE_ENGINE_IMAGE=gitea.local:3100/nyra/quote-engine:latest
WEBHOOK_GATEWAY_IMAGE=gitea.local:3100/nyra/webhook-gateway:latest
BACKUP_AGENT_IMAGE=gitea.local:3100/nyra/backup-agent:latest

# External Access Configuration
SSL_ENABLED=true
DOMAIN_NAME=ratehunter.net
CLOUDFLARE_ENABLED=true
# CLOUDFLARE_TUNNEL_TOKEN - set via Gitea secrets

# Database Configuration (Lightweight for ARM)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nyra_oracle
POSTGRES_USER=nyra
# POSTGRES_PASSWORD - set via Gitea secrets

REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD - set via Gitea secrets

# Core Services (External-facing)
NEXUS_ROUTER_PORT=6000
WEBHOOK_PORT=3000
METRICS_EXPORT_PORT=9100

# Monitoring (Lightweight)
GRAFANA_PORT=3005
PROMETHEUS_PORT=9090
# GRAFANA_ADMIN_PASSWORD - set via Gitea secrets

# External Services
NGINX_PORT=80
NGINX_SSL_PORT=443

# Oracle Cloud Resource Limits (Always Free)
# 4 OCPUs ARM64, 24GB RAM, 200GB storage
POSTGRES_MEMORY_LIMIT=2048
POSTGRES_CPU_LIMIT=2.0
REDIS_MEMORY_LIMIT=512
REDIS_CPU_LIMIT=0.5
NEXUS_MEMORY_LIMIT=1024
NEXUS_CPU_LIMIT=1.0
NGINX_MEMORY_LIMIT=256
WEBHOOK_MEMORY_LIMIT=512

# Performance Optimization (Resource-constrained)
LOG_LEVEL=warn
CONNECTION_POOL_SIZE=10
MAX_CONNECTIONS=50
CACHE_TTL=7200  # Longer cache for better performance
REDIS_MAX_MEMORY=400mb

# Security (Public-facing VPS)
RATE_LIMIT_REQUESTS=50
RATE_LIMIT_WINDOW_MS=60000
FAIL2BAN_ENABLED=true
UFW_ENABLED=true

# DDoS Protection
CLOUDFLARE_DDOS_PROTECTION=true
CLOUDFLARE_WAF_ENABLED=true

# Geographic Restrictions
ALLOWED_COUNTRIES=US,CA  # US and Canada only initially
BLOCKED_IPS_ENABLED=true

# Backup Configuration (Oracle Object Storage)
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 3 * * *"  # 3 AM UTC
BACKUP_RETENTION_DAYS=30
# ORACLE_OBJECT_STORAGE_* - set via Gitea secrets

# External Webhook Configuration
WEBHOOK_ENDPOINTS_ENABLED=true
WEBHOOK_RATE_LIMIT=10  # requests per minute
WEBHOOK_AUTH_REQUIRED=true
# WEBHOOK_SECRET - set via Gitea secrets

# API Keys (Production)
# All set via Gitea secrets:
# ANTHROPIC_API_KEY
# OPENAI_API_KEY
# GOOGLE_API_KEY

# Oracle Cloud Monitoring
ORACLE_MONITORING_ENABLED=true
ORACLE_LOGS_ENABLED=true

# Timezone and Locale
TIMEZONE=America/New_York
LOCALE=en_US.UTF-8

# Feature Flags (Oracle optimized)
ENABLE_MONITORING=true
ENABLE_CRM=false  # Disable heavy CRM on Oracle
ENABLE_WORKFLOWS=false  # Disable heavy workflows
ENABLE_GPU_WORKERS=false
ENABLE_COMPLIANCE_CHECKS=true
ENABLE_RATE_LIMITING=true

# Oracle-specific Environment Variables
ORACLE_CLOUD_FREE_TIER=true
ARM64_OPTIMIZATIONS_ENABLED=true
MEMORY_CONSERVATIVE_MODE=true

# Cloudflare Integration
# CLOUDFLARE_ZONE_ID, CLOUDFLARE_API_TOKEN - set via secrets

# SSL Certificate Configuration
ACME_ENABLED=true
ACME_EMAIL=admin@ratehunter.net
ACME_PROVIDER=cloudflare

# Network Configuration
TAILSCALE_ENABLED=true
# TAILSCALE_AUTH_KEY - set via Gitea secrets

# Development Features (Disabled in Oracle)
HOT_RELOAD_ENABLED=false
DEBUG_MODE=false
PROFILING_ENABLED=false