# Project Nyra - Staging Environment Configuration
# Auto-updated by CI/CD pipeline

# Node Configuration
NYRA_NODE_TYPE=staging
NYRA_ENVIRONMENT=staging
NYRA_NODE_ID=staging-01
COMPOSE_PROJECT_NAME=nyra-staging

# Deployment Information
# These will be updated automatically by CI/CD
DEPLOYMENT_VERSION=main-latest
DEPLOYMENT_DATE=2026-03-10T13:45:00Z
DEPLOYMENT_SHA=abc1234

# Docker Configuration
COMPOSE_PROFILES=core,monitoring,workflow,crm

# Container Images (updated by CI/CD)
NEXUS_ROUTER_IMAGE=gitea.local:3100/nyra/nexus-router:main
CLAUDE_FLOW_IMAGE=gitea.local:3100/nyra/archon-os:main
QUOTE_ENGINE_IMAGE=gitea.local:3100/nyra/quote-engine:main
CAMPAIGN_ENGINE_IMAGE=gitea.local:3100/nyra/campaign-engine:main

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nyra_staging
POSTGRES_USER=nyra
# POSTGRES_PASSWORD - set via Gitea secrets

REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD - set via Gitea secrets

# Core Services Configuration
NEXUS_ROUTER_PORT=6000
LITELLM_PORT=4000
CLAUDE_FLOW_PORT=3010

# Monitoring Configuration
GRAFANA_PORT=3005
PROMETHEUS_PORT=9090
LOKI_PORT=3100
# GRAFANA_ADMIN_PASSWORD - set via Gitea secrets

# Workflow Configuration
N8N_PORT=5678
N8N_BASIC_AUTH_ACTIVE=false
# N8N_ENCRYPTION_KEY - set via Gitea secrets

ACTIVEPIECES_PORT=8082

# CRM Configuration
TWENTYCRM_PORT=3000
# TWENTY_* secrets set via Gitea secrets

# Staging-Specific Settings
LOG_LEVEL=debug
HOT_RELOAD_ENABLED=true
DEBUG_MODE=true
PROFILING_ENABLED=true

# Development Features Enabled
ENABLE_MONITORING=true
ENABLE_CRM=true
ENABLE_WORKFLOWS=true

# Resource Limits (Generous for staging)
POSTGRES_MEMORY_LIMIT=2048
REDIS_MEMORY_LIMIT=1024
GRAFANA_MEMORY_LIMIT=512
NEXUS_MEMORY_LIMIT=1024

# API Keys (shared with production but rate-limited)
# Set via Gitea secrets:
# ANTHROPIC_API_KEY
# OPENAI_API_KEY
# GOOGLE_API_KEY
# OPENROUTER_API_KEY

# Security (Development-friendly)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3005,http://staging.nyra.internal"
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=60000

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 6 * * *"  # 6 AM daily
BACKUP_RETENTION_DAYS=7