# Copy to .env.gitea and replace REPLACE_ME_* with Infisical-provided values.

NYRA_MACHINE=orchestrator
NYRA_NETWORK=nyra-net
TZ=America/Los_Angeles

# Gitea exposure
GITEA_PORT=3100
GITEA_SSH_PORT=2222
GITEA_ROOT_URL=https://git.ratehunter.net/
GITEA_SSH_DOMAIN=git.ratehunter.net

# CI/automation profiles
REVIEW_MODEL=anthropic/claude-3.5-sonnet
REVIEW_MAX_CHARS=18000
REVIEW_POST_AS_REVIEW=true
REVIEW_LABEL=ai-reviewed
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Infisical sidecar/secrets bootstrap
INFISICAL_API_URL=https://app.infisical.com
INFISICAL_PROJECT_ID=REPLACE_ME_INFISICAL_PROJECT_ID
INFISICAL_ENV=prod
INFISICAL_PATH=/nyra/gitea
INFISICAL_POLL_INTERVAL=60s
NYRA_FORCE_SECRETS=false
