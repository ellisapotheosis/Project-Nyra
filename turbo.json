{
  "$schema": "https://turbo.build/schema.json",
  "remoteCache": {
    "enabled": true
  },
  "globalDependencies": [
    "**/.env",
    ".env",
    "tsconfig.json",
    "package.json"
  ],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "ANTHROPIC_API_KEY",
    "CI",
    "NEXUS_ROUTER_URL",
    "TWENTY_CRM_URL",
    "TWENTY_CRM_API_KEY",
    "TWENTY_CRM_WORKSPACE_ID",
    "WEBSOCKET_URL",
    "JWT_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "build/**",
        "out/**",
        ".turbo/cache/**"
      ],
      "env": [
        "NEXT_PUBLIC_*",
        "NODE_ENV"
      ],
      "cache": true,
      "outputLogs": "new-only"
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "NEXT_PUBLIC_*",
        "DATABASE_URL",
        "REDIS_URL",
        "PORT"
      ]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/**",
        "__tests__/**",
        "jest.config.*",
        "tsconfig.json"
      ],
      "outputs": [
        "coverage/**",
        ".test-results/**",
        ".turbo/cache/**"
      ],
      "cache": true,
      "outputLogs": "errors-only"
    },
    "test:watch": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [
        "playwright-report/**",
        "test-results/**"
      ]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": [
        "coverage/**"
      ]
    },
    "lint": {
      "dependsOn": [],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "eslint.config.*",
        ".eslintrc*",
        "tsconfig.json"
      ],
      "outputs": [],
      "cache": true,
      "outputLogs": "errors-only"
    },
    "type-check": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tsconfig.json"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tsconfig.json"
      ],
      "outputs": []
    },
    "format": {
      "cache": false,
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "prisma:generate": {
      "cache": true,
      "outputs": [
        "node_modules/.prisma/**",
        ".prisma/**"
      ]
    },
    "prisma:migrate": {
      "cache": false
    },
    "prisma:studio": {
      "cache": false,
      "persistent": true
    },
    "generate": {
      "cache": true,
      "outputs": [
        "node_modules/.prisma/**",
        ".prisma/**",
        "dist/**"
      ]
    },
    "migrate": {
      "cache": false
    },
    "studio": {
      "cache": false,
      "persistent": true
    }
  }
}
