# Agentic Jujutsu Configuration for Project Nyra
# Version control optimized for multi-agent AI development

# Learning Settings
[reasoningbank]
enabled = true
auto_learn = true
min_trajectory_confidence = 0.7

# Quantum Security
[security]
quantum_fingerprints = true
encryption_enabled = false  # Enable with: jj.enableEncryption(key)

# AgentDB Integration
[agentdb]
enabled = true
operation_logging = true
performance_tracking = true

# Multi-Agent Coordination
[coordination]
concurrent_commits = true
auto_conflict_resolution = true
lock_free_mode = true

# Performance
[performance]
cache_enabled = true
snapshot_frequency = "auto"
gc_auto = true
