{
  "_documentation": {
    "project": "Project Nyra - Distributed AI Stack",
    "nodes": {
      "orchestrator": "Remote PC (n8n Host)",
      "worker_prime": "Alienware Area-51 (RTX 5090 + NPU)",
      "worker_beta": "RTX 3090 Node",
      "worker_gamma": "RTX 3060 Node"
    }
  },
  "env": {
    "CLAUDE_FLOW_MODE": "orchestrator",
    "CLAUDE_FLOW_REMOTE_EXECUTION": "true",
    "CLAUDE_FLOW_MEMORY_PERSISTENCE": "true",
    "CLAUDE_FLOW_NEURAL_OPTIMIZATION": "true",
    "RUV_SWARM_ENABLED": "true",
    "HIVE_MIND_ENABLED": "true",
    "RUVECTOR_ENABLED": "true",
    "RUVECTOR_MODE": "distributed",
    "LETTA_ENABLED": "true",
    "GRAPHITI_ENABLED": "true",
    "GRAPHITI_BACKEND": "falkordb",
    "MEM0_ENABLED": "true"
  },
  "performance": {
    "maxConcurrentTasks": 50,
    "gpuWorkers": {
      "enabled": true,
      "loadBalancing": "least-loaded",
      "workers": [
        {
          "name": "worker-5090-prime",
          "url": "http://your-alienware-tailscale-ip:8000",
          "capabilities": ["reasoning", "large-context", "vllm-lmcache"],
          "maxConcurrent": 8
        },
        {
          "name": "worker-npu-efficiency",
          "url": "http://your-alienware-tailscale-ip:9001",
          "capabilities": ["embeddings", "ocr", "onnx-background"],
          "maxConcurrent": 2
        }
      ]
    }
  },
  "memory": {
    "systems": {
      "ruvector": {
        "enabled": true,
        "priority": 1,
        "mode": "distributed",
        "peers": ["your-alienware-tailscale-ip:7890"],
        "vectorDim": 1536,
        "indexType": "hnsw"
      },
      "letta": {
        "enabled": true,
        "serverUrl": "http://your-alienware-tailscale-ip:8283",
        "persistence": "postgresql"
      }
    }
  }
}