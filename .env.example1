# Vertex AI (YOUR $1300 CREDITS)
GOOGLE_CLOUD_PROJECT=your-google-project-id
GOOGLE_CLOUD_LOCATION=us-west2
GOOGLE_APPLICATION_CREDENTIALS=/path/to/vertex-key.json

# LiteLLM configuration
LITELLM_MASTER_KEY=change-me
LITELLM_API_KEY=change-me

# Nexus logging level
NEXUS_LOG=info

# LLM provider API keys
ANTHROPIC_API_KEY=your-anthropic-key
GOOGLE_API_KEY=your-google-api-key
OPENAI_API_KEY=your-openai-key

# Database credentials
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# Gitea integration
GITEA_URL=http://gitea:3000
GITEA_TOKEN=your-gitea-token
GITEA_OWNER=your-gitea-owner
GITEA_REPO=Project-Nyra

# GitHub (optional)
GITHUB_TOKEN=your-github-token

# Infisical integration
INFISICAL_PROJECT_ID=8374cea9-e5e8-4050-bda4-b91f25ab30ef
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=your-client-id
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=your-client-secret

# Additional variables for future services (Twenty CRM, Dify, Activepieces, etc.)
# Define these as needed when enabling additional services.