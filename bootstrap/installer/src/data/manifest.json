{
  "version": "1.0.0",
  "created": "2025-01-14",
  "description": "Bootstrap configuration for Project Nyra 4-PC Windows 11 cluster",
  "deployments": {
    "orchestrator-mini": {
      "enabled": true,
      "displayName": "Orchestrator Mini PC",
      "role": "orchestrator",
      "description": "Primary orchestration and coordination node",
      "components": {
        "claude-code": {
          "enabled": true,
          "displayName": "Claude Code",
          "description": "Claude CLI with 32K token thinking budget",
          "files": [
            {
              "source": "claude-code/settings.json",
              "target": "%APPDATA%/Claude/settings.json"
            }
          ]
        },
        "claude-desktop": {
          "enabled": true,
          "displayName": "Claude Desktop",
          "description": "Claude Desktop with MCP servers",
          "files": [
            {
              "source": "claude-desktop/config.json",
              "target": "%APPDATA%/Claude/claude_desktop_config.json"
            }
          ]
        },
        "claude-flow": {
          "enabled": true,
          "displayName": "Claude Flow",
          "description": "Multi-agent orchestration framework",
          "files": [
            {
              "source": "claude-flow/claude-flow.config.json",
              "target": "%USERPROFILE%/.claude-flow/config.json"
            },
            {
              "source": "claude-flow/.env",
              "target": "%USERPROFILE%/.claude-flow/.env"
            }
          ]
        },
        "wsl-setup": {
          "enabled": true,
          "displayName": "WSL Setup",
          "description": "WSL 2 + Ubuntu 22.04 configuration",
          "files": [
            {
              "source": "wsl/.wslconfig",
              "target": "%USERPROFILE%/.wslconfig"
            }
          ]
        },
        "docker": {
          "enabled": true,
          "displayName": "Docker",
          "description": "Docker Desktop configuration",
          "files": [
            {
              "source": "docker/daemon.json",
              "target": "%APPDATA%/Docker/daemon.json"
            }
          ]
        },
        "gitea": {
          "enabled": false,
          "displayName": "Gitea",
          "description": "Self-hosted Git server in WSL",
          "files": [
            {
              "source": "gitea/docker-compose.yml",
              "target": "wsl:/opt/gitea/docker-compose.yml"
            }
          ]
        },
        "infisical": {
          "enabled": true,
          "displayName": "Infisical",
          "description": "Secrets management",
          "files": [
            {
              "source": "infisical/.env",
              "target": "%USERPROFILE%/.infisical/.env"
            }
          ]
        }
      },
      "features": {
        "wsl_required": true,
        "gpu_required": false,
        "gitea_optional": true
      }
    },
    "worker-rtx3090ti": {
      "enabled": true,
      "displayName": "Worker RTX 3090 Ti",
      "role": "worker",
      "description": "High-performance GPU worker (always-on)",
      "components": {
        "claude-code": {
          "enabled": true,
          "displayName": "Claude Code",
          "description": "Claude CLI with 32K token thinking budget",
          "files": [
            {
              "source": "claude-code/settings.json",
              "target": "%APPDATA%/Claude/settings.json"
            }
          ]
        },
        "claude-flow": {
          "enabled": true,
          "displayName": "Claude Flow",
          "description": "Multi-agent orchestration framework",
          "files": [
            {
              "source": "claude-flow/claude-flow.config.json",
              "target": "%USERPROFILE%/.claude-flow/config.json"
            }
          ]
        },
        "docker": {
          "enabled": true,
          "displayName": "Docker",
          "description": "Docker Desktop configuration",
          "files": [
            {
              "source": "docker/daemon.json",
              "target": "%APPDATA%/Docker/daemon.json"
            }
          ]
        },
        "nvidia": {
          "enabled": true,
          "displayName": "NVIDIA Container Toolkit",
          "description": "GPU acceleration for containers",
          "files": []
        }
      },
      "features": {
        "wsl_required": false,
        "gpu_required": true,
        "wol_enabled": false
      }
    },
    "worker-rtx5090": {
      "enabled": true,
      "displayName": "Worker RTX 5090",
      "role": "worker",
      "description": "Ultra-high-performance GPU worker (mobile)",
      "components": {
        "claude-code": {
          "enabled": true,
          "displayName": "Claude Code",
          "description": "Claude CLI with 32K token thinking budget",
          "files": [
            {
              "source": "claude-code/settings.json",
              "target": "%APPDATA%/Claude/settings.json"
            }
          ]
        },
        "claude-flow": {
          "enabled": true,
          "displayName": "Claude Flow",
          "description": "Multi-agent orchestration framework",
          "files": [
            {
              "source": "claude-flow/claude-flow.config.json",
              "target": "%USERPROFILE%/.claude-flow/config.json"
            }
          ]
        },
        "docker": {
          "enabled": true,
          "displayName": "Docker",
          "description": "Docker Desktop configuration",
          "files": [
            {
              "source": "docker/daemon.json",
              "target": "%APPDATA%/Docker/daemon.json"
            }
          ]
        },
        "nvidia": {
          "enabled": true,
          "displayName": "NVIDIA Container Toolkit",
          "description": "GPU acceleration for containers",
          "files": []
        }
      },
      "features": {
        "wsl_required": false,
        "gpu_required": true,
        "wol_enabled": true,
        "disconnectable": true
      }
    },
    "worker-rtx3060": {
      "enabled": true,
      "displayName": "Worker RTX 3060",
      "role": "worker",
      "description": "Mobile GPU worker (disconnectable)",
      "components": {
        "claude-code": {
          "enabled": true,
          "displayName": "Claude Code",
          "description": "Claude CLI with 32K token thinking budget",
          "files": [
            {
              "source": "claude-code/settings.json",
              "target": "%APPDATA%/Claude/settings.json"
            }
          ]
        },
        "claude-flow": {
          "enabled": true,
          "displayName": "Claude Flow",
          "description": "Multi-agent orchestration framework",
          "files": [
            {
              "source": "claude-flow/claude-flow.config.json",
              "target": "%USERPROFILE%/.claude-flow/config.json"
            }
          ]
        },
        "docker": {
          "enabled": true,
          "displayName": "Docker",
          "description": "Docker Desktop configuration",
          "files": [
            {
              "source": "docker/daemon.json",
              "target": "%APPDATA%/Docker/daemon.json"
            }
          ]
        },
        "nvidia": {
          "enabled": true,
          "displayName": "NVIDIA Container Toolkit",
          "description": "GPU acceleration for containers",
          "files": []
        }
      },
      "features": {
        "wsl_required": false,
        "gpu_required": true,
        "wol_enabled": true,
        "disconnectable": true
      }
    }
  },
  "global_settings": {
    "backup_enabled": true,
    "dry_run_default": false,
    "log_level": "INFO",
    "parallel_deployment": true
  },
  "installation_order": [
    "claude-code",
    "claude-desktop",
    "infisical",
    "wsl-setup",
    "docker",
    "claude-flow",
    "gitea",
    "nvidia"
  ]
}
