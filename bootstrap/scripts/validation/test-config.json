{
  "version": "1.0.0",
  "metadata": {
    "description": "Cloudflare Tunnel Test Configuration for Project Nyra",
    "last_updated": "2026-01-15",
    "author": "Project Nyra Team"
  },
  "tunnel_endpoints": {
    "orchestrator": {
      "container": "nyra-orchestrator",
      "local_port": 8000,
      "public_url": "https://nyra-orchestrator.yourdomain.com",
      "health_path": "/health",
      "tunnel_name": "nyra-orchestrator",
      "cloudflared_container": "nyra-cloudflared-orchestrator"
    },
    "worker_1": {
      "container": "nyra-worker-1",
      "local_port": 8000,
      "public_url": "https://nyra-worker-1.yourdomain.com",
      "health_path": "/health",
      "tunnel_name": "nyra-worker-1",
      "cloudflared_container": "nyra-cloudflared-worker-1"
    },
    "worker_2": {
      "container": "nyra-worker-2",
      "local_port": 8000,
      "public_url": "https://nyra-worker-2.yourdomain.com",
      "health_path": "/health",
      "tunnel_name": "nyra-worker-2",
      "cloudflared_container": "nyra-cloudflared-worker-2"
    },
    "worker_3": {
      "container": "nyra-worker-3",
      "local_port": 8000,
      "public_url": "https://nyra-worker-3.yourdomain.com",
      "health_path": "/health",
      "tunnel_name": "nyra-worker-3",
      "cloudflared_container": "nyra-cloudflared-worker-3"
    }
  },
  "test_scenarios": {
    "tunnel_creation": {
      "enabled": true,
      "priority": "critical",
      "description": "Verify tunnel containers can start and connect",
      "tests": [
        {
          "name": "Container startup",
          "type": "docker_ps",
          "expected": "running",
          "timeout_seconds": 30
        },
        {
          "name": "Tunnel authentication",
          "type": "log_check",
          "pattern": "Registered tunnel connection",
          "timeout_seconds": 60
        },
        {
          "name": "Connection persistence",
          "type": "continuous_check",
          "duration_seconds": 300,
          "check_interval": 30
        }
      ]
    },
    "service_exposure": {
      "enabled": true,
      "priority": "critical",
      "description": "Validate services are accessible through tunnels",
      "tests": [
        {
          "name": "Public endpoint accessibility",
          "type": "http_request",
          "method": "GET",
          "expected_status": [200, 204],
          "timeout_seconds": 10,
          "retry_count": 3
        },
        {
          "name": "SSL certificate validation",
          "type": "ssl_check",
          "min_tls_version": "1.2",
          "allowed_protocols": ["TLSv1.2", "TLSv1.3"]
        },
        {
          "name": "Response headers",
          "type": "header_check",
          "required_headers": [
            "Content-Type",
            "X-Content-Type-Options",
            "Strict-Transport-Security"
          ]
        }
      ]
    },
    "failover_handling": {
      "enabled": true,
      "priority": "high",
      "description": "Test tunnel resilience and recovery",
      "tests": [
        {
          "name": "Graceful restart",
          "type": "restart_test",
          "max_downtime_seconds": 30,
          "reconnect_timeout": 60
        },
        {
          "name": "Multiple tunnel coordination",
          "type": "coordination_test",
          "min_tunnels": 2,
          "check_conflicts": true
        },
        {
          "name": "Connection state recovery",
          "type": "state_check",
          "verify_session_persistence": false
        }
      ]
    },
    "access_policy_enforcement": {
      "enabled": true,
      "priority": "critical",
      "description": "Verify authentication and authorization",
      "tests": [
        {
          "name": "Unauthorized access prevention",
          "type": "security_test",
          "protected_paths": [
            "/admin",
            "/internal",
            "/metrics",
            "/.env",
            "/config",
            "/.git",
            "/secrets"
          ],
          "expected_status": [401, 403, 404],
          "timeout_seconds": 5
        },
        {
          "name": "API key validation",
          "type": "auth_test",
          "auth_type": "bearer",
          "expected_status_with_key": [200, 204],
          "expected_status_without_key": [401, 403]
        },
        {
          "name": "Rate limiting",
          "type": "rate_limit_test",
          "rapid_requests": 100,
          "expected_limit_status": 429,
          "window_seconds": 60
        }
      ]
    },
    "dns_resolution": {
      "enabled": true,
      "priority": "high",
      "description": "Validate DNS configuration and propagation",
      "tests": [
        {
          "name": "A record resolution",
          "type": "dns_query",
          "record_type": "A",
          "resolvers": ["1.1.1.1", "8.8.8.8", "9.9.9.9"],
          "expected_ip_ranges": [
            "104.16.0.0/12",
            "172.64.0.0/13",
            "104.17.0.0/16",
            "104.18.0.0/16"
          ]
        },
        {
          "name": "AAAA record resolution",
          "type": "dns_query",
          "record_type": "AAAA",
          "optional": true
        },
        {
          "name": "DNS propagation consistency",
          "type": "dns_consistency",
          "resolvers": ["1.1.1.1", "8.8.8.8", "9.9.9.9"],
          "require_all_consistent": true
        }
      ]
    },
    "performance_validation": {
      "enabled": true,
      "priority": "medium",
      "description": "Measure tunnel performance characteristics",
      "tests": [
        {
          "name": "Latency measurement",
          "type": "latency_test",
          "iterations": 10,
          "thresholds": {
            "excellent_ms": 200,
            "good_ms": 500,
            "acceptable_ms": 1000
          }
        },
        {
          "name": "Throughput test",
          "type": "throughput_test",
          "duration_seconds": 10,
          "concurrent_connections": 10,
          "min_requests_per_second": 50
        },
        {
          "name": "Concurrent connections",
          "type": "concurrent_test",
          "concurrent_requests": 20,
          "min_success_rate": 95.0
        },
        {
          "name": "Sustained load",
          "type": "sustained_load_test",
          "duration_seconds": 30,
          "requests_per_second": 10,
          "max_error_rate": 5.0
        }
      ]
    },
    "security_validation": {
      "enabled": true,
      "priority": "critical",
      "description": "Verify security configurations",
      "tests": [
        {
          "name": "TLS configuration",
          "type": "tls_test",
          "min_version": "1.2",
          "forbidden_ciphers": [
            "RC4",
            "DES",
            "3DES",
            "MD5",
            "NULL",
            "EXPORT"
          ],
          "required_ciphers": [
            "TLS_AES_128_GCM_SHA256",
            "TLS_AES_256_GCM_SHA384",
            "TLS_CHACHA20_POLY1305_SHA256"
          ]
        },
        {
          "name": "Security headers",
          "type": "header_security",
          "required_headers": {
            "Strict-Transport-Security": "max-age=31536000",
            "X-Content-Type-Options": "nosniff",
            "X-Frame-Options": "(DENY|SAMEORIGIN)",
            "X-XSS-Protection": "1; mode=block"
          },
          "recommended_headers": {
            "Content-Security-Policy": ".*",
            "Referrer-Policy": ".*",
            "Permissions-Policy": ".*"
          }
        },
        {
          "name": "SQL injection protection",
          "type": "injection_test",
          "payloads": [
            "' OR '1'='1",
            "admin' --",
            "1' UNION SELECT NULL--",
            "'; DROP TABLE users; --"
          ],
          "expected_status": [400, 403],
          "should_sanitize": true
        },
        {
          "name": "XSS protection",
          "type": "xss_test",
          "payloads": [
            "<script>alert('XSS')</script>",
            "<img src=x onerror=alert('XSS')>",
            "javascript:alert('XSS')",
            "<svg/onload=alert('XSS')>"
          ],
          "should_sanitize": true
        },
        {
          "name": "Port exposure analysis",
          "type": "port_scan",
          "scan_ports": [22, 80, 443, 3306, 5432, 6379, 27017],
          "allowed_open_ports": [80, 443],
          "timeout_seconds": 30
        }
      ]
    },
    "integration_flow": {
      "enabled": true,
      "priority": "critical",
      "description": "End-to-end integration test",
      "phases": [
        {
          "name": "Setup",
          "type": "setup",
          "steps": [
            {
              "action": "validate_compose_config",
              "timeout_seconds": 10
            },
            {
              "action": "check_environment_variables",
              "required_vars": ["CLOUDFLARED_TOKEN"]
            }
          ]
        },
        {
          "name": "Start Services",
          "type": "deployment",
          "steps": [
            {
              "action": "docker_compose_up",
              "compose_file": "docker-compose.infisical.yml",
              "timeout_seconds": 120
            },
            {
              "action": "wait_for_services",
              "services": [
                "nyra-orchestrator",
                "metamcp-gateway-enhanced",
                "claude-flow-mcp"
              ],
              "timeout_seconds": 60
            }
          ]
        },
        {
          "name": "Connect Tunnel",
          "type": "tunnel_setup",
          "steps": [
            {
              "action": "wait_for_tunnel_connection",
              "tunnel_container": "nyra-cloudflared-orchestrator",
              "timeout_seconds": 60,
              "log_pattern": "Connection.*registered"
            },
            {
              "action": "verify_tunnel_id",
              "extract_from_logs": true
            }
          ]
        },
        {
          "name": "Service Access",
          "type": "validation",
          "steps": [
            {
              "action": "test_public_endpoint",
              "url": "https://nyra-orchestrator.yourdomain.com/health",
              "expected_status": [200, 204],
              "timeout_seconds": 30,
              "retry_count": 5
            },
            {
              "action": "test_all_endpoints",
              "endpoints": "all_configured",
              "parallel": true
            }
          ]
        },
        {
          "name": "Health Checks",
          "type": "health_validation",
          "steps": [
            {
              "action": "check_service_health",
              "services": [
                {"name": "Orchestrator", "url": "http://localhost:8000/health"},
                {"name": "MetaMCP Gateway", "url": "http://localhost:8005/health"},
                {"name": "Claude Flow MCP", "url": "http://localhost:8003/health"},
                {"name": "Infisical MCP", "url": "http://localhost:8006/health"}
              ],
              "timeout_seconds": 10
            }
          ]
        },
        {
          "name": "Cleanup",
          "type": "teardown",
          "optional": true,
          "steps": [
            {
              "action": "docker_compose_down",
              "compose_file": "docker-compose.infisical.yml",
              "remove_volumes": false,
              "timeout_seconds": 60
            }
          ]
        }
      ]
    }
  },
  "performance_thresholds": {
    "latency": {
      "excellent": {
        "max_avg_ms": 200,
        "max_p95_ms": 300,
        "max_p99_ms": 500
      },
      "good": {
        "max_avg_ms": 500,
        "max_p95_ms": 750,
        "max_p99_ms": 1000
      },
      "acceptable": {
        "max_avg_ms": 1000,
        "max_p95_ms": 1500,
        "max_p99_ms": 2000
      }
    },
    "throughput": {
      "min_requests_per_second": 50,
      "target_requests_per_second": 100,
      "max_time_per_request_ms": 100
    },
    "concurrent_connections": {
      "min_success_rate_percent": 95.0,
      "target_success_rate_percent": 99.0,
      "max_concurrent": 100
    },
    "availability": {
      "min_uptime_percent": 99.0,
      "max_downtime_seconds": 30,
      "max_failover_time_seconds": 60
    }
  },
  "security_requirements": {
    "tls": {
      "min_version": "1.2",
      "preferred_version": "1.3",
      "allowed_ciphers": [
        "TLS_AES_128_GCM_SHA256",
        "TLS_AES_256_GCM_SHA384",
        "TLS_CHACHA20_POLY1305_SHA256",
        "ECDHE-RSA-AES128-GCM-SHA256",
        "ECDHE-RSA-AES256-GCM-SHA384"
      ],
      "certificate_min_days_valid": 30
    },
    "headers": {
      "required": {
        "Strict-Transport-Security": true,
        "X-Content-Type-Options": true,
        "X-Frame-Options": true
      },
      "recommended": {
        "Content-Security-Policy": true,
        "X-XSS-Protection": true,
        "Referrer-Policy": true,
        "Permissions-Policy": true
      }
    },
    "authentication": {
      "enforce_on_paths": [
        "/admin",
        "/internal",
        "/metrics",
        "/api/v1/admin"
      ],
      "rate_limiting": {
        "enabled": true,
        "max_requests_per_minute": 60,
        "burst_size": 10
      }
    },
    "vulnerability_scanning": {
      "sql_injection": true,
      "xss": true,
      "path_traversal": true,
      "command_injection": false,
      "xxe": false
    }
  },
  "dns_configuration": {
    "domains": [
      "nyra-orchestrator.yourdomain.com",
      "nyra-worker-1.yourdomain.com",
      "nyra-worker-2.yourdomain.com",
      "nyra-worker-3.yourdomain.com"
    ],
    "nameservers": [
      "1.1.1.1",
      "8.8.8.8",
      "9.9.9.9"
    ],
    "cloudflare_ip_ranges": {
      "ipv4": [
        "104.16.0.0/12",
        "172.64.0.0/13",
        "104.17.0.0/16",
        "104.18.0.0/16",
        "104.19.0.0/16",
        "104.20.0.0/14",
        "104.24.0.0/14",
        "172.64.0.0/13",
        "173.245.48.0/20",
        "103.21.244.0/22",
        "103.22.200.0/22",
        "103.31.4.0/22",
        "141.101.64.0/18",
        "108.162.192.0/18",
        "190.93.240.0/20",
        "188.114.96.0/20",
        "197.234.240.0/22",
        "198.41.128.0/17"
      ],
      "ipv6": [
        "2606:4700::/32",
        "2803:f800::/32",
        "2405:b500::/32",
        "2405:8100::/32",
        "2a06:98c0::/29",
        "2c0f:f248::/32"
      ]
    },
    "ttl_seconds": 300,
    "dns_propagation_timeout_seconds": 3600
  },
  "monitoring": {
    "metrics_collection": {
      "enabled": true,
      "interval_seconds": 60,
      "retention_days": 30
    },
    "metrics": [
      {
        "name": "tunnel_connection_status",
        "type": "gauge",
        "description": "1 if tunnel is connected, 0 otherwise"
      },
      {
        "name": "tunnel_latency_ms",
        "type": "histogram",
        "description": "Request latency through tunnel in milliseconds"
      },
      {
        "name": "tunnel_request_total",
        "type": "counter",
        "description": "Total number of requests through tunnel"
      },
      {
        "name": "tunnel_request_errors",
        "type": "counter",
        "description": "Number of failed requests"
      },
      {
        "name": "tunnel_ssl_cert_expiry_days",
        "type": "gauge",
        "description": "Days until SSL certificate expires"
      }
    ],
    "alerts": [
      {
        "name": "Tunnel Disconnected",
        "condition": "tunnel_connection_status == 0",
        "duration_seconds": 60,
        "severity": "critical"
      },
      {
        "name": "High Latency",
        "condition": "tunnel_latency_ms > 1000",
        "duration_seconds": 300,
        "severity": "warning"
      },
      {
        "name": "High Error Rate",
        "condition": "rate(tunnel_request_errors[5m]) > 0.05",
        "duration_seconds": 300,
        "severity": "critical"
      },
      {
        "name": "SSL Certificate Expiring",
        "condition": "tunnel_ssl_cert_expiry_days < 30",
        "duration_seconds": 0,
        "severity": "warning"
      }
    ]
  },
  "test_data": {
    "sample_payloads": {
      "sql_injection": [
        "' OR '1'='1",
        "admin' --",
        "1' UNION SELECT NULL--",
        "'; DROP TABLE users; --",
        "1' AND '1'='1",
        "' OR 'a'='a"
      ],
      "xss": [
        "<script>alert('XSS')</script>",
        "<img src=x onerror=alert('XSS')>",
        "javascript:alert('XSS')",
        "<svg/onload=alert('XSS')>",
        "<iframe src=javascript:alert('XSS')>",
        "<body onload=alert('XSS')>"
      ],
      "path_traversal": [
        "../../../etc/passwd",
        "..\\..\\..\\windows\\system32\\config\\sam",
        "....//....//....//etc/passwd",
        "%2e%2e%2f%2e%2e%2f%2e%2e%2fetc%2fpasswd"
      ]
    },
    "valid_api_requests": [
      {
        "path": "/health",
        "method": "GET",
        "expected_status": [200, 204]
      },
      {
        "path": "/api/v1/status",
        "method": "GET",
        "expected_status": [200]
      }
    ]
  },
  "reporting": {
    "output_formats": ["console", "json", "html"],
    "log_level": "INFO",
    "log_retention_days": 30,
    "max_log_files": 10,
    "include_screenshots": false,
    "generate_pdf_report": false,
    "email_report": {
      "enabled": false,
      "recipients": [],
      "on_failure_only": true
    }
  }
}
