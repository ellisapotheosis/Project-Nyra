{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "\uE0B6",
          "trailing_diamond": "\uE0B4",
          "background": "#000000",
          "foreground": "#766EEF",
          "template": " {{ .Icon }} ",
          "properties": {
            "windows": "\uF17A"
          }
        },
        {
          "type": "session",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4",
          "background": "#000000",
          "foreground": "#9A7CF0",
          "template": " {{ if .SSHSession }}\uF817 {{ end }}{{ .UserName }} ",
          "properties": {
            "display_host": false
          }
        },
        {
          "type": "path",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4",
          "background": "#000000",
          "foreground": "#BC6AF0",
          "template": " {{ if .UpstreamURL }}\uF09B {{ end }}\uF07C {{ .Path }} ",
          "properties": {
            "style": "unique",
            "folder_separator_template": "<#C95B90>/<#CC69E1>",
            "max_depth": 4,
            "hide_root_location": true,
            "folder_icon": "\uF07C",
            "home_icon": "\uF015"
          }
        },
        {
          "type": "git",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4",
          "background": "#000000",
          "foreground": "#C6FBB7",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#000000{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#000000{{ end }}",
            "{{ if gt .Ahead 0 }}#000000{{ end }}",
            "{{ if gt .Behind 0 }}#000000{{ end }}",
            "{{ if .UpstreamGone }}#000000{{ end }}"
          ],
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#CC69E1{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#C95B90{{ end }}",
            "{{ if gt .Ahead 0 }}#A8F9B0{{ end }}",
            "{{ if gt .Behind 0 }}#BC6AF0{{ end }}",
            "{{ if .UpstreamGone }}#C95B90{{ end }}"
          ],
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uF044({{ .Working.String }}){{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uF046({{ .Staging.String }}){{ end }}{{ if gt .StashCount 0 }} \uF01C{{ .StashCount }}{{ end }}{{ if gt .WorktreeCount 0 }} \uF1BB{{ .WorktreeCount }}{{ end }} ",
          "properties": {
            "branch_icon": "\uE0A0 ",
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "fetch_stash_count": true,
            "fetch_worktree_count": true,
            "display_stash_count": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "kubectl",
          "style": "diamond",
          "leading_diamond": "\uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "#000000",
          "foreground": "#86A3F3",
          "template": " \uFD31 {{.Context}}{{if .Namespace}} :: {{.Namespace}}{{end}} ",
          "properties": {
            "display_error": false
          }
        },
        {
          "type": "aws",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "#000000",
          "foreground": "#B2F9EC",
          "template": " \uF270 {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} ",
          "properties": {
            "display_default": false
          }
        },
        {
          "type": "sysinfo",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "#000000",
          "foreground": "#A8F9B0",
          "template": " \uF4BC {{ round .PhysicalPercentUsed .Precision }}% ",
          "properties": {
            "precision": 1
          }
        },
        {
          "type": "battery",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "#000000",
          "foreground_templates": [
            "{{ if .Error }}#C95B90{{ end }}",
            "{{ if le .Percentage 15 }}#C95B90{{ end }}",
            "{{ if and (ge .Percentage 16) (le .Percentage 30) }}#BC6AF0{{ end }}",
            "{{ if and (ge .Percentage 31) (le .Percentage 50) }}#CC69E1{{ end }}",
            "{{ if and (ge .Percentage 51) (le .Percentage 70) }}#86A3F3{{ end }}",
            "{{ if and (ge .Percentage 71) (le .Percentage 90) }}#A8F9B0{{ end }}",
            "{{ if ge .Percentage 91 }}#C6FBB7{{ end }}"
          ],
          "template": " {{ if .Error }}\uF00D{{ else }}{{ if eq \"Charging\" .State.String }}\uF0E7{{ else if eq \"Discharging\" .State.String }}\uF578{{ else if eq \"Full\" .State.String }}\uF240{{ else }}\uF578{{ end }} {{ .Percentage }}%{{ end }} "
        },
        {
          "type": "time",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "#000000",
          "foreground_templates": [
            "{{ if regexMatch \"^(06|07|08|09|10|11):\" (.CurrentDate | date .Format) }}#C6FBB7{{ end }}",
            "{{ if regexMatch \"^(12|13|14):\" (.CurrentDate | date .Format) }}#A8F9B0{{ end }}",
            "{{ if regexMatch \"^(15|16|17):\" (.CurrentDate | date .Format) }}#B2F9EC{{ end }}",
            "{{ if regexMatch \"^(18|19|20|21|22|23):\" (.CurrentDate | date .Format) }}#86A3F3{{ end }}",
            "{{ if regexMatch \"^(00|01|02|03|04|05):\" (.CurrentDate | date .Format) }}#766EEF{{ end }}"
          ],
          "template": " \uF017 {{ .CurrentDate | date .Format }} ",
          "properties": {
            "time_format": "15:04"
          }
        },
        {
          "type": "executiontime",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4",
          "background": "#000000",
          "foreground_templates": [
            "{{ if lt .Ms 500 }}#C6FBB7{{ end }}",
            "{{ if and (ge .Ms 500) (lt .Ms 2000) }}#A8F9B0{{ end }}",
            "{{ if and (ge .Ms 2000) (lt .Ms 10000) }}#B2F9EC{{ end }}",
            "{{ if and (ge .Ms 10000) (lt .Ms 30000) }}#CC69E1{{ end }}",
            "{{ if ge .Ms 30000 }}#C95B90{{ end }}"
          ],
          "template": " \uF252 {{ .FormattedMs }} ",
          "properties": {
            "threshold": 100,
            "style": "austin"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "angular",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "#000000",
          "foreground": "#C95B90",
          "template": " \uE753 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "properties": {
            "fetch_version": true
          }
        },
        {
          "type": "node",
          "style": "diamond",
          "leading_diamond": "\uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "#000000",
          "foreground": "#86A3F3",
          "template": " \uE718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "properties": {
            "fetch_version": true,
            "display_mode": "files"
          }
        },
        {
          "type": "python",
          "style": "diamond",
          "leading_diamond": "\uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "#000000",
          "foreground": "#B2F9EC",
          "template": " \uE235 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}{{ if .Venv }} \uE621 {{ .Venv }}{{ end }} ",
          "properties": {
            "display_mode": "files",
            "fetch_virtual_env": true
          }
        },
        {
          "type": "go",
          "style": "diamond",
          "leading_diamond": "\uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "#000000",
          "foreground": "#A8F9B0",
          "template": " \uE626 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "properties": {
            "fetch_version": true
          }
        },
        {
          "type": "rust",
          "style": "diamond",
          "leading_diamond": "\uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "#000000",
          "foreground": "#CC69E1",
          "template": " \uE7A8 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "properties": {
            "display_mode": "files",
            "fetch_version": true
          }
        },
        {
          "type": "java",
          "style": "diamond",
          "leading_diamond": "\uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "#000000",
          "foreground": "#BC6AF0",
          "template": " \uE204 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "properties": {
            "fetch_version": true
          }
        },
        {
          "type": "dotnet",
          "style": "diamond",
          "leading_diamond": "\uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "#000000",
          "foreground": "#766EEF",
          "template": " \uE77F {{ if .Unsupported }}\uF071{{ else }}{{ .Full }}{{ end }} ",
          "properties": {
            "fetch_version": true
          }
        },
        {
          "type": "php",
          "style": "diamond",
          "leading_diamond": "\uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "#000000",
          "foreground": "#9A7CF0",
          "template": " \uE608 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "properties": {
            "fetch_version": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "root",
          "style": "diamond",
          "leading_diamond": "\uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "#000000",
          "foreground": "#C95B90",
          "template": " \uF0E7 {{ if .Root }}ADMIN{{ end }} "
        },
        {
          "type": "text",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "#000000",
          "background_templates": [
            "{{ if .Segments.Session.SSHSession }}#000000{{ end }}"
          ],
          "foreground": "#86A3F3",
          "foreground_templates": [
            "{{ if .Segments.Session.SSHSession }}#B2F9EC{{ end }}"
          ],
          "template": "{{ if .Segments.Session.SSHSession }} \uF817 SSH {{ end }}"
        },
        {
          "type": "status",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "#000000",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#C95B90{{ end }}",
            "{{ if eq .Code 0 }}#A8F9B0{{ end }}"
          ],
          "template": " {{ if gt .Code 0 }}\uD83D\uDC94{{ else }}\u2665{{ end }} {{ if ne .Code 0 }}{{ .Code }}{{ end }} ",
          "properties": {
            "always_enabled": true
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#9A7CF0",
          "template": "\u276F "
        }
      ]
    }
  ],
  "transient_prompt": {
    "template": "<#9A7CF0>\u276F</> "
  },
  "secondary_prompt": {
    "template": "<#766EEF>...</> "
  },
  "console_title_template": "{{ if .Root }}# {{ end }}{{ .Folder }}{{ if .Segments.Git.HEAD }} - {{ .Segments.Git.HEAD }}{{ end }} - {{ .Shell }}",
  "final_space": true,
  "palette": {
    "heliotrope": "#BC6AF0",
    "rose-pink": "#C95B90", 
    "mint-green": "#C6FBB7",
    "neon-green": "#A8F9B0",
    "cyan": "#B2F9EC",
    "blue": "#86A3F3",
    "pink": "#CC69E1",
    "xulbux-purple": "#766EEF",
    "purple": "#9A7CF0"
  },
  "version": 3
}