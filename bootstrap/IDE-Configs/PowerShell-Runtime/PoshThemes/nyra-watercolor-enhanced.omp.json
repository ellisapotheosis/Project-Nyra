{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "\uE0B6",
          "trailing_diamond": "\uE0B4",
          "background": "transparent",
          "foreground": "#9D7FEA",
          "template": " {{ .Icon }} ",
          "properties": {
            "windows": "\uF17A",
            "linux": "\uF17C",
            "wsl": "\uF17A\uF83C"
          }
        },
        {
          "type": "session",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4",
          "background": "transparent",
          "foreground": "#B794F6",
          "template": " {{ if .SSHSession }}\uF817 {{ end }}{{ .UserName }}{{ if .Env.WSL_DISTRO_NAME }} \uF83C {{ .Env.WSL_DISTRO_NAME }}{{ end }} ",
          "properties": {
            "display_host": false
          }
        },
        {
          "type": "path",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4",
          "background": "transparent",
          "foreground": "#A8E6CF",
          "template": " {{ if contains \"project-nyra\" .Path }}\uF1D0 NYRA {{ else if contains \"Project-Nyra\" .Path }}\uF1D0 NYRA {{ else }}\uF07C{{ end }} {{ .Path }} ",
          "properties": {
            "style": "unique",
            "folder_separator_icon": "/",
            "max_depth": 4,
            "hide_root_location": true,
            "folder_icon": "\uF07C",
            "home_icon": "\uF015"
          }
        },
        {
          "type": "git",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4",
          "background": "transparent",
          "foreground": "#88D5C5",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FFB3D9{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#FF8DC7{{ end }}",
            "{{ if gt .Ahead 0 }}#A8E6CF{{ end }}",
            "{{ if gt .Behind 0 }}#87CEEB{{ end }}"
          ],
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uF044({{ .Working.String }}){{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uF046({{ .Staging.String }}){{ end }}{{ if gt .StashCount 0 }} \uF01C{{ .StashCount }}{{ end }} ",
          "properties": {
            "branch_icon": "\uE0A0 ",
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "fetch_stash_count": true
          }
        },
        {
          "type": "gitversion",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4",
          "background": "transparent",
          "foreground": "#88D5C5",
          "template": " \uF1D3 {{ .Major }}.{{ .Minor }}.{{ .Patch }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "ui5tooling",
          "style": "diamond",
          "leading_diamond": "\uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "transparent",
          "foreground": "#FFB3D9",
          "template": " \uE73C UV {{ .Full }} ",
          "properties": {
            "fetch_version": true,
            "display_mode": "context"
          }
        },
        {
          "type": "node",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "transparent",
          "foreground": "#A8E6CF",
          "template": " \uE718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "properties": {
            "fetch_version": true,
            "display_mode": "context"
          }
        },
        {
          "type": "docker",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "transparent",
          "foreground": "#87CEEB",
          "template": " \uF308 {{ .Context }} ",
          "properties": {
            "display_default": false
          }
        },
        {
          "type": "sysinfo",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "transparent",
          "foreground": "#88D5C5",
          "template": " \uF4BC {{ round .PhysicalPercentUsed .Precision }}% ",
          "properties": {
            "precision": 0
          }
        },
        {
          "type": "battery",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "transparent",
          "foreground_templates": [
            "{{ if le .Percentage 15 }}#FFB3D9{{ end }}",
            "{{ if and (ge .Percentage 16) (le .Percentage 50) }}#FF8DC7{{ end }}",
            "{{ if and (ge .Percentage 51) (le .Percentage 80) }}#A8E6CF{{ end }}",
            "{{ if ge .Percentage 81 }}#88D5C5{{ end }}"
          ],
          "template": " {{ if eq \"Charging\" .State.String }}\uF0E7{{ else if eq \"Discharging\" .State.String }}\uF578{{ else if eq \"Full\" .State.String }}\uF240{{ else }}\uF578{{ end }} {{ .Percentage }}% "
        },
        {
          "type": "time",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "transparent",
          "foreground": "#B794F6",
          "template": " \uF017 {{ .CurrentDate | date .Format }} ",
          "properties": {
            "time_format": "15:04"
          }
        },
        {
          "type": "executiontime",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4",
          "background": "transparent",
          "foreground_templates": [
            "{{ if lt .Ms 500 }}#88D5C5{{ end }}",
            "{{ if and (ge .Ms 500) (lt .Ms 2000) }}#A8E6CF{{ end }}",
            "{{ if and (ge .Ms 2000) (lt .Ms 10000) }}#87CEEB{{ end }}",
            "{{ if and (ge .Ms 10000) (lt .Ms 30000) }}#FFB3D9{{ end }}",
            "{{ if ge .Ms 30000 }}#FF8DC7{{ end }}"
          ],
          "template": " \uF252 {{ .FormattedMs }} ",
          "properties": {
            "threshold": 100,
            "style": "austin"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "root",
          "style": "diamond",
          "leading_diamond": "\uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "transparent",
          "foreground": "#FF8DC7",
          "template": " \uF0E7 ADMIN "
        },
        {
          "type": "status",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "transparent",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#FFB3D9{{ end }}",
            "{{ if eq .Code 0 }}#88D5C5{{ end }}"
          ],
          "template": " {{ if gt .Code 0 }}\uD83D\uDC94{{ else }}\u2665{{ end }} {{ if ne .Code 0 }}{{ .Code }}{{ end }} ",
          "properties": {
            "always_enabled": true
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#9D7FEA",
          "template": "\u276F "
        }
      ]
    }
  ],
  "transient_prompt": {
    "template": "<#9D7FEA>\u276F</> "
  },
  "secondary_prompt": {
    "template": "<#87CEEB>...</> "
  },
  "console_title_template": "{{ if .Root }}# {{ end }}{{ .Folder }}{{ if .Segments.Git.HEAD }} - {{ .Segments.Git.HEAD }}{{ end }} - {{ .Shell }}",
  "final_space": true,
  "palette": {
    "deep-purple": "#6A4C93",
    "soft-purple": "#9D7FEA",
    "lavender": "#B794F6",
    "seafoam": "#A8E6CF",
    "mint": "#88D5C5",
    "pale-blue": "#87CEEB",
    "turquoise": "#77C7D3",
    "watermelon": "#FFB3D9",
    "neon-pink": "#FF8DC7",
    "hot-pink": "#FF69B4"
  },
  "version": 3
}
