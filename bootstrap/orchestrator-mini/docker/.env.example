# ==============================================================================
# Environment Variables Template for Orchestrator-Mini Databases
# ==============================================================================
# Copy this file to .env and fill in the values
# Or use Infisical to manage secrets (recommended for production)
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   docker-compose up -d
# ==============================================================================

# ==============================================================================
# POSTGRESQL CONFIGURATION
# ==============================================================================

# Root credentials
POSTGRES_ROOT_USER=postgres
POSTGRES_ROOT_PASSWORD=changeme_postgres_root_password

# Application user credentials
NYRA_APP_USER=nyra_app_user
NYRA_APP_PASSWORD=changeme_app_password

# Auth service user
NYRA_AUTH_USER=nyra_auth_user
NYRA_AUTH_PASSWORD=changeme_auth_password

# Analytics service user
NYRA_ANALYTICS_USER=nyra_analytics_user
NYRA_ANALYTICS_PASSWORD=changeme_analytics_password

# Read-only user
NYRA_READONLY_USER=nyra_readonly_user
NYRA_READONLY_PASSWORD=changeme_readonly_password

# Infisical backend user
INFISICAL_DB_USER=infisical_user
INFISICAL_DB_PASSWORD=changeme_infisical_password

# PostgreSQL tuning (optional)
POSTGRES_PORT=5432
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================

REDIS_PASSWORD=changeme_redis_password
REDIS_PORT=6379
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ==============================================================================
# MONGODB CONFIGURATION
# ==============================================================================

# Root credentials
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme_mongo_root_password

# Application user
MONGO_APP_USER=nyra_app_user
MONGO_APP_PASSWORD=changeme_mongo_app_password

# Read-only user
MONGO_READONLY_USER=nyra_readonly_user
MONGO_READONLY_PASSWORD=changeme_mongo_readonly_password

# Backup user
MONGO_BACKUP_USER=nyra_backup_user
MONGO_BACKUP_PASSWORD=changeme_mongo_backup_password

# Replica set configuration
MONGO_REPLICA_SET_NAME=rs0
MONGO_CACHE_SIZE_GB=0.5
MONGODB_PORT=27017

# ==============================================================================
# AGENTDB (QDRANT) CONFIGURATION
# ==============================================================================

# API key (optional, leave empty to disable auth)
QDRANT_API_KEY=

# HNSW index parameters
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=100

# Performance tuning
QDRANT_MAX_SEARCH_THREADS=4

# Ports
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ==============================================================================
# GITEA CONFIGURATION (Optional - Local Git Server)
# ==============================================================================

# Database credentials
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=changeme_gitea_db_password
GITEA_DB_NAME=gitea

# Server configuration
GITEA_DOMAIN=localhost

# Security (MUST CHANGE - minimum 32 characters)
GITEA_SECRET_KEY=changeme-secret-key-minimum-32-characters-required-here
GITEA_INTERNAL_TOKEN=changeme-internal-token-also-needs-to-be-long

# Admin user (created on first start)
GITEA_ADMIN_USER=admin
GITEA_ADMIN_PASSWORD=changeme_gitea_admin_password
GITEA_ADMIN_EMAIL=admin@localhost

# Logging
GITEA_LOG_LEVEL=Info

# ==============================================================================
# CLOUDFLARE TUNNEL CONFIGURATION
# ==============================================================================

# Get this token from Cloudflare Zero Trust Dashboard
CLOUDFLARE_TUNNEL_TOKEN_ORCHESTRATOR=your_cloudflare_tunnel_token_here

# Tunnel configuration
CLOUDFLARE_TUNNEL_LOGLEVEL=info
CLOUDFLARE_TUNNEL_METRICS=0.0.0.0:9126

# ==============================================================================
# INFISICAL INTEGRATION (Optional - for secret management)
# ==============================================================================

# If using Infisical, these variables will be automatically populated
# Leave empty if not using Infisical
INFISICAL_TOKEN=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev
