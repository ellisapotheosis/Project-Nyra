# =============================================================================
# WORKER-3060 - RTX 3060 12GB VRAM Configuration
# =============================================================================
# PC Spec: RTX 3060 (12GB VRAM)
# Role: Tier 3 - Fast processing, embeddings, code generation, document OCR
# Models: CodeLlama 34B, Qwen 2.5 32B, Gemma 2 27B
# =============================================================================

# ========================
# WORKER IDENTIFICATION
# ========================
WORKER_ID=worker-3060
WORKER_TIER=3
WORKER_ROLE=fast-processing
TAILSCALE_HOSTNAME=worker-3060.tail-net.ts.net

# ========================
# GPU CONFIGURATION
# ========================
GPU_TYPE=RTX_3060
GPU_VRAM_GB=12
GPU_COMPUTE_CAPABILITY=8.6
CUDA_VISIBLE_DEVICES=0
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ========================
# OLLAMA CONFIGURATION
# ========================
OLLAMA_HOST=0.0.0.0:11434
OLLAMA_MODELS=/models
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PARALLEL=3
OLLAMA_MAX_LOADED_MODELS=3

# Primary Model: CodeLlama 34B (quantized Q4_K_M for 12GB VRAM)
OLLAMA_PRIMARY_MODEL=codellama:34b-q4
OLLAMA_PRIMARY_CONTEXT=8192
OLLAMA_PRIMARY_BATCH_SIZE=256
OLLAMA_PRIMARY_GPU_LAYERS=40

# Secondary Model: Qwen 2.5 32B (quantized Q4_K_M)
OLLAMA_SECONDARY_MODEL=qwen2.5:32b-q4
OLLAMA_SECONDARY_CONTEXT=8192
OLLAMA_SECONDARY_BATCH_SIZE=256
OLLAMA_SECONDARY_GPU_LAYERS=40

# Tertiary Model: Gemma 2 27B (quantized Q4_K_M)
OLLAMA_TERTIARY_MODEL=gemma2:27b-q4
OLLAMA_TERTIARY_CONTEXT=8192
OLLAMA_TERTIARY_BATCH_SIZE=256
OLLAMA_TERTIARY_GPU_LAYERS=35

# ========================
# MODEL-SPECIFIC PARAMETERS
# ========================
# CodeLlama 34B - Optimized for code generation and API work
CODELLAMA_TEMPERATURE=0.2
CODELLAMA_TOP_P=0.9
CODELLAMA_TOP_K=40
CODELLAMA_REPEAT_PENALTY=1.1
CODELLAMA_NUM_CTX=8192
CODELLAMA_NUM_BATCH=256
CODELLAMA_NUM_GPU=40
CODELLAMA_NUM_THREAD=8

# Qwen 2.5 32B - Optimized for document processing
QWEN_TEMPERATURE=0.7
QWEN_TOP_P=0.9
QWEN_TOP_K=40
QWEN_REPEAT_PENALTY=1.1
QWEN_NUM_CTX=8192
QWEN_NUM_BATCH=256
QWEN_NUM_GPU=40
QWEN_NUM_THREAD=8

# Gemma 2 27B - Optimized for embeddings and fast inference
GEMMA_TEMPERATURE=0.7
GEMMA_TOP_P=0.9
GEMMA_TOP_K=40
GEMMA_REPEAT_PENALTY=1.1
GEMMA_NUM_CTX=8192
GEMMA_NUM_BATCH=256
GEMMA_NUM_GPU=35
GEMMA_NUM_THREAD=8

# ========================
# EMBEDDINGS MODEL
# ========================
# Separate embeddings model for vector generation
EMBEDDINGS_MODEL=nomic-embed-text:latest
EMBEDDINGS_DIMENSIONS=768
EMBEDDINGS_BATCH_SIZE=32
EMBEDDINGS_GPU_LAYERS=35

# ========================
# VLLM CONFIGURATION (Alternative to Ollama)
# ========================
VLLM_ENABLED=false  # Set to true to use vLLM instead of Ollama
VLLM_HOST=0.0.0.0
VLLM_PORT=8000
VLLM_MODEL=codellama/CodeLlama-34b-Instruct-hf
VLLM_DTYPE=auto
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_QUANTIZATION=awq  # AWQ quantization for 12GB VRAM
VLLM_TRUST_REMOTE_CODE=true

# ========================
# PERFORMANCE TUNING
# ========================
# Memory Management
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128
CUDA_LAUNCH_BLOCKING=0

# Flash Attention
FLASH_ATTENTION_ENABLED=true
FLASH_ATTENTION_VERSION=2

# KV Cache Optimization
KV_CACHE_DTYPE=fp16
KV_CACHE_FREE_GPU_MEM_FRACTION=0.2

# ========================
# ORCHESTRATOR CONNECTION
# ========================
ORCHESTRATOR_URL=http://orchestrator-mini.tail-net.ts.net:6100
ORCHESTRATOR_API_KEY=your-secure-orchestrator-key-here
NEXUS_ROUTER_URL=http://orchestrator-mini.tail-net.ts.net:6000

# Health reporting
HEALTH_CHECK_INTERVAL=30
METRICS_EXPORT_PORT=9093

# ========================
# MODEL ROUTING RULES
# ========================
# Use this worker for:
USE_FOR_TASKS=code-generation,embeddings,document-ocr,fast-queries,data-extraction,simple-classification
PRIORITY_LEVEL=3  # Fast processing worker
MAX_CONCURRENT_REQUESTS=4
REQUEST_TIMEOUT=30000  # 30 seconds for fast tasks

# ========================
# LOGGING
# ========================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DESTINATION=file
LOG_FILE_PATH=/app/logs/worker-3060.log

# ========================
# RESOURCE LIMITS
# ========================
MAX_MEMORY_GB=10  # Reserve 2GB for system
CPU_CORES=8
MAX_THREADS=8

# ========================
# MONITORING
# ========================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9093
GPU_METRICS_ENABLED=true
NVML_ENABLED=true

# ========================
# AUTO-SCALING
# ========================
AUTO_UNLOAD_MODELS=true
UNLOAD_AFTER_IDLE_SECONDS=900  # 15 minutes (faster unload for smaller GPU)
PRELOAD_ON_STARTUP=true

# ========================
# NETWORK
# ========================
INTERNAL_PORT=11434
EXTERNAL_PORT=11434
METRICS_PORT=9093
