DOMAIN=ratehunter.net
MAIN_SUBDOMAIN=nyra
PUBLIC_IP=REPLACE_ME_PUBLIC_IP

# LAN IP mapping (edit to match your network)
ORCH_HOST=MiniOrchestrator
ORCH_LAN_IP=192.168.1.10
M15R7_HOST=M15R7
M15R7_LAN_IP=192.168.1.168
RTX3090TI_HOST=RTX3090Ti
RTX3090TI_LAN_IP=192.168.1.50
AREA51_HOST=AREA-51
AREA51_LAN_IP=192.168.1.60

# Cloudflare
CLOUDFLARE_TOKEN=

# LLM/provider keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=

# Tools
TAVILY_API_KEY=
CONTEXT7_API_KEY=
ZOHO_MCP_URL=
FLOW_NEXUS_MCP_URL=

# Data stores (orchestrator default)
POSTGRES_USER=nyra
POSTGRES_PASSWORD=nyra_pass_ChangeMe
POSTGRES_DB=nyra
REDIS_PASSWORD=nyra_redis_pw

# CORE stack ports
LITELLM_PORT=4000
METAMCP_PORT=12008
OPENWEBUI_PORT=3000
CADDY_HTTP_PORT=8080
POSTGRES_PORT=5432

# === MEMORY integrations ===
# Qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
# Neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_AUTH_USER=neo4j
NEO4J_AUTH_PASSWORD=change_me_neo4j
# Optional Adminer for quick DB peek (Postgres)
ADMINER_PORT=8081

# === OBSERVABILITY integrations ===
PROMETHEUS_PORT=9090
LOKI_PORT=3100
PROMTAIL_PORT=9080
GRAFANA_PORT=3001
CADVISOR_PORT=8088
NODE_EXPORTER_PORT=9100

# Grafana admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Infisical (leave as-is)
INFISICAL_API_URL=https://app.infisical.com
INFISICAL_PROJECT_ID=
INFISICAL_ENV=dev
INFISICAL_FOLDER_PATH=/shared
INFISICAL_FOLDER_PATHS=/shared,/project-nyra
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
INFISICAL_HOST_URL=${INFISICAL_API_URL}

# Optional LiteLLM/OpenRouter proxy
LITELLM_UPSTREAM=openrouter
LITELLM_API_KEYS=${OPENROUTER_API_KEY}
