{
  "version": 1,
  "provider": "openai",
  "model": "nyra-auto",
  "ephemeralSettings": {
    "auth-key-name": "nyra-nexus",
    "base-url": "https://nexus.trex-fiordland.ts.net/v1",
    "context-limit": 128000,
    "compression-threshold": 0.78,
    "max-prompt-tokens": 100000,
    "tool-output-max-items": 45,
    "tool-output-max-tokens": 40000,
    "tool-output-truncate-mode": "warn",
    "shell-default-timeout-seconds": 180,
    "shell-max-timeout-seconds": 1200,
    "task-default-timeout-seconds": 1200,
    "task-max-timeout-seconds": 3600,
    "socket-keepalive": true,
    "socket-nodelay": true
  }
}
