# Project Nyra Wave AI / LLxprt secret and endpoint template.
# Copy to ~/.zsh/99-nyra-wave-env.zsh or merge into ~/.zsh/99-secrets.zsh.
# Do not commit a filled version.

# Tailscale MagicDNS endpoints.
export NYRA_ORCHESTRATOR_HOST="${NYRA_ORCHESTRATOR_HOST:-orchestrator.trex-fiordland.ts.net}"
export NYRA_ORACLE_HOST="${NYRA_ORACLE_HOST:-oracle-vps.trex-fiordland.ts.net}"
export NYRA_WORKER_5090_HOST="${NYRA_WORKER_5090_HOST:-worker-rtx5090.trex-fiordland.ts.net}"
export NYRA_WORKER_3090TI_HOST="${NYRA_WORKER_3090TI_HOST:-worker-rtx3090ti.trex-fiordland.ts.net}"
export NYRA_WORKER_3060_HOST="${NYRA_WORKER_3060_HOST:-worker-rtx3060.trex-fiordland.ts.net}"

# Nexus / LiteLLM / Letta / bridge endpoints.
export NYRA_NEXUS_BASE_URL="${NYRA_NEXUS_BASE_URL:-http://${NYRA_ORCHESTRATOR_HOST}:6000/v1}"
export NYRA_NEXUS_MCP_URL="${NYRA_NEXUS_MCP_URL:-http://${NYRA_ORCHESTRATOR_HOST}:6000/mcp}"
export NYRA_LITELLM_BASE_URL="${NYRA_LITELLM_BASE_URL:-http://${NYRA_ORCHESTRATOR_HOST}:4000/v1}"
export NYRA_OPENCLAW_GATEWAY_URL="${NYRA_OPENCLAW_GATEWAY_URL:-http://${NYRA_ORCHESTRATOR_HOST}:5678}"
export NYRA_LETTA_BASE_URL="${NYRA_LETTA_BASE_URL:-http://${NYRA_ORACLE_HOST}:8283}"
export NYRA_LETTA_MCP_URL="${NYRA_LETTA_MCP_URL:-http://${NYRA_ORACLE_HOST}:8284/mcp}"
export LLXPRT_BRIDGE_BASE_URL="${LLXPRT_BRIDGE_BASE_URL:-http://127.0.0.1:8090/v1}"
export LLXPRT_DEFAULT_PROFILE="${LLXPRT_DEFAULT_PROFILE:-nyra-cli-triad-ha}"
export NYRA_LLXPRT_PACKAGE="${NYRA_LLXPRT_PACKAGE:-@vybestack/llxprt-code}"

# Secret values should come from the shell, Infisical, WaveTerm secret store, or OAuth/keyring.
export NEXUS_MASTER_KEY="${NEXUS_MASTER_KEY:-}"
export LETTA_API_KEY="${LETTA_API_KEY:-}"
export LLXPRT_BRIDGE_API_KEY="${LLXPRT_BRIDGE_API_KEY:-}"
export NYRA_WORKER_API_KEY="${NYRA_WORKER_API_KEY:-}"
export OPENROUTER_API_KEY="${OPENROUTER_API_KEY:-}"
export OPENROUTER_KEY="${OPENROUTER_KEY:-${OPENROUTER_API_KEY}}"
export GROQ_API_KEY="${GROQ_API_KEY:-}"
export GROQ_KEY="${GROQ_KEY:-${GROQ_API_KEY}}"
export KIMI_API_KEY="${KIMI_API_KEY:-}"
