{
  "version": 1,
  "provider": "anthropic",
  "model": "claude-sonnet-4-6",
  "auth": {
    "type": "oauth",
    "buckets": ["default"]
  },
  "ephemeralSettings": {
    "context-limit": 190000,
    "compression-threshold": 0.78,
    "max-prompt-tokens": 160000,
    "tool-output-max-items": 35,
    "tool-output-max-tokens": 32000,
    "tool-output-truncate-mode": "warn",
    "shell-default-timeout-seconds": 150,
    "shell-max-timeout-seconds": 900,
    "task-default-timeout-seconds": 900,
    "task-max-timeout-seconds": 2400,
    "prompt-caching": "1h",
    "reasoning.enabled": true,
    "reasoning.effort": "high",
    "reasoning.includeInResponse": false,
    "reasoning.includeInContext": true,
    "reasoning.stripFromContext": "allButLast"
  }
}
