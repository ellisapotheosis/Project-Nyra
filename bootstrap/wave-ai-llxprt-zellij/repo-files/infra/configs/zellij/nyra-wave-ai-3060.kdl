layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="Agents" focus=true {
        pane split_direction="vertical" {
            pane split_direction="horizontal" size="50%" {
                pane name="llxprt-jefe" command="bash" {
                    args "-lc" "scripts/nyra-zellij-pane.sh llxprt-jefe 'cd ~/repos/project-nyra && scripts/run-llxprt-jefe.sh || bash'"
                }
                pane name="llxprt-code" command="bash" {
                    args "-lc" "scripts/nyra-zellij-pane.sh llxprt-code 'cd ~/repos/project-nyra && scripts/run-llxprt-code.sh --profile-load nyra-subscription-ha || bash'"
                }
            }
            pane split_direction="horizontal" size="50%" {
                pane name="codex-cli" command="bash" {
                    args "-lc" "scripts/nyra-zellij-pane.sh codex-cli 'cd ~/repos/project-nyra && scripts/run-llxprt-code.sh --profile-load nyra-codex-oauth || codex'"
                }
                pane name="gemini-cli" command="bash" {
                    args "-lc" "scripts/nyra-zellij-pane.sh gemini-cli 'cd ~/repos/project-nyra && scripts/run-llxprt-code.sh --profile-load nyra-gemini-oauth || gemini'"
                }
                pane name="claude-code" command="bash" {
                    args "-lc" "scripts/nyra-zellij-pane.sh claude-code 'cd ~/repos/project-nyra && scripts/run-llxprt-code.sh --profile-load nyra-claude-oauth || claude'"
                }
            }
        }
    }

    tab name="OpenClaw" {
        pane split_direction="horizontal" {
            pane name="5090 OpenClaw" command="bash" {
                args "-lc" "scripts/nyra-zellij-pane.sh worker-5090-openclaw 'ssh -A -t -o BatchMode=yes -o ConnectTimeout=5 worker-rtx5090.trex-fiordland.ts.net \"docker logs -f worker-5090-openclaw\" || bash'"
            }
            pane name="3090 OpenClaw" command="bash" {
                args "-lc" "scripts/nyra-zellij-pane.sh worker-3090-openclaw 'ssh -A -t -o BatchMode=yes -o ConnectTimeout=5 worker-rtx3090ti.trex-fiordland.ts.net \"docker logs -f worker-3090-openclaw\" || bash'"
            }
            pane name="3060 OpenClaw" command="bash" {
                args "-lc" "scripts/nyra-zellij-pane.sh worker-3060-openclaw 'ssh -A -t -o BatchMode=yes -o ConnectTimeout=5 worker-rtx3060.trex-fiordland.ts.net \"docker logs -f worker-3060-openclaw\" || bash'"
            }
        }
    }

    tab name="Letta" {
        pane split_direction="vertical" {
            pane name="letta-health" command="bash" {
                args "-lc" "scripts/nyra-zellij-pane.sh letta-health 'while true; do clear; date; curl -fsS http://oracle-vps.trex-fiordland.ts.net:8283/v1/health || curl -fsS http://oracle-vps.trex-fiordland.ts.net:8283/health || true; echo; curl -fsS http://oracle-vps.trex-fiordland.ts.net:8284/mcp || true; sleep 8; done'"
            }
            pane name="llxprt-bridge" command="bash" {
                args "-lc" "scripts/nyra-zellij-pane.sh llxprt-bridge 'cd ~/repos/project-nyra && (make llxprt-bridge-status || true); echo; echo Letta should use http://127.0.0.1:8090/v1 through the llxprt-bridge profile; bash'"
            }
        }
    }

    tab name="Providers" {
        pane split_direction="horizontal" {
            pane name="triad-ha" command="bash" {
                args "-lc" "scripts/nyra-zellij-pane.sh triad-ha 'cd ~/repos/project-nyra && scripts/run-llxprt-code.sh --profile-load nyra-cli-triad-ha || bash'"
            }
            pane name="openrouter-free" command="bash" {
                args "-lc" "scripts/nyra-zellij-pane.sh openrouter-free 'cd ~/repos/project-nyra && scripts/run-llxprt-code.sh --profile-load nyra-openrouter-free || bash'"
            }
            pane name="local-workers" command="bash" {
                args "-lc" "scripts/nyra-zellij-pane.sh local-workers 'cd ~/repos/project-nyra && scripts/run-llxprt-code.sh --profile-load nyra-local-workers || bash'"
            }
        }
    }

    tab name="GPU" {
        pane split_direction="horizontal" {
            pane name="5090 GPU" command="bash" {
                args "-lc" "scripts/nyra-zellij-pane.sh worker-5090-gpu 'ssh -A -t -o BatchMode=yes -o ConnectTimeout=5 worker-rtx5090.trex-fiordland.ts.net \"nvidia-smi -l 1\" || bash'"
            }
            pane name="3090 GPU" command="bash" {
                args "-lc" "scripts/nyra-zellij-pane.sh worker-3090-gpu 'ssh -A -t -o BatchMode=yes -o ConnectTimeout=5 worker-rtx3090ti.trex-fiordland.ts.net \"nvidia-smi -l 1\" || bash'"
            }
            pane name="3060 GPU" command="bash" {
                args "-lc" "scripts/nyra-zellij-pane.sh worker-3060-gpu 'ssh -A -t -o BatchMode=yes -o ConnectTimeout=5 worker-rtx3060.trex-fiordland.ts.net \"nvidia-smi -l 1\" || bash'"
            }
        }
    }

    tab name="Ops" {
        pane split_direction="vertical" {
            pane name="cluster-status" command="bash" {
                args "-lc" "scripts/nyra-zellij-pane.sh cluster-status 'cd ~/repos/project-nyra && while true; do clear; make wave-stack-status; sleep 10; done'"
            }
            pane name="cloudflare-tail" command="bash" {
                args "-lc" "scripts/nyra-zellij-pane.sh cloudflare-tail 'cd ~/repos/project-nyra && (npx wrangler pages deployment tail project-nyra || wrangler pages deployment tail project-nyra || bash)'"
            }
        }
    }
}
