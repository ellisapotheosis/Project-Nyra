{
  "mcpServers": {
    "infisical-mcp": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "docker",
        "run",
        "--rm",
        "-i",
        "--network=host",
        "-e",
        "INFISICAL_PROJECT_ID",
        "-e",
        "INFISICAL_CLIENT_ID",
        "-e",
        "INFISICAL_CLIENT_SECRET",
        "-e",
        "INFISICAL_ENVIRONMENT=dev",
        "ghcr.io/infisical/mcp-server:latest"
      ],
      "env": {
        "INFISICAL_PROJECT_ID": "${INFISICAL_PROJECT_ID}",
        "INFISICAL_CLIENT_ID": "${INFISICAL_CLIENT_ID}",
        "INFISICAL_CLIENT_SECRET": "${INFISICAL_CLIENT_SECRET}",
        "INFISICAL_ENVIRONMENT": "dev"
      },
      "disabled": false,
      "description": "Infisical secrets management - provides secure secret storage and injection for all MCP services"
    },
    "claude-flow": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "claude-flow@alpha", "mcp", "start"],
      "env": {
        "CLAUDE_FLOW_MEMORY_ENABLED": "true",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_NEURAL_ENABLED": "true",
        "CLAUDE_FLOW_GITHUB_ENABLED": "true",
        "CLAUDE_FLOW_AUTO_SPAWN": "true",
        "CLAUDE_FLOW_SESSION_MEMORY": "true",
        "CLAUDE_FLOW_MAX_AGENTS": "10",
        "NODE_ENV": "development"
      },
      "disabled": false,
      "description": "Claude Flow orchestration - main coordination hub with hooks, memory, neural training, and GitHub integration"
    },
    "ruv-swarm": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "ruv-swarm@latest", "mcp", "start"],
      "env": {
        "RUV_SWARM_TOPOLOGY": "adaptive",
        "RUV_SWARM_MAX_AGENTS": "20",
        "RUV_SWARM_WASM_ENABLED": "true",
        "RUV_SWARM_NEURAL_ENABLED": "true",
        "RUV_SWARM_DAA_ENABLED": "true",
        "RUV_SWARM_MEMORY_MODE": "persistent",
        "NODE_ENV": "development"
      },
      "disabled": false,
      "description": "Ruv Swarm coordination - enhanced swarm orchestration with WASM acceleration and DAA capabilities"
    },
    "flow-nexus": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "flow-nexus@latest", "mcp", "start"],
      "env": {
        "FLOW_NEXUS_API_URL": "${FLOW_NEXUS_API_URL}",
        "FLOW_NEXUS_API_KEY": "${FLOW_NEXUS_API_KEY}",
        "FLOW_NEXUS_USER_ID": "${FLOW_NEXUS_USER_ID}",
        "FLOW_NEXUS_SANDBOX_ENABLED": "true",
        "FLOW_NEXUS_NEURAL_ENABLED": "true",
        "FLOW_NEXUS_GITHUB_ENABLED": "true",
        "FLOW_NEXUS_STORAGE_ENABLED": "true",
        "FLOW_NEXUS_REALTIME_ENABLED": "true",
        "NODE_ENV": "development"
      },
      "disabled": false,
      "description": "Flow Nexus platform - cloud-based execution, sandboxes, templates, and real-time monitoring"
    },
    "metamcp": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "docker",
        "run",
        "--rm",
        "-i",
        "--network=host",
        "-v",
        "C:\\Dev\\DevProjects\\Personal-Projects\\Project-Nyra\\config\\metamcp:/config",
        "-e",
        "METAMCP_CONFIG_PATH=/config/metamcp-config.json",
        "-e",
        "METAMCP_ROUTING_MODE=token_cost",
        "-e",
        "METAMCP_LOG_LEVEL=info",
        "ghcr.io/metamcp/mcp-proxy:latest"
      ],
      "env": {
        "METAMCP_CONFIG_PATH": "/config/metamcp-config.json",
        "METAMCP_ROUTING_MODE": "token_cost",
        "METAMCP_LOG_LEVEL": "info",
        "METAMCP_ENABLE_METRICS": "true",
        "METAMCP_ENABLE_CACHE": "true",
        "METAMCP_CACHE_TTL": "3600"
      },
      "disabled": false,
      "description": "MetaMCP proxy - intelligent routing by token cost with channel-based distribution for claude-flow and archon services"
    },
    "serenai-mcp": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "docker",
        "run",
        "--rm",
        "-i",
        "--network=host",
        "-e",
        "SERENAI_API_KEY",
        "-e",
        "SERENAI_MODEL=claude-sonnet-4-5",
        "-e",
        "SERENAI_MEMORY_ENABLED=true",
        "-e",
        "SERENAI_CONTEXT_WINDOW=200000",
        "ghcr.io/serenai/mcp-server:latest"
      ],
      "env": {
        "SERENAI_API_KEY": "${SERENAI_API_KEY}",
        "SERENAI_MODEL": "claude-sonnet-4-5",
        "SERENAI_MEMORY_ENABLED": "true",
        "SERENAI_CONTEXT_WINDOW": "200000",
        "SERENAI_MAX_TOKENS": "8192",
        "SERENAI_TEMPERATURE": "0.7"
      },
      "disabled": false,
      "description": "SerenAI assistant - AI-powered assistant with memory and large context window"
    },
    "archon-mcp": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "docker",
        "compose",
        "-f",
        "C:\\Dev\\DevProjects\\Personal-Projects\\Project-Nyra\\docker\\archon\\docker-compose.yml",
        "run",
        "--rm",
        "archon-mcp"
      ],
      "env": {
        "ARCHON_DB_HOST": "${ARCHON_DB_HOST}",
        "ARCHON_DB_PORT": "${ARCHON_DB_PORT}",
        "ARCHON_DB_NAME": "${ARCHON_DB_NAME}",
        "ARCHON_DB_USER": "${ARCHON_DB_USER}",
        "ARCHON_DB_PASSWORD": "${ARCHON_DB_PASSWORD}",
        "ARCHON_API_URL": "${ARCHON_API_URL}",
        "ARCHON_API_KEY": "${ARCHON_API_KEY}",
        "ARCHON_FRONTEND_URL": "${ARCHON_FRONTEND_URL}",
        "ARCHON_BACKEND_URL": "${ARCHON_BACKEND_URL}",
        "ARCHON_REDIS_URL": "${ARCHON_REDIS_URL}",
        "ARCHON_STORAGE_PATH": "/data/archon",
        "ARCHON_LOG_LEVEL": "info"
      },
      "disabled": false,
      "description": "Archon OS - multi-service orchestration platform with UI, API, database, and backend services"
    },
    "bitwarden-mcp": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "docker",
        "run",
        "--rm",
        "-i",
        "--network=host",
        "-v",
        "C:\\Dev\\DevProjects\\Personal-Projects\\Project-Nyra\\data\\bitwarden:/data",
        "-e",
        "BW_CLIENTID",
        "-e",
        "BW_CLIENTSECRET",
        "-e",
        "BW_PASSWORD",
        "-e",
        "BW_SERVER_URL",
        "ghcr.io/bitwarden/mcp-server:latest"
      ],
      "env": {
        "BW_CLIENTID": "${BW_CLIENTID}",
        "BW_CLIENTSECRET": "${BW_CLIENTSECRET}",
        "BW_PASSWORD": "${BW_PASSWORD}",
        "BW_SERVER_URL": "${BW_SERVER_URL}",
        "BW_DATA_DIR": "/data",
        "BW_SESSION_TIMEOUT": "3600"
      },
      "disabled": false,
      "description": "Bitwarden - secure password and secrets management with local data persistence"
    },
    "agentic-flow": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "agentic-flow@latest", "mcp", "start"],
      "env": {
        "AGENTIC_FLOW_MAX_AGENTS": "15",
        "AGENTIC_FLOW_TOPOLOGY": "mesh",
        "AGENTIC_FLOW_MEMORY_ENABLED": "true",
        "NODE_ENV": "development"
      },
      "disabled": false,
      "description": "Agentic Flow - agent-based workflow orchestration and coordination"
    },
    "agentdb": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "agentdb@latest", "mcp", "start"],
      "env": {
        "AGENTDB_STORAGE_PATH": "C:\\Dev\\DevProjects\\Personal-Projects\\Project-Nyra\\data\\agentdb",
        "AGENTDB_VECTOR_ENABLED": "true",
        "AGENTDB_QUANTIZATION": "true",
        "AGENTDB_CACHE_ENABLED": "true",
        "NODE_ENV": "development"
      },
      "disabled": false,
      "description": "AgentDB - persistent vector database with 150x faster search and quantization"
    },
    "agent-booster": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "agent-booster@latest", "mcp", "start"],
      "env": {
        "AGENT_BOOSTER_OPTIMIZATION_ENABLED": "true",
        "AGENT_BOOSTER_CACHE_ENABLED": "true",
        "NODE_ENV": "development"
      },
      "disabled": false,
      "description": "Agent Booster - performance optimization and acceleration for agent operations"
    },
    "epic-sdk": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "epic-sdk@latest", "mcp", "start"],
      "env": {
        "EPIC_SDK_API_KEY": "${EPIC_SDK_API_KEY}",
        "EPIC_SDK_FEATURES_ENABLED": "all",
        "NODE_ENV": "development"
      },
      "disabled": false,
      "description": "Epic SDK - comprehensive development toolkit and utilities"
    }
  },
  "channels": {
    "claude-flow-channel": {
      "description": "Main orchestration channel for claude-flow ecosystem",
      "servers": [
        "claude-flow",
        "ruv-swarm",
        "flow-nexus",
        "agentic-flow",
        "agentdb",
        "agent-booster",
        "epic-sdk"
      ],
      "routing": {
        "mode": "token_cost",
        "priority": "high",
        "fallback": "claude-flow"
      }
    },
    "archon-channel": {
      "description": "Archon OS ecosystem channel",
      "servers": [
        "archon-mcp"
      ],
      "routing": {
        "mode": "service_based",
        "priority": "medium",
        "fallback": "archon-mcp"
      }
    },
    "security-channel": {
      "description": "Security and secrets management channel",
      "servers": [
        "infisical-mcp",
        "bitwarden-mcp"
      ],
      "routing": {
        "mode": "round_robin",
        "priority": "critical",
        "fallback": "infisical-mcp"
      }
    },
    "ai-channel": {
      "description": "AI assistant and intelligence channel",
      "servers": [
        "serenai-mcp"
      ],
      "routing": {
        "mode": "direct",
        "priority": "medium",
        "fallback": null
      }
    }
  },
  "routing": {
    "strategy": "token_cost",
    "token_cost_thresholds": {
      "low": 1000,
      "medium": 10000,
      "high": 50000,
      "critical": 100000
    },
    "channel_mapping": {
      "low": "claude-flow-channel",
      "medium": "claude-flow-channel",
      "high": "archon-channel",
      "critical": "security-channel"
    },
    "failover": {
      "enabled": true,
      "max_retries": 3,
      "retry_delay_ms": 1000
    }
  },
  "global_settings": {
    "timeout_ms": 30000,
    "max_retries": 3,
    "log_level": "info",
    "metrics_enabled": true,
    "cache_enabled": true,
    "cache_ttl_seconds": 3600
  },
  "integration": {
    "infisical": {
      "inject_into": [
        "claude-flow",
        "ruv-swarm",
        "flow-nexus",
        "archon-mcp",
        "serenai-mcp",
        "bitwarden-mcp",
        "agentic-flow",
        "agentdb",
        "agent-booster",
        "epic-sdk"
      ],
      "auto_refresh": true,
      "refresh_interval_seconds": 300
    },
    "metamcp": {
      "proxy_all_traffic": true,
      "enable_analytics": true,
      "enable_cost_tracking": true
    }
  }
}