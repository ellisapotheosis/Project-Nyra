{
  "hooks": {
    "enabled": true,
    "autoExecute": {
      "preTask": true,
      "postTask": true,
      "preEdit": true,
      "postEdit": true,
      "sessionStart": true,
      "sessionEnd": true
    },
    "customHooks": {
      "preEditBackup": {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File nyra-infra\\tasks\\windows\\nyra-preedit-backup.ps1 \"${file}\"",
        "failOnError": false
      },
      "postEditValidateCompose": {
        "pattern": "*.yml",
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File nyra-infra\\tasks\\windows\\nyra-validate-compose.ps1 \"${file}\"",
        "continueOnError": false
      }
    },
    "memory": {
      "persistence": true,
      "location": ".swarm\\memory.db",
      "syncInterval": 30000
    }
  }
}