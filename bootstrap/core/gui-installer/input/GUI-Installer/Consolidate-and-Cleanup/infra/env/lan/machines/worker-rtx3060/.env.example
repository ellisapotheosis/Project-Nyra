# Worker machine overrides (LAN).
# Copy to: infra\env\lan\machines\worker-rtx3060\.env  (do NOT commit)
NODE_ID=worker-rtx3060
NODE_TYPE=worker

ORCHESTRATOR_URL=http://orchestrator-mini:8000

# Worker LLM runtime (example: Ollama)
OLLAMA_HOST=0.0.0.0
OLLAMA_PORT=11434

INFISICAL_ENV=lan
INFISICAL_PATH=machines/worker-rtx3060
