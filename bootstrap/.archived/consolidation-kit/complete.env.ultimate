LENDERPRICE_API_URL=https://api.lenderprice.com
LENDERPRICE_API_KEY=your-lenderprice-key
LENDERPRICE_USERNAME=your-username
LENDERPRICE_PASSWORD=your-password

# Optimal Blue Integration
OPTIMAL_BLUE_API_URL=https://api.optimalblue.com
OPTIMAL_BLUE_API_KEY=your-optimal-blue-key
OPTIMAL_BLUE_CLIENT_ID=your-client-id

# -----------------------------------------------------
# COMMUNICATION SERVICES
# -----------------------------------------------------
# Twilio (SMS, Voice, Voicemail)
TWILIO_ENABLED=true
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_MESSAGING_SERVICE_SID=your-messaging-service-sid

# SendGrid (Email)
SENDGRID_ENABLED=true
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@ratehunter.net
SENDGRID_FROM_NAME=RateHunter

# -----------------------------------------------------
# INFISICAL - SECRETS MANAGEMENT
# -----------------------------------------------------
INFISICAL_ENABLED=true
INFISICAL_PROJECT_ID=8374cea9-e5e8-4050-bda4-b91f25ab30ef
INFISICAL_ENVIRONMENT=dev
INFISICAL_TOKEN=your-infisical-token
INFISICAL_API_URL=https://api.infisical.com

# -----------------------------------------------------
# MONITORING & OBSERVABILITY
# -----------------------------------------------------
# Sentry (Error Tracking)
SENTRY_ENABLED=true
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development
SENTRY_TRACE_SAMPLE_RATE=1.0

# Prometheus (Metrics)
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=15s

# Grafana (Visualization)
GRAFANA_ENABLED=true
GRAFANA_PORT=3333
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_password

# -----------------------------------------------------
# STORAGE & CDN
# -----------------------------------------------------
# S3/MinIO (File Storage)
S3_ENABLED=true
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nyra-documents
S3_REGION=us-east-1

# Cloudflare (CDN & DNS)
CLOUDFLARE_ENABLED=true
CLOUDFLARE_API_TOKEN=your-cloudflare-token
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token

# -----------------------------------------------------
# CI/CD & DEPLOYMENT
# -----------------------------------------------------
GITHUB_TOKEN=ghp_your-github-token
GITHUB_REPO=your-org/project-nyra
SEMANTIC_RELEASE_ENABLED=true
CREATE_GH_RELEASE=true

# Docker
DOCKER_COMPOSE_PROJECT_NAME=project-nyra
COMPOSE_FILE=docker-compose.yml:docker-compose.memory.yml

# -----------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------
FEATURE_LOCAL_GPU=true
FEATURE_MEMORY_SYSTEMS=true
FEATURE_DRIP_CAMPAIGNS=true
FEATURE_DOCUMENT_OCR=true
FEATURE_VOICE_AUTOMATION=true
FEATURE_ANALYTICS_DASHBOARD=true
FEATURE_ADMIN_PORTAL=true

# -----------------------------------------------------
# PERFORMANCE & OPTIMIZATION
# -----------------------------------------------------
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=30000
CACHE_TTL=300
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=60000

# Worker Threads
WORKER_THREADS=8
PARALLEL_PROCESSING=true
BATCH_SIZE=10

# Memory Limits
MAX_MEMORY_MB=8192
HEAP_SIZE_MB=4096

# -----------------------------------------------------
# DEVELOPMENT
# -----------------------------------------------------
DEBUG=true
VERBOSE_LOGGING=true
HOT_RELOAD=true
SOURCE_MAPS=true
