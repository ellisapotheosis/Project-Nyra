# MORTGAGE SERVICES
# -----------------------------------------------------
# Quote API
QUOTE_API_PORT=8000
QUOTE_API_POSTGRES_HOST=localhost
QUOTE_API_POSTGRES_PORT=5432
QUOTE_API_POSTGRES_DB=quotes
QUOTE_API_REDIS_HOST=localhost
