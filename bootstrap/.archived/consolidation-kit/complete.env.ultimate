# =====================================================
# PROJECT NYRA - ULTIMATE ENVIRONMENT CONFIGURATION
# =====================================================
# Complete environment setup for all memory systems,
# GPU workers, services, and integrations
# =====================================================

# -----------------------------------------------------
# CORE PROJECT SETTINGS
# -----------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
PROJECT_NAME=project-nyra
PROJECT_VERSION=1.0.0

# -----------------------------------------------------
# CLAUDE FLOW & ORCHESTRATION
# -----------------------------------------------------
CLAUDE_FLOW_MODE=orchestrator
CLAUDE_FLOW_AUTO_COMMIT=true
CLAUDE_FLOW_AUTO_PUSH=false
CLAUDE_FLOW_HOOKS_ENABLED=true
CLAUDE_FLOW_TELEMETRY_ENABLED=true
CLAUDE_FLOW_REMOTE_EXECUTION=true
CLAUDE_FLOW_GITHUB_INTEGRATION=true
CLAUDE_FLOW_CHECKPOINT_ENABLED=true
CLAUDE_FLOW_MEMORY_PERSISTENCE=true
CLAUDE_FLOW_NEURAL_OPTIMIZATION=true
CLAUDE_FLOW_AUTO_LEARNING=true
CLAUDE_FLOW_PERFORMANCE_MODE=optimized
CLAUDE_FLOW_CACHE_ENABLED=true
CLAUDE_FLOW_PARALLEL_PROCESSING=true
CLAUDE_FLOW_AGENT_POOL=true
CLAUDE_FLOW_MAX_AGENTS=20
CLAUDE_FLOW_SWARM_TOPOLOGY=mesh

# -----------------------------------------------------
# RUVECTOR - DISTRIBUTED VECTOR DATABASE
# -----------------------------------------------------
RUVECTOR_ENABLED=true
RUVECTOR_MODE=distributed
RUVECTOR_HOST=localhost
RUVECTOR_PORT=7000
RUVECTOR_GRPC_PORT=7001
RUVECTOR_HTTP_PORT=7002
RUVECTOR_CONSENSUS_ENABLED=true
RUVECTOR_CONSENSUS_PEERS=localhost:7001,localhost:7003,localhost:7005
RUVECTOR_VECTOR_DIMENSIONS=1536
RUVECTOR_INDEX_TYPE=HNSW
RUVECTOR_DISTANCE_METRIC=cosine
RUVECTOR_EF_CONSTRUCTION=200
RUVECTOR_M=16
RUVECTOR_EF_SEARCH=100
RUVECTOR_PERSISTENCE_DIR=./memory/ruvector
RUVECTOR_WAL_ENABLED=true
RUVECTOR_WAL_BUFFER_SIZE=1048576
RUVECTOR_COMPRESSION=true
RUVECTOR_COMPRESSION_LEVEL=6
RUVECTOR_SNAPSHOT_ENABLED=true
RUVECTOR_SNAPSHOT_INTERVAL=3600
RUVECTOR_BACKUP_ENABLED=true
RUVECTOR_BACKUP_DIR=./backups/ruvector
RUVECTOR_MAX_MEMORY_GB=8
RUVECTOR_THREAD_POOL_SIZE=8
RUVECTOR_BATCH_SIZE=1000
RUVECTOR_CACHE_SIZE_MB=2048

# -----------------------------------------------------
# LETTA (FORMERLY MEMGPT) - AGENT MEMORY
# -----------------------------------------------------
LETTA_ENABLED=true
LETTA_SERVER_URL=http://localhost:8283
LETTA_API_KEY=
LETTA_AGENT_POOLING=true
LETTA_MAX_AGENTS=20
LETTA_CONTEXT_WINDOW=32000
LETTA_ARCHIVAL_MEMORY=true
LETTA_CORE_MEMORY_LIMIT=8192
LETTA_RECALL_MEMORY_LIMIT=16384
LETTA_POSTGRES_HOST=localhost
LETTA_POSTGRES_PORT=5432
LETTA_POSTGRES_DB=letta
LETTA_POSTGRES_USER=letta
LETTA_POSTGRES_PASSWORD=letta_password
LETTA_POSTGRES_URI=postgresql://letta:letta_password@localhost:5432/letta
LETTA_BACKUP_ENABLED=true
LETTA_BACKUP_DIR=./backups/letta
LETTA_BACKUP_INTERVAL=3600
LETTA_AUTO_SAVE=true
LETTA_AUTO_SAVE_INTERVAL=300
LETTA_EMBEDDING_MODEL=text-embedding-3-small
LETTA_EMBEDDING_PROVIDER=openai
LETTA_LLM_PROVIDER=anthropic
LETTA_LLM_MODEL=claude-sonnet-4-20250514

# -----------------------------------------------------
# GRAPHITI - TEMPORAL KNOWLEDGE GRAPHS
# -----------------------------------------------------
GRAPHITI_ENABLED=true
GRAPHITI_BACKEND=falkordb
GRAPHITI_NEO4J_URI=bolt://localhost:7687
GRAPHITI_NEO4J_USER=neo4j
GRAPHITI_NEO4J_PASSWORD=neo4j_password
GRAPHITI_FALKORDB_URL=redis://localhost:6379
GRAPHITI_FALKORDB_HOST=localhost
GRAPHITI_FALKORDB_PORT=6379
GRAPHITI_FALKORDB_PASSWORD=
GRAPHITI_GRAPH_NAME=nyra_knowledge
GRAPHITI_TEMPORAL_TRACKING=true
GRAPHITI_RELATIONSHIP_INFERENCE=true
GRAPHITI_AUTO_INDEX=true
GRAPHITI_EMBEDDING_MODEL=text-embedding-3-small
GRAPHITI_EMBEDDING_PROVIDER=openai
GRAPHITI_EMBEDDING_DIMENSIONS=1536
GRAPHITI_MAX_NODES=1000000
GRAPHITI_MAX_RELATIONSHIPS=5000000
GRAPHITI_INDEX_PROPERTIES=true
GRAPHITI_SNAPSHOT_ENABLED=true
GRAPHITI_SNAPSHOT_INTERVAL=1800
GRAPHITI_BACKUP_ENABLED=true
GRAPHITI_BACKUP_DIR=./backups/graphiti
GRAPHITI_QUERY_TIMEOUT=30000
GRAPHITI_BATCH_SIZE=1000

# -----------------------------------------------------
# FALKORDB - GRAPH DATABASE BACKEND FOR GRAPHITI
# -----------------------------------------------------
FALKORDB_ENABLED=true
FALKORDB_URL=redis://localhost:6379
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH=nyra_knowledge
FALKORDB_PERSIST_DATA=true
FALKORDB_PERSISTENCE_DIR=./memory/falkordb
FALKORDB_REPLICATION=true
FALKORDB_REPLICA_URLS=redis://localhost:6380,redis://localhost:6381
FALKORDB_MAX_MEMORY=4GB
FALKORDB_EVICTION_POLICY=allkeys-lru
FALKORDB_SNAPSHOT_ENABLED=true
FALKORDB_SNAPSHOT_INTERVAL=900
FALKORDB_AOF_ENABLED=true
FALKORDB_AOF_FSYNC=everysec

# -----------------------------------------------------
# MEM0 - USER PERSONALIZATION & CROSS-APP MEMORY
# -----------------------------------------------------
MEM0_ENABLED=true
MEM0_API_URL=http://localhost:8081
MEM0_API_KEY=
MEM0_USER_PERSONALIZATION=true
MEM0_CROSS_APP_SYNC=true
MEM0_RETENTION_DAYS=90
MEM0_AUTO_CLEANUP=true
MEM0_ENCRYPTION=true
MEM0_ENCRYPTION_KEY=your-encryption-key-here
MEM0_VECTOR_STORE=qdrant
MEM0_VECTOR_STORE_URL=http://localhost:6333
MEM0_LLM_PROVIDER=anthropic
MEM0_LLM_MODEL=claude-sonnet-4-20250514
MEM0_EMBEDDING_MODEL=text-embedding-3-small
MEM0_EMBEDDING_PROVIDER=openai
MEM0_POSTGRES_HOST=localhost
MEM0_POSTGRES_PORT=5432
MEM0_POSTGRES_DB=mem0
MEM0_POSTGRES_USER=mem0
MEM0_POSTGRES_PASSWORD=mem0_password
MEM0_BACKUP_ENABLED=true
MEM0_BACKUP_DIR=./backups/mem0
MEM0_SYNC_INTERVAL=60

# -----------------------------------------------------
# OPENMEMORY - SHARED COLLABORATIVE MEMORY
# -----------------------------------------------------
OPENMEMORY_ENABLED=true
OPENMEMORY_SERVER_URL=http://localhost:8080
OPENMEMORY_API_KEY=
OPENMEMORY_SHARED_MEMORY=true
OPENMEMORY_ENCRYPTION=true
OPENMEMORY_ENCRYPTION_KEY=your-openmemory-key-here
OPENMEMORY_PERSISTENCE=true
OPENMEMORY_PERSISTENCE_DIR=./memory/openmemory
OPENMEMORY_SYNC_INTERVAL=30
OPENMEMORY_VECTOR_STORE=qdrant
OPENMEMORY_POSTGRES_HOST=localhost
OPENMEMORY_POSTGRES_PORT=5432
OPENMEMORY_POSTGRES_DB=openmemory
OPENMEMORY_POSTGRES_USER=openmemory
OPENMEMORY_POSTGRES_PASSWORD=openmemory_password
OPENMEMORY_BACKUP_ENABLED=true
OPENMEMORY_BACKUP_DIR=./backups/openmemory
OPENMEMORY_MAX_USERS=1000
OPENMEMORY_MAX_MEMORIES_PER_USER=10000

# -----------------------------------------------------
# QDRANT - VECTOR DATABASE (SHARED)
# -----------------------------------------------------
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_GRPC_URL=http://localhost:6334
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=nyra_vectors
QDRANT_VECTOR_SIZE=1536
QDRANT_DISTANCE_METRIC=Cosine
QDRANT_ON_DISK_PAYLOAD=true
QDRANT_PERSISTENCE_DIR=./memory/qdrant
QDRANT_SNAPSHOT_ENABLED=true
QDRANT_SNAPSHOT_DIR=./backups/qdrant
QDRANT_OPTIMIZE_INTERVAL=300
QDRANT_INDEXING_THRESHOLD=20000
QDRANT_PAYLOAD_INDEXING=true

# -----------------------------------------------------
# SHARED DATABASES
# -----------------------------------------------------
# PostgreSQL (shared by Letta, Mem0, OpenMemory, TwentyCRM)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=nyra
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_POOL_SIZE=20

# Redis (shared caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_MEMORY=2GB
REDIS_EVICTION_POLICY=allkeys-lru

# Neo4j (alternative to FalkorDB)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password
NEO4J_DATABASE=nyra

# -----------------------------------------------------
# GPU WORKERS & LOCAL LLM ROUTING
# -----------------------------------------------------
# Worker 5090 (RTX 5090 - 48GB VRAM)
GPU_WORKER_5090_ENABLED=true
GPU_WORKER_5090_URL=http://worker-5090.tail-net.ts.net:11434
GPU_WORKER_5090_MODELS=deepseek-r1:236b-q4_K_M,qwen2.5:72b-instruct-q8_0
GPU_WORKER_5090_MAX_CONCURRENT=3
GPU_WORKER_5090_PRIORITY=1

# Worker 3090 (RTX 3090 Ti - 24GB VRAM)
GPU_WORKER_3090_ENABLED=true
GPU_WORKER_3090_URL=http://worker-3090.tail-net.ts.net:11434
GPU_WORKER_3090_MODELS=llama3.1:70b-instruct-q4_K_M,mistral-large:123b-instruct-q4_K_M
GPU_WORKER_3090_MAX_CONCURRENT=2
GPU_WORKER_3090_PRIORITY=2

# Worker 3060 (RTX 3060 - 12GB VRAM)
GPU_WORKER_3060_ENABLED=true
GPU_WORKER_3060_URL=http://worker-3060.tail-net.ts.net:11434
GPU_WORKER_3060_MODELS=qwen2.5:32b-instruct-q8_0,codellama:34b-instruct-q8_0,gemma2:27b-instruct-q8_0
GPU_WORKER_3060_MAX_CONCURRENT=2
GPU_WORKER_3060_PRIORITY=3

# Local LLM Configuration
LOCAL_LLM_ENABLED=true
LOCAL_LLM_PRIORITY=true
LOCAL_LLM_FALLBACK_TO_CLOUD=true
LOCAL_LLM_TIMEOUT=30000
LOCAL_LLM_MAX_RETRIES=2

# -----------------------------------------------------
# NEXUS ROUTER - LLM ROUTING & LOAD BALANCING
# -----------------------------------------------------
NEXUS_ROUTER_ENABLED=true
NEXUS_ROUTER_PORT=4000
NEXUS_MCP_PORT=4001
NEXUS_LOAD_BALANCING=least-loaded
NEXUS_HEALTH_CHECK_ENABLED=true
NEXUS_HEALTH_CHECK_INTERVAL=30000
NEXUS_HEALTH_CHECK_TIMEOUT=5000
NEXUS_FALLBACK_ENABLED=true
NEXUS_FALLBACK_RETRIES=2
NEXUS_CIRCUIT_BREAKER_ENABLED=true
NEXUS_CIRCUIT_BREAKER_THRESHOLD=5
NEXUS_CIRCUIT_BREAKER_TIMEOUT=30000

# -----------------------------------------------------
# CLOUD LLM PROVIDERS (FALLBACK)
# -----------------------------------------------------
# Anthropic (Primary)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=8192
ANTHROPIC_TEMPERATURE=0.7

# OpenRouter (Cost-effective fallback)
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-r1
OPENROUTER_MAX_TOKENS=8192

# OpenAI (Embeddings)
OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ORG_ID=

# -----------------------------------------------------
# DIFY - AI CHAT INTERFACE
# -----------------------------------------------------
DIFY_ENABLED=true
DIFY_API_URL=http://localhost:5001
DIFY_CONSOLE_URL=http://localhost:3000
DIFY_POSTGRES_HOST=localhost
DIFY_POSTGRES_PORT=5432
DIFY_POSTGRES_DB=dify
DIFY_POSTGRES_USER=dify
DIFY_POSTGRES_PASSWORD=dify_password
DIFY_REDIS_HOST=localhost
DIFY_REDIS_PORT=6379
DIFY_REDIS_DB=1
DIFY_SECRET_KEY=your-dify-secret-key
DIFY_API_KEY=app-your-dify-api-key

# -----------------------------------------------------
# N8N - WORKFLOW AUTOMATION
# -----------------------------------------------------
N8N_ENABLED=true
N8N_PORT=5678
N8N_HOST=0.0.0.0
N8N_PROTOCOL=http
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin_password
N8N_WEBHOOK_URL=https://n8n.ratehunter.net
N8N_ENCRYPTION_KEY=your-n8n-encryption-key
N8N_POSTGRES_HOST=localhost
N8N_POSTGRES_PORT=5432
N8N_POSTGRES_DB=n8n
N8N_POSTGRES_USER=n8n
N8N_POSTGRES_PASSWORD=n8n_password
N8N_EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
N8N_EXECUTIONS_DATA_SAVE_ON_ERROR=all

# -----------------------------------------------------
# ACTIVEPIECES - WORKFLOW AUTOMATION
# -----------------------------------------------------
ACTIVEPIECES_ENABLED=true
ACTIVEPIECES_PORT=8080
ACTIVEPIECES_POSTGRES_HOST=localhost
ACTIVEPIECES_POSTGRES_PORT=5432
ACTIVEPIECES_POSTGRES_DB=activepieces
ACTIVEPIECES_POSTGRES_USER=activepieces
ACTIVEPIECES_POSTGRES_PASSWORD=activepieces_password
ACTIVEPIECES_REDIS_HOST=localhost
ACTIVEPIECES_REDIS_PORT=6379
ACTIVEPIECES_REDIS_DB=2
ACTIVEPIECES_SECRET_KEY=your-activepieces-secret

# -----------------------------------------------------
# TWENTY CRM
# -----------------------------------------------------
TWENTY_CRM_ENABLED=true
TWENTY_CRM_PORT=3001
TWENTY_CRM_DATABASE_URL=postgresql://localhost:5432/twenty
TWENTY_CRM_POSTGRES_HOST=localhost
TWENTY_CRM_POSTGRES_PORT=5432
TWENTY_CRM_POSTGRES_DB=twenty
TWENTY_CRM_POSTGRES_USER=twenty
TWENTY_CRM_POSTGRES_PASSWORD=twenty_password
TWENTY_CRM_SECRET_KEY=your-twenty-secret-key
TWENTY_CRM_JWT_SECRET=your-twenty-jwt-secret

