# ===== NYRA global =====
DOMAIN=ratehunter.net
MAIN_SUBDOMAIN=nyra
# Workers (update the IPs/MACs for your LAN)
ORCH_HOST=MiniOrchestrator
ORCH_LAN_IP=192.168.1.10
ORCH_MAC=AA-BB-CC-DD-EE-FF

RTX3090TI_HOST=RTX3090Ti
RTX3090TI_LAN_IP=192.168.1.50
RTX3090TI_MAC=11-22-33-44-55-66

AREA51_HOST=AREA-51
AREA51_LAN_IP=192.168.1.60
AREA51_MAC=22-33-44-55-66-77

M15R7_HOST=M15R7
M15R7_LAN_IP=192.168.1.168
M15R7_MAC=56-ED-B2-AB-54-D4

PUBLIC_IP=107.142.246.181

# ===== Credentials / API Keys =====
# Fill any you have; leave blank to skip providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
XAI_API_KEY=

# Search / Tooling
TAVILY_API_KEY=
CONTEXT7_API_KEY=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# DB / Messaging (dev defaults ok)
POSTGRES_USER=nyra
POSTGRES_PASSWORD=nyra_pass_ChangeMe
POSTGRES_DB=nyra
REDIS_PASSWORD=nyra_redis_pw

# LiteLLM
LITELLM_PORT=4000

# MetaMCP
METAMCP_PORT=12008
APP_URL=http://localhost:${METAMCP_PORT}

# Open WebUI / Lobe / Flowise / n8n
OPENWEBUI_PORT=3000
LOBEBOT_PORT=3210
FLOWISE_PORT=3002
N8N_PORT=5678

# Caddy (portal)
CADDY_HTTP_PORT=8080

# Cloudflared named tunnel
CLOUDFLARE_TUNNEL_NAME=nyra
CLOUDFLARE_TUNNEL_ID=
# Paste your tunnel credentials JSON into: orchestrator/cloudflared/credentials.json
# or set CLOUDFLARE_TOKEN to use token mode (dashboard-created tunnel)
CLOUDFLARE_TOKEN=

# Qdrant / Neo4j
QDRANT_PORT=6333
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474

# Observability (optional ports used by Loki/Prometheus/Grafana if you enable profile)
LOKI_PORT=3100
PROM_PORT=9090
GRAFANA_PORT=3001
