# === Cloud API Keys ===
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-openai-...
GEMINI_API_KEY=AIza...          # Google AI Studio key
OPENROUTER_API_KEY=sk-or-...

# === LiteLLM ===
LITELLM_MASTER_KEY=sk-nyra-litellm-master

POSTGRES_PASSWORD=nyra-litellm
REDIS_PASSWORD=nyra-litellm

# === MetaMCP ===
METAMCP_APP_URL=http://localhost:12008

# === Open WebUI ===
# Public URL your browser will use to reach Open WebUI
OPENWEBUI_URL=http://localhost:3000

# Optional: pre‑seed external tool servers (MetaMCP, mcpo, etc.)
# This is a JSON array string; copied into TOOL_SERVER_CONNECTIONS.
# Easiest path is to start with MetaMCP + Open WebUI integration:
# See: Repo-Bootstrapping/nyra-orchestration/metamcp/README.md
OPENWEBUI_TOOL_SERVER_CONNECTIONS=[]

# === ArchGW (if used as LAN router) ===
ARCHGW_HOST=0.0.0.0
ARCHGW_PORT=8088

# === Infisical (self-hosted PoC) ===
INFISICAL_ENCRYPTION_KEY=CHANGE_ME_INFISICAL_ENCRYPTION
INFISICAL_AUTH_SECRET=CHANGE_ME_INFISICAL_AUTH_SECRET
INFISICAL_DB_PASSWORD=infisical-db-password
INFISICAL_SITE_URL=http://localhost:8080

# === Vaultwarden ===
VAULTWARDEN_DOMAIN=http://localhost:8000
