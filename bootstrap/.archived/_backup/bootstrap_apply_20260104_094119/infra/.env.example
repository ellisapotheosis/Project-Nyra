# Nyra Infra env example

# Nexus
NEXUS_JWT_SECRET=REPLACE_ME_CHANGE_ME
NEXUS_ADMIN_TOKEN=REPLACE_ME_CHANGE_ME

# LiteLLM/OpenRouter
OPENROUTER_API_KEY=REPLACE_ME
LITELLM_MASTER_KEY=REPLACE_ME_CHANGE_ME
LITELLM_DATABASE_URL=sqlite:////data/litellm.sqlite

# Dify
DIFY_SECRET_KEY=REPLACE_ME_CHANGE_ME
DIFY_ENCRYPTION_KEY=REPLACE_ME_CHANGE_ME

# Activepieces
ACTIVEPIECES_API_KEY=REPLACE_ME_CHANGE_ME

# n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=REPLACE_ME_CHANGE_ME
N8N_ENCRYPTION_KEY=REPLACE_ME_CHANGE_ME

# Letta
LETTA_API_KEY=REPLACE_ME_CHANGE_ME

# Mem0 (optional - cloud) / local fallback works without it
MEM0_API_KEY=
MEM0_DEFAULT_USER_ID=ellis
MEM0_BASE_URL=https://api.mem0.ai

# GitHub MCP (optional)
GITHUB_TOKEN=

# Docker Hub MCP (optional)
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# Frontend embeds
NEXT_PUBLIC_NEXUS_URL=http://localhost:7000
NEXT_PUBLIC_DIFY_WIDGET_URL=http://localhost:8080/chatbot.js
NEXT_PUBLIC_DIFY_APP_ID=
