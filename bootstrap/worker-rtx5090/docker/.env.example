# ==============================================================================
# Worker RTX5090 Environment Variables
# ==============================================================================
# Copy this file to .env and configure with your actual values
#
# CRITICAL: This file contains sensitive tokens
#           DO NOT commit .env to version control
# ==============================================================================

# ==============================================================================
# CLOUDFLARE TUNNEL CONFIGURATION
# ==============================================================================

# Cloudflare Tunnel Token for RTX5090 Worker
# Get from: https://one.dash.cloudflare.com/ > Zero Trust > Access > Tunnels
# This token provides secure external access to worker development UIs
CLOUDFLARE_TUNNEL_TOKEN_WORKER_RTX5090=your-rtx5090-worker-tunnel-token-here

# Tunnel Logging Level (debug, info, warn, error)
CLOUDFLARE_TUNNEL_LOGLEVEL=info

# Tunnel Metrics Endpoint (for Prometheus scraping)
CLOUDFLARE_TUNNEL_METRICS=0.0.0.0:9126

# ==============================================================================
# DEVELOPMENT UI PORTS
# ==============================================================================

# Worker Development UI Portal Port
WORKER_RTX5090_DEV_UI_PORT=8090

# GPU Monitoring Dashboard Port
WORKER_RTX5090_GPU_MONITOR_PORT=9835

# Additional Development Tools (adjust as needed)
WORKER_RTX5090_JUPYTER_PORT=8888
WORKER_RTX5090_TENSORBOARD_PORT=6006
WORKER_RTX5090_VSCODE_PORT=8443

# ==============================================================================
# DOCKER NETWORK CONFIGURATION
# ==============================================================================

# Network subnet for RTX5090 worker services
DOCKER_SUBNET_RTX5090=172.21.0.0/16

# ==============================================================================
# GPU CONFIGURATION
# ==============================================================================

# NVIDIA GPU Settings (for docker runtime)
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics

# ==============================================================================
# NOTES
# ==============================================================================
# 1. Get Cloudflare tunnel token from Zero Trust dashboard after creating tunnel
# 2. Ensure NVIDIA Container Toolkit is installed on host
# 3. Keep this file secure and never commit to git
# 4. Adjust ports if they conflict with other services
