# =============================================================================
# WORKER-5090 - RTX 5090 48GB VRAM Configuration
# =============================================================================
# PC Spec: RTX 5090 (48GB VRAM)
# Role: Tier 1 - Complex reasoning, compliance analysis, large model inference
# Models: DeepSeek-R1 236B (quantized), Qwen 2.5 72B
# =============================================================================

# ========================
# WORKER IDENTIFICATION
# ========================
WORKER_ID=worker-5090
WORKER_TIER=1
WORKER_ROLE=complex-reasoning
TAILSCALE_HOSTNAME=worker-5090.tail-net.ts.net

# ========================
# GPU CONFIGURATION
# ========================
GPU_TYPE=RTX_5090
GPU_VRAM_GB=48
GPU_COMPUTE_CAPABILITY=9.0
CUDA_VISIBLE_DEVICES=0
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ========================
# OLLAMA CONFIGURATION
# ========================
OLLAMA_HOST=0.0.0.0:11434
OLLAMA_MODELS=/models
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=2

# Primary Model: DeepSeek-R1 236B (quantized Q4_K_M for 48GB VRAM)
OLLAMA_PRIMARY_MODEL=deepseek-r1:236b-q4
OLLAMA_PRIMARY_CONTEXT=32768
OLLAMA_PRIMARY_BATCH_SIZE=512
OLLAMA_PRIMARY_GPU_LAYERS=80

# Fallback Model: Qwen 2.5 72B
OLLAMA_FALLBACK_MODEL=qwen2.5:72b
OLLAMA_FALLBACK_CONTEXT=32768
OLLAMA_FALLBACK_BATCH_SIZE=512
OLLAMA_FALLBACK_GPU_LAYERS=80

# ========================
# MODEL-SPECIFIC PARAMETERS
# ========================
# DeepSeek-R1 236B - Optimized for complex mortgage reasoning
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_TOP_P=0.9
DEEPSEEK_TOP_K=40
DEEPSEEK_REPEAT_PENALTY=1.1
DEEPSEEK_NUM_CTX=32768
DEEPSEEK_NUM_BATCH=512
DEEPSEEK_NUM_GPU=80
DEEPSEEK_NUM_THREAD=16

# Qwen 2.5 72B - Optimized for general intelligence
QWEN_TEMPERATURE=0.7
QWEN_TOP_P=0.9
QWEN_TOP_K=40
QWEN_REPEAT_PENALTY=1.1
QWEN_NUM_CTX=32768
QWEN_NUM_BATCH=512
QWEN_NUM_GPU=80
QWEN_NUM_THREAD=16

# ========================
# VLLM CONFIGURATION (Alternative to Ollama)
# ========================
VLLM_ENABLED=false  # Set to true to use vLLM instead of Ollama
VLLM_HOST=0.0.0.0
VLLM_PORT=8000
VLLM_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-32B
VLLM_DTYPE=auto
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_MEMORY_UTILIZATION=0.9
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_QUANTIZATION=awq  # or "gptq" for lower memory
VLLM_TRUST_REMOTE_CODE=true

# ========================
# PERFORMANCE TUNING
# ========================
# Memory Management
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512
CUDA_LAUNCH_BLOCKING=0

# Flash Attention
FLASH_ATTENTION_ENABLED=true
FLASH_ATTENTION_VERSION=2

# KV Cache Optimization
KV_CACHE_DTYPE=fp16
KV_CACHE_FREE_GPU_MEM_FRACTION=0.1

# ========================
# ORCHESTRATOR CONNECTION
# ========================
ORCHESTRATOR_URL=http://orchestrator-mini.tail-net.ts.net:6100
ORCHESTRATOR_API_KEY=your-secure-orchestrator-key-here
NEXUS_ROUTER_URL=http://orchestrator-mini.tail-net.ts.net:6000

# Health reporting
HEALTH_CHECK_INTERVAL=30
METRICS_EXPORT_PORT=9091

# ========================
# MODEL ROUTING RULES
# ========================
# Use this worker for:
USE_FOR_TASKS=compliance,legal,complex-reasoning,mortgage-underwriting,risk-analysis
PRIORITY_LEVEL=1  # Highest priority worker
MAX_CONCURRENT_REQUESTS=2
REQUEST_TIMEOUT=120000  # 2 minutes for complex reasoning

# ========================
# LOGGING
# ========================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DESTINATION=file
LOG_FILE_PATH=/app/logs/worker-5090.log

# ========================
# RESOURCE LIMITS
# ========================
MAX_MEMORY_GB=45  # Reserve 3GB for system
CPU_CORES=16
MAX_THREADS=16

# ========================
# MONITORING
# ========================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9091
GPU_METRICS_ENABLED=true
NVML_ENABLED=true

# ========================
# AUTO-SCALING
# ========================
AUTO_UNLOAD_MODELS=true
UNLOAD_AFTER_IDLE_SECONDS=1800  # 30 minutes
PRELOAD_ON_STARTUP=true

# ========================
# NETWORK
# ========================
INTERNAL_PORT=11434
EXTERNAL_PORT=11434
METRICS_PORT=9091
