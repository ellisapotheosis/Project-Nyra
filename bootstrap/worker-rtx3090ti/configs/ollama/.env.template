# =============================================================================
# WORKER-3090 - RTX 3090 Ti 24GB VRAM Configuration
# =============================================================================
# PC Spec: RTX 3090 Ti (24GB VRAM)
# Role: Tier 2 - General purpose, quote generation, document processing
# Models: Llama 3.1 70B (quantized), Mistral Large 123B (quantized)
# =============================================================================

# ========================
# WORKER IDENTIFICATION
# ========================
WORKER_ID=worker-3090
WORKER_TIER=2
WORKER_ROLE=general-purpose
TAILSCALE_HOSTNAME=worker-3090.tail-net.ts.net

# ========================
# GPU CONFIGURATION
# ========================
GPU_TYPE=RTX_3090_Ti
GPU_VRAM_GB=24
GPU_COMPUTE_CAPABILITY=8.6
CUDA_VISIBLE_DEVICES=0
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ========================
# OLLAMA CONFIGURATION
# ========================
OLLAMA_HOST=0.0.0.0:11434
OLLAMA_MODELS=/models
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=2

# Primary Model: Llama 3.1 70B (quantized Q4_K_M for 24GB VRAM)
OLLAMA_PRIMARY_MODEL=llama3.1:70b-q4
OLLAMA_PRIMARY_CONTEXT=16384
OLLAMA_PRIMARY_BATCH_SIZE=512
OLLAMA_PRIMARY_GPU_LAYERS=60

# Fallback Model: Mistral Large 123B (quantized Q3_K_S for 24GB VRAM)
OLLAMA_FALLBACK_MODEL=mistral-large:123b-q3
OLLAMA_FALLBACK_CONTEXT=16384
OLLAMA_FALLBACK_BATCH_SIZE=512
OLLAMA_FALLBACK_GPU_LAYERS=50

# ========================
# MODEL-SPECIFIC PARAMETERS
# ========================
# Llama 3.1 70B - Optimized for mortgage quotes and general tasks
LLAMA_TEMPERATURE=0.7
LLAMA_TOP_P=0.9
LLAMA_TOP_K=40
LLAMA_REPEAT_PENALTY=1.1
LLAMA_NUM_CTX=16384
LLAMA_NUM_BATCH=512
LLAMA_NUM_GPU=60
LLAMA_NUM_THREAD=12

# Mistral Large 123B - Optimized for document understanding
MISTRAL_TEMPERATURE=0.7
MISTRAL_TOP_P=0.9
MISTRAL_TOP_K=40
MISTRAL_REPEAT_PENALTY=1.1
MISTRAL_NUM_CTX=16384
MISTRAL_NUM_BATCH=512
MISTRAL_NUM_GPU=50
MISTRAL_NUM_THREAD=12

# ========================
# VLLM CONFIGURATION (Alternative to Ollama)
# ========================
VLLM_ENABLED=false  # Set to true to use vLLM instead of Ollama
VLLM_HOST=0.0.0.0
VLLM_PORT=8000
VLLM_MODEL=meta-llama/Llama-3.1-70B-Instruct
VLLM_DTYPE=auto
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_MEMORY_UTILIZATION=0.9
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_QUANTIZATION=awq  # AWQ quantization for 24GB VRAM
VLLM_TRUST_REMOTE_CODE=true

# ========================
# PERFORMANCE TUNING
# ========================
# Memory Management
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:256
CUDA_LAUNCH_BLOCKING=0

# Flash Attention
FLASH_ATTENTION_ENABLED=true
FLASH_ATTENTION_VERSION=2

# KV Cache Optimization
KV_CACHE_DTYPE=fp16
KV_CACHE_FREE_GPU_MEM_FRACTION=0.15

# ========================
# ORCHESTRATOR CONNECTION
# ========================
ORCHESTRATOR_URL=http://orchestrator-mini.tail-net.ts.net:6100
ORCHESTRATOR_API_KEY=your-secure-orchestrator-key-here
NEXUS_ROUTER_URL=http://orchestrator-mini.tail-net.ts.net:6000

# Health reporting
HEALTH_CHECK_INTERVAL=30
METRICS_EXPORT_PORT=9092

# ========================
# MODEL ROUTING RULES
# ========================
# Use this worker for:
USE_FOR_TASKS=quote-generation,document-processing,general-queries,borrower-communication,lender-comparison
PRIORITY_LEVEL=2  # Second priority worker
MAX_CONCURRENT_REQUESTS=3
REQUEST_TIMEOUT=60000  # 1 minute for general tasks

# ========================
# LOGGING
# ========================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DESTINATION=file
LOG_FILE_PATH=/app/logs/worker-3090.log

# ========================
# RESOURCE LIMITS
# ========================
MAX_MEMORY_GB=22  # Reserve 2GB for system
CPU_CORES=12
MAX_THREADS=12

# ========================
# MONITORING
# ========================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9092
GPU_METRICS_ENABLED=true
NVML_ENABLED=true

# ========================
# AUTO-SCALING
# ========================
AUTO_UNLOAD_MODELS=true
UNLOAD_AFTER_IDLE_SECONDS=1800  # 30 minutes
PRELOAD_ON_STARTUP=true

# ========================
# NETWORK
# ========================
INTERNAL_PORT=11434
EXTERNAL_PORT=11434
METRICS_PORT=9092
