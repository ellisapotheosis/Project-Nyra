# Orchestrator machine overrides (LAN).
# Copy to: infra\env\lan\machines\orchestrator-mini\.env  (do NOT commit)
NODE_ID=orchestrator-mini
NODE_TYPE=orchestrator

# Local service endpoints (LAN)
ORCHESTRATOR_HOST=orchestrator-mini
ORCHESTRATOR_URL=http://orchestrator-mini:8000

# Workers (comma-separated host:port)
WORKER_LLM_ENDPOINTS=http://worker-rtx3060:11434,http://worker-rtx3090ti:11434,http://worker-rtx5090:11434

# MetaMCP
METAMCP_PORT=9100

# Infisical path for this node
INFISICAL_ENV=lan
INFISICAL_PATH=machines/orchestrator-mini
