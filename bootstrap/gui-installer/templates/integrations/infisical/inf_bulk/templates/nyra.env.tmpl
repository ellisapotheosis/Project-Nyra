# nyra.env.tmpl (Go template)
# Replace:
#   __PROJECT_ID__  -> your Infisical project id
#   __ENV__         -> dev | staging | prod
#   __PATH__        -> folder path e.g. /machines/orchestrator-mini
#
# Recommended: use Secret Imports so __PATH__ contains base + overrides.

{{- with secret "__PROJECT_ID__" "__ENV__" "__PATH__" }}
{{- range . }}
{{ .Key }}={{ .Value }}
{{- end }}
{{- end }}
