{
  "version": "2.0.0",
  "project": "Project-Nyra",
  "description": "Enhanced Claude settings with all 6 memory systems and advanced orchestration",
  
  "environmentVariables": {
    "RUVECTOR_ENABLED": "true",
    "RUVECTOR_MODE": "distributed",
    "RUVECTOR_PORT": "7000",
    "LETTA_ENABLED": "true",
    "LETTA_SERVER_URL": "http://localhost:8283",
    "GRAPHITI_ENABLED": "true",
    "GRAPHITI_BACKEND": "falkordb",
    "MEM0_ENABLED": "true",
    "OPENMEMORY_ENABLED": "true",
    "GPU_WORKER_5090_URL": "http://worker-5090.tail-net.ts.net:11434",
    "GPU_WORKER_3090_URL": "http://worker-3090.tail-net.ts.net:11434",
    "GPU_WORKER_3060_URL": "http://worker-3060.tail-net.ts.net:11434",
    "LOCAL_LLM_ENABLED": "true",
    "NEXUS_ROUTER_ENABLED": "true"
  },
  
  "mcpServers": {
    "claude-flow": {
      "command": "npx",
      "args": ["-y", "@rUv/claude-flow@latest"],
      "env": {
        "CLAUDE_FLOW_MEMORY": "true"
      }
    },
    "ruv-swarm": {
      "command": "npx",
      "args": ["-y", "@rUv/ruv-swarm@latest"],
      "env": {
        "RUV_SWARM_DISTRIBUTED": "true"
      }
    },
    "letta": {
      "command": "python",
      "args": ["-m", "letta.server"],
      "env": {
        "LETTA_PORT": "8283",
        "LETTA_DB_URL": "${DATABASE_URL}"
      }
    },
    "graphiti": {
      "command": "python",
      "args": ["-m", "graphiti.mcp_server"],
      "env": {
        "GRAPHITI_BACKEND": "falkordb",
        "FALKORDB_URL": "${FALKORDB_URL}"
      }
    },
    "mem0-mcp": {
      "command": "python",
      "args": ["-m", "mem0.mcp_server"],
      "env": {
        "MEM0_PORT": "8081",
        "MEM0_VECTOR_STORE": "qdrant"
      }
    },
    "openmemory": {
      "command": "node",
      "args": ["./mcp-servers/openmemory/index.js"],
      "env": {
        "OPENMEMORY_PORT": "8080"
      }
    },
    "ruvector": {
      "command": "cargo",
      "args": ["run", "--release"],
      "cwd": "./mcp-servers/ruvector",
      "env": {
        "RUVECTOR_MODE": "distributed",
        "RUVECTOR_PORT": "7000"
      }
    }
  },
  
  "memorySystem": {
    "enabled": true,
    "routing": {
      "strategy": "intelligent",
      "rules": [
        {
          "pattern": "vector-search|similarity|find-similar",
          "system": "ruvector",
          "fallback": ["qdrant"]
        },
        {
          "pattern": "conversation|chat|dialogue|agent-memory",
          "system": "letta",
          "fallback": ["openmemory"]
        },
        {
          "pattern": "temporal|history|evolution|timeline",
          "system": "graphiti",
          "fallback": ["letta"]
        },
        {
          "pattern": "user-profile|preferences|personalization",
          "system": "mem0",
          "fallback": ["openmemory"]
        },
        {
          "pattern": "shared|collaborative|team|knowledge",
          "system": "openmemory",
          "fallback": ["mem0"]
        }
      ]
    },
    "caching": {
      "enabled": true,
      "ttl": {
        "ruvector": 300,
        "letta": 600,
        "graphiti": 900,
        "mem0": 120,
        "openmemory": 180
      }
    }
  },
  
  "hooks": {
    "sessionStart": {
      "enabled": true,
      "commands": [
        "echo '🚀 Initializing Project Nyra session...'",
        "# Load Infisical secrets",
        "infisical export > .env.local",
        "# Start memory systems if not running",
        "docker-compose -f infra/docker/docker-compose.memory.yml ps || docker-compose -f infra/docker/docker-compose.memory.yml up -d",
        "# Initialize all MCP servers",
        "pnpm run mcp:health-check",
        "echo '✓ Memory systems initialized'",
        "echo '✓ MCP servers ready'",
        "echo '✓ Project Nyra session active'"
      ]
    },
    
    "preToolUse": {
      "enabled": true,
      "validators": [
        {
          "name": "safety-check",
          "command": "node ./scripts/validate-tool-use.js ${TOOL_NAME} ${TOOL_ARGS}",
          "continueOnFailure": false
        },
        {
          "name": "resource-check",
          "command": "node ./scripts/check-resources.js",
          "continueOnFailure": true
        }
      ],
      "enrichers": [
        {
          "name": "memory-context",
          "command": "node ./scripts/enrich-with-memory.js ${TOOL_NAME}",
          "injectResults": true
        }
      ]
    },
    
    "postToolUse": {
      "enabled": true,
      "commands": [
        "# Log tool usage metrics",
        "node ./scripts/log-tool-metrics.js ${TOOL_NAME} ${EXECUTION_TIME} ${SUCCESS}",
        "# Store results in appropriate memory system",
        "node ./scripts/store-in-memory.js ${TOOL_NAME} ${TOOL_RESULT}",
        "# Analyze performance and update neural models",
        "node ./scripts/analyze-performance.js ${TOOL_NAME} ${TOOL_RESULT}",
        "# Train neural prediction models",
        "if [ ${SUCCESS} = 'true' ]; then node ./scripts/train-neural.js ${TOOL_NAME}; fi"
      ]
    },
    
    "preCompact": {
      "enabled": true,
      "commands": [
        "echo '💾 Creating memory backup before compaction...'",
        "# Backup RuVector indices",
        "curl -X POST http://localhost:7000/backup",
        "# Backup Letta agents",
        "curl -X POST http://localhost:8283/backup",
        "# Backup Graphiti graph",
        "curl -X POST http://localhost:6379/backup",
        "# Backup Mem0 profiles",
        "curl -X POST http://localhost:8081/backup",
        "# Create summary of current context",
        "node ./scripts/create-context-summary.js > .context-backup.md",
        "echo '✓ Memory systems backed up'",
        "echo '⚠ Conversation will be compacted. See .context-backup.md for full history.'"
      ],
      "guidance": {
        "message": "This conversation is getting long. To maintain performance, Claude will compact it. All memory systems have been backed up. You can continue asking about anything discussed earlier - the memory systems will retrieve relevant context automatically.",
        "agentUsageReminder": "Remember: Use swarms for complex tasks, use specific agents for specialized work, and leverage memory systems to avoid repeating yourself."
      }
    },
    
    "stop": {
      "enabled": true,
      "commands": [
        "echo '📊 Generating session summary...'",
        "# Create session summary",
        "node ./scripts/create-session-summary.js > .session-summary-$(date +%Y%m%d-%H%M%S).md",
        "# Sync all memory systems",
        "node ./scripts/sync-all-memory.js --bidirectional",
        "# Train neural models on this session",
        "node ./scripts/train-session-models.js",
        "# Create GitHub backup",
        "if [ -n '$(git status --porcelain)' ]; then",
        "  git add -A",
        "  git commit -m 'Session backup: $(date)'",
        "  git push origin main",
        "fi",
        "echo '✓ Session data preserved'",
        "echo '✓ Memory systems synchronized'",
        "echo '✓ Neural models updated'"
      ]
    },
    
    "checkpoint": {
      "enabled": true,
      "interval": 300,
      "commands": [
        "echo '⏱ Auto-checkpoint triggered...'",
        "# Create memory snapshots",
        "node ./scripts/create-memory-snapshots.js",
        "# Create git checkpoint",
        "git add -A",
        "git commit -m 'Checkpoint: $(date +%Y-%m-%d %H:%M:%S)' --allow-empty",
        "git tag -a 'checkpoint-$(date +%Y%m%d-%H%M%S)' -m 'Auto-checkpoint'",
        "echo '✓ Checkpoint created'"
      ]
    }
  },
  
  "neuralModels": {
    "enabled": true,
    "models": [
      {
        "name": "task_predictor",
        "type": "classification",
        "purpose": "Predict optimal task execution strategy",
        "backend": "ruvector",
        "learningRate": 0.001,
        "updateFrequency": "per-session"
      },
      {
        "name": "error_preventer",
        "type": "anomaly-detection",
        "purpose": "Prevent errors before tool execution",
        "backend": "graphiti",
        "threshold": 0.85,
        "blockRiskyOperations": true
      },
      {
        "name": "performance_optimizer",
        "type": "reinforcement",
        "purpose": "Optimize tool selection for speed/accuracy/cost",
        "backend": "letta",
        "objectives": ["minimize-latency", "maximize-accuracy", "minimize-cost"],
        "autoTune": true
      },
      {
        "name": "mortgage_domain_expert",
        "type": "specialized",
        "purpose": "Mortgage industry knowledge and compliance",
        "backend": "graphiti",
        "specialization": "mortgage-automation",
        "trainingData": "./training/mortgage-domain.jsonl"
      }
    ]
  },
  
  "performance": {
    "caching": {
      "enabled": true,
      "strategy": "aggressive",
      "ttl": {
        "hooks": 300,
        "neural": 300,
        "memory": 120
      }
    },
    "parallelization": {
      "enabled": true,
      "maxConcurrent": 20,
      "workerThreads": 8
    },
    "batching": {
      "enabled": true,
      "batchSize": 10,
      "maxWaitMs": 100
    },
    "connectionPooling": {
      "agents": {
        "min": 2,
        "max": 20
      },
      "databases": {
        "min": 2,
        "max": 10
      }
    },
    "circuitBreaker": {
      "enabled": true,
      "threshold": 5,
      "timeout": 30000,
      "resetTimeout": 60000
    }
  },
  
  "logging": {
    "level": "info",
    "format": "json",
    "outputs": ["console", "file"],
    "file": {
      "path": "./logs/claude.log",
      "maxSize": "100MB",
      "maxFiles": 10
    },
    "includeMemoryOperations": true,
    "includeToolMetrics": true
  },
  
  "security": {
    "encryption": {
      "atRest": true,
      "inTransit": true
    },
    "audit": {
      "enabled": true,
      "logToolUse": true,
      "logMemoryAccess": true,
      "logDataAccess": true
    },
    "piiMasking": true,
    "complianceMode": "TRID"
  }
}
