# ============================================================================
# PROJECT NYRA - MASTER ENVIRONMENT CONFIGURATION
# ============================================================================
# This is the central environment configuration file that coordinates all
# memory systems, orchestrators, and infrastructure components for Project Nyra.
#
# STRUCTURE:
# - Core Project Settings: Basic project identification and modes
# - Memory Systems: RuVector, Letta, Graphiti, FalkorDB, Mem0, OpenMemory
# - AI Orchestrators: Claude-Flow, Archon, Ruv-Swarm
# - AI Models: Local GPU workers + Cloud fallbacks
# - Infrastructure: Docker services, databases, networking
# - Integrations: Third-party APIs and services
# - Security: API keys and secrets management
#
# USAGE:
# Load this file using Infisical for secure secret management:
#   infisical run --projectId="8374cea9-e5e8-4050-bda4-b91f25ab30ef" --env="dev"
# ============================================================================

# ----------------------------------------------------------------------------
# CORE PROJECT SETTINGS
# ----------------------------------------------------------------------------

# Project identification and basic configuration. These settings define the
# fundamental operating parameters for the entire Project Nyra system.
PROJECT_NAME=project-nyra
PROJECT_ENV=production
NODE_ENV=production
LOG_LEVEL=info
DEBUG=false

# Operating mode determines how the system coordinates work across components.
# Set to "orchestrator" on the main PC (Area51) and "worker" on GPU machines.
CLAUDE_FLOW_MODE=orchestrator

# Telemetry helps track system performance and identify optimization opportunities.
# This data stays local and helps the neural optimization systems improve over time.
CLAUDE_FLOW_TELEMETRY_ENABLED=true
CLAUDE_FLOW_PERFORMANCE_MODE=optimized

# ----------------------------------------------------------------------------
# MEMORY SYSTEM: RUVECTOR (FAST VECTOR SEARCH)
# ----------------------------------------------------------------------------

# RuVector provides ultra-fast distributed vector search using Rust-based
# performance optimizations and WebAssembly for maximum throughput. This is
# your primary system for code snippet retrieval, semantic search, and
# pattern matching across large codebases.

RUVECTOR_ENABLED=true
RUVECTOR_MODE=distributed

# The consensus peers are your three GPU worker machines. They form a
# distributed cluster that shares vector indices and provides fault tolerance.
# Format: hostname:port,hostname:port,hostname:port
RUVECTOR_CONSENSUS_PEERS=worker-5090.tail-net.ts.net:7890,worker-3090.tail-net.ts.net:7890,worker-3060.tail-net.ts.net:7890

# Raft consensus ensures data consistency across the distributed cluster.
# Leader election happens automatically when nodes join or leave.
RUVECTOR_CONSENSUS_PROTOCOL=raft
RUVECTOR_CONSENSUS_QUORUM=2

# Vector configuration determines embedding dimensions and index structure.
# 1536 dimensions matches OpenAI's text-embedding-3-small model, which provides
# excellent semantic search quality while remaining fast enough for real-time use.
RUVECTOR_VECTOR_DIM=1536
RUVECTOR_INDEX_TYPE=hnsw
RUVECTOR_HNSW_M=16
RUVECTOR_HNSW_EF_CONSTRUCTION=200

# Performance tuning for high-throughput scenarios. These values are optimized
# for your 4-PC setup with NVMe storage and high-speed networking.
RUVECTOR_BATCH_SIZE=1000
RUVECTOR_MAX_CONNECTIONS=100
RUVECTOR_CACHE_SIZE_MB=2048

# Storage location on the orchestrator PC. All worker nodes sync to this location.
RUVECTOR_DATA_DIR=/mnt/nyra-data/ruvector
RUVECTOR_BACKUP_ENABLED=true
RUVECTOR_BACKUP_INTERVAL=3600

# ----------------------------------------------------------------------------
# MEMORY SYSTEM: LETTA (OS-LIKE AGENT MEMORY)
# ----------------------------------------------------------------------------

# Letta provides operating system-like memory management for AI agents. It
# separates "core memory" (like RAM - facts the agent needs frequently) from
# "archival memory" (like a hard drive - historical data and documents).
# This is crucial for maintaining agent personas and borrower context.

LETTA_ENABLED=true
LETTA_API_URL=http://localhost:8283
LETTA_API_KEY=${LETTA_SERVER_PASSWORD}

# Server configuration for the Letta service running in Docker.
# The server handles memory persistence using PostgreSQL as the backend.
LETTA_SERVER_URL=http://localhost:8283
LETTA_SERVER_PASSWORD=${INFISICAL_LETTA_PASSWORD}

# Database connection for Letta's persistent storage. This PostgreSQL instance
# stores agent configurations, memory blocks, and conversation state.
LETTA_POSTGRES_URI=postgresql://letta:${LETTA_DB_PASSWORD}@localhost:5432/letta
LETTA_DB_PASSWORD=${INFISICAL_LETTA_DB_PASSWORD}

# Memory sizing determines how much information each agent can hold in its
# active "working memory" versus how much gets archived for later retrieval.
LETTA_CORE_MEMORY_SIZE=4000
LETTA_ARCHIVAL_MEMORY_ENABLED=true
LETTA_ARCHIVAL_MEMORY_SIZE=unlimited

# Agent configuration controls default behaviors for spawned agents.
# Persistence ensures agents remember across sessions (critical for mortgage ops).
LETTA_AGENT_PERSISTENCE=enabled
LETTA_AGENT_DEFAULT_MODEL=claude-sonnet-4-20250514
LETTA_AGENT_DEFAULT_EMBEDDING=openai/text-embedding-3-small

# MCP server integration allows Claude-Flow to control Letta through the
# Model Context Protocol, enabling seamless agent memory management.
LETTA_MCP_ENABLED=true
LETTA_MCP_PORT=8284

# ----------------------------------------------------------------------------
# MEMORY SYSTEM: GRAPHITI + FALKORDB (TEMPORAL KNOWLEDGE GRAPHS)
# ----------------------------------------------------------------------------

# Graphiti builds temporal knowledge graphs that track how information changes
# over time. This is essential for mortgage operations where you need to know
# "What was the borrower's income last month vs this month?" or track the
# evolution of loan applications through the pipeline.

GRAPHITI_ENABLED=true
GRAPHITI_BACKEND=falkordb

# FalkorDB is a graph database built on Redis that provides fast graph queries
# with persistence. It's Redis-compatible but optimized for graph operations.
FALKORDB_ENABLED=true
FALKORDB_URL=redis://localhost:6379
FALKORDB_PASSWORD=${INFISICAL_FALKORDB_PASSWORD}

# Graph naming helps organize different knowledge domains. The Nyra knowledge
# graph stores all mortgage-related entities, relationships, and temporal data.
FALKORDB_GRAPH_NAME=nyra_knowledge_graph
FALKORDB_PERSISTENCE=aof
FALKORDB_AOF_SYNC=everysec

# Temporal tracking captures timestamps and versioning for all graph updates.
# This enables time-travel queries like "Show me the loan status 3 days ago."
GRAPHITI_TEMPORAL_TRACKING=true
GRAPHITI_SNAPSHOT_INTERVAL=300
GRAPHITI_SNAPSHOT_RETENTION_DAYS=90

# Compression reduces storage costs for large knowledge graphs without
# sacrificing query performance. Historical snapshots are compressed automatically.
GRAPHITI_COMPRESSION_ENABLED=true
GRAPHITI_COMPRESSION_ALGORITHM=zstd

# Entity extraction uses AI to automatically identify key entities (people,
# loans, properties) from unstructured text and add them to the knowledge graph.
GRAPHITI_AUTO_EXTRACTION=true
GRAPHITI_EXTRACTION_MODEL=claude-sonnet-4-20250514
GRAPHITI_EXTRACTION_BATCH_SIZE=100

# Memory allocation for graph operations. FalkorDB runs in Redis, so these
# settings control Redis memory usage for graph data structures.
FALKORDB_MAX_MEMORY=2GB
FALKORDB_EVICTION_POLICY=allkeys-lru

# ----------------------------------------------------------------------------
# MEMORY SYSTEM: MEM0 + OPENMEMORY (USER PERSONALIZATION)
# ----------------------------------------------------------------------------

# Mem0 and OpenMemory provide a cross-application user personalization layer.
# This is where you store borrower preferences, communication preferences,
# and personal information that should follow the user across different
# apps in the Nyra ecosystem (chatbot, CRM, landing pages, etc.).

MEM0_ENABLED=true
MEM0_SERVER_URL=http://localhost:8080
MEM0_API_KEY=${INFISICAL_MEM0_API_KEY}

# OpenMemory extends Mem0 with MCP server capabilities, allowing Claude-Flow
# agents to directly read/write user profile data during conversations.
OPENMEMORY_ENABLED=true
OPENMEMORY_MCP_SERVER=true
OPENMEMORY_MCP_PORT=8081

# Synchronization ensures user profile changes propagate across all apps.
# A 60-second interval balances freshness with performance.
OPENMEMORY_SYNC_INTERVAL=60
OPENMEMORY_CROSS_APP_SHARING=true

# Cloud backup is disabled by default for privacy, but can be enabled if
# you want to backup user profiles to S3 or similar storage.
OPENMEMORY_CLOUD_BACKUP=false
OPENMEMORY_BACKUP_DESTINATION=${AWS_S3_BUCKET}

# User profile schema defines what information is tracked per user.
# This should align with your CRM schema for consistency.
MEM0_PROFILE_SCHEMA=mortgage_borrower
MEM0_TRACK_PREFERENCES=true
MEM0_TRACK_INTERACTIONS=true
MEM0_TRACK_DECISIONS=true

# Privacy controls ensure compliance with data protection regulations.
# PII redaction automatically masks sensitive fields in logs and exports.
MEM0_PII_PROTECTION=enabled
MEM0_PII_REDACTION=automatic
MEM0_GDPR_COMPLIANT=true
MEM0_DATA_RETENTION_DAYS=365

# ----------------------------------------------------------------------------
# AI ORCHESTRATORS: CLAUDE-FLOW + ARCHON + RUV-SWARM
# ----------------------------------------------------------------------------

# Claude-Flow is the primary orchestration framework. It coordinates agents,
# manages workflows, and handles task decomposition using the SPARC methodology.

CLAUDE_FLOW_ENABLED=true
CLAUDE_FLOW_AUTO_COMMIT=true
CLAUDE_FLOW_AUTO_PUSH=false
CLAUDE_FLOW_HOOKS_ENABLED=true
CLAUDE_FLOW_CHECKPOINT_ENABLED=true
CLAUDE_FLOW_MEMORY_PERSISTENCE=true
CLAUDE_FLOW_NEURAL_OPTIMIZATION=true
CLAUDE_FLOW_AUTO_LEARNING=true
CLAUDE_FLOW_PARALLEL_PROCESSING=true
CLAUDE_FLOW_AGENT_POOL=true
CLAUDE_FLOW_CACHE_ENABLED=true

# GitHub integration enables automatic commit hooks, release management,
# and checkpoint creation for rollback capabilities.
CLAUDE_FLOW_GITHUB_INTEGRATION=true
CLAUDE_FLOW_REMOTE_EXECUTION=true
GITHUB_TOKEN=${INFISICAL_GITHUB_TOKEN}
GITHUB_REPO=Project-Nyra
GITHUB_OWNER=${YOUR_GITHUB_USERNAME}

# Archon provides advanced task orchestration with support for complex
# dependency graphs and conditional execution paths.
ARCHON_ENABLED=true
ARCHON_MCP_PORT=3333
ARCHON_TOPOLOGY=hierarchical
ARCHON_MAX_DEPTH=5
ARCHON_PARALLEL_BRANCHES=true

# Ruv-Swarm manages distributed agent swarms with WASM-powered performance.
# It handles agent spawning, lifecycle management, and inter-agent communication.
RUV_SWARM_ENABLED=true
RUV_SWARM_MCP_PORT=3334
RUV_SWARM_TOPOLOGY=mesh
RUV_SWARM_MAX_AGENTS=100
RUV_SWARM_WASM_ENABLED=true
RUV_SWARM_NEURAL_OPTIMIZATION=true

# ----------------------------------------------------------------------------
# AI MODELS: LOCAL GPU WORKERS + CLOUD FALLBACKS
# ----------------------------------------------------------------------------

# Model routing determines which AI model handles each request. The Nexus
# Router intelligently routes to local GPU workers first, falling back to
# cloud APIs only when necessary (for complex reasoning or when local models
# are overloaded).

NEXUS_ROUTER_ENABLED=true
NEXUS_ROUTER_PORT=4000
NEXUS_ROUTER_MCP_PORT=4001

# Local model endpoints are your three GPU worker machines running Ollama.
# Each worker specializes in different model sizes based on VRAM capacity.

# Worker 5090 (48GB VRAM) - Large models for complex reasoning
WORKER_5090_URL=http://worker-5090.tail-net.ts.net:11434
WORKER_5090_MODELS=deepseek-r1:236b-q4_K_M,qwen2.5:72b-instruct-q8_0
WORKER_5090_PRIMARY_USE=reasoning

# Worker 3090 (24GB VRAM) - Medium-large models for analysis
WORKER_3090_URL=http://worker-3090.tail-net.ts.net:11434
WORKER_3090_MODELS=llama3.1:70b-instruct-q4_K_M,mistral-large:123b-instruct-2407-q4_K_M
WORKER_3090_PRIMARY_USE=analysis

# Worker 3060 (12GB VRAM) - Specialized models for coding
WORKER_3060_URL=http://worker-3060.tail-net.ts.net:11434
WORKER_3060_MODELS=codellama:34b-instruct-q8_0,qwen2.5:32b-instruct-q8_0,gemma2:27b-instruct-q8_0
WORKER_3060_PRIMARY_USE=coding

# Cloud API fallbacks for when local models are insufficient or unavailable.
# These provide guaranteed availability and handle the most complex tasks.

# Anthropic Claude Sonnet 4 - Primary cloud model for critical operations
ANTHROPIC_API_KEY=${INFISICAL_ANTHROPIC_API_KEY}
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096

# OpenRouter - Cost-effective cloud routing with 99% savings vs direct APIs
OPENROUTER_API_KEY=${INFISICAL_OPENROUTER_API_KEY}
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-r1

# LiteLLM proxy configuration for unified model access
LITELLM_MASTER_KEY=${INFISICAL_LITELLM_MASTER_KEY}
LITELLM_PORT=8000
LITELLM_DATABASE_URL=postgresql://litellm:${LITELLM_DB_PASSWORD}@localhost:5432/litellm

# Model routing rules define when to use local vs cloud models
MODEL_ROUTING_STRATEGY=cost-optimized
MODEL_ROUTING_PREFER_LOCAL=true
MODEL_ROUTING_FALLBACK_CLOUD=true
MODEL_ROUTING_COST_THRESHOLD=0.10

# ----------------------------------------------------------------------------
# INFRASTRUCTURE: CORE SERVICES
# ----------------------------------------------------------------------------

# PostgreSQL - Primary relational database for Letta, TwentyCRM, Dify, n8n
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nyra
POSTGRES_PASSWORD=${INFISICAL_POSTGRES_PASSWORD}
POSTGRES_DB=nyra_production

# Individual database names for service isolation
LETTA_DB_NAME=letta
TWENTY_DB_NAME=twenty
DIFY_DB_NAME=dify
N8N_DB_NAME=n8n

# Redis - Caching, session storage, message queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=${INFISICAL_REDIS_PASSWORD}
REDIS_DB=0
REDIS_MAX_MEMORY=4GB
REDIS_EVICTION_POLICY=allkeys-lru

# Neo4j - Graph database for Graphiti (alternative to FalkorDB)
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=${INFISICAL_NEO4J_PASSWORD}
NEO4J_DATABASE=nyra_graph

# Qdrant - Vector database for embeddings and semantic search
QDRANT_ENABLED=true
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=${INFISICAL_QDRANT_API_KEY}
QDRANT_COLLECTION=nyra_embeddings
QDRANT_VECTOR_SIZE=1536

# ----------------------------------------------------------------------------
# INFRASTRUCTURE: AI PLATFORMS
# ----------------------------------------------------------------------------

# Dify - No-code AI application builder and chatbot platform
DIFY_ENABLED=true
DIFY_API_URL=http://localhost:5001
DIFY_WEB_URL=http://localhost:3000
DIFY_API_KEY=${INFISICAL_DIFY_API_KEY}
DIFY_POSTGRES_HOST=localhost
DIFY_POSTGRES_PORT=5432
DIFY_POSTGRES_USER=dify
DIFY_POSTGRES_PASSWORD=${INFISICAL_DIFY_DB_PASSWORD}
DIFY_POSTGRES_DB=dify
DIFY_REDIS_HOST=localhost
DIFY_REDIS_PORT=6379
DIFY_REDIS_PASSWORD=${INFISICAL_REDIS_PASSWORD}

# n8n - Workflow automation platform for drip campaigns
N8N_ENABLED=true
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
N8N_ENCRYPTION_KEY=${INFISICAL_N8N_ENCRYPTION_KEY}
N8N_POSTGRES_HOST=localhost
N8N_POSTGRES_PORT=5432
N8N_POSTGRES_USER=n8n
N8N_POSTGRES_PASSWORD=${INFISICAL_N8N_DB_PASSWORD}
N8N_POSTGRES_DB=n8n
N8N_WEBHOOK_URL=https://n8n.ratehunter.net

# Activepieces - Alternative workflow automation (MIT license)
ACTIVEPIECES_ENABLED=true
ACTIVEPIECES_PORT=8080
ACTIVEPIECES_POSTGRES_HOST=localhost
ACTIVEPIECES_POSTGRES_PORT=5432
ACTIVEPIECES_POSTGRES_DATABASE=activepieces
ACTIVEPIECES_POSTGRES_PASSWORD=${INFISICAL_ACTIVEPIECES_DB_PASSWORD}
ACTIVEPIECES_ENCRYPTION_KEY=${INFISICAL_ACTIVEPIECES_ENCRYPTION_KEY}

# TwentyCRM - Open-source CRM for mortgage lead management
TWENTY_ENABLED=true
TWENTY_PORT=3001
TWENTY_DATABASE_URL=postgresql://twenty:${TWENTY_DB_PASSWORD}@localhost:5432/twenty
TWENTY_SERVER_URL=http://localhost:3001
TWENTY_FRONT_BASE_URL=http://localhost:3001

# ----------------------------------------------------------------------------
# MORTGAGE INTEGRATIONS: LEAD SOURCES & PRICING
# ----------------------------------------------------------------------------

# These are the external APIs that provide mortgage leads and rate quotes.
# Each integration has its own authentication and configuration requirements.

# FreeRateUpdate - Mortgage lead provider
FREE_RATE_UPDATE_ENABLED=true
FREE_RATE_UPDATE_API_KEY=${INFISICAL_FREE_RATE_UPDATE_KEY}
FREE_RATE_UPDATE_WEBHOOK_URL=https://api.ratehunter.net/webhooks/free-rate-update

# LendingTree - Major mortgage lead marketplace
LENDING_TREE_ENABLED=true
LENDING_TREE_API_KEY=${INFISICAL_LENDING_TREE_KEY}
LENDING_TREE_WEBHOOK_URL=https://api.ratehunter.net/webhooks/lending-tree

# LenderPrice - Rate pricing and comparison engine
LENDER_PRICE_ENABLED=true
LENDER_PRICE_API_KEY=${INFISICAL_LENDER_PRICE_KEY}
LENDER_PRICE_BASE_URL=https://api.lenderprice.com
LENDER_PRICE_QUOTE_TIMEOUT=30

# Rocket Mortgage API - Primary quote source
ROCKET_MORTGAGE_ENABLED=true
ROCKET_MORTGAGE_API_KEY=${INFISICAL_ROCKET_MORTGAGE_KEY}
ROCKET_MORTGAGE_PARTNER_ID=${INFISICAL_ROCKET_PARTNER_ID}
ROCKET_MORTGAGE_BASE_URL=https://api.rocketmortgage.com

# ----------------------------------------------------------------------------
# COMMUNICATION SERVICES
# ----------------------------------------------------------------------------

# Twilio - SMS, voice calls, and voicemail drops
TWILIO_ENABLED=true
TWILIO_ACCOUNT_SID=${INFISICAL_TWILIO_ACCOUNT_SID}
TWILIO_AUTH_TOKEN=${INFISICAL_TWILIO_AUTH_TOKEN}
TWILIO_PHONE_NUMBER=${INFISICAL_TWILIO_PHONE_NUMBER}
TWILIO_MESSAGING_SERVICE_SID=${INFISICAL_TWILIO_MESSAGING_SID}

# SendGrid - Transactional emails
SENDGRID_ENABLED=true
SENDGRID_API_KEY=${INFISICAL_SENDGRID_API_KEY}
SENDGRID_FROM_EMAIL=noreply@ratehunter.net
SENDGRID_FROM_NAME=Nyra Mortgage Assistant

# Resend - Modern email API (alternative to SendGrid)
RESEND_ENABLED=false
RESEND_API_KEY=${INFISICAL_RESEND_API_KEY}
RESEND_FROM_EMAIL=noreply@ratehunter.net

# ----------------------------------------------------------------------------
# NETWORKING & INFRASTRUCTURE
# ----------------------------------------------------------------------------

# Tailscale - Secure mesh VPN connecting all 4 PCs
TAILSCALE_ENABLED=true
TAILSCALE_AUTH_KEY=${INFISICAL_TAILSCALE_AUTH_KEY}
TAILSCALE_HOSTNAME=orchestrator
TAILSCALE_ADVERTISE_ROUTES=192.168.1.0/24

# Cloudflare Tunnel - Secure public access without exposing ports
CLOUDFLARE_TUNNEL_ENABLED=true
CLOUDFLARE_TUNNEL_TOKEN=${INFISICAL_CLOUDFLARE_TUNNEL_TOKEN}
CLOUDFLARE_ACCOUNT_ID=${INFISICAL_CLOUDFLARE_ACCOUNT_ID}

# Domain configuration
DOMAIN_PRIMARY=ratehunter.net
DOMAIN_API=api.ratehunter.net
DOMAIN_APP=app.ratehunter.net
DOMAIN_CRM=crm.ratehunter.net

# ----------------------------------------------------------------------------
# MONITORING & OBSERVABILITY
# ----------------------------------------------------------------------------

# Prometheus - Metrics collection
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_DAYS=30

# Grafana - Metrics visualization
GRAFANA_ENABLED=true
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=${INFISICAL_GRAFANA_PASSWORD}

# Sentry - Error tracking and performance monitoring
SENTRY_ENABLED=true
SENTRY_DSN=${INFISICAL_SENTRY_DSN}
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ----------------------------------------------------------------------------
# SECURITY & SECRETS MANAGEMENT
# ----------------------------------------------------------------------------

# Infisical - Secrets management (replaces .env files in production)
INFISICAL_PROJECT_ID=8374cea9-e5e8-4050-bda4-b91f25ab30ef
INFISICAL_CLIENT_ID=${INFISICAL_CLIENT_ID}
INFISICAL_CLIENT_SECRET=${INFISICAL_CLIENT_SECRET}
INFISICAL_ENVIRONMENT=production
INFISICAL_PATH=/shared

# Encryption keys for sensitive data at rest
ENCRYPTION_KEY=${INFISICAL_ENCRYPTION_KEY_MAIN}
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_IV_LENGTH=16

# Session management
SESSION_SECRET=${INFISICAL_SESSION_SECRET}
SESSION_MAX_AGE=86400
SESSION_SECURE=true

# CORS configuration for frontend applications
CORS_ALLOWED_ORIGINS=https://ratehunter.net,https://app.ratehunter.net,https://crm.ratehunter.net
CORS_ALLOW_CREDENTIALS=true

# ----------------------------------------------------------------------------
# COMPLIANCE & AUDIT
# ----------------------------------------------------------------------------

# Audit logging for regulatory compliance (TRID, ECOA, RESPA)
AUDIT_LOG_ENABLED=true
AUDIT_LOG_LEVEL=info
AUDIT_LOG_DESTINATION=/var/log/nyra/audit.log
AUDIT_LOG_RETENTION_DAYS=2555
AUDIT_LOG_ENCRYPT=true

# Data retention policies
DATA_RETENTION_APPLICATIONS=2555
DATA_RETENTION_CONVERSATIONS=365
DATA_RETENTION_SYSTEM_LOGS=90

# ----------------------------------------------------------------------------
# PERFORMANCE TUNING
# ----------------------------------------------------------------------------

# Node.js performance settings
NODE_OPTIONS=--max-old-space-size=4096 --max-http-header-size=16384

# Connection pooling for databases
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000

# Cache TTL settings (in seconds)
CACHE_TTL_DEFAULT=300
CACHE_TTL_QUOTES=60
CACHE_TTL_USER_SESSIONS=3600
CACHE_TTL_STATIC_DATA=86400

# Rate limiting to prevent abuse
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL=false

# ----------------------------------------------------------------------------
# FEATURE FLAGS
# ----------------------------------------------------------------------------

# Feature toggles for gradual rollout of new functionality
FEATURE_NEURAL_OPTIMIZATION=true
FEATURE_AUTO_LEARNING=true
FEATURE_VOICE_CALLS=true
FEATURE_DOCUMENT_OCR=true
FEATURE_PREDICTIVE_ANALYTICS=true
FEATURE_A_B_TESTING=true
FEATURE_MULTI_LANGUAGE=false

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
