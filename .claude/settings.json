{
  "env": {
    "SOURCEGIT_CMD": "/usr/bin/sourcegit",
    "LLXPRT_SOURCEGIT": "/usr/bin/sourcegit",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [],
    "deny": [],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "kild agent-status --self working 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "rulecheck-agent",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/skills/rulecheck/hooks/pre-tool-use.sh",
            "statusMessage": "Running pre-tool checks..."
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "wsh badge message-question --color '#e0b956' --priority 20 --beep"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/skills/save-task-list/hooks/verify-task-list.sh",
            "statusMessage": "Checking for restored task list..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "kild agent-status --self idle 2>/dev/null || true",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "wsh badge check --color '#58c142' --priority 10"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "rulecheck-agent",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/skills/rulecheck/hooks/slack-notify.sh",
            "statusMessage": "Notifying Slack..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "kild agent-status --self idle 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "kild agent-status --self waiting 2>/dev/null || true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "wsh badge bell-exclamation --color '#e0b956' --priority 20 --beep"
          }
        ]
      },
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "wsh badge message-question --color '#e0b956' --priority 20 --beep"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "kild status-line"
  },
  "enabledPlugins": {
    "serena@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "agent-skills@addy-agent-skills": true,
    "frontend-design@claude-plugins-official": true,
    "claude-subconscious@claude-subconscious": true,
    "oh-my-claudecode@oh-my-claudecode": true
  },
  "skipDangerousModePermissionPrompt": true,
  "dangerouslySkipAllPrompts": true,
  "yoloMode": true,
  "mcpServers": {
    "nexus-router": {
      "type": "sse",
      "url": "http://127.0.0.1:6000/mcp",
      "startup_timeout_sec": 90
    },
    "serena": {
      "command": "/home/ellisapotheosis/.local/bin/uvx",
      "args": [
        "--python",
        "3.13",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context=claude-code"
      ],
      "startup_timeout_sec": 60
    },
    "omc": {
      "command": "node",
      "args": [
        "/home/ellisapotheosis/.claude/plugins/cache/oh-my-claudecode/oh-my-claudecode/4.13.5/bridge/mcp-server.cjs"
      ],
      "env": {
        "CLAUDE_PLUGIN_ROOT": "/home/ellisapotheosis/.claude/plugins/cache/oh-my-claudecode/oh-my-claudecode/4.13.5"
      }
    }
  }
}
