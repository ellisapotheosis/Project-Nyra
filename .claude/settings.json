{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "description": "Nyra Orchestrator - Global Machine Config",
  "minimumVersion": "2.1.72",
  "theme": "dark",
  "verboseMode": false,
  "alwaysThinkingEnabled": true,
  "model": "opus",
  "effortLevel": "high",
  "fastMode": true,
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "autoConnectIde": true,
  "autoCompact": true,

  "thinking": {
    "enabled": true,
    "budgetTokens": 6000
  },

  "capabilities": {
    "allowUnsandboxedCommands": true,
    "webSearch": true,
    "pdfRead": true,
    "imageAnalysis": true,
    "networkAccess": true,
    "fileSystemAccess": true,
    "shellAccess": true,
    "internetAccess": true,
    "systemCommands": true,
    "mcpAccess": true,
    "browserAutomation": true
  },

  "env": {
    "SHELL": "/bin/zsh",
    "ZDOTDIR": "/tmp",
    "DISABLE_AUTOUPDATER": "0",
    "ENABLE_METRICS": "true",
    "ENABLE_TRACING": "true",
    "LOG_LEVEL": "info"
  },

  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "*",
      "mcp__*",
      "mcp__claude-flow__:*",
      "Bash",
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "Task",
      "TaskCreate",
      "TaskUpdate",
      "TaskOutput",
      "Bash(npx claude-flow:*)",
      "Bash(npx @claude-flow/cli:*)",
      "Bash(claude:*)",
      "Bash(where.exe:*)",
      "Bash(tree:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(chmod:*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(shutdown *)",
      "Bash(reboot *)"
    ]
  },

  "statusLine": {
    "type": "command",
    "command": "npx @claude-flow/cli@latest hooks statusline 2>/dev/null || node .claude/helpers/statusline.cjs 2>/dev/null || echo \"▊ Claude Flow V3\""
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "export INFISICAL_TOKEN=$(infisical login --method=universal-auth --client-id=${INFISICAL_UNIVERSAL_AUTH_CLIENT_ID} --client-secret=${INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET} --silent --plain) && infisical export --projectId=\"8374cea9-e5e8-4050-bda4-b91f25ab30ef\" --env=\"dev\" --format=dotenv > .env"
          },
          {
            "type": "command",
            "command": "[ -n \"$TOOL_INPUT_command\" ] && npx @claude-flow/cli@latest hooks pre-command --command \"$TOOL_INPUT_command\" 2>/dev/null || true",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "^(Write|Edit|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TOOL_INPUT_file_path\" ] && npx @claude-flow/cli@latest hooks pre-edit --file \"$TOOL_INPUT_file_path\" 2>/dev/null || true",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "^Task$",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TOOL_INPUT_prompt\" ] && npx @claude-flow/cli@latest hooks pre-task --task-id \"task-$(date +%s)\" --description \"$TOOL_INPUT_prompt\" 2>/dev/null || true",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TOOL_INPUT_file_path\" ] && npx @claude-flow/cli@latest hooks post-edit --file \"$TOOL_INPUT_file_path\" --success \"${TOOL_SUCCESS:-true}\" 2>/dev/null || true",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TOOL_INPUT_command\" ] && npx @claude-flow/cli@latest hooks post-command --command \"$TOOL_INPUT_command\" --success \"${TOOL_SUCCESS:-true}\" 2>/dev/null || true",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "^Task$",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TOOL_RESULT_agent_id\" ] && npx @claude-flow/cli@latest hooks post-task --task-id \"$TOOL_RESULT_agent_id\" --success \"${TOOL_SUCCESS:-true}\" 2>/dev/null || true",
            "timeout": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$PROMPT\" ] && npx @claude-flow/cli@latest hooks route --task \"$PROMPT\" || true",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx @claude-flow/cli@latest daemon start --quiet 2>/dev/null || true",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "[ -n \"$SESSION_ID\" ] && npx @claude-flow/cli@latest hooks session-restore --session-id \"$SESSION_ID\" 2>/dev/null || true",
            "timeout": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx @claude-flow/cli@latest hooks session-end --save-state true --export-metrics true 2>/dev/null || true",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "npx @claude-flow/cli@latest daemon stop --graceful 2>/dev/null || true",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx @claude-flow/cli@latest hooks session-end --save-state true --export-metrics true 2>/dev/null || true",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "npx @claude-flow/cli@latest memory store --namespace sessions --key \"last-session-$(date +%Y%m%d-%H%M%S)\" --value \"{\\\"endTime\\\": \\\"$(date -Iseconds)\\\", \\\"sessionId\\\": \\\"${SESSION_ID:-unknown}\\\"}\" 2>/dev/null || true",
            "timeout": 3000
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$NOTIFICATION_MESSAGE\" ] && npx @claude-flow/cli@latest memory store --namespace notifications --key \"notify-$(date +%s)\" --value \"$NOTIFICATION_MESSAGE\" 2>/dev/null || true",
            "timeout": 3000
          }
        ]
      }
    ]
  }
}