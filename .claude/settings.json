{
  "env": {
    "SOURCEGIT_CMD": "/usr/bin/sourcegit",
    "LLXPRT_SOURCEGIT": "/usr/bin/sourcegit",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [],
    "deny": [],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "rulecheck-agent",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/skills/rulecheck/hooks/pre-tool-use.sh",
            "statusMessage": "Running pre-tool checks..."
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "wsh badge message-question --color '#e0b956' --priority 20 --beep"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/skills/save-task-list/hooks/verify-task-list.sh",
            "statusMessage": "Checking for restored task list..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "kild agent-status --self idle 2>/dev/null || true",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "wsh badge check --color '#58c142' --priority 10"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "rulecheck-agent",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/skills/rulecheck/hooks/slack-notify.sh",
            "statusMessage": "Notifying Slack..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "kild agent-status --self idle 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "kild agent-status --self waiting 2>/dev/null || true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "wsh badge bell-exclamation --color '#e0b956' --priority 20 --beep"
          }
        ]
      },
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "wsh badge message-question --color '#e0b956' --priority 20 --beep"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "kild status-line"
  },
  "enabledPlugins": {
    "serena@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "agent-skills@addy-agent-skills": true
  },
  "skipDangerousModePermissionPrompt": true,
  "dangerouslySkipAllPrompts": true,
  "yoloMode": true,
  "mcpServers": {
    "nexus-router": {
      "type": "sse",
      "url": "http://100.64.0.1:8080/mcp/sse"
    },
    "serena": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "services/serena-mcp",
        "serena-mcp-server"
      ]
    }
  }
}
