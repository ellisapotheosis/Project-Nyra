{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx @claude-flow/cli@3.0.0-alpha.104 hooks pre-edit --file \"$file\" 2>/dev/null || true",
            "timeout": 5000,
            "continueOnError": true,
            "name": "pre-edit-coordination"
          }
        ],
        "name": "PreEdit",
        "tool": "Edit"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx @claude-flow/cli@3.0.0-alpha.104 hooks pre-edit --file \"$file\" 2>/dev/null || true",
            "timeout": 5000,
            "continueOnError": true,
            "name": "pre-write-coordination"
          }
        ],
        "name": "PreWrite",
        "tool": "Write"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx @claude-flow/cli@3.0.0-alpha.104 hooks pre-task --description \"$description\" 2>/dev/null || true",
            "timeout": 5000,
            "continueOnError": true,
            "name": "pre-task-coordination"
          }
        ],
        "name": "PreTask",
        "tool": "Bash"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx @claude-flow/cli@3.0.0-alpha.104 hooks post-edit --file \"$file\" --memory-key \"swarm/edit/$file\" 2>/dev/null || true",
            "timeout": 5000,
            "continueOnError": true,
            "name": "post-edit-coordination"
          }
        ],
        "name": "PostEdit",
        "tool": "Edit"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx @claude-flow/cli@3.0.0-alpha.104 hooks post-edit --file \"$file\" --memory-key \"swarm/write/$file\" 2>/dev/null || true",
            "timeout": 5000,
            "continueOnError": true,
            "name": "post-write-coordination"
          }
        ],
        "name": "PostWrite",
        "tool": "Write"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx @claude-flow/cli@3.0.0-alpha.104 hooks post-task --task-id \"$task_id\" 2>/dev/null || true",
            "timeout": 5000,
            "continueOnError": true,
            "name": "post-task-coordination"
          }
        ],
        "name": "PostTask",
        "tool": "Bash"
      }
    ],
    "UserPromptSubmit": [],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx @claude-flow/cli@3.0.0-alpha.104 daemon start 2>/dev/null || true",
            "timeout": 5000,
            "continueOnError": true,
            "name": "daemon-auto-start"
          },
          {
            "type": "command",
            "command": "npx @claude-flow/cli@3.0.0-alpha.104 hooks session-restore --session-id \"project-nyra-$timestamp\" 2>/dev/null || true",
            "timeout": 5000,
            "continueOnError": true,
            "name": "session-restore"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx @claude-flow/cli@3.0.0-alpha.104 hooks session-end --export-metrics true 2>/dev/null || true",
            "timeout": 5000,
            "continueOnError": true,
            "name": "session-end-export"
          },
          {
            "type": "command",
            "command": "echo '{\"ok\": true}'",
            "timeout": 1000
          }
        ]
      }
    ],
    "Notification": []
  },
  "statusLine": {
    "type": "command",
    "command": "npx @claude-flow/cli@3.0.0-alpha.104 status --format compact 2>/dev/null || echo \"▊ Project Nyra\"",
    "refreshMs": 5000,
    "enabled": true
  },
  "permissions": {
    "allow": [
      "Bash(npx claude-flow:*)",
      "Bash(npx @claude-flow/cli:*)",
      "mcp__claude-flow__:*"
    ],
    "deny": []
  },
  "claudeFlow": {
    "version": "3.0.0",
    "enabled": true,
    "modelPreferences": {
      "default": "claude-opus-4-5-20251101",
      "routing": "claude-3-5-haiku-20241022"
    },
    "swarm": {
      "topology": "hierarchical-mesh",
      "maxAgents": 15
    },
    "memory": {
      "backend": "hybrid",
      "enableHNSW": true
    },
    "neural": {
      "enabled": true
    },
    "daemon": {
      "autoStart": true,
      "workers": [
        "map",
        "audit",
        "optimize",
        "consolidate",
        "testgaps",
        "ultralearn",
        "deepdive",
        "document",
        "refactor",
        "benchmark"
      ],
      "schedules": {
        "audit": {
          "interval": "1h",
          "priority": "critical"
        },
        "optimize": {
          "interval": "30m",
          "priority": "high"
        },
        "consolidate": {
          "interval": "2h",
          "priority": "low"
        },
        "document": {
          "interval": "1h",
          "priority": "normal",
          "triggers": [
            "adr-update",
            "api-change"
          ]
        },
        "deepdive": {
          "interval": "4h",
          "priority": "normal",
          "triggers": [
            "complex-change"
          ]
        },
        "ultralearn": {
          "interval": "1h",
          "priority": "normal"
        }
      }
    },
    "learning": {
      "enabled": true,
      "autoTrain": true,
      "patterns": [
        "coordination",
        "optimization",
        "prediction"
      ],
      "retention": {
        "shortTerm": "24h",
        "longTerm": "30d"
      }
    },
    "adr": {
      "autoGenerate": true,
      "directory": "/docs/adr",
      "template": "madr"
    },
    "ddd": {
      "trackDomains": true,
      "validateBoundedContexts": true,
      "directory": "/docs/ddd"
    },
    "security": {
      "autoScan": true,
      "scanOnEdit": true,
      "cveCheck": true,
      "threatModel": true
    }
  }
}
