{
  "env": {
    "SOURCEGIT_CMD": "/usr/bin/sourcegit",
    "LLXPRT_SOURCEGIT": "/usr/bin/sourcegit",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [],
    "deny": [],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "kild agent-status --self working 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "kild agent-status --self idle 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "kild agent-status --self waiting 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "echo \"Project Nyra\""
  },
  "enabledPlugins": {
    "serena@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "claude-subconscious@claude-subconscious": true
  },
  "skipDangerousModePermissionPrompt": true,
  "mcpServers": {}
}
