{
  "name": "@project-nyra/bootstrap-agent",
  "version": "1.0.0",
  "description": "Bootstrap and initialize any app/module with custom CLAUDE.md, configs, environments, and workflows",
  "type": "module",
  "main": "batch-init.js",
  "bin": {
    "bootstrap-agent": "./batch-init.js"
  },
  "scripts": {
