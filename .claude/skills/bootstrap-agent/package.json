    "batch": "node batch-init.js batch",
    "test": "node batch-init.js create ./test-app nextjs-typescript --dry-run"
  },
  "keywords": [
    "bootstrap",
    "initialization",
    "claude-flow",
    "templates",
    "automation"
  ],
