{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "*",
      "mcp__*",
      "Bash",
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "Glob",
      "Grep",
      "Task",
      "TodoWrite",
      "AskUserQuestion",
      "Skill",
      "NotebookEdit",
      "EnterPlanMode",
      "ExitPlanMode",
      "KillShell",
      "TaskOutput",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(shutdown *)",
      "Bash(reboot *)"
    ]
  },
  "bypassPermissionsModeAccepted": true,
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "claude-flow",
    "ruv-swarm",
    "flow-nexus",
    "agentic-flow",
    "agentdb",
    "agent-booster",
    "epic-sdk"
  ],
  "experimental": {
    "ultrathinking": true,
    "extendedThinking": true,
    "thinkback": true,
    "streamingToolExecution": true,
    "sessionMemory": true,
    "mcpToolSearch": true,
    "toolPear": true,
    "keybindingCustomization": true,
    "sumi": true,
    "scratch": true,
    "claudeaiMcpConnectors": true,
    "enhancedTelemetry": true,
    "codeDiffCli": true,
    "bashHaikuPrefetch": true,
    "permissionExplainer": false
  },
  "wsl": {
    "optimized": true,
    "useNativeFs": true,
    "pathTranslation": true,
    "systemdIntegration": true,
    "dockerIntegration": true
  },
  "performance": {
    "aggressiveCaching": true,
    "prefetchModels": true,
    "parallelToolExecution": true,
    "maxConcurrentTools": 20,
    "enableParallelAgents": true
  },
  "autoAccept": {
    "bash": true,
    "fileOperations": true,
    "networkRequests": true,
    "mcpTools": true,
    "agentSpawn": true,
    "allTools": true
  },
  "suggestions": {
    "enabled": true,
    "autoApply": false,
    "showInline": true,
    "aggressiveness": "high"
  }
}
