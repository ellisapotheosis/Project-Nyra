# ==============================================================================
# LiteLLM Proxy Configuration
# Project Nyra - Unified Model Gateway
# ==============================================================================
# Routes requests to cloud APIs and local GPU workers
# Workers connect via Tailscale mesh network
# ==============================================================================

model_list:
  # ==========================================================================
  # CLOUD PROVIDERS
  # ==========================================================================
  
  # Anthropic Models
  - model_name: claude-sonnet-4-5
    litellm_params:
      model: anthropic/claude-sonnet-4-5-20250929
      api_key: os.environ/ANTHROPIC_API_KEY
      max_tokens: 8192

  - model_name: claude-3-5-sonnet
    litellm_params:
      model: anthropic/claude-3-5-sonnet-20241022
      api_key: os.environ/ANTHROPIC_API_KEY

  - model_name: claude-3-opus
    litellm_params:
      model: anthropic/claude-3-opus-20240229
      api_key: os.environ/ANTHROPIC_API_KEY

  - model_name: claude-3-haiku
    litellm_params:
      model: anthropic/claude-3-haiku-20240307
      api_key: os.environ/ANTHROPIC_API_KEY

  # Google Models
  - model_name: gemini-2.0-flash
    litellm_params:
      model: gemini/gemini-2.0-flash-exp
      api_key: os.environ/GOOGLE_API_KEY

  - model_name: gemini-1.5-pro
    litellm_params:
      model: gemini/gemini-1.5-pro
      api_key: os.environ/GOOGLE_API_KEY

  # OpenRouter Models (fallback)
  - model_name: deepseek-r1
    litellm_params:
      model: openrouter/deepseek/deepseek-r1
      api_key: os.environ/OPENROUTER_API_KEY
      api_base: https://openrouter.ai/api/v1

  - model_name: llama-3.1-405b
    litellm_params:
      model: openrouter/meta-llama/llama-3.1-405b-instruct
      api_key: os.environ/OPENROUTER_API_KEY
      api_base: https://openrouter.ai/api/v1

  # ==========================================================================
  # WORKER-3060 (RTX 3060 12GB) - Embeddings & Small Models
  # Tailscale IP: 100.64.0.2
  # ==========================================================================
  
  - model_name: local/llama3.2-3b
    litellm_params:
      model: ollama/llama3.2:3b
      api_base: http://100.64.0.2:11434
    model_info:
      supports_function_calling: true
      supports_vision: false

  - model_name: local/phi3-mini
    litellm_params:
      model: ollama/phi3:mini
      api_base: http://100.64.0.2:11434

  - model_name: local/nomic-embed
    litellm_params:
      model: ollama/nomic-embed-text
      api_base: http://100.64.0.2:11434
    model_info:
      mode: embedding

  - model_name: local/minilm-embed
    litellm_params:
      model: ollama/all-minilm:l6-v2
      api_base: http://100.64.0.2:11434
    model_info:
      mode: embedding

  # ==========================================================================
  # WORKER-3090 (RTX 3090 Ti 24GB) - Medium Models & Coding
  # Tailscale IP: 100.64.0.3
  # ==========================================================================
  
  - model_name: local/llama3.1-8b
    litellm_params:
      model: ollama/llama3.1:8b
      api_base: http://100.64.0.3:11434
    model_info:
      supports_function_calling: true

  - model_name: local/llama3.1-70b-q4
    litellm_params:
      model: ollama/llama3.1:70b-q4_K_M
      api_base: http://100.64.0.3:11434
    model_info:
      supports_function_calling: true

  - model_name: local/codellama-34b
    litellm_params:
      model: ollama/codellama:34b
      api_base: http://100.64.0.3:11434

  - model_name: local/mistral-7b
    litellm_params:
      model: ollama/mistral:7b
      api_base: http://100.64.0.3:11434

  - model_name: local/mixtral-8x7b
    litellm_params:
      model: ollama/mixtral:8x7b
      api_base: http://100.64.0.3:11434
    model_info:
      supports_function_calling: true

  - model_name: local/deepseek-coder-33b
    litellm_params:
      model: ollama/deepseek-coder:33b
      api_base: http://100.64.0.3:11434

  # ==========================================================================
  # WORKER-5090 (RTX 5090 32GB) - Large Models via vLLM + LMCache
  # Tailscale IP: 100.64.0.4
  # ==========================================================================
  
  - model_name: local/llama3.1-70b
    litellm_params:
      model: openai/llama3.1-70b
      api_base: http://100.64.0.4:8000/v1
      api_key: "not-needed"
    model_info:
      supports_function_calling: true

  - model_name: local/qwen2.5-72b
    litellm_params:
      model: openai/qwen2.5-72b
      api_base: http://100.64.0.4:8000/v1
      api_key: "not-needed"
    model_info:
      supports_function_calling: true

  - model_name: local/deepseek-r1-70b
    litellm_params:
      model: openai/deepseek-r1-70b
      api_base: http://100.64.0.4:8000/v1
      api_key: "not-needed"
    model_info:
      supports_function_calling: true

# ==============================================================================
# ROUTER SETTINGS
# ==============================================================================

router_settings:
  routing_strategy: "least-busy"  # or "simple-shuffle", "latency-based-routing"
  num_retries: 3
  retry_after: 5
  timeout: 120
  fallbacks:
    - claude-sonnet-4-5: ["claude-3-5-sonnet", "gemini-2.0-flash"]
    - local/llama3.1-70b: ["local/llama3.1-70b-q4", "deepseek-r1"]
  
  # Model group aliases for clawdbot/moltbot
  model_group_alias:
    mortgage-assistant: ["claude-sonnet-4-5", "local/llama3.1-70b", "gemini-2.0-flash"]
    embeddings: ["local/nomic-embed", "local/minilm-embed"]
    coding: ["local/codellama-34b", "local/deepseek-coder-33b", "claude-sonnet-4-5"]

# ==============================================================================
# LITELLM SETTINGS
# ==============================================================================

litellm_settings:
  drop_params: true
  set_verbose: false
  cache: true
  cache_params:
    type: "redis"
    host: "redis"
    port: 6379
    ttl: 3600
  success_callback: ["prometheus", "langfuse"]
  failure_callback: ["prometheus"]
  max_budget: 100.0  # USD per day
  budget_duration: "1d"

# ==============================================================================
# GENERAL SETTINGS
# ==============================================================================

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
  database_url: os.environ/DATABASE_URL
  alerting:
    - webhook_url: os.environ/SLACK_WEBHOOK_URL
      alert_types: ["budget_alerts", "failed_tracking"]
