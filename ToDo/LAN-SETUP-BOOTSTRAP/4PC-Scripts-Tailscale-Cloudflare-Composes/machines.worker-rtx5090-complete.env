# =====================================================
# PROJECT NYRA - RTX 5090 WORKER CONFIGURATION
# =====================================================
# Complete environment setup for RTX 5090 GPU worker
# with Ollama, vLLM, LMCache, and monitoring integration
# =====================================================

# =====================================================
# SYSTEM IDENTIFICATION
# =====================================================
WORKER_ROLE=gpu-worker-flagship
WORKER_HOSTNAME=AREA51
WORKER_ID=rtx5090
WORKER_IP=192.168.1.234
WORKER_TAILSCALE_IP=TO_BE_COLLECTED
WORKER_LAN_MAC_ADDRESS=e8-cf-83-ed-e4-95
WORKER_WIFI_MAC_ADDRESS=8e-4c-d1-e6-0b-42

# =====================================================
# GPU SPECIFICATIONS
# =====================================================
GPU_PRIMARY=NVIDIA GeForce RTX 5090 Laptop GPU
GPU_PRIMARY_VRAM_GB=48
GPU_PRIMARY_VRAM_BYTES=51539607552
GPU_PRIMARY_DRIVER_VERSION=32.0.15.8195
GPU_COMPUTE_CAPABILITY=9.0
GPU_MEMORY_BUS_WIDTH=576-bit
GPU_BOOST_CLOCK_GHZ=2.55
GPU_SECONDARY=Intel Graphics
GPU_SECONDARY_VRAM_GB=2
GPU_EXPECTED_VRAM_TOTAL=48
GPU_QUANTIZATION_SUPPORT=FP16,INT8,INT4,AWQ,GPTQ,HQQ

# =====================================================
# INFERENCE ENGINE: OLLAMA
# =====================================================
OLLAMA_ENABLED=true
OLLAMA_HOST=0.0.0.0
OLLAMA_PORT=11434
OLLAMA_MODELS_DIR=/models/ollama
OLLAMA_NUM_PARALLEL=6
OLLAMA_NUM_THREADS=24
OLLAMA_NUM_GPU=1
OLLAMA_KEEP_ALIVE=24h
OLLAMA_FLASH_ATTENTION=1
OLLAMA_LLM_LIBRARY=cuda
OLLAMA_DEBUG=false
OLLAMA_REQUEST_TIMEOUT=300s
OLLAMA_MAX_LOADED_MODELS=2

# Ollama Models Configuration (RTX 5090 specific)
OLLAMA_MODEL_DEEPSEEK_R1=deepseek-r1:236b-q4_K_M
OLLAMA_MODEL_QWEN_72B=qwen2.5:72b-instruct-q8_0
OLLAMA_MODEL_LLAMA_405B=llama3.1:405b-fp8
OLLAMA_CONTEXT_WINDOW=128000

# =====================================================
# INFERENCE ENGINE: VLLM
# =====================================================
VLLM_ENABLED=true
VLLM_PORT=8000
VLLM_HOST=0.0.0.0
VLLM_MODEL=deepseek-ai/deepseek-r1-distill-qwen-32b
VLLM_TOKENIZER_MODE=auto
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_PIPELINE_PARALLEL_SIZE=1
VLLM_GPU_MEMORY_UTILIZATION=0.95
VLLM_MAX_MODEL_LEN=32768
VLLM_ENFORCE_EAGER=false
VLLM_DISABLE_LOG_REQUESTS=false
VLLM_PORT_PROMETHEUS=8265
VLLM_ATTENTION_BACKEND=flashinfer
VLLM_MAX_NUM_SEQS=8
VLLM_NUM_SPECULATIVE_TOKENS=0
VLLM_ENABLE_PREFIX_CACHING=true
VLLM_DISABLE_CUSTOM_ALL_REDUCE=false
VLLM_USE_V2_BLOCK_MANAGER=true
VLLM_SWAP_SPACE=16

# =====================================================
# LMCACHE - KV CACHE OFFLOADING TO SYSTEM RAM
# =====================================================
LMCACHE_ENABLED=true
LMCACHE_BACKEND=redis
LMCACHE_REDIS_HOST=orchestrator-mini
LMCACHE_REDIS_PORT=6379
LMCACHE_REDIS_PASSWORD=to_be_set_in_infisical
LMCACHE_REDIS_DB=0
LMCACHE_LOCAL_CPU=true
LMCACHE_MAX_LOCAL_CPU_SIZE=24
LMCACHE_CHUNK_SIZE=256
LMCACHE_TTL_SECONDS=7200
LMCACHE_MAX_CACHE_SIZE_GB=24
LMCACHE_PRIORITY=disk-first
LMCACHE_COMPRESSION=true
LMCACHE_COMPRESSION_LEVEL=6
LMCACHE_KV_TRANSFER_CONFIG={"kv_connector":"LMCacheConnectorV1","kv_role":"kv_both"}
LMCACHE_HYBRID_MODE=true
LMCACHE_SPILLOVER_THRESHOLD_GB=20
LMCACHE_ENABLE_FLASH_ATTENTION=true
LMCACHE_ENABLE_PAGED_ATTENTION=true

# =====================================================
# NETWORKING & CONNECTIVITY
# =====================================================
# LAN (Primary)
LAN_ADAPTER_NAME=Ethernet
LAN_ADAPTER_DESCRIPTION=Killer E5000 5 Gigabit Ethernet Controller
LAN_MAC_ADDRESS=e8-cf-83-ed-e4-95
LAN_IPV4_ADDRESS=192.168.1.234
LAN_IPV6_ADDRESS=2600:1700:65f0:8960::3f
LAN_GATEWAY=192.168.1.254
LAN_DNS_PRIMARY=192.168.1.254
LAN_LINK_SPEED=2.5Gbps
LAN_DHCP_ENABLED=true

# WiFi (Secondary)
WIFI_ADAPTER_NAME=Wi-Fi
WIFI_ADAPTER_DESCRIPTION=Killer Wi-Fi 7 BE1750w
WIFI_MAC_ADDRESS=8e-4c-d1-e6-0b-42
WIFI_IPV4_ADDRESS=192.168.1.235
WIFI_IPV6_ADDRESS=2600:1700:65f0:8960::11
WIFI_GATEWAY=192.168.1.254
WIFI_LINK_SPEED_RX=1081Mbps
WIFI_LINK_SPEED_TX=245Mbps
WIFI_ENABLED=true

# Tailscale VPN
TAILSCALE_ENABLED=true
TAILSCALE_INSTALLED=false
TAILSCALE_RUNNING=false
TAILSCALE_IPV4_ADDRESS=TO_BE_COLLECTED
TAILSCALE_HOSTNAME=area51
TAILSCALE_API_KEY=to_be_set_in_infisical
TAILSCALE_AUTH_KEY=to_be_set_in_infisical
TAILSCALE_TAILNET=to_be_set_in_infisical

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_ENABLED=true
CLOUDFLARE_TUNNEL_INSTALLED=false
CLOUDFLARE_TUNNEL_ID=to_be_set_in_infisical
CLOUDFLARE_TUNNEL_TOKEN=to_be_set_in_infisical
CLOUDFLARE_TUNNEL_NAME=worker-rtx5090
CLOUDFLARE_TUNNEL_ROUTE=worker-rtx5090.ratehunter.net

# =====================================================
# ORCHESTRATOR COMMUNICATION
# =====================================================
ORCHESTRATOR_IP=192.168.1.232
ORCHESTRATOR_TAILSCALE_IP=100.115.69.115
ORCHESTRATOR_PORT=6100
ORCHESTRATOR_HEALTH_PORT=6101
ORCHESTRATOR_METRICS_PORT=9999
ORCHESTRATOR_API_KEY=to_be_set_in_infisical
WORKER_HEALTH_REPORT_INTERVAL=30
WORKER_METRICS_REPORT_INTERVAL=15

# =====================================================
# WORKER CONFIGURATION
# =====================================================
WORKER_PRIORITY=highest
WORKER_TIER=0
WORKER_CONCURRENT_REQUESTS=8
WORKER_MAX_BATCH_SIZE=256
WORKER_INFERENCE_ENGINE=vllm
WORKER_FALLBACK_ENGINE=ollama
WORKER_INFERENCE_FRAMEWORK=vLLM+TensorRT-LLM+DeepSeek-R1
WORKER_QUANTIZATION_SUPPORT=FP16,INT8,INT4,AWQ,GPTQ,HQQ
WORKER_MAX_SEQUENCE_LENGTH=128000
WORKER_KV_CACHE_GB=24
WORKER_PERFORMANCE_MODE=ultra-optimized
WORKER_POWER_PROFILE=maximum_performance
WORKER_THERMAL_THROTTLE_THRESHOLD=82
WORKER_AUTO_SCALING=true
WORKER_AUTO_SCALING_MIN=3
WORKER_AUTO_SCALING_MAX=8

# =====================================================
# MODEL SPECIFICATIONS
# =====================================================
# Primary Model (vLLM - DeepSeek R1)
MODEL_PRIMARY_NAME=deepseek-r1-distill-qwen-32b
MODEL_PRIMARY_SIZE_GB=20
MODEL_PRIMARY_VRAM_REQUIREMENT_GB=20
MODEL_PRIMARY_PARAMS_B=32
MODEL_PRIMARY_CONTEXT_WINDOW=32768
MODEL_PRIMARY_QUANTIZATION=fp8
MODEL_PRIMARY_PROVIDER=huggingface
MODEL_PRIMARY_SERVING_ENGINE=vllm
MODEL_PRIMARY_REASONING_ENABLED=true

# Secondary Model (Ollama - Qwen 72B)
MODEL_SECONDARY_NAME=qwen2.5:72b-instruct-q8_0
MODEL_SECONDARY_SIZE_GB=43
MODEL_SECONDARY_VRAM_REQUIREMENT_GB=48
MODEL_SECONDARY_PARAMS_B=72
MODEL_SECONDARY_CONTEXT_WINDOW=32768
MODEL_SECONDARY_QUANTIZATION=Q8_0
MODEL_SECONDARY_PROVIDER=ollama
MODEL_SECONDARY_SERVING_ENGINE=ollama

# Tertiary Model (Ollama - DeepSeek R1)
MODEL_TERTIARY_NAME=deepseek-r1:236b-q4_K_M
MODEL_TERTIARY_SIZE_GB=130
MODEL_TERTIARY_VRAM_REQUIREMENT_GB=48
MODEL_TERTIARY_PARAMS_B=236
MODEL_TERTIARY_CONTEXT_WINDOW=128000
MODEL_TERTIARY_QUANTIZATION=Q4_K_M
MODEL_TERTIARY_PROVIDER=ollama
MODEL_TERTIARY_SERVING_ENGINE=ollama
MODEL_TERTIARY_REASONING_ENABLED=true
MODEL_TERTIARY_NOTES=Largest model available, requires external GPU or CPU offloading

# =====================================================
# MEMORY SYSTEMS
# =====================================================
LETTA_ENABLED=true
LETTA_URL=http://orchestrator-mini:8283
LETTA_API_KEY=to_be_set_in_infisical

GRAPHITI_ENABLED=true
GRAPHITI_URL=http://orchestrator-mini:6379
GRAPHITI_BACKEND=falkordb

QDRANT_ENABLED=true
QDRANT_URL=http://orchestrator-mini:6333
QDRANT_API_KEY=to_be_set_in_infisical

# =====================================================
# MONITORING & METRICS
# =====================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9100
PROMETHEUS_METRICS_INTERVAL=30

NVIDIA_DCGM_ENABLED=true
NVIDIA_DCGM_PORT=9400
NVIDIA_DCGM_METRICS_INTERVAL=30
NVIDIA_DCGM_COLLECT_GPU_UTILIZATION=true
NVIDIA_DCGM_COLLECT_VRAM_USAGE=true
NVIDIA_DCGM_COLLECT_TEMPERATURE=true
NVIDIA_DCGM_COLLECT_POWER_USAGE=true
NVIDIA_DCGM_COLLECT_THROTTLE_REASON=true
NVIDIA_DCGM_COLLECT_THERMAL_SLOWDOWN=true

# Monitoring Alerts
ALERT_GPU_UTILIZATION_THRESHOLD=98
ALERT_VRAM_USAGE_THRESHOLD=95
ALERT_TEMPERATURE_THRESHOLD=82
ALERT_POWER_USAGE_THRESHOLD=575

# =====================================================
# LOGGING
# =====================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT_CONSOLE=true
LOG_OUTPUT_FILE=true
LOG_OUTPUT_DIR=/var/log/nyra-worker
LOG_RETENTION_DAYS=7
LOG_MAX_FILE_SIZE_MB=100
LOG_COMPRESSION=true

# Service-specific logging
OLLAMA_LOG_LEVEL=info
VLLM_LOG_LEVEL=info
LMCACHE_LOG_LEVEL=debug
PROMETHEUS_LOG_LEVEL=info

# =====================================================
# DOCKER COMPOSE
# =====================================================
COMPOSE_PROJECT_NAME=nyra-worker-rtx5090
COMPOSE_FILE=docker-compose.yml:docker-compose.memory.yml
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# =====================================================
# STORAGE & PERSISTENCE
# =====================================================
MODELS_PERSISTENT_VOLUME=/mnt/storage/models
CACHE_PERSISTENT_VOLUME=/mnt/storage/cache
LOGS_PERSISTENT_VOLUME=/mnt/storage/logs
BACKUPS_PERSISTENT_VOLUME=/mnt/storage/backups

# Model Caching
MODEL_CACHE_DIR=/models
MODEL_CACHE_SIZE_GB=200
MODEL_AUTO_DOWNLOAD=true
MODEL_PRELOAD_ON_STARTUP=false

# =====================================================
# PERFORMANCE TUNING
# =====================================================
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_VISIBLE_DEVICES=0
CUDA_LAUNCH_BLOCKING=0
NCCL_DEBUG=INFO
NCCL_BLOCKING_WAIT=0
NCCL_ASYNC_ERROR_HANDLING=1
TORCH_CUDA_ARCH_LIST=9.0

# Memory Management
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb=2048
CUDA_DEVICE_RESET_PER_ITERATION=0
VLLM_ATTENTION_BACKEND=flashinfer
VLLM_ENABLE_PREFIX_CACHING=true

# =====================================================
# SYSTEM REQUIREMENTS (AUTO-DETECTED)
# =====================================================
CPU_CORES=TO_BE_COLLECTED
CPU_LOGICAL_PROCESSORS=24
CPU_NAME=Intel(R) Core(TM) Ultra 9 275HX
SYSTEM_RAM_GB=64
SYSTEM_RAM_SPEED=6400
OS_VERSION=Microsoft Windows 11 Home
OS_BUILD=26200
KERNEL_VERSION=TO_BE_COLLECTED
NVIDIA_DRIVER_VERSION=32.0.15.8195
CUDA_VERSION=TO_BE_COLLECTED
CUDNN_VERSION=TO_BE_COLLECTED

# =====================================================
# HEALTH CHECK & STATUS
# =====================================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
READY_CHECK_ENABLED=true
LIVENESS_CHECK_ENABLED=true
STARTUP_CHECK_ENABLED=true

# =====================================================
# SECURITY & AUTHENTICATION
# =====================================================
API_KEY_ENABLED=true
API_KEY=to_be_set_in_infisical
JWT_SECRET=to_be_set_in_infisical
JWT_ALGORITHM=HS256
JWT_EXPIRATION=86400
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://orchestrator-mini:9999
RATE_LIMITING_ENABLED=true
RATE_LIMITING_MAX_REQUESTS=2000
RATE_LIMITING_WINDOW_SECONDS=60

# =====================================================
# FEATURE FLAGS
# =====================================================
FEATURE_VLLM=true
FEATURE_OLLAMA=true
FEATURE_LMCACHE=true
FEATURE_LETTA=true
FEATURE_GRAPHITI=true
FEATURE_QDRANT=true
FEATURE_PROMETHEUS=true
FEATURE_DCGM=true
FEATURE_AUTO_SCALING=true
FEATURE_HEALTH_CHECKS=true
FEATURE_DEEPSEEK_R1=true
FEATURE_REASONING_MODE=true

# =====================================================
# GENERATED SECRETS (SET VIA INFISICAL)
# =====================================================
# Database Passwords
POSTGRES_PASSWORD=to_be_set_in_infisical
REDIS_PASSWORD=to_be_set_in_infisical

# API Keys
LETTA_API_KEY=to_be_set_in_infisical
QDRANT_API_KEY=to_be_set_in_infisical
ORCHESTRATOR_API_KEY=to_be_set_in_infisical

# JWT Secrets
JWT_SECRET=to_be_set_in_infisical
JWT_REFRESH_SECRET=to_be_set_in_infisical

# Encryption Keys
ENCRYPTION_KEY=to_be_set_in_infisical
ENCRYPTION_IV=to_be_set_in_infisical

# Network Secrets
TAILSCALE_API_KEY=to_be_set_in_infisical
TAILSCALE_AUTH_KEY=to_be_set_in_infisical
CLOUDFLARE_TUNNEL_TOKEN=to_be_set_in_infisical

# =====================================================
# NEXT STEPS
# =====================================================
# 1. ✅ HARDWARE SPECS - Collected during setup
# 2. ⏳ INSTALL TAILSCALE - Follow setup at https://tailscale.com/download
# 3. ⏳ INSTALL CLOUDFLARED - Download from Cloudflare docs
# 4. ⏳ RUN COLLECTION SCRIPT - Execute on this PC to populate missing vars
# 5. ⏳ GENERATE SECRETS - Use: pwsh scripts/generate-secrets.ps1
# 6. ⏳ UPLOAD TO INFISICAL - Run bulk-import-smart.ps1
# =====================================================
