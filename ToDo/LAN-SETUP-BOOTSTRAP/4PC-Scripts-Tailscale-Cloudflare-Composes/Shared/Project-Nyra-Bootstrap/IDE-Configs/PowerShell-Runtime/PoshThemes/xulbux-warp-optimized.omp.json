{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "\uE0B6",
          "trailing_diamond": "\uE0B4",
          "background": "#000000",
          "foreground": "#7572F7",
          "template": " {{ .Icon }} ",
          "properties": {
            "windows": "\uF17A"
          }
        },
        {
          "type": "session",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4",
          "background": "#000000",
          "foreground": "#B38CFF",
          "template": " {{ if .SSHSession }}\uF817 {{ end }}{{ .UserName }} ",
          "properties": {
            "display_host": false
          }
        },
        {
          "type": "path",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4",
          "background": "#000000",
          "foreground": "#668CFF",
          "template": " {{ if .UpstreamURL }}\uF09B {{ end }}\uF07C {{ .Path }} ",
          "properties": {
            "style": "unique",
            "folder_separator_template": "<#C16BFF>/<#9CF6FF>",
            "max_depth": 3,
            "hide_root_location": true,
            "folder_icon": "\uF07C",
            "home_icon": "\uF015"
          }
        },
        {
          "type": "git",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4",
          "background": "#000000",
          "foreground": "#96FFBE",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#000000{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#000000{{ end }}",
            "{{ if gt .Ahead 0 }}#000000{{ end }}",
            "{{ if gt .Behind 0 }}#000000{{ end }}",
            "{{ if .UpstreamGone }}#000000{{ end }}"
          ],
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FF5DAE{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#FF6F9A{{ end }}",
            "{{ if gt .Ahead 0 }}#A7FFD7{{ end }}",
            "{{ if gt .Behind 0 }}#C16BFF{{ end }}",
            "{{ if .UpstreamGone }}#FF78B4{{ end }}"
          ],
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uF044({{ .Working.String }}){{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uF046({{ .Staging.String }}){{ end }} ",
          "properties": {
            "branch_icon": "\uE0A0 ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "python",
          "style": "diamond",
          "leading_diamond": "\uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "#000000",
          "foreground": "#9CF6FF",
          "template": " \uE235 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}{{ if .Venv }} \uE621 {{ .Venv }}{{ end }} ",
          "properties": {
            "display_mode": "context",
            "fetch_virtual_env": true
          }
        },
        {
          "type": "node",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "#000000",
          "foreground": "#A7FFD7",
          "template": " \uE718 {{ .Full }} ",
          "properties": {
            "fetch_version": true,
            "display_mode": "context"
          }
        },
        {
          "type": "time",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "#000000",
          "foreground_templates": [
            "{{ if regexMatch \"^(06|07|08|09|10|11):\" (.CurrentDate | date .Format) }}#96FFBE{{ end }}",
            "{{ if regexMatch \"^(12|13|14):\" (.CurrentDate | date .Format) }}#A7FFD7{{ end }}",
            "{{ if regexMatch \"^(15|16|17):\" (.CurrentDate | date .Format) }}#9CF6FF{{ end }}",
            "{{ if regexMatch \"^(18|19|20|21|22|23):\" (.CurrentDate | date .Format) }}#668CFF{{ end }}",
            "{{ if regexMatch \"^(00|01|02|03|04|05):\" (.CurrentDate | date .Format) }}#7572F7{{ end }}"
          ],
          "template": " \uF017 {{ .CurrentDate | date .Format }} ",
          "properties": {
            "time_format": "15:04"
          }
        },
        {
          "type": "executiontime",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4",
          "background": "#000000",
          "foreground_templates": [
            "{{ if lt .Ms 500 }}#96FFBE{{ end }}",
            "{{ if and (ge .Ms 500) (lt .Ms 2000) }}#A7FFD7{{ end }}",
            "{{ if and (ge .Ms 2000) (lt .Ms 10000) }}#9CF6FF{{ end }}",
            "{{ if and (ge .Ms 10000) (lt .Ms 30000) }}#FF5DAE{{ end }}",
            "{{ if ge .Ms 30000 }}#FF78B4{{ end }}"
          ],
          "template": " \uF252 {{ .FormattedMs }} ",
          "properties": {
            "threshold": 100,
            "style": "austin"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "root",
          "style": "diamond",
          "leading_diamond": "\uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "#000000",
          "foreground": "#FF5DAE",
          "template": " \uF0E7 {{ if .Root }}ADMIN{{ end }} "
        },
        {
          "type": "status",
          "style": "diamond",
          "leading_diamond": " \uE0B6",
          "trailing_diamond": "\uE0B4 ",
          "background": "#000000",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#FF78B4{{ end }}",
            "{{ if eq .Code 0 }}#96FFBE{{ end }}"
          ],
          "template": " {{ if gt .Code 0 }}\uD83D\uDC94{{ else }}\u2665{{ end }} {{ if ne .Code 0 }}{{ .Code }}{{ end }} ",
          "properties": {
            "always_enabled": true
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#B38CFF",
          "template": "\u276F "
        }
      ]
    }
  ],
  "transient_prompt": {
    "template": "<#B38CFF>\u276F</> "
  },
  "secondary_prompt": {
    "template": "<#7572F7>...</> "
  },
  "console_title_template": "{{ if .Root }}# {{ end }}{{ .Folder }}{{ if .Segments.Git.HEAD }} - {{ .Segments.Git.HEAD }}{{ end }} - Warp",
  "final_space": true,
  "palette": {
    "xulbux": "#7572F7",
    "purple": "#B38CFF", 
    "pink": "#FF78B4",
    "hot-pink": "#FF5DAE",
    "heliotrope": "#C16BFF",
    "blue": "#668CFF",
    "cyan": "#9CF6FF",
    "mint": "#A7FFD7",
    "neon-green": "#96FFBE",
    "rose": "#FF6F9A",
    "black": "#000000"
  },
  "version": 3
}