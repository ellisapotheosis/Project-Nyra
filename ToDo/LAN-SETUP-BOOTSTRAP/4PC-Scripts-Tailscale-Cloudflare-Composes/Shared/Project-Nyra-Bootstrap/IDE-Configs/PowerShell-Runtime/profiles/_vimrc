" NYRA Apotheosis Vim Configuration
" Enhanced for modern development with UV Python support

" =====================================================
" VIM-PLUG PLUGIN MANAGER
" =====================================================
call plug#begin('~/.vim/plugged')

" Core Editing
Plug 'tpope/vim-sensible'              " Sensible defaults
Plug 'tpope/vim-surround'              " Surround text objects
Plug 'tpope/vim-commentary'            " Easy commenting
Plug 'tpope/vim-repeat'                " Better . repeat
Plug 'jiangmiao/auto-pairs'            " Auto brackets

" File Navigation
Plug 'junegunn/fzf', { 'do': { -> fzf#install() } }
Plug 'junegunn/fzf.vim'                " Fuzzy finder
Plug 'preservim/nerdtree'              " File tree
Plug 'Xuyuanp/nerdtree-git-plugin'     " Git status in NerdTree

" Git Integration
Plug 'tpope/vim-fugitive'              " Git commands
Plug 'airblade/vim-gitgutter'          " Git diff in gutter
Plug 'tpope/vim-rhubarb'               " GitHub integration

" Language Support
Plug 'sheerun/vim-polyglot'            " Language pack
Plug 'dense-analysis/ale'              " Linting and fixing
Plug 'neoclide/coc.nvim', {'branch': 'release'} " LSP support

" Python (UV focused)
Plug 'vim-python/python-syntax'        " Enhanced Python syntax
Plug 'Vimjas/vim-python-pep8-indent'   " PEP8 indentation
Plug 'jeetsukumaran/vim-pythonsense'   " Python text objects

" TypeScript/JavaScript
Plug 'pangloss/vim-javascript'         " JavaScript syntax
Plug 'leafgarland/typescript-vim'      " TypeScript syntax
Plug 'maxmellon/vim-jsx-pretty'        " JSX/TSX syntax

" Appearance
Plug 'vim-airline/vim-airline'         " Status line
Plug 'vim-airline/vim-airline-themes'  " Airline themes
Plug 'morhetz/gruvbox'                 " Gruvbox color scheme
Plug 'dracula/vim', { 'as': 'dracula' } " Dracula theme
Plug 'joshdick/onedark.vim'            " One Dark theme

" Utilities
Plug 'mbbill/undotree'                 " Undo history
Plug 'preservim/tagbar'                " Tag browser
Plug 'Yggdroot/indentLine'             " Indent guides
Plug 'ryanoasis/vim-devicons'          " File icons

call plug#end()

" =====================================================
" GENERAL SETTINGS
" =====================================================

set nocompatible                       " Not compatible with vi
set encoding=utf-8                     " UTF-8 encoding
set fileencoding=utf-8                 " UTF-8 file encoding
set backspace=indent,eol,start         " Better backspace
set hidden                             " Allow hidden buffers
set autoread                           " Auto-reload changed files
set clipboard=unnamedplus              " System clipboard

" Visual settings
set number                             " Line numbers
set relativenumber                     " Relative line numbers
set cursorline                         " Highlight current line
set showmatch                          " Highlight matching brackets
set laststatus=2                       " Always show status line
set ruler                              " Show cursor position
set showcmd                            " Show command in status
set wildmenu                           " Enhanced command completion
set wildmode=list:longest,full         " Command completion mode
set signcolumn=yes                     " Always show sign column

" Indentation
set tabstop=4                          " Tab width
set shiftwidth=4                       " Indent width
set softtabstop=4                      " Soft tab stop
set expandtab                          " Use spaces instead of tabs
set smarttab                           " Smart tab handling
set autoindent                         " Auto indent
set smartindent                        " Smart indent
set cindent                            " C-style indenting

" Search
set hlsearch                           " Highlight search results
set incsearch                          " Incremental search
set ignorecase                         " Ignore case in search
set smartcase                          " Smart case sensitivity

" Performance
set lazyredraw                         " Don't redraw during macros
set updatetime=300                     " Faster completion
set timeoutlen=500                     " Faster key sequence completion

" Backup and swap
set nobackup                           " No backup files
set nowritebackup                      " No backup when writing
set noswapfile                         " No swap files
set undofile                           " Persistent undo
set undodir=~/.vim/undodir             " Undo directory

" =====================================================
" THEME AND COLORS
" =====================================================

syntax enable                          " Enable syntax highlighting
set termguicolors                      " True color support

" NYRA theme selection (Xulbux Purple inspired)
if has('termguicolors')
    set termguicolors
    colorscheme onedark
    " Custom NYRA colors
    hi Normal guibg=#1e1e2e guifg=#cdd6f4
    hi CursorLine guibg=#313244
    hi LineNr guifg=#6c7086
    hi Comment guifg=#9399b2
    hi String guifg=#a6e3a1
    hi Keyword guifg=#cba6f7
    hi Function guifg=#89b4fa
    hi Type guifg=#f38ba8
else
    colorscheme desert
endif

