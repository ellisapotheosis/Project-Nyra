" NYRA file templates
autocmd BufNewFile *.py call s:NYRAPythonTemplate()
autocmd BufNewFile *.ts call s:NYRATypeScriptTemplate()

function! s:NYRAPythonTemplate()
    0r ~/.vim/templates/nyra_python.py
