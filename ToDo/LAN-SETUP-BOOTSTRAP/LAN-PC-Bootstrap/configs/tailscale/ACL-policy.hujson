// Tailscale ACL Policy for Project Nyra Mesh Network\n// Allows service-to-service communication between orchestrator and workers\n// Static IPs assigned: orchestrator (100.64.0.1), worker-5090 (100.64.0.10),\n// worker-3060 (100.64.0.11), worker-3090ti (100.64.0.12)\n\n{\n  // Grant all permissions on self\n  \"acls\": [\n    {\n      \"action\": \"accept\",\n      \"src\": [\"*\"],\n      \"dst\": [\"*:*\"]\n    }\n  ],\n\n  // Tailscale SSH for administration\n  \"ssh\": [\n    {\n      \"action\": \"accept\",\n      \"src\": [\"taggedGroup:admin\"],\n      \"dst\": [\"*\"],\n      \"users\": [\"autogroup:nonroot\", \"root\"]\n    }\n  ],\n\n  // Define hosts and their IP assignments\n  \"hosts\": {\n    \"orchestrator-mini\": \"100.64.0.1\",\n    \"worker-rtx3060\": \"100.64.0.11\",\n    \"worker-rtx3090ti\": \"100.64.0.12\",\n    \"worker-rtx5090\": \"100.64.0.10\"\n  },\n\n  // Assign static IPs to specific machines based on hostname\n  \"nodeAttrs\": [\n    {\n      \"target\": [\"tag:orchestrator\"],\n      \"attr\": \"tailscale.com/cap/ssh\",\n      \"value\": \"true\"\n    },\n    {\n      \"target\": [\"tag:worker\"],\n      \"attr\": \"tailscale.com/cap/ssh\",\n      \"value\": \"true\"\n    }\n  ],\n\n  // Define groups for easier management\n  \"groups\": {\n    \"group:admin\": [\n      \"edane@gmail.com\"\n    ],\n    \"group:orchestrator\": [\n      \"orchestrator-mini.tail-net.ts.net\"\n    ],\n    \"group:workers\": [\n      \"worker-rtx3060.tail-net.ts.net\",\n      \"worker-rtx3090ti.tail-net.ts.net\",\n      \"worker-rtx5090.tail-net.ts.net\"\n    ]\n  },\n\n  // Tag definitions\n  \"tagOwners\": {\n    \"tag:orchestrator\": [\"group:admin\"],\n    \"tag:worker\": [\"group:admin\"],\n    \"tag:admin\": [\"group:admin\"]\n  },\n\n  // Policy for specific service ports\n  \"tests\": [\n    // Orchestrator health checks\n    {\n      \"src\": \"group:workers\",\n      \"dst\": \"100.64.0.1:12008\",\n      \"expect\": \"ACCEPT\"\n    },\n    // MetaMCP\n    {\n      \"src\": \"group:workers\",\n      \"dst\": \"100.64.0.1:4000\",\n      \"expect\": \"ACCEPT\"\n    },\n    // Archon\n    {\n      \"src\": \"group:workers\",\n      \"dst\": \"100.64.0.1:8080\",\n      \"expect\": \"ACCEPT\"\n    },\n    // Worker 3060 - Ollama\n    {\n      \"src\": \"100.64.0.1\",\n      \"dst\": \"100.64.0.11:11434\",\n      \"expect\": \"ACCEPT\"\n    },\n    // Worker 3090Ti - VLLM\n    {\n      \"src\": \"100.64.0.1\",\n      \"dst\": \"100.64.0.12:8000\",\n      \"expect\": \"ACCEPT\"\n    },\n    // Worker 5090 - VLLM\n    {\n      \"src\": \"100.64.0.1\",\n      \"dst\": \"100.64.0.10:8000\",\n      \"expect\": \"ACCEPT\"\n    }\n  ]\n}\n"