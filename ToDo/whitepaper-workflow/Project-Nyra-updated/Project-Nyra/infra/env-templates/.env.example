# Example environment variables for Project Nyra infrastructure.
# Copy this file to `.env` and adjust values as needed. Do not commit secrets.

# Database credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis configuration
REDIS_PASSWORD=

# Qdrant vector store
QDRANT_API_KEY=

# S3-compatible object storage for persistent assets
S3_ENDPOINT=
S3_BUCKET=nyra-local
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Claude Flow / Archon integration
CLAUDE_FLOW_API_KEY=
