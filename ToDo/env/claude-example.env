# =============================================================================
# Claude Code & Agentic Flow Example Environment
#
# This file defines a minimal set of environment variables used when
# launching the Claude Code CLI (`claude`) or using agentic-flow
# directly.  It focuses on keys and configuration parameters for
# running agents and memory backends on a developer machine.
#
# Unlike the master.env.example, this file is intentionally concise.
# Secrets such as API keys should still be pulled from Infisical or
# another secret manager.  Copy this file to `.env` in your Claude
# Code project or set these variables in your shell before running
# `claude` commands.
# =============================================================================

# === Core CLI & Provider Configuration ===
NODE_ENV=development
# Choose one provider (anthropic, openrouter, openai, gemini).
PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Base URL override for Anthropic or OpenRouter proxies.  When using
# Claude Flow’s proxy, set ANTHROPIC_BASE_URL to http://localhost:8080.
ANTHROPIC_BASE_URL=
# Default model to use when one is not specified in CLI commands.
COMPLETION_MODEL=claude-sonnet-4-20250514

# === Memory Backends (Local) ===
AGENTDB_ENABLED=true
AGENTDB_PATH=.agentdb/claude-code.db
RUVECTOR_ENABLED=false
LETTA_ENABLED=false
OPENMEMORY_ENABLED=false
MEM0_ENABLED=false
GRAPHITI_ENABLED=false
QDRANT_ENABLED=false
# You can toggle these on for advanced memory experiments; when
# enabled, also set the corresponding service URLs.
RUVECTOR_URL=
LETTA_API_URL=
OPENMEMORY_API_URL=
GRAPHITI_URI=
QDRANT_URL=

# === Agentic Flow & Tools ===
# Enable agent memory for the CLI.  When true, tasks executed via
# `claude-flow agent run` will store results in memory.
AGENTIC_FLOW_MEMORY_ENABLED=true
# Directory for storing local state, workflows and test data.
CLAUDE_FLOW_DATA_DIR=./.claude/data
CLAUDE_FLOW_MEMORY_DIR=./.claude/memory
CLAUDE_FLOW_CONFIG_DIR=./.claude/config

# === Debugging & Logging ===
CLAUDE_FLOW_DEBUG=false
LOG_LEVEL=info

# === Miscellaneous ===
# If you run local GPU workers (e.g. Ollama), list them here.
GPU_WORKER_1_URL=
GPU_WORKER_2_URL=
# When using the OpenRouter proxy for cost savings, set this to true
# and set ANTHROPIC_BASE_URL accordingly.
USE_OPENROUTER=false
USE_ONNX=false
