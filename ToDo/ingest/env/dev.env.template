# ===========================================
# PROJECT NYRA - DEVELOPMENT ENVIRONMENT
# ===========================================
# Copy this file to .env and fill in your actual values

# ===========================================
# CRITICAL API KEYS (REQUIRED)
# ===========================================

# Google Gemini API Key
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic API Key (for Claude)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# OpenRouter API Key (cost-effective fallback)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here

# ===========================================
# ORCHESTRATION LAYER
# ===========================================

# Claude Flow (Workflow Orchestrator)
CLAUDE_FLOW_PORT=9000
CLAUDE_FLOW_URL=http://localhost:9000

# Archon OS (Agent Operating System)
ARCHON_PORT=9001
ARCHON_OS_URL=http://localhost:9001

# Nexus Router (LLM Routing Service)
NEXUS_PORT=8000
NEXUS_ROUTER_URL=http://localhost:8000

# ===========================================
# GPU WORKERS (LOCAL INFERENCE)
# ===========================================
# Adjust these URLs based on your GPU setup

# RTX 5090 - Heavy reasoning (DeepSeek-R1 236B)
GPU_WORKER_5090_URL=http://localhost:11434
GPU_WORKER_5090_MODEL=deepseek-r1-236b

# RTX 3090 - Medium tasks (Llama 70B)
GPU_WORKER_3090_URL=http://localhost:11435
GPU_WORKER_3090_MODEL=llama-70b

# RTX 3060 - Light tasks (CodeLlama 34B)
GPU_WORKER_3060_URL=http://localhost:11436
GPU_WORKER_3060_MODEL=codellama-34b

# ===========================================
# MCP SERVERS (MEMORY & TOOLS)
# ===========================================

# Letta (Conversation Memory)
LETTA_PORT=8283
LETTA_URL=http://localhost:8283

# Graphiti (Temporal Knowledge Graph)
GRAPHITI_PORT=6379
GRAPHITI_URL=http://localhost:6379

# RuVector (Vector Similarity Search)
RUVECTOR_PORT=7000
RUVECTOR_URL=http://localhost:7000

# Mem0 (Personalization Engine)
MEM0_PORT=8081
MEM0_URL=http://localhost:8081

# OpenMemory (Shared Knowledge)
OPENMEMORY_PORT=8080
OPENMEMORY_URL=http://localhost:8080

# Qdrant (Hot Vector Cache)
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333

# Serena MCP (Codebase Analysis)
SERENA_PORT=8086
SERENA_URL=http://localhost:8086

# Gemini Assistant MCP
GEMINI_ASSISTANT_PORT=8085
GEMINI_ASSISTANT_URL=http://localhost:8085

# ===========================================
# DATA LAYER
# ===========================================

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nyra
POSTGRES_USER=nyra
POSTGRES_PASSWORD=nyra_dev_password
DATABASE_URL=postgresql://nyra:nyra_dev_password@localhost:5432/nyra

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Neo4j (Graph Database)
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=nyra_dev_password
NEO4J_URL=bolt://localhost:7687

