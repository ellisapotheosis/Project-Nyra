{
  "name": "project-nyra",
  "version": "1.0.0",
  "description": "Nyra Distributed GPU Compute Infrastructure with Cloudflared Tunneling",
  "main": "src/app.js",
  "scripts": {
    "dev": "infisical run --env=development -- nodemon src/app.js",
    "start": "infisical run --env=production -- node src/app.js",
    "start:orchestrator": "infisical run --env=production -- node src/orchestrator/main.js",
    "start:worker": "infisical run --env=production -- node src/worker/main.js",
    "test": "infisical run --env=development -- jest",
    "test:integration": "./scripts/setup/test-infrastructure.sh",
    "test:quick": "./scripts/setup/test-infrastructure.sh --quick",
    "setup:orchestrator": "./scripts/setup/setup-orchestrator.sh",
    "setup:worker": "./scripts/setup/setup-worker.sh",
    "setup:cloudflare": "./scripts/setup/cloudflare-setup.sh",
    "setup:infisical": "./scripts/setup/infisical-setup.sh",
    "setup:complete": "./scripts/setup/complete-setup.ps1",
    "dns:setup": "node src/infrastructure/cloudflared/dns-manager.js setup",
    "dns:validate": "node src/infrastructure/cloudflared/dns-manager.js validate",
    "dns:list": "node src/infrastructure/cloudflared/dns-manager.js list",
    "loadbalancer:setup": "node src/infrastructure/cloudflared/load-balancer.js setup",
    "loadbalancer:test": "node src/infrastructure/cloudflared/load-balancer.js test",
    "discovery:status": "node src/infrastructure/cloudflared/service-discovery.js status",
    "discovery:discover": "node src/infrastructure/cloudflared/service-discovery.js discover",
    "discovery:start": "node src/infrastructure/cloudflared/service-discovery.js start",
    "security:generate-key": "node src/infrastructure/cloudflared/security-manager.js generate-key",
    "security:status": "node src/infrastructure/cloudflared/security-manager.js status",
    "secrets:get": "./scripts/secrets/infisical-helpers.sh get",
    "secrets:generate": "./scripts/secrets/infisical-helpers.sh generate",
    "secrets:validate": "./scripts/secrets/infisical-helpers.sh validate",
    "secrets:export": "./scripts/secrets/infisical-helpers.sh export",
    "health:check": "./scripts/monitoring/health-check.sh",
    "health:tunnel": "./scripts/monitoring/tunnel-health.sh",
    "gpu:monitor": "python3 scripts/monitoring/gpu-monitor.py",
    "logs:orchestrator": "sudo journalctl -u nyra-orchestrator -f",
    "logs:worker": "sudo journalctl -u nyra-worker1 -f",
    "logs:tunnel": "sudo journalctl -u cloudflared -f",
    "build": "echo 'No build step required for infrastructure'",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "docs:serve": "live-server docs/",
    "clean": "rm -rf node_modules/.cache && rm -rf logs/*.log"
  },
  "keywords": [
    "distributed-computing",
    "gpu-cluster",
    "cloudflare-tunnel",
    "infrastructure",
    "zero-trust",
    "load-balancing",
    "service-discovery",
    "monitoring"
  ],
  "author": "Project Nyra Team",
  "license": "MIT",
  "dependencies": {
    "agentdb": "^1.6.1",
    "agentic-flow": "^1.10.2",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "eslint": "^8.54.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-n": "^16.3.1",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.7.0",
    "live-server": "^1.2.2",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "volta": {
    "node": "22.12.0",
    "npm": "10.2.3"
  },
  "nyra": {
    "version": "2.0.0",
    "components": [
      "orchestrator",
      "worker-nodes",
      "cloudflared-tunnels",
      "service-discovery",
      "load-balancer",
      "security-manager",
      "monitoring"
    ],
    "architecture": "distributed-gpu-compute",
    "tunnel-provider": "cloudflare",
    "secret-management": "infisical"
  }
}