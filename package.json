{
  "name": "project-nyra",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered mortgage automation platform with multi-agent orchestration",
  "packageManager": "pnpm@10.27.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "apps/*/*",
    "apps/*/*/*",
    "services/*",
    "services/*/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "cockpit:dev": "turbo run dev --filter=nyra-cockpit",
    "landing:dev": "turbo run dev --filter=ratehunter-landing",
    "projectnyra:dev": "turbo run dev --filter=projectnyra-site",
    "projectnyra:build": "turbo run build --filter=projectnyra-site",
    "all:dev": "turbo run dev --parallel",
    "twenty:dev": "turbo run dev --filter=twenty-crm",
    "typecheck": "turbo run typecheck",
    "test:contracts": "pnpm -C packages/domain-models test && pnpm -C packages/integration-adapters test",

    "docs:check": "ls docs/*.md && ls docs/ops/*.md"
  },
  "dependencies": {
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@playwright/test": "^1.58.2",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^10.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.4.2",
    "turbo": "^2.8.15",
    "typescript": "^5.7.0",
    "vite": "^7.3.2",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=20"
  }
}
