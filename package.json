{
  "name": "project-nyra",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered mortgage automation platform with multi-agent orchestration",
  "packageManager": "pnpm@10.27.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "apps/*/*",
    "!apps/**/.next/**",
    "services/*",
    "services/*/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev --concurrency=30",
    "build": "pnpm -C apps/projectnyra build && turbo run build --concurrency=1 --filter=!projectnyra",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm exec vitest --config vitest.smoke.config.mjs run",
    "test:unit": "bash scripts/testing/run-unit-tests.sh",
    "test:all": "pnpm exec vitest --config vitest.config.mjs run",
    "smoke:lead-lifecycle": "pnpm exec tsx scripts/smoke-test-lead-lifecycle.ts",
    "release:check": "bash scripts/release/check-release-candidate.sh",
    "release:validate": "pnpm exec tsx scripts/release/finish-line-validators.ts",
    "infra:check:infisical": "python3 scripts/infra/validate-infisical-sidecars.py",
    "infra:check:repo-policy": "bash scripts/infra/validate-repo-policy.sh",
    "docker:up": "docker compose -f infra/hosts/oracle-vps/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/hosts/oracle-vps/docker-compose.yml down",
    "twenty:setup": "docker compose -f infra/hosts/oracle-vps/docker-compose.yml up -d twenty twenty-worker twenty-db",
    "twenty:down": "docker compose -f infra/hosts/oracle-vps/docker-compose.yml stop twenty twenty-worker twenty-db",
    "twenty:dev": "turbo run dev --filter=twenty-crm",
    "admin:dev": "turbo run dev --filter=nyra-admin",
    "all:dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "test:contracts": "pnpm -C packages/domain-models test && pnpm -C packages/integration-adapters test",
    "docs:check": "ls docs/*.md && ls docs/ops/*.md",
    "deps:check": "pnpm install --frozen-lockfile --prefer-offline --ignore-scripts",
    "validate:dependencies": "pnpm deps:check"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@playwright/test": "^1.58.2",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^10.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "turbo": "^2.8.15",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "4.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server@<1.19.13": "1.19.13",
      "@xmldom/xmldom@<0.8.13": "0.8.13",
      "axios@>=1.0.0 <1.15.1": "1.15.2",
      "axios@>=1.0.0 <1.15.2": "1.15.2",
      "brace-expansion@>=5.0.0 <5.0.6": "5.0.6",
      "fast-uri@<=3.1.0": "3.1.2",
      "fast-uri@<=3.1.1": "3.1.2",
      "fast-xml-builder@<=1.1.6": "1.2.0",
      "fast-xml-parser@<5.7.0": "5.7.3",
      "follow-redirects@<=1.15.11": "1.16.0",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "hono@<4.12.14": "4.12.21",
      "hono@<4.12.16": "4.12.21",
      "hono@<4.12.18": "4.12.21",
      "ip-address@<=10.1.0": "10.1.1",
      "js-cookie@<=3.0.5": "3.0.7",
      "minimatch@>=9.0.0 <9.0.6": "9.0.7",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "next@>=10.0.0 <15.5.18": "15.5.18",
      "postcss@<8.5.10": "8.5.10",
      "qs@>=6.11.1 <=6.15.1": "6.15.2",
      "turbo@<=2.9.13": "2.9.14",
      "turbo@>=1.1.0 <2.9.14": "2.9.14",
      "uuid@<11.1.1": "11.1.1",
      "ws@>=8.0.0 <8.20.1": "8.20.1"
    }
  }
}
