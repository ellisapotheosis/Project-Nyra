{
  "name": "project-nyra",
  "version": "1.0.0",
  "description": "AI-Powered Mortgage Automation Platform with Multi-Agent Orchestration",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:all": "bash scripts/testing/run-all-tests.sh",
    "test:unit": "bash scripts/testing/run-unit-tests.sh",
    "test:integration": "bash scripts/testing/run-integration-tests.sh",
    "test:e2e": "bash scripts/testing/run-e2e-tests.sh",
    "test:performance": "bash scripts/testing/run-performance-tests.sh",
    "test:watch": "jest --watch --config=jest.config.unit.js",
    "test:coverage": "jest --coverage --config=jest.config.js",
    "test:coverage:view": "open coverage/lcov-report/index.html",
    "test:coverage:detailed": "jest --coverage --verbose --config=jest.config.js",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "db:generate": "cd packages/database && prisma generate",
    "db:migrate": "cd packages/database && prisma migrate deploy",
    "db:studio": "cd packages/database && prisma studio",
    "docker:up": "docker-compose -f infra/docker-compose.dev.yml up -d",
    "docker:down": "docker-compose -f infra/docker-compose.dev.yml down",
    "docker:test:up": "docker-compose -f infra/docker-compose.test.yml up -d",
    "docker:test:down": "docker-compose -f infra/docker-compose.test.yml down -v",
    "mcp:health-check": "npx claude-flow@alpha mcp status",
    "start:all": "pnpm run start:infra && pnpm run start:services && pnpm run start:apps",
    "start:infra": "docker-compose -f infra/docker-compose.yml up -d postgres redis rabbitmq minio vault",
    "start:services": "turbo run dev --filter='./services/*' --parallel --no-cache",
    "start:apps": "turbo run dev --filter='./apps/*' --parallel --no-cache",
    "start:orchestrator": "docker-compose -f infra/docker-compose.orchestrator.yml up -d",
    "start:worker": "docker-compose -f infra/docker-compose.worker.yml up -d",
    "stop:all": "pnpm run stop:apps && pnpm run stop:services && pnpm run stop:infra",
    "stop:apps": "turbo run stop --filter='./apps/*' --parallel || true",
    "stop:services": "turbo run stop --filter='./services/*' --parallel || true",
    "stop:infra": "docker-compose -f infra/docker-compose.yml down",
    "stop:orchestrator": "docker-compose -f infra/docker-compose.orchestrator.yml down",
    "stop:worker": "docker-compose -f infra/docker-compose.worker.yml down",
    "health:check": "node scripts/health-check.js",
    "health:infra": "docker-compose -f infra/docker-compose.yml ps && curl -f http://localhost:5432 || echo 'Postgres: DOWN' && curl -f http://localhost:6379 || echo 'Redis: DOWN'",
    "health:services": "turbo run health --filter='./services/*' --parallel",
    "health:apps": "turbo run health --filter='./apps/*' --parallel",
    "doctor": "npx @claude-flow/cli@latest doctor --fix && pnpm run health:check",
    "doctor:infra": "docker system df && docker-compose -f infra/docker-compose.yml config --quiet && echo 'Infrastructure: OK'",
    "doctor:full": "pnpm run doctor && pnpm run doctor:infra && pnpm run test:all",
    "deploy:orchestrator": "bash scripts/deployment/deploy-orchestrator.sh",
    "deploy:worker": "bash scripts/deployment/deploy-worker.sh",
    "deploy:all": "pnpm run deploy:orchestrator && pnpm run deploy:worker",
    "deploy:staging": "bash scripts/deployment/deploy-staging.sh",
    "deploy:production": "bash scripts/deployment/deploy-production.sh",
    "backup": "bash scripts/backup/backup-all.sh",
    "backup:db": "bash scripts/backup/backup-database.sh",
    "backup:volumes": "bash scripts/backup/backup-volumes.sh",
    "backup:config": "bash scripts/backup/backup-config.sh",
    "restore": "bash scripts/backup/restore-all.sh",
    "restore:db": "bash scripts/backup/restore-database.sh",
    "restore:volumes": "bash scripts/backup/restore-volumes.sh",
    "restore:config": "bash scripts/backup/restore-config.sh",
    "swarm:init": "npx @claude-flow/cli@latest swarm init --topology hierarchical --max-agents 8 --strategy specialized",
    "swarm:status": "npx @claude-flow/cli@latest swarm status",
    "swarm:shutdown": "npx @claude-flow/cli@latest swarm shutdown --graceful",
    "memory:init": "npx @claude-flow/cli@latest memory init --force --verbose",
    "memory:backup": "npx @claude-flow/cli@latest memory export --output ./backups/memory-$(date +%Y%m%d-%H%M%S).json",
    "memory:restore": "npx @claude-flow/cli@latest memory import --input",
    "daemon:start": "npx @claude-flow/cli@latest daemon start",
    "daemon:stop": "npx @claude-flow/cli@latest daemon stop",
    "daemon:status": "npx @claude-flow/cli@latest daemon status",
    "security:scan": "npx @claude-flow/cli@latest security scan --depth full",
    "security:audit": "npx @claude-flow/cli@latest security audit",
    "performance:benchmark": "npx @claude-flow/cli@latest performance benchmark --suite all",
    "performance:profile": "npx @claude-flow/cli@latest performance profile",
    "infra:up": "docker-compose -f infra/docker-compose.yml -f infra/docker-compose.orchestrator.yml -f infra/docker-compose.worker.yml up -d",
    "infra:down": "docker-compose -f infra/docker-compose.yml -f infra/docker-compose.orchestrator.yml -f infra/docker-compose.worker.yml down",
    "infra:logs": "docker-compose -f infra/docker-compose.yml logs -f",
    "infra:ps": "docker-compose -f infra/docker-compose.yml ps",
    "infra:restart": "pnpm run infra:down && pnpm run infra:up",
    "bootstrap:init": "node bootstrap/installer/dist/index.js",
    "bootstrap:gui": "cd bootstrap/installer && pnpm run dev",
    "setup:dev": "pnpm install && pnpm run db:generate && pnpm run docker:up && pnpm run doctor",
    "setup:prod": "pnpm install --prod && pnpm run build && pnpm run deploy:all",
    "logs:all": "turbo run logs --filter='./apps/*' --filter='./services/*' --parallel",
    "logs:orchestrator": "docker-compose -f infra/docker-compose.orchestrator.yml logs -f",
    "logs:worker": "docker-compose -f infra/docker-compose.worker.yml logs -f",
    "update:deps": "pnpm update -r --latest",
    "update:claude-flow": "pnpm add -D @claude-flow/cli@latest",
    "migrate:v3": "npx @claude-flow/cli@latest migrate run --backup",
    "monorepo:check": "pnpm run monorepo:syncpack && pnpm run monorepo:manypkg",
    "monorepo:fix": "pnpm run monorepo:syncpack:fix && pnpm run monorepo:manypkg:fix",
    "monorepo:syncpack": "syncpack list-mismatches",
    "monorepo:syncpack:fix": "syncpack fix-mismatches",
    "monorepo:syncpack:format": "syncpack format",
    "monorepo:syncpack:lint": "syncpack lint",
    "monorepo:manypkg": "manypkg check",
    "monorepo:manypkg:fix": "manypkg fix",
    "monorepo:changeset": "changeset",
    "monorepo:changeset:version": "changeset version",
    "monorepo:changeset:publish": "changeset publish",
    "monorepo:changeset:status": "changeset status",
    "monorepo:gen": "turbo gen",
    "monorepo:gen:workspace": "turbo gen workspace-package",
    "monorepo:gen:component": "turbo gen component",
    "monorepo:gen:hook": "turbo gen hook",
    "monorepo:gen:api": "turbo gen api-route"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@manypkg/cli": "^0.25.1",
    "@playwright/test": "^1.40.0",
    "@turbo/gen": "^1.9.5",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.18.0",
    "jest": "^30.2.0",
    "prettier": "^3.4.2",
    "supertest": "^6.3.0",
    "syncpack": "^13.0.4",
    "ts-jest": "^29.4.6",
    "turbo": "^2.7.5",
    "typescript": "^5.7.0",
    "zod": "^4.3.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "dependencies": {
    "@claude-flow/cli": "3.0.0-alpha.104",
    "agentic-jujutsu": "^2.3.6"
  },
  "volta": {
    "node": "22.11.0"
  }
}
