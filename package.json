{
  "name": "project-nyra",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered mortgage automation platform with multi-agent orchestration",
  "packageManager": "bun@1.3.8",
  "type": "module",

  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "vitest run",

    "doctor": "claude-flow doctor --fix",
    "swarm:init": "claude-flow swarm init --topology hierarchical --max-agents 8",
    "swarm:status": "claude-flow swarm status",
    "swarm:shutdown": "claude-flow swarm shutdown --graceful",

    "memory:init": "claude-flow memory init --force",
    "daemon:start": "claude-flow daemon start",
    "daemon:stop": "claude-flow daemon stop",

    "docker:up": "docker compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down"
  },

  "dependencies": {
    "agentic-flow": "^2.0.2-alpha",
    "agentic-jujutsu": "^2.3.6",
    "zod": "^4.3.5"
  },

  "devDependencies": {
    "turbo": "^2.7.5",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2"
  },

  "engines": {
    "node": ">=20"
  }
}
