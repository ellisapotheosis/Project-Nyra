{
  "name": "project-nyra",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered mortgage automation platform with multi-agent orchestration",
  "packageManager": "pnpm@10.27.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "apps/*/*",
    "apps/*/*/*",
    "services/*",
    "services/*/*",
    "packages/*",
    "tools/*",
    "mcp-servers/*"
  ],
  "pnpm": {
    "overrides": {
      "agentic-flow": "2.0.7"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "node ./scripts/run-workspace-lint.mjs",
    "test": "npx -y vitest --config vitest.config.mjs run",
    "doctor": "claude-flow doctor --fix",
    "swarm:init": "claude-flow swarm init --topology hierarchical --max-agents 8",
    "swarm:status": "claude-flow swarm status",
    "swarm:shutdown": "claude-flow swarm shutdown --graceful",
    "memory:init": "claude-flow memory init --force",
    "daemon:start": "claude-flow daemon start",
    "daemon:stop": "claude-flow daemon stop",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "twenty:setup": "docker compose -f infra/docker-compose.twenty.yml up -d",
    "twenty:down": "docker compose -f infra/docker-compose.twenty.yml down",
    "twenty:dev": "turbo run dev --filter=twenty-crm",
    "admin:dev": "turbo run dev --filter=nyra-admin",
    "all:dev": "turbo run dev --parallel"
  },
  "dependencies": {
    "agentic-flow": "2.0.7",
    "agentic-jujutsu": "^2.3.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@playwright/test": "^1.58.2",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.0.3",
    "prettier": "^3.4.2",
    "turbo": "^2.9.4",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  }
}
