# ============================================================================
# PROJECT NYRA - MASTER ENVIRONMENT CONFIGURATION
# ============================================================================
# Version: 3.0.0
# Last Updated: 2026-01-13
# Documentation: docs/environment/MASTER-ENV-VARS.md
#
# SECURITY WARNINGS:
# - NEVER commit .env files with real secrets to version control
# - Generate all secrets using the commands provided in comments
# - Rotate secrets every 90 days
# - Store critical secrets in Infisical (Project ID: 8374cea9-e5e8-4050-bda4-b91f25ab30ef)
# ============================================================================

# ============================================================================
# 1. CORE SYSTEM CONFIGURATION
# ============================================================================

# Runtime Environment (development | staging | production)
NODE_ENV=development

# Enable debug logging (true | false)
DEBUG=true

# Global logging level (debug | info | warn | error)
LOG_LEVEL=info

# Application HTTP port
PORT=3000

# Bind address (0.0.0.0 = all interfaces, 127.0.0.1 = localhost only)
HOST=0.0.0.0

# Timezone (IANA timezone database format)
TZ=America/New_York

# Locale setting
LANG=en_US.UTF-8

# Node.js runtime options (increase memory for large workloads)
NODE_OPTIONS=--max-old-space-size=4096

# Number of worker processes (typically CPU cores)
WORKERS=4

# Maximum memory per process in MB
MAX_MEMORY_MB=4096

# ============================================================================
# 2. LLM PROVIDERS & AI SERVICES
# ============================================================================
# At least ONE LLM provider API key is required for the system to function
# ============================================================================

# --- Anthropic Claude (Primary Provider) ---
# Generate: Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_WITH_YOUR_KEY

# API endpoint override (leave default unless using proxy)
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Default model (claude-3-5-sonnet-20241022 | claude-opus-4-5-20251101 | claude-3-5-haiku-20241022)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Maximum tokens per request
ANTHROPIC_MAX_TOKENS=8192

# --- OpenAI (Optional Alternative) ---
# Generate: Get from https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4-turbo

# --- OpenRouter (Recommended for Cost Optimization) ---
# Generate: Get from https://openrouter.ai/keys
# OpenRouter provides access to 100+ models with unified API
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3-5-sonnet

# --- LiteLLM (Unified LLM Proxy) ---
# Generate master key: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-litellm-GENERATE_WITH_OPENSSL
LITELLM_BASE_URL=http://localhost:4000

# Optional: PostgreSQL connection for LiteLLM logs/analytics
# LITELLM_DATABASE_URL=postgresql://postgres:password@orchestrator-mini:5432/litellm

# ============================================================================
# 3. DATABASE SERVICES
# ============================================================================

# --- PostgreSQL (Primary Relational Database) ---
# Option A: Use complete connection string (RECOMMENDED)
DATABASE_URL=postgresql://postgres:REPLACE_PASSWORD@orchestrator-mini:5432/nyra

# Option B: Use individual variables (alternative to DATABASE_URL)
POSTGRES_HOST=orchestrator-mini
POSTGRES_PORT=5432
POSTGRES_USER=postgres
# Generate password: openssl rand -base64 24
POSTGRES_PASSWORD=GENERATE_WITH_OPENSSL
POSTGRES_DB=nyra

# Create multiple databases for services (comma-separated)
POSTGRES_MULTIPLE_DATABASES=dify,twenty,letta,n8n,agentdb

# Alternative environment variables (some tools use these instead)
# PGHOST=orchestrator-mini
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=${POSTGRES_PASSWORD}
# PGDATABASE=nyra

# --- Redis (Caching & Message Broker) ---
# Note: Port 6380 to avoid conflict with FalkorDB on 6379
# Option A: Complete connection string
REDIS_URL=redis://:REPLACE_PASSWORD@orchestrator-mini:6380

# Option B: Individual variables
REDIS_HOST=orchestrator-mini
REDIS_PORT=6380
# Generate password: openssl rand -base64 24
REDIS_PASSWORD=GENERATE_WITH_OPENSSL
REDIS_DB=0
REDIS_USE_SSL=false

# --- Qdrant (Vector Database) ---
QDRANT_URL=http://orchestrator-mini:6333
# QDRANT_API_KEY=  # Only needed for Qdrant Cloud
QDRANT_COLLECTION=nyra_vectors

# --- FalkorDB (Graph Database) ---
FALKORDB_URL=redis://orchestrator-mini:6379
FALKORDB_GRAPH_NAME=nyra_graph

# --- MinIO (S3-Compatible Object Storage) ---
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=GENERATE_WITH_OPENSSL
# MINIO_ENDPOINT=http://orchestrator-mini:9000
# MINIO_BUCKET=nyra-storage

# ============================================================================
# 4. CLAUDE-FLOW ORCHESTRATION
# ============================================================================

# --- Core Configuration ---
# Operation mode (orchestrator | worker | hybrid)
CLAUDE_FLOW_MODE=orchestrator

# Number of worker processes
CLAUDE_FLOW_WORKERS=4

# Memory backend (sqlite | postgresql | agentdb)
CLAUDE_FLOW_MEMORY_BACKEND=agentdb

# Enable debug mode
CLAUDE_FLOW_DEBUG=false

# Logging level (debug | info | warn | error)
CLAUDE_FLOW_LOG_LEVEL=info

# Maximum concurrent agents in the system
CLAUDE_FLOW_MAX_AGENTS=100

# Maximum concurrent tasks
CLAUDE_FLOW_MAX_CONCURRENT_TASKS=50

# --- Swarm Configuration ---
# Swarm topology (mesh | hierarchical | ring | star | adaptive)
SWARM_TOPOLOGY=hierarchical

# Maximum agents in a single swarm
SWARM_MAX_AGENTS=31

# Distribution strategy (balanced | specialized | adaptive)
SWARM_STRATEGY=balanced

# Swarm memory database path
SWARM_MEMORY_PATH=.swarm/memory.db

# --- Session & State Management ---
# Current session identifier (auto-generated if not set)
# SESSION_ID=session-${timestamp}

# Auto-restore previous session on startup
SESSION_RESTORE=false

# Session storage directory
SESSION_SAVE_PATH=.claude-flow/sessions

# --- MCP Server Configuration ---
# MCP servers JSON configuration (see .mcp.json)
# MCP_SERVERS={}

# MCP operation timeout in milliseconds
MCP_TIMEOUT=30000

# ============================================================================
# 5. AGENTDB CONFIGURATION (High-Performance Vector Storage)
# ============================================================================
# AgentDB provides 150x-12,500x faster search with HNSW indexing
# ============================================================================

# --- Core Settings ---
# Enable AgentDB integration
AGENTDB_ENABLED=true

# AgentDB connection URL (PostgreSQL with pgvector)
AGENTDB_URL=postgresql://postgres:${POSTGRES_PASSWORD}@orchestrator-mini:5432/agentdb

# SQLite database path (alternative to PostgreSQL)
AGENTDB_PATH=.agentdb/claude-flow.db

# --- Vector Configuration ---
# Quantization method for memory optimization
# Options: binary (32x reduction) | scalar (4x) | product (8x) | none
AGENTDB_QUANTIZATION=scalar

# LRU cache size (increase for better performance)
AGENTDB_CACHE_SIZE=1000

# HNSW index parameters (higher M = more memory, faster search)
# M: Number of bi-directional links (4-64, default 16)
AGENTDB_HNSW_M=16

# EF: Size of dynamic candidate list (default 100)
AGENTDB_HNSW_EF=100

# EF_CONSTRUCTION: Candidate list size during index construction (default 200)
AGENTDB_HNSW_EF_CONSTRUCTION=200

# --- Learning Plugins ---
# Enable AI learning capabilities
AGENTDB_LEARNING=false

# Learning algorithm (decision-transformer | q-learning | sarsa | actor-critic | ppo | dqn | a3c | ddpg | td3)
AGENTDB_LEARNING_ALGORITHM=decision-transformer

# Enable reasoning agents
AGENTDB_REASONING=false

# --- QUIC Synchronization (Multi-PC) ---
# Enable QUIC-based synchronization across workers
AGENTDB_QUIC_SYNC=false

# QUIC server port
AGENTDB_QUIC_PORT=4433

# Comma-separated list of peer addresses (IP:PORT)
# Example: 10.0.0.2:4433,10.0.0.3:4433,10.0.0.4:4433
AGENTDB_QUIC_PEERS=

# ============================================================================
# 6. REASONINGBANK & MEMORY SYSTEMS
# ============================================================================

# --- ReasoningBank (Adaptive Learning) ---
# Enable ReasoningBank trajectory tracking
REASONINGBANK_ENABLED=true

# Memory database path
REASONINGBANK_DB_PATH=.swarm/memory.db

# Top-K memories to retrieve (1-10)
REASONINGBANK_K=3

# Minimum confidence threshold (0-1)
REASONINGBANK_MIN_CONFIDENCE=0.5

# --- Agentic-Flow Training ---
# Enable trajectory-based training
AGENTIC_FLOW_TRAINING=true

# Training mode (online | offline | hybrid)
AGENTIC_FLOW_TRAINING_MODE=online

# EWC++ regularization strength (0-1, prevents catastrophic forgetting)
AGENTIC_FLOW_EWC_LAMBDA=0.4

# --- Letta (MemGPT) - Stateful Long-Term Memory ---
# Generate API key: openssl rand -hex 32
LETTA_API_KEY=GENERATE_WITH_OPENSSL

# Generate server password: openssl rand -base64 24
LETTA_SERVER_PASS=GENERATE_WITH_OPENSSL

# PostgreSQL connection for Letta
LETTA_PG_URI=postgresql://postgres:${POSTGRES_PASSWORD}@orchestrator-mini:5432/letta

# Letta server URL
LETTA_BASE_URL=http://orchestrator-mini:8283

# --- Mem0 (Persistent Agent Memory) ---
# Get API key from https://app.mem0.ai/
# MEM0_API_KEY=REPLACE_WITH_YOUR_KEY
# MEM0_DEFAULT_USER_ID=nyra-default-user
# MEM0_BASE_URL=https://api.mem0.ai
# MEM0_VECTOR_STORE=qdrant
# MEM0_QDRANT_URL=http://orchestrator-mini:6333

# --- Zep (Temporal Context Management) ---
# Get API key from https://www.getzep.com/
# ZEP_API_KEY=REPLACE_WITH_YOUR_KEY
# ZEP_API_URL=https://api.getzep.com

# ============================================================================
# 7. SECURITY & AUTHENTICATION
# ============================================================================
# CRITICAL: All secrets MUST be generated fresh for each environment
# NEVER use example values in production
# ============================================================================

# --- Core Security Secrets ---
# Generate: openssl rand -base64 32
JWT_SECRET=GENERATE_WITH_OPENSSL_BASE64_32
SESSION_SECRET=GENERATE_WITH_OPENSSL_BASE64_32
ENCRYPTION_KEY=GENERATE_WITH_OPENSSL_BASE64_32

# JWT token expiration (24h | 7d | 30d)
JWT_EXPIRATION=24h

# Refresh token expiration
REFRESH_TOKEN_EXPIRATION=7d

# --- Rate Limiting ---
# Rate limit window in milliseconds (900000 = 15 minutes)
RATE_LIMIT_WINDOW=900000

# Maximum requests per window
RATE_LIMIT_MAX=100

# --- Service-Specific Authentication ---

# GitHub (for repository access)
# Get from https://github.com/settings/tokens
GITHUB_TOKEN=ghp_REPLACE_WITH_YOUR_TOKEN

# Dify
# Generate: openssl rand -hex 32
DIFY_SECRET_KEY=GENERATE_WITH_OPENSSL
DIFY_ENCRYPTION_KEY=GENERATE_WITH_OPENSSL

# n8n
# Generate: openssl rand -base64 32
N8N_ENCRYPTION_KEY=GENERATE_WITH_OPENSSL
N8N_BASIC_AUTH_USER=admin
# Generate: openssl rand -base64 24
N8N_BASIC_AUTH_PASSWORD=GENERATE_WITH_OPENSSL

# ============================================================================
# 8. NETWORKING & INFRASTRUCTURE (4-PC SETUP)
# ============================================================================

# --- Tailscale (Mesh VPN) ---
# Get auth key from https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTH_KEY=tskey-auth-REPLACE_WITH_YOUR_KEY
TAILSCALE_HOSTNAME=nyra-orchestrator
TAILSCALE_ADVERTISE_ROUTES=10.0.0.0/24
TAILSCALE_ACCEPT_ROUTES=true

# --- Cloudflare Tunnel (Secure External Access) ---
# Get token from Cloudflare Zero Trust dashboard
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_WITH_YOUR_TUNNEL_TOKEN
# CLOUDFLARE_TUNNEL_ID=REPLACE_WITH_TUNNEL_UUID
# CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_ACCOUNT_ID

# --- Static IP Configuration ---
# PC-specific (override per machine)
LAN_IP=10.0.0.1
LAN_GATEWAY=10.0.0.1
LAN_SUBNET=255.255.255.0
TAILSCALE_IP=100.64.0.1

# --- Reverse Proxy (Nginx/Caddy) ---
# NGINX_PORT=80
# NGINX_SSL_PORT=443
# SSL_CERT_PATH=/etc/ssl/certs/cert.pem
# SSL_KEY_PATH=/etc/ssl/private/key.pem

# ============================================================================
# 9. MONITORING & OBSERVABILITY
# ============================================================================

# --- Prometheus (Metrics Collection) ---
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
PROMETHEUS_SCRAPE_INTERVAL=15s

# --- Loki (Log Aggregation) ---
LOKI_PORT=3100
LOKI_RETENTION=7d

# --- Grafana (Visualization Dashboards) ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Generate: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=GENERATE_WITH_OPENSSL
# Generate: openssl rand -base64 32
GRAFANA_SECRET_KEY=GENERATE_WITH_OPENSSL

# --- AlertManager (Alert Routing) ---
ALERTMANAGER_PORT=9093
# Optional: Slack webhook for alerts
# ALERTMANAGER_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================================================
# 10. PER-PC CONFIGURATION (4-PC DISTRIBUTED SETUP)
# ============================================================================
# Copy this file to each PC and update these variables accordingly
# ============================================================================

# --- Universal Variables (Required on ALL PCs) ---
PC_NAME=orchestrator-mini
PC_ROLE=orchestrator
LAN_IP=10.0.0.1
TAILSCALE_IP=100.64.0.1

# --- PC1 (Orchestrator - Mac Mini) ---
# PC_NAME=orchestrator-mini
# PC_ROLE=orchestrator
# LAN_IP=10.0.0.1
# TAILSCALE_IP=100.64.0.1
# GPU_MODEL=none
# CLAUDE_FLOW_MODE=orchestrator

# --- PC2 (Worker - Alienware M15R7, RTX 3060, 12GB VRAM) ---
# PC_NAME=worker-rtx3060
# PC_ROLE=worker
# LAN_IP=10.0.0.2
# TAILSCALE_IP=100.64.0.2
# GPU_MODEL=RTX_3060
# GPU_VRAM_MB=12288
# GPU_COMPUTE_CAPABILITY=8.6
# OLLAMA_HOST=http://10.0.0.2:11434

# --- PC3 (Worker - Alienware Area-51, RTX 5090, 32GB VRAM) ---
# PC_NAME=worker-rtx5090
# PC_ROLE=worker
# LAN_IP=10.0.0.3
# TAILSCALE_IP=100.64.0.3
# GPU_MODEL=RTX_5090
# GPU_VRAM_MB=32768
# GPU_COMPUTE_CAPABILITY=9.0
# OLLAMA_HOST=http://10.0.0.3:11434

# --- PC4 (Worker - Desktop PC, RTX 3090 Ti, 24GB VRAM) ---
# PC_NAME=worker-rtx3090ti
# PC_ROLE=worker
# LAN_IP=10.0.0.4
# TAILSCALE_IP=100.64.0.4
# GPU_MODEL=RTX_3090_Ti
# GPU_VRAM_MB=24576
# GPU_COMPUTE_CAPABILITY=8.6
# OLLAMA_HOST=http://10.0.0.4:11434

# ============================================================================
# 11. GPU WORKERS & OLLAMA (LOCAL LLM INFERENCE)
# ============================================================================

# --- Ollama Configuration ---
# Ollama server URL (update per worker PC)
OLLAMA_HOST=http://10.0.0.2:11434

# Models to preload (comma-separated)
# OLLAMA_MODELS=llama3,mistral,codellama,deepseek-coder

# Parallel request handling (1-4 depending on VRAM)
OLLAMA_NUM_PARALLEL=1

# Maximum models loaded in memory simultaneously
OLLAMA_MAX_LOADED_MODELS=1

# --- GPU Configuration (Worker PCs Only) ---
# GPU device indices (0 = first GPU, 0,1 = two GPUs)
CUDA_VISIBLE_DEVICES=0

# GPU memory fraction to allocate (0.0-1.0)
GPU_MEMORY_FRACTION=0.9

# NVIDIA driver capabilities
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# --- Model Routing Strategy ---
# GPU selection strategy (vram_based | round_robin | least_loaded)
GPU_ROUTING_STRATEGY=vram_based

# Minimum VRAM required for tasks (in MB)
MIN_VRAM_MB=8192

# GPU Worker URLs (for LiteLLM/routing configuration)
WORKER_RTX3060_URL=http://10.0.0.2:11434
WORKER_RTX5090_URL=http://10.0.0.3:11434
WORKER_RTX3090TI_URL=http://10.0.0.4:11434

# ============================================================================
# 12. WORKFLOW AUTOMATION
# ============================================================================

# --- n8n (Workflow Automation Platform) ---
N8N_PORT=5678
N8N_HOST=orchestrator-mini
N8N_PROTOCOL=http

# Basic authentication
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=GENERATE_WITH_OPENSSL

# Data encryption key: openssl rand -base64 32
N8N_ENCRYPTION_KEY=GENERATE_WITH_OPENSSL

# Webhook base URL
WEBHOOK_URL=http://orchestrator-mini:5678

# Database connection (uses shared PostgreSQL)
N8N_DATABASE_TYPE=postgresdb
N8N_DATABASE_HOST=orchestrator-mini
N8N_DATABASE_PORT=5432
N8N_DATABASE_NAME=n8n
N8N_DATABASE_USER=postgres
N8N_DATABASE_PASSWORD=${POSTGRES_PASSWORD}

# --- Activepieces (Message Delivery Automation) ---
ACTIVEPIECES_PORT=3002
# Generate: openssl rand -hex 32
AP_API_KEY=GENERATE_WITH_OPENSSL
AP_ENCRYPTION_KEY=GENERATE_WITH_OPENSSL
# Generate: openssl rand -base64 32
AP_JWT_SECRET=GENERATE_WITH_OPENSSL
AP_ENVIRONMENT=prod
AP_FRONTEND_URL=http://orchestrator-mini:3002

# --- Dify (AI Chat Interface & App Builder) ---
DIFY_PORT=3001
DIFY_API_PORT=5001

# Generate: openssl rand -hex 32
DIFY_SECRET_KEY=GENERATE_WITH_OPENSSL
DIFY_ENCRYPTION_KEY=GENERATE_WITH_OPENSSL

# Storage backend (local | s3)
DIFY_STORAGE_TYPE=local

# Vector store (qdrant | pinecone)
DIFY_VECTOR_STORE=qdrant

# Database connection
DIFY_DB_TYPE=postgres
DIFY_DB_HOST=orchestrator-mini
DIFY_DB_PORT=5432
DIFY_DB_NAME=dify
DIFY_DB_USERNAME=postgres
DIFY_DB_PASSWORD=${POSTGRES_PASSWORD}

# Redis connection
DIFY_REDIS_HOST=orchestrator-mini
DIFY_REDIS_PORT=6380
DIFY_REDIS_PASSWORD=${REDIS_PASSWORD}

