# Archon OS Environment Configuration
# Copy this file to .env and configure with your actual values

# ==========================================
# CORE CONFIGURATION
# ==========================================
ARCHON_ENV=production
ARCHON_DEBUG=false
ARCHON_LOG_LEVEL=info

# ==========================================
# API CONFIGURATION
# ==========================================
ARCHON_API_PORT=8092
ARCHON_METRICS_PORT=8093
ARCHON_API_KEY=your-secure-api-key-here
WORKER_PROCESSES=4
WORKER_CONNECTIONS=1000
GRACEFUL_TIMEOUT=30

# ==========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==========================================
POSTGRES_USER=archon
POSTGRES_PASSWORD=archon_secure_pass_change_me
POSTGRES_DB=archon_os
DATABASE_URL=postgresql://archon:archon_secure_pass_change_me@archon-postgres:5432/archon_os
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ==========================================
# REDIS CONFIGURATION
# ==========================================
REDIS_URL=redis://archon-redis:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# ==========================================
# MESSAGE QUEUE (RabbitMQ)
# ==========================================
RABBITMQ_USER=archon
RABBITMQ_PASSWORD=archon_queue_pass_change_me
RABBITMQ_URL=amqp://archon:archon_queue_pass_change_me@archon-rabbitmq:5672/
RABBITMQ_EXCHANGE=archon-exchange
RABBITMQ_QUEUE=archon-tasks
RABBITMQ_MANAGEMENT_PORT=15672

# ==========================================
# LITELLM PROXY
# ==========================================
LITELLM_PROXY_URL=http://litellm-proxy:8000
LITELLM_API_KEY=your-litellm-api-key

# ==========================================
# CLAUDE API (Anthropic)
# ==========================================
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ==========================================
# OPENAI API (Optional)
# ==========================================
OPENAI_API_KEY=sk-your-openai-key-here

# ==========================================
# MCP CONFIGURATION
# ==========================================
MCP_ENABLED=true
MCP_SERVER_URL=http://archon-os:8092/mcp
MCP_TRANSPORT=sse

# ==========================================
# CLAUDE FLOW INTEGRATION
# ==========================================
CLAUDE_FLOW_ENABLED=true
CLAUDE_FLOW_HOOKS=true
CLAUDE_FLOW_MEMORY_ENABLED=true

# ==========================================
# AGENT CONFIGURATION
# ==========================================
MAX_AGENTS=50
AGENT_TIMEOUT=300
AGENT_MAX_RETRIES=3
AGENT_CHECKPOINT_INTERVAL=60

# ==========================================
# SWARM CONFIGURATION
# ==========================================
SWARM_TOPOLOGY=mesh
SWARM_MAX_CONCURRENT_TASKS=10
SWARM_COORDINATION_MODE=adaptive

# ==========================================
# SECURITY
# ==========================================
JWT_SECRET=your-jwt-secret-key-change-me-min-32-chars
JWT_EXPIRATION=3600
ENABLE_AUTH=true

# ==========================================
# MONITORING
# ==========================================
PROMETHEUS_ENABLED=true
TRACING_ENABLED=false

# ==========================================
# ADVANCED FEATURES
# ==========================================
# Enable experimental features
ENABLE_AUTO_SCALING=false
ENABLE_NEURAL_COORDINATION=true
ENABLE_ADAPTIVE_TOPOLOGY=true
ENABLE_SELF_HEALING=true

# ==========================================
# RESOURCE LIMITS
# ==========================================
# Docker resource limits
MAX_CPU_CORES=4
MAX_MEMORY_GB=8

# ==========================================
# EXTERNAL SERVICES (Optional)
# ==========================================
# Jaeger Tracing
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831

# Prometheus
PROMETHEUS_PUSHGATEWAY=http://prometheus-pushgateway:9091

# ==========================================
# DEVELOPMENT ONLY
# ==========================================
# Uncomment for development mode
# ARCHON_ENV=development
# ARCHON_DEBUG=true
# ARCHON_LOG_LEVEL=debug
# ENABLE_AUTH=false
