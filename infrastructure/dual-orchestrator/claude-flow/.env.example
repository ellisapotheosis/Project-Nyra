# Claude-Flow Orchestrator Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# Core Configuration
# ============================================================================
NODE_ENV=production
LOG_LEVEL=info

# ============================================================================
# LiteLLM Integration
# ============================================================================
# LiteLLM API Configuration
LITELLM_API_KEY=your_litellm_api_key_here
LITELLM_MODEL=gpt-4

# Direct Anthropic API (fallback)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================================
# MetaMCP Integration
# ============================================================================
METAMCP_API_KEY=your_metamcp_api_key_here

# ============================================================================
# RabbitMQ Message Queue
# ============================================================================
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=change_me_in_production
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=orchestrator-exchange

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_PASSWORD=change_me_in_production

# ============================================================================
# Claude-Flow Specific Settings
# ============================================================================
# Maximum number of concurrent agents
MAX_AGENTS=10

# Default swarm topology (mesh, hierarchical, ring, star)
TOPOLOGY=mesh

# Agent distribution strategy (balanced, specialized, adaptive)
STRATEGY=balanced

# ============================================================================
# Session Management
# ============================================================================
# Session TTL in seconds (default: 1 hour)
SESSION_TTL=3600

# Session cleanup interval in seconds (default: 5 minutes)
SESSION_CLEANUP_INTERVAL=300

# ============================================================================
# Memory Configuration
# ============================================================================
# Memory TTL in seconds (default: 24 hours)
MEMORY_TTL=86400

# ============================================================================
# GitHub Integration (Optional)
# ============================================================================
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO_OWNER=your_username
GITHUB_REPO_NAME=your_repo

# ============================================================================
# Monitoring & Observability
# ============================================================================
# Prometheus metrics
METRICS_ENABLED=true
METRICS_PORT=8091

# ============================================================================
# Security Settings
# ============================================================================
# API Key for external access
API_KEY=your_secure_api_key_here

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================================================
# Performance Tuning
# ============================================================================
# Maximum concurrent tasks
MAX_CONCURRENT_TASKS=20

# Task timeout in milliseconds (default: 5 minutes)
TASK_TIMEOUT=300000

# Connection timeout in milliseconds
CONNECTION_TIMEOUT=10000

# Request timeout in milliseconds
REQUEST_TIMEOUT=300000

# ============================================================================
# Feature Flags
# ============================================================================
# Enable neural training
NEURAL_TRAINING_ENABLED=true

# Enable auto-spawning of agents
AUTO_SPAWNING_ENABLED=true

# Enable self-healing workflows
SELF_HEALING_ENABLED=true

# Enable cross-session memory
CROSS_SESSION_MEMORY_ENABLED=true

# Enable GitHub integration
GITHUB_INTEGRATION_ENABLED=true

# Enable performance analysis
PERFORMANCE_ANALYSIS_ENABLED=true

# ============================================================================
# Development Settings (Development Only)
# ============================================================================
# Enable debug mode
DEBUG=false

# Enable verbose logging
VERBOSE=false

# Enable hot reload
HOT_RELOAD=false

# ============================================================================
# Database Configuration (Optional - for persistence)
# ============================================================================
# PostgreSQL (if using database backend)
# DATABASE_URL=postgresql://user:password@postgres:5432/claudeflow
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10

# ============================================================================
# External Service Integration (Optional)
# ============================================================================
# Slack notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Discord notifications
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK

# Email notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=noreply@claudeflow.local

# ============================================================================
# Advanced Configuration
# ============================================================================
# Worker threads
# WORKER_THREADS=4

# Memory limit (MB)
# MEMORY_LIMIT=2048

# CPU limit (cores)
# CPU_LIMIT=2

# Timezone
TZ=UTC
