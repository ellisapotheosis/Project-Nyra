{
  "mcpServers": {
    "filesystem": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Dev\\Projects\\Repos\\Project-Nyra",
        "C:\\Dev\\NYRA-AIO-Bootstrap"
      ]
    },
    "github": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "serena": {
      "command": "cmd",
      "args": [
        "/c",
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "C:\\Dev\\Projects\\Repos\\Project-Nyra",
        "--project",
        "nyra"
      ],
      "env": {
        "SERENA_LOG_LEVEL": "info"
      }
    },
    "claude-flow": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "claude-flow@alpha",
        "mcp",
        "start"
      ]
    },
    "ruv-swarm": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "ruv-swarm",
        "mcp",
        "start"
      ]
    },
    "flow-nexus": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "flow-nexus",
        "mcp",
        "start"
      ]
    },
    "gemini-assistant": {
      "command": "cmd",
      "args": [
        "/c",
        "python",
        "-u",
        "mcp-servers\\mcp-gemini-assistant\\src\\server.py"
      ],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}"
      }
    }
  }
}