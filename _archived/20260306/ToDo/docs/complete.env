# =============================================================================
# PROJECT NYRA - COMPLETE ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env in your project root and fill in the values
# Last updated: 2025-01-08
# =============================================================================

# =============================================================================
# INFISICAL - Secret Management
# =============================================================================
INFISICAL_PROJECT_ID=8374cea9-e5e8-4050-bda4-b91f25ab30ef
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_ENVIRONMENT=production

# =============================================================================
# ANTHROPIC - Primary LLM Provider
# =============================================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.7

# =============================================================================
# OPENROUTER - Cost-Effective LLM Provider
# =============================================================================
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1
OPENROUTER_SITE_URL=https://ratehunter.net
OPENROUTER_SITE_NAME=Project Nyra

# =============================================================================
# OPENAI - Embeddings and Fallback
# =============================================================================
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# =============================================================================
# GOOGLE GEMINI - Free Tier LLM
# =============================================================================
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-2.0-flash-exp

# =============================================================================
# GITHUB - Code Repository
# =============================================================================
GITHUB_TOKEN=
GITHUB_REPO=Project-Nyra
GITHUB_OWNER=

# =============================================================================
# NEXUS ROUTER - LLM Load Balancing
# =============================================================================
NEXUS_ROUTER_ENABLED=true
NEXUS_ROUTER_PORT=8000
NEXUS_LOAD_BALANCING=least-loaded
NEXUS_HEALTH_CHECK_INTERVAL=30
NEXUS_FALLBACK_ENABLED=true
NEXUS_CIRCUIT_BREAKER_THRESHOLD=5
NEXUS_CIRCUIT_BREAKER_TIMEOUT=30000

# =============================================================================
# GPU WORKERS - Local LLM Inference (via Tailscale)
# =============================================================================
GPU_WORKER_5090_URL=http://worker-5090.tail-net.ts.net:11434
GPU_WORKER_5090_GPU=RTX 5090
GPU_WORKER_5090_VRAM=48GB
GPU_WORKER_5090_MODELS=deepseek-r1:236b-q4,qwen2.5:72b-q8
GPU_WORKER_5090_MAX_CONCURRENT=3
GPU_WORKER_5090_PRIORITY=1

GPU_WORKER_3090_URL=http://worker-3090.tail-net.ts.net:11434
GPU_WORKER_3090_GPU=RTX 3090 Ti
GPU_WORKER_3090_VRAM=24GB
GPU_WORKER_3090_MODELS=llama3.1:70b-q4,mistral-large:123b-q4
GPU_WORKER_3090_MAX_CONCURRENT=2
GPU_WORKER_3090_PRIORITY=2

GPU_WORKER_3060_URL=http://worker-3060.tail-net.ts.net:11434
GPU_WORKER_3060_GPU=RTX 3060
GPU_WORKER_3060_VRAM=12GB
GPU_WORKER_3060_MODELS=codellama:34b-q8,qwen2.5:32b-q8,gemma2:27b
GPU_WORKER_3060_MAX_CONCURRENT=2
GPU_WORKER_3060_PRIORITY=3

LOCAL_LLM_ENABLED=true
LOCAL_LLM_PRIORITY=true
LOCAL_LLM_FALLBACK_TO_CLOUD=true

# =============================================================================
# RUVECTOR - Distributed Vector Search
# =============================================================================
RUVECTOR_ENABLED=true
RUVECTOR_MODE=distributed
RUVECTOR_PORT=7000
RUVECTOR_CONSENSUS_ENABLED=true
RUVECTOR_CONSENSUS_PEERS=localhost:7001,localhost:7002
RUVECTOR_VECTOR_DIMENSIONS=1536
RUVECTOR_INDEX_TYPE=HNSW
RUVECTOR_DISTANCE_METRIC=cosine
RUVECTOR_HNSW_EF_CONSTRUCTION=200
RUVECTOR_HNSW_M=16
RUVECTOR_WAL_ENABLED=true
RUVECTOR_COMPRESSION=true
RUVECTOR_SNAPSHOT_INTERVAL=3600

# =============================================================================
# LETTA (MemGPT) - Agent Memory System
# =============================================================================
LETTA_ENABLED=true
LETTA_SERVER_URL=http://localhost:8283
LETTA_DB_URL=postgresql://letta:letta_password@localhost:5432/letta
LETTA_AGENT_POOLING=true
LETTA_MAX_AGENTS=20
LETTA_CONTEXT_WINDOW=32000
LETTA_ARCHIVAL_MEMORY=true
LETTA_AUTO_SAVE=true
LETTA_SAVE_INTERVAL=300

# =============================================================================
# GRAPHITI - Temporal Knowledge Graph
# =============================================================================
GRAPHITI_ENABLED=true
GRAPHITI_BACKEND=falkordb
GRAPHITI_TEMPORAL_TRACKING=true
GRAPHITI_RELATIONSHIP_INFERENCE=true
GRAPHITI_AUTO_SNAPSHOT=true
GRAPHITI_SNAPSHOT_INTERVAL=3600
GRAPHITI_MAX_NODES=1000000

# =============================================================================
# FALKORDB - Graph Database Backend
# =============================================================================
FALKORDB_URL=redis://localhost:6379
FALKORDB_PASSWORD=
FALKORDB_DB_INDEX=0
FALKORDB_GRAPH_NAME=nyra_knowledge_graph
FALKORDB_PERSISTENCE=true
FALKORDB_REPLICATION=false
FALKORDB_AOF_ENABLED=true

# =============================================================================
# MEM0 - User Personalization Memory
# =============================================================================
MEM0_ENABLED=true
MEM0_PORT=8081
MEM0_USER_PERSONALIZATION=true
MEM0_CROSS_APP_SYNC=true
MEM0_RETENTION_DAYS=90
MEM0_ENCRYPTION=true
MEM0_VECTOR_STORE=qdrant
MEM0_VECTOR_STORE_URL=http://localhost:6333

# =============================================================================
# OPENMEMORY - Shared Collaborative Memory
# =============================================================================
OPENMEMORY_ENABLED=true
OPENMEMORY_PORT=8080
OPENMEMORY_SHARED_MEMORY=true
OPENMEMORY_ENCRYPTION=true
OPENMEMORY_DB_URL=postgresql://openmemory:openmemory_password@localhost:5432/openmemory
OPENMEMORY_SYNC_INTERVAL=30

# =============================================================================
# QDRANT - Vector Database
# =============================================================================
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=nyra_vectors
QDRANT_VECTOR_SIZE=1536
QDRANT_DISTANCE=Cosine
QDRANT_ON_DISK_PAYLOAD=true
QDRANT_INDEXING_THRESHOLD=20000
QDRANT_OPTIMIZATION_ENABLED=true

# =============================================================================
# LMCACHE - Local GPU LLM Caching
# =============================================================================
LMCACHE_ENABLED=true
LMCACHE_BACKEND=redis
LMCACHE_REDIS_URL=redis://localhost:6379/1
LMCACHE_TTL=3600
LMCACHE_MAX_SIZE=10GB

# =============================================================================
# POSTGRESQL - Primary Database
# =============================================================================
DATABASE_URL=postgresql://nyra:nyra_password@localhost:5432/nyra
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_SCHEMA=public

# =============================================================================
# REDIS - Cache and Queue
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50
REDIS_CACHE_TTL=300

# =============================================================================
# NEO4J - Graph Database (Alternative to FalkorDB)
# =============================================================================
NEO4J_ENABLED=false
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j_password

# =============================================================================
# DIFY - AI Chatbot Platform
# =============================================================================
DIFY_ENABLED=true
DIFY_API_URL=http://localhost:3000
DIFY_CONSOLE_URL=http://localhost:5001
DIFY_API_KEY=
DIFY_SECRET_KEY=
DIFY_DB_URL=postgresql://dify:dify_password@localhost:5432/dify

# =============================================================================
# N8N - Workflow Automation
# =============================================================================
N8N_ENABLED=true
N8N_URL=http://localhost:5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=
N8N_ENCRYPTION_KEY=
N8N_DB_TYPE=postgresdb
N8N_DB_URL=postgresql://n8n:n8n_password@localhost:5432/n8n

# =============================================================================
# ACTIVEPIECES - Workflow Automation
# =============================================================================
ACTIVEPIECES_ENABLED=true
ACTIVEPIECES_URL=http://localhost:8080
ACTIVEPIECES_API_KEY=
ACTIVEPIECES_ENCRYPTION_KEY=
ACTIVEPIECES_DB_URL=postgresql://activepieces:activepieces_password@localhost:5432/activepieces

