{
  "manifest_version": 3,
  "name": "Nyra Voicemod Control",
  "version": "0.4.0",
  "description": "Control Voicemod: list voices, pick soundboard sounds, play/stop, mute, icons, and speak selection.",
  "icons": {
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Nyra Voicemod",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "tts",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "ws://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}