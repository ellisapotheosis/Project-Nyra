# Multi-stage Production Dockerfile
# Build optimized images with security scanning

# Stage 1: Base
FROM node:20-alpine AS base
LABEL maintainer="orchestrator@example.com"
LABEL description="Production orchestrator application"

# Install security updates
RUN apk update && apk upgrade && \
    apk add --no-cache \
    dumb-init \
    curl \
    ca-certificates && \
    rm -rf /var/cache/apk/*

# Create app user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

WORKDIR /app

# Stage 2: Dependencies
FROM base AS dependencies

# Copy package files
COPY package*.json ./
COPY pnpm-lock.yaml* ./

# Install pnpm
RUN npm install -g pnpm@latest

# Install production dependencies
RUN pnpm install --frozen-lockfile --prod

# Stage 3: Build
FROM base AS build

# Copy package files
COPY package*.json ./
COPY pnpm-lock.yaml* ./

# Install pnpm and all dependencies
RUN npm install -g pnpm@latest && \
    pnpm install --frozen-lockfile

# Copy source code
COPY src ./src
COPY tsconfig.json ./

# Build application
RUN pnpm run build && \
    pnpm run test:ci && \
    pnpm prune --prod

# Stage 4: Production
FROM base AS production

# Build arguments
ARG NODE_ENV=production
ARG BUILD_DATE
ARG VERSION

# Environment variables
ENV NODE_ENV=${NODE_ENV} \
    NODE_OPTIONS="--max-old-space-size=4096" \
    TZ=UTC

# Labels
LABEL org.opencontainers.image.created=${BUILD_DATE}
LABEL org.opencontainers.image.version=${VERSION}
LABEL org.opencontainers.image.authors="orchestrator@example.com"
LABEL org.opencontainers.image.description="Production orchestrator application"

# Copy dependencies from dependencies stage
COPY --from=dependencies --chown=nodejs:nodejs /app/node_modules ./node_modules

# Copy built application from build stage
COPY --from=build --chown=nodejs:nodejs /app/dist ./dist
COPY --from=build --chown=nodejs:nodejs /app/package.json ./

# Create required directories
RUN mkdir -p /app/logs /app/tmp && \
    chown -R nodejs:nodejs /app

# Security: Remove unnecessary packages
RUN apk del curl && \
    rm -rf /var/cache/apk/*

# Switch to non-root user
USER nodejs

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Use dumb-init to handle signals properly
ENTRYPOINT ["/usr/bin/dumb-init", "--"]

# Start application
CMD ["node", "dist/main.js"]
