# ============================================================================
# Project Nyra - Development Environment Secrets
# ============================================================================
# This file contains secrets for the development environment.
# After editing, upload to Infisical using:
#   infisical secrets set --env=dev --path=/shared --file=env/dev.shared.env
# ============================================================================

# =============================================================================
# CORE PROJECT SETTINGS
# =============================================================================
PROJECT_NAME=project-nyra
PROJECT_ENV=development
NODE_ENV=development
LOG_LEVEL=debug
DEBUG=true

# =============================================================================
# API KEYS (REQUIRED)
# =============================================================================

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-your-dev-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google Gemini API (for Gemini MCP server)
GOOGLE_GEMINI_API_KEY=your-gemini-api-key-here

# OpenRouter API (optional - for LLM fallback)
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# =============================================================================
# DATABASE CREDENTIALS
# =============================================================================

# PostgreSQL
POSTGRES_USER=nyra
POSTGRES_PASSWORD=nyra_dev_password_change_me
POSTGRES_DB=nyra_development
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nyra:nyra_dev_password_change_me@postgresql:5432/nyra_development

# Individual database names
LETTA_DB_NAME=letta
TWENTY_DB_NAME=twenty
DIFY_DB_NAME=dify
N8N_DB_NAME=n8n

# Letta specific
LETTA_POSTGRES_URI=postgresql://letta:letta_dev_pass@postgresql:5432/letta
LETTA_DB_PASSWORD=letta_dev_pass
LETTA_SERVER_PASSWORD=letta_server_dev_pass

# =============================================================================
# REDIS & CACHING
# =============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password_change_me
REDIS_DB=0
REDIS_MAX_MEMORY=4GB
REDIS_EVICTION_POLICY=allkeys-lru
REDIS_URL=redis://:redis_dev_password_change_me@redis:6379

# FalkorDB (graph database)
FALKORDB_PASSWORD=falkor_dev_password
FALKORDB_AOF_SYNC=everysec
FALKORDB_MAX_MEMORY=2GB

# =============================================================================
# VECTOR DATABASES
# =============================================================================

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=qdrant_dev_key_change_me
QDRANT_COLLECTION=nyra_embeddings
QDRANT_VECTOR_SIZE=1536

# =============================================================================
# ORCHESTRATION SERVICES
# =============================================================================

# Claude Flow
CLAUDE_FLOW_PORT=9000
CLAUDE_FLOW_MODE=orchestrator
CLAUDE_FLOW_TELEMETRY_ENABLED=true
CLAUDE_FLOW_PERFORMANCE_MODE=optimized
CLAUDE_FLOW_AUTO_COMMIT=true
CLAUDE_FLOW_HOOKS_ENABLED=true
CLAUDE_FLOW_NEURAL_OPTIMIZATION=true

# Archon OS
ARCHON_PORT=9001
ARCHON_MCP_PORT=3333
ARCHON_TOPOLOGY=hierarchical
ARCHON_MAX_DEPTH=5
ARCHON_PARALLEL_BRANCHES=true

# Nexus Router
NEXUS_ROUTER_PORT=8000
NEXUS_ROUTER_MCP_PORT=4001
MODEL_ROUTING_STRATEGY=cost-optimized
MODEL_ROUTING_PREFER_LOCAL=true
MODEL_ROUTING_FALLBACK_CLOUD=true

# =============================================================================
# MCP SERVERS
# =============================================================================

GEMINI_MCP_PORT=8085
SERENA_MCP_PORT=8086

# Mem0
MEM0_API_KEY=mem0_dev_key
MEM0_PROFILE_SCHEMA=mortgage_borrower
MEM0_PII_PROTECTION=enabled
MEM0_GDPR_COMPLIANT=true
MEM0_SERVER_URL=http://localhost:8080
OPENMEMORY_MCP_PORT=8081

# Letta
LETTA_API_URL=http://localhost:8283
LETTA_MCP_PORT=8284

# =============================================================================
# UI SERVICES
# =============================================================================

OPEN_WEBUI_PORT=3333
LOBECHAT_PORT=3334
LOBECHAT_ACCESS_CODE=dev-access-code

# =============================================================================
# SECURITY & SESSIONS
# =============================================================================

ENCRYPTION_KEY=dev-encryption-key-change-me-32-chars-long
ENCRYPTION_ALGORITHM=aes-256-gcm
SESSION_SECRET=dev-session-secret-change-me
SESSION_MAX_AGE=86400

# =============================================================================
# GITHUB INTEGRATION
# =============================================================================

GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_REPO=Project-Nyra
GITHUB_OWNER=your-github-username

# =============================================================================
# GPU WORKERS (Optional - for local model routing)
# =============================================================================

WORKER_5090_URL=http://worker-5090.tail-net.ts.net:11434
WORKER_5090_MODELS=deepseek-r1:236b-q4_K_M,qwen2.5:72b-instruct-q8_0

WORKER_3090_URL=http://worker-3090.tail-net.ts.net:11434
WORKER_3090_MODELS=llama3.1:70b-instruct-q4_K_M

WORKER_3060_URL=http://worker-3060.tail-net.ts.net:11434
WORKER_3060_MODELS=codellama:34b-instruct-q8_0
