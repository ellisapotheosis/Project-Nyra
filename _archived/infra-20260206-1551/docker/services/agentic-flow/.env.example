# ============================================================================
# Agentic-Flow Alpha - Environment Configuration
# ============================================================================
# Copy to .env and configure for your environment
# Secrets should be managed via Infisical in production
# ============================================================================

# Core Configuration
NODE_ENV=production
AGENTIC_FLOW_PORT=8080
AGENTIC_FLOW_MCP_PORT=8081

# Database Configuration
POSTGRES_USER=nyra_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=nyra_db

# Redis Configuration (Database 3)
REDIS_PASSWORD=your_redis_password
AGENTIC_FLOW_CACHE_TTL=3600

# AgentDB Configuration
AGENTDB_QUANTIZATION=binary
AGENTDB_CACHE_SIZE=2000
AGENTDB_HNSW_M=16
AGENTDB_HNSW_EF=100

# QUIC Synchronization (Multi-node)
AGENTDB_QUIC_SYNC=true
AGENTDB_QUIC_PORT=4433
AGENTDB_QUIC_PEERS=192.168.1.10:4433,192.168.1.11:4433,192.168.1.12:4433

# LLM Provider API Keys (from Infisical)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...

# Service URLs
NEXUS_ROUTER_URL=http://nexus-router:7000
CLAUDE_FLOW_URL=http://claude-flow:3001

# Agent Configuration
MAX_CONCURRENT_AGENTS=35
AGENT_TIMEOUT=300000
WORKER_THREADS=4

# Monitoring
AGENTIC_FLOW_TELEMETRY=true
AGENTIC_FLOW_PROMETHEUS_PORT=9091

# Logging
AGENTIC_FLOW_LOG_LEVEL=info

# Security
AGENTIC_FLOW_AUTH=true
AGENTIC_FLOW_JWT_SECRET=your_jwt_secret_here
AGENTIC_FLOW_API_KEY=your_api_key_here
