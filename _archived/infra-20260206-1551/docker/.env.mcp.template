# MCP Server Environment Variables Template
# Project Nyra - Copy this to ../../.env and configure

# ============================================
# API Keys (Required)
# ============================================

# Google Gemini API Key (required for mcp-gemini)
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=

# Anthropic API Key (required for claude-flow, archon)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ============================================
# Supabase (Required for Archon OS)
# ============================================

# Supabase Project URL
# Format: https://xxxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase Service Role Key (NOT anon key!)
# CRITICAL: Use SERVICE ROLE key from Supabase dashboard
SUPABASE_SERVICE_KEY=

# ============================================
# Database Configuration (Production)
# ============================================

# PostgreSQL for MCP data
MCP_DB_NAME=mcp_production
MCP_DB_USER=mcp_prod
MCP_DB_PASSWORD=

# Redis for MCP caching
MCP_REDIS_PASSWORD=

# ============================================
# MCP Server Configuration
# ============================================

# Gemini MCP
GEMINI_MODEL=gemini-2.0-flash-exp
SESSION_TIMEOUT=3600
MAX_FILE_SIZE=1048576

# Claude Flow MCP
CLAUDE_FLOW_MEMORY=true
CLAUDE_FLOW_DISTRIBUTED=true

# RuV Swarm MCP
RUV_SWARM_DISTRIBUTED=true

# Archon OS MCP
MCP_PORT=8051
ENABLE_AGENT_WORK_ORDERS=true

# ============================================
# Optional: GitHub Integration
# ============================================

# GitHub Personal Access Token (for Archon OS GitHub features)
GITHUB_PAT_TOKEN=

# Claude Code OAuth Token (for Archon OS Claude Code integration)
CLAUDE_CODE_OAUTH_TOKEN=

# ============================================
# Optional: Additional LLM Providers
# ============================================

# OpenRouter (alternative LLM provider)
OPENROUTER_API_KEY=

# Ollama (local LLM)
OLLAMA_URL=http://localhost:11434

# ============================================
# Logging Configuration
# ============================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# ============================================
# Development vs Production
# ============================================

# Environment mode
NODE_ENV=production

# ============================================
# Notes
# ============================================

# 1. Copy this file to ../../.env (project root)
# 2. Fill in all API keys and passwords
# 3. Never commit .env to git
# 4. Use .env.template for reference only
# 5. Supabase requires SERVICE ROLE key, not anon key
# 6. Generate strong passwords for databases
