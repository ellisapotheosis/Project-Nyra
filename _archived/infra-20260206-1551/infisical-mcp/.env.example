# Infisical MCP Server Configuration

# MCP Server Settings
MCP_PORT=8006
LOG_LEVEL=info
NODE_ENV=production

# Infisical Configuration
# Get your token from: https://app.infisical.com/
INFISICAL_TOKEN=your_infisical_token_here
INFISICAL_PROJECT_ID=your_project_id_here
INFISICAL_ENVIRONMENT=development

# Disable update checks in containerized environments
INFISICAL_DISABLE_UPDATE_CHECK=true

# Nyra Integration (Optional)
NYRA_ENVIRONMENT=development
NYRA_PC_ID=orchestrator

# Cache and Storage Paths
CACHE_PATH=/app/cache
SECRETS_PATH=/app/secrets
