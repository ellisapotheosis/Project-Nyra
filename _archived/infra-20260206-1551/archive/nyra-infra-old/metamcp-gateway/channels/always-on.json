{
  "description": "MCPs that are safe to keep connected all the time (low-context).",
  "servers": {
    "Infisical": {
      "type": "STDIO",
      "command": "npx",
      "args": ["-y", "infisical-mcp@latest"],
      "env": {
        "INFISICAL_TOKEN": "${INFISICAL_TOKEN}",
        "INFISICAL_SITE_URL": "${INFISICAL_SITE_URL}"
      }
    },
    "Filesystem": {
      "type": "STDIO",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem"],
      "env": {
        "ROOT": "${NYRA_MOUNT_ROOT}"
      }
    }
  }
}
