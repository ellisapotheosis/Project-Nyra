# ==============================================
# Project Nyra - Orchestration Manifest (Infisical Generated)
# ==============================================

# API Keys (Injected from Infisical Dashboard)
GOOGLE_GEMINI_API_KEY="{{ .GOOGLE_GEMINI_API_KEY }}"
ANTHROPIC_API_KEY="{{ .ANTHROPIC_API_KEY }}"
OPENROUTER_API_KEY="{{ .OPENROUTER_API_KEY }}"

# Orchestration Services
CLAUDE_FLOW_PORT={{ .CLAUDE_FLOW_PORT | default "9000" }}
CLAUDE_FLOW_URL={{ .CLAUDE_FLOW_URL | default "http://localhost:9000" }}
ARCHON_PORT={{ .ARCHON_PORT | default "9001" }}
ARCHON_OS_URL={{ .ARCHON_OS_URL | default "http://localhost:9001" }}
NEXUS_PORT={{ .NEXUS_PORT | default "8000" }}
NEXUS_ROUTER_URL={{ .NEXUS_ROUTER_URL | default "http://localhost:8000" }}

# MCP Servers
GEMINI_MCP_PORT={{ .GEMINI_MCP_PORT | default "8085" }}
GEMINI_MCP_URL={{ .GEMINI_MCP_URL | default "http://localhost:8085" }}
SERENA_MCP_PORT={{ .SERENA_MCP_PORT | default "8086" }}
SERENA_MCP_URL={{ .SERENA_MCP_URL | default "http://localhost:8086" }}
SERENA_REPO_PATH="{{ .SERENA_REPO_PATH | default "/workspace" }}"

# UI & Databases
DIFY_PORT={{ .DIFY_PORT | default "3000" }}
DIFY_URL={{ .DIFY_URL | default "http://localhost:3000" }}
POSTGRES_USER="{{ .POSTGRES_USER }}"
POSTGRES_PASSWORD="{{ .POSTGRES_PASSWORD }}"
POSTGRES_DB="{{ .POSTGRES_DB }}"
POSTGRES_PORT={{ .POSTGRES_PORT | default "5432" }}
DATABASE_URL="postgresql://{{ .POSTGRES_USER }}:{{ .POSTGRES_PASSWORD }}@postgresql:5432/{{ .POSTGRES_DB }}"
REDIS_PORT={{ .REDIS_PORT | default "6379" }}
REDIS_URL="redis://{{ .REDIS_PASSWORD }}@redis:6379"

# GPU Workers (RTX 5090 / 3090 / 3060)
GPU_WORKER_5090_URL="{{ .GPU_WORKER_5090_URL }}"
GPU_WORKER_5090_ENABLED={{ .GPU_WORKER_5090_ENABLED | default "false" }}
GPU_WORKER_3090_URL="{{ .GPU_WORKER_3090_URL }}"
GPU_WORKER_3090_ENABLED={{ .GPU_WORKER_3090_ENABLED | default "false" }}
GPU_WORKER_3060_URL="{{ .GPU_WORKER_3060_URL }}"
GPU_WORKER_3060_ENABLED={{ .GPU_WORKER_3060_ENABLED | default "false" }}

# 2026 Model Configuration
CLAUDE_MODEL="claude-3-7-sonnet-latest"
GEMINI_MODEL="gemini-3-pro-preview"
GPT_MODEL="gpt-5-preview"
DEFAULT_TEMPERATURE=0.7
MAX_TOKENS=16384
CONTEXT_WINDOW=2000000

# Ollama & Dev Settings
OLLAMA_API_BASE_URL="{{ .OLLAMA_API_BASE_URL | default "http://host.docker.internal:11434" }}"
OLLAMA_ENABLED={{ .OLLAMA_ENABLED | default "true" }}
NODE_ENV="{{ .ENV | default "development" }}"
LOG_LEVEL="{{ .LOG_LEVEL | default "info" }}"
DEBUG={{ .DEBUG | default "false" }}

# Security & JWT
JWT_SECRET="{{ .JWT_SECRET }}"
SESSION_SECRET="{{ .SESSION_SECRET }}"
CORS_ORIGIN="{{ .CORS_ORIGIN }}"

# Orchestration Mode
ORCHESTRATION_MODE="dual"
PRIMARY_ORCHESTRATOR="claude-flow"
ENABLE_SWARM_COORDINATION=true