# ==============================================================================
# WORKER - PC4 (RTX 3090 Ti - 24GB VRAM)
# Claude Flow V3 Alpha - Secondary GPU Worker
# Role: Analysis, mid-size models, backup compute
# ==============================================================================

# ==============================================================================
# CORE CONFIGURATION
# ==============================================================================
NODE_ENV=production
CLAUDE_FLOW_MODE=worker
CLAUDE_FLOW_VERSION=3.0.0-alpha.104
CLAUDE_FLOW_DEBUG=false
CLAUDE_FLOW_LOG_LEVEL=info

# ==============================================================================
# WORKER ROLE
# ==============================================================================
CLAUDE_FLOW_MAX_AGENTS=8
CLAUDE_FLOW_MAX_CONCURRENT_TASKS=6
CLAUDE_FLOW_WORKER_THREADS=10
CLAUDE_FLOW_MEMORY_LIMIT=6144
CLAUDE_FLOW_CACHE_SIZE=1536

# ==============================================================================
# SWARM WORKER CONFIGURATION
# ==============================================================================
SWARM_ROLE=worker
SWARM_WORKER_ID=worker-3090ti
SWARM_COORDINATOR_URL=http://orchestrator.tail-net.ts.net:7000
SWARM_WORKER_PORT=7890

# ==============================================================================
# GPU CONFIGURATION
# ==============================================================================
GPU_ENABLED=true
GPU_MODEL=RTX 3090 Ti
GPU_VRAM=24GB
GPU_CUDA_DEVICE=0
GPU_MAX_BATCH_SIZE=32
GPU_MAX_CONCURRENT=2
GPU_PRIORITY=2

# Local LLM (Ollama)
LOCAL_LLM_ENABLED=true
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODELS=llama3.1:70b-q4,mistral-large:123b-q4,mixtral:8x22b-q4

# ==============================================================================
# MEMORY CONFIGURATION (WORKER SUBSET)
# ==============================================================================
MEMORY_BACKEND=distributed
MEMORY_CACHE_ONLY=true
MEMORY_SYNC_INTERVAL=30

# RuVector Worker Node
RUVECTOR_ENABLED=true
RUVECTOR_MODE=worker
RUVECTOR_PORT=7890
RUVECTOR_COORDINATOR=orchestrator.tail-net.ts.net:7000

# AgentDB (read-only sync)
AGENTDB_ENABLED=true
AGENTDB_PATH=.agentdb/worker-3090ti.db
AGENTDB_SYNC_FROM=orchestrator.tail-net.ts.net:7000
AGENTDB_READ_ONLY=false

# ==============================================================================
# NETWORKING
# ==============================================================================
PC_NAME=worker-rtx3090ti
PC_ROLE=worker
LAN_IP=TO_BE_COLLECTED
WAN_IP=TO_BE_SET
TAILSCALE_ENABLED=true
TAILSCALE_HOSTNAME=worker-3090ti
TAILSCALE_IP=TO_BE_COLLECTED
MAC_ETHERNET=TO_BE_COLLECTED
MAC_WIFI=TO_BE_COLLECTED

# ==============================================================================
# MINIMAL API KEYS (FALLBACK ONLY)
# ==============================================================================
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
GOOGLE_API_KEY=${GOOGLE_API_KEY}

MODEL_ROUTING_PREFER_LOCAL=true
MODEL_ROUTING_FALLBACK_CLOUD=true

# ==============================================================================
# PERFORMANCE OPTIMIZATION
# ==============================================================================
NEURAL_OPTIMIZATION_ENABLED=true
NEURAL_FLASH_ATTENTION=true
NEURAL_QUANTIZATION=int4
NEURAL_BATCH_SIZE=32

GPU_MEMORY_FRACTION=0.90
GPU_ALLOW_GROWTH=true

# ==============================================================================
# MONITORING
# ==============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9092
PROMETHEUS_PUSH_GATEWAY=orchestrator.tail-net.ts.net:9090

# ==============================================================================
# REDUCED SECURITY
# ==============================================================================
AIDEFENCE_ENABLED=false
RATE_LIMITING_ENABLED=false

# ==============================================================================
# WORKER-SPECIFIC FEATURES
# ==============================================================================
WORKER_SPECIALIZATION=analysis
WORKER_CAPABILITIES=llama3.1-70b,mistral-large,mixtral-8x22b
