# Worker Environment Variables
# Copy this file to .env and fill in your values

# Worker Identification
WORKER_ID=1
WORKER_NAME=worker-1

# Ollama Configuration
OLLAMA_NUM_PARALLEL=4
OLLAMA_MAX_LOADED_MODELS=3
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_HOST=0.0.0.0:11434
OLLAMA_ORIGINS=*

# vLLM Configuration (optional)
VLLM_MODEL=meta-llama/Llama-2-7b-chat-hf
VLLM_TENSOR_PARALLEL=1
VLLM_GPU_MEMORY=0.9
VLLM_MAX_MODEL_LEN=4096
HUGGINGFACE_TOKEN=your_huggingface_token_here

# NVIDIA Configuration
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Redis Configuration
REDIS_PASSWORD=change_this_redis_password

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password
GRAFANA_ROOT_URL=http://localhost:3001

# Orchestrator Connection
ORCHESTRATOR_IP=192.168.1.100
ORCHESTRATOR_PROMETHEUS_URL=http://192.168.1.100:9090

# GPU Settings
GPU_MEMORY_FRACTION=0.9
GPU_COMPUTE_MODE=0  # 0=Default, 1=Exclusive, 2=Prohibited

# Monitoring
PROMETHEUS_RETENTION=15d
METRICS_PORT=9835

# Performance Tuning
MAX_BATCH_SIZE=512
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=300

# Cache Settings
CACHE_SIZE_GB=10
CACHE_TTL=3600
