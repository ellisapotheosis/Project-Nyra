# Orchestrator Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL Configuration
POSTGRES_DB=orchestrator
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_this_password_in_production

# Redis Configuration
REDIS_PASSWORD=change_this_redis_password

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_this_minio_password

# Open-WebUI Configuration
OLLAMA_BASE_URL=http://worker-1:11434
WEBUI_SECRET_KEY=generate_random_secret_key_here
ENABLE_SIGNUP=false
DEFAULT_USER_ROLE=user

# LobeChat Configuration
OPENAI_API_KEY=your_openai_api_key_or_leave_empty
KEY_VAULTS_SECRET=generate_random_secret_key_here

# Infisical Configuration
INFISICAL_ENCRYPTION_KEY=generate_32_char_encryption_key
INFISICAL_JWT_SECRET=generate_random_jwt_secret
INFISICAL_SITE_URL=http://localhost:8080

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password
GRAFANA_ROOT_URL=http://localhost:3001

# Network Configuration
WORKER_1_IP=192.168.1.101
WORKER_2_IP=192.168.1.102
WORKER_3_IP=192.168.1.103

# Domain Configuration (for production)
DOMAIN=localhost

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM

# Monitoring Configuration
PROMETHEUS_RETENTION=30d
ALERTMANAGER_URL=http://alertmanager:9093

# Security
JWT_SECRET=generate_random_jwt_secret
API_KEY=generate_random_api_key

# Feature Flags
ENABLE_METRICS=true
ENABLE_LOGGING=true
ENABLE_TRACING=false
