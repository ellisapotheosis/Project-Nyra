# Backup Service Dockerfile

FROM alpine:latest

# Install required tools
RUN apk update && apk add --no-cache \
    postgresql16-client \
    aws-cli \
    bash \
    curl \
    gzip \
    tar \
    && rm -rf /var/cache/apk/*

# Create backup user
RUN addgroup -g 1001 -S backup && \
    adduser -S backup -u 1001

# Create directories
RUN mkdir -p /backups /scripts && \
    chown -R backup:backup /backups /scripts

WORKDIR /scripts

# Copy backup scripts
COPY scripts/backup-postgres.sh /scripts/backup-postgres.sh
COPY scripts/backup-minio.sh /scripts/backup-minio.sh
COPY scripts/backup-redis.sh /scripts/backup-redis.sh
COPY scripts/backup-scheduler.sh /scripts/backup-scheduler.sh

# Make scripts executable
RUN chmod +x /scripts/*.sh && \
    chown -R backup:backup /scripts

# Switch to backup user
USER backup

# Health check
HEALTHCHECK --interval=5m --timeout=30s --start-period=30s --retries=3 \
    CMD test -f /backups/last-backup-success || exit 1

# Run backup scheduler
CMD ["/scripts/backup-scheduler.sh"]
