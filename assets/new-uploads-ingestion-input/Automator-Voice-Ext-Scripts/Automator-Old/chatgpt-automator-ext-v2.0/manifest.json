{
  "manifest_version": 3,
  "name": "ChatGPT Automator + Tagger (NYRA)",
  "version": "2.0",
  "description": "Downloads, tagging, Notion CSV\u2192DB + typed picker, Linkwarden with duplicate check & tag\u2192collection mapping, SA/AZ hooks, HA/Voicemod, GitHub templates, Whisper WS VAD.",
  "permissions": [
    "storage",
    "activeTab",
    "downloads",
    "alarms",
    "notifications",
    "microphone"
  ],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://files.oaiusercontent.com/*",
    "https://api.notion.com/*",
    "https://api.github.com/*",
    "https://cloud.linkwarden.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}