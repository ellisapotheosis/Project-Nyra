# Gitea Environment Configuration
# Copy this file to .env and fill in the values

# Domain Configuration
GITEA_DOMAIN=gitea.orchestrator-mini.local

# PostgreSQL Configuration
POSTGRES_DB=gitea
POSTGRES_USER=gitea
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Gitea Security Keys (Generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here
INTERNAL_TOKEN=your_internal_token_here
LFS_JWT_SECRET=your_lfs_jwt_secret_here
OAUTH2_JWT_SECRET=your_oauth2_jwt_secret_here

# Gitea Actions Runner Token
# Generate this in Gitea UI: Settings -> Actions -> Runners -> Create New Runner
RUNNER_TOKEN=your_runner_token_here

# Registration Settings
DISABLE_REGISTRATION=true

# Admin User Configuration (for initial setup)
GITEA_ADMIN_USER=admin
GITEA_ADMIN_PASSWORD=your_secure_admin_password_here
GITEA_ADMIN_EMAIL=admin@orchestrator-mini.local

# GitHub Sync Configuration
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_ORG=your_github_org_or_username
SYNC_INTERVAL=*/30 * * * *  # Every 30 minutes

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/path/to/backup/storage
MINIO_ENDPOINT=http://minio.orchestrator-mini.local:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=gitea-backups

# Tailscale Configuration
TAILSCALE_HOSTNAME=orchestrator-mini

# SSL Configuration
SSL_ENABLED=true
SSL_CERT_EMAIL=admin@orchestrator-mini.local

# Monitoring
ENABLE_METRICS=false
METRICS_TOKEN=your_metrics_token_here
