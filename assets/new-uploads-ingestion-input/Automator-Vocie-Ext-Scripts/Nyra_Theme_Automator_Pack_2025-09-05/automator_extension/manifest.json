{
  "manifest_version": 3,
  "name": "Apotheosis Automator",
  "version": "0.1.0",
  "description": "Hotkeys and page actions for ChatGPT/OpenAI to speed up workflows.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Automate"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "quick-copy-last-answer": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Copy the last assistant answer to clipboard"
    },
    "toggle-compact-ui": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      },
      "description": "Toggle compact UI CSS class"
    }
  }
}