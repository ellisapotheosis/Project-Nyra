// Prisma Schema for Project Nyra - Mortgage Automation Platform
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER MANAGEMENT
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  role          UserRole  @default(USER)
  passwordHash  String
  emailVerified DateTime?
  image         String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  sessions      Session[]
  borrowers     Borrower[]
  loans         Loan[]     @relation("LoanOfficer")
  activities    Activity[]

  @@map("users")
}

enum UserRole {
  ADMIN
  LOAN_OFFICER
  PROCESSOR
  UNDERWRITER
  USER
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ============================================================================
// BORROWER & CONTACT MANAGEMENT
// ============================================================================

model Borrower {
  id              String    @id @default(cuid())
  firstName       String
  lastName        String
  email           String    @unique
  phone           String?
  ssn             String?   // Encrypted
  dateOfBirth     DateTime?
  address         String?
  city            String?
  state           String?
  zipCode         String?

  // Employment
  employer        String?
  occupation      String?
  monthlyIncome   Decimal?  @db.Decimal(12, 2)
  yearsEmployed   Int?

  // Credit
  creditScore     Int?

  // Metadata
  source          String?   // "web", "phone", "referral"
  status          BorrowerStatus @default(LEAD)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])
  loans           Loan[]
  documents       Document[]
  activities      Activity[]

  @@map("borrowers")
}

enum BorrowerStatus {
  LEAD
  QUALIFIED
  PRE_APPROVED
  APPROVED
  CLOSED
  LOST
}

// ============================================================================
// LOAN MANAGEMENT
// ============================================================================

model Loan {
  id              String    @id @default(cuid())
  loanNumber      String    @unique @default(cuid())

  // Borrower Info
  borrowerId      String
  borrower        Borrower  @relation(fields: [borrowerId], references: [id], onDelete: Cascade)

  // Loan Officer
  loanOfficerId   String
  loanOfficer     User      @relation("LoanOfficer", fields: [loanOfficerId], references: [id])

  // Loan Details
  loanType        LoanType
  loanPurpose     LoanPurpose
  loanAmount      Decimal   @db.Decimal(12, 2)
  downPayment     Decimal?  @db.Decimal(12, 2)
  interestRate    Decimal?  @db.Decimal(5, 3)
  loanTerm        Int?      // in months

  // Property
  propertyAddress String?
  propertyCity    String?
  propertyState   String?
  propertyZip     String?
  propertyValue   Decimal?  @db.Decimal(12, 2)

  // Status & Workflow
  status          LoanStatus @default(APPLICATION)
  stage           String?

  // Ratios
  dti             Decimal?  @db.Decimal(5, 2) // Debt-to-Income
  ltv             Decimal?  @db.Decimal(5, 2) // Loan-to-Value

  // Important Dates
  applicationDate DateTime  @default(now())
  approvalDate    DateTime?
  closingDate     DateTime?
  fundingDate     DateTime?

  // Metadata
  notes           String?   @db.Text

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  documents       Document[]
  quotes          Quote[]
  activities      Activity[]

  @@map("loans")
}

enum LoanType {
  CONVENTIONAL
  FHA
  VA
  USDA
  JUMBO
  HELOC
  REFINANCE
}

enum LoanPurpose {
  PURCHASE
  REFINANCE
  CASH_OUT
  DEBT_CONSOLIDATION
  HOME_IMPROVEMENT
}

enum LoanStatus {
  APPLICATION
  PROCESSING
  UNDERWRITING
  CONDITIONAL_APPROVAL
  CLEAR_TO_CLOSE
  CLOSED
  FUNDED
  DENIED
  WITHDRAWN
}

// ============================================================================
// QUOTES & RATES
// ============================================================================

model Quote {
  id              String    @id @default(cuid())
  loanId          String?
  loan            Loan?     @relation(fields: [loanId], references: [id], onDelete: Cascade)

  // Quote Details
  loanAmount      Decimal   @db.Decimal(12, 2)
  downPayment     Decimal   @db.Decimal(12, 2)
  creditScore     Int
  loanType        LoanType
  loanTerm        Int       // months

  // Rate Info
  interestRate    Decimal   @db.Decimal(5, 3)
  apr             Decimal   @db.Decimal(5, 3)
  monthlyPayment  Decimal   @db.Decimal(10, 2)

  // Costs
  closingCosts    Decimal?  @db.Decimal(10, 2)
  points          Decimal?  @db.Decimal(5, 3)

  // Provider
  lender          String?
  program         String?

  // Validity
  validUntil      DateTime

  createdAt       DateTime  @default(now())

  @@map("quotes")
}

// ============================================================================
// DOCUMENTS
// ============================================================================

model Document {
  id              String    @id @default(cuid())

  // Document Info
  name            String
  type            DocumentType
  category        String?

  // Storage
  fileUrl         String
  fileSize        Int?      // bytes
  mimeType        String?

  // AI Analysis
  extractedText   String?   @db.Text
  aiSummary       String?   @db.Text
  verificationStatus VerificationStatus @default(PENDING)

  // Relations
  borrowerId      String?
  borrower        Borrower? @relation(fields: [borrowerId], references: [id], onDelete: Cascade)

  loanId          String?
  loan            Loan?     @relation(fields: [loanId], references: [id], onDelete: Cascade)

  // Metadata
  uploadedBy      String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("documents")
}

enum DocumentType {
  PAYSTUB
  W2
  TAX_RETURN
  BANK_STATEMENT
  CREDIT_REPORT
  APPRAISAL
  TITLE
  INSURANCE
  PURCHASE_AGREEMENT
  DRIVERS_LICENSE
  OTHER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  NEEDS_REVIEW
}

// ============================================================================
// ACTIVITY & AUDIT
// ============================================================================

model Activity {
  id              String    @id @default(cuid())

  // Activity Details
  type            ActivityType
  action          String
  description     String?   @db.Text

  // Context
  entityType      String?   // "loan", "borrower", "document"
  entityId        String?

  // User
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  borrowerId      String?
  borrower        Borrower? @relation(fields: [borrowerId], references: [id], onDelete: SetNull)

  loanId          String?
  loan            Loan?     @relation(fields: [loanId], references: [id], onDelete: SetNull)

  // Metadata
  metadata        Json?

  createdAt       DateTime  @default(now())

  @@map("activities")
}

enum ActivityType {
  LOGIN
  LOGOUT
  LOAN_CREATED
  LOAN_UPDATED
  LOAN_APPROVED
  LOAN_DENIED
  DOCUMENT_UPLOADED
  DOCUMENT_VERIFIED
  EMAIL_SENT
  CALL_MADE
  NOTE_ADDED
  STATUS_CHANGED
}

// ============================================================================
// MEMORY & AI CONTEXT
// ============================================================================

model MemoryStore {
  id              String    @id @default(cuid())

  // Memory System
  system          MemorySystem

  // Content
  key             String
  content         Json
  embedding       Decimal[] // For vector storage

  // Context
  entityType      String?
  entityId        String?

  // TTL
  expiresAt       DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([system, key])
  @@map("memory_store")
}

enum MemorySystem {
  RUVECTOR
  LETTA
}

// ============================================================================
// AGENT ORCHESTRATION
// ============================================================================

model AgentExecution {
  id              String    @id @default(cuid())

  // Agent Info
  agentType       String
  agentId         String?

  // Task
  task            String    @db.Text
  status          ExecutionStatus @default(RUNNING)

  // Results
  result          Json?
  error           String?   @db.Text

  // Performance
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  duration        Int?      // milliseconds
  tokensUsed      Int?

  // Context
  loanId          String?
  borrowerId      String?

  @@map("agent_executions")
}

enum ExecutionStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}
