{
  "name": "Mortgage 45-Day Drip Campaign",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "start-campaign",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Campaign Start Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "campaign-start"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={\"status\": \"success\", \"campaign_id\": \"{{ $json.borrower_id }}\", \"message\": \"Campaign started\"}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "webhook-response",
