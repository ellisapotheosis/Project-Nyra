    {
      "parameters": {
        "operation": "create",
        "resource": "campaigns",
        "url": "={{ $env.POSTGRES_URL }}",
        "query": "INSERT INTO campaigns (borrower_id, campaign_type, status, current_day, total_days, started_at, next_action_at) VALUES ('{{ $json.body.borrower_id }}', '45_day_drip', 'active', 0, 45, NOW(), NOW()) RETURNING id"
      },
      "id": "create-campaign-record",
      "name": "Create Campaign Record",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [650, 300],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "PostgreSQL account"
        }
      }
    },
    {
      "parameters": {
        "operation": "get",
        "resource": "borrowers",
        "url": "={{ $env.POSTGRES_URL }}",
        "query": "SELECT * FROM borrowers WHERE id = '{{ $json.body.borrower_id }}'"
      },
      "id": "get-borrower-data",
      "name": "Get Borrower Data",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "operation": "get",
        "resource": "quotes",
        "url": "={{ $env.POSTGRES_URL }}",
        "query": "SELECT * FROM quotes WHERE borrower_id = '{{ $json.body.borrower_id }}' ORDER BY created_at DESC LIMIT 1"
      },
      "id": "get-latest-quote",
      "name": "Get Latest Quote",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM_EMAIL }}",
        "toEmail": "={{ $json.email }}",
        "subject": "Welcome to RateHunter - Your Mortgage Journey Starts Here",
        "emailType": "html",
        "message": "<html><body><h2>Hi {{ $json.first_name }},</h2><p>Thank you for choosing RateHunter for your mortgage needs. We're excited to help you find the best rates.</p><p><strong>Your Personalized Quote:</strong></p><ul><li>Loan Amount: ${{ $json.loan_amount }}</li><li>Interest Rate: {{ $json.interest_rate }}%</li><li>Monthly Payment: ${{ $json.monthly_payment }}</li></ul><p><strong>Next Steps:</strong></p><ol><li>Review your quote details</li><li>Submit your full application</li><li>Get pre-approved within 24 hours</li></ol><p>Questions? Reply to this email or call us at {{ $env.TWILIO_PHONE_NUMBER }}</p><p>Best regards,<br>The RateHunter Team</p></body></html>"
      },
      "id": "day-0-welcome-email",
      "name": "Day 0 - Welcome Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1250, 300],
      "credentials": {
        "smtp": {
          "id": "1",
          "name": "SMTP account"
        }
      }
    },
    {
      "parameters": {
        "operation": "create",
