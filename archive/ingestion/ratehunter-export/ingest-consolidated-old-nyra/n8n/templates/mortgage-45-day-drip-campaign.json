    {
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM_EMAIL }}",
        "toEmail": "={{ $json.email }}",
        "subject": "Understanding Mortgage Rates - Your Guide",
        "emailType": "html",
        "message": "<html><body><h2>Hi {{ $json.first_name }},</h2><p>Want to understand what affects your mortgage rate? Here's a quick guide:</p><h3>Factors That Impact Your Rate:</h3><ul><li><strong>Credit Score:</strong> Higher scores mean lower rates</li><li><strong>Down Payment:</strong> 20%+ avoids PMI</li><li><strong>Loan Term:</strong> 15-year loans have lower rates</li><li><strong>Property Type:</strong> Single-family homes get best rates</li></ul><p><strong>Your Current Rate: {{ $json.interest_rate }}%</strong></p><p>Based on your profile, you're getting an excellent rate! Lock it in before rates change.</p><p><a href=\"{{ $env.SUBDOMAIN_NYRA }}/apply\" style=\"background-color: #007bff; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; display: inline-block;\">Complete Your Application</a></p><p>Best regards,<br>The RateHunter Team</p></body></html>"
      },
