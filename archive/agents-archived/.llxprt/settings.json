{
  "contextFileName": [
    "AGENTS.md",
    "LLXPRT.md",
    "CONTEXT.md",
    "INSTRUCTIONS.md"
  ],
  "checkpointing": {
    "enabled": true
  },
  "lsp": true,
  "subagents": {
    "asyncEnabled": true,
    "maxAsync": 6
  },
  "summarizeToolOutput": {
    "run_shell_command": {
      "tokenBudget": 2000
    }
  },
  "excludedProjectEnvVars": [
    "DEBUG",
    "DEBUG_MODE",
    "NODE_ENV"
  ],
  "fileFiltering": {
    "respectGitIgnore": true
  },
  "mcpServers": {
    "nyra-nexus": {
      "httpUrl": "https://nexus.trex-fiordland.ts.net/mcp",
      "trust": true,
      "timeout": 30000
    }
  },
  "includeDirectories": [
    "."
  ],
  "loadMemoryFromIncludeDirectories": true
}
