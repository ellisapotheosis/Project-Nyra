{
  "version": "1.0.0",
  "router": {
    "name": "nexus-router",
    "port": 6000,
    "logLevel": "debug",
    "requestTimeout": 30000,
    "enableMetrics": true,
    "enableIntelligentRouting": true
  },
  "intelligentRouting": {
    "enabled": true,
    "costOptimization": {
      "enabled": true,
      "strategy": "cost-first",
      "fallbackStrategy": "latency",
      "costThresholds": {
        "high": 0.015,
        "medium": 0.005,
        "low": 0.001
      }
    },
    "fuzzyToolFind": {
      "enabled": true,
      "threshold": 0.75,
      "algorithm": "jaro-winkler",
      "cache": {
        "enabled": true,
        "ttl": 3600
      }
    },
    "modelRouting": {
      "enabled": true,
      "tiers": [
        {
          "name": "tier1-agent-booster",
          "models": ["agent-booster"],
          "cost": 0.0,
          "latency": "<1ms",
          "context": "simple-transforms",
          "useWhen": ["var-to-const", "add-types", "simple-refactor"]
        },
        {
          "name": "tier2-haiku",
          "models": ["claude-haiku-4-5-20251001"],
          "cost": 0.0002,
          "latency": "~500ms",
          "context": "task-level",
          "useWhen": ["bug-fixes", "simple-tasks", "documentation"]
        },
        {
          "name": "tier3-sonnet",
          "models": ["claude-sonnet-4-20250514"],
          "cost": 0.003,
          "latency": "~2-3s",
          "context": "full-analysis",
          "useWhen": ["architecture", "complex-refactor", "security-review"]
        },
        {
          "name": "tier4-opus",
          "models": ["claude-opus-4.5-20251101"],
          "cost": 0.015,
          "latency": "~5s",
          "context": "comprehensive",
          "useWhen": ["high-stakes", "compliance", "critical-security"]
        },
        {
          "name": "tier5-specialized",
          "models": ["deepseek-r1", "qwen-2.5-72b"],
          "cost": 0.00014,
          "latency": "~1-2s",
          "context": "specialized-reasoning",
          "useWhen": ["reasoning-heavy", "math", "local-available"]
        }
      ],
      "defaultRouting": "cost-first",
      "costSavingTarget": 0.95,
      "fallbackChain": ["tier2", "tier3", "tier4"]
    },
    "requestClassification": {
      "enabled": true,
      "headers": ["X-Model-Preference", "X-Cost-Constraint", "X-Latency-Requirement"],
      "keywords": {
        "simple": ["typo", "var-const", "add-types", "quick"],
        "medium": ["bug", "fix", "refactor", "test"],
        "complex": ["architecture", "security", "design", "compliance"],
        "reasoning": ["analyze", "think", "reason", "evaluate"]
      }
    },
    "rateLimiting": {
      "enabled": true,
      "strategies": {
        "cost-based": {
          "enabled": true,
          "budget": 10.0,
          "period": 3600,
          "action": "queue-or-downgrade"
        },
        "per-user": {
          "enabled": true,
          "ratePerMinute": 60,
          "action": "backpressure"
        },
        "per-model": {
          "enabled": true,
          "distribution": {
            "haiku": 0.6,
            "sonnet": 0.3,
            "opus": 0.1
          }
        }
      }
    }
  },
  "services": [
    {
      "name": "claude-flow-mcp",
      "type": "grpc",
      "address": "localhost:3001",
      "priority": 1,
      "healthCheck": {
        "enabled": true,
        "interval": 30000,
        "timeout": 5000,
        "path": "/health"
      },
      "routes": [
        {
          "path": "/claude-flow/*",
          "methods": ["GET", "POST", "PUT", "DELETE"],
          "modelRouting": "cost-first"
        }
      ],
      "fallback": {
        "enabled": true,
        "strategy": "retry-with-backoff"
      }
    },
    {
      "name": "graphiti-mcp",
      "type": "grpc",
      "address": "localhost:3002",
      "priority": 2,
      "healthCheck": {
        "enabled": true,
        "interval": 30000,
        "timeout": 5000,
        "path": "/health"
      },
      "routes": [
        {
          "path": "/graphiti/*",
          "methods": ["GET", "POST"],
          "modelRouting": "cost-first"
        }
      ]
    },
    {
      "name": "ruvector",
      "type": "http",
      "address": "localhost:7070",
      "priority": 1,
      "healthCheck": {
        "enabled": true,
        "interval": 30000,
        "timeout": 5000,
        "path": "/health"
      },
      "routes": [
        {
          "path": "/search/*",
          "methods": ["POST"],
          "rateLimit": "high"
        },
        {
          "path": "/index/*",
          "methods": ["POST"],
          "rateLimit": "medium"
        }
      ]
    }
  ],
  "loadBalancing": {
    "strategy": "intelligent",
    "algorithms": {
      "roundRobin": { "weight": 0.1 },
      "leastConnections": { "weight": 0.2 },
      "costOptimized": { "weight": 0.6 },
      "latencyOptimized": { "weight": 0.1 }
    },
    "healthCheckInterval": 30000,
    "failoverDelay": 1000
  },
  "caching": {
    "enabled": true,
    "strategy": "intelligent",
    "backends": {
      "redis": {
        "enabled": true,
        "host": "localhost",
        "port": 6379,
        "ttl": 3600,
        "keyPattern": "nexus:cache:{operation}:{hash}"
      },
      "memory": {
        "enabled": true,
        "maxSize": 100,
        "ttl": 300
      }
    },
    "cacheRules": [
      {
        "path": "/memory/search/*",
        "ttl": 1800,
        "keyPattern": "search:{query}:{limit}"
      },
      {
        "path": "/mcp/list/*",
        "ttl": 600,
        "keyPattern": "mcp:list"
      },
      {
        "path": "/providers/available",
        "ttl": 300,
        "keyPattern": "providers:available"
      }
    ]
  },
  "monitoring": {
    "enabled": true,
    "metrics": {
      "prometheus": {
        "enabled": true,
        "port": 9090,
        "path": "/metrics"
      }
    },
    "tracing": {
      "enabled": true,
      "samplingRate": 0.1,
      "backends": ["console"]
    },
    "logging": {
      "level": "debug",
      "format": "json",
      "destinations": ["console", "file"]
    }
  },
  "security": {
    "requireAuth": false,
    "corsEnabled": true,
    "allowedOrigins": ["localhost:*", "127.0.0.1:*"],
    "rateLimiting": {
      "enabled": true,
      "window": 60000,
      "maxRequests": 1000
    },
    "requestValidation": {
      "enabled": true,
      "validateHeaders": true,
      "validatePayload": true
    }
  },
  "providers": {
    "llm": {
      "primaryProvider": "anthropic",
      "fallbackChain": ["openrouter", "local"],
      "costOptimization": true,
      "modelMapping": {
        "simple": "haiku",
        "medium": "sonnet",
        "complex": "opus",
        "reasoning": "deepseek-r1"
      }
    }
  },
  "fuzzyMatching": {
    "enabled": true,
    "operations": {
      "toolFind": {
        "enabled": true,
        "algorithm": "jaro-winkler",
        "threshold": 0.75,
        "maxResults": 5
      },
      "operationFind": {
        "enabled": true,
        "algorithm": "jaro-winkler",
        "threshold": 0.8,
        "maxResults": 3
      }
    },
    "cache": {
      "enabled": true,
      "backend": "redis",
      "ttl": 3600
    }
  },
  "optimization": {
    "requestAggregation": {
      "enabled": true,
      "windowMs": 50,
      "maxRequests": 5
    },
    "responseCompression": {
      "enabled": true,
      "algorithm": "gzip",
      "threshold": 1024
    },
    "connectionPooling": {
      "enabled": true,
      "poolSize": 20,
      "idleTimeout": 30000
    }
  },
  "costTracking": {
    "enabled": true,
    "granularity": "per-operation",
    "reporting": {
      "interval": 3600000,
      "destination": "console"
    },
    "budgetAlerts": {
      "enabled": true,
      "thresholds": [0.5, 0.75, 0.9, 1.0],
      "action": "log-or-throttle"
    }
  }
}
