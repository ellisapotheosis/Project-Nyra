# Orchestrator environment (copy to .env)
#
# NOTE: keep secrets out of Git. This file is safe as an example.

# -----------------------------
# Core secrets (REQUIRED)
# -----------------------------
POSTGRES_PASSWORD=change_me
REDIS_PASSWORD=change_me
MONGO_ROOT_PASSWORD=change_me

# Grafana
GRAFANA_ADMIN_PASSWORD=change_me

# pgAdmin (optional)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me
PGADMIN_PORT=5050

# Infisical (optional; enable compose profile "secrets")
INFISICAL_DB_PASSWORD=change_me
INFISICAL_PORT=8085

# -----------------------------
# Nexus + LiteLLM auth (REQUIRED)
# -----------------------------
LITELLM_MASTER_KEY=dev-litellm-master-key
NEXUS_JWT_SECRET=dev-nexus-jwt-secret
NEXUS_ADMIN_TOKEN=dev-nexus-admin-token

# -----------------------------
# Provider keys (OPTIONAL)
# -----------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# MCP server tokens (OPTIONAL)
GITHUB_TOKEN=
N8N_API_KEY=
TWENTY_API_KEY=

# -----------------------------
# Twenty CRM (enable if you run Twenty)
# -----------------------------
TWENTY_PG_USER=twenty
TWENTY_PG_PASSWORD=change_me
TWENTY_PG_DB=default
TWENTY_APP_SECRET=replace_me_with_a_random_string

# -----------------------------
# Ports (OPTIONAL)
# -----------------------------
NEXUS_PORT=8000
LITELLM_PORT=4000
N8N_PORT=5678
ACTIVEPIECES_PORT=8082
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090

# -----------------------------
# Hostnames (MagicDNS)
# -----------------------------
N8N_HOST=orchestrator.trex-fiordland.ts.net
N8N_PROTOCOL=http

# -----------------------------
# Docker Desktop WSL2 networking
# -----------------------------
DOCKER_SUBNET=172.20.0.0/16

TIMEZONE=America/New_York
