# ==============================================================================
# PRODUCTION ENVIRONMENT - CLAUDE FLOW V3
# Claude Flow V3 Alpha - Production Configuration
# Use: Live deployment, production workloads
# ==============================================================================

# ==============================================================================
# CORE CONFIGURATION
# ==============================================================================
NODE_ENV=production
CLAUDE_FLOW_MODE=production
CLAUDE_FLOW_DEBUG=false
CLAUDE_FLOW_LOG_LEVEL=warn
CLAUDE_FLOW_VERBOSE=false

# ==============================================================================
# PRODUCTION SCALE
# ==============================================================================
CLAUDE_FLOW_MAX_AGENTS=35
CLAUDE_FLOW_MAX_CONCURRENT_TASKS=25
CLAUDE_FLOW_WORKER_THREADS=12
CLAUDE_FLOW_MEMORY_LIMIT=4096
CLAUDE_FLOW_CACHE_SIZE=1024

# ==============================================================================
# PRODUCTION FEATURES
# ==============================================================================
CLAUDE_FLOW_AUTO_COMMIT=true
CLAUDE_FLOW_AUTO_PUSH=false
CLAUDE_FLOW_CHECKPOINTS_ENABLED=true
CLAUDE_FLOW_TELEMETRY_ENABLED=true
CLAUDE_FLOW_SECURITY_AUDIT=true
CLAUDE_FLOW_VERIFY_MODE=strict

# ==============================================================================
# PRODUCTION DATABASES
# ==============================================================================
DATABASE_URL=postgresql://nyra:${POSTGRES_PASSWORD}@postgres.ratehunter.net:5432/nyra_production
DATABASE_POOL_MIN=10
DATABASE_POOL_MAX=50
DATABASE_SSL=true

REDIS_URL=redis://:${REDIS_PASSWORD}@redis.ratehunter.net:6379/0
REDIS_MAX_CONNECTIONS=100

# ==============================================================================
# PRODUCTION MEMORY SYSTEMS
# ==============================================================================
MEMORY_BACKEND=hybrid
MEMORY_PRIMARY_STORE=letta
MEMORY_SECONDARY_STORE=mem0
MEMORY_ENABLE_HNSW=true
MEMORY_COMPRESSION=true
MEMORY_ENCRYPTION=true
MEMORY_BACKUP_TO_GITHUB=true

# ==============================================================================
# STRICT SECURITY
# ==============================================================================
JWT_SECRET=${JWT_SECRET}
ENCRYPTION_KEY=${ENCRYPTION_KEY}
SESSION_SECRET=${SESSION_SECRET}
ENCRYPTION_ALGORITHM=aes-256-gcm
SESSION_SECURE=true

# AI Defense
AIDEFENCE_ENABLED=true
AIDEFENCE_MONITOR_INPUTS=true
AIDEFENCE_MONITOR_OUTPUTS=true
AIDEFENCE_BLOCK_SUSPICIOUS=true

# Rate Limiting
RATE_LIMITING_ENABLED=true
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
HELMET_ENABLED=true

# CORS
CORS_ORIGIN=https://ratehunter.net
CORS_ALLOWED_ORIGINS=https://ratehunter.net,https://app.ratehunter.net,https://api.ratehunter.net
CORS_ALLOW_CREDENTIALS=true

# ==============================================================================
# API KEYS (PRODUCTION TIER)
# ==============================================================================
# Load from Infisical in production
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
GOOGLE_API_KEY=${GOOGLE_API_KEY}
OPENROUTER_API_KEY=${OPENROUTER_API_KEY}

# Production models
COMPLETION_MODEL=claude-sonnet-4-5-20250929
PROVIDER=anthropic
MODEL_ROUTING_STRATEGY=cost-optimized

# ==============================================================================
# DISTRIBUTED GPU WORKERS
# ==============================================================================
LOCAL_LLM_ENABLED=true
LOCAL_LLM_PRIORITY=true
GPU_WORKER_5090_URL=http://worker-5090.tail-net.ts.net:11434
GPU_WORKER_3090_URL=http://worker-3090.tail-net.ts.net:11434
GPU_WORKER_3060_URL=http://worker-3060.tail-net.ts.net:11434

# ==============================================================================
# COMPREHENSIVE MONITORING
# ==============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d

GRAFANA_ENABLED=true
GRAFANA_PORT=3002
GRAFANA_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}

LOKI_ENABLED=true
LOKI_PORT=3100

SENTRY_ENABLED=true
SENTRY_DSN=${SENTRY_DSN}
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ==============================================================================
# PRODUCTION LOGGING
# ==============================================================================
LOG_FORMAT=json
LOG_LEVEL=warn
LOG_FILE_PATH=/var/log/claude-flow/production.log
LOG_MAX_SIZE=500MB
LOG_MAX_FILES=30
LOG_RETENTION_DAYS=90

AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=2555

# ==============================================================================
# NETWORKING (PRODUCTION)
# ==============================================================================
TAILSCALE_ENABLED=true
CLOUDFLARE_TUNNEL_ENABLED=true

# ==============================================================================
# SECRETS MANAGEMENT (INFISICAL)
# ==============================================================================
INFISICAL_ENABLED=true
INFISICAL_PROJECT_ID=${INFISICAL_PROJECT_ID}
INFISICAL_ENVIRONMENT=production
INFISICAL_PATH=/shared

# ==============================================================================
# COMPLIANCE
# ==============================================================================
TRID_ENABLED=true
DATA_ENCRYPTION_AT_REST=true
DATA_ENCRYPTION_IN_TRANSIT=true
PII_MASKING_ENABLED=true

# ==============================================================================
# PERFORMANCE OPTIMIZATION
# ==============================================================================
NODE_OPTIONS=--max-old-space-size=8192 --max-http-header-size=32768
NEURAL_OPTIMIZATION_ENABLED=true
NEURAL_FLASH_ATTENTION=true
NEURAL_QUANTIZATION=int8

# ==============================================================================
# PRODUCTION TIMEOUTS
# ==============================================================================
REQUEST_TIMEOUT=60000
CACHE_TTL=3600
MEMORY_SYNC_INTERVAL=60
CHECKPOINT_INTERVAL=300
