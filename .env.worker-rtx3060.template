# Project Nyra - RTX 3060 Worker Node Configuration Template
# Copy from .env.template and customize for worker role

# Node Configuration
NYRA_NODE_TYPE=worker-rtx3060
NYRA_ENVIRONMENT=production
NYRA_NODE_ID=worker-rtx3060-01
COMPOSE_PROFILES=worker,gpu

# Network Configuration (connect to orchestrator)
ORCHESTRATOR_IP=10.0.0.1
POSTGRES_HOST=10.0.0.1
REDIS_HOST=10.0.0.1

# GPU Configuration
NVIDIA_VISIBLE_DEVICES=0
CUDA_VISIBLE_DEVICES=0
ENABLE_GPU_WORKERS=true

# Local LLM Configuration
OLLAMA_ENABLED=true
OLLAMA_PORT=11434
OLLAMA_MODELS=llama3.1:8b,codellama:13b

# Service roles
ARCHON_MODE=worker
CLAUDE_FLOW_MODE=worker
CLAUDE_FLOW_MASTER_URL=http://10.0.0.1:3010

# Worker-specific ports (to avoid conflicts)
WORKER_API_PORT=8001
WORKER_METRICS_PORT=9001

# Resource allocation for RTX 3060 (12GB VRAM)
GPU_MEMORY_FRACTION=0.8
MAX_CONCURRENT_JOBS=2
BATCH_SIZE=8

# Disable services not needed on worker
ENABLE_MONITORING=false
ENABLE_CRM=false
ENABLE_WORKFLOWS=false

# Performance optimization for RTX 3060
OLLAMA_NUM_GPU_LAYERS=35
OLLAMA_CONTEXT_SIZE=4096
TORCH_BACKENDS_CUDNN_ENABLED=true