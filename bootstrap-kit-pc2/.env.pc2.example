# Project Nyra - PC2 GPU Worker 1 Environment Variables
# Copy this file to .env.pc2 and fill in your actual values

# ============================================================================
# LLM PROVIDER API KEYS
# ============================================================================

# Anthropic Claude API (Primary)
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# OpenRouter API (Cost-efficient fallback)
OPENROUTER_API_KEY=sk-or-YOUR_KEY_HERE

# ============================================================================
# DATABASE PASSWORDS
# ============================================================================

# Letta PostgreSQL
LETTA_POSTGRES_PASSWORD=letta_secure_password_change_me

# Dify PostgreSQL
DIFY_POSTGRES_PASSWORD=dify_secure_password_change_me

# Dify Secret Key
DIFY_SECRET_KEY=dify-secret-key-please-change-me-to-random-string

# ============================================================================
# RUVECTOR CONFIGURATION
# ============================================================================

# Cluster Configuration
RUVECTOR_NODE_ID=leader
RUVECTOR_NODE_IP=10.0.0.2
RUVECTOR_CLUSTER_ID=nyra-cluster

# Peer Nodes (PC3 and PC4)
RUVECTOR_PEERS=10.0.0.3:6370,10.0.0.4:6370

# Performance Tuning
RUVECTOR_GNN_ENABLED=true
RUVECTOR_HNSW_ENABLED=true
RUVECTOR_HNSW_M=16
RUVECTOR_HNSW_EF_CONSTRUCTION=200
RUVECTOR_QUANTIZATION=scalar

# ============================================================================
# OLLAMA CONFIGURATION
# ============================================================================

OLLAMA_HOST=0.0.0.0:11434
OLLAMA_ORIGINS=*
OLLAMA_NUM_PARALLEL=4
OLLAMA_MAX_LOADED_MODELS=3

# Models to pull on first run (comma-separated)
OLLAMA_MODELS=llama3.1:70b,mistral:7b,codellama:34b

# ============================================================================
# LETTA CONFIGURATION
# ============================================================================

LETTA_SERVER_PORT=8283
LETTA_SERVER_HOST=0.0.0.0
LETTA_CORS_ORIGINS=*

# ============================================================================
# MEM0 CONFIGURATION
# ============================================================================

MEM0_API_PORT=4321
MEM0_DB_PATH=/app/data/mem0.db
MEM0_VECTOR_STORE=ruvector
RUVECTOR_URL=http://ruvector:6370

# ============================================================================
# DIFY CONFIGURATION
# ============================================================================

DIFY_MODE=api
DIFY_LOG_LEVEL=INFO

# ============================================================================
# NETWORKING
# ============================================================================

# Local Network Configuration
PC1_IP=10.0.0.1
PC2_IP=10.0.0.2
PC3_IP=10.0.0.3
PC4_IP=10.0.0.4

# Tailscale VPN
TAILSCALE_AUTH_KEY=tskey-YOUR_KEY_HERE
TAILSCALE_HOSTNAME=nyra-gpu-worker-1

# ============================================================================
# SYSTEM CONFIGURATION
# ============================================================================

# Node Environment
NODE_ENV=production

# Timezone
TZ=America/Los_Angeles

# GPU Configuration
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ============================================================================
# NOTES
# ============================================================================
# 1. Never commit .env.pc2 to version control
# 2. Update all passwords before deploying to production
# 3. Ensure GPU drivers are installed (NVIDIA 535+ recommended)
# 4. This PC requires at least 32GB RAM and 1 high-end GPU
# 5. Ruvector will automatically sync with PC3 and PC4 via Raft consensus
