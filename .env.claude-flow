# Claude Flow V3 Environment Configuration for Project Nyra

# Claude Flow Mode
CLAUDE_FLOW_MODE=v3
CLAUDE_FLOW_VERSION=3.0.0-alpha.71

# Swarm Configuration
CLAUDE_FLOW_TOPOLOGY=hierarchical-mesh
CLAUDE_FLOW_MAX_AGENTS=15
CLAUDE_FLOW_COORDINATION_STRATEGY=priority-based

# Memory Configuration
CLAUDE_FLOW_MEMORY_BACKEND=hybrid
CLAUDE_FLOW_ENABLE_HNSW=true
CLAUDE_FLOW_MEMORY_CACHE=true

# Hooks Configuration
CLAUDE_FLOW_HOOKS_ENABLED=true
CLAUDE_FLOW_HOOKS_TIMEOUT=5000

# Daemon Configuration
CLAUDE_FLOW_DAEMON_AUTO_START=true
CLAUDE_FLOW_DAEMON_WORKERS=map,audit,optimize,consolidate,testgaps,ultralearn,deepdive,document,refactor,benchmark

# Learning Configuration
CLAUDE_FLOW_LEARNING_ENABLED=true
CLAUDE_FLOW_LEARNING_AUTO_TRAIN=true
CLAUDE_FLOW_LEARNING_PATTERNS=coordination,optimization,prediction

# ADR Configuration
CLAUDE_FLOW_ADR_AUTO_GENERATE=true
CLAUDE_FLOW_ADR_DIRECTORY=/docs/adr
CLAUDE_FLOW_ADR_TEMPLATE=madr

# DDD Configuration
CLAUDE_FLOW_DDD_TRACK_DOMAINS=true
CLAUDE_FLOW_DDD_VALIDATE_CONTEXTS=true
CLAUDE_FLOW_DDD_DIRECTORY=/docs/ddd

# Security Configuration
CLAUDE_FLOW_SECURITY_AUTO_SCAN=true
CLAUDE_FLOW_SECURITY_SCAN_ON_EDIT=true
CLAUDE_FLOW_SECURITY_CVE_CHECK=true
CLAUDE_FLOW_SECURITY_THREAT_MODEL=true

# Integration Endpoints
NEXUS_ROUTER_URL=http://localhost:6000
LETTA_URL=http://localhost:8283
MEM0_URL=http://localhost:4321
TWENTYCRM_URL=http://localhost:3000
N8N_URL=http://localhost:5678
DIFY_URL=http://localhost:3001

# Observability
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3005
LOKI_URL=http://localhost:3100

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_OUTPUT=stdout

# LLM Provider Configuration (via Nexus Router)
# These should be set in your main .env file
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_API_KEY=

# Infisical Secrets Management
# PROJECT_ID=8374cea9-e5e8-4050-bda4-b91f25ab30ef
