# ==============================================================================
# CLAUDE FLOW V3 ALPHA - COMPREHENSIVE ENVIRONMENT CONFIGURATION
# Project Nyra - Multi-Agent AI Development Stack
# Generated: 2026-01-18
# ==============================================================================

# ==============================================================================
# CORE CLAUDE FLOW CONFIGURATION
# ==============================================================================
NODE_ENV=development
CLAUDE_FLOW_MODE=v3
CLAUDE_FLOW_VERSION=3.0.0-alpha.104
CLAUDE_FLOW_DEBUG=true
CLAUDE_FLOW_LOG_LEVEL=info
CLAUDE_FLOW_DATA_DIR=./.claude-flow/data
CLAUDE_FLOW_MEMORY_DIR=./.claude-flow/memory
CLAUDE_FLOW_CONFIG_DIR=./.claude-flow/config

# ==============================================================================
# FEATURE FLAGS (V3 ALPHA)
# ==============================================================================
CLAUDE_FLOW_ENABLED=true
CLAUDE_FLOW_AUTO_COMMIT=true
CLAUDE_FLOW_AUTO_PUSH=false
CLAUDE_FLOW_HOOKS_ENABLED=true
CLAUDE_FLOW_TELEMETRY_ENABLED=true
CLAUDE_FLOW_REMOTE_EXECUTION=true
CLAUDE_FLOW_GITHUB_INTEGRATION=true
CLAUDE_FLOW_CHECKPOINTS_ENABLED=true
CLAUDE_FLOW_MEMORY_PERSISTENCE=true
CLAUDE_FLOW_NEURAL_OPTIMIZATION=true
CLAUDE_FLOW_AUTO_LEARNING=true
CLAUDE_FLOW_PARALLEL_PROCESSING=true
CLAUDE_FLOW_PERFORMANCE_MODE=optimized
CLAUDE_FLOW_TRUTH_THRESHOLD=0.95
CLAUDE_FLOW_VERIFY_MODE=strict
CLAUDE_FLOW_SECURITY_AUDIT=true

# ==============================================================================
# MCP INTEGRATION
# ==============================================================================
CLAUDE_FLOW_MCP_MODE=advanced
FLOW_NEXUS_ENABLED=true
MCP_PROTOCOL_VERSION=2025-06-18

# ==============================================================================
# PORT CONFIGURATION
# ==============================================================================
# Claude Flow Dashboard: React web application
CLAUDE_FLOW_DASHBOARD_PORT=3003
# Event Server WebSocket: Real-time agent/task/memory events
EVENT_SERVER_WS_PORT=3004
# Event Server HTTP: Event ingestion from CLI commands
EVENT_SERVER_HTTP_PORT=3005
# MCP Server port
CLAUDE_FLOW_MCP_PORT=8003
# Dashboard event URLs
VITE_EVENT_SERVER_URL=ws://localhost:3004
VITE_EVENT_SERVER_HTTP_URL=http://localhost:3005

# ==============================================================================
# PERFORMANCE CONFIGURATION (OPTIMIZED FOR 35 AGENTS)
# ==============================================================================
CLAUDE_FLOW_MAX_AGENTS=35
CLAUDE_FLOW_MAX_CONCURRENT_TASKS=25
CLAUDE_FLOW_MEMORY_LIMIT=4096
CLAUDE_FLOW_CACHE_SIZE=1024
CLAUDE_FLOW_WORKER_THREADS=12
MAX_AGENTS=35

# ==============================================================================
# SWARM COORDINATION
# ==============================================================================
SWARM_TOPOLOGY=hierarchical-mesh
SWARM_COORDINATION_PROTOCOL=mesh
SWARM_MEMORY_SHARED=true
SWARM_NEURAL_SYNC=true
SWARM_MAX_AGENTS=35
SWARM_AUTO_SCALE=true

# ==============================================================================
# AGENTDB CONFIGURATION (V3 ALPHA - 150x-12,500x FASTER)
# ==============================================================================
AGENTDB_ENABLED=true
AGENTDB_PATH=.agentdb/claude-flow.db
AGENTDB_QUANTIZATION=scalar
AGENTDB_CACHE_SIZE=2000
AGENTDB_HNSW_M=16
AGENTDB_HNSW_EF=200
AGENTDB_HNSW_EF_SEARCH=100
AGENTDB_LEARNING=true
AGENTDB_LEARNING_ALGORITHM=decision-transformer
AGENTDB_REASONING=true
AGENTDB_QUIC_SYNC=false
AGENTDB_QUIC_PORT=4433
AGENTDB_AUTO_MIGRATE=true
AGENTDB_FALLBACK_LEGACY=true

# ==============================================================================
# REASONINGBANK CONFIGURATION (ADAPTIVE LEARNING)
# ==============================================================================
REASONINGBANK_ENABLED=true
REASONINGBANK_DB_PATH=.swarm/memory.db
REASONINGBANK_K=10
REASONINGBANK_MIN_CONFIDENCE=0.5
AGENTIC_FLOW_TRAINING=true

# ==============================================================================
# MEMORY & PERSISTENCE (HYBRID BACKEND)
# ==============================================================================
MEMORY_BACKEND=hybrid
MEMORY_PRIMARY_STORE=letta
MEMORY_SECONDARY_STORE=mem0
MEMORY_AUTO_PERSIST=true
MEMORY_COMPRESSION=true
MEMORY_SYNC_INTERVAL=60
MEMORY_RETENTION_DAYS=90
MEMORY_BACKUP_TO_GITHUB=true
MEMORY_NAMESPACES=swarm,tasks,patterns,errors,optimizations,nyra
MEMORY_ENABLE_HNSW=true
MEMORY_HNSW_EF_CONSTRUCTION=200
MEMORY_HNSW_M=16

# ==============================================================================
# NEURAL NETWORK CONFIGURATION (FLASH ATTENTION 2.49x-7.47x SPEEDUP)
# ==============================================================================
NEURAL_OPTIMIZATION_ENABLED=true
NEURAL_FLASH_ATTENTION=true
NEURAL_MODEL_OPTIMIZATION=flash-attention-2
NEURAL_QUANTIZATION=int8
NEURAL_LEARNING_RATE=0.001
NEURAL_UPDATE_FREQUENCY=100
NEURAL_ERROR_PREVENTION_THRESHOLD=0.85
NEURAL_PERFORMANCE_AUTO_TUNE=true
NEURAL_BATCH_SIZE=32

# ==============================================================================
# API CONFIGURATION
# ==============================================================================
# Note: Load from environment or Infisical in production
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.7

GOOGLE_API_KEY=${GOOGLE_API_KEY}
GOOGLE_GEMINI_MODEL=gemini-2.0-flash-exp

OPENROUTER_API_KEY=${OPENROUTER_API_KEY}
OPENROUTER_MODEL=deepseek/deepseek-r1

# Model Routing (Cost-Optimized)
COMPLETION_MODEL=claude-sonnet-4-5-20250929
PROVIDER=anthropic
MODEL_ROUTING_STRATEGY=cost-optimized
MODEL_ROUTING_PREFER_LOCAL=true
MODEL_ROUTING_FALLBACK_CLOUD=true

# ==============================================================================
# V3 PERFORMANCE TARGETS
# ==============================================================================
# Flash Attention: 2.49x-7.47x speedup
# HNSW Search: 150x-12,500x faster
# Memory Reduction: 50-75% with quantization
# MCP Response: <100ms target
# Token Optimization: 30-50% savings
PERF_TARGET_COMMAND_EXECUTION=500
PERF_TARGET_MEMORY_OPERATIONS=100
PERF_TARGET_NEURAL_PREDICTIONS=50
PERF_TARGET_MCP_RESPONSE=100

# ==============================================================================
# SECURITY & COMPLIANCE
# ==============================================================================
JWT_SECRET=${JWT_SECRET}
ENCRYPTION_KEY=${ENCRYPTION_KEY}
SESSION_SECRET=${SESSION_SECRET}
ENCRYPTION_ALGORITHM=aes-256-gcm

# AI Defense System
AIDEFENCE_ENABLED=true
AIDEFENCE_MONITOR_INPUTS=true
AIDEFENCE_MONITOR_OUTPUTS=true
AIDEFENCE_BLOCK_SUSPICIOUS=true

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=30000

# ==============================================================================
# TELEMETRY (DISABLED)
# ==============================================================================
NEXT_TELEMETRY_DISABLED=1
TURBO_TELEMETRY_DISABLED=1
DEBUG=false

# ==============================================================================
# NOTE: Copy to .env and set actual values for API keys and secrets
# Generate secrets with: openssl rand -hex 32
# For production, use Infisical: infisical run -- <command>
# ==============================================================================
