# Project Nyra - PC4 GPU Worker 3 Environment Variables

# ============================================================================
# LLM PROVIDER API KEYS
# ============================================================================

ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# ============================================================================
# DATABASE PASSWORDS
# ============================================================================

POSTGRES_PASSWORD=nyra_secure_password_change_me
ACTIVEPIECES_POSTGRES_PASSWORD=activepieces_secure_password_change_me

# ============================================================================
# N8N CONFIGURATION
# ============================================================================

N8N_PASSWORD=change_me_secure_password
N8N_ENCRYPTION_KEY=change-me-to-exactly-32-character-key!!

# ============================================================================
# ACTIVEPIECES CONFIGURATION
# ============================================================================

ACTIVEPIECES_ENCRYPTION_KEY=change-me-to-exactly-32-character-key!!
ACTIVEPIECES_JWT_SECRET=change-me-jwt-secret-long-random-string

# ============================================================================
# RUVECTOR CONFIGURATION
# ============================================================================

RUVECTOR_NODE_ID=follower2
RUVECTOR_NODE_IP=10.0.0.4
RUVECTOR_CLUSTER_ID=nyra-cluster
RUVECTOR_PEERS=10.0.0.2:6370,10.0.0.3:6370

# ============================================================================
# EXTERNAL SERVICE INTEGRATION
# ============================================================================

# Twilio (SMS/Voice)
TWILIO_ACCOUNT_SID=YOUR_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_AUTH_TOKEN_HERE
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid (Email)
SENDGRID_API_KEY=SG.YOUR_KEY_HERE
SENDGRID_FROM_EMAIL=noreply@ratehunter.net

# ============================================================================
# NETWORKING
# ============================================================================

PC1_IP=10.0.0.1
PC2_IP=10.0.0.2
PC3_IP=10.0.0.3
PC4_IP=10.0.0.4

TAILSCALE_AUTH_KEY=tskey-YOUR_KEY_HERE
TAILSCALE_HOSTNAME=nyra-gpu-worker-3

# ============================================================================
# SYSTEM CONFIGURATION
# ============================================================================

NODE_ENV=production
TZ=America/Los_Angeles
