# Core orchestrator
MANAGER_PORT=8899
MCP_PROXY_MODE=unified
MCP_PROXY_TYPE=mcpo
PORT_RANGE_START=9100
PORT_RANGE_END=9199
CLAUDE_CONFIG_PATH=C:\Users\%USERNAME%\.claude\config.json

# MetaMCP gateway
METAMCP_PORT=9090
METAMCP_SSE_URL=http://localhost:9090/sse
METAMCP_WS_URL=ws://localhost:9090/ws

# Open WebUI
OPENWEBUI_DATA=./data/openwebui

# Secrets (use Infisical for production)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Infisical (optional but recommended)
INFISICAL_TOKEN=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=dev

# Optional backends
QDRANT_URL=http://qdrant:6333
POSTGRES_URL=postgres://postgres:postgres@postgres:5432/postgres
REDIS_URL=redis://redis:6379
