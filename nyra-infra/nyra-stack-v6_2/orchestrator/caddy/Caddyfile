:{$CADDY_HTTP_PORT} {
  encode gzip zstd

  @owui path /owui* /open-webui*
  handle @owui {
    reverse_proxy open-webui:8080
  }

  @metamcp path /metamcp* /mcp*
  handle @metamcp {
    reverse_proxy metamcp:${METAMCP_PORT}
  }

  handle {
    respond "NYRA portal online. Paths: /owui /metamcp" 200
  }
}
