# CASIStack MCP OpenWebUI Orchestrator
# These can be mapped from Infisical -> environment -> Compose automatically.
MANAGER_PORT=3001
MCP_PROXY_MODE=unified
MCP_PROXY_TYPE=mcpo
PORT_RANGE_START=4200
PORT_RANGE_END=4300
# Windows default path for Claude Desktop config; override if different
CLAUDE_CONFIG_PATH=C:/Users/%USERNAME%/.config/Claude/claude_desktop_config.json
