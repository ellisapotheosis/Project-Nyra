{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "3.0.0",
  "projectRoot": "/home/ellisapotheosis/projects/project-nyra",

  "agents": {
    "defaultType": "coder",
    "autoSpawn": true,
    "maxConcurrent": 8,
    "timeout": 180000,
    "providers": [
      {
        "name": "anthropic",
        "priority": 1,
        "enabled": true
      },
      {
        "name": "openai",
        "priority": 2,
        "enabled": true
      },
      {
        "name": "google",
        "priority": 3,
        "enabled": true
      },
      {
        "name": "ollama",
        "priority": 4,
        "enabled": true
      }
    ]
  },

  "swarm": {
    "topology": "mesh",
    "maxAgents": 8,
    "autoScale": true,
    "coordinationStrategy": "distributed",
    "healthCheckInterval": 10000
  },

  "memory": {
    "backend": "hybrid",
    "persistPath": "./data/memory",
    "cacheSize": 50000,
    "enableHNSW": true,
    "vectorDimension": 384
  },

  "mcp": {
    "serverHost": "localhost",
    "serverPort": 3000,
    "autoStart": true,
    "transportType": "stdio",
    "tools": [
      "create",
      "implement",
      "test",
      "fix",
      "optimize",
      "memory",
      "security",
      "monitor"
    ]
  },

  "cli": {
    "colorOutput": true,
    "interactive": true,
    "verbosity": "normal",
    "outputFormat": "json",
    "progressStyle": "spinner"
  },

  "hooks": {
    "enabled": true,
    "autoExecute": true,
    "hooks": [
      {
        "name": "pre-task",
        "event": "task.start",
        "handler": "@claude-flow/hooks/pre-task",
        "priority": 100,
        "enabled": true
      },
      {
        "name": "post-task",
        "event": "task.end",
        "handler": "@claude-flow/hooks/post-task",
        "priority": 100,
        "enabled": true
      },
      {
        "name": "pre-edit",
        "event": "file.edit.start",
        "handler": "@claude-flow/hooks/pre-edit",
        "priority": 90,
        "enabled": true
      },
      {
        "name": "post-edit",
        "event": "file.edit.end",
        "handler": "@claude-flow/hooks/post-edit",
        "priority": 90,
        "enabled": true
      },
      {
        "name": "pre-command",
        "event": "command.start",
        "handler": "@claude-flow/hooks/pre-command",
        "priority": 110,
        "enabled": true
      },
      {
        "name": "post-command",
        "event": "command.end",
        "handler": "@claude-flow/hooks/post-command",
        "priority": 110,
        "enabled": true
      }
    ]
  }
}
