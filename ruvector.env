# RuVector Environment Configuration
# For use with Infisical import and Docker containerization
# Generated: 2026-01-18

# ===================================================================
# CORE RUVECTOR SETTINGS
# ===================================================================

# Enable RuVector distributed vector database
RUVECTOR_ENABLED=true

# Operation mode: standalone, distributed, cluster
RUVECTOR_MODE=distributed

# Host and port configuration
RUVECTOR_HOST=ruvector
RUVECTOR_PORT=6380
RUVECTOR_HTTP_PORT=8380

# ===================================================================
# VECTOR INDEX CONFIGURATION (HNSW)
# ===================================================================

# Index type: hnsw (Hierarchical Navigable Small World)
RUVECTOR_INDEX_TYPE=hnsw

# M: Number of connections per layer (8-32, default 16)
# Higher M = better recall, more memory
RUVECTOR_INDEX_M=16

# ef_construction: Size of dynamic candidate list during construction (50-400)
# Higher value = better index quality, slower build time
RUVECTOR_INDEX_EF_CONSTRUCTION=200

# ef_search: Size of dynamic candidate list during search (30-200)
# Higher value = better recall, slower search
RUVECTOR_INDEX_EF_SEARCH=100

# Distance metric: cosine, euclidean, dot_product
RUVECTOR_INDEX_METRIC=cosine

# ===================================================================
# VECTOR EMBEDDINGS
# ===================================================================

# Vector dimensionality (must match embedding model)
# 384: Xenova/all-MiniLM-L6-v2 (local, fast)
# 768: all-mpnet-base-v2 (better quality)
# 1536: OpenAI text-embedding-3-small (production)
# 3072: OpenAI text-embedding-3-large (best quality)
RUVECTOR_VECTOR_DIM=1536

# Embedding provider: openai, cohere, local, huggingface
RUVECTOR_EMBEDDING_PROVIDER=openai

# Model name based on provider
RUVECTOR_EMBEDDING_MODEL=text-embedding-3-small

# API keys for embedding providers
RUVECTOR_OPENAI_API_KEY=${OPENAI_API_KEY}
RUVECTOR_COHERE_API_KEY=${COHERE_API_KEY}

# Local embedding model path (if using local provider)
RUVECTOR_LOCAL_MODEL_PATH=/models/all-MiniLM-L6-v2

# ===================================================================
# DISTRIBUTED CONSENSUS (Multi-Node)
# ===================================================================

# Consensus protocol: raft, gossip, etcd
RUVECTOR_CONSENSUS_PROTOCOL=raft

# Cluster node ID (unique per node)
RUVECTOR_NODE_ID=node-1

# Peer nodes for consensus (comma-separated)
RUVECTOR_CONSENSUS_PEERS=worker-1:6380,worker-2:6380,worker-3:6380

# Raft-specific settings
RUVECTOR_RAFT_ELECTION_TIMEOUT=3000
RUVECTOR_RAFT_HEARTBEAT_INTERVAL=500
RUVECTOR_RAFT_SNAPSHOT_INTERVAL=10000

# ===================================================================
# PERFORMANCE TUNING
# ===================================================================

# Batch size for bulk operations
RUVECTOR_BATCH_SIZE=1000

# Maximum concurrent connections
RUVECTOR_MAX_CONNECTIONS=100

# Worker thread count (0 = auto-detect CPU cores)
RUVECTOR_WORKER_THREADS=0

# Cache size in MB
RUVECTOR_CACHE_SIZE_MB=2048

# Enable query result caching
RUVECTOR_QUERY_CACHE_ENABLED=true
RUVECTOR_QUERY_CACHE_TTL=300

# Enable write-ahead logging (WAL)
RUVECTOR_WAL_ENABLED=true
RUVECTOR_WAL_SYNC_INTERVAL=1000

# ===================================================================
# STORAGE & PERSISTENCE
# ===================================================================

# Primary storage path
RUVECTOR_STORAGE_PATH=/data/ruvector

# Data directory for indexes
RUVECTOR_DATA_DIR=/data/ruvector/indexes

# Snapshot directory
RUVECTOR_SNAPSHOT_DIR=/data/ruvector/snapshots

# Log directory
RUVECTOR_LOG_DIR=/data/ruvector/logs

# Enable automatic backups
RUVECTOR_BACKUP_ENABLED=true

# Backup interval in seconds (3600 = 1 hour)
RUVECTOR_BACKUP_INTERVAL_SECONDS=3600

# Backup retention count
RUVECTOR_BACKUP_RETENTION=7

# Backup path
RUVECTOR_BACKUP_PATH=/backups/ruvector

# ===================================================================
# SEARCH CONFIGURATION
# ===================================================================

# Default search limit
RUVECTOR_DEFAULT_LIMIT=10

# Maximum search limit
RUVECTOR_MAX_LIMIT=100

# Minimum similarity threshold (0.0-1.0)
RUVECTOR_MIN_SIMILARITY=0.0

# Enable hybrid search (vector + keyword)
RUVECTOR_HYBRID_SEARCH_ENABLED=true

# Hybrid search alpha (0.0 = pure keyword, 1.0 = pure vector)
RUVECTOR_HYBRID_ALPHA=0.7

# ===================================================================
# QUANTIZATION (Memory Optimization)
# ===================================================================

# Enable vector quantization
RUVECTOR_QUANTIZATION_ENABLED=true

# Quantization type: scalar, product, binary
RUVECTOR_QUANTIZATION_TYPE=scalar

# Bits per dimension (4, 8, 16, 32)
# Lower = more compression, less accuracy
RUVECTOR_QUANTIZATION_BITS=8

# ===================================================================
# REDIS INTEGRATION (Optional)
# ===================================================================

# Enable Redis for distributed caching
RUVECTOR_REDIS_ENABLED=true

# Redis connection
RUVECTOR_REDIS_HOST=redis
RUVECTOR_REDIS_PORT=6379
RUVECTOR_REDIS_DB=0
RUVECTOR_REDIS_PASSWORD=${REDIS_PASSWORD}

# Redis key prefix
RUVECTOR_REDIS_PREFIX=ruvector:

# ===================================================================
# QDRANT INTEGRATION (Optional Backend)
# ===================================================================

# Use Qdrant as vector database backend
RUVECTOR_QDRANT_ENABLED=false

# Qdrant connection
RUVECTOR_QDRANT_HOST=qdrant
RUVECTOR_QDRANT_PORT=6333
RUVECTOR_QDRANT_GRPC_PORT=6334
RUVECTOR_QDRANT_API_KEY=${QDRANT_API_KEY}

# Qdrant collection name
RUVECTOR_QDRANT_COLLECTION=ruvector_vectors

# ===================================================================
# MONITORING & OBSERVABILITY
# ===================================================================

# Enable Prometheus metrics
RUVECTOR_METRICS_ENABLED=true
RUVECTOR_METRICS_PORT=9100

# Enable health check endpoint
RUVECTOR_HEALTH_CHECK_ENABLED=true
RUVECTOR_HEALTH_CHECK_INTERVAL=30

# Log level: debug, info, warn, error
RUVECTOR_LOG_LEVEL=info

# Log format: json, text
RUVECTOR_LOG_FORMAT=json

# Enable distributed tracing
RUVECTOR_TRACING_ENABLED=true
RUVECTOR_JAEGER_ENDPOINT=http://jaeger:14268/api/traces

# ===================================================================
# SECURITY
# ===================================================================

# Enable TLS/SSL
RUVECTOR_TLS_ENABLED=false
RUVECTOR_TLS_CERT_PATH=/certs/ruvector.crt
RUVECTOR_TLS_KEY_PATH=/certs/ruvector.key

# Enable authentication
RUVECTOR_AUTH_ENABLED=true
RUVECTOR_API_KEY=${RUVECTOR_API_KEY}

# Enable encryption at rest
RUVECTOR_ENCRYPTION_ENABLED=true
RUVECTOR_ENCRYPTION_KEY=${RUVECTOR_ENCRYPTION_KEY}

# ===================================================================
# SONA INTEGRATION (Self-Optimizing Neural Architecture)
# ===================================================================

# Enable SONA adaptive learning
RUVECTOR_SONA_ENABLED=true

# SONA adaptation interval (ms)
RUVECTOR_SONA_ADAPTATION_INTERVAL=50

# SONA learning rate
RUVECTOR_SONA_LEARNING_RATE=0.001

# SONA optimization target: latency, throughput, quality
RUVECTOR_SONA_OPTIMIZATION_TARGET=latency

# ===================================================================
# REASONINGBANK INTEGRATION
# ===================================================================

# Enable ReasoningBank trajectory tracking
RUVECTOR_REASONINGBANK_ENABLED=true

# Trajectory storage namespace
RUVECTOR_TRAJECTORY_NAMESPACE=trajectories

# Pattern storage namespace
RUVECTOR_PATTERN_NAMESPACE=patterns

# Enable automatic pattern distillation
RUVECTOR_AUTO_DISTILL_ENABLED=true

# Distillation interval (seconds)
RUVECTOR_DISTILLATION_INTERVAL=3600

# ===================================================================
# EWC++ (Elastic Weight Consolidation)
# ===================================================================

# Enable EWC++ anti-forgetting
RUVECTOR_EWC_ENABLED=true

# EWC lambda (regularization strength)
RUVECTOR_EWC_LAMBDA=5000

# EWC gamma (decay factor)
RUVECTOR_EWC_GAMMA=0.9

# ===================================================================
# FLASH ATTENTION OPTIMIZATION
# ===================================================================

# Enable Flash Attention optimization
RUVECTOR_FLASH_ATTENTION_ENABLED=true

# Flash Attention block size
RUVECTOR_FLASH_ATTENTION_BLOCK_SIZE=64

# ===================================================================
# NETWORKING
# ===================================================================

# Maximum request size (MB)
RUVECTOR_MAX_REQUEST_SIZE_MB=100

# Request timeout (seconds)
RUVECTOR_REQUEST_TIMEOUT=30

# Keep-alive timeout (seconds)
RUVECTOR_KEEPALIVE_TIMEOUT=60

# Enable CORS
RUVECTOR_CORS_ENABLED=true
RUVECTOR_CORS_ORIGINS=*

# ===================================================================
# DEVELOPMENT & DEBUGGING
# ===================================================================

# Development mode (disable in production)
RUVECTOR_DEV_MODE=false

# Enable debug logging
RUVECTOR_DEBUG=false

# Enable profiling
RUVECTOR_PROFILING_ENABLED=false

# Seed for reproducible results (0 = random)
RUVECTOR_RANDOM_SEED=0
