# Project Nyra stack-wide infrastructure values
#
# This file is for non-application infrastructure shared by the stack.  It is
# a documentation/bootstrap contract only; production values come from
# Infisical and must not be committed here.

COMPOSE_PROJECT_NAME=project-nyra
INFISICAL_URL=https://app.infisical.com
INFISICAL_PROJECT_ID=REPLACE_WITH_INFISICAL_PROJECT_ID
INFISICAL_ENV=prod

# Internal persistence and service authentication.
POSTGRES_USER=REPLACE_WITH_POSTGRES_USER
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD
POSTGRES_DB=REPLACE_WITH_POSTGRES_DB
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
QDRANT_API_KEY=REPLACE_WITH_QDRANT_API_KEY
FALKORDB_PASSWORD=REPLACE_WITH_FALKORDB_PASSWORD
NEXUS_INTERNAL_BEARER_TOKEN=REPLACE_WITH_NEXUS_INTERNAL_BEARER_TOKEN

# Edge/tunnel infrastructure.
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_WITH_CLOUDFLARE_TUNNEL_TOKEN
TAILSCALE_AUTHKEY=REPLACE_WITH_TAILSCALE_AUTHKEY

# Shared model ingress credentials are documented here as well as in the
# host-shared file when the same value is required by multiple Compose hosts.
LITELLM_MASTER_KEY=REPLACE_WITH_SHARED_LITELLM_MASTER_KEY
CF_GATEWAY_ACCESS_CLIENT_ID=REPLACE_WITH_CLOUDFLARE_ACCESS_SERVICE_TOKEN_ID
CF_GATEWAY_ACCESS_CLIENT_SECRET=REPLACE_WITH_CLOUDFLARE_ACCESS_SERVICE_TOKEN_SECRET
