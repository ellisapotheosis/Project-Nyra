# -----------------------------
# STORAGE + MOUNTS (Samsung T5)
# -----------------------------
# Example mount point on Linux/Home Assistant OS add-on host
HA_STACK_ROOT=/mnt/samsung_t5/homeassistant-stack

# -----------------------------
# LINKWARDEN CORE
# -----------------------------
LINKWARDEN_PORT=3010
NEXTAUTH_URL=http://homeassistant.local:3010
NEXTAUTH_SECRET=REPLACE_ME_LONG_RANDOM_32_PLUS_CHARS

POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=REPLACE_ME_POSTGRES_PASSWORD
MEILI_MASTER_KEY=REPLACE_ME_MEILI_MASTER_KEY

# Inside Docker network, StarWarden should talk directly to Linkwarden container
LINKWARDEN_INTERNAL_URL=http://linkwarden:3000

# Generate this from Linkwarden Settings -> API Access Tokens
LINKWARDEN_TOKEN=REPLACE_ME_LINKWARDEN_API_TOKEN

# -----------------------------
# STARWARDEN (GitHub stars sync)
# -----------------------------
GITHUB_USERNAME=REPLACE_ME_GITHUB_USERNAME
GITHUB_TOKEN=REPLACE_ME_GITHUB_TOKEN
COLLECTION_ID=
CRON_SCHEDULE=0 */6 * * *

# Optional notifications (Apprise URL list, comma-separated)
APPRISE_URLS=

# Optional tag controls
OPT_TAG=true
OPT_TAG_GITHUB=true
OPT_TAG_GITHUBSTARS=true
OPT_TAG_LANGUAGE=false
OPT_TAG_USERNAME=false
OPT_TAG_CUSTOM=
