# Home Assistant all-in-one env file
# Copy to .env.homeassistant and replace all REPLACE_ME_* values.
#
# =========================
# INFISICAL (STORE SECRETS)
# =========================
NEXTAUTH_SECRET=REPLACE_ME_NEXTAUTH_SECRET
POSTGRES_PASSWORD=REPLACE_ME_POSTGRES_PASSWORD
MEILI_MASTER_KEY=REPLACE_ME_MEILI_MASTER_KEY
LINKWARDEN_TOKEN=REPLACE_ME_LINKWARDEN_API_TOKEN
GITHUB_TOKEN=REPLACE_ME_GITHUB_TOKEN
APPRISE_URLS=

# ================================
# NON-INFISICAL (SAFE NON-SECRETS)
# ================================
HA_STACK_ROOT=/mnt/samsung_t5/homeassistant-stack
HOMEASSISTANT_IP=100.64.0.20
HOMEPAGE_PORT=3007
LINKWARDEN_PORT=3010

NEXTAUTH_URL=http://homeassistant.local:3010
LINKWARDEN_INTERNAL_URL=http://linkwarden:3000

POSTGRES_USER=postgres
POSTGRES_DB=postgres

GITHUB_USERNAME=REPLACE_ME_GITHUB_USERNAME
COLLECTION_ID=
CRON_SCHEDULE=0 */6 * * *
OPT_TAG=true
OPT_TAG_GITHUB=true
OPT_TAG_GITHUBSTARS=true
OPT_TAG_LANGUAGE=false
OPT_TAG_USERNAME=false
OPT_TAG_CUSTOM=

PORTAINER_URL=https://portainer.ratehunter.net
ARCHON_URL=https://archon.ratehunter.net
WEBAPP_URL=https://app.ratehunter.net
LANDING_URL=https://ratehunter.net
GRAFANA_URL=https://grafana.ratehunter.net
NEXUS_URL=http://100.64.0.1:7000
LINKWARDEN_URL=http://100.64.0.20:3010
