{
  "team_name": "${CF_ACCESS_TEAM_NAME}",
  "domain": "projectnyra.com",
  "default_ui_policy": "allow Google Workspace/domain-approved users, require MFA where available",
  "service_token_policy": "allow only named Cloudflare Access service tokens for API/MCP machine access",
  "applications": [
    {
      "name": "Nyra Webapp",
      "hostnames": ["app.projectnyra.com"],
      "type": "self_hosted",
      "policy": "public_auth_until_supabase_auth_ready"
    },
    {
      "name": "Nyra Admin UIs",
      "hostnames": [
        "twenty.projectnyra.com",
        "crm.projectnyra.com",
        "n8n.projectnyra.com",
        "gitea.projectnyra.com",
        "activepieces.projectnyra.com",
        "openwebui.projectnyra.com",
        "nexus-ui.projectnyra.com",
        "paperclip.projectnyra.com",
        "clawteam.projectnyra.com",
        "links.projectnyra.com",
        "linkwarden.projectnyra.com",
        "openclaw-gateway.projectnyra.com"
      ],
      "type": "self_hosted",
      "policy": "public_auth"
    },
    {
      "name": "Nyra Owner Only Infra",
      "hostnames": [
        "grafana.projectnyra.com",
        "prometheus.projectnyra.com",
        "cadvisor.projectnyra.com",
        "litellm.projectnyra.com",
        "portainer-oracle.projectnyra.com"
      ],
      "type": "self_hosted",
      "policy": "owner_only_public_auth"
    },
    {
      "name": "Nyra Service APIs",
      "hostnames": [
        "nexus.projectnyra.com",
        "nexus-router.projectnyra.com",
        "hooks.projectnyra.com"
      ],
      "type": "self_hosted",
      "policy": "service_token_or_signed_request"
    }
  ],
  "excluded_from_access": ["api.projectnyra.com", "mcp-gateway.projectnyra.com"]
}
