#================================================================
# Orchestrator Environment Configuration
#
# INSTRUCTIONS:
# 1. Create a copy of this file named '.env' in this same directory.
# 2. Fill in the required values for your specific network setup.
#================================================================

#------------------------------------------------
# Worker PC Network Configuration (REQUIRED)
#------------------------------------------------
# IP Addresses for the three worker PCs. These are CRITICAL for the
# orchestrator to connect to the distributed AI models.

WORKER_5090_HOST=192.168.1.101
WORKER_3090TI_HOST=192.168.1.102
WORKER_3060_HOST=192.168.1.103

# Corresponding ports for the worker services.
# These should match the ports configured in the worker setups.
WORKER_5090_PORT=8001   # LMCache port for RTX 5090
WORKER_3090TI_PORT=8001 # LMCache port for RTX 3090Ti
WORKER_3060_PORT=11434  # Ollama port for RTX 3060

#------------------------------------------------
# Gitea Configuration (REQUIRED)
#------------------------------------------------
# The host IP address and ports for the Gitea service.
# This should be the IP address of THIS orchestrator PC itself.
GITEA_HOST_IP=192.168.1.100
GITEA_HOST_HTTP_PORT=3000
GITEA_HOST_SSH_PORT=2222

#------------------------------------------------
# Other Service Configuration (OPTIONAL)
#------------------------------------------------
# Add any other necessary environment variables for your services below.
# For example, API keys for external services, etc.

# Example for accessing private models on Hugging Face
# HUGGING_FACE_HUB_TOKEN=...

# Example for Infisical
# INFISICAL_TOKEN=...
