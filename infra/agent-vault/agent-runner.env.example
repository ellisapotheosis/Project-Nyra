# Agent Runner Environment Configuration
# Used by local agents (Claude, Codex, custom agents) that run through Agent Vault.
# Location: Copy to a host-local, ignored .env file.
# Never commit real token/secret values.

# ============================================================================
# AGENT VAULT ACCESS
# ============================================================================

# Agent Vault server address (same as AGENT_VAULT_ADDR in agent-vault.env.example)
AGENT_VAULT_ADDR=http://127.0.0.1:14321

# Agent token — generated by Agent Vault for this specific agent.
# Permissions: access to specific vault(s) only (e.g., nyra-llm, nyra-github, nyra-comms)
# NEVER commit real token value.
AGENT_VAULT_TOKEN=REPLACE_WITH_AGENT_TOKEN_FROM_AGENT_VAULT

# Vault to use for this agent's credential access.
# Must be created in Agent Vault and backed by Infisical Cloud credentials.
# Examples: nyra-llm, nyra-github, nyra-comms
AGENT_VAULT_VAULT=nyra-llm

# ============================================================================
# DUMMY CREDENTIAL NAMES
# ============================================================================

# These are placeholders that Agent Vault will replace with real values from Infisical.
# Do NOT put real secrets here.
# Agent Vault proxy will intercept requests and inject actual credentials.

OPENAI_API_KEY=__OPENAI_API_KEY__
ANTHROPIC_API_KEY=__ANTHROPIC_API_KEY__
OPENROUTER_API_KEY=__OPENROUTER_API_KEY__
GITHUB_TOKEN=__GITHUB_TOKEN__
TWILIO_ACCOUNT_SID=__TWILIO_ACCOUNT_SID__
TWILIO_AUTH_TOKEN=__TWILIO_AUTH_TOKEN__
SENDGRID_API_KEY=__SENDGRID_API_KEY__
RESEND_API_KEY=__RESEND_API_KEY__
