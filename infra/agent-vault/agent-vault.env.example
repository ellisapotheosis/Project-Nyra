# Project Nyra Agent Vault Environment Configuration Template
# Location: Copy to a host-local, ignored .env file (e.g., infra/hosts/oracle-vps/.env.agent-vault)
# Never commit real values.

# ============================================================================
# AGENT VAULT SERVER
# ============================================================================

# Local/private binding address. Never expose 14321 to public internet.
# Prefer 127.0.0.1 for local hosts.
# For remote hosts: use Tailscale, VPN, or Cloudflare Zero Trust only.
AGENT_VAULT_ADDR=http://127.0.0.1:14321

# Master password — encrypts all locally stored credentials.
# Generate with: openssl rand -base64 32
# NEVER commit real value.
AGENT_VAULT_MASTER_PASSWORD=REPLACE_WITH_LONG_RANDOM_MASTER_PASSWORD

# Log level: trace, debug, info, warn, error
AGENT_VAULT_LOG_LEVEL=info

# Logs retention (hours)
AGENT_VAULT_LOGS_MAX_AGE_HOURS=168

# Maximum credential log entries per vault
AGENT_VAULT_LOGS_MAX_ROWS_PER_VAULT=10000

# ============================================================================
# INFISICAL CLOUD CREDENTIAL STORE
# ============================================================================

# Infisical Cloud is the source of truth for AI-agent credentials.
# Never use local self-hosted Infisical.
INFISICAL_URL=https://app.infisical.com

# Machine Identity (read-only).
# Created in Infisical Cloud: Settings → Machine Identities → Create.
# Scopes: Read-only, environment-specific paths (/agents/agent-vault/llm, etc.)
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=REPLACE_WITH_READ_ONLY_MACHINE_IDENTITY_CLIENT_ID
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=REPLACE_WITH_READ_ONLY_MACHINE_IDENTITY_CLIENT_SECRET

# ============================================================================
# OPTIONAL: SMTP NOTIFICATIONS
# ============================================================================

# Prefer SendGrid, Resend, or AWS SES over personal Gmail.
# Leave empty to disable email features.

AGENT_VAULT_SMTP_HOST=
AGENT_VAULT_SMTP_PORT=587
AGENT_VAULT_SMTP_USERNAME=
AGENT_VAULT_SMTP_PASSWORD=
AGENT_VAULT_SMTP_FROM=
AGENT_VAULT_SMTP_FROM_NAME=Project Nyra Agent Vault
AGENT_VAULT_SMTP_TLS_MODE=required
AGENT_VAULT_SMTP_TLS_SKIP_VERIFY=false
