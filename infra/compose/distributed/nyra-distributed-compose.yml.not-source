name: nyra-distributed

x-default-logging: &default_logging
  driver: json-file
  options:
    max-size: '10m'
    max-file: '3'

networks:
  nyra:
    driver: bridge

volumes:
  orchestrator_secrets: {}
  oracle_secrets: {}
  worker_secrets: {}
  homeassistant_secrets: {}
  redis_worker_data: {}
  ollama_data: {}
  lmcache_data: {}
  vaultwarden_data: {}
  linkwarden_data: {}
  postgres_linkwarden_data: {}
  meilisearch_data: {}

services:
  infisical-sidecar-orchestrator:
    image: infisical/cli:latest
    profiles: ['orchestrator']
    entrypoint: ['/bin/sh', '-lc']
    command: >-
      test -n "$INFISICAL_TOKEN" &&
      while true; do
        infisical export --projectId=${INFISICAL_PROJECT_ID} --env=${INFISICAL_ENV:-prod} --path=/shared --format=dotenv > /secrets/shared.env &&
        infisical export --projectId=${INFISICAL_PROJECT_ID} --env=${INFISICAL_ENV:-prod} --path=/orchestrator --format=dotenv > /secrets/orchestrator.env &&
        sleep ${INFISICAL_POLL_INTERVAL:-60};
      done
    environment:
      INFISICAL_TOKEN: ${INFISICAL_TOKEN:?set INFISICAL_TOKEN}
      INFISICAL_API_URL: ${INFISICAL_API_URL:-https://app.infisical.com}
      INFISICAL_PROJECT_ID: ${INFISICAL_PROJECT_ID:?set INFISICAL_PROJECT_ID}
      INFISICAL_ENV: ${INFISICAL_ENV:-prod}
      INFISICAL_POLL_INTERVAL: ${INFISICAL_POLL_INTERVAL:-60}
    volumes:
      - orchestrator_secrets:/secrets
    restart: unless-stopped
    networks: [nyra]
    logging: *default_logging

  infisical-sidecar-oracle:
    image: infisical/cli:latest
    profiles: ['oracle']
    entrypoint: ['/bin/sh', '-lc']
    command: >-
      test -n "$INFISICAL_TOKEN" &&
      while true; do
        infisical export --projectId=${INFISICAL_PROJECT_ID} --env=${INFISICAL_ENV:-prod} --path=/shared --format=dotenv > /secrets/shared.env &&
        infisical export --projectId=${INFISICAL_PROJECT_ID} --env=${INFISICAL_ENV:-prod} --path=/oracle --format=dotenv > /secrets/oracle.env &&
        sleep ${INFISICAL_POLL_INTERVAL:-60};
      done
    environment:
      INFISICAL_TOKEN: ${INFISICAL_TOKEN:?set INFISICAL_TOKEN}
      INFISICAL_API_URL: ${INFISICAL_API_URL:-https://app.infisical.com}
      INFISICAL_PROJECT_ID: ${INFISICAL_PROJECT_ID:?set INFISICAL_PROJECT_ID}
      INFISICAL_ENV: ${INFISICAL_ENV:-prod}
      INFISICAL_POLL_INTERVAL: ${INFISICAL_POLL_INTERVAL:-60}
    volumes:
      - oracle_secrets:/secrets
    restart: unless-stopped
    networks: [nyra]
    logging: *default_logging

  infisical-sidecar-worker:
    image: infisical/cli:latest
    profiles: ['worker']
    entrypoint: ['/bin/sh', '-lc']
    command: >-
      test -n "$INFISICAL_TOKEN" &&
      while true; do
        infisical export --projectId=${INFISICAL_PROJECT_ID} --env=${INFISICAL_ENV:-prod} --path=/shared --format=dotenv > /secrets/shared.env &&
        infisical export --projectId=${INFISICAL_PROJECT_ID} --env=${INFISICAL_ENV:-prod} --path=/${NYRA_NODE_ROLE:-worker} --format=dotenv > /secrets/worker.env &&
        sleep ${INFISICAL_POLL_INTERVAL:-60};
      done
    environment:
      INFISICAL_TOKEN: ${INFISICAL_TOKEN:?set INFISICAL_TOKEN}
      INFISICAL_API_URL: ${INFISICAL_API_URL:-https://app.infisical.com}
      INFISICAL_PROJECT_ID: ${INFISICAL_PROJECT_ID:?set INFISICAL_PROJECT_ID}
      INFISICAL_ENV: ${INFISICAL_ENV:-prod}
      INFISICAL_POLL_INTERVAL: ${INFISICAL_POLL_INTERVAL:-60}
      NYRA_NODE_ROLE: ${NYRA_NODE_ROLE:-worker-rtx5090}
    volumes:
      - worker_secrets:/secrets
    restart: unless-stopped
    networks: [nyra]
    logging: *default_logging

  infisical-sidecar-homeassistant:
    image: infisical/cli:latest
    profiles: ['homeassistant']
    entrypoint: ['/bin/sh', '-lc']
    command: >-
      test -n "$INFISICAL_TOKEN" &&
      while true; do
        infisical export --projectId=${INFISICAL_PROJECT_ID} --env=${INFISICAL_ENV:-prod} --path=/shared --format=dotenv > /secrets/shared.env &&
        infisical export --projectId=${INFISICAL_PROJECT_ID} --env=${INFISICAL_ENV:-prod} --path=/homeassistant --format=dotenv > /secrets/homeassistant.env &&
        sleep ${INFISICAL_POLL_INTERVAL:-60};
      done
    environment:
      INFISICAL_TOKEN: ${INFISICAL_TOKEN:?set INFISICAL_TOKEN}
      INFISICAL_API_URL: ${INFISICAL_API_URL:-https://app.infisical.com}
      INFISICAL_PROJECT_ID: ${INFISICAL_PROJECT_ID:?set INFISICAL_PROJECT_ID}
      INFISICAL_ENV: ${INFISICAL_ENV:-prod}
      INFISICAL_POLL_INTERVAL: ${INFISICAL_POLL_INTERVAL:-60}
    volumes:
      - homeassistant_secrets:/secrets
    restart: unless-stopped
    networks: [nyra]
    logging: *default_logging

  nexus-router:
    image: ghcr.io/project-nexus/router:latest
    profiles: ['orchestrator']
    ports:
      - '${NEXUS_ROUTER_PORT:-7000}:7000'
      - '${NEXUS_MCP_PORT:-8080}:8080'
    environment:
      NEXUS_ROUTER_PORT: ${NEXUS_ROUTER_PORT:-7000}
      NEXUS_MCP_PORT: ${NEXUS_MCP_PORT:-8080}
      REDIS_URL: redis://:${REDIS_PASSWORD}@redis-worker:6379
      LITELLM_BASE_URL: http://litellm:4000
    depends_on:
      infisical-sidecar-orchestrator:
        condition: service_started
    restart: unless-stopped
    networks: [nyra]
    logging: *default_logging

  litellm:
    image: ghcr.io/berriai/litellm:main-stable
    profiles: ['orchestrator']
    command: ['--config', '/app/config.yaml', '--port', '4000']
    environment:
      LITELLM_MASTER_KEY: ${LITELLM_MASTER_KEY:?set LITELLM_MASTER_KEY}
    volumes:
      - ../configs/litellm/config.yaml:/app/config.yaml:ro
    depends_on:
      infisical-sidecar-orchestrator:
        condition: service_started
    restart: unless-stopped
    networks: [nyra]
    logging: *default_logging

  twentycrm:
    image: twentycrm/twenty:latest
    profiles: ['oracle']
    environment:
      SERVER_URL: ${TWENTY_SERVER_URL:?set TWENTY_SERVER_URL}
      NEXUS_BASE_URL: ${NEXUS_BASE_URL:-http://orchestrator:7000}
    depends_on:
      infisical-sidecar-oracle:
        condition: service_started
    ports:
      - '${TWENTYCRM_PORT:-3000}:3000'
    restart: unless-stopped
    networks: [nyra]
    logging: *default_logging

  n8n:
    image: n8nio/n8n:latest
    profiles: ['oracle']
    environment:
      N8N_PORT: '5678'
      NEXUS_BASE_URL: ${NEXUS_BASE_URL:-http://orchestrator:7000}
    depends_on:
      infisical-sidecar-oracle:
        condition: service_started
    ports:
      - '${N8N_PORT:-5678}:5678'
    restart: unless-stopped
    networks: [nyra]
    logging: *default_logging

  activepieces:
    image: activepieces/activepieces:latest
    profiles: ['oracle']
    environment:
      AP_ENVIRONMENT: ${ACTIVEPIECES_ENV:-prod}
      NEXUS_BASE_URL: ${NEXUS_BASE_URL:-http://orchestrator:7000}
    depends_on:
      infisical-sidecar-oracle:
        condition: service_started
    ports:
      - '${ACTIVEPIECES_PORT:-8082}:80'
    restart: unless-stopped
    networks: [nyra]
    logging: *default_logging

  redis-worker:
    image: redis:7-alpine
    profiles: ['worker']
    command: ['redis-server', '--appendonly', 'yes', '--requirepass', '${REDIS_PASSWORD}']
    volumes:
      - redis_worker_data:/data
    restart: unless-stopped
    networks: [nyra]
    logging: *default_logging

  ollama:
    image: ollama/ollama:latest
    profiles: ['worker']
    environment:
      OLLAMA_KEEP_ALIVE: 5m
    ports:
      - '${OLLAMA_PORT:-11434}:11434'
    volumes:
      - ollama_data:/root/.ollama
      - worker_secrets:/secrets:ro
    depends_on:
      infisical-sidecar-worker:
        condition: service_started
    restart: unless-stopped
    networks: [nyra]
    logging: *default_logging

  vllm:
    image: vllm/vllm-openai:latest
    profiles: ['worker']
    command:
      - --model
      - ${VLLM_MODEL:-Qwen/Qwen2.5-Coder-32B-Instruct}
      - --host
      - 0.0.0.0
      - --port
      - '8000'
      - --max-model-len
      - ${VLLM_MAX_MODEL_LEN:-8192}
    ports:
      - '${VLLM_PORT:-8000}:8000'
    depends_on:
      infisical-sidecar-worker:
        condition: service_started
      redis-worker:
        condition: service_started
    restart: unless-stopped
    networks: [nyra]
    logging: *default_logging

  lmcache:
    image: lmcache/lmcache:latest
    profiles: ['worker']
    environment:
      REDIS_URL: redis://:${REDIS_PASSWORD}@redis-worker:6379
    volumes:
      - lmcache_data:/var/lib/lmcache
    depends_on:
      redis-worker:
        condition: service_started
    restart: unless-stopped
    networks: [nyra]
    logging: *default_logging

  vaultwarden:
    image: vaultwarden/server:latest
    profiles: ['homeassistant']
    environment:
      DOMAIN: ${VAULTWARDEN_DOMAIN:?set VAULTWARDEN_DOMAIN}
      SIGNUPS_ALLOWED: ${VAULTWARDEN_SIGNUPS_ALLOWED:-false}
    volumes:
      - vaultwarden_data:/data
      - homeassistant_secrets:/secrets:ro
    depends_on:
      infisical-sidecar-homeassistant:
        condition: service_started
    ports:
      - '${VAULTWARDEN_PORT:-8085}:80'
    restart: unless-stopped
    networks: [nyra]
    logging: *default_logging

  linkwarden:
    image: ghcr.io/linkwarden/linkwarden:latest
    profiles: ['homeassistant']
    environment:
      NEXTAUTH_URL: ${LINKWARDEN_URL:?set LINKWARDEN_URL}
      NEXTAUTH_SECRET: ${LINKWARDEN_NEXTAUTH_SECRET:?set LINKWARDEN_NEXTAUTH_SECRET}
      DATABASE_URL: postgresql://linkwarden:${LINKWARDEN_DB_PASSWORD}@linkwarden-postgres:5432/linkwarden
      MEILI_HOST: http://linkwarden-meilisearch:7700
    depends_on:
      infisical-sidecar-homeassistant:
        condition: service_started
      linkwarden-postgres:
        condition: service_started
      linkwarden-meilisearch:
        condition: service_started
    ports:
      - '${LINKWARDEN_PORT:-3005}:3000'
    restart: unless-stopped
    networks: [nyra]
    logging: *default_logging

  linkwarden-postgres:
    image: postgres:16-alpine
    profiles: ['homeassistant']
    environment:
      POSTGRES_USER: linkwarden
      POSTGRES_PASSWORD: ${LINKWARDEN_DB_PASSWORD:?set LINKWARDEN_DB_PASSWORD}
      POSTGRES_DB: linkwarden
    volumes:
      - postgres_linkwarden_data:/var/lib/postgresql/data
    restart: unless-stopped
    networks: [nyra]
    logging: *default_logging

  linkwarden-meilisearch:
    image: getmeili/meilisearch:v1.12
    profiles: ['homeassistant']
    environment:
      MEILI_MASTER_KEY: ${LINKWARDEN_MEILI_MASTER_KEY:?set LINKWARDEN_MEILI_MASTER_KEY}
    volumes:
      - meilisearch_data:/meili_data
    restart: unless-stopped
    networks: [nyra]
    logging: *default_logging

  starwarden:
    image: ghcr.io/not-first/starsync:latest
    profiles: ['homeassistant']
    environment:
      STARWARDEN_BASE_URL: ${STARWARDEN_BASE_URL:?set STARWARDEN_BASE_URL}
      NEXUS_MCP_PROXY_URL: ${NEXUS_MCP_PROXY_URL:-http://orchestrator:8080}
    depends_on:
      infisical-sidecar-homeassistant:
        condition: service_started
    ports:
      - '${STARWARDEN_PORT:-3040}:3040'
    restart: unless-stopped
    networks: [nyra]
    logging: *default_logging
