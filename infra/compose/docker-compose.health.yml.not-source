version: '3.9'

services:
  nexus-router:
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:6000/health >/dev/null"]
      interval: 30s
      timeout: 10s
      retries: 3

  litellm:
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:4000/health >/dev/null"]
      interval: 30s
      timeout: 10s
      retries: 3

  redis:
    healthcheck:
      test: ["CMD", "redis-cli", "PING"]
      interval: 30s
      timeout: 5s
      retries: 3

  twenty-postgres:
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "${TWENTY_POSTGRES_USER:-twenty}"]
      interval: 30s
      timeout: 5s
      retries: 3

  twentycrm:
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:3000/healthz >/dev/null"]
      interval: 30s
      timeout: 10s
      retries: 3

  activepieces:
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:8082/api/health >/dev/null"]
      interval: 30s
      timeout: 10s
      retries: 3
