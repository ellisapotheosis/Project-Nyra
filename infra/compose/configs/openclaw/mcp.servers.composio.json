{
  "mcpServers": {
    "composio": {
      "type": "url",
      "url": "${COMPOSIO_MCP_URL}",
      "transport": "streamable-http",
      "headers": {
        "Authorization": "Bearer ${COMPOSIO_API_KEY}"
      },
      "toolPolicy": {
        "allowToolkits": ["jira", "slack", "twenty"],
        "requireUserConnection": true
      }
    }
  }
}
