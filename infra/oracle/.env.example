POSTGRES_USER=ruvector
POSTGRES_PASSWORD=change-me
POSTGRES_DB=twenty
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# Twenty CRM (required by infra/oracle/docker-compose.oracle.yml)
TWENTY_SERVER_URL=https://admin.ratehunter.net
TWENTY_FRONTEND_URL=https://admin.ratehunter.net
TWENTY_APP_SECRET=change-me-app-secret
TWENTY_PG_DATABASE_URL=postgresql://ruvector:change-me@nyra-postgres:5432/twenty
TWENTY_REDIS_URL=redis://nyra-redis-cache:6379

# Activepieces (required by infra/oracle/docker-compose.oracle.yml)
AP_DB_TYPE=POSTGRES
AP_POSTGRES_HOST=nyra-postgres
AP_POSTGRES_PORT=5432
AP_POSTGRES_DATABASE=activepieces
AP_POSTGRES_USERNAME=ruvector
AP_POSTGRES_PASSWORD=change-me
AP_REDIS_HOST=nyra-redis-cache
AP_REDIS_PORT=6379
AP_REDIS_PASSWORD=
AP_ENCRYPTION_KEY=change-me-encryption-key
AP_JWT_SECRET=change-me-jwt-secret
AP_FRONTEND_URL=https://activepieces.ratehunter.net
AP_EXECUTION_MODE=UNSANDBOXED
AP_TELEMETRY_ENABLED=false

# n8n
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me-n8n-encryption
N8N_HOST=n8n.ratehunter.net
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.ratehunter.net/
N8N_SKIP_WEBHOOK_DNS_CHECK=true

# moltbot
CLAWDBOT_GATEWAY_TOKEN=change-me-clawdbot-token
CLAWDBOT_GATEWAY_PORT=18789

# quote-api
QUOTE_API_PORT=7070
QUOTE_API_SECRET=change-me-quote-api-secret

# optional LLM providers for graphiti-mcp
OPENAI_API_KEY=change-me
ANTHROPIC_API_KEY=change-me
GEMINI_API_KEY=change-me

# optional cloudflared tunnel
CLOUDFLARED_TUNNEL_TOKEN=
