# ============================================================================
# Project Nyra - Environment Configuration
# ============================================================================
# Copy this file to .env and customize for your environment
# DO NOT commit .env to version control
# ============================================================================

# =============================================================================
# API KEYS (REQUIRED)
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENROUTER_API_KEY=sk-or-your-key-here
GOOGLE_API_KEY=your-google-api-key-here

# =============================================================================
# DATABASE PASSWORDS (REQUIRED - Change these!)
# =============================================================================
POSTGRES_USER=nyra_user
POSTGRES_PASSWORD=change_me_secure_password
POSTGRES_DB=nyra_db

REDIS_PASSWORD=change_me_redis_password
FALKORDB_PASSWORD=change_me_falkordb_password
QDRANT_API_KEY=change_me_qdrant_key

# =============================================================================
# SERVICE-SPECIFIC DATABASES
# =============================================================================
LETTA_DB=letta
TWENTY_DB=twenty
DIFY_DB=dify
N8N_DB=n8n
LITELLM_DB=litellm
ACTIVEPIECES_DB=activepieces

# =============================================================================
# PORTS (Optional - defaults provided)
# =============================================================================
POSTGRES_PORT=5432
REDIS_PORT=6380
FALKORDB_PORT=6379
QDRANT_PORT=6333

NEXUS_PORT=6000
LITELLM_PORT=4000
LETTA_PORT=8283
MEM0_PORT=4321
OPENWEBUI_PORT=8080

TWENTY_PORT=3000
N8N_PORT=5678
DIFY_WEB_PORT=3001
ACTIVEPIECES_PORT=3002

PROMETHEUS_PORT=9090
GRAFANA_PORT=3005
LOKI_PORT=3100
ALERTMANAGER_PORT=9093
CADVISOR_PORT=8080

NYRA_ORCHESTRATOR_PORT=8010
QUOTE_ENGINE_PORT=9010
CAMPAIGN_ENGINE_PORT=9020
QUOTE_API_PORT=8089

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_MAX_MEMORY=2gb
REDIS_EVICTION_POLICY=allkeys-lru

# =============================================================================
# FALKORDB CONFIGURATION
# =============================================================================
FALKORDB_AOF_SYNC=everysec
FALKORDB_MAX_MEMORY=4gb

# =============================================================================
# TWENTYCRM SECRETS
# =============================================================================
TWENTY_SERVER_URL=http://localhost:3000
TWENTY_ENCRYPTION_SECRET=change_me_twenty_encryption_secret
TWENTY_JWT_SECRET=change_me_twenty_jwt_secret
TWENTY_PASSWORD_SALT=change_me_twenty_password_salt
TWENTY_ACCESS_TOKEN_SECRET=change_me_twenty_access_token_secret
TWENTY_LOGIN_TOKEN_SECRET=change_me_twenty_login_token_secret
TWENTY_REFRESH_TOKEN_SECRET=change_me_twenty_refresh_token_secret
TWENTY_FILE_TOKEN_SECRET=change_me_twenty_file_token_secret
TWENTY_FRONT_BASE_URL=http://localhost:3000

# =============================================================================
# LETTA CONFIGURATION
# =============================================================================
LETTA_API_KEY=change_me_letta_api_key
LETTA_SERVER_PASSWORD=change_me_letta_password

# =============================================================================
# LITELLM CONFIGURATION
# =============================================================================
LITELLM_MASTER_KEY=sk-litellm-change-me

# =============================================================================
# N8N CONFIGURATION
# =============================================================================
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_n8n_password
N8N_ENCRYPTION_KEY=change_me_n8n_encryption_key

# =============================================================================
# DIFY CONFIGURATION
# =============================================================================
DIFY_SECRET_KEY=change_me_dify_secret_key
DIFY_ENCRYPTION_KEY=change_me_dify_encryption_key

# =============================================================================
# ACTIVEPIECES CONFIGURATION
# =============================================================================
ACTIVEPIECES_API_KEY=change_me_activepieces_api_key
AP_ENCRYPTION_KEY=change_me_ap_encryption_key
AP_JWT_SECRET=change_me_ap_jwt_secret
AP_FRONTEND_URL=http://localhost:3002

# =============================================================================
# GRAFANA CONFIGURATION
# =============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
GRAFANA_ROOT_URL=http://localhost:3005

# =============================================================================
# NYRA ORCHESTRATOR CONFIGURATION
# =============================================================================
NYRA_POLICY_MODE=strict
NYRA_ALLOWED_CHANNELS=sms,email,webchat
NYRA_ESCALATION_EMAIL=ops@example.com

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# TIMEZONE
# =============================================================================
TIMEZONE=America/New_York

# =============================================================================
# SESSION/SECURITY
# =============================================================================
SESSION_SECRET=change_me_session_secret

# =============================================================================
# OPTIONAL: Custom URLs for services
# =============================================================================
# NEXUS_URL=http://nexus:6000
# TWENTY_BASE_URL=http://twentycrm:3000
# MEM0_REST_URL=http://mem0:4321
# LETTA_BASE_URL=http://letta:8283
# FALKOR_URL=redis://falkordb:6379
