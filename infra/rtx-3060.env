# RTX 3060 Mobile Worker Configuration
# Fast drafting and utility models (Ollama)

WORKER_NAME=rtx-3060
TAILSCALE_IP=100.x.x.3

# Ollama Configuration (uses profile "ollama")
OLLAMA_MODEL=qwen:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:v1.5
OLLAMA_DATA_DIR=/mnt/ollama-3060

# Docker
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
