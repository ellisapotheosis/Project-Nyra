# Enhanced MetaMCP Gateway with Infisical Integration
FROM node:22-alpine

LABEL maintainer="Project Nyra Team" \
      version="2.0.0" \
      description="Enhanced MetaMCP Gateway with Infisical Secret Management"

# Install system dependencies
RUN apk add --no-cache \
    curl \
    bash \
    jq \
    ca-certificates \
    git

# Install Infisical CLI for secret injection
RUN curl -1sLf 'https://dl.cloudsmith.io/public/infisical/infisical-cli/setup.alpine.sh' | bash && \
    apk add infisical

# Create app directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --only=production && npm cache clean --force

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S gateway -u 1001 -G nodejs

# Create necessary directories
RUN mkdir -p /app/{config,cache,logs,plugins,secrets} && \
    chown -R gateway:nodejs /app

# Copy application code
COPY src/ ./src/
COPY config/ ./config/

# Set permissions
RUN chown -R gateway:nodejs /app

# Switch to non-root user
USER gateway

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:${GATEWAY_PORT:-8005}/health || exit 1

# Expose gateway port
EXPOSE ${GATEWAY_PORT:-8005}

# Start command with Infisical secret injection
CMD ["sh", "-c", "infisical run -- node src/gateway-enhanced.js"]