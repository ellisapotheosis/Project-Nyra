# ==============================================================================
# RuVector Intelligence System - Environment Configuration
# ==============================================================================

# Service Configuration
RUVECTOR_HOST=0.0.0.0
RUVECTOR_PORT=7000
VERSION=1.0.0

# Data Paths
NEURAL_DATA_PATH=/data/neural
AGENTDB_PATH=/data/agentdb
CACHE_PATH=/data/cache

# SONA Configuration
SONA_ENABLED=true
SONA_ADAPTATION_TIME=0.05
SONA_LEARNING_RATE=0.001
SONA_MODE=balanced

# MoE Configuration
MOE_ENABLED=true
MOE_EXPERT_COUNT=12
MOE_TOP_K=3
MOE_LOAD_BALANCING=true
MOE_SPECIALIZATION=adaptive

# HNSW Configuration
HNSW_ENABLED=true
HNSW_M=32
HNSW_EF=400
HNSW_EF_CONSTRUCTION=400
HNSW_SPACE=cosine

# EWC++ Configuration
EWC_ENABLED=true
EWC_LAMBDA=0.5
EWC_CONSOLIDATION_INTERVAL=100

# Flash Attention Configuration
FLASH_ATTENTION_ENABLED=true
FLASH_ATTENTION_BLOCK_SIZE=64
FLASH_ATTENTION_TARGET_SPEEDUP=5.0

# LoRA Configuration
LORA_ENABLED=true
LORA_RANK=8
LORA_ALPHA=16
LORA_DROPOUT=0.1

# Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32

# Intelligence Pipeline
TRAJECTORY_TRACKING=true
VERDICT_JUDGMENT=true
PATTERN_DISTILLATION=true
MEMORY_CONSOLIDATION=true

# Performance
MAX_WORKERS=4
CACHE_SIZE=10000

# Logging
LOG_LEVEL=INFO
