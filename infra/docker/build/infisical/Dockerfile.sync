# Infisical Secrets Sync Service
FROM alpine:3.19 AS base

# Install dependencies
RUN apk add --no-cache \
    curl \
    bash \
    jq \
    tini \
    ca-certificates

# Install Infisical CLI
RUN curl -1sLf 'https://dl.cloudsmith.io/public/infisical/infisical-cli/setup.alpine.sh' | bash && \
    apk add infisical

# Create app user
RUN addgroup -g 1001 -S infisical && \
    adduser -S sync -u 1001 -G infisical

# Set working directory
WORKDIR /app

# Create sync script
COPY --chown=sync:infisical scripts/sync-secrets.sh /app/sync-secrets.sh
RUN chmod +x /app/sync-secrets.sh

# Create necessary directories
RUN mkdir -p {shared,config,logs} && \
    chown -R sync:infisical /app

# Switch to app user
USER sync

# Expose sync service port
EXPOSE 8006

# Health check
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD test -f /app/shared/.env.synced && echo "Secrets synced" || exit 1

# Use tini as entrypoint
ENTRYPOINT ["/sbin/tini", "--"]

# Start sync service
CMD ["/app/sync-secrets.sh"]