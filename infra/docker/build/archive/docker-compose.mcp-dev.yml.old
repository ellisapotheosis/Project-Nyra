# Docker Compose - MCP Servers Development Environment
# Project Nyra - Development MCP Server Stack
version: '3.8'

services:
  # MCP Gemini Assistant
  mcp-gemini:
    build:
      context: ../../bootstrap/mcp-gemini-assistant
      dockerfile: Dockerfile
    container_name: nyra-mcp-gemini-dev
    environment:
      - GEMINI_API_KEY=${GOOGLE_GEMINI_API_KEY}
      - GEMINI_MODEL=gemini-2.0-flash-exp
      - SESSION_TIMEOUT=3600
      - MAX_FILE_SIZE=1048576
      - LOG_LEVEL=debug
    volumes:
      # Mount source for hot-reload in development
      - ../../bootstrap/mcp-gemini-assistant:/app:ro
      # Persistent session data
      - mcp-gemini-sessions:/app/data/sessions
      # Development logs
      - ./logs/mcp-gemini:/app/logs
    networks:
      - mcp-network
    restart: unless-stopped
    labels:
      - "com.project-nyra.service=mcp-gemini"
      - "com.project-nyra.environment=development"

  # Claude Flow MCP Server
  mcp-claude-flow:
    build:
      context: ../../bootstrap/mcp-servers/claude-flow
      dockerfile: Dockerfile
    container_name: nyra-mcp-claude-flow-dev
    environment:
      - CLAUDE_FLOW_MEMORY=true
      - CLAUDE_FLOW_DISTRIBUTED=true
      - ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
      - NODE_ENV=development
      - LOG_LEVEL=debug
    volumes:
      # Persistent memory and session data
      - mcp-claude-flow-data:/app/data
      # Development logs
      - ./logs/mcp-claude-flow:/app/logs
      # Claude Flow configuration
      - ../../.claude-flow:/app/.claude-flow:ro
    networks:
      - mcp-network
    restart: unless-stopped
    labels:
      - "com.project-nyra.service=mcp-claude-flow"
      - "com.project-nyra.environment=development"

  # RuV Swarm MCP Server
  mcp-ruv-swarm:
    build:
      context: ../../bootstrap/mcp-servers/ruv-swarm
      dockerfile: Dockerfile
    container_name: nyra-mcp-ruv-swarm-dev
    environment:
      - RUV_SWARM_DISTRIBUTED=true
      - NODE_ENV=development
      - LOG_LEVEL=debug
    volumes:
      # Persistent swarm data
      - mcp-ruv-swarm-data:/app/data
      # Development logs
      - ./logs/mcp-ruv-swarm:/app/logs
      # Swarm configuration
      - ../../.swarm:/app/.swarm:ro
    networks:
      - mcp-network
    restart: unless-stopped
    labels:
      - "com.project-nyra.service=mcp-ruv-swarm"
      - "com.project-nyra.environment=development"

  # Archon OS MCP Server
  mcp-archon:
    build:
      context: ../../bootstrap/archon-os
      dockerfile: Dockerfile.mcp
    container_name: nyra-mcp-archon-dev
    environment:
      - SUPABASE_URL=${SUPABASE_URL}
      - SUPABASE_SERVICE_KEY=${SUPABASE_SERVICE_KEY}
      - ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
      - MCP_PORT=8051
      - LOG_LEVEL=debug
    volumes:
      # Mount source for hot-reload in development
      - ../../bootstrap/archon-os/backend:/app:ro
      # Persistent knowledge base cache
      - mcp-archon-data:/app/data
      # Development logs
      - ./logs/mcp-archon:/app/logs
    ports:
      - "8051:8051"
    networks:
      - mcp-network
    restart: unless-stopped
    depends_on:
      - postgres-mcp
    labels:
      - "com.project-nyra.service=mcp-archon"
      - "com.project-nyra.environment=development"

  # PostgreSQL for MCP data (development)
  postgres-mcp:
    image: postgres:15-alpine
    container_name: nyra-postgres-mcp-dev
    environment:
      - POSTGRES_DB=mcp_development
      - POSTGRES_USER=mcp_dev
      - POSTGRES_PASSWORD=mcp_dev_password
    volumes:
      - postgres-mcp-data:/var/lib/postgresql/data
      - ./init-scripts:/docker-entrypoint-initdb.d:ro
    ports:
      - "5433:5432"
    networks:
      - mcp-network
    restart: unless-stopped
    labels:
      - "com.project-nyra.service=postgres-mcp"
      - "com.project-nyra.environment=development"

  # Redis for MCP caching (development)
  redis-mcp:
    image: redis:7-alpine
    container_name: nyra-redis-mcp-dev
    command: redis-server --appendonly yes
    volumes:
      - redis-mcp-data:/data
    ports:
      - "6380:6379"
    networks:
      - mcp-network
    restart: unless-stopped
    labels:
      - "com.project-nyra.service=redis-mcp"
      - "com.project-nyra.environment=development"

networks:
  mcp-network:
    name: nyra-mcp-dev-network
    driver: bridge

volumes:
  mcp-gemini-sessions:
    name: nyra-mcp-gemini-sessions-dev
  mcp-claude-flow-data:
    name: nyra-mcp-claude-flow-data-dev
  mcp-ruv-swarm-data:
    name: nyra-mcp-ruv-swarm-data-dev
  mcp-archon-data:
    name: nyra-mcp-archon-data-dev
  postgres-mcp-data:
    name: nyra-postgres-mcp-data-dev
  redis-mcp-data:
    name: nyra-redis-mcp-data-dev
