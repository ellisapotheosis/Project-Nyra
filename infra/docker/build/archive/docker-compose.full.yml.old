# ============================================================================
# Project Nyra - Complete Full Stack - Docker Compose
# ============================================================================
# Complete orchestration of all services including:
# - Core Databases (PostgreSQL, Redis, FalkorDB, Qdrant)
# - Orchestration (Claude Flow, Archon OS, Nexus Router)
# - AI Services (Letta, Open-WebUI, LobeChat)
# - Observability (Prometheus, Grafana, Loki)
# - Add-ons (n8n, Dify)
# - Development Tools
#
# Usage:
#   docker compose -f docker-compose.full.yml up -d
#   docker compose -f docker-compose.full.yml down
#
# With Infisical:
#   infisical run --projectId="8374cea9-e5e8-4050-bda4-b91f25ab30ef" \
#     --env="dev" --path="/shared" -- docker compose -f docker-compose.full.yml up -d
# ============================================================================

version: '3.8'

networks:
  nyra-network:
    driver: bridge
    ipam:
      config:
        - subnet: 172.28.0.0/16

# ============================================================================
# SERVICES
# ============================================================================
services:
  # ==========================================================================
  # DATABASE LAYER
  # ==========================================================================

  # PostgreSQL - Primary data store
  postgresql:
    image: postgres:16-alpine
    container_name: nyra-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-nyra_user}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-nyra_secure_password}
      POSTGRES_DB: ${POSTGRES_DB:-nyra_db}
      POSTGRES_MULTIPLE_DATABASES: ${LETTA_DB_NAME:-letta_db},${TWENTY_DB_NAME:-twenty_db},${DIFY_DB_NAME:-dify_db},${N8N_DB_NAME:-n8n_db}
      PGDATA: /var/lib/postgresql/data/pgdata
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./scripts/postgres-init:/docker-entrypoint-initdb.d
    ports:
      - "${POSTGRES_PORT:-5432}:5432"
    networks:
      - nyra-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-nyra_user}"]
      interval: 10s
      timeout: 5s
      retries: 5
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 4G
        reservations:
          cpus: '1.0'
          memory: 2G

  # Redis - Caching and session storage
  redis:
    image: redis:7-alpine
    container_name: nyra-redis
    restart: unless-stopped
    command: >
      redis-server
      --requirepass ${REDIS_PASSWORD:-redis_secure_pass}
      --maxmemory ${REDIS_MAX_MEMORY:-2gb}
      --maxmemory-policy ${REDIS_EVICTION_POLICY:-allkeys-lru}
      --appendonly yes
      --appendfsync everysec
    environment:
      REDIS_PASSWORD: ${REDIS_PASSWORD:-redis_secure_pass}
    volumes:
      - redis_data:/data
    ports:
      - "${REDIS_PORT:-6379}:6379"
    networks:
      - nyra-network
    healthcheck:
      test: ["CMD", "redis-cli", "--raw", "incr", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 2G
        reservations:
          cpus: '0.5'
          memory: 1G

  # FalkorDB - Temporal knowledge graphs
  falkordb:
    image: falkordb/falkordb:latest
    container_name: nyra-falkordb
    restart: unless-stopped
    command: >
      redis-server
      --requirepass ${FALKORDB_PASSWORD:-falkordb_secure_pass}
      --appendonly yes
      --appendfsync ${FALKORDB_AOF_SYNC:-everysec}
      --maxmemory ${FALKORDB_MAX_MEMORY:-4gb}
    environment:
      REDIS_PASSWORD: ${FALKORDB_PASSWORD:-falkordb_secure_pass}
    volumes:
      - falkordb_data:/data
    ports:
      - "${FALKORDB_PORT:-6380}:6379"
    networks:
      - nyra-network
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "${FALKORDB_PASSWORD:-falkordb_secure_pass}", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 4G
        reservations:
          cpus: '1.0'
          memory: 2G

  # Qdrant - Vector database
  qdrant:
    image: qdrant/qdrant:latest
    container_name: nyra-qdrant
    restart: unless-stopped
    environment:
      QDRANT__SERVICE__API_KEY: ${QDRANT_API_KEY:-qdrant_secure_key}
      QDRANT__SERVICE__GRPC_PORT: 6334
      QDRANT__STORAGE__STORAGE_PATH: /qdrant/storage
    volumes:
      - qdrant_data:/qdrant/storage
    ports:
      - "${QDRANT_PORT:-6333}:6333"
      - "6334:6334"  # GRPC port
    networks:
      - nyra-network
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:6333/health"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 4G
        reservations:
          cpus: '1.0'
          memory: 2G

  # ==========================================================================
  # ORCHESTRATION LAYER
  # ==========================================================================

  # Claude Flow - Multi-agent workflow orchestration
  claude-flow:
    image: node:20-alpine
    container_name: nyra-claude-flow
    restart: unless-stopped
    working_dir: /app
    command: sh -c "npm install -g pnpm && pnpm install && pnpm start"
    environment:
      NODE_ENV: ${NODE_ENV:-production}
      PORT: ${CLAUDE_FLOW_PORT:-9000}
      DATABASE_URL: ${DATABASE_URL:-postgresql://nyra_user:nyra_secure_password@postgresql:5432/nyra_db}
      REDIS_URL: ${REDIS_URL:-redis://:redis_secure_pass@redis:6379}
      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY}
      OPENROUTER_API_KEY: ${OPENROUTER_API_KEY}
      CLAUDE_FLOW_MODE: ${CLAUDE_FLOW_MODE:-dual-orchestrator}
      CLAUDE_FLOW_TELEMETRY_ENABLED: ${CLAUDE_FLOW_TELEMETRY_ENABLED:-true}
      CLAUDE_FLOW_PERFORMANCE_MODE: ${CLAUDE_FLOW_PERFORMANCE_MODE:-high}
      CLAUDE_FLOW_AUTO_COMMIT: ${CLAUDE_FLOW_AUTO_COMMIT:-false}
      CLAUDE_FLOW_HOOKS_ENABLED: ${CLAUDE_FLOW_HOOKS_ENABLED:-true}
      CLAUDE_FLOW_NEURAL_OPTIMIZATION: ${CLAUDE_FLOW_NEURAL_OPTIMIZATION:-true}
      GITHUB_TOKEN: ${GITHUB_TOKEN}
      GITHUB_REPO: ${GITHUB_REPO:-Project-Nyra}
      GITHUB_OWNER: ${GITHUB_OWNER}
    volumes:
      - ../../orchestration/claude-flow:/app
      - claude_flow_data:/app/data
      - /var/run/docker.sock:/var/run/docker.sock
    ports:
      - "${CLAUDE_FLOW_PORT:-9000}:${CLAUDE_FLOW_PORT:-9000}"
    networks:
      - nyra-network
    depends_on:
      postgresql:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:${CLAUDE_FLOW_PORT:-9000}/health"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 2G
        reservations:
          cpus: '1.0'
          memory: 1G

  # Archon OS - Agent operating system
  archon-os:
    image: node:20-alpine
    container_name: nyra-archon-os
    restart: unless-stopped
    working_dir: /app
    command: sh -c "npm install -g pnpm && pnpm install && pnpm start"
    environment:
      NODE_ENV: ${NODE_ENV:-production}
      PORT: ${ARCHON_PORT:-9001}
      DATABASE_URL: ${DATABASE_URL:-postgresql://nyra_user:nyra_secure_password@postgresql:5432/nyra_db}
      REDIS_URL: ${REDIS_URL:-redis://:redis_secure_pass@redis:6379}
      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY}
      ARCHON_MCP_PORT: ${ARCHON_MCP_PORT:-9002}
      ARCHON_TOPOLOGY: ${ARCHON_TOPOLOGY:-hierarchical}
      ARCHON_MAX_DEPTH: ${ARCHON_MAX_DEPTH:-5}
      ARCHON_PARALLEL_BRANCHES: ${ARCHON_PARALLEL_BRANCHES:-10}
    volumes:
      - ../../orchestration/archon-os:/app
      - archon_data:/app/data
    ports:
      - "${ARCHON_PORT:-9001}:${ARCHON_PORT:-9001}"
      - "${ARCHON_MCP_PORT:-9002}:${ARCHON_MCP_PORT:-9002}"
    networks:
      - nyra-network
    depends_on:
      postgresql:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:${ARCHON_PORT:-9001}/health"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 2G
        reservations:
          cpus: '1.0'
          memory: 1G

  # Nexus Router - Intelligent LLM request routing
  nexus-router:
    image: node:20-alpine
    container_name: nyra-nexus-router
    restart: unless-stopped
    working_dir: /app
    command: sh -c "npm install && npm start"
    environment:
      NODE_ENV: ${NODE_ENV:-production}
      PORT: ${NEXUS_ROUTER_PORT:-8000}
      MCP_PORT: ${NEXUS_ROUTER_MCP_PORT:-4001}
      REDIS_URL: ${REDIS_URL:-redis://:redis_secure_pass@redis:6379}

      # Local GPU Workers
      WORKER_5090_URL: ${WORKER_5090_URL:-http://localhost:8001}
      WORKER_5090_MODELS: ${WORKER_5090_MODELS:-llama-3.1-405b,qwen-2.5-72b,deepseek-v3}
      WORKER_3090_URL: ${WORKER_3090_URL:-http://localhost:8002}
      WORKER_3090_MODELS: ${WORKER_3090_MODELS:-llama-3.1-70b,qwen-2.5-32b,mixtral-8x22b}
      WORKER_3060_URL: ${WORKER_3060_URL:-http://localhost:8003}
      WORKER_3060_MODELS: ${WORKER_3060_MODELS:-llama-3.1-8b,qwen-2.5-7b,deepseek-coder-6.7b}

      # Cloud API Fallbacks
      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY}
      ANTHROPIC_MODEL: ${ANTHROPIC_MODEL:-claude-sonnet-4-20250514}
      OPENROUTER_API_KEY: ${OPENROUTER_API_KEY}
      OPENROUTER_BASE_URL: ${OPENROUTER_BASE_URL:-https://openrouter.ai/api/v1}

      # Routing Strategy
      MODEL_ROUTING_STRATEGY: ${MODEL_ROUTING_STRATEGY:-cost-optimized}
      MODEL_ROUTING_PREFER_LOCAL: ${MODEL_ROUTING_PREFER_LOCAL:-true}
      MODEL_ROUTING_FALLBACK_CLOUD: ${MODEL_ROUTING_FALLBACK_CLOUD:-true}
      MODEL_ROUTING_COST_THRESHOLD: ${MODEL_ROUTING_COST_THRESHOLD:-0.10}
    volumes:
      - ../../services/nexus-router:/app
      - nexus_router_data:/app/data
    ports:
      - "${NEXUS_ROUTER_PORT:-8000}:${NEXUS_ROUTER_PORT:-8000}"
      - "${NEXUS_ROUTER_MCP_PORT:-4001}:${NEXUS_ROUTER_MCP_PORT:-4001}"
    networks:
      - nyra-network
    depends_on:
      - redis
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:${NEXUS_ROUTER_PORT:-8000}/health"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 1G
        reservations:
          cpus: '0.5'
          memory: 512M

  # ==========================================================================
  # AI SERVICES LAYER
  # ==========================================================================

  # Letta - Agent memory management
  letta:
    image: letta/letta:latest
    container_name: nyra-letta
    restart: unless-stopped
    environment:
      LETTA_SERVER_PASSWORD: ${LETTA_SERVER_PASSWORD:-letta_secure_pass_2024}
      LETTA_POSTGRES_URI: ${LETTA_POSTGRES_URI:-postgresql://nyra_user:nyra_secure_password@postgresql:5432/letta_db}
      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY}
      LETTA_LLM_ENDPOINT: http://nexus-router:${NEXUS_ROUTER_PORT:-8000}/v1
    volumes:
      - letta_data:/root/.letta
    ports:
      - "8283:8283"
      - "8284:8284"
    networks:
      - nyra-network
    depends_on:
      postgresql:
        condition: service_healthy
      nexus-router:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8283/health"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 2G
        reservations:
          cpus: '0.5'
          memory: 1G

  # Open-WebUI - Primary development interface
  open-webui:
    image: ghcr.io/open-webui/open-webui:main
    container_name: nyra-open-webui
    restart: unless-stopped
    environment:
      DATABASE_URL: ${DATABASE_URL:-postgresql://nyra_user:nyra_secure_password@postgresql:5432/nyra_db}
      OPENAI_API_BASE_URL: http://nexus-router:${NEXUS_ROUTER_PORT:-8000}/v1
      OPENAI_API_KEY: ${ANTHROPIC_API_KEY}
      WEBUI_SECRET_KEY: ${SESSION_SECRET:-$(openssl rand -base64 32)}
      ENABLE_SIGNUP: "false"
      ENABLE_RAG: "true"
      ENABLE_IMAGE_GENERATION: "false"
      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY}
      OPENROUTER_API_KEY: ${OPENROUTER_API_KEY}
    volumes:
      - open_webui_data:/app/backend/data
    ports:
      - "${OPEN_WEBUI_PORT:-3210}:8080"
    networks:
      - nyra-network
    depends_on:
      postgresql:
        condition: service_healthy
      nexus-router:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/health"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 2G
        reservations:
          cpus: '1.0'
          memory: 1G

  # LobeChat - Alternative development interface
  lobechat:
    image: lobehub/lobe-chat:latest
    container_name: nyra-lobechat
    restart: unless-stopped
    environment:
      DATABASE_URL: ${DATABASE_URL:-postgresql://nyra_user:nyra_secure_password@postgresql:5432/nyra_db}
      OPENAI_API_KEY: ${ANTHROPIC_API_KEY}
      OPENAI_PROXY_URL: http://nexus-router:${NEXUS_ROUTER_PORT:-8000}/v1
      ACCESS_CODE: ${LOBECHAT_ACCESS_CODE:-}
      ENABLE_OAUTH_SSO: "false"
      NEXT_PUBLIC_BASE_PATH: ""
    volumes:
      - lobechat_data:/app/.next
    ports:
      - "${LOBECHAT_PORT:-3211}:3210"
    networks:
      - nyra-network
    depends_on:
      postgresql:
        condition: service_healthy
      nexus-router:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:3210/api/health"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 1G
        reservations:
          cpus: '0.5'
          memory: 512M

  # ==========================================================================
  # WORKFLOW AUTOMATION LAYER
  # ==========================================================================

  # n8n - Workflow automation
  n8n:
    image: n8nio/n8n:latest
    container_name: nyra-n8n
    restart: unless-stopped
    environment:
      N8N_HOST: ${N8N_HOST:-localhost}
      N8N_PORT: 5678
      N8N_PROTOCOL: http
      WEBHOOK_URL: http://localhost:5678/
      GENERIC_TIMEZONE: America/Los_Angeles
      N8N_BASIC_AUTH_ACTIVE: "true"
      N8N_BASIC_AUTH_USER: ${N8N_BASIC_AUTH_USER:-nyra}
      N8N_BASIC_AUTH_PASSWORD: ${N8N_BASIC_AUTH_PASSWORD:-changeme}
      DB_TYPE: postgresdb
      DB_POSTGRESDB_HOST: postgresql
      DB_POSTGRESDB_PORT: 5432
      DB_POSTGRESDB_DATABASE: ${N8N_DB_NAME:-n8n_db}
      DB_POSTGRESDB_USER: ${POSTGRES_USER:-nyra_user}
      DB_POSTGRESDB_PASSWORD: ${POSTGRES_PASSWORD:-nyra_secure_password}
    volumes:
      - n8n_data:/home/node/.n8n
    ports:
      - "5678:5678"
    networks:
      - nyra-network
    depends_on:
      postgresql:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:5678/healthz"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 2G
        reservations:
          cpus: '0.5'
          memory: 1G

  # ==========================================================================
  # OBSERVABILITY LAYER
  # ==========================================================================

  # Prometheus - Metrics collection
  prometheus:
    image: prom/prometheus:latest
    container_name: nyra-prometheus
    restart: unless-stopped
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--web.console.libraries=/etc/prometheus/console_libraries'
      - '--web.console.templates=/etc/prometheus/consoles'
      - '--storage.tsdb.retention.time=30d'
      - '--web.enable-lifecycle'
    volumes:
      - ./observability/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./observability/prometheus-alerts.yml:/etc/prometheus/alerts/alerts.yml:ro
      - prometheus_data:/prometheus
    ports:
      - "9090:9090"
    networks:
      - nyra-network
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:9090/-/healthy"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 2G
        reservations:
          cpus: '0.5'
          memory: 1G

  # Grafana - Visualization and dashboards
  grafana:
    image: grafana/grafana:latest
    container_name: nyra-grafana
    restart: unless-stopped
    environment:
      GF_SECURITY_ADMIN_USER: ${GRAFANA_ADMIN_USER:-admin}
      GF_SECURITY_ADMIN_PASSWORD: ${GRAFANA_ADMIN_PASSWORD:-admin}
      GF_INSTALL_PLUGINS: grafana-piechart-panel,grafana-clock-panel
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_SERVER_ROOT_URL: http://localhost:3000
      GF_AUTH_ANONYMOUS_ENABLED: "false"
    volumes:
      - ./observability/grafana-datasources.yml:/etc/grafana/provisioning/datasources/datasources.yml:ro
      - ./observability/dashboards:/etc/grafana/provisioning/dashboards:ro
      - grafana_data:/var/lib/grafana
    ports:
      - "3000:3000"
    networks:
      - nyra-network
    depends_on:
      - prometheus
      - loki
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:3000/api/health"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 1G
        reservations:
          cpus: '0.5'
          memory: 512M

  # Loki - Log aggregation
  loki:
    image: grafana/loki:latest
    container_name: nyra-loki
    restart: unless-stopped
    command: -config.file=/etc/loki/local-config.yaml
    volumes:
      - ./observability/loki-config.yml:/etc/loki/local-config.yaml:ro
      - loki_data:/loki
    ports:
      - "3100:3100"
    networks:
      - nyra-network
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:3100/ready"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 2G
        reservations:
          cpus: '0.5'
          memory: 1G

  # Promtail - Log shipping to Loki
  promtail:
    image: grafana/promtail:latest
    container_name: nyra-promtail
    restart: unless-stopped
    command: -config.file=/etc/promtail/config.yml
    volumes:
      - ./observability/promtail-config.yml:/etc/promtail/config.yml:ro
      - /var/log:/var/log:ro
      - /var/lib/docker/containers:/var/lib/docker/containers:ro
      - /var/run/docker.sock:/var/run/docker.sock
    networks:
      - nyra-network
    depends_on:
      - loki
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512M
        reservations:
          cpus: '0.25'
          memory: 256M

  # Node Exporter - System metrics
  node-exporter:
    image: prom/node-exporter:latest
    container_name: nyra-node-exporter
    restart: unless-stopped
    command:
      - '--path.procfs=/host/proc'
      - '--path.sysfs=/host/sys'
      - '--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)'
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro
    ports:
      - "9100:9100"
    networks:
      - nyra-network
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: 128M
        reservations:
          cpus: '0.1'
          memory: 64M

  # cAdvisor - Container metrics
  cadvisor:
    image: gcr.io/cadvisor/cadvisor:latest
    container_name: nyra-cadvisor
    restart: unless-stopped
    privileged: true
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:rw
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
    ports:
      - "8080:8080"
    networks:
      - nyra-network
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 256M
        reservations:
          cpus: '0.25'
          memory: 128M

  # Alertmanager - Alert routing and notifications
  alertmanager:
    image: prom/alertmanager:latest
    container_name: nyra-alertmanager
    restart: unless-stopped
    command:
      - '--config.file=/etc/alertmanager/config.yml'
      - '--storage.path=/alertmanager'
    volumes:
      - ./observability/alertmanager.yml:/etc/alertmanager/config.yml:ro
      - alertmanager_data:/alertmanager
    ports:
      - "9093:9093"
    networks:
      - nyra-network
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:9093/-/healthy"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512M
        reservations:
          cpus: '0.25'
          memory: 256M

# ============================================================================
# VOLUMES
# ============================================================================
volumes:
  postgres_data:
    driver: local
  redis_data:
    driver: local
