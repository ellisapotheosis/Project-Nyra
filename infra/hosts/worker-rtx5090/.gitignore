# Worker RTX 5090 - Git Ignore

# Environment files (contain secrets)
.env
.env.worker-5090
.env.local
.env.*.local

# Infisical secrets
.infisical.json

# Logs
*.log
health-monitor.log
setup-log.json

# Cloudflared credentials
*credentials*.json
*.pem

# Docker volumes
ollama-models/
models/
data/

# Backup files
*.backup
*.bak
*.old

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# PowerShell
*.ps1.bak

# Temporary files
*.tmp
*.temp
~*

# Job outputs
job-*.txt

# VRAM dumps
*.vram

# Model cache
.cache/
__pycache__/

# IDE
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store

# Node modules (if any)
node_modules/

# Python
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
