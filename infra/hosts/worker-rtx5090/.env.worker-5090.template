# Worker RTX 5090 Environment Variables
# Copy this file to .env and fill in your values

# ==========================================
# WORKER IDENTIFICATION
# ==========================================
WORKER_ID=worker-5090
GPU_WORKER_ID=worker-rtx5090
WORKER_ROLE=primary_reasoning
GPU_TYPE=rtx_5090
VRAM_GB=48

# ==========================================
# NETWORKING
# ==========================================
MACHINE_HOSTNAME=YOUR_HOSTNAME
MACHINE_IP_ETHERNET=YOUR_IP_ADDRESS
MACHINE_IP_TAILSCALE=YOUR_TAILSCALE_IP
TAILSCALE_HOSTNAME=worker-5090.tail-net.ts.net

# Ports
OLLAMA_PORT=11434
LITELLM_PORT=4000
MODEL_MANAGER_PORT=8080
PERF_MONITOR_PORT=9090
HEALTH_CHECK_PORT=8081

# ==========================================
# OLLAMA CONFIGURATION
# ==========================================
OLLAMA_HOST=0.0.0.0
OLLAMA_MODELS=/app/models
OLLAMA_NUM_PARALLEL=8
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=30m
OLLAMA_MAX_VRAM=46GB

# ==========================================
# LITELLM CONFIGURATION
# ==========================================
LITELLM_MASTER_KEY=your-litellm-master-key-here
LITELLM_DATABASE_URL=postgresql://postgres:password@postgres:5432/litellm
LITELLM_LOG=INFO

# ==========================================
# ORCHESTRATOR INTEGRATION
# ==========================================
ORCHESTRATOR_URL=http://nexus:7000
NEXUS_ROUTER_URL=http://nexus.tail-net.ts.net:7000
NEXUS_ADMIN_TOKEN=your-nexus-admin-token-here
NEXUS_JWT_SECRET=your-jwt-secret-here

# ==========================================
# MONITORING
# ==========================================
PROMETHEUS_PUSH_GATEWAY=http://prometheus:9091
LOKI_URL=http://loki:3100
GRAFANA_URL=http://grafana:3005

# Alert Thresholds
ALERT_THRESHOLD_GPU_TEMP=85
ALERT_THRESHOLD_VRAM_USAGE=90
ALERT_THRESHOLD_INFERENCE_TIME=10

# ==========================================
# HEALTH CHECK CONFIGURATION
# ==========================================
CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=15
HEALTH_CHECK_RETRIES=3

# Services to monitor
SERVICES=ollama,litellm,model-manager,perf-monitor

# ==========================================
# MODEL CONFIGURATION
# ==========================================
PRIMARY_MODELS=deepseek-r1:236b-instruct-q4_K_M,qwen2.5:72b-instruct-q5_K_M
SPECIALIZATION=complex_reasoning,mortgage_calculations,compliance_analysis

# ==========================================
# SECURITY
# ==========================================
TAILSCALE_KEY=tskey-auth-xxxxxxxxxxxxx
CLOUDFLARED_TOKEN=your-cloudflared-token-here

# ==========================================
# INFISICAL (SECRET MANAGEMENT)
# ==========================================
INFISICAL_PROJECT_ID=8374cea9-e5e8-4050-bda4-b91f25ab30ef
INFISICAL_ENV=dev
INFISICAL_PATH=/worker-5090
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
INFISICAL_TOKEN=

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=/app/logs/worker-5090.log

# ==========================================
# PERFORMANCE TUNING
# ==========================================
# GPU settings
NVIDIA_VISIBLE_DEVICES=0
CUDA_VISIBLE_DEVICES=0

# Docker resource limits
DOCKER_CPU_LIMIT=16
DOCKER_MEMORY_LIMIT=32G

# ==========================================
# CLOUDFLARED TUNNEL (OPTIONAL)
# ==========================================
CLOUDFLARED_TUNNEL_NAME=worker-5090
CLOUDFLARED_HOSTNAME=worker-5090.projectnyra.com
CLOUDFLARED_LITELLM_HOSTNAME=litellm-5090.projectnyra.com
