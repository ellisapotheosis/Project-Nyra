VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_PORT=8000
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_MEMORY_UTILIZATION=0.85
LITELLM_PORT=4000
REDIS_PORT=6379
REDIS_MAX_MEMORY=4gb
LMCACHE_REDIS_PORT=6379
CADVISOR_PORT=8081
TAILSCALE_AUTHKEY=tskey-auth-xxxx

# Infisical sidecar auth. INFISICAL_TOKEN may come from exported shell env,
# gitignored host .env, Portainer, systemd, or a machine secret store.
# The sidecar writes fetched values to /run/nyra-secrets.
INFISICAL_TOKEN=
INFISICAL_PROJECT_ID=8374cea9-e5e8-4050-bda4-b91f25ab30ef
INFISICAL_ENV=prod
INFISICAL_PATH=/machines/worker-rtx5090
INFISICAL_POLL_INTERVAL=60

# Required by shared worker observability overlays.
GRAFANA_ADMIN_PASSWORD=

# Required when assistant or voice/unmute stacks are enabled.
NEXUS_ADMIN_TOKEN=
UNMUTE_OPENAI_API_KEY=
