{
  "mcpServers": {
    "fetch": {
      "image": "mcp/fetch"
    },
    "filesystem": {
      "image": "mcp/filesystem",
      "args": ["/repos", "/home/user"],
      "volumes": [
        "/home/ellisapotheosis/repos:/repos:rw",
        "/home/ellisapotheosis:/home/user:rw"
      ]
    },
    "git": {
      "image": "mcp/git",
      "volumes": ["/home/ellisapotheosis/repos:/repos:rw"]
    },
    "time": {
      "image": "mcp/time"
    },
    "desktop-commander": {
      "command": "npx",
      "args": ["-y", "@wonderwhy-er/desktop-commander"],
      "env": {}
    }
  }
}
