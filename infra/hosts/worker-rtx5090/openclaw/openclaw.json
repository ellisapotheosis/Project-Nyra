{
  "plugins": {
    "allow": ["openclaw-mem0"],
    "slots": {
      "memory": "openclaw-mem0"
    },
    "entries": {
      "openclaw-mem0": {
        "enabled": false,
        "hooks": {
          "allowConversationAccess": true
        },
        "config": {
          "mode": "open-source",
          "userId": "nyra",
          "autoRecall": true,
          "autoCapture": true,
          "enableGraph": true,
          "topK": 5,
          "searchThreshold": 0.3,
          "oss": {
            "embedder": {
              "provider": "openai",
              "config": {
                "model": "text-embedding-3-small",
                "api_key": "REPLACE_WITH_LITELLM_API_KEY",
                "base_url": "https://litellm.projectnyra.com/v1"
              }
            },
            "vectorStore": {
              "provider": "memory",
              "config": { "dimension": 1536 }
            },
            "graphStore": {
              "provider": "falkordb",
              "config": {
                "host": "falkordb.projectnyra.com",
                "port": 6379,
                "graphName": "mem0"
              }
            },
            "llm": {
              "provider": "openai",
              "config": {
                "model": "gpt-4o-mini",
                "api_key": "REPLACE_WITH_LITELLM_API_KEY",
                "base_url": "https://litellm.projectnyra.com/v1"
              }
            }
          }
        }
      }
    }
  }
}
