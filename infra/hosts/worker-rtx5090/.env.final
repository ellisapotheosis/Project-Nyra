# Worker RTX 5090 - Final env template (vLLM + LMCache + Redis)

INFISICAL_TOKEN=${INFISICAL_TOKEN}
INFISICAL_PROJECT_ID=${INFISICAL_PROJECT_ID}
INFISICAL_ENV=${INFISICAL_ENV:-prod}
INFISICAL_PATH=/machines/worker-rtx5090

# --- Secrets from Infisical ---
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
REDIS_PASSWORD=${REDIS_PASSWORD}
API_KEY_PC3=${API_KEY_PC3}
API_SECRET=${API_SECRET}
TAILSCALE_AUTHKEY=${TAILSCALE_AUTHKEY}
OPENAI_API_KEY=${OPENAI_API_KEY}
OPENROUTER_API_KEY=${OPENROUTER_API_KEY}
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
GOOGLE_API_KEY=${GOOGLE_API_KEY}
HF_TOKEN=${HF_TOKEN}
CLOUDFLARE_TUNNEL_TOKEN=${CLOUDFLARE_TUNNEL_TOKEN}

# --- High-value tunables ---
NODE_ENV=production
VLLM_MODEL=HauhauCS/Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_MEMORY_UTILIZATION=0.92
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_ENABLE_PREFIX_CACHING=true
VLLM_ENABLE_CHUNKED_PREFILL=true
VLLM_MAX_NUM_BATCHED_TOKENS=16384
VLLM_KV_CACHE_DTYPE=auto
LMCACHE_ENABLED=true
LMCACHE_MAX_SIZE=40GB
LMCACHE_CHUNK_SIZE=256
LMCACHE_TTL=86400
LMCACHE_REDIS_URL=redis://redis:6379
