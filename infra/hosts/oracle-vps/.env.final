# Oracle VPS - Final env template (external-facing + non latency-sensitive services)

INFISICAL_TOKEN=${INFISICAL_TOKEN}
INFISICAL_PROJECT_ID=${INFISICAL_PROJECT_ID}
INFISICAL_ENV=${INFISICAL_ENV:-prod}
INFISICAL_PATH=/machines/oracle-vps

# --- Secrets from Infisical ---
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
REDIS_PASSWORD=${REDIS_PASSWORD}
TWENTY_APP_SECRET=${TWENTY_APP_SECRET}
TWENTY_ENCRYPTION_SECRET=${TWENTY_ENCRYPTION_SECRET}
TWENTY_JWT_SECRET=${TWENTY_JWT_SECRET}
TWENTY_PASSWORD_SALT=${TWENTY_PASSWORD_SALT}
AP_POSTGRES_PASSWORD=${AP_POSTGRES_PASSWORD}
AP_ENCRYPTION_KEY=${AP_ENCRYPTION_KEY}
AP_JWT_SECRET=${AP_JWT_SECRET}
N8N_ENCRYPTION_KEY=${N8N_ENCRYPTION_KEY}
N8N_BASIC_AUTH_USER=${N8N_BASIC_AUTH_USER}
N8N_BASIC_AUTH_PASSWORD=${N8N_BASIC_AUTH_PASSWORD}
CLAWDBOT_GATEWAY_TOKEN=${CLAWDBOT_GATEWAY_TOKEN}
QUOTE_API_SECRET=${QUOTE_API_SECRET}
OPENAI_API_KEY=${OPENAI_API_KEY}
OPENROUTER_API_KEY=${OPENROUTER_API_KEY}
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
GEMINI_API_KEY=${GEMINI_API_KEY}
CLOUDFLARED_TUNNEL_TOKEN=${CLOUDFLARED_TUNNEL_TOKEN}
CLOUDFLARE_API_TOKEN=${CLOUDFLARE_API_TOKEN}

# --- Non-secret high-value knobs ---
NODE_ENV=production
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=30
CONNECTION_POOL_SIZE=10
MAX_CONNECTIONS=50
