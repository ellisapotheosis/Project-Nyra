# =============================================================================
# infra/oracle/.env.oracle.template
# Oracle VPS standalone stack — environment template.
# Copy to infra/oracle/.env.oracle, fill values from Infisical.
# NEVER commit .env.oracle — it is gitignored.
# =============================================================================

# ── Postgres (shared: ruvector, n8n, activepieces) ─────────────────────────
POSTGRES_USER=ruvector
POSTGRES_PASSWORD=__FROM_INFISICAL__
POSTGRES_DB=twenty

# ── TwentyCRM ──────────────────────────────────────────────────────────────
# Full public URL (used by Twenty's auth/email flows and frontend)
TWENTY_SERVER_URL=https://crm.yourdomain.com
TWENTY_FRONTEND_URL=https://crm.yourdomain.com
TWENTY_APP_SECRET=__FROM_INFISICAL__
# Constructed from POSTGRES creds — edit host/db if you separate Twenty's DB
TWENTY_PG_DATABASE_URL=postgresql://ruvector:__FROM_INFISICAL__@nyra-postgres:5432/twenty
TWENTY_REDIS_URL=redis://nyra-redis-cache:6379

# ── Activepieces ───────────────────────────────────────────────────────────
AP_POSTGRES_USERNAME=ruvector
AP_POSTGRES_PASSWORD=__FROM_INFISICAL__
AP_ENCRYPTION_KEY=__FROM_INFISICAL__
AP_JWT_SECRET=__FROM_INFISICAL__
# Public URL for Activepieces webhooks / frontend
AP_FRONTEND_URL=http://oracle.trex-fiordland.ts.net:8080

# ── n8n ────────────────────────────────────────────────────────────────────
N8N_DB=n8n
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=__FR0OM_INFISICAL__
N8N_ENCRYPTION_KEY=__FROM_INFISICAL__
N8N_HOST=oracle.trex-fiordland.ts.net
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://oracle.trex-fiordland.ts.net:5678/
N8N_SKIP_WEBHOOK_DNS_CHECK=true

# ── letta / AI model keys ───────────────────────────────────────────────
OPENAI_API_KEY=__FROM_INFISICAL__
ANTHROPIC_API_KEY=__FROM_INFISICAL__
GEMINI_API_KEY=__FROM_INFISICAL__
letta_TELEMETRY_ENABLED=false
FALKORDB_HOST=nyra-falkordb
FALKORDB_PORT=6379

# ── Moltbot (OpenClaw) ─────────────────────────────────────────────────────
CLAWDBOT_GATEWAY_TOKEN=__FROM_INFISICAL__
CLAWDBOT_GATEWAY_PORT=18789

# ── Quote API ─────────────────────────────────────────────────────────────
QUOTE_API_PORT=7070
QUOTE_API_SECRET=__FROM_INFISICAL__

# ── MemPalace ─────────────────────────────────────────────────────────────
MEMPAL_DIR=/opt/nyra/mempalace
MEMPALACE_PORT=8002

# ── Observability ─────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__FROM_INFISICAL__
# Use Tailscale hostname for Grafana links; change to public URL if tunnelled
GRAFANA_ROOT_URL=http://oracle.trex-fiordland.ts.net:3003

# ── OpenWebUI (points back to orchestrator LiteLLM via Tailscale) ──────────
OPENWEBUI_SECRET_KEY=__FROM_INFISICAL__
# LiteLLM runs on orchestrator — accessible from oracle via Tailscale
LITELLM_BASE_URL=http://orchestrator.trex-fiordland.ts.net:4000/v1
LITELLM_MASTER_KEY=__FROM_INFISICAL__

# ── Cloudflared tunnel (optional — enable with --profile cloudflared) ───────
CLOUDFLARED_TUNNEL_TOKEN=__FROM_INFISICAL__
