# Required OCI provider auth
# Use OCIDs and key material from your OCI user profile.
tenancy_ocid     = "ocid1.tenancy.oc1..exampleuniqueID"
user_ocid        = "ocid1.user.oc1..exampleuniqueID"
fingerprint      = "aa:bb:cc:dd:ee:ff:11:22:33:44:55:66:77:88:99:00"
private_key_path = "~/.oci/oci_api_key.pem"
region           = "us-ashburn-1"

# Target compartment where networking + compute are created
compartment_ocid = "ocid1.compartment.oc1..exampleuniqueID"

# SSH public key content (single line)
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIexample nyra@local"

# Optional overrides
# availability_domain = "Uocm:US-ASHBURN-AD-1"
# ubuntu_version      = "24.04"
# ocpu                = 4
# memory_gb           = 24
# boot_volume_size_gb = 100
