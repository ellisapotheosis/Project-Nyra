# Caddy Reverse Proxy Configuration — Oracle VPS
# Purpose: Single entry point for all services via Tailscale mesh
# Binding: ORACLE_TAILSCALE_IP:443 (Tailscale IP, HTTPS only, no public bind)
# TLS: Automatic certificates via ACME (LetsEncrypt or internal CA)
# DNS: MagicDNS (trex-fiordland.ts.net suffix)

# Global settings
{
	admin off
	log default {
		output file /var/log/caddy/access.log {
			roll_size 100mb
			roll_keep 5
		}
		level info
	}
}

# Container/process health probe. The Compose healthcheck reaches this over
# the private 443 listener without requiring an application route.
:443 {
	tls internal
	respond /health "OK" 200
}

# ============================================================================
# PUBLIC-FACING APPS (Cloudflare Tunneled, optionally Access-gated)
# ============================================================================

# Public shell and broker/customer webapp
projectnyra.com, www.projectnyra.com, app.projectnyra.com {
	reverse_proxy localhost:3002 {
		header_up X-Forwarded-For {http.request.remote.host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {http.request.host}
	}
}

# CRM UI (Twenty)
crm.projectnyra.com, twenty.projectnyra.com {
	reverse_proxy localhost:3020 {
		header_up X-Forwarded-For {http.request.remote.host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {http.request.host}
	}
}

# Webhook relay (n8n public endpoint)
hooks.projectnyra.com {
	reverse_proxy localhost:5678 {
		header_up X-Forwarded-For {http.request.remote.host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {http.request.host}
	}
	log {
		level debug
	}
}

# ============================================================================
# PRIVATE INTERNAL SERVICES (Tailscale Mesh Only)
# Access these from any device on the tailnet without port exposure
# ============================================================================

