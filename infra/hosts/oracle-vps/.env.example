POSTGRES_USER=nyra
POSTGRES_PASSWORD=change-me
POSTGRES_DB=twenty
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# Twenty CRM (required by infra/oracle/docker-compose.oracle.yml)
TWENTY_SERVER_URL=https://crm.projectnyra.com
TWENTY_FRONTEND_URL=https://crm.projectnyra.com
TWENTY_APP_SECRET=change-me-app-secret
TWENTY_PG_DATABASE_URL=postgresql://ruvector:change-me@nyra-postgres:5432/twenty
TWENTY_REDIS_URL=redis://nyra-redis-cache:6379

# Activepieces (required by infra/oracle/docker-compose.oracle.yml)
AP_DB_TYPE=POSTGRES
AP_POSTGRES_HOST=nyra-postgres
AP_POSTGRES_PORT=5432
AP_POSTGRES_DATABASE=activepieces
AP_POSTGRES_USERNAME=ruvector
AP_POSTGRES_PASSWORD=change-me
AP_REDIS_HOST=nyra-redis-cache
AP_REDIS_PORT=6379
AP_REDIS_PASSWORD=
AP_ENCRYPTION_KEY=change-me-encryption-key
AP_JWT_SECRET=change-me-jwt-secret
AP_FRONTEND_URL=https://activepieces.projectnyra.com
AP_EXECUTION_MODE=UNSANDBOXED
AP_TELEMETRY_ENABLED=false

# n8n
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me-n8n-encryption
N8N_HOST=n8n.projectnyra.com
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.projectnyra.com/
N8N_SKIP_WEBHOOK_DNS_CHECK=true

# moltbot
CLAWDBOT_GATEWAY_TOKEN=change-me-clawdbot-token
CLAWDBOT_GATEWAY_PORT=18789

# quote-api
QUOTE_API_PORT=7070
QUOTE_API_SECRET=change-me-quote-api-secret

# Home Assistant MCP bridge. Keep the token in .env/Infisical only.
HOMEASSISTANT_URL=https://homeassistant.projectnyra.com
HOMEASSISTANT_TOKEN=change-me-homeassistant-token
HA_MCP_IMAGE=ghcr.io/homeassistant-ai/ha-mcp:7.4.0
HA_MCP_BACKUP_HINT=normal
HAMCP_ENABLE_FILESYSTEM_TOOLS=false
ENABLE_YAML_CONFIG_EDITING=false
HAMCP_ENABLE_CUSTOM_COMPONENT_INTEGRATION=false

# Gitea + local CI/CD on Oracle
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=change-me-gitea-db
GITEA_SECRET_KEY=change-me-gitea-secret-key
GITEA_INTERNAL_TOKEN=change-me-gitea-internal-token
GITEA_JWT_SECRET=change-me-gitea-jwt-secret
GITEA_HTTP_PORT=3001
GITEA_SSH_PORT=2222
GITEA_DOMAIN=git.projectnyra.com
GITEA_ROOT_URL=https://git.projectnyra.com/
GITEA_SSH_DOMAIN=git-ssh.projectnyra.com
GITEA_RUNNER_TOKEN=
GITEA_RUNNER_NAME=oracle-standard-01
GITEA_REPO=nyra-admin/Project-Nyra
GITEA_TOKEN=
GITHUB_REPO=ellisapotheosis/Project-Nyra
GITHUB_TOKEN=
GITHUB_MIRROR_INTERVAL_SECONDS=600

# optional LLM providers
OPENAI_API_KEY=change-me
ANTHROPIC_API_KEY=change-me
GEMINI_API_KEY=change-me

# Agent Vault (infisical/agent-vault — AI credential broker on port 14321/14322)
AGENT_VAULT_MASTER_PASSWORD=REPLACE_WITH_LONG_RANDOM_MASTER_PASSWORD
AGENT_VAULT_LOG_LEVEL=info
INFISICAL_URL=https://app.infisical.com
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=REPLACE_WITH_READ_ONLY_MACHINE_IDENTITY_CLIENT_ID
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=REPLACE_WITH_READ_ONLY_MACHINE_IDENTITY_CLIENT_SECRET

# Infisical Agent sidecar (polls Infisical Cloud, renders secrets to /run/nyra-secrets/)
INFISICAL_TOKEN=REPLACE_WITH_SERVICE_TOKEN_FROM_INFISICAL_CLOUD
INFISICAL_PROJECT_ID=REPLACE_WITH_PROJECT_ID
INFISICAL_ENV=prod
INFISICAL_PATH=/oracle-vps

# optional cloudflared tunnel
CLOUDFLARED_TUNNEL_TOKEN=

# OpenLIT AI observability
OPENLIT_HOST_PORT=3004
OPENLIT_NEXTAUTH_URL=https://openlit.projectnyra.com
OPENLIT_NEXTAUTH_SECRET=change-me-openlit-nextauth-secret
OPENLIT_VAULT_ENCRYPTION_KEY=change-me-openlit-vault-key
OPENLIT_DB_NAME=openlit
OPENLIT_DB_USER=default
OPENLIT_DB_PASSWORD=change-me-openlit-db-password
OPENLIT_TELEMETRY_ENABLED=false
OPENLIT_ALLOWED_CORS_ORIGINS=https://openlit.projectnyra.com
OPENLIT_GOOGLE_CLIENT_ID=
OPENLIT_GOOGLE_CLIENT_SECRET=
OPENLIT_GITHUB_CLIENT_ID=
OPENLIT_GITHUB_CLIENT_SECRET=
OPENLIT_CLICKHOUSE_HTTP_PORT=8123
OPENLIT_CLICKHOUSE_NATIVE_PORT=9000
OPENLIT_OTLP_GRPC_PORT=4317
OPENLIT_OTLP_HTTP_PORT=4318
