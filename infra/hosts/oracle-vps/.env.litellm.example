# LiteLLM Multi-Provider Configuration — Oracle VPS
#
# This file contains secrets for multi-tier LLM provider routing.
# Copy to .env.litellm and fill with actual values from Infisical.
#
# NEVER commit the actual .env.litellm file — it contains API keys.

# ============================================================================
# TIER 1: CLAUDE API (Anthropic Native)
# ============================================================================
# Get this from: Infisical > project-nyra > dev > CLAUDE_API_KEY
# Format: sk-ant-<48+ random characters>
# Permissions: Access to claude-3-5-sonnet, claude-3-5-haiku, claude-3-opus
CLAUDE_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ============================================================================
# TIER 2: CODEX CLI SUBSCRIPTION
# ============================================================================
# Get this from: Infisical > project-nyra > dev > CODEX_API_KEY
# This is the subscription key for Claude Code (Codex) desktop app
CODEX_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ============================================================================
# TIER 3: OMNIROUTE (Free Models)
# ============================================================================
# Get this from: Infisical > project-nyra > dev > OMNIROUTE_API_KEY
# OmniRoute endpoint key for free model access (qwen, deepseek, etc.)
# Running on localhost:20128 (docker network)
OMNIROUTE_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ============================================================================
# TIER 5: OPENROUTER FALLBACK
# ============================================================================
# Get this from: Infisical > project-nyra > dev > OPENROUTER_API_KEY
# OpenRouter free tier fallback (https://openrouter.ai)
# Free models: deepseek-r1:free, qwen-3-coder:free, nemotron-3.5-lightning:free
OPENROUTER_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ============================================================================
# LITELLM CORE SECRETS
# ============================================================================
# Master key for LiteLLM admin access (arbitrary, not from external provider)
# Generate: python3 -c "import secrets; print('sk-' + secrets.token_hex(24))"
LITELLM_MASTER_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional: PostgreSQL URL for cost tracking database
# Format: postgresql://user:password@host:port/dbname
# If not set, cost tracking will use in-memory storage (lost on restart)
LITELLM_DATABASE_URL=

# ============================================================================
# TENANT API KEYS (For Letta and Other Services)
# ============================================================================
# Generate each with: python3 -c "import secrets; print('sk-' + secrets.token_hex(24))"

# Letta agents routing key
LETTA_AGENTS_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# OpenClaw agent routing key
OPENCLAW_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Production services routing key
PRODUCTION_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ============================================================================
# LITELLM SERVICE CONFIGURATION
# ============================================================================
# Port binding
LITELLM_HOST=0.0.0.0
LITELLM_PORT=4000

# Logging
LITELLM_LOG_LEVEL=INFO

# ============================================================================
# INFISICAL INTEGRATION (Optional)
# ============================================================================
# If using Infisical secrets gateway, set these to fetch secrets at runtime
# instead of loading from .env.litellm
INFISICAL_BACKEND_URL=http://infisical-gateway:8200
INFISICAL_SECRET_PATH_PREFIX=/domains/project-nyra/dev
