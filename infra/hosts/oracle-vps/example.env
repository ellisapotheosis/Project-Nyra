# Canonical example for /hosts/oracle-vps. Values are injected by Infisical.
COMPOSE_PROJECT_NAME=nyra-network-nyra
INFISICAL_PROJECT_ID=REPLACE_WITH_INFISICAL_PROJECT_ID
INFISICAL_ENV=prod
INFISICAL_PATH=/hosts/oracle-vps
ORACLE_MAIN_NETWORK=oracle-vps_nyra_net
LITELLM_API_BASE=https://litellm.trex-fiordland.ts.net/v1
NEXUS_ROUTER_URL=https://nexus-router.projectnyra.com/mcp
OMNIROUTE_BASE_URL=http://omniroute:20128/v1
# Shared credentials come from ../hosts-shared.example.env.
CF_GATEWAY_ACCESS_CLIENT_ID=REPLACE_WITH_SHARED_VALUE
CF_GATEWAY_ACCESS_CLIENT_SECRET=REPLACE_WITH_SHARED_VALUE
