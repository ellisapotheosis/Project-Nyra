# sshd_config — Infisical SSH Certificate Authority Integration
# Template for all cluster nodes (oracle-vps, orchestrator, worker-rtx5090, etc.)
#
# This configuration enables certificate-based SSH authentication via Infisical PKI,
# eliminating per-host authorized_keys management.
#
# Deployment:
#   1. Generate template on oracle-vps via Infisical-gateway
#   2. Distribute to all cluster nodes via Infisical PAM
#   3. Verify with: ssh -v user@host (should show certificate validation)
#
# Key Features:
#   - SSH CA public key trust (no more per-user authorized_keys per host)
#   - Short-lived certificates (default 8h from Infisical)
#   - Automatic key rotation via Infisical-gateway
#   - Audit trail of all SSH access in Infisical logs

# ════════════════════════════════════════════════════════════════════════════════
# SECTION 1: Core SSH Service Configuration
# ════════════════════════════════════════════════════════════════════════════════

# Listen on all interfaces (Tailscale will constrain network access)
ListenAddress 0.0.0.0
ListenAddress ::
Port 22

# SSH protocol version (v2 only, v1 is deprecated)
Protocol 2

# ════════════════════════════════════════════════════════════════════════════════
# SECTION 2: Host Key Management
# ════════════════════════════════════════════════════════════════════════════════

# Host keys for server identity
HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_rsa_key

# Host key algorithm preference (ED25519 first, RSA fallback)
HostKeyAlgorithms ecdsa-sha2-nistp256-cert-v01@openssh.com,ecdsa-sha2-nistp256,ssh-ed25519-cert-v01@openssh.com,ssh-ed25519,rsa-sha2-512-cert-v01@openssh.com,rsa-sha2-512

# ════════════════════════════════════════════════════════════════════════════════
# SECTION 3: Infisical SSH Certificate Authority (CRITICAL)
# ════════════════════════════════════════════════════════════════════════════════

# Trust Infisical's SSH CA public key for certificate-based authentication
# This file is distributed by Infisical-gateway and rotated automatically
# Download from Infisical: curl https://infisical.trex-fiordland.ts.net/api/v1/ssh-ca/public-key > /etc/ssh/infisical-ca.pub
TrustedUserCAKeys /etc/ssh/infisical-ca.pub

# SSH certificate revocation list (optional, for explicit revocations)
# Generated by Infisical for any manually revoked certificates
# RevokedKeys /etc/ssh/revoked-keys

# ════════════════════════════════════════════════════════════════════════════════
# SECTION 4: User Authentication (Certificate Priority)
# ════════════════════════════════════════════════════════════════════════════════

# Public key authentication (includes certificates)
PubkeyAuthentication yes

# Strict key checking (verify certificate signature against CA)
StrictModes yes

# Maximum number of authentication attempts
MaxAuthTries 6

# Login grace time (seconds to authenticate before disconnect)
LoginGraceTime 120

# ════════════════════════════════════════════════════════════════════════════════
# SECTION 5: Authentication Methods (Certificate First, Password Fallback)
# ════════════════════════════════════════════════════════════════════════════════

# Preferred authentication methods (order matters)
# 1. publickey (includes Infisical certificates)
# 2. keyboard-interactive (fallback, disabled by default)
# 3. password (DISABLED for security)
AuthenticationMethods publickey
PasswordAuthentication no
PermitEmptyPasswords no
PubkeyAcceptedAlgorithms ecdsa-sha2-nistp256-cert-v01@openssh.com,ecdsa-sha2-nistp256,ssh-ed25519-cert-v01@openssh.com,ssh-ed25519,rsa-sha2-512-cert-v01@openssh.com,rsa-sha2-512

# Disabled authentication methods (security hardening)
KerberosAuthentication no
GSSAPIAuthentication no
UsePAM no

# ════════════════════════════════════════════════════════════════════════════════
# SECTION 6: Session & Terminal Settings
# ════════════════════════════════════════════════════════════════════════════════

# Allow terminal emulation
PermitTTY yes

# SSH subsystems (SFTP, etc.)
Subsystem sftp /usr/lib/openssh/sftp-server -f AUTHPRIV -l INFO

# ════════════════════════════════════════════════════════════════════════════════
# SECTION 7: Certificate-Based Capabilities (from Infisical SSH_CA_EXTENSIONS)
# ════════════════════════════════════════════════════════════════════════════════

# Interactive shell capability (set by Infisical permit-pty extension)
PermitTTY yes

# Port forwarding capability (set by Infisical permit-port-forwarding extension)
AllowTcpForwarding yes
AllowAgentForwarding yes

# X11 forwarding (disabled for security unless explicitly needed)
X11Forwarding no

# ════════════════════════════════════════════════════════════════════════════════
# SECTION 8: Network & Tunnel Settings
# ════════════════════════════════════════════════════════════════════════════════

# TCP keep-alive (prevent connection drops)
TCPKeepAlive yes
ClientAliveInterval 300
ClientAliveCountMax 3

# Disable compression (modern networks have sufficient bandwidth)
Compression no

# ════════════════════════════════════════════════════════════════════════════════
# SECTION 9: Security Hardening
# ════════════════════════════════════════════════════════════════════════════════

# Root login via SSH
PermitRootLogin prohibit-password

# Restrict allowed users (override with: AllowUsers root ubuntu deploy)
# AllowUsers root ubuntu deploy

# Match blocks for fine-grained control
# Example: disable root certificate login if needed
# Match User root
#     PasswordAuthentication no
#     PubkeyAuthentication yes
#     TrustedUserCAKeys /etc/ssh/infisical-ca.pub

# ════════════════════════════════════════════════════════════════════════════════
# SECTION 10: Logging & Audit
# ════════════════════════════════════════════════════════════════════════════════

# Log level (VERBOSE to capture certificate details)
LogLevel VERBOSE

# Audit logging for certificate-based SSH
# All certificate validations and SSH connections logged to syslog
# View with: journalctl -u ssh -f

# ════════════════════════════════════════════════════════════════════════════════
# DEPLOYMENT CHECKLIST
# ════════════════════════════════════════════════════════════════════════════════
#
# On each cluster node:
#
# 1. Fetch Infisical SSH CA public key:
#    curl -k https://infisical.trex-fiordland.ts.net/api/v1/ssh-ca/public-key \
#      -o /etc/ssh/infisical-ca.pub \
#      && chmod 644 /etc/ssh/infisical-ca.pub
#
# 2. Backup existing sshd_config:
#    cp /etc/ssh/sshd_config /etc/ssh/sshd_config.backup.$(date +%s)
#
# 3. Deploy this template:
#    cp sshd_config.infisical-ca /etc/ssh/sshd_config
#
# 4. Validate configuration:
#    sshd -T  # Should show no errors
#
# 5. Restart SSH:
#    systemctl restart ssh  (Ubuntu/Debian)
#    systemctl restart sshd (RHEL/CentOS)
#
# 6. Test certificate-based login (from a machine with Infisical cert):
#    ssh -v user@hostname
#    # Should see: Offering public key / Authentications that can continue / Authenticated with certificate
#
# 7. Verify audit logging:
#    journalctl -u ssh -f
#    # Should show certificate validation messages on login

