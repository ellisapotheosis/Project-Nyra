# Oracle VPS runtime contract. Sensitive values are fetched from Infisical and are not stored here.
COMPOSE_PROJECT_NAME=nyra
INFISICAL_PROJECT_ID=8374cea9-e5e8-4050-bda4-b91f25ab30ef
INFISICAL_ENV=prod
INFISICAL_PATH=/hosts/oracle-vps
NEXT_PUBLIC_WEBAPP_URL=https://app.projectnyra.com
NEXT_PUBLIC_SUPABASE_URL=https://api.projectnyra.com
WEBAPP_HOST_PORT=3002
LETTA_BASE_URL=http://letta:8283
LETTA_MCP_PORT=8284
LITELLM_HOST=0.0.0.0
LITELLM_PORT=4000
TWENTY_API_URL=http://twenty:3000
QDRANT_URL=http://qdrant:6333
FALKORDB_URL=redis://falkordb:6379
MEMORY_CONTEXT_SIZE=4096
GITHUB_API_URL=https://api.github.com
GIT_REPO_PATH=/workspace
BROWSER_WS_ENDPOINT=ws://browserless:3000
FORGEJO_DOMAIN=git.projectnyra.com
FORGEJO_HTTP_PORT=3101
FORGEJO_SSH_PORT=2223
FORGEJO_ROOT_URL=https://git.projectnyra.com/

# Required secret names are defined in infra/hosts/master.example.env and must exist in Infisical before startup.
