OLLAMA_HOST=0.0.0.0
LITELLM_PORT=4000
CADVISOR_PORT=8081
TAILSCALE_AUTHKEY=tskey-auth-xxxx

# Infisical sidecar auth. INFISICAL_TOKEN may come from exported shell env,
# gitignored host .env, Portainer, systemd, or a machine secret store.
# The sidecar writes fetched values to /run/nyra-secrets.
INFISICAL_TOKEN=
INFISICAL_PROJECT_ID=8374cea9-e5e8-4050-bda4-b91f25ab30ef
INFISICAL_ENV=prod
INFISICAL_PATH=/machines/worker-rtx3060
INFISICAL_POLL_INTERVAL=60

# Required by local observability compose stacks.
GRAFANA_ADMIN_PASSWORD=

# Required when voice/unmute stacks are enabled.
UNMUTE_OPENAI_API_KEY=

# RTX3060 utility model lane for Oracle mem0/Letta.
# Ollama keeps one model loaded at a time on the 6GB card.
OLLAMA_PRELOAD_MODELS=nomic-embed-text llama3.2:3b mistral:7b-instruct-v0.3-q4_K_M
OLLAMA_KEEP_ALIVE=5m

# Optional PicoClaw override. PicoClaw source/image is not currently present in
# this repo, so set the image explicitly when enabling the overlay.
PICOCLAW_IMAGE=ghcr.io/project-nyra/picoclaw:latest
PICOCLAW_HOST_PORT=8004
PICOCLAW_UI_HOST_PORT=18792
