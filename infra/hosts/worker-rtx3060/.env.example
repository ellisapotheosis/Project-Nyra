# worker-rtx3060 — Ollama inference node (12 GB VRAM)
# Copy to .env and fill in real values. Never commit the real .env file.

# ── Container naming ──────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=worker-rtx3060

# Tailscale (required for Tailscale mesh join)
TAILSCALE_AUTHKEY=tskey-auth-xxxx

# Ollama
OLLAMA_HOST=0.0.0.0

# LiteLLM proxy (required by worker-3060-litellm)
LITELLM_MASTER_KEY=sk-REPLACE_WITH_LITELLM_MASTER_KEY

# llxprt bridge (required by worker-rtx3060-worker-3060-llxprt-bridge)
LLXPRT_BRIDGE_API_KEY=REPLACE_WITH_LLXPRT_BRIDGE_API_KEY

# Grafana (required by worker-rtx3060-worker-grafana)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=REPLACE_WITH_GRAFANA_ADMIN_PASSWORD

# Infisical Agent sidecar (polls Infisical Cloud every 300s)
# Network note: worker-rtx3060 must have outbound 443 to app.infisical.com
# Rotate v2 service token (st. prefix) to Universal Auth if TLS timeouts persist
INFISICAL_TOKEN=REPLACE_WITH_SERVICE_TOKEN_FROM_INFISICAL_CLOUD
INFISICAL_PROJECT_ID=8374cea9-e5e8-4050-bda4-b91f25ab30ef
INFISICAL_ENV=prod
INFISICAL_PATH=/hosts/worker-rtx3060
INFISICAL_EXPORT_INTERVAL_SECONDS=300

# BitNet model paths (not secrets — configure model storage location)
BITNET_MODEL_DIR=/models/BitNet-b1.58-2B-4T
BITNET_MODEL_FILE=/models/BitNet-b1.58-2B-4T/ggml-model-i2_s.gguf

# ClawTeam fallback node routing
NEXUS_ROUTER_URL=http://orchestrator:7000
LITELLM_API_URL=http://orchestrator:4000
CLAWTEAM_HOST=worker-rtx3060
