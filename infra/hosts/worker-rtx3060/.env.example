OLLAMA_HOST=0.0.0.0
TAILSCALE_AUTHKEY=tskey-auth-xxxx

# Infisical sidecar auth. INFISICAL_TOKEN may come from exported shell env,
# gitignored host .env, Portainer, systemd, or a machine secret store.
# The sidecar writes fetched values to /run/nyra-secrets.
INFISICAL_TOKEN=
INFISICAL_PROJECT_ID=8374cea9-e5e8-4050-bda4-b91f25ab30ef
INFISICAL_ENV=prod
INFISICAL_PATH=/machines/worker-rtx3060
INFISICAL_POLL_INTERVAL=60

# Required by local observability compose stacks.
GRAFANA_ADMIN_PASSWORD=

# Required when voice/unmute stacks are enabled.
UNMUTE_OPENAI_API_KEY=
