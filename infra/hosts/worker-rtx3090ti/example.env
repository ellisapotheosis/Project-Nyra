# Canonical example for /hosts/worker-rtx3090ti. Values are injected by Infisical.
COMPOSE_PROJECT_NAME=worker-rtx3090ti
INFISICAL_PROJECT_ID=REPLACE_WITH_INFISICAL_PROJECT_ID
INFISICAL_ENV=prod
INFISICAL_PATH=/hosts/worker-rtx3090ti
VLLM_MODEL=Qwen/Qwen3.8-27B
VLLM_PORT=8000
LITELLM_API_BASE=https://litellm.projectnyra.com/v1
# Shared credentials come from ../hosts-shared.example.env.
LITELLM_MASTER_KEY=REPLACE_WITH_SHARED_VALUE
TAILSCALE_AUTHKEY=REPLACE_WITH_SHARED_VALUE
