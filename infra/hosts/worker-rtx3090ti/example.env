# =============================================================================
# infra/hosts/worker-rtx3090ti/example.env
# =============================================================================
# Infisical Agent template-injection contract for worker-rtx3090ti.
#
# VARIABLE NAMES ONLY. Every right-hand side is a ${VAR} placeholder resolved at
# runtime by the Infisical Agent. Never commit a real value to this file.
#
# Infisical path : /hosts/worker-rtx3090ti
# Agent config   : infra/configs/infisical/infisical-agent.yaml
# Derived from   : infra/hosts/worker-rtx3090ti/docker-compose*.yml
#                  root compose.yaml profile "worker-3090ti"
#                  infra/env/worker-rtx3090ti.env.example
#
# The retired Grafbase Nexus router has been replaced by the LiteLLM gateway on
# oracle-vps. No NEXUS_* variable is an active requirement. See
# docs/architecture/NYRA_MCP_ARCHITECTURE.md.
# =============================================================================


# --- LiteLLM gateway (canonical MCP router — absorbed the retired Nexus role) ---
DATABASE_URL=${DATABASE_URL}
LITELLM_PORT=${LITELLM_PORT}

# --- Downstream model providers (held by the gateway; agents never hold these) ---
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
HF_TOKEN=${HF_TOKEN}
HUGGING_FACE_HUB_TOKEN=${HUGGING_FACE_HUB_TOKEN}

# --- Infisical machine identity + agent ---
INFISICAL_AGENT_PROXY_ADDRESS=${INFISICAL_AGENT_PROXY_ADDRESS}
INFISICAL_DOMAIN=${INFISICAL_DOMAIN}
INFISICAL_ENV=${INFISICAL_ENV}
INFISICAL_ENVIRONMENT=${INFISICAL_ENVIRONMENT}
INFISICAL_POLL_INTERVAL=${INFISICAL_POLL_INTERVAL}
INFISICAL_PROJECT_ID=${INFISICAL_PROJECT_ID}
INFISICAL_SECRET_PATH=${INFISICAL_SECRET_PATH}
INFISICAL_TOKEN=${INFISICAL_TOKEN}
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=${INFISICAL_UNIVERSAL_AUTH_CLIENT_ID}
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=${INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET}

# --- Tailscale / network ---
NO_PROXY=${NO_PROXY}
ORCHESTRATOR_URL=${ORCHESTRATOR_URL}

# --- vLLM / local inference ---
HF_CACHE_DIR=${HF_CACHE_DIR}
LMCACHE_CHUNK_SIZE=${LMCACHE_CHUNK_SIZE}
LMCACHE_CONFIG_FILE=${LMCACHE_CONFIG_FILE}
LMCACHE_REMOTE_SERDE=${LMCACHE_REMOTE_SERDE}
LMCACHE_REMOTE_URL=${LMCACHE_REMOTE_URL}
LMCACHE_USE_EXPERIMENTAL=${LMCACHE_USE_EXPERIMENTAL}
OLLAMA_MODELS_PATH=${OLLAMA_MODELS_PATH}
VLLM_GPU_MEMORY_UTILIZATION=${VLLM_GPU_MEMORY_UTILIZATION}
VLLM_GPU_MEMORY_UTILIZATION_3090TI=${VLLM_GPU_MEMORY_UTILIZATION_3090TI}
VLLM_HOST=${VLLM_HOST}
VLLM_IMAGE=${VLLM_IMAGE}
VLLM_MAX_MODEL_LEN=${VLLM_MAX_MODEL_LEN}
VLLM_MAX_MODEL_LEN_3090TI=${VLLM_MAX_MODEL_LEN_3090TI}
VLLM_MODEL=${VLLM_MODEL}
VLLM_MODEL_3090TI=${VLLM_MODEL_3090TI}
VLLM_PORT=${VLLM_PORT}
VLLM_SERVED_NAME_3090TI=${VLLM_SERVED_NAME_3090TI}
VLLM_TENSOR_PARALLEL_SIZE=${VLLM_TENSOR_PARALLEL_SIZE}

# --- Databases / caches ---
MONGO_PORT=${MONGO_PORT}
POSTGRES_PORT=${POSTGRES_PORT}
REDIS_PORT=${REDIS_PORT}

# --- Memory plane (Letta / mem0 / OpenMemory) ---
MEM0_API_KEY=${MEM0_API_KEY}
MEM0_API_URL=${MEM0_API_URL}

# --- Observability ---
CADVISOR_PORT=${CADVISOR_PORT}
GRAFANA_PORT=${GRAFANA_PORT}
LOKI_PORT=${LOKI_PORT}
LOKI_URL=${LOKI_URL}
PROMETHEUS_PORT=${PROMETHEUS_PORT}

# --- CRM / mortgage (borrower PII boundary — nyra-mortgage scope only) ---
QUOTE_ENGINE_URL=${QUOTE_ENGINE_URL}
TWENTY_CRM_API_KEY=${TWENTY_CRM_API_KEY}
TWENTY_CRM_URL=${TWENTY_CRM_URL}

# --- Automation (n8n / Activepieces) ---
N8N_PORT=${N8N_PORT}

# --- Portainer fleet ---
PORTAINER_AGENT_TAGS=${PORTAINER_AGENT_TAGS}
PORTAINER_EDGE_ID=${PORTAINER_EDGE_ID}
PORTAINER_EDGE_INSECURE_POLL=${PORTAINER_EDGE_INSECURE_POLL}
PORTAINER_EDGE_KEY=${PORTAINER_EDGE_KEY}

# --- Other host/service settings ---
COMPOSE_PROJECT_NAME=${COMPOSE_PROJECT_NAME}
WORKER_ID=${WORKER_ID}
