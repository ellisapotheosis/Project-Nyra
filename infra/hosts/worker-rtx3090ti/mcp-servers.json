{
  "mcpServers": {
    "fetch": {
      "image": "mcp/fetch"
    },
    "filesystem": {
      "image": "mcp/filesystem",
      "args": ["/repos", "/x", "/z"],
      "volumes": [
        "/home/ellisapotheosis/repos:/repos:ro",
        "/run/desktop/mnt/host/x:/x:ro",
        "/run/desktop/mnt/host/z:/z:ro"
      ]
    },
    "git": {
      "image": "mcp/git",
      "volumes": ["/home/ellisapotheosis/repos:/repos:rw"]
    },
    "time": {
      "image": "mcp/time"
    }
  }
}
