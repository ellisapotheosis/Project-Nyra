VLLM_MODEL=OBLITERATUS/gemma-4-E4B-it-OBLITERATED
VLLM_PORT=8000
TAILSCALE_AUTHKEY=tskey-auth-xxxx

# Infisical sidecar auth. Universal Auth is preferred; INFISICAL_TOKEN is only
# a fallback for older agents or break-glass operation.
# The sidecar writes fetched values to /run/nyra-secrets.
INFISICAL_TOKEN=
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
INFISICAL_PROJECT_ID=8374cea9-e5e8-4050-bda4-b91f25ab30ef
INFISICAL_ENV=prod
INFISICAL_PATH=/machines/worker-rtx3090ti
INFISICAL_POLL_INTERVAL=60

# Required by shared worker observability overlays.
GRAFANA_ADMIN_PASSWORD=

# Required when assistant or voice/unmute stacks are enabled.
NEXUS_ADMIN_TOKEN=
UNMUTE_OPENAI_API_KEY=
