VLLM_MODEL=OBLITERATUS/gemma-4-E4B-it-OBLITERATED
VLLM_PORT=8000
TAILSCALE_AUTHKEY=tskey-auth-xxxx

# Infisical sidecar auth. Keep the real token only in the host-local .env or a
# machine secret store; the sidecar writes fetched values to /run/nyra-secrets.
INFISICAL_TOKEN=
INFISICAL_PROJECT_ID=8374cea9-e5e8-4050-bda4-b91f25ab30ef
INFISICAL_ENV=prod
INFISICAL_PATH=/machines/worker-rtx3090ti
INFISICAL_POLL_INTERVAL=60
