.config/google-chrome
.config/google-chrome/**
.config/google-chrome-unstable
.config/google-chrome-unstable/**
.config/google-chrome-for-testing
.config/google-chrome-for-testing/**
.config/gh
.config/gh/**
.config/.wrangler/logs
.config/.wrangler/logs/**
.config/superpowers/conversation-index
.config/superpowers/conversation-index/**
.camofox
.camofox/**
.browser-devtools-mcp
.browser-devtools-mcp/**
.gnome
.gnome/**
.landscape
.icons
.icons/**
snap
snap/**

