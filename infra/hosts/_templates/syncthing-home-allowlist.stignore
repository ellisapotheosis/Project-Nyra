// Project Nyra Syncthing Ubuntu home allowlist.
// Intent: sync durable settings, shell/agent configuration, skills, prompts,
// and useful working files. Do not sync credentials, browser profiles, package
// stores, generated outputs, build caches, model artifacts, logs, databases, or
// live session state.
//
// Syncthing ignore patterns are order-sensitive. Keep hard denies first, allow
// parent paths explicitly, then default-deny everything else at the end.

// ---------------------------------------------------------------------------
// Hard deny: identity, credentials, private auth, host-specific machine state.
// ---------------------------------------------------------------------------
.ssh
.ssh/**
.gnupg
.gnupg/**
.git-credentials
.infisical
.infisical/**
infisical-keyring
infisical-keyring/**
.mcp-auth
.mcp-auth/**
.oci
.oci/**
.aws
.azure
.docker/config.json
.docker/desktop
.docker/desktop/**
.docker/run
.docker/run/**
.llxprt/oauth
.llxprt/oauth/**
.nyra/secrets-work
.nyra/secrets-work/**
**/.env
**/.env.*
**/*.pem
**/*.key
**/*_rsa
**/*_ed25519

// ---------------------------------------------------------------------------
// Hard deny: histories, sessions, logs, tmp, volatile databases.
// ---------------------------------------------------------------------------
.bash_history
.zsh_history
.python_history
.node_repl_history
.sudo_as_admin_successful
.motd_shown
.warprc
.wget-hsts
.lesshst
**/history
**/history/**
**/sessions
**/sessions/**
**/session-env
**/session-env/**
**/shell-snapshots
**/shell-snapshots/**
**/shell_snapshots
**/shell_snapshots/**
**/logs
**/logs/**
**/log
**/log/**
**/tmp
**/tmp/**
**/.tmp
**/.tmp/**
**/temp
**/temp/**
**/*.log
**/*.log.*
**/*.sqlite
**/*.sqlite-*
**/*.db
**/*.db-*
**/*.wal
**/*.journal

// ---------------------------------------------------------------------------
// Hard deny: browser/desktop app profiles and local OS runtime state.
// ---------------------------------------------------------------------------
.cache
.cache/**
.local/share/Trash
.local/share/Trash/**
.local/share/recently-used.xbel
.local/share/pnpm
.local/share/pnpm/**
.local/share/uv
.local/share/uv/**
.local/share/claude/versions
.local/share/claude/versions/**
.local/share/rtk
