.npm
.npm/**
.npm-global/lib
.npm-global/lib/**
.bun/install
.bun/install/**
.cargo/registry
.cargo/registry/**
.cargo/git
.cargo/git/**
.rustup/toolchains
.rustup/toolchains/**
go/pkg
go/pkg/**
.venvs
.venvs/**
