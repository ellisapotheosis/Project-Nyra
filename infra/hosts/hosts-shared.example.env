# Project Nyra shared host values
#
# These names are consumed by more than one host.  Production values are
# injected from Infisical; never commit a populated copy of this file.

INFISICAL_PROJECT_ID=REPLACE_WITH_INFISICAL_PROJECT_ID
INFISICAL_ENV=prod

# Shared model gateway credentials (references only; no values in Git).
LITELLM_MASTER_KEY=REPLACE_WITH_SHARED_LITELLM_MASTER_KEY
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_API_KEY
OMNIROUTE_API_KEY=REPLACE_WITH_OMNIROUTE_API_KEY
CF_GATEWAY_ACCESS_CLIENT_ID=REPLACE_WITH_CLOUDFLARE_ACCESS_SERVICE_TOKEN_ID
CF_GATEWAY_ACCESS_CLIENT_SECRET=REPLACE_WITH_CLOUDFLARE_ACCESS_SERVICE_TOKEN_SECRET

# Shared private-network/bootstrap values.
TAILSCALE_AUTHKEY=REPLACE_WITH_TAILSCALE_AUTHKEY
PORTAINER_EDGE_ID=REPLACE_WITH_PORTAINER_EDGE_ID
PORTAINER_EDGE_KEY=REPLACE_WITH_PORTAINER_EDGE_KEY

# Shared endpoint aliases; each host may override the local/private URL.
LITELLM_API_BASE=https://litellm.projectnyra.com/v1
NEXUS_ROUTER_URL=https://nexus-router.projectnyra.com/mcp
OMNIROUTE_BASE_URL=http://omniroute:20128/v1
