# Orchestrator — Environment Variables
# Copy to .env and fill in real values.
# Canonical secrets live in Infisical; use: make secrets-check
# to verify the Infisical connection before bringing services up.

# ── Container naming ──────────────────────────────────────────────────────────
# All containers on this host are named orchestrator-<service>.
COMPOSE_PROJECT_NAME=orchestrator

# ── Infisical (required for make inject-secrets) ──────────────────────────────
INFISICAL_PROJECT_ID=REPLACE_WITH_PROJECT_ID
INFISICAL_ENV=prod
INFISICAL_PATH=/orchestrator
# INFISICAL_TOKEN is fetched automatically via machine identity; set only if
# using a pre-generated token (service token or CI token).
# INFISICAL_TOKEN=

# ── LiteLLM (canonical gateway on orchestrator) ───────────────────────────────
# Format: sk-<48+ random chars>   Generate: openssl rand -hex 32 | sed 's/^/sk-/'
# Accessible at:
#   Internal:      http://litellm:4000/v1  (docker-internal from same project)
#   Tailscale:     http://orchestrator.trex-fiordland.ts.net:4010/v1
#   Private DNS:   http://litellm.projectnyra.com/v1  (AdGuard split-horizon)
#   Admin UI:      http://litellm.projectnyra.com/ui  (key as password)
LITELLM_MASTER_KEY=sk-REPLACE_WITH_48_PLUS_RANDOM_CHARACTERS
LITELLM_PORT=4010
LITELLM_HOST=0.0.0.0
LITELLM_BASE_URL=http://litellm:4000/v1

# ── Upstream provider keys (injected into LiteLLM) ────────────────────────────
OMNIROUTE_API_KEY=REPLACE_WITH_OMNIROUTE_ENDPOINT_KEY
LLXPRT_BRIDGE_API_KEY=REPLACE_WITH_LLXPRT_BRIDGE_API_KEY
OPENROUTER_API_KEY=REPLACE_OR_LEAVE_UNUSED
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Portainer Agent (edge agent connecting to oracle-vps Portainer CE) ────────
PORTAINER_EDGE_ID=REPLACE_WITH_EDGE_ID_FROM_PORTAINER_UI
PORTAINER_EDGE_KEY=REPLACE_WITH_EDGE_KEY_FROM_PORTAINER_UI
PORTAINER_EDGE_INSECURE_POLL=1

# ── OpenClaw Gateway ─────────────────────────────────────────────────────────
NEXUS_API_URL=http://100.64.0.3:3000
LITELLM_API_URL=http://litellm:4000
MEM0_API_URL=http://100.64.0.3:5000
