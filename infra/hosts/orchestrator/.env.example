# Orchestrator host-local bootstrap env.
# Keep real values in a gitignored .env file, exported shell env, Portainer
# stack env, systemd EnvironmentFile, or machine-level secret store.

COMPOSE_PROJECT_NAME=nyra

# Infisical sidecar auth. Prefer Universal Auth machine identity credentials.
# INFISICAL_TOKEN remains supported as a temporary/manual fallback.
INFISICAL_TOKEN=
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
INFISICAL_PROJECT_ID=8374cea9-e5e8-4050-bda4-b91f25ab30ef
INFISICAL_ENV=prod
INFISICAL_PATH=/machines/orchestrator
INFISICAL_POLL_INTERVAL=60

# Required by local observability compose stacks. Source from Infisical or a
# gitignored host env file; do not use the old Grafana admin/admin default.
GRAFANA_ADMIN_PASSWORD=

# Optional direct override for the standalone cloudflared stack. Prefer
# ORCHESTRATOR_TUNNEL_TOKEN from Infisical at /machines/orchestrator.
ORCHESTRATOR_TUNNEL_TOKEN=
DOCKER_MCP_TOOLKIT_PORT=8811
NEXUS_ROUTER_URL=http://oracle.trex-fiordland.ts.net:6000
