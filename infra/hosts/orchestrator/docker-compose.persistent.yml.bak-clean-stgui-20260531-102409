# Persistent services for orchestrator — Portainer edge agent + Syncthing
# Deployed with: docker compose -p nyra-persistent -f this-file --env-file .env up -d
name: nyra-persistent

services:
  portainer-edge-agent:
    image: portainer/agent:2.27.9
    container_name: nyra-persistent-orchestrator-portainer-agent
    restart: always
    environment:
      STGUIADDRESS: "0.0.0.0:8385"
      STGUIADDRESS: "0.0.0.0:8385"
      EDGE: "1"
      EDGE_ID: ${PORTAINER_EDGE_ID:-}
      EDGE_KEY: ${PORTAINER_EDGE_KEY}
      EDGE_INSECURE_POLL: "1"
      AGENT_CLUSTER_ADDR: tasks.portainer-edge-agent
      AGENT_TAGS: nyra,edge,orchestrator
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /var/lib/docker/volumes:/var/lib/docker/volumes
    networks:
      - default

  syncthing:
    image: syncthing/syncthing:latest
    container_name: nyra-persistent-orchestrator-syncthing
    restart: always
    network_mode: host
    healthcheck:
      test: ["CMD-SHELL", "curl -fkLsS -m 2 127.0.0.1:8385/rest/noauth/health | grep -o OK || exit 1"]
      interval: 60s
      timeout: 10s
      retries: 3
    environment:
      STGUIADDRESS: "0.0.0.0:8385"
      PUID: "1000"
      PGID: "1000"
    volumes:
      - /home/ellisapotheosis:/var/syncthing/data/home
      - orchestrator_syncthing_config:/var/syncthing

volumes:
  orchestrator_syncthing_config:
    external: true
