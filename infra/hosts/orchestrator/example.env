# =============================================================================
# infra/hosts/orchestrator/example.env
# =============================================================================
# Infisical Agent template-injection contract for orchestrator.
#
# VARIABLE NAMES ONLY. Every right-hand side is a ${VAR} placeholder resolved at
# runtime by the Infisical Agent. Never commit a real value to this file.
#
# Infisical path : /hosts/orchestrator
# Agent config   : infra/configs/infisical/infisical-agent.yaml
# Derived from   : infra/hosts/orchestrator/docker-compose*.yml
#                  root compose.yaml profile "orchestrator"
#                  infra/env/orchestrator.env.example
#
# The retired Grafbase Nexus router has been replaced by the LiteLLM gateway on
# oracle-vps. No NEXUS_* variable is an active requirement. See
# docs/architecture/NYRA_MCP_ARCHITECTURE.md.
# =============================================================================


# --- LiteLLM gateway (canonical MCP router — absorbed the retired Nexus role) ---
LITELLM_BASE_URL=${LITELLM_BASE_URL}
LITELLM_BIND_IP=${LITELLM_BIND_IP}
LITELLM_DB_NAME=${LITELLM_DB_NAME}
LITELLM_DB_PASSWORD=${LITELLM_DB_PASSWORD}
LITELLM_DB_USER=${LITELLM_DB_USER}
LITELLM_HERMES_KEY=${LITELLM_HERMES_KEY}
LITELLM_IMAGE=${LITELLM_IMAGE}
# WARNING: LITELLM_MASTER_KEY is an ADMINISTRATIVE credential that
# docs/architecture/NYRA_SECRETS_PLANE.md scopes to the oracle-vps gateway
# ONLY. It is listed here because compose files on orchestrator still reference
# it. That reference is the defect; do not treat this line as approval.
LITELLM_MASTER_KEY=${LITELLM_MASTER_KEY}
LITELLM_PORT=${LITELLM_PORT}
LITELLM_POSTGRES_IMAGE=${LITELLM_POSTGRES_IMAGE}

# --- Downstream model providers (held by the gateway; agents never hold these) ---
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
OMNIROUTE_IMAGE=${OMNIROUTE_IMAGE}
OMNIROUTE_PORT=${OMNIROUTE_PORT}
OPENAI_API_KEY=${OPENAI_API_KEY}
OPENROUTER_API_KEY=${OPENROUTER_API_KEY}

# --- Infisical machine identity + agent ---
INFISICAL_AGENT_PROXY_ADDRESS=${INFISICAL_AGENT_PROXY_ADDRESS}
INFISICAL_DOMAIN=${INFISICAL_DOMAIN}
INFISICAL_ENVIRONMENT=${INFISICAL_ENVIRONMENT}
INFISICAL_PROJECT_ID=${INFISICAL_PROJECT_ID}
INFISICAL_SECRET_PATH=${INFISICAL_SECRET_PATH}
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=${INFISICAL_UNIVERSAL_AUTH_CLIENT_ID}
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=${INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET}

# --- Tailscale / network ---
NO_PROXY=${NO_PROXY}
NYRA_DOCKER_NETWORK=${NYRA_DOCKER_NETWORK}

# --- vLLM / local inference ---
BITNET_CPUS=${BITNET_CPUS}
BITNET_CTX_SIZE=${BITNET_CTX_SIZE}
BITNET_IMAGE=${BITNET_IMAGE}
BITNET_MEM_LIMIT=${BITNET_MEM_LIMIT}
BITNET_THREADS=${BITNET_THREADS}
EMBEDDINGS_CPUS=${EMBEDDINGS_CPUS}
EMBEDDINGS_MEM_LIMIT=${EMBEDDINGS_MEM_LIMIT}
EMBEDDINGS_THREADS=${EMBEDDINGS_THREADS}
LLAMACPP_SERVER_IMAGE=${LLAMACPP_SERVER_IMAGE}

# --- Databases / caches ---
CLICKHOUSE_PASSWORD=${CLICKHOUSE_PASSWORD}
CLICKHOUSE_USER=${CLICKHOUSE_USER}
POSTGRES_DB=${POSTGRES_DB}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_USER=${POSTGRES_USER}
REDIS_PASSWORD=${REDIS_PASSWORD}

# --- Memory plane (Letta / mem0 / OpenMemory) ---
MEM0_API_URL=${MEM0_API_URL}
MEMPALACE_URL=${MEMPALACE_URL}

# --- Observability ---
ALERTMANAGER_PAGERDUTY_KEY=${ALERTMANAGER_PAGERDUTY_KEY}
ALERTMANAGER_PORT=${ALERTMANAGER_PORT}
ALERTMANAGER_SLACK_WEBHOOK_URL=${ALERTMANAGER_SLACK_WEBHOOK_URL}
GRAFANA_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}
GRAFANA_ADMIN_USER=${GRAFANA_ADMIN_USER}
OPENLIT_ALLOWED_CORS_ORIGINS=${OPENLIT_ALLOWED_CORS_ORIGINS}
OPENLIT_DB_NAME=${OPENLIT_DB_NAME}
OPENLIT_DB_PASSWORD=${OPENLIT_DB_PASSWORD}
OPENLIT_DB_USER=${OPENLIT_DB_USER}
OPENLIT_HOST_PORT=${OPENLIT_HOST_PORT}
OPENLIT_NEXTAUTH_SECRET=${OPENLIT_NEXTAUTH_SECRET}
OPENLIT_NEXTAUTH_URL=${OPENLIT_NEXTAUTH_URL}
OPENLIT_OTLP_GRPC_PORT=${OPENLIT_OTLP_GRPC_PORT}
OPENLIT_OTLP_HTTP_PORT=${OPENLIT_OTLP_HTTP_PORT}
OPENLIT_TELEMETRY_ENABLED=${OPENLIT_TELEMETRY_ENABLED}
OPENLIT_VAULT_ENCRYPTION_KEY=${OPENLIT_VAULT_ENCRYPTION_KEY}

# --- CRM / mortgage (borrower PII boundary — nyra-mortgage scope only) ---
QUOTE_ENGINE_URL=${QUOTE_ENGINE_URL}

# --- Portainer fleet ---
PORTAINER_AGENT_TAGS=${PORTAINER_AGENT_TAGS}
PORTAINER_EDGE_ID=${PORTAINER_EDGE_ID}
PORTAINER_EDGE_INSECURE_POLL=${PORTAINER_EDGE_INSECURE_POLL}
PORTAINER_EDGE_KEY=${PORTAINER_EDGE_KEY}

# --- OpenClaw / agent runtimes ---
OPENCLAW_GATEWAY_TOKEN=${OPENCLAW_GATEWAY_TOKEN}

# --- Other host/service settings ---
COMPOSE_PROJECT_NAME=${COMPOSE_PROJECT_NAME}
NATS_BIND_IP=${NATS_BIND_IP}
NATS_IMAGE=${NATS_IMAGE}
NATS_MONITOR_PORT=${NATS_MONITOR_PORT}
NATS_PORT=${NATS_PORT}
