# Project Nyra staging secrets for orchestrator-hosted product services.
# Copy to a gitignored .env file or secret manager entry. Do not commit real values.

# Soft-pull credit provider selection: MOCK, CERTIFIED_CREDIT, EQUIFAX, OTHER_APPROVED.
SOFT_PULL_CREDIT_PROVIDER=MOCK

# Certified Credit credentials, if approved for staging.
CERTIFIED_CREDIT_API_BASE_URL=
CERTIFIED_CREDIT_CLIENT_ID=
CERTIFIED_CREDIT_CLIENT_SECRET=
CERTIFIED_CREDIT_WEBHOOK_SECRET=

# Equifax credentials, if approved for staging.
EQUIFAX_API_BASE_URL=
EQUIFAX_CLIENT_ID=
EQUIFAX_CLIENT_SECRET=
EQUIFAX_WEBHOOK_SECRET=

# Optional provider signing key for request verification.
SOFT_PULL_CREDIT_SIGNING_KEY=
