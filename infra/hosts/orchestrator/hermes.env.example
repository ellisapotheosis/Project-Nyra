# ============================================================================
# Hermes Gateway Environment Configuration
# ============================================================================
# Copy to `.env.local` or set in docker-compose override.
# ============================================================================

# ── Hermes Core ─────────────────────────────────────────────────────────
PORT=8763
HOST=0.0.0.0
AGENT_NAME=hermes-orchestrator
AGENT_DESCRIPTION=Project Nyra orchestrator — always-on product & operations assistant
AGENT_PUBLIC_URL=http://orchestrator.trex-fiordland.ts.net:8763

# ── LiteLLM Integration ─────────────────────────────────────────────────
# Points to local LiteLLM proxy (loopback only)
ADAPTER_OPENAI_BASE_URL=http://127.0.0.1:4010/v1
LITELLM_HERMES_KEY=your-litellm-master-key-here
ADAPTER_OPENAI_API_KEY=${LITELLM_HERMES_KEY}

# ── Adapter Configuration ───────────────────────────────────────────────
ADAPTER_DRIVER=openai
ADAPTER_TIMEOUT_MS=900000
ADAPTER_STATE_DIR=/data/state/hermes
ADAPTER_OPENAI_MODEL=default

# ── Logging ─────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── MCP Authentication (Secrets) ────────────────────────────────────────
# Obtain from Infisical or environment secrets
NEXUS_API_KEY=your-nexus-api-key-here
GITEA_API_TOKEN=your-gitea-api-token-here
FIRECRAWL_API_KEY=your-firecrawl-api-key-here
TAVILY_API_KEY=your-tavily-api-key-here
INFISICAL_MCP_TOKEN=your-infisical-mcp-token-here
PAPERCLIP_API_KEY=your-paperclip-api-key-here

# ── Compose Project Name ────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=nyra
