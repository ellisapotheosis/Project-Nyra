# Orchestrator (NUC) - Final env template
# Keep secrets in Infisical and inject at runtime.

INFISICAL_TOKEN=${INFISICAL_TOKEN}
INFISICAL_PROJECT_ID=${INFISICAL_PROJECT_ID}
INFISICAL_ENV=${INFISICAL_ENV:-prod}
INFISICAL_PATH=/machines/orchestrator

# --- Secrets from Infisical ---
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
REDIS_PASSWORD=${REDIS_PASSWORD}
LITELLM_MASTER_KEY=${LITELLM_MASTER_KEY}
NEXUS_JWT_SECRET=${NEXUS_JWT_SECRET}
NEXUS_ADMIN_TOKEN=${NEXUS_ADMIN_TOKEN}
AUTH_SECRET=${AUTH_SECRET}
API_SECRET=${API_SECRET}
TWENTY_API_KEY=${TWENTY_API_KEY}
TWENTY_ENCRYPTION_SECRET=${TWENTY_ENCRYPTION_SECRET}
TWENTY_JWT_SECRET=${TWENTY_JWT_SECRET}
TWENTY_PASSWORD_SALT=${TWENTY_PASSWORD_SALT}
N8N_ENCRYPTION_KEY=${N8N_ENCRYPTION_KEY}
N8N_BASIC_AUTH_USER=${N8N_BASIC_AUTH_USER}
N8N_BASIC_AUTH_PASSWORD=${N8N_BASIC_AUTH_PASSWORD}
AP_ENCRYPTION_KEY=${AP_ENCRYPTION_KEY}
AP_JWT_SECRET=${AP_JWT_SECRET}
AP_POSTGRES_PASSWORD=${AP_POSTGRES_PASSWORD}
OPENAI_API_KEY=${OPENAI_API_KEY}
OPENROUTER_API_KEY=${OPENROUTER_API_KEY}
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
GOOGLE_API_KEY=${GOOGLE_API_KEY}
HF_TOKEN=${HF_TOKEN}
TWILIO_ACCOUNT_SID=${TWILIO_ACCOUNT_SID}
TWILIO_AUTH_TOKEN=${TWILIO_AUTH_TOKEN}
SENDGRID_API_KEY=${SENDGRID_API_KEY}
LEADMAILBOX_API_KEY=${LEADMAILBOX_API_KEY}
LENDINGTREE_WEBHOOK_SECRET=${LENDINGTREE_WEBHOOK_SECRET}
FREERATEUPDATER_WEBHOOK_SECRET=${FREERATEUPDATER_WEBHOOK_SECRET}
CLOUDFLARE_API_TOKEN=${CLOUDFLARE_API_TOKEN}
CLOUDFLARE_TUNNEL_TOKEN=${CLOUDFLARE_TUNNEL_TOKEN}

# --- Non-secret defaults that should remain local per host ---
NODE_ENV=production
MODEL_ROUTING_PREFER_LOCAL=true
MODEL_ROUTING_FALLBACK_CLOUD=true
REQUEST_TIMEOUT=60
BATCH_TIMEOUT_MS=120000
RECOVERY_CHECK_INTERVAL=30
