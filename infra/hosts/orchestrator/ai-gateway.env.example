# Copy to /etc/projectnyra/secrets/ai-gateway.env and chmod 0600.
# Store canonical values in Infisical; this file should be rendered locally.

LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
LITELLM_POSTGRES_IMAGE=postgres:16.4-alpine
OMNIROUTE_IMAGE=diegosouzapw/omniroute:latest
NATS_IMAGE=nats:2.11-alpine

LITELLM_MASTER_KEY=sk-REPLACE_WITH_48_PLUS_RANDOM_CHARACTERS
LITELLM_DB_NAME=litellm
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
LITELLM_PORT=4000

WORKER_LOCAL_API_KEY=not-needed
WORKER_5090_VLLM_BASE_URL=http://worker-rtx5090.trex-fiordland.ts.net:8000/v1
WORKER_5090_LITELLM_MODEL=openai/REPLACE_WITH_ACTUAL_5090_SERVED_MODEL_ID
WORKER_3090_VLLM_BASE_URL=http://worker-rtx3090ti.trex-fiordland.ts.net:8000/v1
WORKER_3090_LITELLM_MODEL=openai/REPLACE_WITH_ACTUAL_3090_SERVED_MODEL_ID
WORKER_3060_OLLAMA_BASE_URL=http://worker-rtx3060.trex-fiordland.ts.net:11434
WORKER_3060_CHAT_LITELLM_MODEL=ollama/qwen2.5:4b
WORKER_3060_EMBED_LITELLM_MODEL=ollama/nomic-embed-text

OMNIROUTE_PORT=20128
OMNIROUTE_BASE_URL=http://omniroute:20128/v1
OMNIROUTE_API_KEY=REPLACE_WITH_OMNIROUTE_ENDPOINT_KEY
OMNIROUTE_CODEX_LITELLM_MODEL=openai/cx/REPLACE_WITH_CONNECTED_CODEX_MODEL
OMNIROUTE_CLAUDE_LITELLM_MODEL=openai/cc/REPLACE_WITH_CONNECTED_CLAUDE_MODEL
OMNIROUTE_FREE_LITELLM_MODEL=openai/auto
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_SECRET
API_KEY_SECRET=REPLACE_WITH_RANDOM_64_CHAR_SECRET
DATABASE_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_CHAR_SECRET
INITIAL_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD

OPENROUTER_API_KEY=REPLACE_OR_LEAVE_UNUSED
OPENROUTER_FREE_LITELLM_MODEL=openrouter/openrouter/free

NEXUS_MCP_URL=http://nexus-router:8080/mcp
NEXUS_API_KEY=REPLACE_WITH_NEXUS_INTERNAL_BEARER_TOKEN

LLXPRT_A2A_URL=http://worker-rtx5090.trex-fiordland.ts.net:8762
HERMES_A2A_URL=http://worker-rtx3090ti.trex-fiordland.ts.net:8763
OPENHARNESS_A2A_URL=http://worker-rtx5090.trex-fiordland.ts.net:8764

NATS_BIND_IP=127.0.0.1
NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_USER=nyra-runtime
NATS_PASSWORD=REPLACE_WITH_RANDOM_NATS_PASSWORD

NYRA_DOCKER_NETWORK=nyra-network_nyra-network
