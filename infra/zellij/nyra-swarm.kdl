// infra/zellij/nyra-swarm.kdl
// 🌌 THE COCKPIT: Project Nyra Maximalist Swarm Layout
// Hand-crafted for WaveTerm + Zellij integration.

layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    // =========================================================================
    // TAB 1: THE GHOST LAYER (Hidden Routing)
    // Runs llxprt-jefe (daemon) & llxprt-code (proxy) to hijack API traffic.
    // Zellij auto-restarts these panes if they crash.
    // =========================================================================
    tab name="[0] GHOST_LAYER" hide_floating_panes=true {
        pane split_direction="vertical" {
            pane name="llxprt-jefe [DAEMON]" command="bash" {
                args "-c" "echo 'Starting llxprt-jefe...'; cd external/llxprt-jefe && while true; do ./jefe || echo 'Jefe crashed! Rebooting...'; sleep 3; done"
            }
            pane name="llxprt-code [PROXY]" command="bash" {
                args "-c" "echo 'Starting llxprt-code...'; cd external/llxprt-code && while true; do ./code || echo 'Code proxy crashed! Rebooting...'; sleep 3; done"
            }
        }
    }

    // =========================================================================
    // TAB 2: THE COCKPIT (Visible CLI Swarm)
    // 3 LLM CLIs pre-injected with the Ghost Layer local proxy endpoints.
    // 2 Heavy Metal SSH panels straight into OpenClaw workers.
    // =========================================================================
    tab name="[1] COCKPIT_SWARM" focus=true {
        pane split_direction="vertical" {
            pane split_direction="horizontal" size="60%" {
                pane name="[CLAUDE] claude-code" command="bash" {
                    args "-c" "export ANTHROPIC_BASE_URL=http://localhost:8080/v1; export ANTHROPIC_API_KEY=llxprt_ghost; echo '✅ ANTHROPIC_BASE_URL injected. Launching Claude Code...'; claude"
                }
                pane name="[GEMINI] gemini-cli" command="bash" {
                    args "-c" "export GEMINI_API_BASE=http://localhost:8080/v1; export GEMINI_API_KEY=llxprt_ghost; echo '✅ GEMINI_API_BASE injected. Launching Gemini...'; gemini"
                }
                pane name="[CODEX] codex-cli" command="bash" {
                    args "-c" "export OPENAI_BASE_URL=http://localhost:8080/v1; export OPENAI_API_KEY=llxprt_ghost; echo '✅ OPENAI_BASE_URL injected. Launching Codex...'; codex"
                }
            }
            pane split_direction="horizontal" size="40%" {
                pane name="[HEAVY METAL] RTX-5090 (OpenClaw)" command="bash" {
                    args "-c" "echo 'Connecting to Worker-5090...'; ssh -t worker-rtx5090-win 'docker exec -it worker-5090-openclaw bash || bash' || bash"
                }
                pane name="[HEAVY METAL] RTX-3090Ti (OpenClaw)" command="bash" {
                    args "-c" "echo 'Connecting to Worker-3090Ti...'; ssh -t worker-rtx3090ti-win 'docker exec -it worker-3090-openclaw bash || bash' || bash"
                }
            }
        }
    }
}