layout {
  tab name="Nyra Swarm" focus=true {
    pane split_direction="vertical" {
      pane name="codex" command="scripts/nyra-zellij-pane.sh" {
        args "swarm-codex" "codex --model gpt-5.5"
      }
      pane split_direction="horizontal" {
        pane name="gemini" command="scripts/nyra-zellij-pane.sh" {
          args "swarm-gemini" "gemini"
        }
        pane name="claude" command="scripts/nyra-zellij-pane.sh" {
          args "swarm-claude" "claude"
        }
      }
    }
  }
}
