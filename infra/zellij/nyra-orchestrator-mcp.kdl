layout {
  tab name="Orchestrator MCP" focus=true {
    pane split_direction="vertical" {
      pane name="nexus" command="scripts/nyra-zellij-pane.sh" {
        args "nexus" "curl -fsS http://orchestrator.trex-fiordland.ts.net:6000/health || true; exec bash"
      }
      pane name="letta-mcp" command="scripts/nyra-zellij-pane.sh" {
        args "letta-mcp" "curl -fsS http://oracle-vps.trex-fiordland.ts.net:8284/health || true; exec bash"
      }
    }
  }
}
