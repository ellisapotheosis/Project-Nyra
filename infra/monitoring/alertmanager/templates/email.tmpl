{{ define "email.default.subject" }}
[{{ .Status | toUpper }}{{ if eq .Status "firing" }}:{{ .Alerts.Firing | len }}{{ end }}] {{ .GroupLabels.alertname }} - {{ .GroupLabels.cluster }}
{{ end }}

{{ define "email.default.html" }}
<!DOCTYPE html>
<html>
<head>
<style>
  body { font-family: Arial, sans-serif; }
  .alert { border-left: 4px solid #ff9800; padding: 10px; margin: 10px 0; background-color: #fff3e0; }
  .critical { border-left-color: #f44336; background-color: #ffebee; }
  .warning { border-left-color: #ff9800; background-color: #fff3e0; }
  .info { border-left-color: #2196f3; background-color: #e3f2fd; }
  table { border-collapse: collapse; width: 100%; }
  th, td { text-align: left; padding: 8px; border-bottom: 1px solid #ddd; }
  th { background-color: #f2f2f2; }
  .resolved { color: #4caf50; }
  .firing { color: #f44336; }
</style>
</head>
<body>

<h2>Alert Notification</h2>
<p><strong>Status:</strong> <span class="{{ .Status }}">{{ .Status | toUpper }}</span></p>
<p><strong>Group:</strong> {{ .GroupLabels.alertname }}</p>
<p><strong>Cluster:</strong> {{ .GroupLabels.cluster }}</p>
<p><strong>Time:</strong> {{ .Alerts.Firing | len }} firing, {{ .Alerts.Resolved | len }} resolved</p>

<h3>Firing Alerts</h3>
{{ range .Alerts.Firing }}
<div class="alert {{ .Labels.severity }}">
  <h4>{{ .Annotations.summary }}</h4>
  <p>{{ .Annotations.description }}</p>
  <table>
    <tr><th>Label</th><th>Value</th></tr>
    {{ range .Labels.SortedPairs }}
    <tr><td>{{ .Name }}</td><td>{{ .Value }}</td></tr>
    {{ end }}
  </table>
  {{ if .Annotations.dashboard }}
  <p><a href="{{ .Annotations.dashboard }}">View Dashboard</a></p>
  {{ end }}
  {{ if .Annotations.runbook }}
  <p><a href="{{ .Annotations.runbook }}">View Runbook</a></p>
  {{ end }}
</div>
{{ end }}

{{ if gt (len .Alerts.Resolved) 0 }}
<h3>Resolved Alerts</h3>
{{ range .Alerts.Resolved }}
<div class="alert info">
  <h4>✓ {{ .Annotations.summary }}</h4>
  <p>{{ .Annotations.description }}</p>
</div>
{{ end }}
{{ end }}

<hr>
<p><small>Generated by AlertManager at {{ .ExternalURL }}</small></p>

</body>
</html>
{{ end }}
