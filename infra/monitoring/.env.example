# Monitoring Stack Environment Variables
# Copy this file to .env and update with your values

# ==========================================
# GRAFANA
# ==========================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# ==========================================
# DATABASE CONNECTION
# ==========================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=nyra

# ==========================================
# REDIS CONNECTION
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# ==========================================
# ALERTMANAGER NOTIFICATIONS
# ==========================================

# Slack Webhooks
SLACK_WEBHOOK_CRITICAL=https://hooks.slack.com/services/YOUR/CRITICAL/WEBHOOK
SLACK_WEBHOOK_WARNINGS=https://hooks.slack.com/services/YOUR/WARNINGS/WEBHOOK
SLACK_WEBHOOK_DATABASE=https://hooks.slack.com/services/YOUR/DATABASE/WEBHOOK
SLACK_WEBHOOK_APPLICATION=https://hooks.slack.com/services/YOUR/APPLICATION/WEBHOOK
SLACK_WEBHOOK_INFRASTRUCTURE=https://hooks.slack.com/services/YOUR/INFRA/WEBHOOK

# Email Configuration
SMTP_FROM=alerts@example.com
SMTP_SMARTHOST=smtp.gmail.com:587
SMTP_AUTH_USERNAME=alerts@example.com
SMTP_AUTH_PASSWORD=your-app-password

# PagerDuty
PAGERDUTY_SERVICE_KEY=your-pagerduty-service-key

# ==========================================
# HOSTNAME
# ==========================================
HOSTNAME=nyra-production
