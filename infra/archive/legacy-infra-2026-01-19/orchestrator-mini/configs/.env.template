# Infisical Environment Configuration Template
# Copy this file to .env.infisical and fill in your values
# NEVER commit the actual .env.infisical file!

# ====================
# Infisical Configuration
# ====================

# Project Configuration
export INFISICAL_PROJECT_ID="your-project-id-here"
export INFISICAL_WORKSPACE_ID="your-workspace-id-here"

# Machine Identity (will be set by setup script)
export INFISICAL_MACHINE_IDENTITY_PATH="./credentials/orchestrator-mini-identity"

# Environment Selection
export INFISICAL_ENVIRONMENT="production"  # Options: dev, staging, prod

# API Configuration
export INFISICAL_API_URL="https://app.infisical.com/api"

# ====================
# Machine Configuration
# ====================

# Machine Type (will be auto-detected by setup script)
# Options: orchestrator-mini, worker-rtx3060, worker-rtx3090ti, worker-rtx5090
export MACHINE_TYPE="orchestrator-mini"

# Machine Hostname
export MACHINE_HOSTNAME="$(hostname)"

# ====================
# Logging Configuration
# ====================

# Log Level (debug, info, warn, error)
export INFISICAL_LOG_LEVEL="info"

# Log Format (json, text)
export LOG_FORMAT="json"

# ====================
# MCP Server Configuration
# ====================

# MCP Server Port
export MCP_SERVER_PORT="3100"

# MCP Server Host
export MCP_SERVER_HOST="0.0.0.0"

# ====================
# Bitwarden Configuration (Optional)
# ====================

# Bitwarden Client ID
export BW_CLIENTID=""

# Bitwarden Client Secret
export BW_CLIENTSECRET=""

# Bitwarden Server URL
export BW_SERVER="https://vault.bitwarden.com"

# ====================
# Docker Configuration
# ====================

# Docker Compose Project Name
export COMPOSE_PROJECT_NAME="project-nyra"

# Docker Network Name
export DOCKER_NETWORK="orchestrator-network"

# ====================
# Environment-Specific IDs
# ====================

# These will be populated after creating environments in Infisical
export INFISICAL_ENV_DEV_ID=""
export INFISICAL_ENV_STAGING_ID=""
export INFISICAL_ENV_PROD_ID=""

# ====================
# Cache Configuration
# ====================

# Cache TTL in seconds (default: 300 = 5 minutes)
export INFISICAL_CACHE_TTL="300"

# Cache Directory
export INFISICAL_CACHE_DIR="./.infisical-cache"

# ====================
# Security Configuration
# ====================

# Enable audit logging
export INFISICAL_AUDIT_LOGGING="true"

# Encryption key path (for local encryption)
export ENCRYPTION_KEY_PATH="./credentials/encryption-key"

# ====================
# Notes
# ====================

# 1. Run setup-infisical.sh to automatically configure most values
# 2. Get Project ID from Infisical dashboard: Settings > General
# 3. Create machine identity: Settings > Machine Identities
# 4. Never commit this file with actual values!
# 5. Keep credentials/ directory secured (chmod 700)
