# ==== LLM KEYS ====
ANTHROPIC_API_KEY=REPLACE_ME
OPENROUTER_API_KEY=REPLACE_ME
# Optional if you route some models directly:
OPENAI_API_KEY=
# ==== COMMUNICATIONS (optional) ====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# ==== TWENTY CRM ====
# NOTE: Dev defaults in docker-compose.yml are OK for local use, but rotate for prod.
TWENTY_ENCRYPTION_SECRET=changeme-32+chars-minimum
TWENTY_JWT_SECRET=changeme-32+chars-minimum
TWENTY_PASSWORD_SALT=changeme-32+chars-minimum
TWENTY_SERVER_URL=http://localhost:3000
# ==== NYRA ORCHESTRATOR ====
NYRA_ALLOWED_CHANNELS=sms,email,webchat
NYRA_ESCALATION_EMAIL=ops@yourdomain.com
NYRA_POLICY_MODE=strict

# ==== N8N (optional) ====
N8N_BASIC_AUTH_USER=nyra
N8N_BASIC_AUTH_PASSWORD=changeme

# ==== DIFY (optional) ====
DIFY_SECRET_KEY=REPLACE_ME_LONG_RANDOM
DIFY_POSTGRES_USER=dify
DIFY_POSTGRES_PASSWORD=dify
DIFY_POSTGRES_DB=dify

# ==== GRAPHITI (optional) ====
GRAPHITI_GROUP_ID=nyra
# OPENAI_API_KEY can be set to an OpenAI key, or leave blank and configure Graphiti to use Anthropic/Groq/etc.


# ==== OPEN WEBUI + DISTRIBUTED WORKER MODELS ====
# Open WebUI authenticates to LiteLLM using this key.
OPENWEBUI_OPENAI_API_KEY=sk-local-dev

# Tailscale/DNS URLs for worker model servers (OpenAI-compatible endpoints)
# Examples: http://worker-5090.tailnet-name.ts.net:8000/v1 or http://100.101.102.103:8000/v1
LLXPERT_CODER_BASE_URL=http://worker-3090.tailnet-name.ts.net:8000/v1
LLXPERT_CODER_API_KEY=dummy
LLXPERT_JEFE_BASE_URL=http://worker-5090.tailnet-name.ts.net:8000/v1
LLXPERT_JEFE_API_KEY=dummy

# Optional third worker endpoint (for embeddings/specialized model)
LLXPERT_AUX_BASE_URL=http://worker-3060.tailnet-name.ts.net:11434/v1
LLXPERT_AUX_API_KEY=dummy

# Tailscale worker hostnames/IPs used by mesh preflight checks.
WORKER_1_HOST=worker-5090.tailnet-name.ts.net
WORKER_2_HOST=worker-3090.tailnet-name.ts.net
WORKER_3_HOST=worker-3060.tailnet-name.ts.net
