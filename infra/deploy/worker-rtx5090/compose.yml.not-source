services:
  vllm:
    image: vllm/vllm-openai:latest
    container_name: nyra-vllm-5090
    ports:
      - "8000:8000"
    environment:
      HUGGING_FACE_HUB_TOKEN: ${HF_TOKEN}
      VLLM_API_KEY: ${VLLM_API_KEY:-local-dev-key}
    command: >
      --model ${VLLM_MODEL}
      --host 0.0.0.0
      --port 8000
      --api-key ${VLLM_API_KEY:-local-dev-key}
      --dtype auto
      --gpu-memory-utilization 0.90
      --max-model-len 8192
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
    restart: unless-stopped
