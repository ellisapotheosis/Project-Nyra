# =============================================================================
# infra/worker-pcs/TEMPLATE.env.host
# Copy this file to infra/worker-pcs/<node-name>/.env.host and fill in values.
# =============================================================================

# SSH config Host alias from ~/.ssh/config — REQUIRED
# Maps to: orch | 5090 | 3090 | 3060
SSH_ALIAS=

# Human-readable label for this node
NODE_LABEL=

# Portainer shared secret (optional but recommended in production)
# Generate with: openssl rand -hex 32
PORTAINER_AGENT_SECRET=

# Tailscale IP (documentation only, not used by the deploy script)
NODE_IP=
