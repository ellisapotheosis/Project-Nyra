FROM node:20-alpine AS base
ARG APP_PATH
ARG APP_NAME

FROM base AS builder
RUN apk add --no-cache libc6-compat
WORKDIR /app
ARG APP_PATH
ARG APP_NAME
# Full workspace copy is required so pnpm sees all workspace package.json files
# and resolves peer-dep hashes consistently with the lockfile.
COPY . .
RUN corepack enable && pnpm install --no-frozen-lockfile && pnpm --filter ${APP_NAME} build

FROM base AS runner
WORKDIR /app
ARG APP_PATH
ARG APP_NAME
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs
# standalone output traces only runtime-needed files — image ~200MB vs ~3GB
COPY --from=builder --chown=nextjs:nodejs /app/${APP_PATH}/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/${APP_PATH}/.next/static ./${APP_PATH}/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/${APP_PATH}/public ./${APP_PATH}/public
WORKDIR /app/${APP_PATH}
USER nextjs
EXPOSE 3000
ENV PORT=3000
CMD ["node", "server.js"]
