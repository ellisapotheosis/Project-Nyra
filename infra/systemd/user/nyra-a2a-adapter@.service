[Unit]
Description=Project Nyra A2A Adapter (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/nyra/a2a-%i.env
WorkingDirectory=%h/projects/project-nyra/services/agent-runtime/a2a-command-adapter
ExecStart=/usr/bin/env node server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.local/state/nyra-a2a %h/projects/project-nyra

[Install]
WantedBy=default.target
