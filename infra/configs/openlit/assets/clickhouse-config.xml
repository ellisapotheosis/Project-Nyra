<clickhouse>
    <!-- Listen on all interfaces so the openlit container can reach it -->
    <listen_host>0.0.0.0</listen_host>

    <!-- Conservative memory caps for a shared orchestrator host -->
    <max_memory_usage>2000000000</max_memory_usage>
    <max_server_memory_usage>4000000000</max_server_memory_usage>

    <!-- Reduce noise in container logs -->
    <logger>
        <level>warning</level>
        <console>true</console>
        <log>/dev/null</log>
        <errorlog>/dev/stderr</errorlog>
    </logger>

    <!-- Allow the openlit app user to connect without a password for health checks -->
    <access_control_improvements>
        <users_without_row_level_security>default</users_without_row_level_security>
    </access_control_improvements>
</clickhouse>
