# Archon OS Infisical Template
# This file renders the actual .env for the services
# It maps Infisical project secrets into a flat env file

ARCHON_ENV={{ .ARCHON_ENV }}
ARCHON_OS_PORT={{ .ARCHON_OS_PORT }}
NEXUS_ROUTER_URL={{ .NEXUS_ROUTER_URL }}
DATABASE_URL={{ .DATABASE_URL }}
REDIS_URL={{ .REDIS_URL }}
OPENAI_API_KEY={{ .OPENAI_API_KEY }}
ANTHROPIC_API_KEY={{ .ANTHROPIC_API_KEY }}
GOOGLE_API_KEY={{ .GOOGLE_API_KEY }}
GITHUB_TOKEN={{ .GITHUB_TOKEN }}
LITELLM_MASTER_KEY={{ .LITELLM_MASTER_KEY }}
POSTGRES_USER={{ .POSTGRES_USER }}
POSTGRES_PASSWORD={{ .POSTGRES_PASSWORD }}
POSTGRES_DB={{ .POSTGRES_DB }}
REDIS_PASSWORD={{ .REDIS_PASSWORD }}
