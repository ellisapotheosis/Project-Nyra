# =============================================================================
# OPTIMAL PRODUCTION CONFIGURATION
# =============================================================================
# This file contains optimized environment variable values for production.
#
# SETUP INSTRUCTIONS:
# 1. NEVER commit this file with real secrets to version control
# 2. Use Infisical to inject secrets at runtime:
#    infisical run -- docker-compose up
# 3. Use environment variable substitution or secrets manager:
#    - AWS Secrets Manager
#    - Azure Key Vault
#    - Infisical
#    - HashiCorp Vault
# 4. Replace all placeholder values with actual production values
# 5. Run security audit before deploying: npm run security:audit
#
# KEY DIFFERENCES FROM DEVELOPMENT:
# - Production service URLs (domain names, managed services)
# - Strict security settings (CORS restricted, debug disabled)
# - Production API keys and credentials
# - Monitoring and APM enabled
# - Comprehensive logging with remote aggregation
# - Production feature flags (experimental features disabled)
# - Optimized cache TTLs for performance
# - Database connection pooling optimized for scale
# =============================================================================

# ============================================================================
# NODE & APPLICATION ENVIRONMENT
# ============================================================================
NODE_ENV=production
DEBUG=false
LOG_LEVEL=info

# Application Name & Version
APP_NAME=Project-Nyra
APP_VERSION=0.1.0

# Application URLs (Use your production domain)
APP_HOST=0.0.0.0
APP_PORT=3000
APP_PROTOCOL=https
APP_URL=https://nyra.example.com
API_BASE_URL=https://api.nyra.example.com

# CORS Settings (Restrict to known domains)
CORS_ORIGIN=https://nyra.example.com,https://app.nyra.example.com
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL (Primary Database - Use Managed Service)
# Reference Infisical or secrets manager: ${DATABASE_URL}
DATABASE_URL=${DATABASE_URL}
DB_HOST=${DB_HOST}
DB_PORT=5432
DB_USERNAME=${DB_USERNAME}
DB_PASSWORD=${DB_PASSWORD}
DB_NAME=${DB_NAME}
DB_SSL=true

# Connection Pool Settings (Production - Optimized for concurrent users)
DB_POOL_MIN=5
DB_POOL_MAX=50
DB_IDLE_TIMEOUT=30000
DB_STATEMENT_TIMEOUT=60000
DB_CONNECTION_TIMEOUT=10000

# MongoDB (if using secondary store - Managed Atlas)
MONGODB_URL=${MONGODB_URL}
MONGODB_DATABASE=${MONGODB_DATABASE}

# Redis (Managed Cache & Sessions)
REDIS_URL=${REDIS_URL}
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_DB=0
REDIS_TLS=true
REDIS_TTL=3600

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# JWT Configuration (Use strong secrets from Infisical)
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRE=24h
JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET}
JWT_REFRESH_EXPIRE=7d

# OAuth2 / External Auth (Production Keys)
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}
GOOGLE_CALLBACK_URL=https://nyra.example.com/auth/google/callback

GITHUB_CLIENT_ID=${GITHUB_CLIENT_ID}
GITHUB_CLIENT_SECRET=${GITHUB_CLIENT_SECRET}
GITHUB_CALLBACK_URL=https://nyra.example.com/auth/github/callback

# Session Configuration (Secure Production Settings)
SESSION_SECRET=${SESSION_SECRET}
SESSION_TIMEOUT=1800000
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# Password Reset Token (Production)
PASSWORD_RESET_TOKEN_EXPIRE=15m
PASSWORD_RESET_TIMEOUT=900000

# TLS/SSL Configuration
TLS_ENABLED=true
TLS_CERT_PATH=/etc/ssl/certs/tls.crt
TLS_KEY_PATH=/etc/ssl/private/tls.key

# ============================================================================
# API KEYS & EXTERNAL SERVICES
# ============================================================================
# Email Service (SendGrid/Mailgun Production)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=${SENDGRID_API_KEY}
SENDGRID_FROM=noreply@nyra.example.com
SENDGRID_REPLY_TO=support@nyra.example.com

# SMS Service (Twilio Production)
TWILIO_ACCOUNT_SID=${TWILIO_ACCOUNT_SID}
TWILIO_AUTH_TOKEN=${TWILIO_AUTH_TOKEN}
TWILIO_PHONE_NUMBER=${TWILIO_PHONE_NUMBER}

# Payment Processing (Stripe Production)
STRIPE_PUBLIC_KEY=${STRIPE_PUBLIC_KEY}
STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY}
STRIPE_WEBHOOK_SECRET=${STRIPE_WEBHOOK_SECRET}

# Cloud Storage (AWS S3 Production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
AWS_S3_BUCKET=nyra-prod
AWS_S3_ENDPOINT=https://s3.amazonaws.com
AWS_S3_URL_EXPIRY=3600

# CDN Configuration (CloudFront / Cloudflare)
CDN_URL=https://cdn.nyra.example.com
CDN_INVALIDATION_KEY=${CDN_INVALIDATION_KEY}

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
# Logging Configuration (Structured JSON logs for aggregation)
LOG_FORMAT=json
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_PATH=/var/log/app/app.log
LOG_MAX_FILES=30
LOG_MAX_SIZE=100M

# Remote Log Aggregation
LOG_AGGREGATION_ENABLED=true
LOG_AGGREGATION_URL=${LOG_AGGREGATION_URL}
LOG_AGGREGATION_API_KEY=${LOG_AGGREGATION_API_KEY}

# HTTP Request Logging
HTTP_LOG_ENABLED=true
HTTP_LOG_LEVEL=info

# Database Query Logging (Minimal in production)
DB_QUERY_LOG=false
DB_QUERY_SLOW_THRESHOLD=1000

# APM / Error Tracking (Sentry / DataDog)
APM_ENABLED=true
SENTRY_DSN=${SENTRY_DSN}
SENTRY_ENVIRONMENT=production
SENTRY_DEBUG=false
SENTRY_SAMPLE_RATE=0.1
SENTRY_TRACES_SAMPLE_RATE=0.05

# DataDog (Alternative)
DATADOG_ENABLED=false
DATADOG_API_KEY=${DATADOG_API_KEY}
DATADOG_SITE=datadoghq.com

# Health Check Endpoint
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# ============================================================================
# FEATURE FLAGS (Production)
# ============================================================================
# Disable experimental features in production
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_BETA_API=false
FEATURE_EXPERIMENTAL_UI=false
FEATURE_DEBUG_ENDPOINTS=false
FEATURE_MOCK_DATA=false

# Rate Limiting (Strict in Production)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# DDoS Protection
DDOS_PROTECTION_ENABLED=true
CLOUDFLARE_ENABLED=true
CLOUDFLARE_ZONE_ID=${CLOUDFLARE_ZONE_ID}
CLOUDFLARE_API_TOKEN=${CLOUDFLARE_API_TOKEN}

# ============================================================================
# CACHING & PERFORMANCE
# ============================================================================
# Cache TTLs (Optimized for production performance)
CACHE_TTL_DEFAULT=3600
CACHE_TTL_USER=7200
CACHE_TTL_CONTENT=1800
CACHE_TTL_AUTH=300

# Query Result Caching
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL=3600

# Static Asset Caching
STATIC_CACHE_MAX_AGE=31536000

# Compression
ENABLE_GZIP=true
GZIP_LEVEL=6

# ============================================================================
# FILE UPLOAD & STORAGE
# ============================================================================
# Upload Configuration
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=/var/uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx
STORAGE_TYPE=s3

# Virus Scanning
ENABLE_VIRUS_SCAN=true
CLAM_AV_HOST=${CLAM_AV_HOST}
CLAM_AV_PORT=3310

# ============================================================================
# WORKER & JOB QUEUE
# ============================================================================
# Bull / Job Queue (Redis-backed)
QUEUE_REDIS_URL=${QUEUE_REDIS_URL}
QUEUE_CONCURRENCY=50
QUEUE_PROCESSING_DELAY=0
QUEUE_ATTEMPTS=5
QUEUE_BACKOFF_DELAY=30000

# Background Jobs
ENABLE_JOB_QUEUE=true
JOB_QUEUE_TYPE=bull
JOB_QUEUE_PRIORITY=true

# ============================================================================
# THIRD-PARTY INTEGRATIONS
# ============================================================================
# Infisical Secret Management (Recommended for production)
INFISICAL_TOKEN=${INFISICAL_TOKEN}
INFISICAL_ENVIRONMENT=prod

# GitHub Integration
GITHUB_TOKEN=${GITHUB_TOKEN}
GITHUB_REPO=ruvnet/Project-Nyra
GITHUB_BRANCH=main

# Slack Integration (for alerts)
SLACK_WEBHOOK_URL=${SLACK_WEBHOOK_URL}
SLACK_ENABLED=true

# ============================================================================
# PERFORMANCE & SCALING
# ============================================================================
# Clustering / Load Balancing
ENABLE_CLUSTERING=true
CLUSTER_NUM_WORKERS=auto

# Request Timeout
REQUEST_TIMEOUT=30000
BODY_TIMEOUT=30000

# Keep-Alive Settings
KEEP_ALIVE_TIMEOUT=65000

# ============================================================================
# COMPLIANCE & SECURITY
# ============================================================================
# GDPR/Privacy
GDPR_ENABLED=true
DATA_RETENTION_DAYS=365
DATA_DELETION_RETENTION_DAYS=30

# Security Headers (Strict production settings)
ENABLE_HELMET=true
ENABLE_CSRF_PROTECTION=true
ENABLE_HSTS=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true

# IP Whitelisting (if needed)
IP_WHITELIST_ENABLED=false
IP_WHITELIST=${IP_WHITELIST}

# SSL/TLS
MIN_TLS_VERSION=1.2
CIPHER_SUITES=HIGH:!aNULL:!MD5

# API Key Rotation
API_KEY_ROTATION_ENABLED=true
API_KEY_ROTATION_DAYS=90

# ============================================================================
# BACKUP & DISASTER RECOVERY
# ============================================================================
# Database Backups
DB_BACKUP_ENABLED=true
DB_BACKUP_SCHEDULE=0 2 * * *
DB_BACKUP_RETENTION_DAYS=30
DB_BACKUP_S3_BUCKET=${DB_BACKUP_S3_BUCKET}

# Replication & Failover
DB_REPLICA_HOST=${DB_REPLICA_HOST}
DB_REPLICA_ENABLED=true

# ============================================================================
# MONITORING & ALERTS
# ============================================================================
# Prometheus Metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Alert Manager
ALERT_MANAGER_ENABLED=true
ALERT_EMAIL=${ALERT_EMAIL}
ALERT_SLACK_CHANNEL=${ALERT_SLACK_CHANNEL}

# ============================================================================
# DEPLOYMENT & CI/CD
# ============================================================================
# Docker / Container Settings
DOCKER_REGISTRY=${DOCKER_REGISTRY}
DOCKER_IMAGE=nyra:latest

# Kubernetes (if applicable)
KUBE_NAMESPACE=production
KUBE_REPLICAS=3

# Deployment Strategy
DEPLOYMENT_STRATEGY=rolling
DEPLOYMENT_MIN_READY_SECONDS=10

# =============================================================================
# END OF PRODUCTION CONFIGURATION
# =============================================================================
# CRITICAL REMINDERS:
# 1. NEVER commit this file with real secrets to version control
# 2. Use Infisical or a secrets manager to inject values at runtime
# 3. All ${VAR} placeholders MUST be replaced with actual values
# 4. Rotate secrets regularly (API keys, JWT secrets, etc.)
# 5. Use separate credentials for each environment
# 6. Enable audit logging for all secret access
# 7. Run security audits before each deployment
# =============================================================================
