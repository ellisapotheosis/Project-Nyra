# ==============================================================================
# Git Configuration for Claude Flow CI/CD Container
# ==============================================================================
# This file is mounted into the container at /root/.gitconfig
# ==============================================================================

[user]
    name = Claude Flow CI/CD
    email = cicd@nyra.local

[core]
    # Use SSH for Git operations
    sshCommand = ssh -i /root/.ssh/id_ed25519 -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no

    # Line ending configuration
    autocrlf = input
    eol = lf

    # Editor (fallback)
    editor = vim

    # File permissions
    fileMode = true

    # Compression
    compression = 9

[init]
    defaultBranch = main

[pull]
    rebase = false

[push]
    default = simple
    followTags = true

[fetch]
    prune = true
    prunetags = true

[rebase]
    autoStash = true

[diff]
    algorithm = histogram
    colorMoved = default

[merge]
    conflictStyle = diff3
    ff = false

[credential]
    helper = store --file /root/.git-credentials

[commit]
    # Automatically sign commits (optional - requires GPG setup)
    # gpgsign = true

    # Template for commit messages
    # template = /workspace/.gitmessage

[tag]
    # Automatically sign tags (optional)
    # gpgsign = true

[color]
    ui = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold

[color "status"]
    added = green
    changed = yellow
    untracked = red

[alias]
    # Logging
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

    # Status
    st = status -sb

    # Branch management
    br = branch -vv

    # Commit shortcuts
    ci = commit
    co = checkout

    # Diff shortcuts
    di = diff
    dc = diff --cached

    # Stash shortcuts
    sl = stash list
    sa = stash apply
    ss = stash save

[http]
    # Timeout settings
    postBuffer = 524288000
    lowSpeedLimit = 1000
    lowSpeedTime = 600

[https]
    # SSL verification (disable for self-signed certs in development)
    # sslVerify = false

# ==============================================================================
# GitHub specific configuration
# ==============================================================================
[url "https://github.com/"]
    insteadOf = gh:

[url "https://gitlab.com/"]
    insteadOf = gl:

# ==============================================================================
# Performance optimization
# ==============================================================================
[pack]
    threads = 0
    windowMemory = 100m

[gc]
    auto = 256

# ==============================================================================
# Security
# ==============================================================================
[transfer]
    fsckobjects = true

[receive]
    fsckObjects = true

[fetch]
    fsckobjects = true

# ==============================================================================
# Notes
# ==============================================================================
# 1. This configuration is optimized for CI/CD automation
# 2. Credentials are stored in /root/.git-credentials (mounted separately)
# 3. SSH keys should be mounted at /root/.ssh/
# 4. For GPG signing, mount GPG keys and configure GPG agent
# ==============================================================================
