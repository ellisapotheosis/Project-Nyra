# ==============================================================================
# CLAUDE FLOW CI/CD - ENVIRONMENT CONFIGURATION
# Project Nyra - Dedicated CI/CD Container Environment
# ==============================================================================
# Copy this file to .env.cicd and configure with your actual values
# DO NOT commit .env.cicd to version control
# ==============================================================================

# ==============================================================================
# CORE CONFIGURATION
# ==============================================================================
NODE_ENV=production
CLAUDE_FLOW_MODE=v3
CLAUDE_FLOW_VERSION=3.0.0-alpha.104
CLAUDE_FLOW_CICD_MODE=true
CLAUDE_FLOW_ENVIRONMENT=cicd

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================
CLAUDE_FLOW_ENABLED=true
CLAUDE_FLOW_AUTO_COMMIT=true
CLAUDE_FLOW_AUTO_PUSH=false
CLAUDE_FLOW_HOOKS_ENABLED=true
CLAUDE_FLOW_TELEMETRY_ENABLED=false
CLAUDE_FLOW_REMOTE_EXECUTION=true
CLAUDE_FLOW_GITHUB_INTEGRATION=true
CLAUDE_FLOW_CHECKPOINTS_ENABLED=true
CLAUDE_FLOW_MEMORY_PERSISTENCE=true
CLAUDE_FLOW_NEURAL_OPTIMIZATION=true
CLAUDE_FLOW_AUTO_LEARNING=true
CLAUDE_FLOW_PARALLEL_PROCESSING=true
CLAUDE_FLOW_PERFORMANCE_MODE=optimized
CLAUDE_FLOW_TRUTH_THRESHOLD=0.95
CLAUDE_FLOW_VERIFY_MODE=strict
CLAUDE_FLOW_SECURITY_AUDIT=true

# ==============================================================================
# LOGGING & DEBUGGING
# ==============================================================================
CLAUDE_FLOW_DEBUG=false
CLAUDE_FLOW_LOG_LEVEL=info
CLAUDE_FLOW_LOG_FILE=/data/claude-flow/logs/cicd.log

# ==============================================================================
# PERFORMANCE CONFIGURATION
# ==============================================================================
CLAUDE_FLOW_MAX_AGENTS=35
CLAUDE_FLOW_MAX_CONCURRENT_TASKS=25
CLAUDE_FLOW_MEMORY_LIMIT=8192
CLAUDE_FLOW_CACHE_SIZE=2048
CLAUDE_FLOW_WORKER_THREADS=16
MAX_AGENTS=35

# ==============================================================================
# SWARM COORDINATION
# ==============================================================================
SWARM_TOPOLOGY=mesh
SWARM_COORDINATION_PROTOCOL=mesh
SWARM_MEMORY_SHARED=true
SWARM_NEURAL_SYNC=true
SWARM_MAX_AGENTS=35
SWARM_AUTO_SCALE=true

# ==============================================================================
# AGENTDB CONFIGURATION (150x-12,500x FASTER)
# ==============================================================================
AGENTDB_ENABLED=true
AGENTDB_PATH=/data/agentdb/claude-flow.db
AGENTDB_QUANTIZATION=scalar
AGENTDB_CACHE_SIZE=2000
AGENTDB_HNSW_M=16
AGENTDB_HNSW_EF=200
AGENTDB_HNSW_EF_SEARCH=100
AGENTDB_LEARNING=true
AGENTDB_LEARNING_ALGORITHM=decision-transformer
AGENTDB_REASONING=true
AGENTDB_QUIC_SYNC=false
AGENTDB_AUTO_MIGRATE=true
AGENTDB_FALLBACK_LEGACY=true

# ==============================================================================
# REASONINGBANK CONFIGURATION
# ==============================================================================
REASONINGBANK_ENABLED=true
REASONINGBANK_DB_PATH=/data/memory/reasoning.db
REASONINGBANK_K=10
REASONINGBANK_MIN_CONFIDENCE=0.5
AGENTIC_FLOW_TRAINING=true

# ==============================================================================
# MEMORY & PERSISTENCE
# ==============================================================================
MEMORY_BACKEND=hybrid
MEMORY_PRIMARY_STORE=agentdb
MEMORY_SECONDARY_STORE=sqlite
MEMORY_AUTO_PERSIST=true
MEMORY_COMPRESSION=true
MEMORY_SYNC_INTERVAL=60
MEMORY_RETENTION_DAYS=90
MEMORY_BACKUP_TO_GITHUB=false
MEMORY_NAMESPACES=cicd,tasks,patterns,errors,optimizations,deployments
MEMORY_ENABLE_HNSW=true
MEMORY_HNSW_EF_CONSTRUCTION=200
MEMORY_HNSW_M=16

# ==============================================================================
# NEURAL NETWORK CONFIGURATION
# ==============================================================================
NEURAL_OPTIMIZATION_ENABLED=true
NEURAL_FLASH_ATTENTION=true
NEURAL_MODEL_OPTIMIZATION=flash-attention-2
NEURAL_QUANTIZATION=int8
NEURAL_LEARNING_RATE=0.001
NEURAL_UPDATE_FREQUENCY=100
NEURAL_ERROR_PREVENTION_THRESHOLD=0.85
NEURAL_PERFORMANCE_AUTO_TUNE=true
NEURAL_BATCH_SIZE=32

# ==============================================================================
# API KEYS (REQUIRED)
# ==============================================================================
# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.7

# OpenAI (GPT)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_ORG_ID=

# Google (Gemini)
GOOGLE_API_KEY=your-key-here
GOOGLE_GEMINI_MODEL=gemini-2.0-flash-exp

# OpenRouter (DeepSeek, etc.)
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=deepseek/deepseek-r1

# ==============================================================================
# MODEL ROUTING
# ==============================================================================
COMPLETION_MODEL=claude-sonnet-4-5-20250929
PROVIDER=anthropic
MODEL_ROUTING_STRATEGY=cost-optimized
MODEL_ROUTING_PREFER_LOCAL=false
MODEL_ROUTING_FALLBACK_CLOUD=true

# ==============================================================================
# SECURITY SECRETS (GENERATE WITH: openssl rand -hex 32)
# ==============================================================================
JWT_SECRET=your-jwt-secret-here
ENCRYPTION_KEY=your-encryption-key-here
SESSION_SECRET=your-session-secret-here
ENCRYPTION_ALGORITHM=aes-256-gcm

# ==============================================================================
# RATE LIMITING
# ==============================================================================
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=30000

# ==============================================================================
# DATABASE CONNECTIONS (OPTIONAL - CONNECT TO MAIN STACK)
# ==============================================================================
# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=nyra_user
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=claude_flow_cicd
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# ==============================================================================
# GIT CONFIGURATION (FOR CHECKPOINTING)
# ==============================================================================
GIT_AUTHOR_NAME=Claude Flow CI/CD
GIT_AUTHOR_EMAIL=cicd@nyra.local
GIT_COMMITTER_NAME=Claude Flow CI/CD
GIT_COMMITTER_EMAIL=cicd@nyra.local

# GitHub integration (optional)
GITHUB_TOKEN=ghp_your-token-here
GITHUB_REPOSITORY=your-org/your-repo
GITHUB_BRANCH=main

# ==============================================================================
# CI/CD SPECIFIC SETTINGS
# ==============================================================================
# CI/CD provider detection
CI=true
CONTINUOUS_INTEGRATION=true
CI_PROVIDER=docker

# Build and deployment
BUILD_ID=${BUILD_ID:-local}
DEPLOYMENT_ENVIRONMENT=cicd
DEPLOYMENT_TARGET=testing

# Notification webhooks (optional)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
EMAIL_NOTIFICATIONS=false

# ==============================================================================
# TELEMETRY (DISABLED FOR CI/CD)
# ==============================================================================
NEXT_TELEMETRY_DISABLED=1
TURBO_TELEMETRY_DISABLED=1
DEBUG=false

# ==============================================================================
# PERFORMANCE TARGETS
# ==============================================================================
PERF_TARGET_COMMAND_EXECUTION=500
PERF_TARGET_MEMORY_OPERATIONS=100
PERF_TARGET_NEURAL_PREDICTIONS=50
PERF_TARGET_MCP_RESPONSE=100

# ==============================================================================
# NOTES
# ==============================================================================
# 1. Copy this file to .env.cicd
# 2. Fill in all required API keys and secrets
# 3. Generate secrets with: openssl rand -hex 32
# 4. DO NOT commit .env.cicd to version control
# 5. Use Infisical or Docker secrets in production
# 6. Rotate credentials regularly
# ==============================================================================
