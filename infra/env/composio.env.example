COMPOSIO_API_KEY=replace-with-composio-api-key
COMPOSIO_DEFAULT_USER_ID=nyra-system
COMPOSIO_MCP_SERVER_ID=replace-with-server-id
COMPOSIO_MCP_URL=https://backend.composio.dev/v3/mcp/${COMPOSIO_MCP_SERVER_ID}?user_id=${COMPOSIO_DEFAULT_USER_ID}
COMPOSIO_MCP_TRANSPORT=streamable-http
COMPOSIO_MCP_SERVER_NAME=composio
COMPOSIO_TOOLKITS_ALLOW=jira,slack,twenty
COMPOSIO_EXECUTION_POLICY=require-user-bound-connection
