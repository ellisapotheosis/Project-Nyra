# =============================================================================
# worker-rtx5090 (100.64.0.11) — primary inference + LMCache backend
# =============================================================================
# MEASURED HARDWARE (nvidia-smi, 2026-09-04):
#   NVIDIA GeForce RTX 5090 Laptop GPU
#   24463 MiB VRAM  (~23.9 GiB)
#   driver 616.64
#
# The repository previously described this GPU as 48 GB
# (services/nexus-router/src/config.ts). That was WRONG. Size for 24 GB.

# --- Hugging Face -------------------------------------------------------------
# Only required for gated/private model weights. Source: Infisical.
HUGGING_FACE_HUB_TOKEN=
HF_CACHE_DIR=

# --- vLLM ---------------------------------------------------------------------
# `--served-model-name` is a Nyra naming contract consumed by
# infra/configs/litellm/config.yaml. Do not change one side without the other.
VLLM_SERVED_NAME_5090=nyra-primary

# The Hugging Face model id to serve. NOT pre-filled: no model has been chosen
# and no vLLM deployment exists on this host yet (verified - `docker ps` shows
# no vLLM container anywhere in the fleet). Choose a model that fits 24 GB with
# KV headroom, then record the choice here.
VLLM_MODEL_5090=

# 0.88, not 0.95. On a 24 GB card 0.88 leaves ~2.9 GB for CUDA graphs, LMCache
# CPU-side overhead, the qwen3.5 Ollama fast lane and fragmentation.
# 0.95 leaves ~1.2 GB and consumes the final safety margin.
# Tune with measured idle VRAM, warm KV cache, peak prompt length, concurrency,
# CUDA graph overhead, LMCache overhead and OOM history - not by intuition.
VLLM_GPU_MEMORY_UTILIZATION_5090=0.88

# NO DEFAULT ON PURPOSE. max_model_len cannot be chosen without measuring KV
# cache footprint for the selected model at the intended concurrency. Guessing
# it is the single most common cause of OOM under load.
VLLM_MAX_MODEL_LEN_5090=

# --- LMCache ------------------------------------------------------------------
# LMCACHE_USE_EXPERIMENTAL must remain an ENVIRONMENT VARIABLE. `LMCACHE_ENABLE`
# is NOT the activation mechanism and is not used.
LMCACHE_USE_EXPERIMENTAL=True
LMCACHE_CHUNK_SIZE=256
LMCACHE_REMOTE_URL=redis://100.64.0.11:6379
LMCACHE_REMOTE_SERDE=naive
LMCACHE_CONFIG_FILE=/etc/lmcache/lmcache.yaml

# NO DEFAULT ON PURPOSE. Set from ACTUAL measured host RAM. Must not starve
# Linux, Docker, vLLM CPU-side work, the LMCache CPU cache, or the developer
# applications running on this workstation. Total system RAM was not measurable
# from the sandboxed WSL2 shell during migration, so no value is invented here.
LMCACHE_REDIS_MAXMEMORY=

# --- Ollama (fast lane only) ---------------------------------------------------
# EMBEDDINGS NO LONGER LIVE HERE. `nyra-embedding` moved to the orchestrator
# CPU (llama.cpp on 100.64.0.10:8081) - see infra/env/orchestrator.env.example.
# The old instruction to rebind this host's Ollama in order to unblock
# `nyra-embedding` and mcp_semantic_tool_filter is SUPERSEDED; do not follow it.
#
# What remains here is `nyra-fast` (ollama/qwen3.5:latest), which LiteLLM still
# reaches at http://100.64.0.11:11434. That lane needs the Tailnet bind; the
# embedding lane no longer does.
#
# The VRAM freed by removing the resident embedder stays inside the existing
# 0.88 gpu_memory_utilization budget as headroom - do NOT raise that number on
# the strength of this change without re-measuring.
OLLAMA_HOST=100.64.0.11:11434

# --- Infisical ----------------------------------------------------------------
# Worker service identity. Distinct from both the Oracle service identity and
# the autonomous-agent identity.
INFISICAL_DOMAIN=
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=
INFISICAL_SECRET_PATH=
INFISICAL_AGENT_PROXY_ADDRESS=

# --- Proxy exclusions ---------------------------------------------------------
# Local vLLM calls and LMCache Redis must NEVER traverse the Agent Proxy.
NO_PROXY=127.0.0.1,localhost,100.64.0.3,100.64.0.11,100.64.0.13,.trex-fiordland.ts.net,lmcache-redis
no_proxy=127.0.0.1,localhost,100.64.0.3,100.64.0.11,100.64.0.13,.trex-fiordland.ts.net,lmcache-redis
