# ===== Core =====
TZ=America/Los_Angeles

# --- RuVector Postgres (primary DB + vector + graph-ish ops) ---
POSTGRES_HOST=ruvector-postgres
POSTGRES_PORT=5432
POSTGRES_DB=claude_flow
POSTGRES_USER=claude
POSTGRES_PASSWORD=archon-os-test

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- LiteLLM (OpenAI-compatible gateway) ---
LITELLM_MASTER_KEY=CHANGE_ME__LITELLM_MASTER_KEY
LITELLM_PORT=4000

# Put provider keys here (or inject via Infisical/etc)
OPENAI_API_KEY=CHANGE_ME
ANTHROPIC_API_KEY=CHANGE_ME
GEMINI_API_KEY=CHANGE_ME
OPENROUTER_API_KEY=CHANGE_ME

# ===== Edge =====
# Cloudflare Tunnel token (recommended approach)
CLOUDFLARED_TOKEN=CHANGE_ME__CLOUDFLARED_TOKEN

# Optional: tailscale auth key for container (I usually prefer installing tailscale on the host)
TAILSCALE_AUTHKEY=CHANGE_ME__TS_AUTHKEY
TAILSCALE_HOSTNAME=orchestrator-mini
