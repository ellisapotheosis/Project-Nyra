# ============================================================================
# Project Nyra - Production Gitea Environment Configuration
# ============================================================================
# Copy to .env.gitea and customize for your environment
# Secrets are managed via Infisical - only non-sensitive config here
# ============================================================================

# ==========================================
# DEPLOYMENT CONFIGURATION
# ==========================================
NYRA_MACHINE=orchestrator
NYRA_NETWORK=nyra-net
COMPOSE_PROJECT_NAME=nyra-gitea
TZ=America/Los_Angeles

# ==========================================
# GITEA SERVER CONFIGURATION
# ==========================================
# Public facing URLs (update for your domain)
GITEA_DOMAIN=git.ratehunter.net
GITEA_ROOT_URL=https://git.ratehunter.net/
GITEA_SSH_DOMAIN=git.ratehunter.net
GITEA_PROTOCOL=https

# Ports (internal container and external host)
GITEA_PORT=3100
GITEA_SSH_PORT=2222
GITEA_DB_PORT=5433

# Repository settings
GITEA_OWNER=admin
GITEA_REPO=Project-Nyra

# Email configuration
GITEA_EMAIL_FROM=git@ratehunter.net
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=git@ratehunter.net

# ==========================================
# AI CODE REVIEW CONFIGURATION
# ==========================================
AI_REVIEWER_PORT=8091
REVIEW_MODEL=claude-3.5-sonnet
REVIEW_MAX_CHARS=18000
REVIEW_POST_AS_REVIEW=true
REVIEW_LABEL=ai-reviewed

# AI model routing via Nexus
OPENAI_BASE_URL=http://nexus-router:6000/v1

# ==========================================
# MCP SERVER CONFIGURATION
# ==========================================
GITEA_MCP_PORT=8092

# ==========================================
# GITHUB SYNCHRONIZATION
# ==========================================
GITHUB_REPO=ellisapotheosis/Project-Nyra
SYNC_INTERVAL=300
SYNC_DIRECTION=bidirectional
CONFLICT_RESOLUTION=gitea_wins

# ==========================================
# INFISICAL SECRETS CONFIGURATION
# ==========================================
INFISICAL_API_URL=https://app.infisical.com
INFISICAL_PROJECT_ID=8374cea9-e5e8-4050-bda4-b91f25ab30ef
INFISICAL_ENV=prod
INFISICAL_PATH=/nyra/gitea
INFISICAL_POLL_INTERVAL=300s
NYRA_FORCE_SECRETS=false

# ==========================================
# DATA STORAGE PATHS
# ==========================================
# Local data storage (customize for your setup)
GITEA_DATA_PATH=./data/gitea
GITEA_DB_PATH=./data/gitea-db

# ==========================================
# PERFORMANCE TUNING
# ==========================================
LOG_LEVEL=Info

# ==========================================
# DEVELOPMENT OVERRIDES
# ==========================================
# Uncomment for development
# GITEA_DOMAIN=localhost
# GITEA_ROOT_URL=http://localhost:3100/
# GITEA_PROTOCOL=http
# LOG_LEVEL=Debug

# ==========================================
# REQUIRED SECRETS (managed by Infisical)
# ==========================================
# These secrets MUST be set in Infisical vault:
# - INFISICAL_TOKEN (machine token for this environment)
# - gitea_db_pass (PostgreSQL password)
# - gitea_secret_key (Gitea security key, 32+ chars)
# - gitea_internal_token (Gitea internal token, 64+ chars)
# - gitea_pat_token (Personal access token for API)
# - gitea_admin_token (Admin token for GitHub sync)
# - gitea_mcp_token (MCP server token)
# - gitea_runner_token (Actions runner registration token)
# - github_token (GitHub personal access token)
# - webhook_auth_token (Webhook authentication)
# - webhook_secret (Webhook signing secret)
# - smtp_password (SMTP authentication)
# - openai_api_key (AI review API key)
# - redis_password (Redis authentication)