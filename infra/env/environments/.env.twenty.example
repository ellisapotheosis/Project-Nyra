# TwentyCRM Environment Configuration for Nyra Integration
# Copy this file to .env.twenty and update with your actual values

# Database Configuration
TWENTY_DB_PASSWORD=your_secure_database_password_change_me
TWENTY_REDIS_PASSWORD=your_secure_redis_password_change_me

# Application URLs
TWENTY_SERVER_URL=http://localhost:3020
TWENTY_FRONT_BASE_URL=http://localhost:3020

# Authentication & Security Secrets (GENERATE UNIQUE VALUES!)
TWENTY_ACCESS_TOKEN_SECRET=your_unique_access_token_secret_64_chars_minimum
TWENTY_LOGIN_TOKEN_SECRET=your_unique_login_token_secret_64_chars_minimum
TWENTY_REFRESH_TOKEN_SECRET=your_unique_refresh_token_secret_64_chars_minimum
TWENTY_FILE_TOKEN_SECRET=your_unique_file_token_secret_64_chars_minimum

# Nyra Integration
NYRA_WEBHOOK_SECRET=your_unique_nyra_webhook_secret_change_me
TWENTY_CRM_API_KEY=your_twenty_crm_api_key_from_settings
TWENTY_CRM_WORKSPACE_ID=default

# Email Configuration (Optional)
EMAIL_FROM_ADDRESS=noreply@nyra.com
EMAIL_SYSTEM_ADDRESS=system@nyra.com
EMAIL_DRIVER=logger

# API Rate Limiting
API_RATE_LIMITING_TTL=100
API_RATE_LIMITING_REQUEST_COUNT=100

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3008,http://localhost:3000,http://localhost:3001

# Production Settings
DEBUG_MODE=false
SIGN_IN_PREFILLED=false
NODE_ENV=production
