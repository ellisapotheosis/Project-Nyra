# Project Nyra - Development Environment Configuration
# Local/shared dev environment aligned with the `develop` branch and Infisical `dev`.

# Node Configuration
NYRA_NODE_TYPE=development
NYRA_ENVIRONMENT=development
NYRA_NODE_ID=dev-01
COMPOSE_PROJECT_NAME=nyra-dev

# Deployment Information
# These values are expected to be refreshed by CI/CD or local setup scripts.
DEPLOYMENT_VERSION=develop-latest
DEPLOYMENT_DATE=2026-03-13T00:00:00Z
DEPLOYMENT_SHA=develop

# Docker Configuration
COMPOSE_PROFILES=core,monitoring,workflow,crm

# Container Images (development tags)
NEXUS_ROUTER_IMAGE=gitea.local:3100/nyra/nexus-router:develop
CLAUDE_FLOW_IMAGE=gitea.local:3100/nyra/archon-os:develop
QUOTE_ENGINE_IMAGE=gitea.local:3100/nyra/quote-engine:develop
CAMPAIGN_ENGINE_IMAGE=gitea.local:3100/nyra/campaign-engine:develop

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nyra_dev
POSTGRES_USER=nyra
# POSTGRES_PASSWORD - set via Gitea secrets or Infisical

REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD - set via Gitea secrets or Infisical

# Core Services Configuration
NEXUS_ROUTER_PORT=6000
LITELLM_PORT=4000
CLAUDE_FLOW_PORT=3010

# Monitoring Configuration
GRAFANA_PORT=3005
PROMETHEUS_PORT=9090
LOKI_PORT=3100
# GRAFANA_ADMIN_PASSWORD - set via Gitea secrets or Infisical

# Workflow Configuration
N8N_PORT=5678
N8N_BASIC_AUTH_ACTIVE=false
# N8N_ENCRYPTION_KEY - set via Gitea secrets or Infisical

ACTIVEPIECES_PORT=8082

# CRM Configuration
TWENTYCRM_PORT=3000
# TWENTY_* secrets set via Gitea secrets or Infisical

# Development Settings
LOG_LEVEL=debug
HOT_RELOAD_ENABLED=true
DEBUG_MODE=true
PROFILING_ENABLED=true
NODE_ENV=development

# Feature Flags
ENABLE_MONITORING=true
ENABLE_CRM=true
ENABLE_WORKFLOWS=true
ENABLE_GPU_WORKERS=false
ENABLE_COMPLIANCE_CHECKS=false
ENABLE_RATE_LIMITING=false

# Resource Limits (leaner than staging for quicker iteration)
POSTGRES_MEMORY_LIMIT=1024
REDIS_MEMORY_LIMIT=512
GRAFANA_MEMORY_LIMIT=512
NEXUS_MEMORY_LIMIT=1024

# API Keys
# Set via Gitea secrets or Infisical:
# ANTHROPIC_API_KEY
# OPENAI_API_KEY
# GOOGLE_API_KEY
# OPENROUTER_API_KEY

# Security (development-friendly)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3005,http://dev.nyra.internal"
RATE_LIMIT_REQUESTS=2000
RATE_LIMIT_WINDOW_MS=60000

# Backup Configuration
BACKUP_ENABLED=false
BACKUP_RETENTION_DAYS=3
