# =============================================================================
# orchestrator (100.64.0.10, "MiniApotheosis") — memory-manager host
# =============================================================================
# MEASURED HARDWARE (2026-09-04, over SSH to this host):
#   AMD Ryzen 7 6800H with Radeon Graphics — 8 cores / 16 logical processors
#   15.2 GB system RAM
#   Docker 29.7.2 / Compose v5.5.1, Docker Desktop on a WSL2 backend
#   WSL2 guest reports 7 GB usable RAM — that VM cap, not the 15.2 GB host
#   figure, is the real ceiling for these containers.
#
# NO DISCRETE GPU. This host runs CPU inference only, and it is deliberately
# NOT a second LiteLLM or Nexus control plane. It publishes two origins that the
# canonical oracle-vps LiteLLM consumes as ordinary model_list entries:
#
#   nyra-embedding -> 100.64.0.10:8081   llama.cpp, nomic-embed-text-v1.5, 768d
#   nyra-memory    -> 100.64.0.10:8087   bitnet.cpp, BitNet b1.58 2B-4T
#
# Both bind the Tailnet address only. Verified live on this host: Docker Desktop
# publishes on the WSL2-mirrored Tailscale interface and worker-rtx5090 can
# reach it (`100.64.0.10:8081->...` established from 100.64.0.11).

# --- Embedding service (llama.cpp) -------------------------------------------
# Immutable digest for ghcr.io/ggml-org/llama.cpp tag `server`, resolved
# 2026-09-04. The OCI index publishes linux/amd64 AND linux/arm64; orchestrator
# is amd64. The image self-reports:
#   version: 0.3.0-dev (build 10795, commit 6703d7894)
#
# `server` is a floating tag upstream. Re-resolve and re-pin deliberately; do
# not switch this to the tag.
LLAMACPP_SERVER_IMAGE=ghcr.io/ggml-org/llama.cpp@sha256:fcca4dac388066ca93db561751e8caf5fc7d46d9df5f00a7422026db68468e31

# 4 of 16 logical processors. Embedding requests are short and bursty; the
# remaining threads are left to BitNet and to the rest of the orchestrator.
EMBEDDINGS_THREADS=4
EMBEDDINGS_CPUS=4

# nomic-embed-text-v1.5 f16 is a 274 MB artifact; 2 GB covers weights plus an
# 8192-token batch with headroom, inside the 7 GB WSL2 VM.
EMBEDDINGS_MEM_LIMIT=2g

# --- Memory-manager service (bitnet.cpp) -------------------------------------
# bitnet.cpp is not published to any registry, so this is a LOCAL build from a
# pinned upstream commit. See infra/hosts/orchestrator/bitnet/Dockerfile:
#   microsoft/BitNet         @ 0b341e582afbf9e1011f24744b554c96a3477eb5
#   microsoft/bitnet-b1.58-2B-4T-gguf @ a1f2f1c765812aa8af3f6eda4a313707064bba15
# Override only if you publish the build to a registry and pin it by digest.
BITNET_IMAGE=nyra/bitnet-memory-manager:local

# 6 of 16 logical processors, leaving 6 for the embedder and 4 for the host.
BITNET_THREADS=6
BITNET_CPUS=6

# The i2_s BitNet b1.58 2B-4T weights are ~1.1 GB; 3 GB covers weights plus a
# 4096-token KV cache. The previous docker-compose.bitnet.yml asked for 10g on
# a 7 GB VM, which could never be satisfied.
BITNET_MEM_LIMIT=3g

# Consolidation prompts summarise clusters of episodic entries, so this needs to
# be larger than the old 2048 default, but it is bounded by the memory limit
# above. Raise both together or not at all.
BITNET_CTX_SIZE=4096

# --- Infisical ----------------------------------------------------------------
# Neither service holds a credential: they are unauthenticated Tailnet-only
# origins behind LiteLLM, exactly like the vLLM workers. These variables exist
# for the host's other stacks, not for the memory-manager plane.
INFISICAL_DOMAIN=
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=
INFISICAL_SECRET_PATH=
INFISICAL_AGENT_PROXY_ADDRESS=

# --- Proxy exclusions ---------------------------------------------------------
NO_PROXY=127.0.0.1,localhost,100.64.0.3,100.64.0.10,100.64.0.11,100.64.0.13,.trex-fiordland.ts.net
no_proxy=127.0.0.1,localhost,100.64.0.3,100.64.0.10,100.64.0.11,100.64.0.13,.trex-fiordland.ts.net
