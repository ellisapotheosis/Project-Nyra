# OpenClaw cloud + Mem0
OPENCLAW_MVP_IMAGE=nyra/openclaw-mvp:local
OPENCLAW_MVP_PORT=3401
OPENCLAW_PROVIDER=openai
OPENCLAW_OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=REPLACE_ME_OPENAI_API_KEY
OPENROUTER_API_KEY=
LITELLM_MASTER_KEY=
MEM0_API_KEY=REPLACE_ME_MEM0_API_KEY
OPENCLAW_GATEWAY_TOKEN=REPLACE_ME_OPENCLAW_GATEWAY_TOKEN

# Session and endpoint wiring
OPENCLAW_SESSION_PATH=/home/node/.openclaw/sessions
OPENCLAW_PUBLIC_BASE_URL=http://localhost:3401
NYRA_CHAT_INTERNAL_API_BASE_URL=http://nexus-router:7000
NEXUS_MCP_URL=http://nexus-router:8080/mcp
OPENCLAW_WEBHOOK_INGRESS_PATH=/webhooks/openclaw/inbound

# Safety defaults
OPENCLAW_SANDBOX_ENABLED=true
OPENCLAW_TOOL_POLICY=deny-by-default
OPENCLAW_HTTP_ALLOWLIST=nexus-router:8080,n8n:5678,activepieces:80,twentycrm:3000

# Optional integrations
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
TWENTY_API_KEY=
N8N_API_KEY=
ACTIVEPIECES_API_KEY=
INFI_CLIENT_ID=
INFI_CLIENT_SECRET=
INFI_PROJECT_ID=

# Overlay toggles (used by infra/openclaw/scripts/up.sh)
BOOT_OPENCLAW_VOICE=false
BOOT_OPENCLAW_UI_PROXY=false
OPENCLAW_FORCE_BUILD=false
OPENCLAW_COMPOSE_VALIDATE=true
OPENCLAW_HEALTH_TIMEOUT_S=90

# Build args (optional)
OPENCLAW_INSTALL_BROWSER=1
OPENCLAW_DOCKER_APT_PACKAGES=git curl jq python3 python3-pip build-essential ffmpeg

# Optional routing/public endpoints
UNMUTE_PUBLIC_BASE_URL=
