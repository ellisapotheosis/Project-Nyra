# =============================================================================
# oracle-vps (100.64.0.3, aarch64) — control plane runtime environment
# =============================================================================
# Variable NAMES and SAFE NON-SECRET DEFAULTS ONLY.
# All values marked "Infisical" are delivered at runtime by the Infisical Agent
# into ./runtime-secrets/oracle.runtime.env, which is gitignored and never
# committed.

# --- LiteLLM administrative ---------------------------------------------------
# ADMINISTRATIVE credential. Lives ONLY here, on the gateway host.
# Never copied into ClawTeam, OpenHarness, Claude Code, Codex, any agent
# runtime, or any acceptance test. Source: Infisical.
LITELLM_MASTER_KEY=

# PostgreSQL only. LiteLLM rejects sqlite:// and other schemes for its virtual
# key / spend-tracking features. Source: Infisical.
DATABASE_URL=

# --- Downstream provider credentials (LiteLLM holds these, agents never do) ---
# Source: Infisical.
OPENROUTER_API_KEY=
OMNIROUTE_API_KEY=

# No paid provider is intentionally enabled, so OPENAI_API_KEY and
# ANTHROPIC_API_KEY are deliberately ABSENT. Declaring a provider that is not
# budget-authorized creates a meaningless blank dependency and a credential the
# gateway does not need to hold. Add them only when a paid route is actually
# authorized, and add the matching model_list entry in the same change.

# --- LiteLLM UI / CLI ---------------------------------------------------------
# EXPERIMENTAL_UI_LOGIN is deliberately NOT set. Default posture is
# experimental behaviour disabled unless its exact behaviour is required.
# Nothing in this architecture requires it.
#
# LITELLM_USE_KEYCHAIN is deliberately NOT set and must not be added. It does
# not exist in v1.99.1 - verified by grepping the pinned image. The modern
# LiteLLM CLI manages OS keychain storage itself.

# --- Cloudflare ---------------------------------------------------------------
# Canonical names chosen from the dominant existing usage in this repository
# (CLOUDFLARE_API_TOKEN appears 218x, CLOUDFLARE_ACCOUNT_ID 139x,
# CF_ACCESS_CLIENT_ID 54x). Least-privilege scoped API token, NOT a Global API
# Key - CLOUDFLARE_API_KEY / CLOUDFLARE_EMAIL (Global Key auth) must not be used.
# Source: Infisical.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# Machine-client access to the Cloudflare MCP Server Portal. Source: Infisical.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Tunnel credential. The repository currently uses four competing names
# (CLOUDFLARE_TUNNEL_TOKEN, CLOUDFLARED_TUNNEL_TOKEN, CLOUDFLARED_TOKEN,
# TUNNEL_TOKEN). CLOUDFLARED_TUNNEL_TOKEN is canonical; the cloudflared
# container's own TUNNEL_TOKEN is mapped from it at the compose layer so the
# rename is atomic rather than a second competing name. Source: Infisical.
CLOUDFLARED_TUNNEL_TOKEN=

# --- Infisical ----------------------------------------------------------------
# ORACLE SERVICE identity. Distinct from the autonomous-agent identity in
# infra/env/agent.env.example. Never use one root-equivalent machine identity
# everywhere. This identity holds secret-read/lease privileges for the Oracle
# control plane and nothing else.
INFISICAL_DOMAIN=
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=
INFISICAL_SECRET_PATH=
INFISICAL_AGENT_PROXY_ADDRESS=

# --- Proxy exclusions ---------------------------------------------------------
NO_PROXY=127.0.0.1,localhost,100.64.0.3,100.64.0.11,100.64.0.13,.trex-fiordland.ts.net,litellm,litellm-redis,omniroute
no_proxy=127.0.0.1,localhost,100.64.0.3,100.64.0.11,100.64.0.13,.trex-fiordland.ts.net,litellm,litellm-redis,omniroute
