# Project Nyra canonical infra environment template (sanitized)
# Copy to infra/env/.env.<node> and fill with real values from Infisical.

# Compose behavior
COMPOSE_PROJECT_NAME=nyra
COMPOSE_PROFILES=core,gateway,workflow,crm,archon,observability,edge,vector,mcp,orchestrator
NODE_ENV=production
LOG_LEVEL=info

# Core DB/cache
POSTGRES_DB=nyra
POSTGRES_USER=nyra
POSTGRES_PASSWORD=__SET_IN_INFISICAL__
POSTGRES_PORT=5432
REDIS_PASSWORD=__SET_IN_INFISICAL__
REDIS_PORT=6379
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=__SET_IN_INFISICAL__
MONGO_PORT=27017

# Router/LLM
LITELLM_MASTER_KEY=__SET_IN_INFISICAL__
LITELLM_PORT=4000
NEXUS_ROUTER_PORT=7000
NEXUS_MCP_PORT=8080
NEXUS_METRICS_PORT=9091
OPENROUTER_API_KEY=__SET_IN_INFISICAL__
ANTHROPIC_API_KEY=__SET_IN_INFISICAL__
OPENAI_API_KEY=__SET_IN_INFISICAL__
GOOGLE_API_KEY=__SET_IN_INFISICAL__

# Workflow
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=__SET_IN_INFISICAL__
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=__SET_IN_INFISICAL__
WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678
ACTIVEPIECES_PORT=8082
ACTIVEPIECES_JWT_SECRET=__SET_IN_INFISICAL__
ACTIVEPIECES_ENCRYPTION_KEY=__SET_IN_INFISICAL__

# CRM
TWENTY_POSTGRES_USER=twenty
TWENTY_POSTGRES_PASSWORD=__SET_IN_INFISICAL__
TWENTY_POSTGRES_DB=twenty
TWENTYCRM_PORT=3000
TWENTYCRM_MCP_PORT=8182
TWENTY_ENCRYPTION_SECRET=__SET_IN_INFISICAL__
TWENTY_JWT_SECRET=__SET_IN_INFISICAL__
TWENTY_PASSWORD_SALT=__SET_IN_INFISICAL__
TWENTYCRM_API_KEY=__SET_IN_INFISICAL__

# Apps/archon
ARCHON_OS_PORT=9001
MOLTBOT_WEB_PORT=3030
OPENWEBUI_PORT=8088

# Observability
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3006
GRAFANA_ADMIN_PASSWORD=__SET_IN_INFISICAL__
CADVISOR_PORT=8081

# Edge + tunnels
CLOUDFLARE_TUNNEL_TOKEN_ORCHESTRATOR=__SET_IN_INFISICAL__

# Vector
RUVECTOR_POSTGRES_USER=claude
RUVECTOR_POSTGRES_PASSWORD=__SET_IN_INFISICAL__
RUVECTOR_POSTGRES_DB=claude_flow
RUVECTOR_POSTGRES_PORT=5436
RUVECTOR_PGADMIN_PORT=5050

# Workers
WORKER_3060_OLLAMA_PORT=11434
WORKER_3090TI_VLLM_PORT=8100
WORKER_5090_VLLM_PORT=8101
WORKER_3090TI_MODEL=meta-llama/Llama-3.1-8B-Instruct
WORKER_5090_MODEL=Qwen/Qwen2.5-72B-Instruct-AWQ
