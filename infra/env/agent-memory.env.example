# =============================================================================
# `.agent/` memory lane — orchestrator CPU memory manager
# =============================================================================
# Scoped profile for the memory/reflection lane of the agentic-stack brain in
# `.agent/`. Source it ONLY for that lane:
#
#     set -a; . ./infra/env/agent-memory.env; set +a
#     python3 .agent/harness/conductor.py "<prompt>"
#
# DO NOT export these globally and DO NOT use OPENAI_BASE_URL / OPENAI_API_KEY
# for this. Setting those process-wide breaks native subscription auth for
# Claude Code and Codex. `.agent/harness/llm.py` reads AGENT_BASE_URL /
# AGENT_API_KEY precisely so this stays scoped.

# openai == "OpenAI-compatible transport", not the OpenAI company. The
# transport terminates at the Nyra LiteLLM gateway.
AGENT_PROVIDER=openai

# The LiteLLM alias, NOT the origin. Backed by bitnet.cpp serving BitNet b1.58
# 2B-4T on orchestrator (100.64.0.10:8087). Address the gateway so routing,
# budget and key scoping still apply.
AGENT_MODEL=nyra-memory

# Canonical LiteLLM on oracle-vps, over Tailscale. Never a public hostname.
AGENT_BASE_URL=http://100.64.0.3:4000/v1

# A SCOPED virtual key. Never LITELLM_MASTER_KEY, which exists only in the
# oracle-vps runtime environment. Rendered by the Infisical Agent; do not
# hand-write a value here.
AGENT_API_KEY=

# BitNet b1.58 2B-4T is a 2B CPU model: it is slow per token and its useful
# context is bounded by BITNET_CTX_SIZE on the host (4096 by default). Keep
# consolidation prompts small; that is the workload this lane is for.
AGENT_MAX_CONTEXT=4096

# Local gateway traffic must never traverse the Infisical Agent Proxy.
NO_PROXY=127.0.0.1,localhost,100.64.0.3,100.64.0.10,100.64.0.11,100.64.0.13,.trex-fiordland.ts.net
no_proxy=127.0.0.1,localhost,100.64.0.3,100.64.0.10,100.64.0.11,100.64.0.13,.trex-fiordland.ts.net
