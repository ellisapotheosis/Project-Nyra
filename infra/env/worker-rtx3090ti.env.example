# =============================================================================
# worker-rtx3090ti (100.64.0.13) — secondary inference
# =============================================================================
# HARDWARE NOT MEASURED. This host has been offline for 39 days
# ("idle; offline, last seen 39d ago") and was unreachable during the
# 2026-09-04 migration. `ping 100.64.0.13` timed out; no nvidia-smi, no driver
# version, no CUDA version and no container inventory could be collected.
#
# The 24 GB budget below is the user-stated operational budget, NOT a
# measurement. Re-verify with `nvidia-smi` before first production start.
#
# This is a SEPARATE independent replica, not a tensor-parallel peer of the
# 5090. Cross-host tensor parallelism over a WAN Tailnet link is latency-bound
# at every layer boundary; LiteLLM routing and fallback is used instead.

# --- Hugging Face -------------------------------------------------------------
HUGGING_FACE_HUB_TOKEN=
HF_CACHE_DIR=

# --- vLLM ---------------------------------------------------------------------
# Naming contract consumed by infra/configs/litellm/config.yaml.
VLLM_SERVED_NAME_3090TI=nyra-secondary

# Not pre-filled: no model has been chosen and the host could not be inspected.
VLLM_MODEL_3090TI=

VLLM_GPU_MEMORY_UTILIZATION_3090TI=0.88

# NO DEFAULT ON PURPOSE. Set after VRAM validation on the actual device.
VLLM_MAX_MODEL_LEN_3090TI=

# --- LMCache ------------------------------------------------------------------
# Points at the LMCache Redis running on worker-rtx5090, reached over Tailscale.
# Cross-instance KV reuse requires both hosts to share this backend with the
# same chunk_size and serde.
LMCACHE_USE_EXPERIMENTAL=True
LMCACHE_CHUNK_SIZE=256
LMCACHE_REMOTE_URL=redis://100.64.0.11:6379
LMCACHE_REMOTE_SERDE=naive
LMCACHE_CONFIG_FILE=/etc/lmcache/lmcache.yaml

# --- Infisical ----------------------------------------------------------------
INFISICAL_DOMAIN=
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=
INFISICAL_SECRET_PATH=
INFISICAL_AGENT_PROXY_ADDRESS=

# --- Proxy exclusions ---------------------------------------------------------
NO_PROXY=127.0.0.1,localhost,100.64.0.3,100.64.0.11,100.64.0.13,.trex-fiordland.ts.net
no_proxy=127.0.0.1,localhost,100.64.0.3,100.64.0.11,100.64.0.13,.trex-fiordland.ts.net
