# Core persistence + secrets (replace in infra/env/nyra.env)
POSTGRES_DB=nyra
POSTGRES_USER=nyra
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432
REDIS_PASSWORD=change-me-redis
MONGO_ROOT_PASSWORD=change-me-mongo

# AI gateway
LITELLM_MASTER_KEY=change-me-litellm
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Workflow apps
N8N_ENCRYPTION_KEY=change-me-n8n
ACTIVEPIECES_JWT_SECRET=change-me-ap-jwt
ACTIVEPIECES_ENCRYPTION_KEY=change-me-ap-enc

# CRM
TWENTY_ENCRYPTION_SECRET=change-me-twenty-enc
TWENTY_JWT_SECRET=change-me-twenty-jwt
TWENTY_PASSWORD_SALT=change-me-twenty-salt
TWENTYCRM_API_KEY=

# Observability
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Nyra + Nexus
NEXUS_ADMIN_TOKEN=change-me-nexus-admin
NYRA_MCP_PORT=3333
NYRA_HTTP_ALLOWLIST=http://nexus-router:8080,http://n8n:5678,http://activepieces:80,http://twentycrm:3000

# OpenClaw (no provider keys here, only LiteLLM key)
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_PORT=3400
OPENCLAW_PORTS=127.0.0.1:3400:3400
OPENCLAW_HOME_VOLUME=./data/openclaw/config
OPENCLAW_WORKSPACE_VOLUME=./data/openclaw/workspace
OPENCLAW_SECRET_REF_MODE=true
OPENCLAW_SANDBOX_ENABLED=true
OPENCLAW_OUTBOUND_HTTP_ALLOWLIST=nexus-router:8080,nyra-mcp:3333,n8n:5678,activepieces:80,twentycrm:3000,litellm:4000
OPENCLAW_TOOL_POLICY=deny-by-default
OPENCLAW_TOOLS_ALLOW=mcp,http_fetch,task
OPENCLAW_TOOLS_DENY=shell_exec,host_fs,docker_sock,raw_network_scan
OPENCLAW_INSTALL_BROWSER=1
OPENCLAW_DOCKER_APT_PACKAGES=git curl jq python3 python3-pip build-essential ffmpeg

# Optional channel auth (leave blank by default)
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
WHATSAPP_PHONE_NUMBER=

# Bootstrap control
BOOT_OPENCLAW=false
