# =============================================================================
# Nyra agent runtime — scoped, least-privilege
# =============================================================================
# For ClawTeam agents, OpenHarness profiles, and unattended automation that is
# DELIBERATELY routed through LiteLLM's OpenAI-compatible endpoint.
#
# READ THIS FIRST — the two rules that break things if ignored:
#
# 1. LITELLM_MASTER_KEY IS NEVER IN THIS FILE. Not commented out, not renamed,
#    not "temporarily". Agents use scoped virtual keys only. The master key is
#    administrative and lives only on the gateway host.
#
# 2. DO NOT SET OPENAI_BASE_URL / OPENAI_API_KEY GLOBALLY. Setting them in a
#    global shell profile breaks Claude Code's and Codex's native subscription
#    authentication. Source this file into a PER-PROFILE shell only, for the
#    specific agent process that should route through LiteLLM.
#
# Interactive Claude Code / Codex sessions keep their NATIVE authentication.
# Their subscription credentials are never scraped, never copied into
# Infisical, and never relayed to LiteLLM as a fake provider API key.

# --- Model plane --------------------------------------------------------------
OPENAI_BASE_URL=http://100.64.0.3:4000/v1

# A SCOPED LiteLLM VIRTUAL KEY. Not a provider key. Not the master key.
# Set this to exactly one of the scoped keys below, matching the agent's role.
OPENAI_API_KEY=

# --- Scoped LiteLLM virtual keys ----------------------------------------------
# Created via POST /key/generate with an explicit `object_permission`, each with
# its own model access, MCP server grants, Tool Search permission, spend/rate
# limits and expiry. Source: Infisical. Populate only the ones a given runtime
# actually needs - an agent should hold exactly one.
#
#   NYRA_LITELLM_DEV_KEY          -> nyra-dev            (dev tools, docs, local models)
#   NYRA_LITELLM_AGENT_KEY        -> nyra-dev            (general agent lane)
#   NYRA_LITELLM_AUTOMATION_KEY   -> nyra-automation     (n8n / Activepieces lane)
#   NYRA_LITELLM_MORTGAGE_KEY     -> nyra-mortgage       (CRM + borrower PII)
#   NYRA_LITELLM_ADMIN_KEY        -> nyra-admin          (Cloudflare/Docker/Infisical MCP)
#   NYRA_LITELLM_OBSERVABILITY_KEY-> nyra-observability  (telemetry read-only)
#
# Domain isolation is enforced, not advisory:
#   - a nyra-dev key CANNOT reach nyra_crm (borrower PII, CRM mutation)
#   - a nyra-mortgage key CANNOT reach nyra_docker, nyra_secrets, or any
#     Cloudflare-mutating MCP server
# A system prompt is never the authorization mechanism.
NYRA_LITELLM_DEV_KEY=
NYRA_LITELLM_AGENT_KEY=
NYRA_LITELLM_AUTOMATION_KEY=
NYRA_LITELLM_MORTGAGE_KEY=
NYRA_LITELLM_ADMIN_KEY=
NYRA_LITELLM_OBSERVABILITY_KEY=

# --- Model aliases the agent should use ---------------------------------------
# Agents address logical aliases only. They do not know about individual vLLM
# hosts, OmniRoute, OpenRouter, or the provider fallback order.
#   nyra-general    nyra-fast    nyra-reasoning    nyra-coding    nyra-embedding
NYRA_DEFAULT_MODEL=nyra-general

# --- Infisical (AGENT identity) -----------------------------------------------
# DISTINCT from the Oracle service identity. This identity deliberately has
# NO broad secret-read permission. An agent that can call the Agent Proxy must
# not thereby be able to read the backing secret.
INFISICAL_DOMAIN=
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=
INFISICAL_SECRET_PATH=

# Outbound tool credentials the agent must never possess are brokered here.
INFISICAL_AGENT_PROXY_ADDRESS=

# --- Cloudflare Access (unattended agents reaching the portal) ----------------
# Service token, NOT a human admin token. Never put a human admin credential in
# an unattended bot.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# --- Proxy exclusions ---------------------------------------------------------
# Local vLLM, LMCache Redis, Tailscale control traffic, localhost and
# intra-Docker traffic are never proxied.
NO_PROXY=127.0.0.1,localhost,100.64.0.3,100.64.0.11,100.64.0.13,.trex-fiordland.ts.net
no_proxy=127.0.0.1,localhost,100.64.0.3,100.64.0.11,100.64.0.13,.trex-fiordland.ts.net
