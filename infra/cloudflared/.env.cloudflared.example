# Copy to infra/cloudflared/.env.cloudflared and fill values.
# Do NOT commit the copied file.

# Orchestrator tunnel
CF_TUNNEL_UUID_ORCHESTRATOR=REPLACE_ME_ORCHESTRATOR_TUNNEL_UUID
CF_CREDENTIALS_FILE_ORCHESTRATOR=/etc/cloudflared/credentials/orchestrator.json

# Oracle tunnel
CF_TUNNEL_UUID_ORACLE=REPLACE_ME_ORACLE_TUNNEL_UUID
CF_CREDENTIALS_FILE_ORACLE=/etc/cloudflared/credentials/oracle.json

# Optional origin behavior
CF_ORIGIN_NO_TLS_VERIFY=false
