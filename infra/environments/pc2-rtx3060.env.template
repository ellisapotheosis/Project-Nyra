# =============================================================================
# PC2 - RTX 3060 ENVIRONMENT CONFIGURATION
# =============================================================================
# Hardware: RTX 3060 (12GB VRAM), 16GB+ RAM, SSD storage
# Role: GPU inference node for lightweight models
# Static IP: 192.168.1.101
# Services: Ollama, LiteLLM proxy, GPU monitoring, lightweight model serving
# =============================================================================

# Network Configuration
PC_NAME=pc2-rtx3060
PC_ROLE=gpu-inference-light
STATIC_IP=192.168.1.101
TAILSCALE_AUTHKEY=tskey-auth-XXXXX-XXXXX-change-me
CLOUDFLARED_TUNNEL_TOKEN=your_tunnel_token_here_change_me

# Discovery and Registration
SERVICE_REGISTRY_URL=http://192.168.1.100:8500
CONSUL_ENABLED=true
CONSUL_CLIENT_ADDR=192.168.1.101:8501
CONSUL_SERVER_ADDR=192.168.1.100:8500

# Orchestrator Connection (PC1)
ORCHESTRATOR_HOST=192.168.1.100
ORCHESTRATOR_PORT=3000
ORCHESTRATOR_API_KEY=change_me_orchestrator_api_key

# =============================================================================
# OLLAMA CONFIGURATION (PC2 GPU Models - 12GB VRAM Optimized)
# =============================================================================

# Ollama Server
OLLAMA_HOST=0.0.0.0:11434
OLLAMA_MODELS_DIR=/data/ollama/models
OLLAMA_NUM_GPU=1
OLLAMA_GPU_LAYERS=0
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=5m

# GPU Memory Management
OLLAMA_GPU_MEMORY_FRACTION=0.95
CUDA_VISIBLE_DEVICES=0
CUDA_DEVICE_ORDER=PCI_BUS_ID

# Installed Models (12GB RTX 3060 Optimized)
# These models fit within 12GB VRAM with layer offloading
OLLAMA_MODELS=llama3.1:8b,codellama:13b,mistral:7b,deepseek-coder:6.7b

# Model Specifications
LLAMA3_1_8B_PARAMS=4000
CODELLAMA_13B_PARAMS=2500
MISTRAL_7B_PARAMS=3000
DEEPSEEK_CODER_6B7_PARAMS=3700

# =============================================================================
# LITELLM PROXY (Local Model Routing)
# =============================================================================

# LiteLLM Proxy Server
LITELLM_PORT=8000
LITELLM_HOST=0.0.0.0
LITELLM_LOG_LEVEL=info
LITELLM_MAX_TOKENS=8192

# Model Routing
LITELLM_PROXY_REDIS_URL=redis://:change_me_redis_password@192.168.1.100:6379/2
LITELLM_FALLBACK_MODELS=true
LITELLM_MODEL_FALLBACK_ORDER=llama3.1:8b,codellama:13b,mistral:7b

# Prompt Caching
LITELLM_CACHING_ENABLED=true
LITELLM_CACHE_TTL=3600

# =============================================================================
# GPU MONITORING & METRICS
# =============================================================================

# NVIDIA GPU Monitoring
NVIDIA_GPU_MONITORING=true
NVIDIA_SMI_INTERVAL=5
GPU_POWER_LIMIT=250W
GPU_CLOCK_SPEED_LIMIT=1860MHz

# Prometheus GPU Exporter
NVIDIA_EXPORTER_PORT=9445
NVIDIA_EXPORTER_HOST=0.0.0.0
NVIDIA_EXPORTER_INTERVAL=5

# System Metrics
SYSTEM_MONITORING=true
CPU_THRESHOLD_PERCENT=80
MEMORY_THRESHOLD_PERCENT=85
DISK_THRESHOLD_PERCENT=90

# =============================================================================
# LOGGING & DIAGNOSTICS
# =============================================================================

LOG_LEVEL=info
DEBUG_MODE=false
VERBOSE_GPU_LOGGING=false

# Model Loading Logs
OLLAMA_DEBUG=false
OLLAMA_NUM_THREAD=8

# Performance Profiling
ENABLE_PROFILING=false
PROFILE_PORT=6000

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Ollama Performance
OLLAMA_LOAD_TIMEOUT=300
OLLAMA_INFERENCE_TIMEOUT=600
OLLAMA_BATCH_SIZE=32

# Connection Settings
CONNECTION_POOL_SIZE=20
REQUEST_TIMEOUT=300000
KEEP_ALIVE_TIMEOUT=60000

# Memory Management
SWAP_ENABLED=true
SWAP_SIZE_GB=8
AGGRESSIVE_MEMORY_CLEANUP=false

# =============================================================================
# RESOURCE LIMITS
# =============================================================================

# VRAM Allocation
MAX_VRAM_USAGE_PERCENT=95
MIN_FREE_VRAM_GB=1

# System RAM
MAX_SYSTEM_RAM_PERCENT=90
MIN_FREE_RAM_GB=2

# Disk Space
MIN_DISK_SPACE_GB=50
CLEANUP_OLD_MODELS_DAYS=30

# =============================================================================
# SECURITY
# =============================================================================

# API Keys
API_KEY_PC2=change_me_pc2_api_key
API_SECRET=change_me_api_secret

# Network Security
ENABLE_TLS=true
TLS_CERT_PATH=/etc/ssl/certs/pc2.crt
TLS_KEY_PATH=/etc/ssl/private/pc2.key

# Access Control
ALLOW_ORCHESTRATOR_IP=192.168.1.100
ALLOW_PC1_IP=192.168.1.100
ALLOW_PC3_IP=192.168.1.102
ALLOW_PC4_IP=192.168.1.103
FIREWALL_ENABLED=true

# =============================================================================
# INTEGRATION WITH 4-PC STACK
# =============================================================================

# Load Balancing Configuration
ENABLE_LOCAL_LB=true
ROUND_ROBIN_MODELS=true
QUEUE_SIZE=100
QUEUE_TIMEOUT=30

# Health Checks
HEALTH_CHECK_INTERVAL=10
HEALTH_CHECK_TIMEOUT=5
UNHEALTHY_THRESHOLD=3

# Distributed Tracing
JAEGER_ENABLED=true
JAEGER_AGENT_HOST=192.168.1.100
JAEGER_AGENT_PORT=6831

# Logging
LOKI_ENABLED=true
LOKI_HOST=192.168.1.100
LOKI_PORT=3100

# =============================================================================
# BACKUP & RECOVERY
# =============================================================================

# Model Backup
BACKUP_MODELS=true
BACKUP_INTERVAL_HOURS=24
BACKUP_PATH=/data/ollama/backups
BACKUP_RETENTION_DAYS=7

# Auto Recovery
AUTO_RECOVERY_ENABLED=true
RECOVERY_CHECK_INTERVAL=300

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================

# Quantization
ENABLE_QUANTIZATION=true
QUANTIZATION_FORMAT=Q4_K_M

# Batching
ENABLE_DYNAMIC_BATCHING=true
MAX_BATCH_SIZE=32
BATCH_TIMEOUT_MS=100

# Prefetching
ENABLE_PREFETCHING=true
PREFETCH_THRESHOLD=0.8
