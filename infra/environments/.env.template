# Project Nyra - Environment Configuration Template
# Generated: 2026-03-10
# Instructions: Copy this file to .env and configure your environment-specific values

# =============================================================================
# NODE CONFIGURATION
# =============================================================================

# Node Type: orchestrator | worker-rtx3060 | worker-rtx3090ti | worker-rtx5090 | oracle
NYRA_NODE_TYPE=orchestrator

# Node Environment: development | staging | production
NYRA_ENVIRONMENT=development

# Node ID (unique identifier for this node in the cluster)
NYRA_NODE_ID=node-orchestrator-01

# Network Configuration
NYRA_NETWORK_NAME=nyra-net
TAILSCALE_ENABLED=false
TAILSCALE_AUTHKEY=""

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nyra
POSTGRES_USER=nyra
POSTGRES_PASSWORD=""  # REQUIRED: Set a strong password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=""     # REQUIRED: Set a strong password
REDIS_DB=0

# FalkorDB Configuration (Graph Database)
FALKORDB_HOST=falkordb
FALKORDB_PORT=6381
FALKORDB_PASSWORD=""  # REQUIRED: Set a strong password

# =============================================================================
# API & SERVICE CONFIGURATION
# =============================================================================

# Nexus Router (API Gateway)
NEXUS_ROUTER_PORT=6000
NEXUS_ROUTER_HOST=0.0.0.0

# LiteLLM Proxy
LITELLM_PORT=4000
LITELLM_HOST=0.0.0.0
LITELLM_API_KEY=""    # REQUIRED: Set API key for management

# Claude Flow Configuration
CLAUDE_FLOW_PORT=3010
CLAUDE_FLOW_HOST=0.0.0.0
CLAUDE_FLOW_CONFIG_PATH=./configs/archon-os/config.json

# Archon OS Configuration
ARCHON_PORT=8000
ARCHON_HOST=0.0.0.0
ARCHON_MODE=master    # master | worker

# =============================================================================
# AI & ML SERVICES
# =============================================================================

# OpenAI API Configuration
OPENAI_API_KEY=""     # REQUIRED: Your OpenAI API key
OPENAI_ORG_ID=""      # OPTIONAL: Organization ID

# Anthropic Claude API
ANTHROPIC_API_KEY=""  # REQUIRED: Your Anthropic API key

# Local LLM Configuration (for GPU workers)
OLLAMA_ENABLED=false
