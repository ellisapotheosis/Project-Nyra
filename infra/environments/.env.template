# =============================================================================
# SECURITY & SECRETS
# =============================================================================

# Infisical (Secrets Management)
INFISICAL_PROJECT_ID=""     # REQUIRED: Your Infisical project ID
INFISICAL_CLIENT_ID=""      # REQUIRED: Your Infisical client ID
INFISICAL_CLIENT_SECRET=""  # REQUIRED: Your Infisical client secret
