LETTA_HOST=0.0.0.0
LETTA_PG_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Mem0 (Secondary Memory)
