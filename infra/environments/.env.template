ALERTMANAGER_HOST=0.0.0.0

# =============================================================================
# GIT & CI/CD
# =============================================================================

# Gitea Configuration
GITEA_PORT=3100
GITEA_SSH_PORT=2222
GITEA_HOST=0.0.0.0
GITEA_DOMAIN=gitea.local
GITEA_ROOT_URL=http://localhost:3100/
