CLOUDFLARE_ZONE_ID=""       # OPTIONAL: Your Cloudflare zone ID
CLOUDFLARE_API_TOKEN=""     # OPTIONAL: Your Cloudflare API token

# Domain Configuration
DOMAIN_NAME=""              # OPTIONAL: Your custom domain
SSL_ENABLED=false

# =============================================================================
# DEVELOPMENT & DEBUGGING
# =============================================================================

# Logging Configuration
LOG_LEVEL=info              # debug | info | warn | error
LOG_FORMAT=json             # json | text

# Development Features
HOT_RELOAD_ENABLED=true
DEBUG_MODE=false
PROFILING_ENABLED=false

# Testing Configuration
TEST_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/nyra_test

# =============================================================================
# DOCKER & DEPLOYMENT
# =============================================================================

# Docker Configuration
COMPOSE_PROJECT_NAME=nyra
COMPOSE_PROFILES=""         # Comma-separated list: core,worker,monitoring,crm

# Registry Configuration (for multi-node deployment)
DOCKER_REGISTRY=""          # OPTIONAL: Private Docker registry URL
DOCKER_REGISTRY_USER=""     # OPTIONAL: Registry username
DOCKER_REGISTRY_PASS=""     # OPTIONAL: Registry password

# =============================================================================
# RESOURCE LIMITS
# =============================================================================

# Memory Limits (in MB)
POSTGRES_MEMORY_LIMIT=2048
REDIS_MEMORY_LIMIT=512
GRAFANA_MEMORY_LIMIT=512
NEXUS_MEMORY_LIMIT=1024

# CPU Limits (as decimal, e.g., 0.5 = 50% of one CPU core)
POSTGRES_CPU_LIMIT=1.0
REDIS_CPU_LIMIT=0.5
GRAFANA_CPU_LIMIT=0.5
NEXUS_CPU_LIMIT=1.0

# =============================================================================
# BACKUP & MAINTENANCE
# =============================================================================

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# Storage Paths
DATA_DIR=./data
LOG_DIR=./logs
BACKUP_DIR=./backups
CONFIG_DIR=./configs

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Feature Toggles
ENABLE_MONITORING=true
ENABLE_CRM=false
ENABLE_WORKFLOWS=true
ENABLE_GPU_WORKERS=false
ENABLE_COMPLIANCE_CHECKS=true
ENABLE_RATE_LIMITING=true

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================

# Performance Tuning
MAX_CONNECTIONS=100
CONNECTION_TIMEOUT=30
QUERY_TIMEOUT=60
BATCH_SIZE=1000

# Security Settings
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3005"
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

