# =============================================================================
# PC1 ORCHESTRATOR ENVIRONMENT CONFIGURATION
# =============================================================================
# Hardware: Multi-core CPU, 32GB+ RAM, SSD storage
# Role: Central orchestrator for the 4-PC distributed stack
# Static IP: 192.168.1.100
# Services: All core services, databases, MCP servers, monitoring
# =============================================================================

# Network Configuration
PC_NAME=pc1-orchestrator
PC_ROLE=orchestrator
STATIC_IP=192.168.1.100
TAILSCALE_AUTHKEY=tskey-auth-XXXXX-XXXXX-change-me
CLOUDFLARED_TUNNEL_TOKEN=your_tunnel_token_here_change_me

# Discovery and Registration
SERVICE_REGISTRY_URL=http://192.168.1.100:8500
CONSUL_ENABLED=true
CONSUL_HTTP_ADDR=192.168.1.100:8500

# =============================================================================
# DATABASE SERVICES (PC1 Only)
# =============================================================================

# PostgreSQL (Main Database)
POSTGRES_HOST=pc1-orchestrator
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=nyra_production
POSTGRES_INITDB_ARGS=-c shared_buffers=1GB -c effective_cache_size=4GB
POSTGRES_MAX_CONNECTIONS=200

# Redis (Cache & Sessions)
REDIS_HOST=pc1-orchestrator
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_DB=0
REDIS_MAXMEMORY=4gb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Neo4j (Graph Database)
NEO4J_HOST=pc1-orchestrator
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_HTTPS_PORT=7473
NEO4J_AUTH=neo4j/change_me_neo4j_password
NEO4J_INITIAL_HEAP_SIZE=2g
NEO4J_MAX_HEAP_SIZE=4g

# Qdrant (Vector Database)
QDRANT_HOST=pc1-orchestrator
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=change_me_qdrant_api_key

# MongoDB (Document Storage)
MONGODB_HOST=pc1-orchestrator
MONGODB_PORT=27017
MONGODB_USERNAME=admin
MONGODB_PASSWORD=change_me_mongodb_password
MONGODB_INITDB_ROOT_USERNAME=admin
MONGODB_INITDB_ROOT_PASSWORD=change_me_mongodb_password

# =============================================================================
# MCP SERVERS (PC1 Core Infrastructure)
# =============================================================================

# MCP Nexus Router (Central routing hub)
MCP_NEXUS_PORT=3000
MCP_NEXUS_HOST=0.0.0.0
MCP_NEXUS_LOG_LEVEL=info
MCP_NEXUS_MAX_CONNECTIONS=1000
MCP_NEXUS_TIMEOUT=30000

# LiteLLM Proxy (Model routing)
LITELLM_PORT=8000
LITELLM_HOST=0.0.0.0
LITELLM_LOG_LEVEL=info
LITELLM_DATABASE_URL=postgresql://postgres:change_me_postgres_password@pc1-orchestrator:5432/litellm_db

# Claude Flow CLI MCP Server
CLAUDE_FLOW_MCP_PORT=3100
CLAUDE_FLOW_MCP_HOST=0.0.0.0
CLAUDE_FLOW_CONFIG=./claude-flow.config.json

# Ollama Proxy MCP
OLLAMA_MCP_PORT=3200
OLLAMA_MCP_HOST=0.0.0.0
OLLAMA_PROXY_TIMEOUT=300

# Bitwarden MCP Server
BITWARDEN_MCP_PORT=3300
BITWARDEN_MCP_HOST=0.0.0.0
BITWARDEN_CLI_PATH=/usr/bin/bw

# Git MCP Server
GIT_MCP_PORT=3400
GIT_MCP_HOST=0.0.0.0

# Docker MCP Server
DOCKER_MCP_PORT=3500
DOCKER_MCP_HOST=0.0.0.0
DOCKER_SOCKET=/var/run/docker.sock

# =============================================================================
# APPLICATION SERVICES (PC1 Hosted)
# =============================================================================

# TwentyCRM
TWENTYCRM_PORT=3001
TWENTYCRM_HOST=0.0.0.0
TWENTYCRM_DATABASE_URL=postgresql://postgres:change_me_postgres_password@pc1-orchestrator:5432/twentycrm
TWENTYCRM_REDIS_URL=redis://:change_me_redis_password@pc1-orchestrator:6379/0
TWENTYCRM_JWT_SECRET=change_me_jwt_secret
TWENTYCRM_LOG_LEVEL=info

# n8n (Workflow Automation)
N8N_PORT=5678
N8N_HOST=0.0.0.0
N8N_PROTOCOL=http
N8N_DATABASE_URL=postgresql://postgres:change_me_postgres_password@pc1-orchestrator:5432/n8n
N8N_ENCRYPTION_KEY=change_me_n8n_encryption_key
N8N_LOG_LEVEL=info
N8N_EXECUTION_MODE=queue

# Dify (LLM Application Platform)
DIFY_PORT=5001
DIFY_HOST=0.0.0.0
DIFY_DATABASE_URL=postgresql://postgres:change_me_postgres_password@pc1-orchestrator:5432/dify
DIFY_REDIS_URL=redis://:change_me_redis_password@pc1-orchestrator:6379/1
DIFY_JWT_SECRET=change_me_dify_jwt_secret
DIFY_LOG_LEVEL=info

# =============================================================================
# MONITORING & OBSERVABILITY (PC1 Hosted)
# =============================================================================

# Prometheus (Metrics Collection)
PROMETHEUS_PORT=9090
PROMETHEUS_HOST=0.0.0.0
PROMETHEUS_RETENTION_DAYS=30
PROMETHEUS_SCRAPE_INTERVAL=15s

# Grafana (Dashboards)
GRAFANA_PORT=3000
GRAFANA_HOST=0.0.0.0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
GRAFANA_PROVISIONING_PATH=/etc/grafana/provisioning

# Loki (Log Aggregation)
LOKI_PORT=3100
LOKI_HOST=0.0.0.0
LOKI_RETENTION_DAYS=7

# Jaeger (Distributed Tracing)
JAEGER_AGENT_PORT=6831
JAEGER_QUERY_PORT=16686

# =============================================================================
# SECURITY & SECRETS
# =============================================================================

# API Keys (Change These!)
API_SECRET_KEY=change_me_api_secret_key
ENCRYPTION_KEY=change_me_encryption_key
HMAC_SECRET=change_me_hmac_secret

# OAuth/OIDC
OAUTH_ENABLED=true
OAUTH_PROVIDER=keycloak
OAUTH_CLIENT_ID=nyra-orchestrator
OAUTH_CLIENT_SECRET=change_me_oauth_secret

# SSL/TLS
SSL_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/server.crt
SSL_KEY_PATH=/etc/ssl/private/server.key
SSL_VERIFY_PEER=true

# =============================================================================
# LOGGING & DEBUG
# =============================================================================

LOG_LEVEL=info
DEBUG_MODE=false
VERBOSE_LOGGING=false

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Connection Pooling
DB_CONNECTION_POOL_SIZE=50
DB_CONNECTION_TIMEOUT=10000
DB_IDLE_TIMEOUT=900000

# Caching
CACHE_TTL=3600
CACHE_ENABLED=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=1000

# =============================================================================
# DISTRIBUTED STACK COORDINATION
# =============================================================================

# PC2 (RTX 3060 - GPU Inference)
PC2_ORCHESTRATOR_IP=192.168.1.101
PC2_OLLAMA_PORT=11434
PC2_LITELLM_PORT=8000

# PC3 (RTX 5090 - Heavy Operations)
PC3_ORCHESTRATOR_IP=192.168.1.102
PC3_OLLAMA_PORT=11434
PC3_VLLM_PORT=8001
PC3_MEMORY_SERVICE_PORT=8080

# PC4 (RTX 3090 - Inference)
PC4_ORCHESTRATOR_IP=192.168.1.103
PC4_OLLAMA_PORT=11434
PC4_VLLM_PORT=8001

# Service Discovery
DISCOVERY_INTERVAL=30
HEALTH_CHECK_INTERVAL=10
SYNC_INTERVAL=5
