# ============================================================
# .env.stack — Orchestrator port overrides for docker-compose
# ============================================================
# Only set values that differ from docker-compose.yml defaults.
# ============================================================

# ── Required secrets (compose interpolation fails without these) ────────────
# Extracted from running nyra-grafana container — must match existing deployment
GRAFANA_ADMIN_PASSWORD=fa2ea690772e6f5254d85c74fe5effe839176ed58804e8542e6ea66b926cdb29

# ── Port conflict fixes ──────────────────────────────────────
# Loki default (3100) collides with nyra-gitea (port 3100 → internal 3000)
LOKI_PORT=3101

# Cadvisor default (8081) collides with nyra-archon-nexus-router (8081)
CADVISOR_PORT=8083
