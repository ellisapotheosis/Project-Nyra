# Project Nyra - Orchestrator Node Configuration Template
# Copy from .env.template and customize for orchestrator role

# Node Configuration
NYRA_NODE_TYPE=orchestrator
NYRA_ENVIRONMENT=production
NYRA_NODE_ID=orchestrator-01
COMPOSE_PROFILES=core,monitoring,crm,workflows

# Network Configuration
NYRA_NETWORK_NAME=nyra-net
TAILSCALE_ENABLED=true

# Enable core orchestrator services
ENABLE_MONITORING=true
ENABLE_CRM=true
ENABLE_WORKFLOWS=true
ENABLE_GPU_WORKERS=false

# Orchestrator-specific resource limits
POSTGRES_MEMORY_LIMIT=4096
REDIS_MEMORY_LIMIT=1024
GRAFANA_MEMORY_LIMIT=1024
NEXUS_MEMORY_LIMIT=2048

# Service roles
ARCHON_MODE=master
CLAUDE_FLOW_MODE=coordinator
MEMPALACE_URL=http://nyra-oracle.trex-fiordland.ts.net:8002/mcp

# Database configuration (orchestrator hosts shared databases)
POSTGRES_HOST=localhost
REDIS_HOST=localhost

# Monitoring and observability
GRAFANA_PORT=3005
PROMETHEUS_PORT=9090
LOKI_PORT=3100
ALERTMANAGER_PORT=9093

# Development features (disabled for orchestrator)
HOT_RELOAD_ENABLED=false
DEBUG_MODE=false
PROFILING_ENABLED=false