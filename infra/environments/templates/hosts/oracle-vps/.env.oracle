# Project Nyra - Oracle VPS Configuration
# Copy from .env.template and customize for Oracle Cloud VPS

# Node Configuration
NYRA_NODE_TYPE=oracle
NYRA_ENVIRONMENT=production
NYRA_NODE_ID=oracle-vps-01
COMPOSE_PROFILES=edge,backup,monitoring

# Oracle Cloud specific
ORACLE_INSTANCE_IP=YOUR_ORACLE_IP_HERE
ORACLE_REGION=us-phoenix-1

# External access configuration
SSL_ENABLED=true
DOMAIN_NAME=ratehunter.net
CLOUDFLARE_TUNNEL_ENABLED=true

# Services for Oracle VPS (lightweight, external-facing)
ENABLE_MONITORING=true
ENABLE_CRM=false
ENABLE_WORKFLOWS=false
ENABLE_GPU_WORKERS=false

# Backup and sync services
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 3 * * *"
BACKUP_RETENTION_DAYS=30

# External service ports (for public access)
NGINX_PORT=80
NGINX_SSL_PORT=443
WEBHOOK_PORT=3000
METRICS_EXPORT_PORT=9100

# Resource limits for Oracle Always Free (1 OCPU, 1GB RAM)
POSTGRES_MEMORY_LIMIT=256
REDIS_MEMORY_LIMIT=128
NGINX_MEMORY_LIMIT=128
WEBHOOK_MEMORY_LIMIT=256

# Optimization for limited resources
LOG_LEVEL=warn
CONNECTION_POOL_SIZE=5
MAX_CONNECTIONS=20

# Security for public-facing VPS
RATE_LIMIT_REQUESTS=50
RATE_LIMIT_WINDOW_MS=60000
FAIL2BAN_ENABLED=true
UFW_ENABLED=true

# Cloudflare integration
CLOUDFLARE_ZONE_ID=YOUR_CLOUDFLARE_ZONE_ID
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN