# =============================================================================
# PC3 - RTX 5090 ENVIRONMENT CONFIGURATION
# =============================================================================
# Hardware: RTX 5090 (32GB VRAM), 48GB+ RAM, High-speed SSD storage
# Role: Flagship GPU node for heavy operations, large models, fine-tuning
# Static IP: 192.168.1.102
# Services: Ollama, vLLM, Fine-tuning service, Heavy inference, Memory service
# =============================================================================

# Network Configuration
PC_NAME=pc3-rtx5090
PC_ROLE=gpu-flagship-heavy
STATIC_IP=192.168.1.102
TAILSCALE_AUTHKEY=tskey-auth-XXXXX-XXXXX-change-me
CLOUDFLARED_TUNNEL_TOKEN=your_tunnel_token_here_change_me

# Discovery and Registration
SERVICE_REGISTRY_URL=http://192.168.1.100:8500
CONSUL_ENABLED=true
CONSUL_CLIENT_ADDR=192.168.1.102:8502
CONSUL_SERVER_ADDR=192.168.1.100:8500

# Orchestrator Connection (PC1)
ORCHESTRATOR_HOST=192.168.1.100
ORCHESTRATOR_PORT=3000
ORCHESTRATOR_API_KEY=change_me_orchestrator_api_key

# =============================================================================
# OLLAMA CONFIGURATION (PC3 GPU Models - 32GB VRAM)
# =============================================================================

# Ollama Server
OLLAMA_HOST=0.0.0.0:11434
OLLAMA_MODELS_DIR=/data/ollama/models
OLLAMA_NUM_GPU=1
OLLAMA_GPU_LAYERS=50
OLLAMA_MAX_LOADED_MODELS=3
OLLAMA_KEEP_ALIVE=10m

# GPU Memory Management
OLLAMA_GPU_MEMORY_FRACTION=0.95
CUDA_VISIBLE_DEVICES=0
CUDA_DEVICE_ORDER=PCI_BUS_ID

# Installed Models (32GB RTX 5090 - Flagship)
# These are the largest and most powerful models
OLLAMA_MODELS=llama3.1:70b,qwen2.5:72b,mixtral:8x22b,codellama:70b

# Model Specifications
LLAMA3_1_70B_PARAMS=65000
QWEN2_5_72B_PARAMS=70000
MIXTRAL_8X22B_PARAMS=141000
CODELLAMA_70B_PARAMS=70000

# Advanced GPU Optimization
OLLAMA_OPTIMIZATION_LEVEL=3
OLLAMA_FLASH_ATTENTION=true
OLLAMA_ROPE_FREQ_BASE=500000
OLLAMA_ROPE_FREQ_SCALE=0.5

# =============================================================================
# VLLM CONFIGURATION (Fast Inference Engine)
# =============================================================================

# vLLM Server
VLLM_PORT=8001
VLLM_HOST=0.0.0.0
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.95

# vLLM Model Configuration
VLLM_MODELS=llama3.1:70b,qwen2.5:72b,mixtral:8x22b
VLLM_ENABLE_PREFIX_CACHING=true
VLLM_ENABLE_CHUNKED_PREFILL=true
VLLM_MAX_NUM_BATCHED_TOKENS=8192

# Tensor Parallelism
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_PIPELINE_PARALLEL_SIZE=1

# KV Cache Configuration
VLLM_KV_CACHE_DTYPE=auto
VLLM_ENABLE_LOGPROBS=true
VLLM_LOGPROBS_SOFT_CAP=0.0

# Serving Configuration
VLLM_DISABLE_LOG_REQUESTS=false
VLLM_DISABLE_LOG_STATS=false
VLLM_ENFORCE_EAGER_EXECUTION=false

# =============================================================================
# FINE-TUNING SERVICE
# =============================================================================

# Fine-tuning Configuration
FINETUNING_ENABLED=true
FINETUNING_PORT=8002
FINETUNING_HOST=0.0.0.0

# Dataset Storage
FINETUNING_DATASET_PATH=/data/finetuning/datasets
FINETUNING_OUTPUT_PATH=/data/finetuning/outputs
FINETUNING_MAX_DATASET_SIZE_GB=100

# Training Parameters
FINETUNING_LEARNING_RATE=2e-5
FINETUNING_BATCH_SIZE=4
FINETUNING_EPOCHS=3
FINETUNING_WARMUP_STEPS=500
FINETUNING_MAX_STEPS=10000

# LoRA Configuration
LORA_ENABLED=true
LORA_R=8
LORA_ALPHA=16
LORA_DROPOUT=0.1
LORA_TARGET_MODULES=q_proj,v_proj

# Optimization
GRADIENT_CHECKPOINTING=true
MIXED_PRECISION=fp16
ENABLE_GRADIENT_ACCUMULATION=true
GRADIENT_ACCUMULATION_STEPS=4

# =============================================================================
# HEAVY OPERATIONS & MEMORY SERVICE
# =============================================================================

# Memory Service
MEMORY_SERVICE_ENABLED=true
MEMORY_SERVICE_PORT=8080
MEMORY_SERVICE_HOST=0.0.0.0

# Vector Database (Qdrant Integration)
VECTOR_DB_HOST=192.168.1.100
VECTOR_DB_PORT=6333
VECTOR_DB_COLLECTION=embeddings_primary

# Embedding Service
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=256
EMBEDDING_DEVICE=cuda

# Long Context Processing
LONG_CONTEXT_WINDOW=32768
SLIDING_WINDOW_SIZE=2048
CONTEXT_OVERLAP=512

# RAG (Retrieval Augmented Generation)
RAG_ENABLED=true
RAG_TOP_K=10
RAG_SIMILARITY_THRESHOLD=0.7

# =============================================================================
# GPU MONITORING & METRICS
# =============================================================================

# NVIDIA GPU Monitoring
NVIDIA_GPU_MONITORING=true
NVIDIA_SMI_INTERVAL=2
GPU_POWER_LIMIT=575W
GPU_CLOCK_SPEED_LIMIT=2850MHz
GPU_MEMORY_CLOCK=10001MHz

# Advanced GPU Telemetry
ENABLE_GPU_POWER_MONITORING=true
ENABLE_GPU_THERMAL_MONITORING=true
GPU_THERMAL_THRESHOLD_C=85

# Prometheus GPU Exporter
NVIDIA_EXPORTER_PORT=9446
NVIDIA_EXPORTER_HOST=0.0.0.0
NVIDIA_EXPORTER_INTERVAL=2

# System Metrics
SYSTEM_MONITORING=true
CPU_THRESHOLD_PERCENT=85
MEMORY_THRESHOLD_PERCENT=90
DISK_THRESHOLD_PERCENT=90

# Performance Tracking
TRACK_INFERENCE_TIME=true
TRACK_QUEUE_DEPTH=true
TRACK_MODEL_LOADING_TIME=true

# =============================================================================
# DISTRIBUTED OPERATIONS
# =============================================================================

# Distributed Processing
DISTRIBUTED_INFERENCE_ENABLED=true
DISTRIBUTED_FINETUNING_ENABLED=false
ENABLE_MULTI_GPU_SYNC=true

# Communication
NCCL_DEBUG=INFO
NCCL_TIMEOUT=30
TORCH_DISTRIBUTED_DEBUG=DETAIL

# Coordination with other PCs
PC2_INFERENCE_FALLBACK=true
PC4_INFERENCE_FALLBACK=true
LOAD_BALANCE_MODELS=true

# =============================================================================
# LOGGING & DIAGNOSTICS
# =============================================================================

LOG_LEVEL=info
DEBUG_MODE=false
VERBOSE_GPU_LOGGING=false
VERBOSE_VLLM_LOGGING=true

# Training Logs
FINETUNING_LOG_FREQUENCY=100
FINETUNING_SAVE_FREQUENCY=500

# Performance Profiling
ENABLE_PROFILING=true
PROFILE_PORT=6001
ENABLE_NSYS_PROFILING=false

# Tensorboard
TENSORBOARD_ENABLED=true
TENSORBOARD_PORT=6006

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Inference Performance
OLLAMA_LOAD_TIMEOUT=600
OLLAMA_INFERENCE_TIMEOUT=900
VLLM_REQUEST_TIMEOUT=900

# Batching Configuration
DYNAMIC_BATCHING_ENABLED=true
MAX_BATCH_SIZE=256
BATCH_TIMEOUT_MS=500
BATCH_WAIT_TIMEOUT_MS=1000

# Connection Settings
CONNECTION_POOL_SIZE=50
REQUEST_TIMEOUT=600000
KEEP_ALIVE_TIMEOUT=120000

# Memory Management
SWAP_ENABLED=false
ENABLE_MEMORY_OPTIMIZATION=true
CLEAR_CACHE_INTERVAL=3600

# =============================================================================
# RESOURCE LIMITS & ALLOCATION
# =============================================================================

# VRAM Allocation
MAX_VRAM_USAGE_PERCENT=95
MIN_FREE_VRAM_GB=2
VRAM_RESERVED_FOR_SYSTEM_GB=1

# System RAM
MAX_SYSTEM_RAM_PERCENT=95
MIN_FREE_RAM_GB=4
RAM_RESERVED_FOR_OS_GB=4

# Disk Space
MIN_DISK_SPACE_GB=100
CLEANUP_OLD_MODELS_DAYS=60
CLEANUP_CHECKPOINTS_DAYS=30

# Concurrent Operations
MAX_CONCURRENT_INFERENCES=16
MAX_CONCURRENT_FINETUNES=2
MAX_CONCURRENT_EMBEDDINGS=4

# =============================================================================
# SECURITY
# =============================================================================

# API Keys
API_KEY_PC3=change_me_pc3_api_key
API_SECRET=change_me_api_secret
FINETUNING_API_KEY=change_me_finetuning_api_key

# Network Security
ENABLE_TLS=true
TLS_CERT_PATH=/etc/ssl/certs/pc3.crt
TLS_KEY_PATH=/etc/ssl/private/pc3.key

# Access Control
ALLOW_ORCHESTRATOR_IP=192.168.1.100
ALLOW_PC1_IP=192.168.1.100
ALLOW_PC2_IP=192.168.1.101
ALLOW_PC4_IP=192.168.1.103
FIREWALL_ENABLED=true

# =============================================================================
# BACKUP & RECOVERY
# =============================================================================

# Model Backup
BACKUP_MODELS=true
BACKUP_INTERVAL_HOURS=24
BACKUP_PATH=/data/ollama/backups
BACKUP_RETENTION_DAYS=14

# Checkpoint Management
CHECKPOINT_ENABLED=true
CHECKPOINT_INTERVAL_STEPS=1000
CHECKPOINT_RETENTION=5

# Auto Recovery
AUTO_RECOVERY_ENABLED=true
RECOVERY_CHECK_INTERVAL=300

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================

# Quantization Support
ENABLE_QUANTIZATION=true
QUANTIZATION_FORMAT=Q4_K_M
FP8_QUANTIZATION=true

# Prefetching & Caching
ENABLE_PREFETCHING=true
PREFETCH_THRESHOLD=0.8
MODEL_CACHE_SIZE_GB=16

# Flash Attention
ENABLE_FLASH_ATTENTION_2=true
FLASH_ATTENTION_BACKEND=triton

# Compilation
ENABLE_JIT_COMPILATION=true
COMPILATION_TIMEOUT=300
