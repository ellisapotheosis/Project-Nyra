# =============================================================================
# PC4 - RTX 3090 ENVIRONMENT CONFIGURATION
# =============================================================================
# Hardware: RTX 3090 (24GB VRAM), 32GB+ RAM, SSD storage
# Role: High-performance inference node for large models
# Static IP: 192.168.1.103
# Services: Ollama, vLLM, High-speed inference, Load balancing
# =============================================================================

# Network Configuration
PC_NAME=pc4-rtx3090
PC_ROLE=gpu-inference-heavy
STATIC_IP=192.168.1.103
TAILSCALE_AUTHKEY=tskey-auth-XXXXX-XXXXX-change-me
CLOUDFLARED_TUNNEL_TOKEN=your_tunnel_token_here_change_me

# Discovery and Registration
SERVICE_REGISTRY_URL=http://192.168.1.100:8500
CONSUL_ENABLED=true
CONSUL_CLIENT_ADDR=192.168.1.103:8503
CONSUL_SERVER_ADDR=192.168.1.100:8500

# Orchestrator Connection (PC1)
ORCHESTRATOR_HOST=192.168.1.100
ORCHESTRATOR_PORT=3000
ORCHESTRATOR_API_KEY=change_me_orchestrator_api_key

# =============================================================================
# OLLAMA CONFIGURATION (PC4 GPU Models - 24GB VRAM)
# =============================================================================

# Ollama Server
OLLAMA_HOST=0.0.0.0:11434
OLLAMA_MODELS_DIR=/data/ollama/models
OLLAMA_NUM_GPU=1
OLLAMA_GPU_LAYERS=35
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=7m

# GPU Memory Management
OLLAMA_GPU_MEMORY_FRACTION=0.95
CUDA_VISIBLE_DEVICES=0
CUDA_DEVICE_ORDER=PCI_BUS_ID

# Installed Models (24GB RTX 3090 - Heavy Inference)
# These are larger models that require significant VRAM
OLLAMA_MODELS=llama3.1:70b,qwen2.5:32b,codellama:34b,mixtral:8x7b

# Model Specifications
LLAMA3_1_70B_PARAMS=65000
QWEN2_5_32B_PARAMS=30000
CODELLAMA_34B_PARAMS=33000
MIXTRAL_8X7B_PARAMS=46700

# Advanced GPU Optimization
OLLAMA_OPTIMIZATION_LEVEL=2
OLLAMA_FLASH_ATTENTION=true
OLLAMA_ROPE_FREQ_BASE=500000
OLLAMA_ROPE_FREQ_SCALE=0.5

# =============================================================================
# VLLM CONFIGURATION (Fast Inference Engine)
# =============================================================================

# vLLM Server
VLLM_PORT=8001
VLLM_HOST=0.0.0.0
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.95

# vLLM Model Configuration
VLLM_MODELS=llama3.1:70b,qwen2.5:32b,codellama:34b,mixtral:8x7b
VLLM_ENABLE_PREFIX_CACHING=true
VLLM_ENABLE_CHUNKED_PREFILL=true
VLLM_MAX_NUM_BATCHED_TOKENS=8192

# Tensor Parallelism
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_PIPELINE_PARALLEL_SIZE=1

# KV Cache Configuration
VLLM_KV_CACHE_DTYPE=auto
VLLM_ENABLE_LOGPROBS=true
VLLM_LOGPROBS_SOFT_CAP=0.0

# Serving Configuration
VLLM_DISABLE_LOG_REQUESTS=false
VLLM_DISABLE_LOG_STATS=false
VLLM_ENFORCE_EAGER_EXECUTION=false

# =============================================================================
# LOAD BALANCING & REQUEST ROUTING
# =============================================================================

# Local Load Balancer
LOCAL_LB_ENABLED=true
LOCAL_LB_PORT=8003
LOCAL_LB_HOST=0.0.0.0

# Load Balancing Strategy
LB_STRATEGY=round_robin
LB_HEALTH_CHECK_INTERVAL=5
LB_REQUEST_QUEUE_SIZE=500
LB_REQUEST_TIMEOUT=300

# Model Distribution
PRIMARY_MODEL=llama3.1:70b
FALLBACK_MODELS=qwen2.5:32b,codellama:34b
MODEL_AFFINITY_ENABLED=true

# =============================================================================
# LITELLM PROXY (Local Model Routing)
# =============================================================================

# LiteLLM Proxy Server
LITELLM_PORT=8000
LITELLM_HOST=0.0.0.0
LITELLM_LOG_LEVEL=info
LITELLM_MAX_TOKENS=8192

# Model Routing
LITELLM_PROXY_REDIS_URL=redis://:change_me_redis_password@192.168.1.100:6379/3
LITELLM_FALLBACK_MODELS=true
LITELLM_MODEL_FALLBACK_ORDER=llama3.1:70b,qwen2.5:32b,codellama:34b

# Prompt Caching
LITELLM_CACHING_ENABLED=true
LITELLM_CACHE_TTL=3600

# =============================================================================
# GPU MONITORING & METRICS
# =============================================================================

# NVIDIA GPU Monitoring
NVIDIA_GPU_MONITORING=true
NVIDIA_SMI_INTERVAL=3
GPU_POWER_LIMIT=420W
GPU_CLOCK_SPEED_LIMIT=2550MHz

# Advanced GPU Telemetry
ENABLE_GPU_POWER_MONITORING=true
ENABLE_GPU_THERMAL_MONITORING=true
GPU_THERMAL_THRESHOLD_C=83

# Prometheus GPU Exporter
NVIDIA_EXPORTER_PORT=9447
NVIDIA_EXPORTER_HOST=0.0.0.0
NVIDIA_EXPORTER_INTERVAL=3

# System Metrics
SYSTEM_MONITORING=true
CPU_THRESHOLD_PERCENT=85
MEMORY_THRESHOLD_PERCENT=90
DISK_THRESHOLD_PERCENT=90

# Performance Tracking
TRACK_INFERENCE_TIME=true
TRACK_QUEUE_DEPTH=true
TRACK_MODEL_LOADING_TIME=true

# =============================================================================
# DISTRIBUTED OPERATIONS
# =============================================================================

# Distributed Inference
DISTRIBUTED_INFERENCE_ENABLED=true
ENABLE_MULTI_GPU_SYNC=false

# Load Sharing
ENABLE_PC2_FALLBACK=true
ENABLE_PC3_FALLBACK=true
PC2_LOAD_THRESHOLD=0.8
PC3_LOAD_THRESHOLD=0.9

# Request Distribution
DISTRIBUTE_TO_PC2_WEIGHT=0.3
DISTRIBUTE_TO_PC3_WEIGHT=0.2
KEEP_LOCAL_WEIGHT=0.5

# =============================================================================
# INFERENCE OPTIMIZATION
# =============================================================================

# Request Processing
BATCH_SIZE=64
BATCH_TIMEOUT_MS=200
MAX_CONCURRENT_REQUESTS=32

# Context Caching
ENABLE_KV_CACHE=true
CACHE_SIZE_PERCENT=0.9
CACHE_EVICTION_POLICY=lru

# Token Prediction
ENABLE_SPECULATIVE_DECODING=true
SPECULATIVE_TOKENS=5

# =============================================================================
# LOGGING & DIAGNOSTICS
# =============================================================================

LOG_LEVEL=info
DEBUG_MODE=false
VERBOSE_GPU_LOGGING=false
VERBOSE_VLLM_LOGGING=true

# Request Logging
LOG_REQUEST_DETAILS=true
LOG_INFERENCE_TIME=true
LOG_CACHE_HITS=true

# Performance Profiling
ENABLE_PROFILING=true
PROFILE_PORT=6002
ENABLE_INFERENCE_PROFILING=true

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Inference Performance
OLLAMA_LOAD_TIMEOUT=450
OLLAMA_INFERENCE_TIMEOUT=750
VLLM_REQUEST_TIMEOUT=750

# Batching Configuration
DYNAMIC_BATCHING_ENABLED=true
MAX_BATCH_SIZE=128
BATCH_TIMEOUT_MS=300
BATCH_WAIT_TIMEOUT_MS=750

# Connection Settings
CONNECTION_POOL_SIZE=40
REQUEST_TIMEOUT=450000
KEEP_ALIVE_TIMEOUT=90000

# Memory Management
SWAP_ENABLED=true
SWAP_SIZE_GB=16
ENABLE_MEMORY_OPTIMIZATION=true
CLEAR_CACHE_INTERVAL=1800

# =============================================================================
# RESOURCE LIMITS & ALLOCATION
# =============================================================================

# VRAM Allocation
MAX_VRAM_USAGE_PERCENT=95
MIN_FREE_VRAM_GB=1.5
VRAM_RESERVED_FOR_SYSTEM_GB=0.5

# System RAM
MAX_SYSTEM_RAM_PERCENT=90
MIN_FREE_RAM_GB=3
RAM_RESERVED_FOR_OS_GB=3

# Disk Space
MIN_DISK_SPACE_GB=75
CLEANUP_OLD_MODELS_DAYS=45
CLEANUP_CHECKPOINTS_DAYS=30

# Concurrent Operations
MAX_CONCURRENT_INFERENCES=32
MAX_CONCURRENT_EMBEDDINGS=4

# =============================================================================
# SECURITY
# =============================================================================

# API Keys
API_KEY_PC4=change_me_pc4_api_key
API_SECRET=change_me_api_secret

# Network Security
ENABLE_TLS=true
TLS_CERT_PATH=/etc/ssl/certs/pc4.crt
TLS_KEY_PATH=/etc/ssl/private/pc4.key

# Access Control
ALLOW_ORCHESTRATOR_IP=192.168.1.100
ALLOW_PC1_IP=192.168.1.100
ALLOW_PC2_IP=192.168.1.101
ALLOW_PC3_IP=192.168.1.102
FIREWALL_ENABLED=true

# =============================================================================
# HIGH AVAILABILITY & FAILOVER
# =============================================================================

# Health Checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=10
HEALTH_CHECK_TIMEOUT=5
UNHEALTHY_THRESHOLD=3

# Failover Configuration
ENABLE_AUTO_FAILOVER=true
FAILOVER_TIMEOUT=30
FAILOVER_RETRY_INTERVAL=10

# Service Discovery
SERVICE_DISCOVERY_ENABLED=true
DISCOVERY_INTERVAL=30
DEREGISTRATION_CRITICAL_SERVICE_AFTER=30s

# =============================================================================
# BACKUP & RECOVERY
# =============================================================================

# Model Backup
BACKUP_MODELS=true
BACKUP_INTERVAL_HOURS=24
BACKUP_PATH=/data/ollama/backups
BACKUP_RETENTION_DAYS=10

# Checkpoint Management
CHECKPOINT_ENABLED=false
CHECKPOINT_INTERVAL_STEPS=None

# Auto Recovery
AUTO_RECOVERY_ENABLED=true
RECOVERY_CHECK_INTERVAL=300

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================

# Quantization Support
ENABLE_QUANTIZATION=true
QUANTIZATION_FORMAT=Q4_K_M
FP8_QUANTIZATION=true

# Prefetching & Caching
ENABLE_PREFETCHING=true
PREFETCH_THRESHOLD=0.85
MODEL_CACHE_SIZE_GB=12

# Flash Attention
ENABLE_FLASH_ATTENTION_2=true
FLASH_ATTENTION_BACKEND=triton

# Compilation
ENABLE_JIT_COMPILATION=true
COMPILATION_TIMEOUT=300

# Request Priority
ENABLE_REQUEST_PRIORITY=true
PRIORITY_QUEUE_DEPTH=50

# =============================================================================
# MONITORING & ALERTS
# =============================================================================

# Alert Thresholds
ALERT_GPU_TEMP_THRESHOLD_C=80
ALERT_GPU_POWER_THRESHOLD_W=400
ALERT_QUEUE_DEPTH_THRESHOLD=100
ALERT_RESPONSE_TIME_THRESHOLD_MS=5000

# Alerting
ENABLE_ALERTS=true
ALERT_WEBHOOK_URL=http://192.168.1.100:5000/alerts
ALERT_EMAIL_ENABLED=false

# Metrics Export
EXPORT_METRICS=true
METRICS_EXPORT_INTERVAL=60
METRICS_RETENTION_DAYS=7
