# Core ports
REDIS_PORT=6379
ruvector_PORT=5440
RUVECTOR_POSTGRES_PORT=5436
AGENTIC_FLOW_PORT=8095
AGENTIC_FLOW_PROVIDER=anthropic
AGENTIC_FLOW_BOOTSTRAP=1
CLAUDE_FLOW_PORT=8085
CLAUDE_FLOW_DASHBOARD_PORT=3003
EVENT_SERVER_WS_PORT=3004
EVENT_SERVER_HTTP_PORT=3005

# Core credentials (replace for real use)
ruvector_DB=ruvector
ruvector_USER=ruvector
ruvector_PASSWORD=REPLACE_ME_ruvector_PASSWORD

RUVECTOR_POSTGRES_DB=claude_flow
RUVECTOR_POSTGRES_USER=claude
RUVECTOR_POSTGRES_PASSWORD=REPLACE_ME_RUVECTOR_PASSWORD

# AI provider keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_GEMINI_API_KEY=

# Optional: custom package specs/versions
RUFLO_VERSION=3.5.15
CLAUDE_FLOW_VERSION=3.5.15
AGENTIC_FLOW_VERSION=2.0.7
ruvector_VERSION=3.0.0-alpha.10
RUVECTOR_VERSION=0.2.12
AGENT_BOOSTER_VERSION=0.2.2
CLAUDE_FLOW_MEMORY_VERSION=3.0.0-alpha.11
CLAUDE_FLOW_MCP_VERSION=3.0.0-alpha.8
CLAUDE_FLOW_NEURAL_VERSION=3.0.0-alpha.7
CLAUDE_FLOW_CODEX_VERSION=3.0.0-alpha.9

# Optional: private/unpublished package install spec for epic sdk
# Examples:
# EPIC_SDK_SPEC=github:ruvnet/epic-sdk
# EPIC_SDK_SPEC=file:/workspace/path/to/epic-sdk.tgz
EPIC_SDK_SPEC=

# Runtime bootstrapping toggle
RUFLO_BOOTSTRAP=1
RUFLO_START_SYSTEM=0
RUFLO_TOPOLOGY=hierarchical-mesh
