#!/usr/bin/env bash
set -euo pipefail

# Project Nyra master infra runner
# Usage examples:
#   infra/scripts/nyra up orchestrator
#   infra/scripts/nyra up orchestrator core,observability
#   infra/scripts/nyra down worker-rtx5090
#   infra/scripts/nyra logs orchestrator n8n
#   infra/scripts/nyra validate

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
INFRA_DIR="${ROOT_DIR}/infra"

BASE_COMPOSE="${INFRA_DIR}/docker-compose.yml"
OVERRIDE_DIR="${INFRA_DIR}/compose/overrides"
ENV_DIR="${INFRA_DIR}/env"


usage() {
  cat <<'EOF'
Nyra master infra runner

Usage:
  nyra <command> <node> [profiles] [service]

Commands:
  up        Bring stack up for node (optional profiles override)
  down      Bring stack down for node
  restart   Restart stack for node
  status    Show ps for node
  logs      Show logs for node (optional service)
  config    Render docker compose config for node
  pull      Pull images for node
  validate  Validate compose config for all nodes
  ports     Show all host port bindings (per node or all)

Arguments:
 node orchestrator | | worker-rtx5090 | worker-rtx3090ti
  profiles  comma-separated compose profiles (optional)
  service   optional service name for logs/restart

Examples:
  nyra up orchestrator
  nyra up orchestrator core,observability
  nyra up worker-rtx5090 gpu,vector
  nyra status orchestrator
  nyra logs orchestrator n8n
  nyra validate
EOF
}

contains_node() {
  local n="$1"
  for v in "${VALID_NODES[@]}"; do
    [[ "$v" == "$n" ]] && return 0
  done
  return 1
}

node_env_file() {
  echo "${ENV_DIR}/.env.$1"
}

node_override_file() {
  echo "${OVERRIDE_DIR}/docker-compose.$1.override.yml"
}

require_node_files() {
  local node="$1"
  local envf; envf="$(node_env_file "$node")"
  local ovf; ovf="$(node_override_file "$node")"

  [[ -f "$BASE_COMPOSE" ]] || { echo "Missing: $BASE_COMPOSE"; exit 1; }
  [[ -f "$envf" ]] || { echo "Missing env file: $envf"; exit 1; }
  [[ -f "$ovf" ]] || { echo "Missing override file: $ovf"; exit 1; }
}

show_context() {
  local node="$1"
  local envf; envf="$(node_env_file "$node")"
  echo "== Nyra context =="
  echo "Repo root:      $ROOT_DIR"
  echo "Infra dir:      $INFRA_DIR"
  echo "Base compose:   $BASE_COMPOSE"
  echo "Override:       $(node_override_file "$node")"
  echo "Env file:       $envf"
  if [[ -f "$envf" ]]; then
    local cp
    cp="$(grep -E '^COMPOSE_PROFILES=' "$envf" | tail -n1 | cut -d= -f2- || true)"
    echo "Env profiles:   ${cp:-<none set>}"
  fi
  echo
}

cmd="${1:-}"
node="${2:-}"
profiles="${3:-}"
service="${4:-}"

if [[ -z "$cmd" ]]; then
  usage
  exit 1
fi

if [[ "$cmd" == "validate" && -z "${node:-}" ]]; then
  for n in "${VALID_NODES[@]}"; do
    echo "---- validating $n ----"
    require_node_files "$n"
    show_context "$n"
    docker compose \
      --env-file "$(node_env_file "$n")" \
      -f "$BASE_COMPOSE" \
      -f "$(node_override_file "$n")" \
      config >/dev/null
    echo "OK: $n"
    echo
  done
  exit 0
fi

if [[ "$cmd" == "ports" && -z "${node:-}" ]]; then
  for n in "${VALID_NODES[@]}"; do
    echo "---- ports for $n ----"
    require_node_files "$n"
    docker compose \
      --env-file "$(node_env_file "$n")" \
      -f "$BASE_COMPOSE" \
      -f "$(node_override_file "$n")" \
      config | awk '
        $1=="ports:" {inports=1; next}
        inports && $1 ~ /^-/ {print}
        inports && $1 !~ /^-/ {inports=0}
      ' || true
    echo
  done
  exit 0
fi

if [[ -z "${node:-}" ]]; then
  echo "Error: node is required for command '$cmd'"
  usage
  exit 1
fi

contains_node "$node" || { echo "Invalid node: $node"; usage; exit 1; }
require_node_files "$node"
show_context "$node"

case "$cmd" in
  up)
    if [[ -n "$profiles" ]]; then
      COMPOSE_PROFILES="$profiles" docker compose \
        --env-file "$(node_env_file "$node")" \
        -f "$BASE_COMPOSE" -f "$(node_override_file "$node")" \
        up -d --remove-orphans
    else
      docker compose \
        --env-file "$(node_env_file "$node")" \
        -f "$BASE_COMPOSE" -f "$(node_override_file "$node")" \
        up -d --remove-orphans
    fi
    ;;
  down)
    docker compose \
      --env-file "$(node_env_file "$node")" \
      -f "$BASE_COMPOSE" -f "$(node_override_file "$node")" \
      down --remove-orphans
    ;;
  restart)
    if [[ -n "${service:-}" ]]; then
      docker compose \
        --env-file "$(node_env_file "$node")" \
        -f "$BASE_COMPOSE" -f "$(node_override_file "$node")" \
        restart "$service"
    else
      docker compose \
        --env-file "$(node_env_file "$node")" \
        -f "$BASE_COMPOSE" -f "$(node_override_file "$node")" \
        restart
    fi
    ;;
  status|ps)
    docker compose \
      --env-file "$(node_env_file "$node")" \
      -f "$BASE_COMPOSE" -f "$(node_override_file "$node")" \
      ps
    ;;
  logs)
    if [[ -n "$service" ]]; then
      docker compose \
        --env-file "$(node_env_file "$node")" \
        -f "$BASE_COMPOSE" -f "$(node_override_file "$node")" \
        logs -f --tail=200 "$service"
    else
      docker compose \
        --env-file "$(node_env_file "$node")" \
        -f "$BASE_COMPOSE" -f "$(node_override_file "$node")" \
        logs -f --tail=200
    fi
    ;;
  config)
    if [[ -n "$profiles" ]]; then
      COMPOSE_PROFILES="$profiles" docker compose \
        --env-file "$(node_env_file "$node")" \
        -f "$BASE_COMPOSE" -f "$(node_override_file "$node")" \
        config
    else
      docker compose \
        --env-file "$(node_env_file "$node")" \
        -f "$BASE_COMPOSE" -f "$(node_override_file "$node")" \
        config
    fi
    ;;
  pull)
    if [[ -n "$profiles" ]]; then
      COMPOSE_PROFILES="$profiles" docker compose \
        --env-file "$(node_env_file "$node")" \
        -f "$BASE_COMPOSE" -f "$(node_override_file "$node")" \
        pull
    else
      docker compose \
        --env-file "$(node_env_file "$node")" \
        -f "$BASE_COMPOSE" -f "$(node_override_file "$node")" \
        pull
    fi
    ;;
  validate)
    docker compose \
      --env-file "$(node_env_file "$node")" \
      -f "$BASE_COMPOSE" -f "$(node_override_file "$node")" \
      config >/dev/null
    echo "OK: compose config valid for $node"
    ;;
  *)
    echo "Unknown command: $cmd"
    usage
    exit 1
    ;;
esac