# worker-rtx5090: session coordination, streaming TTS, and outbound audio mux.

name: nyra-voice-mesh-rtx5090

x-gpu: &gpu
  runtime: nvidia
  ipc: host
  shm_size: 8gb
  restart: unless-stopped
  environment:
    NVIDIA_VISIBLE_DEVICES: ${NVIDIA_VISIBLE_DEVICES:-0}
    NVIDIA_DRIVER_CAPABILITIES: compute,utility
    CUDA_DEVICE_ORDER: PCI_BUS_ID

services:
  voice-session-coordinator:
    image: ${NYRA_VOICE_COORDINATOR_IMAGE:-nyra/voice-session-coordinator:local}
    container_name: nyra-voice-session-coordinator-5090
    network_mode: host
    restart: unless-stopped
    environment:
      NODE_NAME: worker-rtx5090
      BIND_ADDR: ${RTX5090_LAN_IP:?set RTX5090_LAN_IP}
      HTTP_PORT: "18400"
      CLOCK_SYNC_SOURCE: ptp
      PTP_INTERFACE: ${VOICE_PTP_INTERFACE:-eno1}
      RTX3060_INGRESS_URL: http://${RTX3060_LAN_IP:?set RTX3060_LAN_IP}:18080
      RTX3090TI_STT_URL: ws://${RTX3090TI_LAN_IP:?set RTX3090TI_LAN_IP}:18200/stream
      RTX5090_TTS_URL: ws://${RTX5090_LAN_IP:?set RTX5090_LAN_IP}:18300/stream
      SESSION_TTL_SECONDS: "900"
      TURN_DEADLINE_MS: "850"
      ENABLE_BARGE_IN: "true"
      ENABLE_SPECULATIVE_TTS: "true"

  kyutai-tts-stream:
    <<: *gpu
    image: ${NYRA_KYUTAI_TTS_IMAGE:-nyra/kyutai-tts-stream:local}
    container_name: nyra-kyutai-tts-5090
    network_mode: host
    environment:
      NVIDIA_VISIBLE_DEVICES: ${NVIDIA_VISIBLE_DEVICES:-0}
      NODE_NAME: worker-rtx5090
      BIND_ADDR: ${RTX5090_LAN_IP:?set RTX5090_LAN_IP}
      WS_PORT: "18300"
      METRICS_PORT: "18390"
      MODEL_DIR: /models/kyutai
      CACHE_DIR: /cache
      PRECISION: ${TTS_PRECISION:-fp16}
      AUDIO_SAMPLE_RATE: "24000"
      AUDIO_FRAME_MS: "10"
      STREAM_CHUNK_MS: "20"
      FIRST_AUDIO_TARGET_MS: "160"
      SPECULATIVE_TTS_PREFIX_TOKENS: "16"
      SESSION_COORDINATOR_URL: http://${RTX5090_LAN_IP:?set RTX5090_LAN_IP}:18400
      OUTBOUND_RTP_ADDR: ${RTX3060_LAN_IP:?set RTX3060_LAN_IP}
      OUTBOUND_RTP_PORT_BASE: "41200"
    volumes:
      - ${UNMUTE_MODEL_VOLUME:-/srv/nyra/models/kyutai}:/models/kyutai:ro
      - ${UNMUTE_CACHE_VOLUME:-/srv/nyra/cache/kyutai}:/cache

  voice-egress-mux:
    image: ${NYRA_VOICE_EGRESS_IMAGE:-nyra/voice-egress-mux:local}
    container_name: nyra-voice-egress-5090
    network_mode: host
    restart: unless-stopped
    environment:
      NODE_NAME: worker-rtx5090
      BIND_ADDR: ${RTX5090_LAN_IP:?set RTX5090_LAN_IP}
      RTP_SOURCE_PORT_RANGE: "41200-41399"
      INGRESS_SIGNAL_URL: http://${RTX3060_LAN_IP:?set RTX3060_LAN_IP}:18080
      SESSION_COORDINATOR_URL: http://${RTX5090_LAN_IP:?set RTX5090_LAN_IP}:18400
      AUDIO_SAMPLE_RATE: "24000"
      AUDIO_FRAME_MS: "10"
      PLC_ENABLED: "true"
      DTX_ENABLED: "true"
