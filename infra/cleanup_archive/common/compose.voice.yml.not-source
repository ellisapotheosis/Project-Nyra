version: '3.8'

services:
  pockettts:
    image: ghcr.io/kyutai-labs/pocket-tts:latest
    restart: unless-stopped
    environment:
      - PORT=8000
    networks:
      - nyra-network

  voice-wrapper:
    image: ghcr.io/openclaw/pockettts-openai-wrapper:latest
    restart: unless-stopped
    ports:
      - "8000:8000"
    environment:
      - POCKETTTS_URL=http://pockettts:8000
    networks:
      - nyra-network
