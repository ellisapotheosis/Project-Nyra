# Project Nyra canonical environment template (no secrets)
# Generate secure values:
#   openssl rand -hex 32

# Cloudflare
CF_ACCOUNT_ID=replace-me
CF_ZONE_ID=replace-me
CF_API_TOKEN=replace-me
CF_TUNNEL_NAME=nyra-orchestrator
CF_TUNNEL_TOKEN=replace-me
CF_PAGES_PROJECT=ratehunter-landing
NYRA_DOMAIN_ROOT=nyra.example.com

# Core secrets
JWT_SECRET=replace-me
SESSION_SECRET=replace-me
ENCRYPTION_KEY=replace-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me

# Data
POSTGRES_DB=nyra
POSTGRES_USER=nyra
POSTGRES_PASSWORD=replace-me
REDIS_PASSWORD=replace-me
MONGO_ROOT_PASSWORD=replace-me
RUVECTOR_POSTGRES_PASSWORD=replace-me
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# LLM / Routing
OPENROUTER_API_KEY=replace-me
LITELLM_MASTER_KEY=replace-me
WORKER1_LLM_BASE_URL=http://100.64.0.10:8000
WORKER2_LLM_BASE_URL=http://100.64.0.12:8000
WORKER3_LLM_BASE_URL=http://100.64.0.11:11434
WORKER1_LLM_API_KEY=
WORKER2_LLM_API_KEY=
WORKER3_LLM_API_KEY=

# Tailscale
TAILSCALE_AUTHKEY=replace-me

# Kyutai Unmute
HUGGING_FACE_HUB_TOKEN=
KYUTAI_LLM_URL=http://litellm:4000/v1
KYUTAI_LLM_MODEL=openrouter/openai/gpt-4o-mini
KYUTAI_LLM_API_KEY=ollama

# Optional secrets manager
INFISICAL_PROJECT_ID=replace-me
INFISICAL_CLIENT_ID=replace-me
INFISICAL_CLIENT_SECRET=replace-me

# Compose ports
NEXUS_ROUTER_PORT=7000
NEXUS_MCP_PORT=8080
LITELLM_PORT=4000
N8N_PORT=5678
ACTIVEPIECES_PORT=8082
TWENTYCRM_PORT=3000
TWENTYCRM_MCP_PORT=8182
MOLTBOT_WEB_PORT=3030
OPENWEBUI_PORT=8088
PROMETHEUS_PORT=9090
GRAFANA_PORT=3003
LOKI_PORT=3100
