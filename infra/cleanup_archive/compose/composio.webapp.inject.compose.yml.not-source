# Inject the hosted Composio MCP server into the Project-Nyra webapp service.
# Apply only with the compose project that already defines `webapp`.

x-composio-env: &composio-env
  COMPOSIO_MCP_URL: ${COMPOSIO_MCP_URL:?set COMPOSIO_MCP_URL}
  COMPOSIO_API_KEY: ${COMPOSIO_API_KEY:?set COMPOSIO_API_KEY}
  COMPOSIO_MCP_TRANSPORT: ${COMPOSIO_MCP_TRANSPORT:-streamable-http}
  COMPOSIO_MCP_SERVER_NAME: ${COMPOSIO_MCP_SERVER_NAME:-composio}
  COMPOSIO_DEFAULT_USER_ID: ${COMPOSIO_DEFAULT_USER_ID:?set COMPOSIO_DEFAULT_USER_ID}
  COMPOSIO_TOOLKITS_ALLOW: ${COMPOSIO_TOOLKITS_ALLOW:-jira,slack,twenty}
  COMPOSIO_EXECUTION_POLICY: ${COMPOSIO_EXECUTION_POLICY:-require-user-bound-connection}

services:
  webapp:
    environment:
      <<: *composio-env
      NEXT_PUBLIC_ASSISTANT_MCP_ENABLED: "true"
      ASSISTANT_MCP_COMPOSIO_URL: ${COMPOSIO_MCP_URL:?set COMPOSIO_MCP_URL}
      ASSISTANT_MCP_SERVERS: ${ASSISTANT_MCP_SERVERS:-nexus,composio}
      ASSISTANT_TOOLKITS_ALLOW: ${ASSISTANT_TOOLKITS_ALLOW:-jira,slack,twenty}
