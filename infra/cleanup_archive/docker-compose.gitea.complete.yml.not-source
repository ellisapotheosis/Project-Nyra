# ============================================================================
# Project Nyra - Complete Gitea Infrastructure
# ============================================================================
# Enhanced production setup integrating all discovered configurations
# Includes: CI/CD, AI review, monitoring, Oracle backup, MCP integration
# ============================================================================

version: '3.9'

services:
  # ==========================================
  # SECRETS & CONFIGURATION MANAGEMENT
  # ==========================================
  nyra-secrets-init:
    build:
      context: ./infra/hosts/infisical-secrets-init
      dockerfile: Dockerfile
    container_name: nyra-gitea-secrets-init
    entrypoint: ["/usr/local/bin/secrets-init.sh"]
    environment:
      INFISICAL_API_URL: ${INFISICAL_API_URL:-https://app.infisical.com}
      INFISICAL_PROJECT_ID: ${INFISICAL_PROJECT_ID:-8374cea9-e5e8-4050-bda4-b91f25ab30ef}
      INFISICAL_TOKEN: ${INFISICAL_TOKEN}
      INFISICAL_ENV: ${INFISICAL_ENV:-prod}
      INFISICAL_PATH: ${INFISICAL_PATH:-/nyra/gitea}
      NYRA_FORCE_SECRETS: ${NYRA_FORCE_SECRETS:-false}
    volumes:
      - nyra_secrets:/run/nyra-secrets
    networks:
      - nyra-net
    restart: "no"
    labels:
      - "nyra.service=secrets-init"
      - "nyra.category=infrastructure"
      - "nyra.machine=${NYRA_MACHINE:-orchestrator}"

  # ==========================================
  # CORE DATABASE CLUSTER
  # ==========================================
  gitea-db:
    image: postgres:16-alpine
    container_name: nyra-gitea-db
    depends_on:
      nyra-secrets-init:
        condition: service_completed_successfully
    environment:
      POSTGRES_DB: gitea
      POSTGRES_USER: gitea
      POSTGRES_PASSWORD_FILE: /run/nyra-secrets/gitea_db_pass
      POSTGRES_INITDB_ARGS: "--auth-host=scram-sha-256 --data-checksums"
      PGDATA: /var/lib/postgresql/data/pgdata
    ports:
      - "${GITEA_DB_PORT:-5433}:5432"
    volumes:
      - gitea_db_data:/var/lib/postgresql/data
      - nyra_secrets:/run/nyra-secrets:ro
      - ./infra/configs/gitea/db-init:/docker-entrypoint-initdb.d:ro
    networks:
      - nyra-net
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U gitea -d gitea"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s
    deploy:
      resources:
        limits:
          memory: 2G
          cpus: '2'
        reservations:
          memory: 512M
          cpus: '0.5'
    labels:
      - "nyra.service=gitea-db"
      - "nyra.category=database"
      - "nyra.machine=${NYRA_MACHINE:-orchestrator}"

  # ==========================================
  # REDIS CLUSTER (Cache & Sessions)
  # ==========================================
  gitea-redis:
    image: redis:7-alpine
    container_name: nyra-gitea-redis
    command: >
      redis-server
      --appendonly yes
      --appendfsync everysec
      --maxmemory 1gb
      --maxmemory-policy allkeys-lru
      --requirepass "$$(cat /run/secrets/redis_password)"
      --save 900 1
      --save 300 10
      --save 60 10000
    volumes:
      - gitea_redis_data:/data
      - nyra_secrets:/run/secrets:ro
    networks:
      - nyra-net
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "redis-cli", "--no-auth-warning", "-a", "$$(cat /run/secrets/redis_password)", "ping"]
      interval: 10s
      timeout: 5s
      retries: 3
    deploy:
      resources:
        limits:
          memory: 1G
          cpus: '1'
    labels:
      - "nyra.service=gitea-redis"
      - "nyra.category=cache"

  # ==========================================
  # GITEA SERVER (Enhanced Configuration)
  # ==========================================
  gitea:
    image: docker.gitea.com/gitea:1.25.4
    container_name: nyra-gitea
    depends_on:
      gitea-db:
        condition: service_healthy
      gitea-redis:
        condition: service_healthy
    environment:
      # Core Configuration
      USER_UID: 1000
      USER_GID: 1000
      GITEA_WORK_DIR: /data/gitea

      # Database Configuration
      GITEA__database__DB_TYPE: postgres
      GITEA__database__HOST: gitea-db:5432
      GITEA__database__NAME: gitea
      GITEA__database__USER: gitea
      GITEA__database__PASSWD__FILE: /run/nyra-secrets/gitea_db_pass
      GITEA__database__CHARSET: utf8
      GITEA__database__SSL_MODE: disable

      # Server Configuration
      GITEA__server__ROOT_URL: ${GITEA_ROOT_URL:-https://git.ratehunter.net/}
      GITEA__server__SSH_DOMAIN: ${GITEA_SSH_DOMAIN:-git.ratehunter.net}
      GITEA__server__SSH_PORT: ${GITEA_SSH_PORT:-2222}
      GITEA__server__SSH_LISTEN_PORT: 22
      GITEA__server__DOMAIN: ${GITEA_DOMAIN:-git.ratehunter.net}
      GITEA__server__PROTOCOL: ${GITEA_PROTOCOL:-https}
      GITEA__server__LFS_START_SERVER: "true"
      GITEA__server__ENABLE_GZIP: "true"
      GITEA__server__LANDING_PAGE: login
      GITEA__server__ENABLE_PPROF: ${GITEA_ENABLE_PPROF:-false}

      # Security Configuration
      GITEA__security__SECRET_KEY__FILE: /run/nyra-secrets/gitea_secret_key
      GITEA__security__INTERNAL_TOKEN__FILE: /run/nyra-secrets/gitea_internal_token
      GITEA__security__INSTALL_LOCK: "true"
      GITEA__security__MIN_PASSWORD_LENGTH: 12
      GITEA__security__PASSWORD_COMPLEXITY: "lower,upper,digit,spec"
      GITEA__security__PASSWORD_HASH_ALGO: argon2
      GITEA__security__SUCCESSFUL_TOKENS_CACHE_SIZE: 20

      # Service Configuration
      GITEA__service__DISABLE_REGISTRATION: "true"
      GITEA__service__REQUIRE_SIGNIN_VIEW: "true"
      GITEA__service__DEFAULT_BRANCH: main
      GITEA__service__DEFAULT_KEEP_EMAIL_PRIVATE: "true"
      GITEA__service__ENABLE_NOTIFY_MAIL: "true"
      GITEA__service__AUTO_WATCH_NEW_REPOS: "true"
      GITEA__service__DEFAULT_ORG_VISIBILITY: private

      # Actions & CI/CD
      GITEA__actions__ENABLED: "true"
      GITEA__actions__DEFAULT_ACTIONS_URL: github
      GITEA__actions__ARTIFACT_RETENTION_DAYS: 30
      GITEA__actions__LOG_RETENTION_DAYS: 30

      # Repository Configuration
      GITEA__repository__ROOT: /data/git/repositories
      GITEA__repository__DEFAULT_PRIVATE: private
      GITEA__repository__ENABLE_PUSH_CREATE_USER: "true"
      GITEA__repository__ENABLE_PUSH_CREATE_ORG: "true"
      GITEA__repository__DEFAULT_REPO_UNITS: "repo.code,repo.releases,repo.issues,repo.pulls,repo.wiki,repo.actions"
      GITEA__repository__PREFERRED_LICENSES: "MIT,Apache-2.0,GPL-3.0,BSD-3-Clause"
      GITEA__repository__DISABLE_HTTP_GIT: "false"

      # Webhook Configuration
      GITEA__webhook__ALLOWED_HOST_LIST: "github.com,api.github.com,*.github.com,*.ratehunter.net,localhost,127.0.0.1"
      GITEA__webhook__SKIP_TLS_VERIFY: "false"
      GITEA__webhook__DELIVER_TIMEOUT: 15

      # Email Configuration
      GITEA__mailer__ENABLED: "true"
      GITEA__mailer__SMTP_ADDR: ${SMTP_HOST:-smtp.gmail.com}
      GITEA__mailer__SMTP_PORT: ${SMTP_PORT:-587}
      GITEA__mailer__FROM: ${GITEA_EMAIL_FROM:-git@ratehunter.net}
      GITEA__mailer__USER: ${SMTP_USER:-}
      GITEA__mailer__PASSWD__FILE: /run/nyra-secrets/smtp_password
      GITEA__mailer__USE_SENDMAIL: "false"
      GITEA__mailer__HELO_HOSTNAME: ${GITEA_DOMAIN:-git.ratehunter.net}

      # Cache & Session Configuration
      GITEA__cache__ENABLED: "true"
      GITEA__cache__ADAPTER: redis
      GITEA__cache__HOST: redis://:$$(cat /run/nyra-secrets/redis_password)@gitea-redis:6379/0
      GITEA__cache__ITEM_TTL: 16h

      GITEA__session__PROVIDER: redis
      GITEA__session__PROVIDER_CONFIG: redis://:$$(cat /run/nyra-secrets/redis_password)@gitea-redis:6379/1
      GITEA__session__COOKIE_SECURE: "true"
      GITEA__session__SAME_SITE: lax

      # Performance & Logging
      GITEA__log__LEVEL: ${LOG_LEVEL:-Info}
      GITEA__log__ROOT_PATH: /data/gitea/log
      GITEA__log__MODE: console,file
      GITEA__log__BUFFER_LEN: 10000

      # API & Metrics
      GITEA__api__ENABLE_SWAGGER: "true"
      GITEA__api__MAX_RESPONSE_ITEMS: 50
      GITEA__metrics__ENABLED: "true"
      GITEA__metrics__TOKEN__FILE: /run/nyra-secrets/gitea_metrics_token

    ports:
      - "${GITEA_PORT:-3100}:3000"
      - "${GITEA_SSH_PORT:-2222}:22"
    volumes:
      - gitea_data:/data
      - nyra_secrets:/run/nyra-secrets:ro
      - ./infra/configs/gitea/app.ini.d:/etc/gitea/conf.d:ro
      - ./infra/configs/gitea/templates:/data/gitea/templates:ro
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    networks:
      - nyra-net
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3000/api/healthz"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    deploy:
      resources:
        limits:
          memory: 4G
          cpus: '4'
        reservations:
          memory: 1G
          cpus: '1'
    labels:
      - "nyra.service=gitea"
      - "nyra.role=git-orchestrator"
      - "nyra.machine=${NYRA_MACHINE:-orchestrator}"
      # Traefik/Reverse Proxy Labels
      - "traefik.enable=true"
      - "traefik.http.routers.gitea.rule=Host(`git.ratehunter.net`)"
      - "traefik.http.routers.gitea.entrypoints=websecure"
      - "traefik.http.routers.gitea.tls.certresolver=letsencrypt"
      - "traefik.http.services.gitea.loadbalancer.server.port=3000"

  # ==========================================
  # INFISICAL AGENT (Live Secrets Sync)
  # ==========================================
  infisical-agent-gitea:
    build:
      context: ./infra/hosts/infisical-secrets-init
      dockerfile: Dockerfile
    container_name: nyra-infisical-agent-gitea
    entrypoint: ["/usr/local/bin/agent-sidecar.sh"]
    depends_on:
      nyra-secrets-init:
        condition: service_completed_successfully
    environment:
      INFISICAL_API_URL: ${INFISICAL_API_URL:-https://app.infisical.com}
      INFISICAL_PROJECT_ID: ${INFISICAL_PROJECT_ID:-8374cea9-e5e8-4050-bda4-b91f25ab30ef}
      INFISICAL_TOKEN: ${INFISICAL_TOKEN}
      INFISICAL_ENV: ${INFISICAL_ENV:-prod}
      INFISICAL_PATH: ${INFISICAL_PATH:-/nyra/gitea}
      INFISICAL_POLL_INTERVAL: ${INFISICAL_POLL_INTERVAL:-300s}
    volumes:
      - nyra_secrets:/run/nyra-secrets
    networks:
      - nyra-net
    restart: unless-stopped
    profiles:
      - infisical
    labels:
      - "nyra.service=infisical-agent"
      - "nyra.category=infrastructure"

  # ==========================================
  # AI CODE REVIEWER (Enhanced)
  # ==========================================
  gitea-ai-reviewer:
    build:
      context: ./infra/ai-reviewer
      dockerfile: Dockerfile
    container_name: nyra-gitea-ai-reviewer
    depends_on:
      gitea:
        condition: service_healthy
    environment:
      GITEA_BASE_URL: http://gitea:3000
      GITEA_TOKEN_FILE: /run/nyra-secrets/gitea_pat_token
      WEBHOOK_AUTH_TOKEN_FILE: /run/nyra-secrets/webhook_auth_token
      WEBHOOK_SECRET_FILE: /run/nyra-secrets/webhook_secret
      OPENAI_BASE_URL: ${OPENAI_BASE_URL:-http://nexus-router:6000/v1}
      OPENAI_API_KEY_FILE: /run/nyra-secrets/openai_api_key
      REVIEW_MODEL: ${REVIEW_MODEL:-claude-3.5-sonnet}
      REVIEW_MAX_CHARS: ${REVIEW_MAX_CHARS:-18000}
      REVIEW_POST_AS_REVIEW: ${REVIEW_POST_AS_REVIEW:-true}
      REVIEW_LABEL: ${REVIEW_LABEL:-ai-reviewed}
      REVIEW_SKIP_PATHS: "vendor/,node_modules/,*.lock,*.min.js,*.min.css,dist/,build/"
      # Enhanced AI Features
      REVIEW_ANALYZE_SECURITY: "true"
      REVIEW_ANALYZE_PERFORMANCE: "true"
      REVIEW_ANALYZE_ARCHITECTURE: "true"
      REVIEW_AUTO_MERGE_THRESHOLD: "95"
    ports:
      - "${AI_REVIEWER_PORT:-8091}:8000"
    volumes:
      - nyra_secrets:/run/nyra-secrets:ro
    networks:
      - nyra-net
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
    profiles:
      - ai
    labels:
      - "nyra.service=gitea-ai-reviewer"
      - "nyra.category=automation"

  # ==========================================
  # GITEA ACTIONS RUNNERS
  # ==========================================
  gitea-act-runner:
    image: nyra/gitea-act-runner:0.2.11
    build:
      context: .
      dockerfile: infra/images/gitea-act-runner/Dockerfile
      args:
        ACT_RUNNER_VERSION: 0.2.11
    container_name: nyra-gitea-actions
    depends_on:
      gitea:
        condition: service_healthy
    environment:
      TZ: ${TZ:-America/Los_Angeles}
      GITEA_INSTANCE_URL: http://gitea:3000
      GITEA_RUNNER_REGISTRATION_TOKEN_FILE: /run/nyra-secrets/gitea_runner_token
      GITEA_RUNNER_CONFIG_TEMPLATE: /opt/nyra/runner-config.yaml
      GITEA_RUNNER_CONFIG_PATH: /data/config.yaml
      GITEA_RUNNER_NAME: nyra-runner-${NYRA_MACHINE:-orchestrator}
      GITEA_RUNNER_LABELS: "ubuntu-latest:docker://node:20-bookworm,docker:host,self-hosted:host,nyra:host,postgres:docker://postgres:16-alpine"
      RUNNER_CACHE_DIR: /cache
      DOCKER_HOST: unix:///var/run/docker.sock
      # Enhanced Runner Features
      RUNNER_UPDATE_INTERVAL: "24h"
      RUNNER_FETCH_TIMEOUT: "30s"
      RUNNER_FETCH_INTERVAL: "5s"
    volumes:
      - act_runner_data:/data
      - act_runner_cache:/cache
      - /var/run/docker.sock:/var/run/docker.sock:rw
      - nyra_secrets:/run/nyra-secrets:ro
      - ./tmp/runner-cache:/tmp/cache
    networks:
      - nyra-net
    entrypoint: ["/bin/sh", "/usr/local/bin/bootstrap-act-runner.sh"]
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 8G
          cpus: '4'
        reservations:
          memory: 2G
          cpus: '1'
    profiles:
      - actions
    labels:
      - "nyra.service=gitea-actions"
      - "nyra.machine=${NYRA_MACHINE:-orchestrator}"
      - "nyra.runner.type=standard"

  gitea-act-runner-large:
    image: nyra/gitea-act-runner:0.2.11
    build:
      context: .
      dockerfile: infra/images/gitea-act-runner/Dockerfile
      args:
        ACT_RUNNER_VERSION: 0.2.11
    container_name: nyra-gitea-actions-large
    depends_on:
      gitea:
        condition: service_healthy
    environment:
      TZ: ${TZ:-America/Los_Angeles}
      GITEA_INSTANCE_URL: http://gitea:3000
      GITEA_RUNNER_REGISTRATION_TOKEN_FILE: /run/nyra-secrets/gitea_runner_token
      GITEA_RUNNER_CONFIG_TEMPLATE: /opt/nyra/runner-config-large.yaml
      GITEA_RUNNER_CONFIG_PATH: /data/config.yaml
      GITEA_RUNNER_NAME: nyra-runner-large-${NYRA_MACHINE:-orchestrator}
      GITEA_RUNNER_LABELS: "ubuntu-latest-large:docker://node:20-bookworm,docker-large:host,self-hosted-large:host,gpu:host,nyra-large:host"
      RUNNER_CACHE_DIR: /cache
      DOCKER_HOST: unix:///var/run/docker.sock
      # GPU Environment
      NVIDIA_VISIBLE_DEVICES: "all"
      NVIDIA_DRIVER_CAPABILITIES: "compute,utility"
    volumes:
      - act_runner_large_data:/data
      - act_runner_large_cache:/cache
      - /var/run/docker.sock:/var/run/docker.sock:rw
      - nyra_secrets:/run/nyra-secrets:ro
      - ./tmp/runner-cache-large:/tmp/cache
    networks:
      - nyra-net
    entrypoint: ["/bin/sh", "/usr/local/bin/bootstrap-act-runner.sh"]
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 24G
          cpus: '12'
        reservations:
          memory: 8G
          cpus: '4'
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]
    profiles:
      - actions-large
    labels:
      - "nyra.service=gitea-actions-large"
      - "nyra.machine=${NYRA_MACHINE:-orchestrator}"
      - "nyra.runner.type=large"

  # ==========================================
  # GITEA MCP SERVER (Enhanced)
  # ==========================================
  gitea-mcp:
    build:
      context: ./services/gitea-mcp
      dockerfile: Dockerfile
    container_name: nyra-gitea-mcp
    depends_on:
      gitea:
        condition: service_healthy
    environment:
      PORT: 3100
      GITEA_URL: http://gitea:3000
      GITEA_TOKEN_FILE: /run/nyra-secrets/gitea_mcp_token
      GITEA_OWNER: ${GITEA_OWNER:-admin}
      GITEA_REPO: ${GITEA_REPO:-Project-Nyra}
      MCP_SERVER_NAME: gitea-mcp-server
      LOG_LEVEL: ${LOG_LEVEL:-info}
      # Enhanced MCP Features
      MCP_MAX_CONNECTIONS: 100
      MCP_RATE_LIMIT: "1000/hour"
      MCP_ENABLE_METRICS: "true"
    ports:
      - "${GITEA_MCP_PORT:-8092}:3100"
    volumes:
      - nyra_secrets:/run/nyra-secrets:ro
    networks:
      - nyra-net
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3100/health"]
      interval: 30s
      timeout: 10s
      retries: 3
    labels:
      - "nyra.service=gitea-mcp"
      - "nyra.category=mcp-server"
      - "mcp.server=gitea"
      - "mcp.capabilities=repository,files,commits"

  # ==========================================
  # GITHUB MIRROR SYNC SERVICE
  # ==========================================
  github-mirror-sync:
    build:
      context: ./infra/github-sync
      dockerfile: Dockerfile
    container_name: nyra-github-mirror
    depends_on:
      gitea:
        condition: service_healthy
    environment:
      GITEA_URL: http://gitea:3000
      GITEA_TOKEN_FILE: /run/nyra-secrets/gitea_admin_token
      GITHUB_TOKEN_FILE: /run/nyra-secrets/github_token
      GITHUB_REPO: ${GITHUB_REPO:-ellisapotheosis/Project-Nyra}
      SYNC_INTERVAL: ${SYNC_INTERVAL:-300}
      SYNC_DIRECTION: ${SYNC_DIRECTION:-bidirectional}
      CONFLICT_RESOLUTION: ${CONFLICT_RESOLUTION:-gitea_wins}
      LOG_LEVEL: ${LOG_LEVEL:-info}
      # Enhanced Sync Features
      SYNC_BRANCHES: ${SYNC_BRANCHES:-main,develop}
      SYNC_TAGS: "true"
      SYNC_RELEASES: "true"
      SYNC_ISSUES: ${SYNC_ISSUES:-false}
      SYNC_PULL_REQUESTS: ${SYNC_PULL_REQUESTS:-false}
    ports:
      - "${GITHUB_SYNC_PORT:-8093}:8080"
    volumes:
      - nyra_secrets:/run/nyra-secrets:ro
      - github_sync_data:/data
    networks:
      - nyra-net
    restart: unless-stopped
    profiles:
      - mirror
    labels:
      - "nyra.service=github-mirror"
      - "nyra.category=synchronization"

  # ==========================================
  # MONITORING & OBSERVABILITY
  # ==========================================
  gitea-prometheus:
    image: prom/prometheus:v2.51.0
    container_name: nyra-gitea-prometheus
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--storage.tsdb.retention.time=30d'
      - '--web.console.libraries=/etc/prometheus/console_libraries'
      - '--web.console.templates=/etc/prometheus/consoles'
      - '--web.enable-lifecycle'
      - '--web.enable-admin-api'
    ports:
      - "${PROMETHEUS_PORT:-9090}:9090"
    volumes:
      - ./infra/configs/prometheus/gitea-prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus_data:/prometheus
    networks:
      - nyra-net
    restart: unless-stopped
    profiles:
      - monitoring
    labels:
      - "nyra.service=prometheus"
      - "nyra.category=monitoring"

  gitea-grafana:
    image: grafana/grafana:11.1.3
    container_name: nyra-gitea-grafana
    environment:
      GF_SECURITY_ADMIN_PASSWORD_FILE: /run/nyra-secrets/grafana_admin_pass
      GF_INSTALL_PLUGINS: grafana-piechart-panel,grafana-worldmap-panel
    ports:
      - "${GRAFANA_PORT:-3005}:3000"
    volumes:
      - grafana_data:/var/lib/grafana
      - ./infra/configs/grafana/gitea-dashboards:/etc/grafana/provisioning/dashboards:ro
      - ./infra/configs/grafana/datasources:/etc/grafana/provisioning/datasources:ro
      - nyra_secrets:/run/nyra-secrets:ro
    networks:
      - nyra-net
    restart: unless-stopped
    profiles:
      - monitoring
    labels:
      - "nyra.service=grafana"
      - "nyra.category=monitoring"

# ==========================================
# VOLUMES
# ==========================================
volumes:
  gitea_data:
    name: nyra-gitea-data
    driver: local
    driver_opts:
      type: none
      o: bind
      device: ${GITEA_DATA_PATH:-./data/gitea}

  gitea_db_data:
    name: nyra-gitea-db
    driver: local
    driver_opts:
      type: none
      o: bind
      device: ${GITEA_DB_PATH:-./data/gitea-db}

  gitea_redis_data:
    name: nyra-gitea-redis

  act_runner_data:
    name: nyra-gitea-actions-data

  act_runner_large_data:
    name: nyra-gitea-actions-large-data

  act_runner_cache:
    name: nyra-gitea-actions-cache

  act_runner_large_cache:
    name: nyra-gitea-actions-large-cache

  github_sync_data:
    name: nyra-github-sync-data

  prometheus_data:
    name: nyra-prometheus-data

  grafana_data:
    name: nyra-grafana-data

  nyra_secrets:
    name: nyra-secrets
    external: true

# ==========================================
# NETWORKS
# ==========================================
networks:
  nyra-net:
    name: ${NYRA_NETWORK:-nyra-net}
    external: true