# ============================================================================
# Worker-3060 Configuration
# ============================================================================

# Worker Identity
WORKER_NAME=worker-3060
WORKER_TYPE=gpu
WORKER_ID=worker-3060-${RANDOM_ID}
GPU_MODEL=RTX_3060
VRAM_GB=12
WORKER_ROLE=document-processing

# ============================================================================
# Ollama Configuration
# ============================================================================

OLLAMA_HOST=0.0.0.0:11434
OLLAMA_ORIGINS=*
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=3
OLLAMA_MAX_QUEUE=10
OLLAMA_KEEP_ALIVE=5m

# Model Configuration
PRIMARY_MODEL=codellama:34b
SECONDARY_MODEL=qwen2:32b
TERTIARY_MODEL=gemma2:27b
DEFAULT_MODEL=codellama:34b

# ============================================================================
# NVIDIA CUDA Configuration
# ============================================================================

CUDA_VERSION=12.4
CUDA_PATH=C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v12.4
CUDA_VISIBLE_DEVICES=0
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ============================================================================
# Network Configuration
# ============================================================================

# Tailscale
TAILSCALE_HOSTNAME=worker-3060.tail-net.ts.net
TAILSCALE_KEY=tskey-auth-XXXXXXXXXXXXXXXXXXXX
TAILSCALE_AUTH_KEY=${TAILSCALE_KEY}

# Nexus Router
NEXUS_ROUTER_URL=http://nexus-router.tail-net.ts.net:6000
NEXUS_ROUTER_API_KEY=your-api-key-here

# Internal URLs
OLLAMA_INTERNAL_URL=http://ollama:11434
ONNX_INTERNAL_URL=http://onnx-runtime:8001
EMBEDDING_INTERNAL_URL=http://embedding-service:8080
REDIS_INTERNAL_URL=redis://redis:6379

# ============================================================================
# Infisical Configuration (Secrets Management)
# ============================================================================

INFISICAL_PROJECT_ID=8374cea9-e5e8-4050-bda4-b91f25ab30ef
INFISICAL_ENV=dev
INFISICAL_PATH=/worker-3060
INFISICAL_TOKEN=your-service-token-here
INFISICAL_API_URL=https://app.infisical.com

# ============================================================================
# Cloudflare Tunnel Configuration
# ============================================================================

CLOUDFLARED_TUNNEL_ID=your-tunnel-id-here
CLOUDFLARED_TUNNEL_NAME=worker-3060
CLOUDFLARED_TUNNEL_TOKEN=your-tunnel-token-here
CLOUDFLARED_TUNNEL_URL=https://worker-3060.yourdomain.com

# ============================================================================
# ONNX Runtime Configuration
# ============================================================================

ONNX_RUNTIME_PROVIDER=cuda
ONNX_RUNTIME_DEVICE=0
ONNX_RUNTIME_LOG_LEVEL=WARNING
ONNX_RUNTIME_INTER_OP_THREADS=2
ONNX_RUNTIME_INTRA_OP_THREADS=4

# ============================================================================
# Embedding Service Configuration
# ============================================================================

EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_SEQUENCE_LENGTH=512
EMBEDDING_CACHE_DIR=/cache
EMBEDDING_PORT=8080

# ============================================================================
# Redis Configuration
# ============================================================================

REDIS_PORT=6379
REDIS_MAXMEMORY=2gb
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_PASSWORD=your-redis-password-here

# ============================================================================
# Health Monitor Configuration
# ============================================================================

HEALTH_CHECK_INTERVAL=60
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3
HEALTH_MONITOR_PORT=9090

PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_PUSH_GATEWAY=http://prometheus-gateway.tail-net.ts.net:9091

# ============================================================================
# Monitoring & Observability
# ============================================================================

# Prometheus
PROMETHEUS_URL=http://prometheus.tail-net.ts.net:9090

# Grafana
GRAFANA_URL=http://grafana.tail-net.ts.net:3005
GRAFANA_API_KEY=your-grafana-api-key-here

# Loki
LOKI_URL=http://loki.tail-net.ts.net:3100

# Node Exporter
NODE_EXPORTER_PORT=9100

# GPU Exporter
GPU_EXPORTER_PORT=9445

# ============================================================================
# Performance Tuning
# ============================================================================

# GPU Memory Management
GPU_MEMORY_FRACTION=0.95
GPU_ALLOW_GROWTH=true

# Batch Processing
MAX_BATCH_SIZE=32
MIN_BATCH_SIZE=1
BATCH_TIMEOUT_MS=100

# Concurrency
MAX_CONCURRENT_REQUESTS=4
WORKER_THREADS=4

# Caching
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# ============================================================================
# Logging Configuration
# ============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/worker-3060/worker.log
LOG_MAX_SIZE=100M
LOG_MAX_FILES=10

# ============================================================================
# Security Configuration
# ============================================================================

# API Keys
WORKER_API_KEY=your-worker-api-key-here
INTERNAL_API_KEY=your-internal-api-key-here

# TLS/SSL
TLS_ENABLED=false
TLS_CERT_PATH=/etc/ssl/certs/worker-3060.crt
TLS_KEY_PATH=/etc/ssl/private/worker-3060.key

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ============================================================================
# Docker Configuration
# ============================================================================

COMPOSE_PROJECT_NAME=worker-3060
COMPOSE_HTTP_TIMEOUT=300
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# ============================================================================
# Project Nyra Integration
# ============================================================================

# TwentyCRM
TWENTY_CRM_URL=http://twenty-crm.tail-net.ts.net:3000
TWENTY_CRM_API_KEY=your-twenty-crm-api-key-here

# Dify
DIFY_URL=http://dify.tail-net.ts.net:3001
DIFY_API_KEY=your-dify-api-key-here

# n8n
N8N_URL=http://n8n.tail-net.ts.net:5678
N8N_API_KEY=your-n8n-api-key-here

# Letta
LETTA_URL=http://letta.tail-net.ts.net:8283
LETTA_API_KEY=your-letta-api-key-here

# Graphiti
GRAPHITI_URL=http://graphiti.tail-net.ts.net:8080
GRAPHITI_API_KEY=your-graphiti-api-key-here

# RuVector
RUVECTOR_URL=http://ruvector.tail-net.ts.net:6333
RUVECTOR_API_KEY=your-ruvector-api-key-here

# ============================================================================
# Feature Flags
# ============================================================================

ENABLE_GPU=true
ENABLE_CACHING=true
ENABLE_MONITORING=true
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true
ENABLE_AUTO_SCALING=false
ENABLE_LOAD_BALANCING=true

# ============================================================================
# Experimental Features
# ============================================================================

EXPERIMENTAL_FLASH_ATTENTION=false
EXPERIMENTAL_TENSOR_PARALLEL=false
EXPERIMENTAL_QUANTIZATION=false
