# worker-rtx3060: ingress, VAD, codec, jitter control, and low-VRAM fallback decode.

name: nyra-voice-mesh-rtx3060

x-gpu: &gpu
  runtime: nvidia
  ipc: host
  shm_size: 2gb
  restart: unless-stopped
  environment:
    NVIDIA_VISIBLE_DEVICES: ${NVIDIA_VISIBLE_DEVICES:-0}
    NVIDIA_DRIVER_CAPABILITIES: compute,utility
    CUDA_DEVICE_ORDER: PCI_BUS_ID

services:
  voice-ingress:
    image: ${NYRA_VOICE_EDGE_IMAGE:-nyra/kyutai-voice-edge:local}
    container_name: nyra-voice-ingress-3060
    network_mode: host
    restart: unless-stopped
    environment:
      NODE_NAME: worker-rtx3060
      RTP_BIND_ADDR: ${RTX3060_LAN_IP:?set RTX3060_LAN_IP}
      RTP_PORT_RANGE: ${VOICE_RTP_PORT_RANGE:-41000-41199}
      WS_SIGNAL_BIND: ${RTX3060_LAN_IP:?set RTX3060_LAN_IP}:18080
      CLOCK_SYNC_SOURCE: ptp
      PTP_INTERFACE: ${VOICE_PTP_INTERFACE:-eno1}
      AUDIO_SAMPLE_RATE: "24000"
      AUDIO_FRAME_MS: "10"
      JITTER_TARGET_MS: "20"
      JITTER_MAX_MS: "45"
      VAD_ENDPOINT: http://${RTX3060_LAN_IP:?set RTX3060_LAN_IP}:18100
      STT_STREAM_ENDPOINT: ws://${RTX3090TI_LAN_IP:?set RTX3090TI_LAN_IP}:18200/stream
      TTS_STREAM_ENDPOINT: ws://${RTX5090_LAN_IP:?set RTX5090_LAN_IP}:18300/stream
      SESSION_COORDINATOR_URL: http://${RTX5090_LAN_IP:?set RTX5090_LAN_IP}:18400
      ASSISTANT_GATEWAY_URL: ${ASSISTANT_GATEWAY_URL:-http://orchestrator.lan:3400}

  kyutai-vad-codec:
    <<: *gpu
    image: ${NYRA_KYUTAI_VAD_IMAGE:-nyra/kyutai-vad-codec:local}
    container_name: nyra-kyutai-vad-codec-3060
    network_mode: host
    environment:
      NVIDIA_VISIBLE_DEVICES: ${NVIDIA_VISIBLE_DEVICES:-0}
      BIND_ADDR: ${RTX3060_LAN_IP:?set RTX3060_LAN_IP}
      HTTP_PORT: "18100"
      MODEL_DIR: /models/kyutai
      CACHE_DIR: /cache
      PRECISION: int8
      AUDIO_FRAME_MS: "10"
      PRE_ROLL_MS: "120"
      HANGOVER_MS: "160"
    volumes:
      - ${UNMUTE_MODEL_VOLUME:-/srv/nyra/models/kyutai}:/models/kyutai:ro
      - ${UNMUTE_CACHE_VOLUME:-/srv/nyra/cache/kyutai}:/cache

  kyutai-fallback-decode:
    <<: *gpu
    image: ${NYRA_KYUTAI_DECODE_IMAGE:-nyra/kyutai-decode:local}
    container_name: nyra-kyutai-fallback-decode-3060
    network_mode: host
    environment:
      NVIDIA_VISIBLE_DEVICES: ${NVIDIA_VISIBLE_DEVICES:-0}
      BIND_ADDR: ${RTX3060_LAN_IP:?set RTX3060_LAN_IP}
      WS_PORT: "18120"
      MODEL_DIR: /models/kyutai
      PRECISION: int8
      MAX_ACTIVE_STREAMS: "1"
    volumes:
      - ${UNMUTE_MODEL_VOLUME:-/srv/nyra/models/kyutai}:/models/kyutai:ro
