# ============================================================================
# Worker-3090 Environment Variables
# ============================================================================
# DO NOT COMMIT THIS FILE WITH REAL VALUES
# Copy to .env and fill in with actual values from Infisical

# ============================================================================
# Worker Configuration
# ============================================================================
WORKER_ID=worker-3090
WORKER_TYPE=gpu
GPU_MODEL=RTX-3090-Ti
GPU_VRAM=24GB
HOSTNAME=worker-3090

# ============================================================================
# Ollama Configuration
# ============================================================================
OLLAMA_PORT=11434
OLLAMA_HOST=0.0.0.0:11434
OLLAMA_MODELS=/root/.ollama/models
OLLAMA_DEBUG=1
OLLAMA_NUM_PARALLEL=4
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_GPU=35
OLLAMA_FLASH_ATTENTION=1
OLLAMA_MODELS_PATH=./data/ollama-models

# ============================================================================
# CUDA Configuration
# ============================================================================
CUDA_VERSION=12.4
CUDA_VISIBLE_DEVICES=0
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ============================================================================
# Infisical Configuration
# ============================================================================
INFISICAL_PROJECT_ID=8374cea9-e5e8-4050-bda4-b91f25ab30ef
INFISICAL_ENV=dev
INFISICAL_PATH=/worker-3090
# Get token from: https://app.infisical.com/project/{PROJECT_ID}/settings/tokens
INFISICAL_TOKEN=

# ============================================================================
# Secrets (Pulled from Infisical)
# ============================================================================
# These are pulled automatically by setup script
TAILSCALE_KEY=
GPU_WORKER_ID=
NEXUS_ROUTER_URL=http://nexus-router:6000
GRAFANA_API_KEY=
LOKI_URL=http://loki:3100

# ============================================================================
# Monitoring Configuration
# ============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3005
LOKI_PORT=3100
NODE_EXPORTER_PORT=9100
NVIDIA_EXPORTER_PORT=9835

# ============================================================================
# Model Configuration
# ============================================================================
PRIMARY_MODEL=llama3.1:70b
SECONDARY_MODEL=mistral-large:123b

# Model sizes (for documentation)
PRIMARY_MODEL_SIZE=40GB
SECONDARY_MODEL_SIZE=70GB
PRIMARY_MODEL_VRAM=24GB
SECONDARY_MODEL_VRAM=24GB

# ============================================================================
# Tailscale Configuration
# ============================================================================
TAILSCALE_HOSTNAME=worker-3090
TAILSCALE_AUTH_KEY=
TAILSCALE_TAGS=tag:gpu,tag:worker,tag:llm

# ============================================================================
# Cloudflared Tunnel Configuration
# ============================================================================
CLOUDFLARED_TUNNEL_ID=
CLOUDFLARED_TUNNEL_TOKEN=
CLOUDFLARED_TUNNEL_NAME=worker-3090-tunnel

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=info
LOG_MAX_SIZE=50m
LOG_MAX_FILES=5
LOG_PATH=./logs

# ============================================================================
# Health Check Configuration
# ============================================================================
HEALTH_CHECK_INTERVAL=60
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=60

# ============================================================================
# Performance Configuration
# ============================================================================
# CPU cores to allocate
CPU_LIMIT=16
# RAM to allocate (GB)
MEMORY_LIMIT=32G
# GPU memory fraction (0.0-1.0)
GPU_MEMORY_FRACTION=0.95

# ============================================================================
# Network Configuration
# ============================================================================
# Docker network name
NETWORK_NAME=nyra-worker-3090
# Docker network driver
NETWORK_DRIVER=bridge
# Docker network subnet (optional)
# NETWORK_SUBNET=172.28.0.0/16

# ============================================================================
# Docker Configuration
# ============================================================================
COMPOSE_PROJECT_NAME=worker-3090
COMPOSE_FILE=docker-compose.worker-3090.yml
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# ============================================================================
# Backup Configuration
# ============================================================================
BACKUP_PATH=D:\Backups\worker-3090
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * * # Daily at 2 AM

# ============================================================================
# Project Nyra Configuration
# ============================================================================
PROJECT_NAME=project-nyra
PROJECT_ENV=production
PROJECT_REGION=us-east-1

# ============================================================================
# Integration Endpoints
# ============================================================================
# Nexus Router
NEXUS_API_URL=${NEXUS_ROUTER_URL}/api
NEXUS_METRICS_URL=${NEXUS_ROUTER_URL}/metrics

# TwentyCRM
TWENTYCRM_URL=http://twentycrm:3000
TWENTYCRM_API_KEY=

# Dify Chat
DIFY_URL=http://dify:3001
DIFY_API_KEY=

# n8n Workflows
N8N_URL=http://n8n:5678
N8N_API_KEY=

# ============================================================================
# Observability
# ============================================================================
# Prometheus
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_RETENTION=30d

# Grafana
GRAFANA_URL=http://grafana:3005
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Loki
LOKI_RETENTION_PERIOD=30d
LOKI_INGESTION_RATE_MB=50

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_GPU_METRICS=true
ENABLE_LOG_SHIPPING=true
ENABLE_HEALTH_MONITOR=true
ENABLE_CLOUDFLARED=false
ENABLE_TAILSCALE=true

# ============================================================================
# Development Settings (disable in production)
# ============================================================================
DEBUG=false
VERBOSE_LOGGING=false
ENABLE_PROFILING=false
ENABLE_TRACING=false
