# Example environment for the RTX 3090 Ti worker

# The model to load on this worker.
# Recommended default for the RTX 3090 Ti: DeepSeek R1 Distill (Qwen 14B).
MODEL_NAME=deepseek-ai/DeepSeek-R1-Distill-Qwen-14B

# Ports exposed on the host
VLLM_PORT=8000      # OpenAI‑compatible inference endpoint
LM_CACHE_PORT=9000  # LMCache server
REDIS_PORT=6379     # Redis backend

# GPU utilisation and context tuning
GPU_MEMORY_UTIL=0.88  # Fraction of VRAM vLLM can allocate
MAX_MODEL_LEN=16384    # Maximum sequence length
TP_SIZE=1              # Tensor parallelism (single GPU)

# LMCache tuning
LMCACHE_CHUNK_SIZE=256

# Feel free to adjust these values.  Higher `GPU_MEMORY_UTIL` yields faster
# throughput but may risk OOM.  Increase `MAX_MODEL_LEN` if your model
# supports longer contexts and your GPU has enough memory.