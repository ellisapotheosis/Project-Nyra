# Example environment for the RTX 5090 worker

# The Hugging Face model to load.
# Recommended default for the RTX 5090: DeepSeek R1 Distill (Qwen 32B).
# (You can swap to any other HF model that vLLM supports.)
MODEL_NAME=deepseek-ai/DeepSeek-R1-Distill-Qwen-32B

# Ports exposed on the host
VLLM_PORT=8000      # OpenAI‑compatible inference endpoint
LM_CACHE_PORT=9000  # LMCache server
REDIS_PORT=6379     # Redis backend for LMCache

# GPU utilisation and context size tuning
GPU_MEMORY_UTIL=0.90  # Fraction of VRAM vLLM can use (0.70–0.95)
MAX_MODEL_LEN=32768    # Maximum sequence length (tokens)
TP_SIZE=1              # Tensor parallelism (1 GPU only)

# LMCache tuning
LMCACHE_CHUNK_SIZE=256  # Controls granularity of cached key/value pairs

# Feel free to add additional environment variables here to
# customise your deployment.  When editing, remove the comments on
# the right (everything after the #).