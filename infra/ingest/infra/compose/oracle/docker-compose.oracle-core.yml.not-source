version: '3.8'

# Oracle Core Services

services:
  postgres-twenty:
    image: postgres:15-alpine
    environment:
      - POSTGRES_DB=twenty
      - POSTGRES_USER=twenty
      - POSTGRES_PASSWORD=${TWENTY_DB_PASSWORD}
    volumes:
      - /data/nyra/postgres/twenty:/var/lib/postgresql/data
    networks:
      - oracle-net

  postgres-nyra-ai:
    image: ruvnet/ruvector-postgres:latest
    environment:
      - POSTGRES_USER=nyra
      - POSTGRES_PASSWORD=${NYRA_AI_DB_PASSWORD}
      - POSTGRES_DB=nyra_ai
    volumes:
      - /data/nyra/postgres/nyra-ai:/var/lib/postgresql/data
      - ../../configs/ruvector/init-db.sql:/docker-entrypoint-initdb.d/01-init.sql:ro
    networks:
      - oracle-net

  postgres-letta:
    image: postgres:15-alpine
    environment:
      - POSTGRES_DB=letta
      - POSTGRES_USER=letta
      - POSTGRES_PASSWORD=${LETTA_DB_PASSWORD}
    volumes:
      - /data/nyra/postgres/letta:/var/lib/postgresql/data
    networks:
      - oracle-net

  postgres-activepieces:
    image: postgres:15-alpine
    environment:
      - POSTGRES_DB=activepieces
      - POSTGRES_USER=activepieces
      - POSTGRES_PASSWORD=${ACTIVEPIECES_DB_PASSWORD}
    volumes:
      - /data/nyra/postgres/activepieces:/var/lib/postgresql/data
    networks:
      - oracle-net

  postgres-dify:
    image: postgres:15-alpine
    environment:
      - POSTGRES_DB=dify
      - POSTGRES_USER=dify
      - POSTGRES_PASSWORD=${DIFY_DB_PASSWORD}
    volumes:
      - /data/nyra/postgres/dify:/var/lib/postgresql/data
    networks:
      - oracle-net

  falkordb:
    image: falkordb/falkordb:latest
    volumes:
      - /data/nyra/falkordb:/data
    networks:
      - oracle-net

  redis:
    image: redis:7-alpine
    command: redis-server --appendonly yes
    volumes:
      - /data/nyra/redis:/data
    networks:
      - oracle-net

  letta:
    image: ghcr.io/letta-ai/letta:latest
    environment:
      - DATABASE_URL=postgresql://letta:${LETTA_DB_PASSWORD}@postgres-letta:5432/letta
    depends_on:
      - postgres-letta
    networks:
      - oracle-net

  # Monitoring on Oracle
  prometheus:
    image: prom/prometheus:latest
    volumes:
      - /data/nyra/prometheus:/prometheus
      - ../../configs/prometheus.yml:/etc/prometheus/prometheus.yml:ro
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
    networks:
      - oracle-net

  grafana:
    image: grafana/grafana:latest
    environment:
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}
    volumes:
      - /data/nyra/grafana:/var/lib/grafana
    networks:
      - oracle-net

  loki:
    image: grafana/loki:latest
    command: ["-config.file=/etc/loki/local-config.yaml"]
    volumes:
      - /data/nyra/loki:/loki
    networks:
      - oracle-net

networks:
  oracle-net:
    driver: bridge