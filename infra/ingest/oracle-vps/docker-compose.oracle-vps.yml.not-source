services:
  caddy:
    image: caddy:2.9.1
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    depends_on:
      - webapp-backend
      - n8n

  webapp-backend:
    image: ghcr.io/project-nyra/webapp-backend:latest
    restart: unless-stopped
    env_file:
      - ./.env
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:8000/health"]
      interval: 30s
      timeout: 5s
      retries: 5
    expose:
      - "8000"

  n8n:
    image: n8nio/n8n:1.90.2
    restart: unless-stopped
    env_file:
      - ./.env
    volumes:
      - n8n_data:/home/node/.n8n
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:5678/healthz"]
      interval: 30s
      timeout: 5s
      retries: 5
    expose:
      - "5678"

volumes:
  caddy_data:
  caddy_config:
  n8n_data:
