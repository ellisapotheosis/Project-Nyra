# Copy to .env (or inject via Infisical)
POSTGRES_PASSWORD=change-me
POSTGRES_USER=nyra
POSTGRES_DB=nyra_main

RUVECTOR_PG_PASSWORD=change-me
RUVECTOR_DATABASE_URL=postgres://ruvector:change-me@postgres-ruvector:5432/ruvector

# LLM keys (prefer Infisical)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Worker endpoints (choose one approach)
# OpenAI-compatible workers (vLLM, LM Studio, TGI):
WORKER_RTX3060_OPENAI_BASE_URL=http://worker-rtx3060:8000/v1
WORKER_RTX3090TI_OPENAI_BASE_URL=http://worker-rtx3090ti:8000/v1
WORKER_RTX5090_OPENAI_BASE_URL=http://worker-rtx5090:8000/v1

# Or Ollama:
# WORKER_RTX3060_OLLAMA_URL=http://worker-rtx3060:11434
# WORKER_RTX3090TI_OLLAMA_URL=http://worker-rtx3090ti:11434
# WORKER_RTX5090_OLLAMA_URL=http://worker-rtx5090:11434

# Toolkit endpoint (if using Docker Desktop MCP Toolkit instead of included container)
# DOCKER_MCP_TOOLKIT_URL=http://host.docker.internal:8082/mcp
