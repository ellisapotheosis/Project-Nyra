# Bitwarden Secrets Manager MCP Configuration
# Copy this file to .env and fill in your values

# REQUIRED: Bitwarden Secrets Manager Access Token
# Get this from: Bitwarden Web Vault → Organizations → Settings → Machine Accounts
BWS_ACCESS_TOKEN=0.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: PC identifier for distributed setup
NYRA_PC_ID=orchestrator

# Optional: Logging level (debug, info, warn, error)
LOG_LEVEL=info

# Optional: MCP server port
MCP_PORT=8007
