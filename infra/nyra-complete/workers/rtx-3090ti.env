# RTX 3090Ti Worker Configuration
# Code generation and text composition

WORKER_NAME=rtx-3090ti
TAILSCALE_IP=100.x.x.2

# vLLM Configuration
MODEL_NAME=deepseek-coder-16b
MODEL_DTYPE=float16
GPU_MEMORY_UTIL=0.85
MAX_MODEL_LEN=4096
MODEL_CACHE_DIR=/mnt/models-3090ti

# Docker
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
