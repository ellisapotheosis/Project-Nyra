# ==============================================================================
# Project Nyra - Infrastructure Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!
#
# Generated: 2026-01-15
# ==============================================================================

# ==============================================================================
# CORE DATABASE CREDENTIALS
# ==============================================================================

# PostgreSQL (Main Nyra Database)
POSTGRES_DB=nyra
POSTGRES_USER=nyra
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_PORT=5432

# Redis (Cache & Queue)
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
REDIS_PORT=6379
REDIS_MAX_MEMORY=2gb

# MongoDB (Infisical Backend)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
MONGO_PORT=27017

# ==============================================================================
# APPLICATION DATABASES
# ==============================================================================

# Letta PostgreSQL
LETTA_POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
LETTA_POSTGRES_PORT=5433

# Twenty CRM PostgreSQL
TWENTY_POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
TWENTY_POSTGRES_PORT=5435

# Dify PostgreSQL
DIFY_POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DIFY_POSTGRES_PORT=5434

# Neo4j
NEO4J_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# FalkorDB
FALKORDB_PASSWORD=CHANGE_ME_OPTIONAL
FALKORDB_PORT=6380

# ==============================================================================
# SECRET MANAGEMENT (INFISICAL)
# ==============================================================================

# Infisical Server
INFISICAL_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_HEX_STRING
INFISICAL_JWT_SECRET=CHANGE_ME_STRONG_PASSWORD_HERE
INFISICAL_SITE_URL=http://localhost:8080
INFISICAL_PORT=8080
INFISICAL_PROJECT_ID=8374cea9-e5e8-4050-bda4-b91f25ab30ef
INFISICAL_ENV=development

# Infisical Agents (Machine Identities)
# Generate these in Infisical UI: Settings > Machine Identities
INFISICAL_CLIENT_ID_CLAUDE_FLOW=YOUR_CLAUDE_FLOW_CLIENT_ID
INFISICAL_CLIENT_SECRET_CLAUDE_FLOW=YOUR_CLAUDE_FLOW_CLIENT_SECRET
INFISICAL_CLIENT_ID_ARCHON=YOUR_ARCHON_CLIENT_ID
INFISICAL_CLIENT_SECRET_ARCHON=YOUR_ARCHON_CLIENT_SECRET

# ==============================================================================
# AI API KEYS
# ==============================================================================

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-YOUR_API_KEY_HERE

# OpenAI
OPENAI_API_KEY=sk-YOUR_API_KEY_HERE

# OpenRouter
OPENROUTER_API_KEY=sk-or-YOUR_API_KEY_HERE

# Google Gemini
GOOGLE_GEMINI_API_KEY=YOUR_API_KEY_HERE

# ==============================================================================
# CLAUDE FLOW & ARCHON
# ==============================================================================

NODE_ENV=production
NODE_VERSION=20
VOLTA_VERSION=1.1.1
CLAUDE_FLOW_MCP_PORT=3000
CLAUDE_FLOW_METRICS_PORT=9090
CLAUDE_FLOW_LOG_LEVEL=info

PYTHON_ENV=production
PYTHON_VERSION=3.11
ARCHON_API_PORT=8000
ARCHON_API_WORKERS=4
ARCHON_METRICS_PORT=9091
ARCHON_LOG_LEVEL=INFO

# ==============================================================================
# MCP SERVICES
# ==============================================================================

GRAPHITI_PORT=8001
MEM0_PORT=8002
LETTA_PORT=8283

