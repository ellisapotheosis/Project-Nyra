# Nyra Infra env example

# Nexus
NEXUS_JWT_SECRET=
NEXUS_ADMIN_TOKEN=

# LiteLLM/OpenRouter
OPENROUTER_API_KEY=
LITELLM_MASTER_KEY=
LITELLM_DATABASE_URL=sqlite:////data/litellm.sqlite

# Dify
DIFY_SECRET_KEY=
DIFY_ENCRYPTION_KEY=

# Activepieces
ACTIVEPIECES_API_KEY=REPLACE_ME_CHANGE_ME

# n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=REPLACE_ME_CHANGE_ME
N8N_ENCRYPTION_KEY=REPLACE_ME_CHANGE_ME

# Letta
LETTA_API_KEY=REPLACE_ME_CHANGE_ME

# Mem0 (optional - cloud) / local fallback works without it
MEM0_API_KEY=
MEM0_DEFAULT_USER_ID=
MEM0_BASE_URL=https://api.mem0.ai

# GitHub MCP (optional)
GITHUB_TOKEN=

# Docker Hub MCP (optional)
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# Frontend embeds
NEXT_PUBLIC_NEXUS_URL=http://localhost:4000
NEXT_PUBLIC_DIFY_WIDGET_URL=http://localhost/embed.min.js
NEXT_PUBLIC_DIFY_APP_ID=Paste_Your_App_UUID_Here
