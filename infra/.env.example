# Project Nyra - Consolidated Infrastructure .env.example
# Copy to .env and fill in values

# --- CORE DB ---
POSTGRES_DB=nyra
POSTGRES_USER=nyra
POSTGRES_PASSWORD=REQUIRES_USER_VALUE
REDIS_PASSWORD=REQUIRES_USER_VALUE
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=REQUIRES_USER_VALUE

# --- INFISICAL ---
INFISICAL_ENCRYPTION_KEY=REQUIRES_USER_VALUE_32_CHAR_HEX
INFISICAL_JWT_SECRET=REQUIRES_USER_VALUE
INFISICAL_SITE_URL=http://localhost:8080
INFISICAL_PROJECT_ID=8374cea9-e5e8-4050-bda4-b91f25ab30ef

# --- AI & ORCHESTRATION ---
ANTHROPIC_API_KEY=REQUIRES_USER_VALUE
OPENAI_API_KEY=REQUIRES_USER_VALUE
OPENROUTER_API_KEY=REQUIRES_USER_VALUE
GOOGLE_GEMINI_API_KEY=REQUIRES_USER_VALUE
NEXUS_JWT_SECRET=REQUIRES_USER_VALUE
NEXUS_ADMIN_TOKEN=REQUIRES_USER_VALUE
CLAUDE_FLOW_MODE=orchestrator

# --- CRM & MCP ---
TWENTY_PORT=3020
TWENTY_API_KEY=REQUIRES_USER_VALUE
APP_URL_INTERNAL=http://nyra-twenty:3000
APP_URL_PUBLIC=https://twenty.ratehunter.net

# --- MONITORING ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3003
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REQUIRES_USER_VALUE
LOKI_PORT=3100
ALERTMANAGER_PORT=9093
CADVISOR_PORT=8081

# --- COMMUNICATION ---
TWILIO_ACCOUNT_SID=REQUIRES_USER_VALUE
TWILIO_AUTH_TOKEN=REQUIRES_USER_VALUE
SENDGRID_API_KEY=REQUIRES_USER_VALUE

# --- GENERAL ---
TIMEZONE=America/New_York
DOCKER_SUBNET=172.20.0.0/16
