# =============================================================================
# OPTIMAL DEVELOPMENT CONFIGURATION
# =============================================================================
# This file contains optimized environment variable values for local development.
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env in your repo root
# 2. Replace placeholder values with your actual local credentials (if needed)
# 3. For local databases, ensure services are running on localhost
# 4. Never commit .env files with real secrets to git
# 5. Use this for local testing with debug features enabled
#
# KEY DIFFERENCES FROM PRODUCTION:
# - Local service URLs (localhost, 127.0.0.1, 192.168.x.x)
# - Debug logging enabled (verbose output)
# - Less strict security (CORS permissive, debug endpoints open)
# - Mock/sandbox API keys where possible
# - Shorter cache TTLs for rapid iteration
# - Development feature flags enabled
# =============================================================================

# ============================================================================
# NODE & APPLICATION ENVIRONMENT
# ============================================================================
NODE_ENV=development
DEBUG=true
LOG_LEVEL=debug

# Application Name & Version
APP_NAME=Project-Nyra
APP_VERSION=0.1.0

# Application URLs
APP_HOST=localhost
APP_PORT=3000
APP_PROTOCOL=http
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api

# CORS Settings (permissive for development)
CORS_ORIGIN=*
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL (Primary Database)
DATABASE_URL=postgresql://devuser:devpass@localhost:5432/nyra_dev
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=devuser
DB_PASSWORD=devpass
DB_NAME=nyra_dev
DB_SSL=false

# Connection Pool Settings (Development - smaller pools for local work)
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=10000
DB_STATEMENT_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# MongoDB (if using secondary store)
MONGODB_URL=mongodb://localhost:27017/nyra_dev
MONGODB_DATABASE=nyra_dev

# Redis (Cache & Sessions)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=300

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# JWT Configuration
JWT_SECRET=dev-secret-key-for-testing-only-change-in-production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=dev-refresh-secret-only-for-testing
JWT_REFRESH_EXPIRE=30d

# OAuth2 / External Auth (Sandbox/Test Keys)
GOOGLE_CLIENT_ID=mock-google-client-id-dev
GOOGLE_CLIENT_SECRET=mock-google-secret-dev
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

GITHUB_CLIENT_ID=mock-github-client-id-dev
GITHUB_CLIENT_SECRET=mock-github-secret-dev
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Session Configuration
SESSION_SECRET=dev-session-secret-for-local-testing
SESSION_TIMEOUT=3600000
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Password Reset Token (Development)
PASSWORD_RESET_TOKEN_EXPIRE=1h
PASSWORD_RESET_TIMEOUT=3600000

# CORS Preflight
PREFLIGHT_CONTINUE=false

# ============================================================================
# API KEYS & EXTERNAL SERVICES
# ============================================================================
# Email Service (SendGrid/Mailgun - use sandbox)
EMAIL_PROVIDER=mailgun
MAILGUN_API_KEY=mock-key-mg-dev
MAILGUN_DOMAIN=sandbox.mailgun.org
MAILGUN_FROM=dev@sandbox.mailgun.org

# Alternative: SendGrid
SENDGRID_API_KEY=mock-key-sg-dev
SENDGRID_FROM=dev@nyra.local

# SMS Service (Twilio - use test credentials)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Payment Processing (Stripe - use test keys)
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_test_xxxxxxxxxxxx

# Cloud Storage (AWS S3 - use minio for local dev)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=nyra-dev
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_URL_EXPIRY=3600

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
# Logging Configuration
LOG_FORMAT=pretty
LOG_LEVEL=debug
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/app.log
LOG_MAX_FILES=7
LOG_MAX_SIZE=10M

# HTTP Request Logging
HTTP_LOG_ENABLED=true
HTTP_LOG_LEVEL=debug

# Database Query Logging
DB_QUERY_LOG=true
DB_QUERY_SLOW_THRESHOLD=500

# APM / Monitoring (Development defaults - minimal overhead)
APM_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_DEBUG=true
SENTRY_SAMPLE_RATE=0.1

# ============================================================================
# FEATURE FLAGS (Development)
# ============================================================================
# Enable all experimental features in development
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_BETA_API=true
FEATURE_EXPERIMENTAL_UI=true
FEATURE_DEBUG_ENDPOINTS=true
FEATURE_MOCK_DATA=true

# Rate Limiting (Permissive in Dev)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=1000

# ============================================================================
# CACHING & PERFORMANCE
# ============================================================================
# Cache TTLs (Short for rapid iteration)
CACHE_TTL_DEFAULT=300
CACHE_TTL_USER=600
CACHE_TTL_CONTENT=300
CACHE_TTL_AUTH=60

# Query Result Caching
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL=300

# Static Asset Caching
STATIC_CACHE_MAX_AGE=0

# ============================================================================
# FILE UPLOAD & STORAGE
# ============================================================================
# Upload Configuration
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx
STORAGE_TYPE=local

# ============================================================================
# WORKER & JOB QUEUE
# ============================================================================
# Bull / Job Queue (Redis-backed)
QUEUE_REDIS_URL=redis://localhost:6379
QUEUE_CONCURRENCY=5
QUEUE_PROCESSING_DELAY=1000
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_DELAY=5000

# Background Jobs
ENABLE_JOB_QUEUE=true
JOB_QUEUE_TYPE=bull

# ============================================================================
# THIRD-PARTY INTEGRATIONS
# ============================================================================
# Infisical Secret Management (Optional for local dev)
INFISICAL_TOKEN=
INFISICAL_ENVIRONMENT=dev

# GitHub Integration
GITHUB_TOKEN=ghp_mock_token_for_testing
GITHUB_REPO=ruvnet/Project-Nyra
GITHUB_BRANCH=main

# ============================================================================
# DEVELOPMENT TOOLS & DEBUG
# ============================================================================
# Enable Hot Reload
ENABLE_HOT_RELOAD=true

# Debug Express
DEBUG_EXPRESS=true

# GraphQL Playground (if using GraphQL)
GRAPHQL_PLAYGROUND=true
GRAPHQL_INTROSPECTION=true

# Swagger UI / API Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=/api/docs

# Request ID Generation
ENABLE_REQUEST_ID=true
REQUEST_ID_HEADER=X-Request-ID

# ============================================================================
# TESTING CONFIGURATION
# ============================================================================
# Test Database
TEST_DATABASE_URL=postgresql://testuser:testpass@localhost:5432/nyra_test
TEST_REDIS_URL=redis://localhost:6379/1

# Jest/Testing Framework
JEST_TIMEOUT=30000
TEST_ENVIRONMENT=node

# ============================================================================
# COMPLIANCE & SECURITY (Development Relaxed)
# ============================================================================
# GDPR/Privacy
GDPR_ENABLED=false
DATA_RETENTION_DAYS=90

# Security Headers (Development - some disabled for testing)
ENABLE_HELMET=true
ENABLE_CSRF_PROTECTION=false
ENABLE_HSTS=false

# IP Whitelisting (Development - disabled)
IP_WHITELIST_ENABLED=false

# =============================================================================
# END OF DEVELOPMENT CONFIGURATION
# =============================================================================
# Remember: NEVER commit this file with real secrets to version control.
# Use .gitignore to exclude .env files from commits.
# For team development, use Infisical or similar secret management.
# =============================================================================
