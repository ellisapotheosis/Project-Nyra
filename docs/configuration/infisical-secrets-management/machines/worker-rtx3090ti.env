# ==============================================================================
# MACHINE-SPECIFIC VARIABLES: worker-rtx3090ti
# Infisical Path: /machines/worker-rtx3090ti
# ==============================================================================
# This file contains ONLY machine-specific variables for PC4 (RTX 3090 Ti worker).
# Shared variables (API keys, database passwords) are in /shared
# ==============================================================================

# Machine Identity
MACHINE_HOSTNAME=TO_BE_COLLECTED
MACHINE_ROLE=worker-rtx3090ti
MACHINE_PURPOSE=Secondary GPU worker for analysis and medium-large models
MACHINE_SPECIALIZATION=analysis

# Hardware Specs
MACHINE_CPU=TO_BE_DETERMINED
MACHINE_RAM_GB=64
MACHINE_OS=Windows 11 Pro / Linux

# Network Configuration (TO_BE_COLLECTED)
MACHINE_IP_ETHERNET=TO_BE_COLLECTED
MACHINE_IP_TAILSCALE=TO_BE_COLLECTED
MACHINE_MAC_ETHERNET=TO_BE_COLLECTED
TAILSCALE_HOSTNAME=worker-3090
TAILSCALE_FQDN=worker-3090.tail558973.ts.net
TAILSCALE_DOMAIN=tail558973.ts.net

# PC-level aliases for MASTER-ENV-VARS schema (fill once data is known)
PC_NAME=worker-rtx3090ti
PC_ROLE=worker
LAN_IP=TO_BE_COLLECTED
WAN_IP=TO_BE_SET
TAILSCALE_IP=TO_BE_COLLECTED
MAC_ETHERNET=TO_BE_COLLECTED
MAC_WIFI=TO_BE_COLLECTED
GPU_MODEL=RTX_3090_Ti
GPU_VRAM_MB=24576
GPU_COMPUTE_CAPABILITY=8.6

# GPU Configuration
MACHINE_GPU_TYPE=rtx_3090ti
MACHINE_GPU_NAME=NVIDIA GeForce RTX 3090 Ti
MACHINE_GPU_VRAM_GB=24
MACHINE_HAS_GPU=true
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics

# Service Bindings (Worker-Specific)
CLAUDE_FLOW_MODE=worker
OLLAMA_HOST=0.0.0.0
OLLAMA_PORT=11434
OLLAMA_BIND=0.0.0.0:11434

# Ollama Configuration (Medium-Large Models)
OLLAMA_MODELS=llama3.1:70b-instruct-q4_K_M,mistral-large:123b-instruct-2407-q4_K_M,qwen2.5:72b-instruct-q4_K_M
OLLAMA_GPU_LAYERS=50
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=2

# Worker Endpoints (for Nexus Router)
WORKER_3090_URL=http://TO_BE_COLLECTED:11434
WORKER_3090_MODELS=llama3.1:70b-instruct-q4_K_M,mistral-large:123b-instruct-2407-q4_K_M,qwen2.5:72b-instruct-q4_K_M
WORKER_3090_PRIMARY_USE=analysis
WORKER_3090_MAX_CONCURRENT=2
WORKER_3090_PRIORITY=2
WORKER_3090_SPECIALIZATION=analysis

# vLLM Configuration (Production Inference)
VLLM_ENABLED=true
VLLM_PORT=8001
VLLM_BIND=0.0.0.0:8001
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_MODEL_LEN=32768
VLLM_TENSOR_PARALLEL_SIZE=1

# Orchestrator Connection
NEXUS_ROUTER_URL=http://100.115.69.115:7000
ORCHESTRATOR_URL=http://100.115.69.115:8010
CLAUDE_FLOW_ORCHESTRATOR=http://100.115.69.115:9000

# RuVector Distributed Peer
RUVECTOR_ENABLED=true
RUVECTOR_MODE=peer
RUVECTOR_PORT=7890
RUVECTOR_PEER_ID=worker-3090
RUVECTOR_LEADER=100.115.69.115:7000

# Cloudflare Tunnel Token (PC4-specific)
CLOUDFLARE_TUNNEL_TOKEN_WORKER_RTX3090TI=TO_BE_SET
CLOUDFLARE_TUNNEL_NAME=worker-3090
CLOUDFLARE_TUNNEL_LOGLEVEL=info
CLOUDFLARE_TUNNEL_METRICS=0.0.0.0:9126

# Docker Network
DOCKER_SUBNET_RTX3090=172.24.0.0/16

# Development UI Ports
WORKER_RTX3090_DEV_UI_PORT=8093
WORKER_RTX3090_GPU_MONITOR_PORT=9838
WORKER_RTX3090_VSCODE_PORT=8446
WORKER_RTX3090_MLFLOW_PORT=5002
WORKER_RTX3090_JUPYTER_PORT=8891

# Monitoring
PROMETHEUS_NODE_EXPORTER_PORT=9100
NVIDIA_DCGM_EXPORTER_PORT=9400
PROMETHEUS_REMOTE_WRITE_URL=http://100.115.69.115:9090/api/v1/write

# Resource Limits (24GB VRAM, 64GB RAM)
MAX_CONCURRENT_REQUESTS=2
MAX_CONTEXT_LENGTH=32768
OLLAMA_KEEP_ALIVE=5m
