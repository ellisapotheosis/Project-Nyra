# ==============================================================================
# MACHINE-SPECIFIC VARIABLES: worker-rtx5090
# Infisical Path: /machines/worker-rtx5090
# ==============================================================================
# This file contains ONLY machine-specific variables for PC3 (RTX 5090 worker).
# Shared variables (API keys, database passwords) are in /shared
# ==============================================================================

# Machine Identity
MACHINE_HOSTNAME=TO_BE_COLLECTED
MACHINE_ROLE=worker-rtx5090
MACHINE_PURPOSE=Primary GPU worker for large model reasoning and production LLMs
MACHINE_SPECIALIZATION=reasoning

# Hardware Specs
MACHINE_CPU=TO_BE_DETERMINED
MACHINE_RAM_GB=64
MACHINE_OS=Windows 11 Pro / Linux

# Network Configuration (TO BE COLLECTED)
MACHINE_IP_ETHERNET=TO_BE_COLLECTED
MACHINE_IP_TAILSCALE=TO_BE_COLLECTED
MACHINE_MAC_ETHERNET=TO_BE_COLLECTED
TAILSCALE_HOSTNAME=worker-5090
TAILSCALE_FQDN=worker-5090.tail558973.ts.net
TAILSCALE_DOMAIN=tail558973.ts.net

# PC-level aliases for MASTER-ENV-VARS schema (fill once data is known)
PC_NAME=worker-rtx5090
PC_ROLE=worker
LAN_IP=TO_BE_COLLECTED
WAN_IP=TO_BE_SET
TAILSCALE_IP=TO_BE_COLLECTED
MAC_ETHERNET=TO_BE_COLLECTED
MAC_WIFI=TO_BE_COLLECTED
GPU_MODEL=RTX_5090
GPU_VRAM_MB=32768
GPU_COMPUTE_CAPABILITY=9.0

# GPU Configuration
MACHINE_GPU_TYPE=rtx_5090
MACHINE_GPU_NAME=NVIDIA GeForce RTX 5090
MACHINE_GPU_VRAM_GB=32
MACHINE_HAS_GPU=true
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics

# Service Bindings (Worker-Specific)
CLAUDE_FLOW_MODE=worker
OLLAMA_HOST=0.0.0.0
OLLAMA_PORT=11434
OLLAMA_BIND=0.0.0.0:11434

# Ollama Configuration (Large Models)
OLLAMA_MODELS=deepseek-r1:236b-q4_K_M,qwen2.5:72b-instruct-q8_0,llama3.1:70b-instruct-q4_K_M
OLLAMA_GPU_LAYERS=80
OLLAMA_NUM_PARALLEL=3
OLLAMA_MAX_LOADED_MODELS=2

# Worker Endpoints (for Nexus Router)
WORKER_5090_URL=http://TO_BE_COLLECTED:11434
WORKER_5090_MODELS=deepseek-r1:236b-q4_K_M,qwen2.5:72b-instruct-q8_0,llama3.1:70b-instruct-q4_K_M
WORKER_5090_PRIMARY_USE=reasoning
WORKER_5090_MAX_CONCURRENT=3
WORKER_5090_PRIORITY=1
WORKER_5090_SPECIALIZATION=reasoning

# vLLM Configuration (Production Inference)
VLLM_ENABLED=true
VLLM_PORT=8001
VLLM_BIND=0.0.0.0:8001
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_MODEL_LEN=32768
VLLM_TENSOR_PARALLEL_SIZE=1

# Orchestrator Connection
NEXUS_ROUTER_URL=http://100.115.69.115:7000
ORCHESTRATOR_URL=http://100.115.69.115:8010
CLAUDE_FLOW_ORCHESTRATOR=http://100.115.69.115:9000

# RuVector Distributed Peer
RUVECTOR_ENABLED=true
RUVECTOR_MODE=peer
RUVECTOR_PORT=7890
RUVECTOR_PEER_ID=worker-5090
RUVECTOR_LEADER=100.115.69.115:7000

# Cloudflare Tunnel Token (PC3-specific)
CLOUDFLARE_TUNNEL_TOKEN_WORKER_RTX5090=TO_BE_SET
CLOUDFLARE_TUNNEL_NAME=worker-rtx5090
CLOUDFLARE_TUNNEL_LOGLEVEL=info
CLOUDFLARE_TUNNEL_METRICS=0.0.0.0:9126

# Docker Network
DOCKER_SUBNET_RTX5090=172.23.0.0/16

# Development UI Ports
WORKER_RTX5090_DEV_UI_PORT=8092
WORKER_RTX5090_GPU_MONITOR_PORT=9837
WORKER_RTX5090_VSCODE_PORT=8445
WORKER_RTX5090_MLFLOW_PORT=5001
WORKER_RTX5090_JUPYTER_PORT=8890

# Monitoring
PROMETHEUS_NODE_EXPORTER_PORT=9100
NVIDIA_DCGM_EXPORTER_PORT=9400
PROMETHEUS_REMOTE_WRITE_URL=http://100.115.69.115:9090/api/v1/write

# Resource Limits (32GB VRAM, 64GB RAM)
MAX_CONCURRENT_REQUESTS=3
MAX_CONTEXT_LENGTH=32768
OLLAMA_KEEP_ALIVE=5m

# TensorRT-LLM (Optional, if using)
TENSORRT_LLM_ENABLED=false
TENSORRT_LLM_PORT=8002
