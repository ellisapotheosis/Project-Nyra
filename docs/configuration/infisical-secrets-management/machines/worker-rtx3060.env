# ==============================================================================
# MACHINE-SPECIFIC VARIABLES: worker-rtx3060 (ALIENAPOTHEOSIS)
# Infisical Path: /machines/worker-rtx3060
# ==============================================================================
# This file contains ONLY machine-specific variables for PC2 (RTX 3060 worker).
# Shared variables (API keys, database passwords) are in /shared
# ==============================================================================

# Machine Identity
MACHINE_HOSTNAME=ALIENAPOTHEOSIS
MACHINE_ROLE=worker-rtx3060
MACHINE_PURPOSE=GPU worker for code generation and development LLMs
MACHINE_SPECIALIZATION=code

# Hardware Specs
MACHINE_MODEL=Alienware m15 R7
MACHINE_CPU=Intel/AMD (TO_BE_DETERMINED)
MACHINE_RAM_GB=32
MACHINE_OS=Windows 11 Pro

# Network Configuration (ACTUAL VALUES from machine-info.json)
MACHINE_IP_ETHERNET=169.254.102.76
MACHINE_IP_WIFI=192.168.1.221
MACHINE_IP_TAILSCALE=100.83.23.49
MACHINE_MAC_ETHERNET=04-BF-1B-29-A3-F3
MACHINE_MAC_WIFI=C2-B3-B9-2F-4C-D2
TAILSCALE_HOSTNAME=alienapotheosis
TAILSCALE_FQDN=alienapotheosis.tail558973.ts.net
TAILSCALE_DOMAIN=tail558973.ts.net

# Primary Network Interface (WiFi is active)
PRIMARY_NETWORK_INTERFACE=wifi
PRIMARY_IP=192.168.1.221

# GPU Configuration
MACHINE_GPU_TYPE=rtx_3060
MACHINE_GPU_NAME=NVIDIA GeForce RTX 3060 Laptop GPU
MACHINE_GPU_VRAM_GB=12
MACHINE_HAS_GPU=true
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics

# Service Bindings (Worker-Specific)
CLAUDE_FLOW_MODE=worker
OLLAMA_HOST=0.0.0.0
OLLAMA_PORT=11434
OLLAMA_BIND=0.0.0.0:11434

# Ollama Configuration
OLLAMA_MODELS=codellama:34b-instruct-q8_0,qwen2.5:32b-instruct-q8_0,gemma2:27b-instruct-q8_0
OLLAMA_GPU_LAYERS=35
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=2

# Worker Endpoints (for Nexus Router)
WORKER_3060_URL=http://100.83.23.49:11434
WORKER_3060_MODELS=codellama:34b-instruct-q8_0,qwen2.5:32b-instruct-q8_0,gemma2:27b-instruct-q8_0
WORKER_3060_PRIMARY_USE=code
WORKER_3060_MAX_CONCURRENT=2
WORKER_3060_PRIORITY=3
WORKER_3060_SPECIALIZATION=code

# Orchestrator Connection
NEXUS_ROUTER_URL=http://100.115.69.115:7000
ORCHESTRATOR_URL=http://100.115.69.115:8010
CLAUDE_FLOW_ORCHESTRATOR=http://100.115.69.115:9000

# RuVector Distributed Peer
RUVECTOR_ENABLED=true
RUVECTOR_MODE=peer
RUVECTOR_PORT=7890
RUVECTOR_PEER_ID=worker-3060
RUVECTOR_LEADER=100.115.69.115:7000

# Cloudflare Tunnel Token (PC2-specific)
CLOUDFLARE_TUNNEL_TOKEN_WORKER_RTX3060=TO_BE_SET
CLOUDFLARE_TUNNEL_NAME=worker-rtx3060
CLOUDFLARE_TUNNEL_LOGLEVEL=info
CLOUDFLARE_TUNNEL_METRICS=0.0.0.0:9126

# Docker Network
DOCKER_SUBNET_RTX3060=172.22.0.0/16

# Development UI Ports
WORKER_RTX3060_DEV_UI_PORT=8091
WORKER_RTX3060_GPU_MONITOR_PORT=9836
WORKER_RTX3060_VSCODE_PORT=8444
WORKER_RTX3060_MLFLOW_PORT=5000
WORKER_RTX3060_JUPYTER_PORT=8889

# Monitoring
PROMETHEUS_NODE_EXPORTER_PORT=9100
NVIDIA_DCGM_EXPORTER_PORT=9400
PROMETHEUS_REMOTE_WRITE_URL=http://100.115.69.115:9090/api/v1/write

# Resource Limits (12GB VRAM, 32GB RAM)
MAX_CONCURRENT_REQUESTS=2
MAX_CONTEXT_LENGTH=32768
OLLAMA_KEEP_ALIVE=5m
