# ==============================================================================
# MACHINE-SPECIFIC VARIABLES: orchestrator-mini
# Infisical Path: /machines/orchestrator-mini
# ==============================================================================
# This file contains ONLY machine-specific variables for the orchestrator PC.
# Shared variables (API keys, database passwords) are in /shared
# ==============================================================================

# Machine Identity
MACHINE_HOSTNAME=orchestrator-mini
MACHINE_ROLE=orchestrator
MACHINE_PURPOSE=Primary orchestrator, databases, MCP servers, web services

# Hardware Specs
MACHINE_CPU=Ryzen 7 3700X
MACHINE_CPU_CORES=8
MACHINE_CPU_THREADS=16
MACHINE_RAM_GB=16
MACHINE_STORAGE=1TB NVMe SSD
MACHINE_OS=Windows 11 Pro

# Network Configuration
MACHINE_IP_ETHERNET=192.168.1.100
MACHINE_IP_TAILSCALE=100.115.69.115
MACHINE_MAC_ETHERNET=TO_BE_COLLECTED
TAILSCALE_HOSTNAME=orchestrator-mini
TAILSCALE_FQDN=orchestrator-mini.tail558973.ts.net

# GPU Configuration
MACHINE_GPU_TYPE=none
MACHINE_GPU_VRAM_GB=0
MACHINE_HAS_GPU=false

# Service Bindings (Orchestrator-Specific)
CLAUDE_FLOW_MODE=orchestrator
NEXUS_ROUTER_BIND=0.0.0.0:7000
NEXUS_ROUTER_PORT=7000

# Database Hosting (PC1 hosts all databases)
POSTGRES_BIND=0.0.0.0:5432
POSTGRES_HOST=localhost
REDIS_BIND=0.0.0.0:6379
REDIS_HOST=localhost
FALKORDB_BIND=0.0.0.0:6380
QDRANT_BIND=0.0.0.0:6333

# MCP Servers Hosted on PC1
ARCHON_MCP_BIND=0.0.0.0:8051
BITWARDEN_MCP_BIND=0.0.0.0:4003
INFISICAL_MCP_BIND=0.0.0.0:4002
NEXUS_ROUTER_MCP_BIND=0.0.0.0:4001

# Web Services Hosted on PC1
DIFY_WEB_BIND=0.0.0.0:3002
N8N_WEB_BIND=0.0.0.0:5678
TWENTY_CRM_BIND=0.0.0.0:3020
LETTA_API_BIND=0.0.0.0:8283
GRAFANA_BIND=0.0.0.0:3003
PROMETHEUS_BIND=0.0.0.0:9090

# Memory Systems
RUVECTOR_MODE=coordinator
RUVECTOR_BIND=0.0.0.0:7000
RUVECTOR_DATA_DIR=/mnt/nyra-data/ruvector

# Worker Connections (URLs to reach GPU workers)
GPU_WORKER_3060_URL=http://100.83.23.49:11434
GPU_WORKER_3060_MODELS=codellama:34b-q8,qwen2.5:32b-q8,gemma2:27b
GPU_WORKER_3060_PRIORITY=3
GPU_WORKER_3060_SPECIALIZATION=code

GPU_WORKER_5090_URL=http://worker-5090.tail558973.ts.net:11434
GPU_WORKER_5090_MODELS=deepseek-r1:236b-q4,qwen2.5:72b-q8
GPU_WORKER_5090_PRIORITY=1
GPU_WORKER_5090_SPECIALIZATION=reasoning

GPU_WORKER_3090_URL=http://worker-3090.tail558973.ts.net:11434
GPU_WORKER_3090_MODELS=llama3.1:70b-q4,mistral-large:123b-q4
GPU_WORKER_3090_PRIORITY=2
GPU_WORKER_3090_SPECIALIZATION=analysis

# Cloudflare Tunnel Token (PC1-specific)
CLOUDFLARE_TUNNEL_TOKEN_ORCHESTRATOR=TO_BE_SET

# Docker Network
DOCKER_SUBNET_ORCHESTRATOR=172.20.0.0/16

# Resource Limits (16GB RAM)
MAX_CONCURRENT_CONNECTIONS=50
MAX_DB_CONNECTIONS=100
REDIS_MAX_MEMORY=4GB
POSTGRES_SHARED_BUFFERS=2GB

# Monitoring
PROMETHEUS_NODE_EXPORTER_PORT=9100
PROMETHEUS_RETENTION_DAYS=90

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_DIR=/mnt/nyra-data/backups
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
