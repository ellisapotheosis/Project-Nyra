{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code-config-schema/main/schema.json",
  "env": {
    "CLAUDE_FLOW_AUTO_COMMIT": "true",
    "CLAUDE_FLOW_AUTO_PUSH": "false",
    "CLAUDE_FLOW_HOOKS_ENABLED": "true",
    "CLAUDE_FLOW_TELEMETRY_ENABLED": "true",
    "CLAUDE_FLOW_REMOTE_EXECUTION": "true",
    "CLAUDE_FLOW_GITHUB_INTEGRATION": "true",
    "CLAUDE_FLOW_CHECKPOINT_ENABLED": "true",
    "CLAUDE_FLOW_MEMORY_PERSISTENCE": "true",
    "CLAUDE_FLOW_NEURAL_OPTIMIZATION": "true",
    "CLAUDE_FLOW_AUTO_LEARNING": "true",
    "CLAUDE_FLOW_PERFORMANCE_MODE": "optimized",
    "CLAUDE_FLOW_CACHE_ENABLED": "true",
    "CLAUDE_FLOW_PARALLEL_PROCESSING": "true",
    "CLAUDE_FLOW_AGENT_POOL": "true",
    "NYRA_PROJECT_ROOT": "C:\\Dev\\Projects\\Repos\\Project-Nyra",
    "NYRA_DATA_ROOT": "C:\\Dev\\Projects\\Repos\\Project-Nyra\\data",
    "NYRA_CONFIG_ROOT": "C:\\Dev\\Projects\\Repos\\Project-Nyra\\config",
    "NYRA_GPU_WORKERS": "3",
    "NYRA_ORCHESTRATOR_HOST": "localhost",
    "NYRA_DISTRIBUTED_MODE": "true"
  },
  "performance": {
    "caching": {
      "hooks": {
        "enabled": true,
        "ttl": 300000,
        "maxSize": 1000
      },
      "neural": {
        "enabled": true,
        "ttl": 300000,
        "maxSize": 10000
      },
      "memory": {
        "enabled": true,
        "ttl": 60000,
        "maxSize": 1000
      },
      "vectorSearch": {
        "enabled": true,
        "ttl": 600000,
        "maxSize": 5000
      }
    },
    "parallelization": {
      "enabled": true,
      "maxConcurrent": 20,
      "workerThreads": 8,
      "taskQueue": {
        "size": 200,
        "priorityLevels": 5
      },
      "gpuWorkers": {
        "enabled": true,
        "workers": [
          {
            "name": "worker1-rtx5090",
            "vram": "48GB",
            "role": "reasoning",
            "priority": 1
          },
          {
            "name": "worker2-rtx3090ti",
            "vram": "24GB",
            "role": "analysis",
            "priority": 2
          },
          {
            "name": "worker3-rtx3060",
            "vram": "12GB",
            "role": "coding",
            "priority": 3
          }
        ]
      }
    },
    "batching": {
      "hooks": {
        "enabled": true,
        "size": 10,
        "flushInterval": 100
      },
      "memory": {
        "enabled": true,
        "size": 50,
        "flushInterval": 1000
      },
      "neural": {
        "enabled": true,
        "size": 100,
        "maxWaitTime": 50
      }
    },
    "pooling": {
      "agents": {
        "enabled": true,
        "sizes": {
          "coordinator": { "min": 2, "max": 5 },
          "coder": { "min": 3, "max": 10 },
          "researcher": { "min": 2, "max": 5 },
          "analyst": { "min": 2, "max": 5 },
          "tester": { "min": 2, "max": 5 },
          "reviewer": { "min": 1, "max": 3 }
        },
        "idleTimeout": 300000,
        "recycleAfter": 100,
        "preWarmEnabled": true
      },
      "connections": {
        "database": { "min": 5, "max": 20 },
        "mcp": { "min": 2, "max": 10 },
        "vector": { "min": 3, "max": 15 }
      }
    }
  },
  "checkpoints": {
    "enabled": true,
    "interval": 300,
    "auto_commit": true,
    "commit_message_prefix": "🔄 NYRA Checkpoint:",
    "include_metrics": true,
    "branch_strategy": "checkpoints/{timestamp}",
    "max_checkpoints": 50,
    "compression": true,
    "backup_to_remote": true,
    "cleanup_old": true,
    "retention_days": 30
  },
  "memory": {
    "hierarchy": {
      "l1": {
        "type": "ruvector",
        "path": "${NYRA_DATA_ROOT}/ruvector",
        "enabled": true,
        "quantization": true,
        "hnsw_index": true,
        "cache_size": 10000
      },
      "l2": {
        "type": "agentdb",
        "path": "${NYRA_DATA_ROOT}/agentdb",
        "enabled": true,
        "vector_enabled": true,
        "quantization": true,
        "performance_mode": "fast"
      },
      "l3": {
        "type": "letta",
        "path": "${NYRA_DATA_ROOT}/letta",
        "enabled": true,
        "backend": "sqlite",
        "compression": true,
        "retention_policy": "persistent"
      },
      "l4": {
        "type": "graphiti",
        "path": "${NYRA_DATA_ROOT}/graphiti",
        "enabled": true,
        "temporal_enabled": true,
        "knowledge_graph": true
      },
      "l5": {
        "type": "mem0",
        "enabled": true,
        "personalization": true,
        "context_aware": true,
        "learning_enabled": true
      }
    },
    "auto_persist": true,
    "compression": true,
    "sync_interval": 60,
    "namespaces": [
      "swarm",
      "tasks",
      "patterns",
      "errors",
      "optimizations",
      "agents",
      "checkpoints",
      "metrics",
      "learnings"
    ],
    "retention_days": 90,
    "backup_to_github": true,
    "optimization": {
      "writeBatch": true,
      "readCache": true,
      "compressionThreshold": 1024,
      "indexing": true,
      "prefetch": true
    }
  },
  "neural": {
    "auto_optimize": true,
    "optimization_triggers": [
      "error",
      "success",
      "pattern",
      "performance",
      "user_feedback"
    ],
    "models": {
      "task_predictor": {
        "enabled": true,
        "learning_rate": 0.001,
        "update_frequency": 100,
        "preload": true,
        "cache": true,
        "gpu_accelerated": true
      },
      "error_preventer": {
        "enabled": true,
        "threshold": 0.85,
        "block_risky_operations": true,
        "preload": true,
        "cache": true,
        "gpu_accelerated": true
      },
      "performance_optimizer": {
        "enabled": true,
        "target_metrics": ["speed", "accuracy", "efficiency", "cost"],
        "auto_tune": true,
        "preload": true,
        "cache": true,
        "gpu_accelerated": true
      },
      "pattern_recognizer": {
        "enabled": true,
        "learning_enabled": true,
        "cache": true,
        "gpu_accelerated": false
      }
    },
    "wasm": {
      "enabled": true,
      "simd": true,
      "threads": 8,
      "memoryPages": 512,
      "optimization_level": 3
    },
    "distributed_training": {
      "enabled": true,
      "workers": 3,
      "sync_strategy": "async",
      "gradient_accumulation": 4
    }
  },
  "permissions": {
    "allow": [
      "Bash(npx claude-flow *)",
      "Bash(npx ruv-swarm *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(pnpm *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Bash(git tag *)",
      "Bash(git config *)",
      "Bash(gh *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(node *)",
      "Bash(python *)",
      "Bash(which *)",
      "Bash(where *)",
      "Bash(pwd)",
      "Bash(ls *)",
      "Bash(dir *)",
      "Bash(cd *)",
      "Bash(cat *)",
      "Bash(type *)",
      "Bash(echo *)",
      "Bash(jq *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(del /f /s /q C:\\*)",
      "Bash(format *)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(Invoke-Expression *)",
      "Bash(iex *)",
      "Bash(eval *)",
      "Bash(sudo rm *)"
    ]
  },
  "hooks": {
    "_optimization": {
      "batch": true,
      "parallel": true,
      "cache": true,
      "deduplicate": true,
      "gpu_accelerate": true
    },
    "PreToolUse": [
      {
        "matcher": "Bash",
        "batch": true,
        "parallel": true,
        "hooks": [
          {
            "type": "command",
            "command": "npx claude-flow@alpha hooks pre-command --command \"$CLAUDE_COMMAND\" --validate-safety true --prepare-resources true --predict-outcome true --check-patterns true --batch true --cache true"
          },
          {
            "type": "command",
            "command": "npx claude-flow@alpha memory store --key \"command/pre/$CLAUDE_TIMESTAMP\" --value \"$CLAUDE_COMMAND\" --namespace \"commands\" --batch true"
          },
          {
            "type": "command",
            "command": "npx claude-flow@alpha neural predict --model \"error_preventer\" --input \"$CLAUDE_COMMAND\" --block-if-risky true --cache true"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "batch": true,
        "parallel": true,
        "hooks": [
          {
            "type": "command",
            "command": "npx claude-flow@alpha hooks pre-edit --file \"$CLAUDE_EDITED_FILE\" --auto-assign-agents true --load-context true --analyze-impact true --batch true --cache true"
          },
          {
            "type": "command",
            "command": "npx claude-flow@alpha memory store --key \"edit/pre/$CLAUDE_EDITED_FILE\" --value \"$CLAUDE_OPERATION_CONTEXT\" --namespace \"edits\" --batch true"
          },
          {
            "type": "command",
            "command": "npx claude-flow@alpha neural optimize --operation \"file-edit\" --target \"$CLAUDE_EDITED_FILE\" --suggest-improvements true --cache true"
          }
        ]
      },
      {
        "matcher": "Task",
        "batch": true,
        "parallel": false,
        "hooks": [
          {
            "type": "command",
            "command": "npx claude-flow@alpha swarm pre-task --agent-type \"$CLAUDE_AGENT_TYPE\" --prepare-pool true --allocate-resources true --cache true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "batch": true,
        "parallel": true,
        "hooks": [
          {
            "type": "command",
            "command": "npx claude-flow@alpha hooks post-command --command \"$CLAUDE_COMMAND\" --track-metrics true --store-results true --analyze-performance true --batch true"
          },
          {
            "type": "command",
            "command": "npx claude-flow@alpha memory store --key \"command/post/$CLAUDE_TIMESTAMP\" --value \"{\\\"command\\\": \\\"$CLAUDE_COMMAND\\\", \\\"result\\\": \\\"$CLAUDE_RESULT\\\", \\\"duration\\\": $CLAUDE_DURATION}\" --namespace \"commands\" --batch true"
          },
          {
            "type": "command",
            "command": "npx claude-flow@alpha neural train --model \"performance_optimizer\" --data \"{\\\"operation\\\": \\\"bash\\\", \\\"duration\\\": $CLAUDE_DURATION, \\\"success\\\": $CLAUDE_SUCCESS}\" --batch true"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "batch": true,
        "parallel": true,
        "hooks": [
          {
            "type": "command",
            "command": "npx claude-flow@alpha hooks post-edit --file \"$CLAUDE_EDITED_FILE\" --format true --update-memory true --analyze-quality true --batch true"
          },
          {
            "type": "command",
            "command": "npx claude-flow@alpha neural train --model \"pattern_recognizer\" --data \"{\\\"file\\\": \\\"$CLAUDE_EDITED_FILE\\\", \\\"operation\\\": \\\"edit\\\"}\" --batch true"
          }
        ]
      },
      {
        "matcher": "Task",
        "batch": true,
        "parallel": false,
        "hooks": [
          {
            "type": "command",
            "command": "npx claude-flow@alpha swarm post-task --agent-id \"$CLAUDE_AGENT_ID\" --collect-metrics true --update-pool true --cache true"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -c 'echo \"🔄 NYRA PreCompact Guidance:\"; echo \"📋 Review Project-Nyra configuration:\"; echo \"   • 54+ available agents in .claude/agents/\"; echo \"   • Swarm coordination (hierarchical, mesh, adaptive)\"; echo \"   • SPARC methodology with 13 development modes\"; echo \"   • Memory hierarchy: RuVector → AgentDB → Letta → Graphiti → Mem0\"; echo \"   • 3 GPU workers for distributed processing\"; echo \"   • Neural optimization with WASM acceleration\"; echo \"✅ Ready for compact operation\"'"
          }
        ]
      },
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -c 'echo \"🔄 NYRA Auto-Compact (Context Full):\"; echo \"📋 Ensure understanding of:\"; echo \"   • All agents and concurrent execution patterns\"; echo \"   • Batchtools optimization (300% performance gain)\"; echo \"   • GPU worker allocation strategies\"; echo \"   • Memory hierarchy for optimal performance\"; echo \"⚡ GOLDEN RULE: Batch all operations in single messages\"; echo \"✅ Auto-compacting with full context\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx claude-flow@alpha hooks session-end --generate-summary true --persist-state true --export-metrics true --backup-memory true --optimize-models true --sync-github true"
          }
        ]
      }
    ]
  },
  "github": {
    "owner": "ellisapotheosis",
    "repo": "Project-Nyra",
    "branch": "main",
    "checkpoint_branch": "checkpoints",
    "memory_backup_gists": true,
    "auto_issue_on_error": true,
    "pr_on_major_improvement": false,
    "sync_learnings": true,
    "commit_signature": true
  },
  "optimization": {
    "continuous_improvement": true,
    "performance_targets": {
      "command_execution": "< 100ms overhead",
      "memory_operations": "< 20ms",
      "neural_predictions": "< 10ms",
      "hook_execution": "< 50ms",
      "agent_spawn": "< 100ms",
      "vector_search": "< 5ms"
    },
    "auto_tune_parameters": true,
    "share_anonymized_patterns": false,
    "monitoring": {
      "enabled": true,
      "metrics": [
        "latency",
        "throughput",
        "errors",
        "cache_hits",
        "gpu_utilization",
        "memory_usage",
        "agent_pool_efficiency"
      ],
      "alert_thresholds": {
        "latency": 200,
        "error_rate": 0.05,
        "cache_miss_rate": 0.3,
        "gpu_utilization": 0.9
      },
      "export_to": "C:\\Dev\\Projects\\Repos\\Project-Nyra\\metrics"
    }
  },
  "includeCoAuthoredBy": true,
  "enabledMcpjsonServers": [
    "claude-flow",
    "ruv-swarm",
    "agentdb",
    "ruvector",
    "letta",
    "flow-nexus"
  ],
  "statusLine": {
    "type": "command",
    "command": "npx claude-flow@alpha status --format compact --show gpu,memory,agents,cache"
  },
  "projectInfo": {
    "name": "Project-Nyra",
    "description": "AI Development Stack with Distributed GPU Computing",
    "version": "1.0.0",
    "infrastructure": {
      "orchestrator": "Mini PC (Command Center)",
      "workers": [
        "RTX 5090 (48GB) - Reasoning",
        "RTX 3090 Ti (24GB) - Analysis",
        "RTX 3060 (12GB) - Coding"
      ],
      "networking": "Tailscale Mesh + Cloudflared Tunnels"
    }
  }
}
