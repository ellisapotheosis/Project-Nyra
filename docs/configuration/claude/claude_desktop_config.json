{
  "$schema": "https://raw.githubusercontent.com/anthropics/anthropic-mcp-config-schema/main/schema.json",
  "globalSettings": {
    "timeout": 30000,
    "retries": 3,
    "caching": {
      "enabled": true,
      "ttl": 3600,
      "maxSize": 1000
    },
    "rateLimit": {
      "requestsPerMinute": 60,
      "burstSize": 10
    },
    "logging": {
      "level": "info",
      "format": "json",
      "output": "C:\\Users\\edane\\AppData\\Roaming\\Claude\\logs\\mcp-servers.log"
    }
  },
  "mcpServers": {
    "infisical-mcp": {
      "command": "cmd",
      "args": [
        "/c",
        "docker",
        "run",
        "--rm",
        "-i",
        "--network=host",
        "-e",
        "INFISICAL_PROJECT_ID",
        "-e",
        "INFISICAL_CLIENT_ID",
        "-e",
        "INFISICAL_CLIENT_SECRET",
        "-e",
        "INFISICAL_ENVIRONMENT=dev",
        "ghcr.io/infisical/mcp-server:latest"
      ],
      "env": {
        "INFISICAL_PROJECT_ID": "${INFISICAL_PROJECT_ID}",
        "INFISICAL_CLIENT_ID": "${INFISICAL_CLIENT_ID}",
        "INFISICAL_CLIENT_SECRET": "${INFISICAL_CLIENT_SECRET}",
        "INFISICAL_ENVIRONMENT": "dev"
      },
      "priority": "critical",
      "description": "Centralized secret management and environment variable injection"
    },
    "archon-os": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "archon-os@alpha",
        "mcp",
        "start"
      ],
      "env": {
        "CLAUDE_FLOW_MEMORY_ENABLED": "true",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_NEURAL_ENABLED": "true",
        "CLAUDE_FLOW_GITHUB_ENABLED": "true",
        "CLAUDE_FLOW_AUTO_SPAWN": "true",
        "CLAUDE_FLOW_SESSION_MEMORY": "true",
        "CLAUDE_FLOW_MAX_AGENTS": "20",
        "CLAUDE_FLOW_CHECKPOINTS_ENABLED": "true",
        "CLAUDE_FLOW_PERFORMANCE_MODE": "optimized",
        "CLAUDE_FLOW_CACHE_ENABLED": "true",
        "CLAUDE_FLOW_PARALLEL_PROCESSING": "true",
        "CLAUDE_FLOW_AGENT_POOL": "true",
        "NODE_ENV": "development"
      },
      "priority": "critical",
      "description": "Main orchestration framework with agent coordination and memory"
    },
    "ruv-swarm": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "ruv-swarm@latest",
        "mcp",
        "start"
      ],
      "env": {
        "RUV_SWARM_TOPOLOGY": "adaptive",
        "RUV_SWARM_MAX_AGENTS": "20",
        "RUV_SWARM_WASM_ENABLED": "true",
        "RUV_SWARM_NEURAL_ENABLED": "true",
        "RUV_SWARM_DAA_ENABLED": "true",
        "RUV_SWARM_MEMORY_MODE": "persistent",
        "RUV_SWARM_GPU_WORKERS": "3",
        "RUV_SWARM_DISTRIBUTED": "true",
        "NODE_ENV": "development"
      },
      "priority": "high",
      "description": "Distributed swarm coordination with adaptive topology"
    },
    "metamcp": {
      "command": "cmd",
      "args": [
        "/c",
        "docker",
        "run",
        "--rm",
        "-i",
        "--network=host",
        "-v",
        "C:\\Dev\\Projects\\Repos\\Project-Nyra\\config\\metamcp:/config",
        "-e",
        "METAMCP_CONFIG_PATH=/config/metamcp-config.json",
        "-e",
        "METAMCP_ROUTING_MODE=token_cost",
        "-e",
        "METAMCP_LOG_LEVEL=info",
        "ghcr.io/metamcp/mcp-proxy:latest"
      ],
      "env": {
        "METAMCP_CONFIG_PATH": "/config/metamcp-config.json",
        "METAMCP_ROUTING_MODE": "token_cost",
        "METAMCP_LOG_LEVEL": "info",
        "METAMCP_ENABLE_METRICS": "true",
        "METAMCP_ENABLE_CACHE": "true",
        "METAMCP_CACHE_TTL": "3600",
        "METAMCP_COST_OPTIMIZATION": "aggressive"
      },
      "priority": "high",
      "description": "Intelligent MCP proxy with token-cost routing"
    },
    "serenai-mcp": {
      "command": "cmd",
      "args": [
        "/c",
        "docker",
        "run",
        "--rm",
        "-i",
        "--network=host",
        "-e",
        "SERENAI_API_KEY",
        "-e",
        "SERENAI_MODEL=claude-sonnet-4-5",
        "-e",
        "SERENAI_MEMORY_ENABLED=true",
        "-e",
        "SERENAI_CONTEXT_WINDOW=200000",
        "ghcr.io/serenai/mcp-server:latest"
      ],
      "env": {
        "SERENAI_API_KEY": "${SERENAI_API_KEY}",
        "SERENAI_MODEL": "claude-sonnet-4-5",
        "SERENAI_MEMORY_ENABLED": "true",
        "SERENAI_CONTEXT_WINDOW": "200000",
        "SERENAI_MAX_TOKENS": "8192",
        "SERENAI_TEMPERATURE": "0.7"
      },
      "priority": "medium",
      "description": "AI assistant with extended context and memory"
    },
    "archon-mcp": {
      "command": "cmd",
      "args": [
        "/c",
        "docker",
        "compose",
        "-f",
        "C:\\Dev\\Projects\\Repos\\Project-Nyra\\docker\\archon\\docker-compose.yml",
        "run",
        "--rm",
        "archon-mcp"
      ],
      "env": {
        "ARCHON_DB_HOST": "${ARCHON_DB_HOST}",
        "ARCHON_DB_PORT": "${ARCHON_DB_PORT}",
        "ARCHON_DB_NAME": "${ARCHON_DB_NAME}",
        "ARCHON_DB_USER": "${ARCHON_DB_USER}",
        "ARCHON_DB_PASSWORD": "${ARCHON_DB_PASSWORD}",
        "ARCHON_API_URL": "${ARCHON_API_URL}",
        "ARCHON_API_KEY": "${ARCHON_API_KEY}",
        "ARCHON_FRONTEND_URL": "${ARCHON_FRONTEND_URL}",
        "ARCHON_BACKEND_URL": "${ARCHON_BACKEND_URL}",
        "ARCHON_REDIS_URL": "${ARCHON_REDIS_URL}",
        "ARCHON_STORAGE_PATH": "/data/archon",
        "ARCHON_LOG_LEVEL": "info",
        "ARCHON_MULTI_SERVICE_ENABLED": "true"
      },
      "priority": "high",
      "description": "Multi-service orchestration platform"
    },
    "archon-os": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "archon-os@latest",
        "mcp",
        "start"
      ],
      "env": {
        "AGENTIC_FLOW_MAX_AGENTS": "15",
        "AGENTIC_FLOW_TOPOLOGY": "mesh",
        "AGENTIC_FLOW_MEMORY_ENABLED": "true",
        "AGENTIC_FLOW_PARALLEL_EXECUTION": "true",
        "NODE_ENV": "development"
      },
      "priority": "high",
      "description": "Agent workflow orchestration with mesh topology"
    },
    "ruvector": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "ruvector@latest",
        "mcp",
        "start"
      ],
      "env": {
        "ruvector_STORAGE_PATH": "C:\\Dev\\Projects\\Repos\\Project-Nyra\\data\\ruvector",
        "ruvector_VECTOR_ENABLED": "true",
        "ruvector_QUANTIZATION": "true",
        "ruvector_CACHE_ENABLED": "true",
        "ruvector_HNSW_INDEX": "true",
        "ruvector_PERFORMANCE_MODE": "fast",
        "NODE_ENV": "development"
      },
      "priority": "high",
      "description": "150x faster vector database with quantization"
    },
    "ruvector": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "ruvector@latest",
        "mcp",
        "start"
      ],
      "env": {
        "RUVECTOR_STORAGE_PATH": "C:\\Dev\\Projects\\Repos\\Project-Nyra\\data\\ruvector",
        "RUVECTOR_DIMENSION": "1536",
        "RUVECTOR_METRIC": "cosine",
        "RUVECTOR_INDEX_TYPE": "hnsw",
        "RUVECTOR_CACHE_SIZE": "10000",
        "RUVECTOR_QUANTIZATION": "true",
        "NODE_ENV": "development"
      },
      "priority": "high",
      "description": "Fast vector search with HNSW indexing"
    },
    "letta": {
      "command": "cmd",
      "args": [
        "/c",
        "docker",
        "run",
        "--rm",
        "-i",
        "--network=host",
        "-v",
        "C:\\Dev\\Projects\\Repos\\Project-Nyra\\data\\letta:/data",
        "-e",
        "LETTA_STORAGE_PATH=/data",
        "-e",
        "LETTA_MEMORY_BACKEND=sqlite",
        "ghcr.io/letta-ai/letta-mcp:latest"
      ],
      "env": {
        "LETTA_STORAGE_PATH": "/data",
        "LETTA_MEMORY_BACKEND": "sqlite",
        "LETTA_RETENTION_POLICY": "persistent",
        "LETTA_COMPRESSION": "true",
        "LETTA_MAX_MEMORY_SIZE": "10GB"
      },
      "priority": "medium",
      "description": "Agent memory system with persistent storage"
    },
    "letta": {
      "command": "cmd",
      "args": [
        "/c",
        "docker",
        "run",
        "--rm",
        "-i",
        "--network=host",
        "-v",
        "C:\\Dev\\Projects\\Repos\\Project-Nyra\\data\\letta:/data",
        "-e",
        "letta_STORAGE_PATH=/data",
        "-e",
        "letta_NEO4J_ENABLED=true",
        "ghcr.io/letta-ai/letta-mcp:latest"
      ],
      "env": {
        "letta_STORAGE_PATH": "/data",
        "letta_NEO4J_URI": "${NEO4J_URI}",
        "letta_NEO4J_USER": "${NEO4J_USER}",
        "letta_NEO4J_PASSWORD": "${NEO4J_PASSWORD}",
        "letta_TEMPORAL_ENABLED": "true",
        "letta_KNOWLEDGE_GRAPH": "true"
      },
      "priority": "medium",
      "description": "Temporal knowledge graphs with Neo4j"
    },
    "mem0": {
      "command": "cmd",
      "args": [
        "/c",
        "docker",
        "run",
        "--rm",
        "-i",
        "--network=host",
        "-e",
        "MEM0_API_KEY",
        "-e",
        "MEM0_USER_ID",
        "ghcr.io/mem0-ai/mem0-mcp:latest"
      ],
      "env": {
        "MEM0_API_KEY": "${MEM0_API_KEY}",
        "MEM0_USER_ID": "${MEM0_USER_ID}",
        "MEM0_PERSONALIZATION": "true",
        "MEM0_CONTEXT_AWARE": "true",
        "MEM0_LEARNING_ENABLED": "true"
      },
      "priority": "medium",
      "description": "User personalization and context-aware memory"
    },
    "openmemory": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@openmemory/mcp@latest",
        "start"
      ],
      "env": {
        "OPENMEMORY_STORAGE_PATH": "C:\\Dev\\Projects\\Repos\\Project-Nyra\\data\\openmemory",
        "OPENMEMORY_PROFILE_SYNC": "true",
        "OPENMEMORY_CROSS_APP": "true",
        "OPENMEMORY_ENCRYPTION": "true",
        "NODE_ENV": "development"
      },
      "priority": "medium",
      "description": "Cross-app user profiles and memory sync"
    },
    "bitwarden-mcp": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@bitwarden/mcp-server@latest",
        "start"
      ],
      "env": {
        "BW_CLIENTID": "${BW_CLIENTID}",
        "BW_CLIENTSECRET": "${BW_CLIENTSECRET}",
        "BW_PASSWORD": "${BW_PASSWORD}",
        "BW_SESSION": "${BW_SESSION}",
        "BW_URL": "https://vault.bitwarden.com",
        "BW_AUTO_SYNC": "true"
      },
      "priority": "high",
      "description": "Password management and secure credential storage"
    },
    "github-mcp": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-github@latest"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}",
        "GITHUB_OWNER": "ellisapotheosis",
        "GITHUB_REPO": "Project-Nyra",
        "GITHUB_AUTO_PUSH": "false",
        "GITHUB_BRANCH": "main"
      },
      "priority": "high",
      "description": "GitHub integration for repos, PRs, and issues"
    },
    "vscode-mcp": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@vscode/mcp-server@latest",
        "start"
      ],
      "env": {
        "VSCODE_WORKSPACE": "C:\\Dev\\Projects\\Repos\\Project-Nyra",
        "VSCODE_AUTO_SYNC": "true",
        "VSCODE_EXTENSION_SYNC": "true",
        "NODE_ENV": "development"
      },
      "priority": "medium",
      "description": "VS Code workspace integration and extension management"
    },
    "claude-code-dev-kit": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "claude-code-dev-kit@latest",
        "mcp",
        "start"
      ],
      "env": {
        "CCDK_TOOLS_ENABLED": "all",
        "CCDK_SNIPPETS_PATH": "C:\\Dev\\Projects\\Repos\\Project-Nyra\\snippets",
        "CCDK_TEMPLATES_ENABLED": "true",
        "NODE_ENV": "development"
      },
      "priority": "medium",
      "description": "Claude Code development toolkit with templates"
    },
    "nexus-router": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "nexus-router@latest",
        "mcp",
        "start"
      ],
      "env": {
        "NEXUS_ROUTER_STRATEGY": "intelligent",
        "NEXUS_ROUTER_COST_AWARE": "true",
        "NEXUS_ROUTER_LATENCY_THRESHOLD": "100",
        "NEXUS_ROUTER_FALLBACK_ENABLED": "true",
        "NODE_ENV": "development"
      },
      "priority": "high",
      "description": "Intelligent routing with cost and latency optimization"
    },
    "agent-booster": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "agent-booster@latest",
        "mcp",
        "start"
      ],
      "env": {
        "AGENT_BOOSTER_OPTIMIZATION_ENABLED": "true",
        "AGENT_BOOSTER_CACHE_ENABLED": "true",
        "AGENT_BOOSTER_PARALLEL_EXECUTION": "true",
        "AGENT_BOOSTER_WASM_ENABLED": "true",
        "NODE_ENV": "development"
      },
      "priority": "high",
      "description": "Agent performance optimization and acceleration"
    },
    "epic-sdk": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "epic-sdk@latest",
        "mcp",
        "start"
      ],
      "env": {
        "EPIC_SDK_API_KEY": "${EPIC_SDK_API_KEY}",
        "EPIC_SDK_FEATURES_ENABLED": "all",
        "EPIC_SDK_AUTO_UPDATE": "true",
        "NODE_ENV": "development"
      },
      "priority": "medium",
      "description": "Epic SDK development toolkit with full features"
    },
    "flow-nexus": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "flow-nexus@latest",
        "mcp",
        "start"
      ],
      "env": {
        "FLOW_NEXUS_API_KEY": "${FLOW_NEXUS_API_KEY}",
        "FLOW_NEXUS_USER_ID": "${FLOW_NEXUS_USER_ID}",
        "FLOW_NEXUS_CLOUD_ENABLED": "true",
        "FLOW_NEXUS_SANDBOXES_ENABLED": "true",
        "FLOW_NEXUS_NEURAL_ENABLED": "true",
        "FLOW_NEXUS_DISTRIBUTED_TRAINING": "true",
        "NODE_ENV": "development"
      },
      "priority": "high",
      "description": "Cloud execution platform with distributed training"
    },
    "gemini-mcp": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@google/generative-ai-mcp@latest",
        "start"
      ],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}",
        "GEMINI_MODEL": "gemini-2.0-flash-thinking-exp-1219",
        "GEMINI_SAFETY_SETTINGS": "BLOCK_NONE",
        "GEMINI_MAX_TOKENS": "8192",
        "GEMINI_THINKING_MODE": "true",
        "GEMINI_REQUIRE_PERMISSION": "false",
        "GEMINI_AUTO_APPROVE_TOOLS": "true",
        "GEMINI_ALLOW_ALL_OPERATIONS": "true",
        "GEMINI_BYPASS_CONFIRMATIONS": "true",
        "GEMINI_TOOL_USE_UNRESTRICTED": "true"
      },
      "priority": "medium",
      "description": "Google Gemini AI integration with thinking mode (all permissions enabled)"
    }
  },
  "channels": {
    "routing": {
      "strategy": "token_cost",
      "fallback": "metamcp",
      "thresholds": {
        "high_cost": 1000,
        "medium_cost": 500,
        "low_cost": 100
      },
      "preferences": {
        "high_cost_operations": ["archon-os", "serenai-mcp"],
        "medium_cost_operations": ["gemini-mcp", "archon-mcp"],
        "low_cost_operations": ["ruvector", "ruvector", "letta"]
      }
    }
  },
  "integration": {
    "infisical": {
      "auto_inject": true,
      "refresh_interval": 300,
      "fallback_to_env": true
    },
    "metamcp": {
      "proxy_enabled": true,
      "routing_mode": "token_cost",
      "cache_enabled": true
    },
    "github": {
      "auto_commit": false,
      "auto_push": false,
      "checkpoint_enabled": true
    }
  },
  "preferences": {
    "chromeExtensionEnabled": true,
    "experimentalFeatures": {
      "multimodalInput": true,
      "codeExecution": true,
      "extendedContextWindow": true,
      "toolUseOptimization": true,
      "advancedReasoning": true,
      "parallelToolExecution": true,
      "agentPooling": true,
      "neuralOptimization": true
    },
    "performance": {
      "cacheAggressive": true,
      "parallelization": true,
      "compression": true,
      "wasmAcceleration": true
    }
  }
}
