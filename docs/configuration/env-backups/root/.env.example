# ==============================================================================
# PROJECT NYRA - MASTER ENVIRONMENT VARIABLES
# ==============================================================================
# Complete environment configuration for all services
# Updated: 2026-01-13
#
# INSTRUCTIONS:
# 1. Copy this file to .env in the same directory: cp .env.example .env
# 2. Fill in all values marked as REQUIRED
# 3. Generate secrets with: openssl rand -hex 32
# 4. Never commit .env files to git (already in .gitignore)
# 5. For production, use Infisical secrets management (see INFISICAL section)
# 6. Use ./scripts/validate-env.sh to check for missing required variables
#
# ==============================================================================

# ==============================================================================
# INFISICAL - SECRETS MANAGEMENT (Production)
# ==============================================================================
# Infisical integration for centralized secret management across all PCs
# If INFISICAL_TOKEN is set, secrets will be fetched from Infisical
# Otherwise, uses local .env values

INFISICAL_TOKEN=                                    # REQUIRED for production
INFISICAL_PROJECT_ID=                               # REQUIRED for production
INFISICAL_ENVIRONMENT=development                   # Options: development, staging, production
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=                 # Alternative auth method
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=             # Alternative auth method

# ==============================================================================
# DATABASE - PostgreSQL (Shared)
# ==============================================================================
# Shared PostgreSQL database for: Dify, TwentyCRM, Letta, n8n, LiteLLM, Nyra services
# Uses pgvector extension for vector storage

POSTGRES_USER=postgres
POSTGRES_PASSWORD=                                  # REQUIRED - Generate with: openssl rand -hex 32
POSTGRES_PORT=5432

# Legacy individual database passwords (deprecated - use POSTGRES_PASSWORD)
LETTA_POSTGRES_PASSWORD=
TWENTY_POSTGRES_PASSWORD=
DIFY_POSTGRES_PASSWORD=

# Multiple databases auto-created via init script:
# - dify, twenty, letta, n8n, litellm, nyra, activepieces

# ==============================================================================
# REDIS - Caching & Session Store
# ==============================================================================

REDIS_PASSWORD=                                     # REQUIRED - Generate with: openssl rand -hex 32
REDIS_PORT=6380                                    # Using 6380 to avoid conflict with FalkorDB

# ==============================================================================
# GRAPH DATABASE - FalkorDB
# ==============================================================================
# Redis-compatible graph database (alternative to Neo4j)
# Used by letta MCP for relationship tracking

FALKORDB_PASSWORD=                                  # REQUIRED - Generate with: openssl rand -hex 32

# Legacy Neo4j (if still using)
NEO4J_PASSWORD=

# ==============================================================================
# LLM API KEYS
# ==============================================================================

# Anthropic (Claude) - Complex reasoning, code generation
ANTHROPIC_API_KEY=                                  # REQUIRED - Get from: https://console.anthropic.com

# Google (Gemini) - Cost-efficient routine tasks
GOOGLE_API_KEY=                                     # REQUIRED - Get from: https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=                              # Alias for GOOGLE_API_KEY

# OpenRouter - Fallback and alternative models
OPENROUTER_API_KEY=                                 # Optional - Get from: https://openrouter.ai

# Context7 - Enhanced context management (if using)
CONTEXT7_API_KEY=                                   # Optional

# ==============================================================================
# NEXUS ROUTER - Unified MCP + LLM Gateway
# ==============================================================================
# Single entry point for all MCP servers and LLM routing
# Replaces both MetaMCP and LiteLLM with intelligent fuzzy matching

NEXUS_ROUTER_PORT=7000
NEXUS_URL=http://localhost:7000
NEXUS_JWT_SECRET=                                   # REQUIRED - Generate with: openssl rand -hex 32
NEXUS_ADMIN_TOKEN=                                  # REQUIRED - Generate with: openssl rand -hex 32

# ==============================================================================
# LITELLM - LLM Proxy (Legacy - being replaced by Nexus)
# ==============================================================================
# Unified LLM proxy for model routing and cost tracking

PORT_LITELLM=4000
LITELLM_MASTER_KEY=                                 # REQUIRED - Generate with: openssl rand -hex 32

# ==============================================================================
# N8N - WORKFLOW AUTOMATION
# ==============================================================================
# Workflow automation for mortgage drip campaigns

PORT_N8N=5678
N8N_URL=http://localhost:5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=                            # REQUIRED - Strong password recommended
N8N_PASSWORD=                                       # Alias for N8N_BASIC_AUTH_PASSWORD
N8N_ENCRYPTION_KEY=                                 # REQUIRED - Generate with: openssl rand -hex 32
N8N_HOST=localhost

# ==============================================================================
# ACTIVEPIECES - LOW-CODE AUTOMATION
# ==============================================================================
# Alternative workflow automation for message delivery

PORT_ACTIVEPIECES=3002
ACTIVEPIECES_API_KEY=                               # REQUIRED - Generate with: openssl rand -hex 32
AP_ENCRYPTION_KEY=                                  # REQUIRED - Generate with: openssl rand -hex 32
AP_JWT_SECRET=                                      # REQUIRED - Generate with: openssl rand -hex 32

# ==============================================================================
# DIFY - AI CHAT INTERFACE
# ==============================================================================
# AI application builder and chat interface

PORT_DIFY=3001
DIFY_URL=http://localhost:3001
DIFY_SECRET_KEY=                                    # REQUIRED - Generate with: openssl rand -hex 32
DIFY_ENCRYPTION_KEY=                                # REQUIRED - Generate with: openssl rand -hex 32

# ==============================================================================
# TWENTYCRM - CUSTOMER RELATIONSHIP MANAGEMENT
# ==============================================================================
# Open source CRM for borrower/lead management

PORT_TWENTYCRM=3010
TWENTY_CRM_URL=http://localhost:3010
TWENTY_ACCESS_TOKEN_SECRET=                         # REQUIRED - Generate with: openssl rand -hex 32
TWENTY_LOGIN_TOKEN_SECRET=                          # REQUIRED - Generate with: openssl rand -hex 32
TWENTY_REFRESH_TOKEN_SECRET=                        # REQUIRED - Generate with: openssl rand -hex 32
TWENTY_FILE_TOKEN_SECRET=                           # REQUIRED - Generate with: openssl rand -hex 32

# ==============================================================================
# LETTA - MEMORY SERVER
# ==============================================================================
# Stateful memory agent with long-term persistence

PORT_LETTA=8283
LETTA_URL=http://localhost:8283
LETTA_API_KEY=                                      # REQUIRED - Generate with: openssl rand -hex 32
LETTA_SERVER_PASS=                                  # REQUIRED - Strong password recommended

# ==============================================================================
# letta MCP - GRAPH MEMORY
# ==============================================================================
# Temporal graph-based memory with relationship tracking

letta_API_KEY=                                   # Optional - Required for cloud mode
letta_TEMPORAL_TRACKING=true
letta_RELATIONSHIP_INFERENCE=true

# ==============================================================================
# MEM0 - VECTOR MEMORY
# ==============================================================================
# Universal episodic memory management

MEM0_API_KEY=                                       # Optional - Required for cloud mode
MEM0_PORT=8081
MEM0_URL=http://localhost:4321
MEM0_DEFAULT_USER_ID=default
MEM0_BASE_URL=https://api.mem0.ai

# ==============================================================================
# QDRANT - VECTOR DATABASE
# ==============================================================================
# High-performance vector database for embeddings

QDRANT_PORT=6333

# ==============================================================================
# QUOTE ENGINE - MORTGAGE QUOTE GENERATION
# ==============================================================================
# FastAPI service for generating mortgage quotes

QUOTE_ENGINE_PORT=8001
QUOTE_ENGINE_URL=http://localhost:8001
QUOTE_ENGINE_HOST=0.0.0.0
LOG_LEVEL=INFO

# ==============================================================================
# CAMPAIGN ENGINE - DRIP CAMPAIGN ORCHESTRATION
# ==============================================================================
# FastAPI service for 45-day mortgage drip campaigns

CAMPAIGN_ENGINE_PORT=8002
CAMPAIGN_ENGINE_URL=http://localhost:8002
CAMPAIGN_ENGINE_HOST=0.0.0.0

# ==============================================================================
# NYRA ORCHESTRATOR - COMPLIANCE & COORDINATION
# ==============================================================================
# Central orchestration service with compliance validation

NYRA_ORCHESTRATOR_PORT=8003
ORCHESTRATOR_URL=http://localhost:8010
NYRA_ORCHESTRATOR_HOST=0.0.0.0

# ==============================================================================
# TWILIO - SMS/VOICE COMMUNICATION
# ==============================================================================
# Communication platform for SMS, voice calls

TWILIO_ACCOUNT_SID=                                 # REQUIRED - Get from: https://console.twilio.com
TWILIO_AUTH_TOKEN=                                  # REQUIRED - Get from: https://console.twilio.com
TWILIO_PHONE_NUMBER=                                # REQUIRED - Format: +15551234567

# ==============================================================================
# EMAIL SERVICE
# ==============================================================================
# SMTP configuration for email delivery

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=                                          # REQUIRED - Your email address
SMTP_PASSWORD=                                      # REQUIRED - App-specific password
SMTP_FROM_EMAIL=                                    # REQUIRED - From address
SMTP_FROM_NAME=RateHunter Team

# ==============================================================================
# MONITORING - PROMETHEUS & GRAFANA
# ==============================================================================
# Observability stack for metrics and logs

PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=                             # REQUIRED - Strong password recommended
GRAFANA_PASSWORD=                                   # Alias for GRAFANA_ADMIN_PASSWORD

# ==============================================================================
# MCP SERVERS - MODEL CONTEXT PROTOCOL
# ==============================================================================
# Individual port assignments for MCP servers
# All registered with Nexus Router for unified access

MCP_VSCODE_PORT=8081                               # Code editing operations
MCP_TWENTYCRM_PORT=8082                            # CRM operations
MCP_DIFY_PORT=8083                                 # Dify workflow proxy
MCP_FILESYSTEM_PORT=8084                           # File system access
MCP_GITHUB_PORT=8085                               # GitHub integration
MCP_BRAVE_SEARCH_PORT=8086                         # Web search
MCP_BITWARDEN_PORT=8087                            # Secrets management
MCP_GITLAB_PORT=8088                               # GitLab integration
MCP_GOOGLE_MAPS_PORT=8089                          # Location services
MCP_SENTRY_PORT=8090                               # Error tracking
MCP_SLACK_PORT=8091                                # Slack integration
MCP_POSTGRES_PORT=8092                             # Database queries

# ==============================================================================
# GITHUB INTEGRATION
# ==============================================================================
# For MCP GitHub server and general GitHub operations

GITHUB_TOKEN=                                       # Optional - Get from: https://github.com/settings/tokens

# ==============================================================================
# BITWARDEN SECRETS
# ==============================================================================
# For MCP Bitwarden server - secure secrets vault

BITWARDEN_CLIENT_ID=                                # Optional - For Bitwarden secrets
BITWARDEN_CLIENT_SECRET=                            # Optional - For Bitwarden secrets
BITWARDEN_PASSWORD=                                 # Optional - Master password
BW_SESSION=                                         # Optional - Active session token

# ==============================================================================
# CLOUDFLARED TUNNELS - MULTI-PC NETWORKING
# ==============================================================================
# Secure tunnels between PCs for distributed GPU orchestration

CLOUDFLARED_TUNNEL_TOKEN=                           # REQUIRED for multi-PC setup
CLOUDFLARED_TUNNEL_NAME=nyra-tunnel

# ==============================================================================
# DOMAIN CONFIGURATION
# ==============================================================================
# RateHunter.net domain settings

DOMAIN=ratehunter.net
SUBDOMAIN_NYRA=nyra.ratehunter.net
SUBDOMAIN_API=api.ratehunter.net
SUBDOMAIN_ADMIN=admin.ratehunter.net

# ==============================================================================
# ENVIRONMENT & DEBUGGING
# ==============================================================================

NODE_ENV=development                                # Options: development, staging, production
ENVIRONMENT=development
DEBUG=archon-os:*,archon:*                        # Debug namespaces
