# ==============================================
# Project Nyra - Orchestration Environment Configuration
# ==============================================
# Created: January 8, 2026
# Purpose: Complete environment configuration for Phase 3 orchestration setup
#
# INSTRUCTIONS:
# 1. Copy this file to .env in project root: cp .env.orchestration.template .env
# 2. Fill in your actual API keys and configuration values
# 3. DO NOT commit .env file to version control
# ==============================================

# ==============================================
# API Keys (REQUIRED)
# ==============================================

# Google Gemini API Key
# Get from: https://makersuite.google.com/app/apikey
# Used by: Gemini Assistant MCP server
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Key
# Get from: https://console.anthropic.com/
# Used by: Claude Flow, Nexus Router fallback
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenRouter API Key (Optional)
# Get from: https://openrouter.ai/keys
# Used by: Nexus Router cloud fallback
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ==============================================
# Orchestration Services Ports
# ==============================================

# Claude Flow - Workflow Orchestration Engine
CLAUDE_FLOW_PORT=9000
CLAUDE_FLOW_URL=http://localhost:9000

# Archon OS - Agent Operating System
ARCHON_PORT=9001
ARCHON_OS_URL=http://localhost:9001

# Nexus Router - LLM Request Routing
NEXUS_PORT=8000
NEXUS_ROUTER_URL=http://localhost:8000

# ==============================================
# MCP Servers Ports
# ==============================================

# Gemini Assistant MCP Server
GEMINI_MCP_PORT=8085
GEMINI_MCP_URL=http://localhost:8085

# Serena MCP Server (Codebase Analysis)
SERENA_MCP_PORT=8086
SERENA_MCP_URL=http://localhost:8086
SERENA_REPO_PATH=/workspace

# ==============================================
# UI Services Ports
# ==============================================

# Open-WebUI - Primary Development Interface
OPEN_WEBUI_PORT=3333
OPEN_WEBUI_URL=http://localhost:3333
WEBUI_AUTH=false

# LobeChat - Alternative Development Interface
LOBECHAT_PORT=3334
LOBECHAT_URL=http://localhost:3334
NEXT_PUBLIC_BASE_URL=http://localhost:3334

# Dify - Production Chatbot Interface (Existing)
DIFY_PORT=3000
DIFY_URL=http://localhost:3000

# ==============================================
# Database Configuration
# ==============================================

# PostgreSQL - Primary database for Claude Flow
POSTGRES_USER=nyra
POSTGRES_PASSWORD=nyra_password_change_in_production
POSTGRES_DB=nyra_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nyra:nyra_password_change_in_production@postgresql:5432/nyra_db

# Redis - Caching and Task Queues
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# ==============================================
# GPU Workers Configuration (Optional)
# ==============================================
# If you have local GPU workers for inference, configure their URLs
# Otherwise, Nexus Router will fallback to cloud providers

# RTX 5090 Worker (Highest Priority)
GPU_WORKER_5090_URL=http://gpu-worker-5090:11434
GPU_WORKER_5090_ENABLED=false
GPU_WORKER_5090_MAX_CONCURRENT=3

# RTX 3090 Worker (Medium Priority)
GPU_WORKER_3090_URL=http://gpu-worker-3090:11434
GPU_WORKER_3090_ENABLED=false
GPU_WORKER_3090_MAX_CONCURRENT=2

# RTX 3060 Worker (Lower Priority)
GPU_WORKER_3060_URL=http://gpu-worker-3060:11434
GPU_WORKER_3060_ENABLED=false
GPU_WORKER_3060_MAX_CONCURRENT=2

# ==============================================
# LLM Model Configuration
# ==============================================

# Default models for different providers
CLAUDE_MODEL=claude-3-sonnet-20240229
GPT_MODEL=gpt-4-turbo-preview
GEMINI_MODEL=gemini-pro

# Temperature and token limits
DEFAULT_TEMPERATURE=0.7
MAX_TOKENS=4096
CONTEXT_WINDOW=200000

# ==============================================
# Ollama Configuration (for local models)
# ==============================================

OLLAMA_API_BASE_URL=http://host.docker.internal:11434
OLLAMA_ENABLED=true

# ==============================================
# Development Settings
# ==============================================

# Environment mode
NODE_ENV=development
ENV=development

# Logging
LOG_LEVEL=info
DEBUG=false
VERBOSE=true

# Enable development features
DEV_MODE=true
HOT_RELOAD=true

# ==============================================
# Security Settings
# ==============================================

# JWT Secret for authentication (generate a secure random string)
JWT_SECRET=change_this_to_a_secure_random_string_in_production

# Session secret
SESSION_SECRET=another_secure_random_string_for_sessions

# CORS settings
CORS_ORIGIN=http://localhost:3000,http://localhost:3333,http://localhost:3334
CORS_ENABLED=true

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# ==============================================
# Docker Network Configuration
# ==============================================

DOCKER_NETWORK=nyra-network
COMPOSE_PROJECT_NAME=nyra

# ==============================================
# Orchestration Integration Settings
# ==============================================

# Integration mode (single, dual, or distributed)
ORCHESTRATION_MODE=dual

# Primary orchestrator
PRIMARY_ORCHESTRATOR=archon-os

# Secondary orchestrator
SECONDARY_ORCHESTRATOR=archon-os

# Integration protocol
INTEGRATION_PROTOCOL=http
INTEGRATION_TIMEOUT=60000
HEARTBEAT_INTERVAL=30

# ==============================================
# Memory and Storage Configuration
# ==============================================

# Memory service URLs (if you have existing memory systems)
MEMORY_SERVICE_URL=http://localhost:8080
CONTEXT_SERVICE_URL=http://localhost:8081
SESSION_SERVICE_URL=http://localhost:8082

# Storage paths
WORKFLOW_STORAGE_PATH=/app/workflows
AGENT_STORAGE_PATH=/app/agents
TASK_QUEUE_PATH=/app/task-queue
LOGS_PATH=/app/logs

# ==============================================
# Performance and Resource Limits
# ==============================================

# Worker concurrency limits
MAX_CONCURRENT_TASKS=10
MAX_AGENTS_PER_WORKFLOW=5
TASK_TIMEOUT_MS=300000

# Memory limits (in MB)
CONTAINER_MEMORY_LIMIT=4096
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ==============================================
# Monitoring and Observability
# ==============================================

# Enable monitoring
MONITORING_ENABLED=true
METRICS_PORT=9090

# Health check intervals (in seconds)
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# ==============================================
# Feature Flags
# ==============================================

# Enable experimental features
ENABLE_NEURAL_AGENTS=false
ENABLE_DISTRIBUTED_TRAINING=false
ENABLE_AUTO_SCALING=false

# Enable advanced orchestration
ENABLE_SWARM_COORDINATION=true
ENABLE_MEMORY_PERSISTENCE=true
ENABLE_WORKFLOW_CACHING=true

# ==============================================
# Webhook and Notification Configuration
# ==============================================

# Webhook URLs for notifications (optional)
WEBHOOK_URL=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Email notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@project-nyra.local

# ==============================================
# CI/CD Integration (Optional)
# ==============================================

GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# ==============================================
# Production Overrides
# ==============================================
# These should be overridden in production environment

# Production database URL
# DATABASE_URL_PRODUCTION=postgresql://user:password@production-db:5432/nyra_prod

# Production Redis URL
# REDIS_URL_PRODUCTION=redis://production-redis:6379

# Production API keys (use secrets manager)
# ANTHROPIC_API_KEY_PRODUCTION=
# GOOGLE_GEMINI_API_KEY_PRODUCTION=

# ==============================================
# END OF CONFIGURATION
# ==============================================

# NOTES:
# - Replace all "your_*_api_key_here" with actual API keys
# - Replace all "change_this_*" with secure random strings
# - For production, use a secrets manager (e.g., HashiCorp Vault, AWS Secrets Manager)
# - Enable SSL/TLS for production deployments
# - Regularly rotate API keys and secrets
# - Monitor resource usage and adjust limits as needed
