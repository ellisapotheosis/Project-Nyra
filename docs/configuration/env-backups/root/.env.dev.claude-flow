# ==============================================================================
# DEVELOPMENT ENVIRONMENT - CLAUDE FLOW V3
# Claude Flow V3 Alpha - Development Configuration
# Use: Local development, testing, debugging
# ==============================================================================

# ==============================================================================
# CORE CONFIGURATION
# ==============================================================================
NODE_ENV=development
CLAUDE_FLOW_MODE=development
CLAUDE_FLOW_DEBUG=true
CLAUDE_FLOW_LOG_LEVEL=debug
CLAUDE_FLOW_VERBOSE=true

# ==============================================================================
# RELAXED LIMITS FOR DEVELOPMENT
# ==============================================================================
CLAUDE_FLOW_MAX_AGENTS=10
CLAUDE_FLOW_MAX_CONCURRENT_TASKS=5
CLAUDE_FLOW_WORKER_THREADS=4
CLAUDE_FLOW_MEMORY_LIMIT=2048
CLAUDE_FLOW_CACHE_SIZE=256

# ==============================================================================
# DEVELOPMENT FEATURES
# ==============================================================================
# Enable all debugging and development features
CLAUDE_FLOW_AUTO_COMMIT=false
CLAUDE_FLOW_AUTO_PUSH=false
CLAUDE_FLOW_CHECKPOINTS_ENABLED=false
CLAUDE_FLOW_TELEMETRY_ENABLED=false

# Hot reload
CLAUDE_FLOW_HOT_RELOAD=true
CLAUDE_FLOW_WATCH_MODE=true

# ==============================================================================
# LOCAL-ONLY SERVICES
# ==============================================================================
# Use local SQLite instead of PostgreSQL
DATABASE_URL=sqlite:///.archon-os/dev.db
REDIS_URL=redis://localhost:6379/1

# Local memory systems
MEMORY_BACKEND=file
MEMORY_AUTO_PERSIST=true
MEMORY_COMPRESSION=false

# ==============================================================================
# RELAXED SECURITY FOR DEV
# ==============================================================================
JWT_SECRET=dev-secret-change-in-production
ENCRYPTION_KEY=dev-encryption-key-change-in-production
SESSION_SECRET=dev-session-secret

# Disable strict security
AIDEFENCE_ENABLED=false
RATE_LIMITING_ENABLED=false
HELMET_ENABLED=false

# Allow all CORS
CORS_ORIGIN=*
ALLOWED_ORIGINS=*

# ==============================================================================
# API KEYS (DEV TIER)
# ==============================================================================
# Use lower-tier APIs or free tier for development
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
GOOGLE_API_KEY=${GOOGLE_API_KEY}
OPENROUTER_API_KEY=${OPENROUTER_API_KEY}

# Prefer cheaper models in dev
COMPLETION_MODEL=claude-3-5-haiku-20241022
PROVIDER=anthropic

# ==============================================================================
# LOCAL GPU (IF AVAILABLE)
# ==============================================================================
LOCAL_LLM_ENABLED=true
LOCAL_LLM_PRIORITY=true
LOCAL_LLM_URL=http://localhost:11434

# ==============================================================================
# MONITORING (MINIMAL)
# ==============================================================================
PROMETHEUS_ENABLED=false
GRAFANA_ENABLED=false
SENTRY_ENABLED=false

# Console logging only
LOG_FORMAT=pretty
LOG_FILE_PATH=./logs/dev.log

# ==============================================================================
# DEVELOPMENT TOOLS
# ==============================================================================
# Enable experimental features
FEATURE_EXPERIMENTAL=true
FEATURE_DEBUG_TOOLS=true
FEATURE_MOCK_SERVICES=true

# Mock external services for offline dev
MOCK_TWILIO=true
MOCK_SENDGRID=true
MOCK_AWS=true

# ==============================================================================
# FAST ITERATION
# ==============================================================================
# Reduce intervals for faster testing
MEMORY_SYNC_INTERVAL=10
CHECKPOINT_INTERVAL=60
CACHE_TTL=60

# ==============================================================================
# NO SECRETS MANAGEMENT IN DEV
# ==============================================================================
INFISICAL_ENABLED=false
