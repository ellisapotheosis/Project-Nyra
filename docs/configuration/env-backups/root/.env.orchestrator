# ==============================================================================
# ORCHESTRATOR - PC1 (Mini PC)
# Claude Flow V3 Alpha - Orchestrator Configuration
# Role: Central coordinator, no GPU compute
# ==============================================================================

# ==============================================================================
# CORE CONFIGURATION
# ==============================================================================
NODE_ENV=production
CLAUDE_FLOW_MODE=orchestrator
CLAUDE_FLOW_VERSION=3.0.0-alpha.104
CLAUDE_FLOW_DEBUG=false
CLAUDE_FLOW_LOG_LEVEL=info

# ==============================================================================
# ORCHESTRATOR ROLE
# ==============================================================================
# This PC coordinates the swarm but doesn't run GPU workloads
CLAUDE_FLOW_MAX_AGENTS=35
CLAUDE_FLOW_MAX_CONCURRENT_TASKS=25
CLAUDE_FLOW_WORKER_THREADS=8
CLAUDE_FLOW_MEMORY_LIMIT=2048
CLAUDE_FLOW_CACHE_SIZE=512

# ==============================================================================
# SWARM COORDINATION (ORCHESTRATOR AS QUEEN)
# ==============================================================================
SWARM_TOPOLOGY=hierarchical-mesh
SWARM_MAX_AGENTS=35
SWARM_ROLE=coordinator
SWARM_AUTO_SCALE=true
SWARM_COORDINATION_PROTOCOL=mesh

# Distributed Workers (Tailscale addresses)
SWARM_WORKERS=worker-3060.tail-net.ts.net:7890,worker-5090.tail-net.ts.net:7890,worker-3090.tail-net.ts.net:7890

# ==============================================================================
# GPU WORKERS - DISTRIBUTED COMPUTE
# ==============================================================================
LOCAL_LLM_ENABLED=true
LOCAL_LLM_PRIORITY=true
LOCAL_LLM_FALLBACK_TO_CLOUD=true

# PC2: RTX 3060 (Coding)
GPU_WORKER_3060_URL=http://worker-3060.tail-net.ts.net:11434
GPU_WORKER_3060_PRIORITY=3
GPU_WORKER_3060_MAX_CONCURRENT=2

# PC3: RTX 5090 (Large Models - PRIMARY)
GPU_WORKER_5090_URL=http://worker-5090.tail-net.ts.net:11434
GPU_WORKER_5090_PRIORITY=1
GPU_WORKER_5090_MAX_CONCURRENT=3

# PC4: RTX 3090 Ti (Analysis - SECONDARY)
GPU_WORKER_3090_URL=http://worker-3090.tail-net.ts.net:11434
GPU_WORKER_3090_PRIORITY=2
GPU_WORKER_3090_MAX_CONCURRENT=2

# ==============================================================================
# MEMORY SYSTEMS (ORCHESTRATOR HOSTS DATABASES)
# ==============================================================================
MEMORY_BACKEND=hybrid
MEMORY_PRIMARY_STORE=letta
MEMORY_ENABLE_HNSW=true

# ruvector (orchestrator hosts)
ruvector_ENABLED=true
ruvector_PATH=.ruvector/archon-os.db
ruvector_HNSW_M=16
ruvector_HNSW_EF=200

# RuVector (distributed across workers)
RUVECTOR_ENABLED=true
RUVECTOR_MODE=distributed
RUVECTOR_PORT=7000
RUVECTOR_CONSENSUS_PEERS=worker-5090.tail-net.ts.net:7890,worker-3090.tail-net.ts.net:7890,worker-3060.tail-net.ts.net:7890

# Letta (orchestrator hosts)
LETTA_ENABLED=true
LETTA_API_URL=http://localhost:8283
LETTA_MAX_AGENTS=20

# Qdrant (orchestrator hosts)
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333

# ==============================================================================
# NETWORKING (TAILSCALE)
# ==============================================================================
TAILSCALE_ENABLED=true
TAILSCALE_HOSTNAME=orchestrator
TAILSCALE_ADVERTISE_ROUTES=192.168.1.0/24

# ==============================================================================
# API CONFIGURATION
# ==============================================================================
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
GOOGLE_API_KEY=${GOOGLE_API_KEY}
OPENROUTER_API_KEY=${OPENROUTER_API_KEY}

# Model Routing
COMPLETION_MODEL=claude-sonnet-4-5-20250929
PROVIDER=anthropic
MODEL_ROUTING_STRATEGY=cost-optimized
MODEL_ROUTING_PREFER_LOCAL=true
MODEL_ROUTING_FALLBACK_CLOUD=true

# ==============================================================================
# DATABASES (ORCHESTRATOR HOSTS)
# ==============================================================================
DATABASE_URL=postgresql://nyra:${POSTGRES_PASSWORD}@localhost:5432/nyra
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0
REDIS_PORT=6379

# ==============================================================================
# MONITORING (ORCHESTRATOR COLLECTS METRICS)
# ==============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=true
GRAFANA_PORT=3002
SENTRY_ENABLED=true

# ==============================================================================
# DAEMON & WORKERS
# ==============================================================================
CLAUDE_FLOW_DAEMON_ENABLED=true
CLAUDE_FLOW_HOOKS_ENABLED=true

# ==============================================================================
# PERFORMANCE
# ==============================================================================
NEURAL_OPTIMIZATION_ENABLED=true
NEURAL_FLASH_ATTENTION=true
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=30000

# ==============================================================================
# SECURITY
# ==============================================================================
JWT_SECRET=${JWT_SECRET}
ENCRYPTION_KEY=${ENCRYPTION_KEY}
AIDEFENCE_ENABLED=true
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# ==============================================================================
# INFISICAL (PRODUCTION SECRETS)
# ==============================================================================
INFISICAL_PROJECT_ID=${INFISICAL_PROJECT_ID}
INFISICAL_ENVIRONMENT=production
INFISICAL_PATH=/shared
