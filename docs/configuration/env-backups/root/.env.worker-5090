# ==============================================================================
# WORKER - PC3 (RTX 5090 - 48GB VRAM)
# Claude Flow V3 Alpha - Primary GPU Worker
# Role: Large model inference, heavy compute
# ==============================================================================

# ==============================================================================
# CORE CONFIGURATION
# ==============================================================================
NODE_ENV=production
CLAUDE_FLOW_MODE=worker
CLAUDE_FLOW_VERSION=3.0.0-alpha.104
CLAUDE_FLOW_DEBUG=false
CLAUDE_FLOW_LOG_LEVEL=info

# ==============================================================================
# WORKER ROLE
# ==============================================================================
CLAUDE_FLOW_MAX_AGENTS=10
CLAUDE_FLOW_MAX_CONCURRENT_TASKS=8
CLAUDE_FLOW_WORKER_THREADS=12
CLAUDE_FLOW_MEMORY_LIMIT=8192
CLAUDE_FLOW_CACHE_SIZE=2048

# ==============================================================================
# SWARM WORKER CONFIGURATION
# ==============================================================================
SWARM_ROLE=worker
SWARM_WORKER_ID=worker-5090
SWARM_COORDINATOR_URL=http://orchestrator.tail-net.ts.net:7000
SWARM_WORKER_PORT=7890

# ==============================================================================
# GPU CONFIGURATION
# ==============================================================================
GPU_ENABLED=true
GPU_MODEL=RTX 5090
GPU_VRAM=48GB
GPU_CUDA_DEVICE=0
GPU_MAX_BATCH_SIZE=64
GPU_MAX_CONCURRENT=3
GPU_PRIORITY=1

# Local LLM (Ollama)
LOCAL_LLM_ENABLED=true
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODELS=deepseek-r1:236b-q4,qwen2.5:72b-q8,llama3.1:70b-q4

# ==============================================================================
# MEMORY CONFIGURATION (WORKER SUBSET)
# ==============================================================================
MEMORY_BACKEND=distributed
MEMORY_CACHE_ONLY=true
MEMORY_SYNC_INTERVAL=30

# RuVector Worker Node
RUVECTOR_ENABLED=true
RUVECTOR_MODE=worker
RUVECTOR_PORT=7890
RUVECTOR_COORDINATOR=orchestrator.tail-net.ts.net:7000

# AgentDB (read-only sync from orchestrator)
AGENTDB_ENABLED=true
AGENTDB_PATH=.agentdb/worker-5090.db
AGENTDB_SYNC_FROM=orchestrator.tail-net.ts.net:7000
AGENTDB_READ_ONLY=false

# ==============================================================================
# NETWORKING
# ==============================================================================
TAILSCALE_ENABLED=true
TAILSCALE_HOSTNAME=worker-5090

# ==============================================================================
# MINIMAL API KEYS (FALLBACK ONLY)
# ==============================================================================
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
GOOGLE_API_KEY=${GOOGLE_API_KEY}

# Prefer local models, fallback to cloud
MODEL_ROUTING_PREFER_LOCAL=true
MODEL_ROUTING_FALLBACK_CLOUD=true

# ==============================================================================
# PERFORMANCE OPTIMIZATION
# ==============================================================================
NEURAL_OPTIMIZATION_ENABLED=true
NEURAL_FLASH_ATTENTION=true
NEURAL_QUANTIZATION=int4
NEURAL_BATCH_SIZE=64

# GPU Memory Management
GPU_MEMORY_FRACTION=0.95
GPU_ALLOW_GROWTH=true

# ==============================================================================
# MONITORING (METRICS TO ORCHESTRATOR)
# ==============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9091
PROMETHEUS_PUSH_GATEWAY=orchestrator.tail-net.ts.net:9090

# ==============================================================================
# REDUCED SECURITY (TRUSTED NETWORK)
# ==============================================================================
# Workers in Tailscale VPN - less strict security
AIDEFENCE_ENABLED=false
RATE_LIMITING_ENABLED=false

# ==============================================================================
# WORKER-SPECIFIC FEATURES
# ==============================================================================
# This worker handles: Large model inference, deep reasoning, complex analysis
WORKER_SPECIALIZATION=large-models
WORKER_CAPABILITIES=deepseek-r1,qwen2.5-72b,llama3.1-70b
