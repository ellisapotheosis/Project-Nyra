# [OPT] Sentry error tracking enabled
SENTRY_ENABLED=false


# =============================================================================
# NOTES FOR SETUP
# =============================================================================
# 1. PC1 (Orchestrator): Use all [PC1] and [ALL] variables
# 2. PC2 (RTX 3060): Use GPU worker section + [PC2] and [ALL] variables
# 3. PC3 (RTX 5090): Use GPU worker section + [PC3] and [ALL] variables
# 4. PC4 (RTX 3090): Use GPU worker section + [PC4] and [ALL] variables
#
# 5. All passwords and API keys should be:
#    - Generated securely (minimum 32 characters for secrets)
#    - Stored in Infisical after setup
#    - Never committed to version control
#    - Rotated periodically
#
# 6. For each PC, create a PC-specific .env file:
#    - .env (PC1 - Orchestrator)
#    - .env.worker-3060 (PC2)
#    - .env.worker-5090 (PC3)
#    - .env.worker-3090 (PC4)
#
# 7. Test all connections before deploying:
#    - Database connections
#    - API keys
#    - Worker node URLs
#    - Cloudflare tunnels
#
# =============================================================================
