# =============================================================================
# MASTER .env REFERENCE - ALL POSSIBLE VARIABLES
# =============================================================================
# This file shows ALL environment variables used across Project Nyra.
# Copy relevant sections to PC-specific .env files as needed.
#
# Legend:
# [REQ]  = Required
# [OPT]  = Optional
# [PC1]  = Orchestrator PC (main)
# [PC2]  = RTX 3060 Worker PC
# [PC3]  = RTX 5090 Worker PC
# [PC4]  = RTX 3090 Worker PC
# [ALL]  = All PCs (common configuration)
# =============================================================================

# =============================================================================
# ENVIRONMENT & MODE CONFIGURATION [ALL]
# =============================================================================
# [REQ] Node environment (production/development/test)
NODE_ENV=production

# [REQ] Python runtime environment
PYTHON_ENV=production

# [REQ] Project name
PROJECT_NAME=project-nyra

# [REQ] Project environment
PROJECT_ENV=production

# [OPT] Python version
PYTHON_VERSION=3.11

# [OPT] Node version
NODE_VERSION=20

# [OPT] Volta version (Node version manager)
VOLTA_VERSION=1.1.1

# [OPT] Docker buildkit support
DOCKER_BUILDKIT=1

# [OPT] Docker compose CLI build
COMPOSE_DOCKER_CLI_BUILD=1

# [OPT] Docker compose project name
COMPOSE_PROJECT_NAME=nyra-network

# [OPT] Docker networking subnet
DOCKER_SUBNET=172.20.0.0/16


# =============================================================================
# AUTHENTICATION & SECURITY [PC1 - Orchestrator]
# =============================================================================
# [REQ] User email/identity
--username=edaneandersen@gmail.com

# [REQ] Main Anthropic API key for Claude API access
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# [OPT] Anthropic base URL (override if using proxy)
ANTHROPIC_BASE_URL=

# [OPT] Anthropic default Sonnet model version
ANTHROPIC_DEFAULT_SONNET_MODEL=

# [OPT] Anthropic max tokens override
ANTHROPIC_MAX_TOKENS=

# [REQ] Default Claude model for API calls
ANTHROPIC_MODEL=claude-sonnet-4-5

# [OPT] Claude API key (alias for ANTHROPIC_API_KEY)
CLAUDE_API_KEY=sk-ant-your-api-key-here

# [OPT] Default Claude model
CLAUDE_MODEL=claude-sonnet-4-5

# [OPT] Auto-approve Claude operations
CLAUDE_AUTO_APPROVE=1

# [OPT] Bash working directory maintenance
CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR=1

# [OPT] Enable Claude Code always thinking mode
CLAUDE_CODE_ALWAYS_THINKING_ENABLED=true

# [OPT] Disable non-essential traffic
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# [OPT] Disable terminal title updates
CLAUDE_CODE_DISABLE_TERMINAL_TITLE=1

# [OPT] Enable Claude Code telemetry
CLAUDE_CODE_ENABLE_TELEMETRY=1

# [OPT] Claude Code Git Bash path (Windows)
CLAUDE_CODE_GIT_BASH_PATH=C:\Program Files\git\bin\bash.exe

# [OPT] Claude Code interaction mode (bypassPermissions/strict)
CLAUDE_CODE_INTERACTION_MODE=bypassPermissions

# [OPT] Claude Code max output tokens
CLAUDE_CODE_MAX_OUTPUT_TOKENS=64000

# [REQ] Claude Code subagent model for lightweight tasks
CLAUDE_CODE_SUBAGENT_MODEL=claude-3-5-haiku-latest

# [OPT] Claude escalation model for complex tasks
CLAUDE_ESCALATE_MODEL=claude-3-5-opus-latest

# [OPT] Claude metrics storage path
CLAUDE_METRICS_PATH=$HOME/.claude/metrics

# [OPT] Completion model for inference tasks
COMPLETION_MODEL=claude-3-5-sonnet-20241022

# [OPT] Disable non-essential model calls
DISABLE_NON_ESSENTIAL_MODEL_CALLS=1

# [OPT] Disable prompt caching for Haiku model
DISABLE_PROMPT_CACHING_HAIKU=0

# [OPT] Disable telemetry
DISABLE_TELEMETRY=0

# [OPT] JWT secret for authentication tokens
JWT_SECRET=your_jwt_secret_here_min_32_chars

# [OPT] Encryption key for sensitive data
ENCRYPTION_KEY=your_encryption_key_here_min_32_chars

# [OPT] Session secret for session management
SESSION_SECRET=your_session_secret_here_min_32_chars


# =============================================================================
# DATABASE CONNECTIONS [PC1 - Orchestrator]
# =============================================================================
# PostgreSQL Main Database
# [REQ] PostgreSQL host
POSTGRES_HOST=localhost

# [REQ] PostgreSQL port
POSTGRES_PORT=5432

# [REQ] PostgreSQL database name
POSTGRES_DB=nyra_production

# [REQ] PostgreSQL username
POSTGRES_USER=nyra

# [REQ] PostgreSQL password
POSTGRES_PASSWORD=your_secure_postgres_password_here

# [REQ] PostgreSQL superuser password
POSTGRES_SUPER_PASSWORD=your_super_admin_password_here

# [REQ] PostgreSQL connection string
DATABASE_URL=postgresql://nyra:password@postgresql:5432/nyra_production

# [OPT] PG database host override
PG_DATABASE_HOST=

# [OPT] PG database name override
PG_DATABASE_NAME=

# [OPT] PG database URL override
PG_DATABASE_URL=

# [OPT] PG database user override
PG_DATABASE_USER=

# [OPT] Connection pool size for database connections
CONNECTION_POOL_SIZE=20

# PostgreSQL Admin (pgAdmin)
# [OPT] pgAdmin password for web UI
PGADMIN_PASSWORD=your_pgadmin_password_here

# [OPT] pgAdmin web UI port
PGADMIN_PORT=5050

# MongoDB
# [OPT] MongoDB root password
MONGO_ROOT_PASSWORD=your_mongodb_root_password_here


# =============================================================================
# REDIS CACHE & QUEUE [PC1 - Orchestrator]
# =============================================================================
# [REQ] Redis host
REDIS_HOST=localhost

# [REQ] Redis port
REDIS_PORT=6379

# [REQ] Redis password
REDIS_PASSWORD=your_redis_secure_password_here

# [REQ] Redis connection URL
REDIS_URL=redis://localhost:6379

# [OPT] Redis eviction policy (allkeys-lru/volatile-lru/etc.)
REDIS_EVICTION_POLICY=allkeys-lru

# [OPT] Redis max memory limit
REDIS_MAX_MEMORY=4GB

# [OPT] Cache TTL in seconds
CACHE_TTL=3600

# [OPT] Memory cache type (redis/memcached/in-memory)
MEMORY_CACHE_TYPE=redis


# =============================================================================
# VECTOR DATABASES [PC1 - Orchestrator]
# =============================================================================
# Qdrant Vector Database
# [OPT] Qdrant API key
QDRANT_API_KEY=your_qdrant_api_key_here

# [OPT] Qdrant localhost URL
QDRANT_LOCALHOST_URL=http://localhost:6333

# [OPT] Qdrant port
QDRANT_PORT=6333

# FalkorDB Graph Database
# [OPT] FalkorDB password
FALKORDB_PASSWORD=your_falkordb_password_here

# [OPT] FalkorDB port
FALKORDB_PORT=6380

# [OPT] FalkorDB AOF sync mode (everysec/always/no)
FALKORDB_AOF_SYNC=everysec

# [OPT] FalkorDB max memory limit
FALKORDB_MAX_MEMORY=2GB

# Neo4j Graph Database
# [OPT] Neo4j password
NEO4J_PASSWORD=your_neo4j_password_here

# [OPT] Neo4j Bolt port (binary protocol)
NEO4J_BOLT_PORT=7687

# [OPT] Neo4j HTTP port (REST API)
NEO4J_HTTP_PORT=7474


# =============================================================================
# ruvector - VECTOR MEMORY & LEARNING [PC1 - Orchestrator]
# =============================================================================
# [REQ] ruvector enabled flag
ruvector_ENABLED=true

# [REQ] ruvector API key for authentication
ruvector_API_KEY=ruvector_your_key_here

# [OPT] ruvector database path
ruvector_PATH=.ruvector/archon-os.db

# [OPT] ruvector data directory
ruvector_DATA_DIR=/var/lib/ruvector

# [OPT] ruvector port for HTTP API
ruvector_PORT=7700

# [OPT] ruvector QUIC port for fast sync
ruvector_QUIC_PORT=4433

# [OPT] Enable QUIC protocol for vector sync
ruvector_QUIC_SYNC=false

# [OPT] Vector dimensions for embeddings (1536 for OpenAI)
ruvector_VECTOR_DIMENSIONS=1536

# [OPT] Distance metric for vector search (cosine/euclidean/manhattan)
ruvector_DISTANCE_METRIC=cosine

# [OPT] Embedding model for vector generation
ruvector_EMBEDDING_MODEL=text-embedding-3-small

# [OPT] HNSW M parameter (connections per node)
ruvector_HNSW_M=16

# [OPT] HNSW ef parameter (search quality)
ruvector_HNSW_EF=100

# [OPT] HNSW ef_construction parameter (index quality)
ruvector_HNSW_EF_CONSTRUCTION=200

# [OPT] HNSW ef_search parameter (search efficiency)
ruvector_HNSW_EF_SEARCH=100

# [OPT] Quantization method (scalar/product/binary/none)
ruvector_QUANTIZATION=scalar

# [OPT] Cache size for frequently accessed vectors
ruvector_CACHE_SIZE=1000

# [OPT] Compression algorithm (zstd/lz4/snappy)
ruvector_COMPRESSION=zstd

# [OPT] Enable Write-Ahead Logging for durability
ruvector_WAL_ENABLED=true

# [OPT] Snapshot interval in seconds for persistence
ruvector_SNAPSHOT_INTERVAL=3600

# [OPT] Enable backup functionality
ruvector_BACKUP_ENABLED=true

# [OPT] Auto-migrate database schema
ruvector_AUTO_MIGRATE=false

# [OPT] Fallback to legacy storage if needed
ruvector_FALLBACK_LEGACY=true

# [OPT] Enable learning features (decision transformer, etc.)
ruvector_LEARNING=true

# [OPT] Learning algorithm (decision-transformer/q-learning/sarsa/actor-critic)
ruvector_LEARNING_ALGORITHM=decision-transformer

# [OPT] Enable reasoning features
ruvector_REASONING=true


# =============================================================================
# CLAUDE FLOW V3 - AGENT ORCHESTRATION [PC1 - Orchestrator]
# =============================================================================
# Mode & Profile
# [REQ] Claude Flow mode (orchestrator/worker/hybrid)
CLAUDE_FLOW_MODE=orchestrator

# [OPT] Claude Flow profile (development/production/test)
CLAUDE_FLOW_PROFILE=development

# [OPT] Claude Flow performance mode (optimized/balanced/debug)
CLAUDE_FLOW_PERFORMANCE_MODE=optimized

# [OPT] Alpha features enabled
CLAUDE_FLOW_ALPHA=true

# Core Ports & URLs
# [REQ] Claude Flow port for MCP/API
CLAUDE_FLOW_PORT=9000

# [OPT] Claude Flow MCP port
CLAUDE_FLOW_MCP_PORT=3000

# [OPT] Claude Flow MCP URL
CLAUDE_FLOW_MCP_URL=http://archon-os:9000/mcp

# [OPT] Claude Flow base URL
CLAUDE_FLOW_BASE_URL=http://archon-os:8787

# [OPT] Claude Flow Redis URL
CLAUDE_FLOW_REDIS_URL=redis://localhost:6379/1

# Agent & Swarm Configuration
# [OPT] Min agents to keep running
CLAUDE_FLOW_MIN_AGENTS=1

# [OPT] Max agents allowed in swarm
CLAUDE_FLOW_MAX_AGENTS=100

# [OPT] Max agents for scaling operations
CLAUDE_FLOW_MAX_AGENTS_SCALING=50

# [OPT] Worker threads per agent
CLAUDE_FLOW_WORKER_THREADS=8

# [OPT] Enable agent pool for reuse
CLAUDE_FLOW_AGENT_POOL=true

# [OPT] Scale up threshold (% CPU)
CLAUDE_FLOW_SCALE_UP_THRESHOLD=80

# [OPT] Scale down threshold (% CPU)
CLAUDE_FLOW_SCALE_DOWN_THRESHOLD=30

# [OPT] Swarm topology (mesh/hierarchical/ring/star)
CLAUDE_FLOW_TOPOLOGY=mesh

# [OPT] MCP mode (advanced/basic)
CLAUDE_FLOW_MCP_MODE=advanced

# Task & Performance
# [OPT] Concurrent tasks allowed
CLAUDE_FLOW_CONCURRENT_TASKS=100

# [OPT] Task timeout in milliseconds
CLAUDE_FLOW_TIMEOUT=300000

# [OPT] Enable parallel processing
CLAUDE_FLOW_PARALLEL_PROCESSING=true

# [OPT] Remote execution support
CLAUDE_FLOW_REMOTE_EXECUTION=true

# Memory & Caching
# [OPT] Enable memory subsystem
CLAUDE_FLOW_ENABLE_MEMORY=true

# [OPT] Enable memory persistence
CLAUDE_FLOW_MEMORY_PERSIST=true

# [OPT] Memory persistence flag
CLAUDE_FLOW_MEMORY_PERSISTENCE=true

# [OPT] Enable memory limit enforcement
CLAUDE_FLOW_MEMORY_ENABLED=true

# [OPT] Memory size limit
CLAUDE_FLOW_MEMORY_SIZE=2GB

# [OPT] Memory limit in MB
CLAUDE_FLOW_MEMORY_LIMIT=2048

# [OPT] Cache enabled
CLAUDE_FLOW_CACHE_ENABLED=true

# [OPT] Cache size in MB
CLAUDE_FLOW_CACHE_SIZE=512

# Features
# [OPT] Enable neural pattern learning
CLAUDE_FLOW_ENABLE_NEURAL=true

# [OPT] Enable semantic search
CLAUDE_FLOW_SEMANTIC_SEARCH=true

# [OPT] Enable metrics collection
CLAUDE_FLOW_ENABLE_METRICS=true

# [OPT] Enable hooks system
CLAUDE_FLOW_ENABLE_HOOKS=true

# [OPT] Enable MCP integration
CLAUDE_FLOW_ENABLE_MCP=true

# [OPT] Enable swarm orchestration
CLAUDE_FLOW_ENABLE_SWARM=true

# [OPT] Enable checkpoints
CLAUDE_FLOW_ENABLE_CHECKPOINTS=true

# [OPT] Enable forking
CLAUDE_FLOW_ENABLE_FORKING=true

# [OPT] Enable pause/resume
CLAUDE_FLOW_ENABLE_PAUSE_RESUME=true

# [OPT] Enable tracing
CLAUDE_FLOW_ENABLE_TRACING=true

# [OPT] Coordination enabled
CLAUDE_FLOW_COORDINATION_ENABLED=true

# [OPT] Hooks system enabled
CLAUDE_FLOW_HOOKS_ENABLED=true

# [OPT] GitHub integration enabled
CLAUDE_FLOW_GITHUB_INTEGRATION=true

# [OPT] Auto-commit changes
CLAUDE_FLOW_AUTO_COMMIT=true

# [OPT] Auto-push changes
CLAUDE_FLOW_AUTO_PUSH=true

# [OPT] Force update
CLAUDE_FLOW_FORCE_UPDATE=true

# [OPT] Auto-update disabled
CLAUDE_FLOW_AUTO_UPDATE=false

# [OPT] Auto-scaling enabled
CLAUDE_FLOW_AUTO_SCALING=true

# [OPT] Auto-learning enabled
CLAUDE_FLOW_AUTO_LEARNING=true

# [OPT] Checkpoints enabled
CLAUDE_FLOW_CHECKPOINTS_ENABLED=true

# [OPT] Checkpoint interval in minutes
CLAUDE_FLOW_CHECKPOINT_INTERVAL=10

# [OPT] Checkpoint enabled flag
CLAUDE_FLOW_CHECKPOINT_ENABLED=true

# [OPT] Neural optimization
CLAUDE_FLOW_NEURAL_OPTIMIZATION=true

# Telemetry & Debug
# [OPT] Telemetry enabled
CLAUDE_FLOW_TELEMETRY_ENABLED=true

# [OPT] Debug mode
CLAUDE_FLOW_DEBUG=true

# [OPT] Log level (debug/info/warn/error)
CLAUDE_FLOW_LOG_LEVEL=debug

# [OPT] Verbose logging
CLAUDE_FLOW_VERBOSE=false

# [OPT] Metrics port
CLAUDE_FLOW_METRICS_PORT=9090

# Data & Configuration
# [OPT] Data directory
CLAUDE_FLOW_DATA_DIR=./data

# [OPT] Command for starting Claude Flow
CLAUDE_FLOW_CMD=archon-os mcp start


# =============================================================================
# ARCHON - ORCHESTRATION & COORDINATION [PC1 - Orchestrator]
# =============================================================================
# [OPT] Archon enabled
ARCHON_ENABLED=true

# [OPT] Archon server port
ARCHON_SERVER_PORT=8181

# [OPT] Archon main port
ARCHON_PORT=9001

# [OPT] Archon API port
ARCHON_API_PORT=8000

# [OPT] Archon API workers
ARCHON_API_WORKERS=4

# [OPT] Archon MCP port
ARCHON_MCP_PORT=8051

# [OPT] Archon agents management port
ARCHON_AGENTS_PORT=8052

# [OPT] Archon work orders port
AGENT_WORK_ORDERS_PORT=8053

# [OPT] Archon metrics port
ARCHON_METRICS_PORT=9091

# [OPT] Archon documentation port
ARCHON_DOCS_PORT=3838

# [OPT] Archon UI port
ARCHON_UI_PORT=3737

# [OPT] Archon base URL for internal communication
ARCHON_BASE_URL=http://archon:8181

# [OPT] Archon UI base URL
ARCHON_UI_BASE_URL=http://archon-ui:3737

# [OPT] Archon MCP URL
ARCHON_MCP_URL=http://archon-os:9001/mcp

# [OPT] Archon Redis URL
ARCHON_REDIS_URL=redis://:password@redis:6379/2

# [OPT] Archon topology (hierarchical/mesh)
ARCHON_TOPOLOGY=hierarchical

# [OPT] Archon parallel branches
ARCHON_PARALLEL_BRANCHES=true

# [OPT] Archon state persistence
ARCHON_STATE_PERSISTENCE=true

# [OPT] Archon max recursion depth
ARCHON_MAX_DEPTH=5

# [OPT] Archon task timeout in milliseconds
ARCHON_TASK_TIMEOUT=300000

# [OPT] Archon checkpoint interval in milliseconds
ARCHON_CHECKPOINT_INTERVAL=60000

# [OPT] Archon retry attempts
ARCHON_RETRY_ATTEMPTS=3

# [OPT] Archon retry backoff multiplier
ARCHON_BACKOFF_MULTIPLIER=2

# [OPT] Archon log level
ARCHON_LOG_LEVEL=INFO


# =============================================================================
# AGENTIC FLOW - DISTRIBUTED EXECUTION [PC1 - Orchestrator]
# =============================================================================
# [OPT] Agentic Flow training enabled
AGENTIC_FLOW_TRAINING=true

# [OPT] Agent Booster enabled (optimization layer)
AGENT_BOOSTER_ENABLED=true


# =============================================================================
# FLOW NEXUS - ADVANCED DEPLOYMENT [PC1 - Orchestrator]
# =============================================================================
# [REQ] Flow Nexus enabled
FLOW_NEXUS_ENABLED=true

# [REQ] Flow Nexus API key
FLOW_NEXUS_API_KEY=fnx_sk_your_key_here

# [REQ] Flow Nexus token
FLOW_NEXUS_TOKEN=your_flow_nexus_token_here

# [OPT] Flow Nexus user ID
FLOW_NEXUS_USER_ID=usr_your_user_id

# [OPT] Flow Nexus URL
FLOW_NEXUS_URL=https://mcp-flow-nexus.ruv.io

# [OPT] Flow Nexus mode
FLOW_NEXUS_MODE=

# [OPT] Flow Nexus MCP start command
FLOW_NEXUS_CMD=npx -y flow-nexus@latest mcp start


# =============================================================================
# REASONING BANK - ADAPTIVE LEARNING [PC1 - Orchestrator]
# =============================================================================
# [OPT] ReasoningBank enabled
REASONINGBANK_ENABLED=true

# [OPT] ReasoningBank database path
REASONINGBANK_DB_PATH=.swarm/memory.db

# [OPT] ReasoningBank K neighbors for similarity search
REASONINGBANK_K=3

# [OPT] ReasoningBank minimum confidence threshold
REASONINGBANK_MIN_CONFIDENCE=0.5


# =============================================================================
# RUV SWARM - MULTI-AGENT COORDINATION [PC1 - Orchestrator]
# =============================================================================
# [OPT] Swarm topology (mesh/hierarchical)
SWARM_TOPOLOGY=mesh

# [OPT] RUV Swarm log level
RUV_SWARM_LOG_LEVEL=info

# [OPT] Enable SIMD optimization
RUV_SWARM_ENABLE_SIMD=true

# [OPT] RUV Swarm MCP start command
RUV_SWARM_CMD=npx -y ruv-swarm mcp start


# =============================================================================
# CLOUDFLARE TUNNELING [PC1 - Orchestrator + ALL Workers]
# =============================================================================
# [OPT] Cloudflare account ID
CLOUDFLARE_ACCOUNT_ID=your_cf_account_id_here

# [OPT] Cloudflare zone ID
CLOUDFLARE_ZONE_ID=your_cf_zone_id_here

# [OPT] Cloudflare API key
CLOUDFLARE_API_KEY=your_cf_api_key_here

# [OPT] Cloudflare email
CLOUDFLARE_EMAIL=your_email@example.com

# [OPT] Cloudflare global API
CLOUDFLARE_GLOBAL_API=your_global_api_here

# [OPT] Cloudflare Origin CA key for SSL
CLOUDFLARE_ORIGIN_CA_KEY=your_origin_ca_key_here

# [OPT] Access Client ID for Cloudflare Access
CF_ACCESS_CLIENT_ID=your_access_client_id_here

# [OPT] Access Client Secret for Cloudflare Access
CF_ACCESS_CLIENT_SECRET=your_access_client_secret_here

# [OPT] Cloudflare tunnel token for Orchestrator [PC1]
CLOUDFLARE_TUNNEL_TOKEN_ORCHESTRATOR=your_tunnel_token_here

# [OPT] Cloudflare tunnel name for Orchestrator
CLOUDFLARE_TUNNEL_NAME_ORCHESTRATOR=nyra-orchestrator

# [OPT] Cloudflare tunnel ID for Orchestrator
CLOUDFLARE_TUNNEL_ID_ORCHESTRATOR=your_tunnel_id_here

# [OPT] Cloudflare tunnel token for RTX 5090 Worker [PC3]
CLOUDFLARE_TUNNEL_TOKEN_WORKER_RTX5090=your_tunnel_token_here

# [OPT] Cloudflare tunnel token for RTX 3060 Worker [PC2]
CLOUDFLARE_TUNNEL_TOKEN_WORKER_RTX3060=your_tunnel_token_here

# [OPT] Cloudflare tunnel token for RTX 3090 Worker [PC4]
CLOUDFLARE_TUNNEL_TOKEN_WORKER_RTX3090TI=your_tunnel_token_here

# [OPT] Cloudflared tunnel token (generic)
CLOUDFLARED_TUNNEL_TOKEN=

# [OPT] API key for CLI
CLOUDFLARE_API=your_api_key_here


# =============================================================================
# GITHUB INTEGRATION [PC1 - Orchestrator]
# =============================================================================
# [OPT] GitHub integration enabled
GITHUB_INTEGRATION_ENABLED=true

# [REQ] GitHub owner/organization
GITHUB_OWNER=ellisapotheosis
GH_REPOSITORY_OWNER=ellisapotheosis

# [REQ] GitHub personal access token
GITHUB_TOKEN=github_pat_your_pat_here

# [OPT] GitHub PAT alias
GH_PAT=github_pat_your_pat_here

# [OPT] GitHub personal access token (all permissions)
GH_PERSONAL_ACCESS_TOKEN=github_pat_your_pat_here

# [OPT] GitHub personal access token (all scopes)
GH_PERSONAL_ACCESS_TOKEN_ALL=github_pat_your_pat_here

# [OPT] GitHub token (another alias)
GH_TOKEN=github_pat_your_pat_here

# [OPT] Simple GitHub token
SIMPLE_GH_TOKEN=ghp_your_simple_token_here

# [OPT] Fine-grained GitHub PAT
FINE_GH_PAT=github_pat_your_fine_grained_token_here

# [OPT] Dynamic toolsets for GitHub
GH_DYNAMIC_TOOLSETS=1

# [OPT] GitHub toolsets configuration
GH_TOOLSETS=context,repos,pull_requests,actions

# [OPT] GitHub MCP API key
GH_MCP_API_KEY=your_mcp_key_here

# [OPT] Create GitHub release
CREATE_GH_RELEASE=true


# =============================================================================
# DOCKER & CONTAINER REGISTRY [ALL]
# =============================================================================
# [OPT] DockerHub username
DOCKERHUB_USERNAME=your_dockerhub_username

# [OPT] DockerHub PAT token
DOCKHERHUB_TOKEN=dckr_pat_your_token_here

# [OPT] Docker Hub PAT token
HUB_PAT_TOKEN=dckr_pat_your_token_here

# [OPT] Docker Hub username
HUB_USERNAME=your_dockerhub_username


# =============================================================================
# EXTERNAL AI MODELS [PC1 - Orchestrator]
# =============================================================================
# Google APIs
# [OPT] Google API key
GOOGLE_API_KEY=your_google_api_key_here

# [OPT] Google Gemini API key
GOOGLE_GEMINI_API_KEY=your_gemini_key_here
GEMINI_API_KEY=your_gemini_key_here

# [OPT] Use Gemini
USE_GEMINI=true

# OpenAI
# [OPT] OpenAI API key
OPENAI_API_KEY=sk-proj-your_openai_key_here

# OpenRouter (model aggregator)
# [OPT] OpenRouter API key
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# [OPT] OpenRouter base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# [OPT] OpenRouter fallback model
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-r1

# Exa Search API
# [OPT] Exa API key
EXA_API_KEY=your_exa_api_key_here

# Composio
# [OPT] Composio API key
COMPOSIO_API_KEY=ak_your_composio_key_here

# Ollama (local models)
# [OPT] Ollama API key
OLLAMA_API=your_ollama_api_key_here

# OpenMemory
# [OPT] OpenMemory API key
OPENMEMORY_API_KEY=om_your_openmemory_key_here

# Mem0 (persistent memory)
# [OPT] Mem0 API key
MEM0_API_KEY=m0_your_mem0_key_here

# [OPT] Mem0 base URL
MEM0_BASE_URL=https://api.mem0.ai

# [OPT] Mem0 organization ID
MEM0_ORGANIZATION_ID=org_your_org_id

# [OPT] Mem0 organization name
MEM0_ORGANIZATION_NAME=your_org_name

# [OPT] Mem0 default user ID
MEM0_DEFAULT_USER_ID=your_user_id

# [OPT] Mem0 port
MEM0_PORT=8002


# =============================================================================
# LOCAL GPU WORKER NODES [PC2, PC3, PC4]
# =============================================================================
# RTX 3060 Worker [PC2]
# [OPT] Enable RTX 3060 worker
GPU_WORKER_3060_ENABLED=false

# [OPT] RTX 3060 worker URL
WORKER_3060_URL=http://worker-3060.tail-net.ts.net:11434

# [OPT] Models running on RTX 3060
WORKER_3060_MODELS=codellama:34b-instruct-q8_0,qwen2.5:32b-instruct-q8_0

# RTX 5090 Worker [PC3]
# [OPT] Enable RTX 5090 worker
GPU_WORKER_5090_ENABLED=false

# [OPT] RTX 5090 worker URL
WORKER_5090_URL=http://worker-5090.tail-net.ts.net:11434

# [OPT] Models running on RTX 5090
WORKER_5090_MODELS=deepseek-r1:236b-q4_K_M,qwen2.5:72b-instruct-q8_0

# RTX 3090 Worker [PC4]
# [OPT] Enable RTX 3090 worker
GPU_WORKER_3090_ENABLED=false

# [OPT] RTX 3090 worker URL
WORKER_3090_URL=http://worker-3090.tail-net.ts.net:11434

# [OPT] Models running on RTX 3090
WORKER_3090_MODELS=llama3.1:70b-instruct-q4_K_M,mistral-large:123b-instruct-2407-q4_K_M

# Local LLM
# [OPT] Local LLM enabled
LOCAL_LLM_ENABLED=false


# =============================================================================
# MODEL ROUTING & OPTIMIZATION [PC1 - Orchestrator]
# =============================================================================
