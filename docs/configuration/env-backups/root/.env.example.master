# [OPT] Prefer local models over cloud
MODEL_ROUTING_PREFER_LOCAL=true

# [OPT] Fallback to cloud if local unavailable
MODEL_ROUTING_FALLBACK_CLOUD=true

# [OPT] Cost threshold for routing decisions
MODEL_ROUTING_COST_THRESHOLD=0.10

# [OPT] Use ONNX runtime
USE_ONNX=true

# [OPT] ONNX runtime enabled
ONNX_RUNTIME_ENABLED=true


