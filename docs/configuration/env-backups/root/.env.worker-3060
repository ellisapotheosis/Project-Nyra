# ==============================================================================
# WORKER - PC2 (RTX 3060 - 12GB VRAM)
# Claude Flow V3 Alpha - Coding Worker
# Role: Code generation, smaller models, fast inference
# ==============================================================================

# ==============================================================================
# CORE CONFIGURATION
# ==============================================================================
NODE_ENV=production
CLAUDE_FLOW_MODE=worker
CLAUDE_FLOW_VERSION=3.0.0-alpha.104
CLAUDE_FLOW_DEBUG=false
CLAUDE_FLOW_LOG_LEVEL=info

# ==============================================================================
# WORKER ROLE
# ==============================================================================
CLAUDE_FLOW_MAX_AGENTS=6
CLAUDE_FLOW_MAX_CONCURRENT_TASKS=4
CLAUDE_FLOW_WORKER_THREADS=8
CLAUDE_FLOW_MEMORY_LIMIT=4096
CLAUDE_FLOW_CACHE_SIZE=1024

# ==============================================================================
# SWARM WORKER CONFIGURATION
# ==============================================================================
SWARM_ROLE=worker
SWARM_WORKER_ID=worker-3060
SWARM_COORDINATOR_URL=http://orchestrator.tail-net.ts.net:7000
SWARM_WORKER_PORT=7890

# ==============================================================================
# GPU CONFIGURATION
# ==============================================================================
GPU_ENABLED=true
GPU_MODEL=RTX 3060
GPU_VRAM=12GB
GPU_CUDA_DEVICE=0
GPU_MAX_BATCH_SIZE=16
GPU_MAX_CONCURRENT=2
GPU_PRIORITY=3

# Local LLM (Ollama) - Coding-focused models
LOCAL_LLM_ENABLED=true
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODELS=codellama:34b-q8,qwen2.5:32b-q8,gemma2:27b,starcoder2:15b

# ==============================================================================
# MEMORY CONFIGURATION (WORKER SUBSET)
# ==============================================================================
MEMORY_BACKEND=distributed
MEMORY_CACHE_ONLY=true
MEMORY_SYNC_INTERVAL=30

# RuVector Worker Node
RUVECTOR_ENABLED=true
RUVECTOR_MODE=worker
RUVECTOR_PORT=7890
RUVECTOR_COORDINATOR=orchestrator.tail-net.ts.net:7000

# ruvector (read-only sync)
ruvector_ENABLED=true
ruvector_PATH=.ruvector/worker-3060.db
ruvector_SYNC_FROM=orchestrator.tail-net.ts.net:7000
ruvector_READ_ONLY=false

# ==============================================================================
# NETWORKING
# ==============================================================================
PC_NAME=worker-rtx3060
PC_ROLE=worker
LAN_IP=192.168.1.221
WAN_IP=TO_BE_SET
TAILSCALE_ENABLED=true
TAILSCALE_HOSTNAME=worker-3060
TAILSCALE_IP=100.83.23.49
MAC_ETHERNET=04-BF-1B-29-A3-F3
MAC_WIFI=C2-B3-B9-2F-4C-D2

# ==============================================================================
# MINIMAL API KEYS (FALLBACK ONLY)
# ==============================================================================
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
GOOGLE_API_KEY=${GOOGLE_API_KEY}

MODEL_ROUTING_PREFER_LOCAL=true
MODEL_ROUTING_FALLBACK_CLOUD=true

# ==============================================================================
# PERFORMANCE OPTIMIZATION
# ==============================================================================
NEURAL_OPTIMIZATION_ENABLED=true
NEURAL_FLASH_ATTENTION=true
NEURAL_QUANTIZATION=int8
NEURAL_BATCH_SIZE=16

GPU_MEMORY_FRACTION=0.85
GPU_ALLOW_GROWTH=true

# ==============================================================================
# MONITORING
# ==============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9093
PROMETHEUS_PUSH_GATEWAY=orchestrator.tail-net.ts.net:9090

# ==============================================================================
# REDUCED SECURITY
# ==============================================================================
AIDEFENCE_ENABLED=false
RATE_LIMITING_ENABLED=false

# ==============================================================================
# WORKER-SPECIFIC FEATURES
# ==============================================================================
WORKER_SPECIALIZATION=coding
WORKER_CAPABILITIES=codellama-34b,qwen2.5-32b,gemma2-27b,starcoder2-15b
