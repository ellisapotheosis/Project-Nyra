# Development Environment Configuration
NODE_ENV=development
DEVELOPMENT_MODE=true

# Local Package Linking
LOCAL_CLAUDE_FLOW=C:\Dev\Projects\Repos\Project-Nyra\submodules\archon-os
LOCAL_ARCHON=C:\Dev\Projects\Repos\Project-Nyra\submodules\archon

# MCP Server Configuration
MCP_ENABLE_LOCAL_PACKAGES=true
MCP_HOT_RELOAD=true
MCP_LOG_LEVEL=debug

# Claude Flow Development Settings
CLAUDE_FLOW_ENABLE_DEV_MODE=true
CLAUDE_FLOW_DEV_PATH=C:\Dev\Projects\Repos\Project-Nyra\submodules\archon-os

# Archon Development Settings
ARCHON_ENABLE_DEV_MODE=true
ARCHON_DEV_PATH=C:\Dev\Projects\Repos\Project-Nyra\submodules\archon

# Port Configuration
DEV_PORT=3000
MCP_SERVER_PORT=8080
CLAUDE_FLOW_PORT=8081
ARCHON_PORT=8082

# Source Maps and Debugging
ENABLE_SOURCE_MAPS=true
DEBUG=project-nyra:*
