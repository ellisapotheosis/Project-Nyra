# ============================================================================
# PROJECT NYRA - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Version: 1.0.0
# Purpose: Template for environment variables across all 4 PCs
#
# INSTRUCTIONS:
#   1. Copy this file to .env in project root
#   2. Fill in all values marked with <REQUIRED>
#   3. Optional values can be left blank or removed
#   4. Never commit .env to version control
#   5. Use Infisical for production secret management
#
# SECURITY:
#   - Treat this file as sensitive
#   - Use strong passwords (16+ characters)
#   - Rotate secrets regularly
#   - Use different values per environment (dev/staging/prod)
# ============================================================================

# ----------------------------------------------------------------------------
# INFISICAL SECRETS MANAGEMENT
# ----------------------------------------------------------------------------
# Get these values from: https://app.infisical.com/project/<your-project>
INFISICAL_PROJECT_ID=8374cea9-e5e8-4050-bda4-b91f25ab30ef

# Universal Auth credentials (for CI/CD and automated access)
# Get from: Infisical Dashboard → Settings → Machine Identities
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=<REQUIRED>
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=<REQUIRED>

# Environment path structure per PC
# /nyra/orchestrator/{development,staging,production}
# /nyra/worker-1/{development,staging,production}
# /nyra/worker-2/{development,staging,production}
# /nyra/worker-3/{development,staging,production}
# /nyra/shared/{development,staging,production}

# ----------------------------------------------------------------------------
# PC IDENTIFICATION (Auto-discovered by GUI installer)
# ----------------------------------------------------------------------------
# Leave blank - GUI installer will set these automatically
NYRA_PC_ID=
NYRA_PC_ROLE=
NYRA_ENVIRONMENT=development

# ----------------------------------------------------------------------------
# LLM API KEYS
# ----------------------------------------------------------------------------
# Anthropic Claude (Required for core functionality)
ANTHROPIC_API_KEY=<REQUIRED>

# OpenRouter (For multi-model routing)
OPENROUTER_API_KEY=<REQUIRED>

# Google Gemini 2.0 (Cost optimization for routine tasks)
GOOGLE_GEMINI_API_KEY=<REQUIRED>

# OpenAI (Optional - for GPT-4 fallback)
OPENAI_API_KEY=

# ----------------------------------------------------------------------------
# NEXUS ROUTER CONFIGURATION (Port 6000)
# ----------------------------------------------------------------------------
NEXUS_PORT=6000
NEXUS_LOG_LEVEL=info
NEXUS_ENABLE_TELEMETRY=true

# ----------------------------------------------------------------------------
# TWENTYCRM DATABASE (Port 3000)
# ----------------------------------------------------------------------------
# PostgreSQL connection
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=twentycrm
POSTGRES_USER=twentycrm
POSTGRES_PASSWORD=<REQUIRED>

# TwentyCRM application
TWENTY_CRM_PORT=3000
TWENTY_CRM_SECRET_KEY=<REQUIRED>

# ----------------------------------------------------------------------------
# LETTA MEMORY SERVER (Port 8283)
# ----------------------------------------------------------------------------
LETTA_PORT=8283
LETTA_LOG_LEVEL=info
LETTA_ENABLE_AUTH=true
LETTA_API_KEY=<REQUIRED>

# ----------------------------------------------------------------------------
# MEM0 UNIVERSAL MEMORY (Port 4321)
# ----------------------------------------------------------------------------
MEM0_PORT=4321
MEM0_REDIS_URL=redis://redis:6379/1

# ----------------------------------------------------------------------------
# N8N WORKFLOW AUTOMATION (Port 5678)
# ----------------------------------------------------------------------------
N8N_PORT=5678
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=<REQUIRED>
N8N_ENCRYPTION_KEY=<REQUIRED>

# ----------------------------------------------------------------------------
# DIFY CHAT INTERFACE (Port 3001)
# ----------------------------------------------------------------------------
DIFY_PORT=3001
DIFY_SECRET_KEY=<REQUIRED>
DIFY_DB_USERNAME=dify
DIFY_DB_PASSWORD=<REQUIRED>

# ----------------------------------------------------------------------------
# OBSERVABILITY STACK
# ----------------------------------------------------------------------------
# Prometheus (Port 9090)
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=90d

# Grafana (Port 3005)
GRAFANA_PORT=3005
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<REQUIRED>

# Loki (Port 3100)
LOKI_PORT=3100

# ----------------------------------------------------------------------------
# REDIS CACHE (Port 6379)
# ----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_PASSWORD=<REQUIRED>
REDIS_MAXMEMORY=2gb

# ----------------------------------------------------------------------------
# CLOUDFLARE TUNNELS
# ----------------------------------------------------------------------------
# Get from: Cloudflare Dashboard → Zero Trust → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=<REQUIRED>
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# Tunnel names per PC (auto-configured during bootstrap)
CLOUDFLARE_TUNNEL_NAME=

# ----------------------------------------------------------------------------
# MORTGAGE AUTOMATION APIS
# ----------------------------------------------------------------------------
# Twilio (SMS/Voice campaigns)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SendGrid (Email campaigns)
SENDGRID_API_KEY=

# LenderPrice (Rate comparisons)
LENDERPRICE_API_KEY=

# ----------------------------------------------------------------------------
# GITHUB INTEGRATION
# ----------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=Project-Nyra

# ----------------------------------------------------------------------------
# DOCKER CONFIGURATION
# ----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=nyra
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# ----------------------------------------------------------------------------
# APPLICATION SETTINGS
# ----------------------------------------------------------------------------
# RateHunter public site
RATEHUNTER_PORT=3100
RATEHUNTER_DOMAIN=ratehunter.net

# Nyra Admin internal dashboard
NYRA_ADMIN_PORT=3101
NYRA_ADMIN_DOMAIN=app.projectnyra.com

# Quote Engine API
QUOTE_ENGINE_PORT=8001

# Campaign Engine API
CAMPAIGN_ENGINE_PORT=8002

# ----------------------------------------------------------------------------
# DEVELOPMENT / DEBUGGING
# ----------------------------------------------------------------------------
DEBUG=false
LOG_LEVEL=info
ENABLE_TELEMETRY=true

# ----------------------------------------------------------------------------
# BACKUP CONFIGURATION
# ----------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=

# ============================================================================
# NOTES
# ============================================================================
#
# PORT ALLOCATION STANDARD:
#   6000 - Nexus Router (LLM Gateway)
#   3000 - TwentyCRM (System of Record)
#   3001 - Dify (Chat Interface)
#   3005 - Grafana (Monitoring)
#   3100 - Loki (Logs) / RateHunter (Public Site)
#   3101 - Nyra Admin (Internal Dashboard)
#   5678 - n8n (Workflows)
#   8001 - Quote Engine API
#   8002 - Campaign Engine API
#   8283 - Letta (Memory Server)
#   4321 - Mem0 (Universal Memory)
#   9090 - Prometheus (Metrics)
#   6379 - Redis (Cache)
#   5432 - PostgreSQL (Database)
#
# SECURITY BEST PRACTICES:
#   - Generate strong random passwords: openssl rand -base64 32
#   - Use different passwords for each service
#   - Rotate secrets every 90 days minimum
#   - Store production secrets only in Infisical
#   - Enable MFA on all external services (Cloudflare, Twilio, etc.)
#
# TROUBLESHOOTING:
#   - Verify all <REQUIRED> fields are filled
#   - Check port conflicts: netstat -ano | findstr ":<port>"
#   - Test Infisical connection: infisical secrets list
#   - Validate syntax: docker compose config
#
# ============================================================================
