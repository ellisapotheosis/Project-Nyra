# Project Nyra - Shared Environment Variables
# These variables are the SAME across all machines
# Upload to Infisical: /shared path

# ==========================================
# Database Configuration
# ==========================================
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_USER=nyra
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_DB=nyra_production

# Database Names for Services
LETTA_DB_NAME=letta_db
TWENTY_DB_NAME=twenty_db
DIFY_DB_NAME=dify_db
N8N_DB_NAME=n8n_db

# Database URL
DATABASE_URL=postgresql://nyra:CHANGE_ME_SECURE_PASSWORD@postgresql:5432/nyra_production

# ==========================================
# Redis Configuration
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_MAX_MEMORY=4GB
REDIS_EVICTION_POLICY=allkeys-lru
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379

# Redis Database Allocation (Database isolation)
NEXUS_REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
CLAUDE_FLOW_REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/1
ARCHON_REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/2

# ==========================================
# FalkorDB Configuration
# ==========================================
FALKORDB_PORT=6380
FALKORDB_PASSWORD=CHANGE_ME_FALKORDB_PASSWORD
FALKORDB_AOF_SYNC=everysec
FALKORDB_MAX_MEMORY=2GB

# ==========================================
# Qdrant Configuration
# ==========================================
QDRANT_PORT=6333
QDRANT_API_KEY=CHANGE_ME_QDRANT_KEY

# ==========================================
# Letta Configuration
# ==========================================
LETTA_API_URL=http://localhost:8283
LETTA_DB_PASSWORD=CHANGE_ME_LETTA_DB_PASSWORD
LETTA_POSTGRES_URI=postgresql://letta:CHANGE_ME_LETTA_DB_PASSWORD@postgresql:5432/letta
LETTA_SERVER_PASSWORD=CHANGE_ME_LETTA_SERVER_PASSWORD

# ==========================================
# Claude Flow Configuration
# ==========================================
CLAUDE_FLOW_PORT=9000
CLAUDE_FLOW_MODE=orchestrator
CLAUDE_FLOW_PERFORMANCE_MODE=optimized
CLAUDE_FLOW_TELEMETRY_ENABLED=true
CLAUDE_FLOW_AUTO_COMMIT=true
CLAUDE_FLOW_HOOKS_ENABLED=true
CLAUDE_FLOW_NEURAL_OPTIMIZATION=true

# ==========================================
# Archon Configuration
# ==========================================
# Supabase Configuration (REQUIRED for Archon)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Archon Service Ports
ARCHON_SERVER_PORT=8181
ARCHON_MCP_PORT=8051
ARCHON_AGENTS_PORT=8052
ARCHON_UI_PORT=3737
ARCHON_PORT=8092
ARCHON_MCP_PORT=8093
ARCHON_TOPOLOGY=hierarchical
ARCHON_MAX_DEPTH=5
ARCHON_PARALLEL_BRANCHES=10

# Archon Feature Flags
ARCHON_AGENTS_ENABLED=false
ARCHON_ENABLE_WORK_ORDERS=false
ARCHON_ENABLED=true

# Archon Integration URLs
USE_NEXUS_ROUTER=true
NEXUS_ROUTER_URL=http://nexus-router:6000
CLAUDE_FLOW_MCP_URL=http://nyra-archon-os:3010/mcp
ARCHON_BASE_URL=http://archon-os:8092
ARCHON_MCP_URL=http://archon-os:8092/mcp
ARCHON_METRICS_URL=http://archon-os:8093/metrics

# ==========================================
# Nexus Router Configuration
# ==========================================
NEXUS_ROUTER_PORT=8000
NEXUS_ROUTER_MCP_PORT=4001
MODEL_ROUTING_STRATEGY=cost-optimized
MODEL_ROUTING_PREFER_LOCAL=true
MODEL_ROUTING_FALLBACK_CLOUD=true
MODEL_ROUTING_COST_THRESHOLD=0.10

# Nexus JWT & Admin
NEXUS_JWT_SECRET=CHANGE_ME_JWT_SECRET
NEXUS_ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN

# ==========================================
# AI Provider API Keys
# ==========================================
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=4096

OPENROUTER_API_KEY=sk-or-v1-CHANGE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-r1

OPENAI_API_KEY=sk-proj-CHANGE_ME

GOOGLE_API_KEY=CHANGE_ME
GOOGLE_GEMINI_API_KEY=CHANGE_ME

# ==========================================
# GitHub Configuration
# ==========================================
GITHUB_TOKEN=github_pat_CHANGE_ME
GH_PAT=github_pat_CHANGE_ME
GITHUB_PAT_TOKEN=github_pat_CHANGE_ME
GITHUB_OWNER=your-github-username
GITHUB_REPO=Project-Nyra

# ==========================================
# General Configuration
# ==========================================
NODE_ENV=production
LOG_LEVEL=info
