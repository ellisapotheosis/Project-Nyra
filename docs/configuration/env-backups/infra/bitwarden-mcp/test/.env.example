# Bitwarden MCP Test Configuration

# BWS Access Token (required)
# Get from: Bitwarden Web Vault → Organizations → Settings → Machine Accounts
BWS_ACCESS_TOKEN=0.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Test Configuration
TEST_CONTAINER_NAME=nyra-bitwarden-mcp
TEST_MCP_PORT=8007
TEST_TIMEOUT=10000

# Optional: Test Secret IDs
# These can be used for integration tests
TEST_SECRET_ID=00000000-0000-0000-0000-000000000000
TEST_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Logging
LOG_LEVEL=debug
