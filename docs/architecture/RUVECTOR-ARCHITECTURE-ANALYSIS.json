  "ewc_implementation": {
    "name": "Elastic Weight Consolidation++",
    "purpose": "Prevent catastrophic forgetting during continual learning",
    "algorithm": {
      "fisher_information_matrix": "Tracks importance of each parameter",
      "optimal_weights": "Stores best weights from previous tasks",
      "penalty_calculation": "lambda/2 * sum(fisher[i] * (w[i] - w_optimal[i])^2)"
    },
    "parameters": {
      "lambda": 5000,
      "gamma": 0.9,
      "online_update": true
    },
    "implementation": ".claude/agents/v3/memory-specialist.md (EWCPlusPlusManager class)",
    "workflow": [
      "Compute Fisher Information for existing memories",
      "Store optimal weights before learning new task",
      "Add EWC penalty to loss during new learning",
      "Update Fisher Information online (EWC++)",
      "Consolidate memories while protecting important patterns"
    ],
    "benefits": [
      "No forgetting of old tasks",
      "Continuous learning capability",
      "Task-aware importance weighting",
      "Online adaptation (gamma decay)"
    ]
  },
