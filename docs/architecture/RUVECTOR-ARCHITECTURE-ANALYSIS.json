      "ReasoningBank Intelligence Pipeline"
    ]
  },
  "intelligence_pipeline": {
    "name": "4-Step ReasoningBank Pipeline",
    "stages": [
      {
        "step": 1,
        "name": "RETRIEVE",
        "description": "Fetch relevant patterns via HNSW-indexed vector search",
        "technology": "HNSW (Hierarchical Navigable Small World)",
        "performance": "150x-12,500x faster than linear search",
        "latency": "<5ms for 1M vectors",
        "implementation": "services/ruvector-search/src/index/index-manager.ts",
        "mcp_tools": ["memory_search", "memory_analytics"],
        "key_features": [
          "Logarithmic search complexity O(log n)",
          "Configurable M (connections per layer): 8-32",
          "Configurable ef_search (search quality): 50-200",
          "SIMD-accelerated distance calculations"
        ]
      },
      {
        "step": 2,
        "name": "JUDGE",
        "description": "Evaluate trajectories with success/failure verdicts",
        "purpose": "Assign quality scores to agent operations",
        "implementation": ".claude/agents/v3/reasoningbank-learner.md",
        "trajectory_tracking": {
          "start": "npx archon-os@v3alpha hooks intelligence trajectory-start",
          "step": "npx archon-os@v3alpha hooks intelligence trajectory-step",
          "end": "npx archon-os@v3alpha hooks intelligence trajectory-end"
        },
        "verdict_types": ["success", "failure"],
        "reward_range": "0.0-1.0",
        "latency": "<1ms"
      },
      {
        "step": 3,
        "name": "DISTILL",
        "description": "Extract key learnings via LoRA adaptation",
        "technology": "LoRA (Low-Rank Adaptation)",
        "parameter_reduction": "99%",
        "training_speedup": "10-100x",
        "rank_options": [2, 4, 8, 16],
        "micro_lora": {
          "rank": 2,
          "latency": "0.447ms per vector",
          "throughput": "2211 ops/sec"
        },
        "implementation": ".claude/agents/sona/sona-learning-optimizer.md",
        "quality_improvements": {
          "code": "+5.0%",
          "creative": "+4.3%",
          "reasoning": "+3.6%",
          "chat": "+2.1%",
          "math": "+1.2%"
        }
      },
      {
        "step": 4,
        "name": "CONSOLIDATE",
        "description": "Prevent catastrophic forgetting via EWC++",
        "technology": "Elastic Weight Consolidation++",
        "purpose": "Preserve important learned patterns while learning new ones",
        "fisher_information": "Tracks parameter importance",
        "lambda": 5000,
        "gamma": 0.9,
        "implementation": ".claude/agents/v3/memory-specialist.md (lines 686-793)",
        "consolidation_frequency": "automatic background process"
      }
    ],
    "data_flow": "User Task → RETRIEVE patterns → JUDGE execution → DISTILL learnings → CONSOLIDATE memory → Enhanced Agent"
  },
