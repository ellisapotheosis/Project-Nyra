# npm Configuration - Performance Optimized
# Last Updated: 2026-01-21
# This is an npm-compatible version of the npmrc file

# ===== CORE SETTINGS =====
# Legacy peer dependencies for compatibility
legacy-peer-deps=false

# ===== PERFORMANCE OPTIMIZATIONS =====
# Parallel processing
maxsockets=16

# Enable side-effects cache for faster installs
cache-min=86400

# ===== CACHING =====
# Fetch timeout
fetch-timeout=60000
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# ===== LOGGING =====
# Reduce noise in CI
loglevel=warn

# ===== REGISTRY =====
# Registry settings
registry=https://registry.npmjs.org/

# ===== ENGINE SETTINGS =====
# Engine strict mode
engine-strict=false

# Save exact versions
save-exact=false
