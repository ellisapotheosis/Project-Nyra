{
  "mcpServers": {
    "retired orchestration tooling": {
      "command": "docker",
      "args": [
        "exec",
        "-i",
        "nyra-retired orchestration tooling-mcp",
        "npx",
        "@retired orchestration tooling/cli@latest",
        "mcp",
        "start"
      ],
      "env": {
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "15",
        "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid"
      },
      "autoStart": false
    },
    "sequential-thinking": {
      "command": "docker",
      "args": [
        "exec",
        "-i",
        "nyra-sequential-thinking-mcp",
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "env": {
        "ENABLE_REVISIONS": "true",
        "ENABLE_BRANCHING": "true",
        "ENABLE_DYNAMIC_ADJUSTMENT": "true",
        "MAX_THOUGHTS": "100",
        "MAX_BRANCHES": "10",
        "LOG_LEVEL": "info"
      },
      "autoStart": false
    },
    "dockerhub": {
      "command": "docker",
      "args": [
        "exec",
        "-i",
        "nyra-dockerhub-mcp",
        "node",
        "src/mcp-server.js"
      ],
      "env": {
        "MCP_PORT": "8007",
        "DOCKERHUB_NAMESPACE": "projectnyra",
        "LOG_LEVEL": "info",
        "CACHE_TTL": "300",
        "RATE_LIMIT": "100"
      },
      "autoStart": false
    },
    "docker-mcp": {
      "command": "docker",
      "args": [
        "exec",
        "-i",
        "nyra-docker-mcp",
        "node",
        "dist/index.js"
      ],
      "env": {
        "NODE_ENV": "production",
        "LOG_LEVEL": "info",
        "DOCKER_HOST": "unix:///var/run/docker.sock"
      },
      "autoStart": false
    }
  }
}