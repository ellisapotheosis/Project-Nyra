# Claude Flow V3 Runtime Configuration - OPTIMIZED
# Last Updated: 2026-01-19
# Project: Nyra - Distributed AI Multi-Agent Orchestration

version: "3.0.0"

# Swarm Orchestration (Optimized for 35 agents)
swarm:
  topology: hierarchical-mesh
  maxAgents: 35
  minAgents: 5
  autoScale: true
  scaleThreshold: 0.8
  coordinationStrategy: raft
  faultTolerance: byzantine
  adaptiveTopology: true
  heartbeatInterval: 3000
  taskQueueSize: 200

# Memory System (Optimized for 150x-12,500x speedup)
memory:
  type: hybrid
  enableHNSW: true
  persistPath: .claude-flow/data
  cacheSize: 1024
  maxEntries: 50000
  ttl: 604800
  compression: true
  quantization:
    enabled: true
    bits: 8
    memoryReduction: 0.75
  hnsw:
    m: 32
    ef: 400
    efConstruction: 400
    efSearch: 200
    numThreads: 8
    distanceMetric: cosine

# Neural Intelligence (SONA + EWC++ + Flash Attention)
neural:
  enabled: true
  modelPath: .claude-flow/neural
  sona:
    enabled: true
    adaptationTime: 0.05
    learningRate: 0.001
  ewc:
    enabled: true
    lambda: 0.5
    preventForgetting: true
  moe:
    enabled: true
    experts: 12
    topK: 3
    loadBalancing: true
  flashAttention:
    enabled: true
    targetSpeedup: 5.0
    memoryEfficient: true
  lora:
    enabled: true
    rank: 8
    alpha: 16

# Hooks & Learning System
hooks:
  enabled: true
  autoExecute: true
  learning: true
  pretrainOnStart: true
  autoOptimize: true
  workers:
    enabled: true
    concurrent: 4
    types:
      - optimize
      - audit
      - testgaps
      - document
      - map
  reasoningBank:
    enabled: true
    trajectoryTracking: true
    verdictJudgment: true
    patternDistillation: true

# MCP Server Configuration
mcp:
  autoStart: true
  port: 3000
  host: localhost
  keepAlive: true
  timeout: 30000
  reconnect: true
  maxReconnectAttempts: 5
  compression: true

# Performance Optimization
performance:
  tokenOptimization:
    enabled: true
    targetReduction: 0.5
    compressionLevel: high
  caching:
    enabled: true
    aggressiveCaching: true
    predictivePreload: true
  parallelization:
    maxThreads: 16
    ioThreads: 8
    taskSplitting: true
  gc:
    enabled: true
    interval: 300000
    aggressive: false

# Load Balancing
loadBalancing:
  strategy: least-connection
  healthCheckInterval: 15000
  maxLoad: 0.85
  predictiveScaling: true
  workStealing: true
  affinityBased: true

# Coordination
coordination:
  mode: hybrid
  maxRetries: 5
  retryDelay: 5000
  backoffMultiplier: 1.5
  deadlockDetection: true
  timeoutEscalation: true
  circuitBreaker:
    enabled: true
    threshold: 5
    timeout: 30000
    resetTimeout: 180000

# Security
security:
  mode: strict
  inputValidation: true
  pathValidation: true
  commandSanitization: true
  sandboxing: true
  cve:
    autoScan: true
    remediation: automatic
    alertLevel: medium
  rateLimit:
    enabled: true
    maxRequests: 5000
    windowMs: 60000
    burstLimit: 100
    adaptive: true

# Monitoring & Alerts
monitoring:
  enabled: true
  metricsInterval: 30000
  detailedMetrics: true
  predictiveAlerts: true
  anomalyDetection: true
  alertThresholds:
    errorRate: 0.03
    responseTime: 3000
    memoryUsage: 0.85
    cpuUsage: 0.8
    queueDepth: 150

# Logging (Optimized for performance)
logging:
  level: warn
  format: json
  destination: file
  filePath: ./logs/claude-flow.log
  maxFileSize: 500MB
  maxFiles: 5
  compress: true
  async: true
  sampling:
    enabled: true
    rate: 0.1

# Provider Routing (3-Tier with Haiku)
providers:
  default: anthropic
  fallback:
    - openai
    - google
  routing:
    useHaiku: true
    haikuModel: claude-3-5-haiku-20241022
    costOptimization: true
    complexityThreshold: 0.6
  anthropic:
    model: claude-sonnet-4-5-20250929
    maxTokens: 16384
    streamingEnabled: true

# Experimental Features
experimental:
  quantumResistant: false
  distributedMemory: true
  edgeComputing: false
  hybridCloud: false
