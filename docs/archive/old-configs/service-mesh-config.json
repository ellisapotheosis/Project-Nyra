{
  "serviceMesh": {
    "name": "Nyra Service Mesh",
    "version": "1.0.0",
    "description": "Comprehensive service mesh for MCP ecosystem integration",
    "architecture": {
      "type": "mesh",
      "pattern": "sidecar-proxy",
      "communication": "grpc+stdio+http",
      "discovery": "dns+consul",
      "loadBalancing": "round-robin+least-connections"
    },
    "services": {
      "nexus-router": {
        "name": "Nexus Router Gateway",
        "address": "localhost:6000",
        "protocol": "http+stdio",
        "role": "unified-gateway",
        "dependencies": ["consul", "jaeger"],
        "sidecar": {
          "proxy": "envoy",
          "port": 6100,
          "config": "/etc/envoy/nexus-router.yaml"
        }
      },
      "archon-mcp": {
        "name": "Archon MCP",
        "address": "localhost:8081",
        "protocol": "grpc+stdio",
        "role": "coordination-service",
        "dependencies": ["redis", "sqlite"],
        "sidecar": {
          "proxy": "envoy",
          "port": 8181,
          "config": "/etc/envoy/archon.yaml"
        }
      },
      "claude-flow-mcp": {
        "name": "Claude-Flow MCP",
        "address": "localhost:8082",
        "protocol": "stdio",
        "role": "workflow-service",
        "dependencies": ["redis", "sqlite"],
        "sidecar": {
          "proxy": "envoy",
          "port": 8182,
          "config": "/etc/envoy/claude-flow.yaml"
        }
      },
      "nyra-orchestrator": {
        "name": "Nyra Orchestrator",
        "address": "localhost:8083",
        "protocol": "grpc+http",
        "role": "compute-orchestrator",
        "dependencies": ["cloudflared", "wake-on-lan"],
        "sidecar": {
          "proxy": "envoy",
          "port": 8183,
          "config": "/etc/envoy/nyra.yaml"
        }
      },
      "infisical-mcp": {
        "name": "Infisical MCP",
        "address": "localhost:8084",
        "protocol": "http",
        "role": "secrets-service",
        "dependencies": ["vault"],
        "sidecar": {
          "proxy": "envoy",
          "port": 8184,
          "config": "/etc/envoy/infisical.yaml"
        }
      }
    },
    "networking": {
      "communication": {
        "interService": {
          "protocol": "grpc",
          "tls": true,
          "mTLS": true,
          "compression": "gzip"
        },
        "external": {
          "protocol": "https",
          "rateLimiting": true,
          "authentication": "jwt"
        }
      },
      "discovery": {
        "type": "hybrid",
        "dns": {
          "enabled": true,
          "domain": "nyra.local",
          "ttl": 30
        },
        "consul": {
          "enabled": true,
          "address": "localhost:8500",
          "datacenter": "nyra-dc1"
        }
      },
      "loadBalancing": {
        "algorithms": ["round-robin", "least-connections", "weighted"],
        "healthChecks": {
          "enabled": true,
          "interval": "10s",
          "timeout": "5s",
          "retries": 3
        },
        "circuitBreaker": {
          "enabled": true,
          "failureThreshold": 5,
          "timeout": "30s"
        }
      }
    },
    "security": {
      "authentication": {
        "type": "multi-factor",
        "methods": ["jwt", "ed25519", "mtls"],
        "tokenExpiry": 3600,
        "refreshEnabled": true
      },
      "authorization": {
        "type": "rbac+abac",
        "policies": [
          {
            "name": "admin-policy",
            "subjects": ["admin"],
            "actions": ["*"],
            "resources": ["*"]
          },
          {
            "name": "orchestrator-policy",
            "subjects": ["orchestrator"],
            "actions": ["read", "write", "execute"],
            "resources": ["agents", "swarms", "gpu-clusters"]
          },
          {
            "name": "worker-policy",
            "subjects": ["worker"],
            "actions": ["read", "execute"],
            "resources": ["tasks", "compute-resources"]
          }
        ]
      },
      "encryption": {
        "inTransit": {
          "protocol": "TLS 1.3",
          "cipherSuites": ["ECDHE-ECDSA-AES256-GCM-SHA384"],
          "certificateRotation": "auto"
        },
        "atRest": {
          "algorithm": "AES-256-GCM",
          "keyRotation": "weekly"
        }
      },
      "secrets": {
        "management": "infisical+vault",
        "rotation": "automatic",
        "distribution": "secure-channel"
      }
    },
    "observability": {
      "monitoring": {
        "metrics": {
          "collection": "prometheus",
          "retention": "30d",
          "scrapeInterval": "15s"
        },
        "alerting": {
          "manager": "alertmanager",
          "rules": "/etc/prometheus/rules/",
          "receivers": ["slack", "email", "webhook"]
        }
      },
      "logging": {
        "aggregation": "fluentd",
        "storage": "elasticsearch",
        "retention": "90d",
        "format": "structured-json"
      },
      "tracing": {
        "system": "jaeger",
        "sampling": {
          "type": "probabilistic",
          "param": 0.1
        },
        "storage": "elasticsearch"
      },
      "dashboards": {
        "platform": "grafana",
        "templates": [
          "service-overview",
          "performance-metrics",
          "error-tracking",
          "capacity-planning"
        ]
      }
    },
    "resilience": {
      "faultTolerance": {
        "patterns": ["circuit-breaker", "retry", "timeout", "bulkhead"],
        "gracefulDegradation": true,
        "cascadingFailureProtection": true
      },
      "backup": {
        "strategy": "3-2-1",
        "frequency": "hourly",
        "retention": "30d",
        "encryption": true
      },
      "disaster-recovery": {
        "rpo": "1h",
        "rto": "4h",
        "sites": ["primary", "secondary"],
        "automation": true
      }
    },
    "deployment": {
      "strategy": "blue-green",
      "orchestrator": "docker-compose+kubernetes",
      "scaling": {
        "type": "horizontal+vertical",
        "triggers": ["cpu", "memory", "request-rate"],
        "automation": true
      },
      "environments": {
        "development": {
          "replicas": 1,
          "resources": "minimal"
        },
        "staging": {
          "replicas": 2,
          "resources": "medium"
        },
        "production": {
          "replicas": 3,
          "resources": "optimized"
        }
      }
    }
  }
}