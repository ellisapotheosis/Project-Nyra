{
  "nyraOrchestrator": {
    "name": "Nyra Orchestrator",
    "version": "1.0.0",
    "description": "GPU compute cluster orchestration and mortgage workflow automation",
    "configuration": {
      "server": {
        "host": "localhost",
        "port": 8083,
        "protocol": "grpc+http",
        "maxConnections": 200,
        "timeout": 60000
      },
      "gpuCluster": {
        "orchestrator": {
          "name": "Minisforum UH680",
          "role": "coordinator",
          "specs": {
            "cpu": "Ryzen 7 6800H",
            "memory": "16GB DDR5",
            "storage": "1TB SSD"
          },
          "capabilities": [
            "task-coordination",
            "resource-allocation",
            "worker-management",
            "wake-on-lan",
            "cloudflared-tunnels"
          ]
        },
        "workers": [
          {
            "id": "worker-1",
            "name": "Alienware M15R7",
            "role": "gpu-compute",
            "specs": {
              "gpu": "RTX 3060",
              "memory": "16GB",
              "cpu": "Intel i7"
            },
            "capabilities": [
              "ml-training",
              "inference",
              "parallel-processing"
            ],
            "networking": {
              "tunnel": "worker1.nyra.local",
              "wol": {
                "mac": "00:11:22:33:44:55",
                "ip": "192.168.1.101"
              }
            }
          },
          {
            "id": "worker-2",
            "name": "Alienware Area-51",
            "role": "high-performance-compute",
            "specs": {
              "gpu": "RTX 5090",
              "memory": "32GB",
              "cpu": "Intel i9"
            },
            "capabilities": [
              "heavy-ml-training",
              "high-performance-inference",
              "large-model-processing"
            ],
            "networking": {
              "tunnel": "worker2.nyra.local",
              "wol": {
                "mac": "00:11:22:33:44:66",
                "ip": "192.168.1.102"
              }
            }
          },
          {
            "id": "worker-3",
            "name": "Desktop PC",
            "role": "gpu-compute",
            "specs": {
              "gpu": "RTX 3090Ti",
              "memory": "32GB",
              "cpu": "AMD Ryzen 9"
            },
            "capabilities": [
              "ml-training",
              "inference",
              "data-processing"
            ],
            "networking": {
              "tunnel": "worker3.nyra.local",
              "wol": {
                "mac": "00:11:22:33:44:77",
                "ip": "192.168.1.103"
              }
            }
          }
        ]
      },
      "cloudCompute": {
        "oracle-vps": {
          "enabled": true,
          "apiKey": "${KOYEB_API_KEY}",
          "region": "us-east-1",
          "instances": [
            {
              "name": "nyra-worker-cloud-1",
              "type": "micro",
              "image": "nyra/worker:latest"
            }
          ]
        }
      },
      "networking": {
        "cloudflaredTunnels": {
          "enabled": true,
          "config": "/etc/cloudflared/config.yml",
          "tunnels": [
            {
              "name": "nyra-main",
              "hostname": "nyra.ratehunter.net",
              "service": "http://localhost:8080"
            },
            {
              "name": "nyra-workers",
              "hostname": "workers.nyra.ratehunter.net",
              "service": "http://localhost:8083"
            }
          ]
        },
        "wakeOnLan": {
          "enabled": true,
          "broadcastAddress": "192.168.1.255",
          "retryAttempts": 3,
          "timeout": 30000
        }
      },
      "mortgageWorkflows": {
        "n8nIntegration": {
          "enabled": true,
          "endpoint": "http://localhost:5678",
          "webhooks": {
            "leadCapture": "/webhook/lead-capture",
            "statusUpdate": "/webhook/status-update",
            "documentRequest": "/webhook/document-request"
          }
        },
        "workflows": {
          "leadDripCampaign": {
            "enabled": true,
            "channels": ["email", "sms", "voice", "voicemail"],
            "frequency": "daily",
            "duration": "30-days",
            "templates": {
              "email": "/templates/drip-email.html",
              "sms": "/templates/drip-sms.txt",
              "voice": "/templates/drip-voice.mp3",
              "voicemail": "/templates/drip-voicemail.mp3"
            }
          },
          "documentTracking": {
            "enabled": true,
            "requiredDocuments": [
              "application",
              "income-verification",
              "asset-statements",
              "credit-report",
              "property-appraisal"
            ],
            "reminders": {
              "frequency": "every-3-days",
              "escalation": "after-2-weeks"
            }
          },
          "statusNotifications": {
            "enabled": true,
            "stages": [
              "application-received",
              "processing",
              "underwriting",
              "conditional-approval",
              "clear-to-close",
              "funding"
            ],
            "channels": ["email", "sms", "portal"]
          },
          "leadDistribution": {
            "enabled": true,
            "strategy": "round-robin",
            "criteria": {
              "loanAmount": "range",
              "creditScore": "minimum",
              "geography": "state",
              "propertyType": "category"
            },
            "routing": {
              "brokers": ["broker-1", "broker-2", "broker-3"],
              "loadBalancing": true
            }
          }
        }
      },
      "resourceAllocation": {
        "scheduling": {
          "algorithm": "priority-based",
          "factors": [
            "task-complexity",
            "deadline",
            "resource-requirements",
            "worker-availability"
          ]
        },
        "loadBalancing": {
          "strategy": "least-loaded",
          "healthChecks": true,
          "failover": true
        },
        "scaling": {
          "auto": true,
          "triggers": [
            "queue-length",
            "resource-utilization",
            "response-time"
          ],
          "cooldown": 300000
        }
      },
      "monitoring": {
        "metrics": {
          "collection": "real-time",
          "types": [
            "gpu-utilization",
            "memory-usage",
            "task-completion-rate",
            "network-latency",
            "power-consumption"
          ]
        },
        "alerts": {
          "enabled": true,
          "thresholds": {
            "gpu-utilization": 90,
            "memory-usage": 85,
            "task-failure-rate": 5,
            "response-time": 5000
          },
          "channels": ["email", "slack", "webhook"]
        }
      },
      "security": {
        "authentication": {
          "type": "ed25519+jwt",
          "keyRotation": "weekly"
        },
        "authorization": {
          "type": "rbac",
          "roles": [
            {
              "name": "orchestrator",
              "permissions": ["cluster:manage", "worker:control", "mortgage:admin"]
            },
            {
              "name": "worker",
              "permissions": ["task:execute", "status:report"]
            },
            {
              "name": "mortgage-admin",
              "permissions": ["workflow:manage", "lead:access"]
            }
          ]
        },
        "encryption": {
          "inTransit": "TLS 1.3",
          "atRest": "AES-256-GCM"
        }
      },
      "integration": {
        "nexusRouter": {
          "enabled": true,
          "registration": "automatic",
          "healthReporting": true,
          "note": "Uses Nexus Router unified gateway (replaces MetaMCP per ADR-002)"
        },
        "archonMcp": {
          "enabled": true,
          "memorySharing": true,
          "taskCoordination": true
        },
        "claudeFlow": {
          "enabled": true,
          "sparcIntegration": true,
          "swarmCoordination": true
        },
        "ratehunterNet": {
          "enabled": true,
          "domain": "ratehunter.net",
          "subdomain": "nyra.ratehunter.net",
          "ssl": true,
          "cdn": "cloudflare"
        }
      }
    },
    "apis": {
      "cluster": {
        "status": "/api/v1/cluster/status",
        "workers": "/api/v1/cluster/workers",
        "wake": "/api/v1/cluster/wake",
        "shutdown": "/api/v1/cluster/shutdown"
      },
      "tasks": {
        "submit": "/api/v1/tasks/submit",
        "status": "/api/v1/tasks/status",
        "results": "/api/v1/tasks/results",
        "cancel": "/api/v1/tasks/cancel"
      },
      "mortgage": {
        "leads": "/api/v1/mortgage/leads",
        "workflows": "/api/v1/mortgage/workflows",
        "documents": "/api/v1/mortgage/documents",
        "status": "/api/v1/mortgage/status"
      },
      "monitoring": {
        "metrics": "/api/v1/monitoring/metrics",
        "health": "/api/v1/monitoring/health",
        "alerts": "/api/v1/monitoring/alerts"
      }
    }
  }
}