# Archon Integration Environment Variables
# Copy this to .env and configure with your actual values

# ==========================================
# REQUIRED: Supabase Configuration
# ==========================================
# Get these from: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # MUST be service_role key!

# ==========================================
# REQUIRED: AI Provider (at least one)
# ==========================================
# OpenAI (recommended)
OPENAI_API_KEY=sk-proj-...

# OR Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# OR Google Gemini
GOOGLE_API_KEY=AIzaSy...

# OR Local Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ==========================================
# Service Ports (defaults shown)
# ==========================================
ARCHON_SERVER_PORT=8181
ARCHON_MCP_PORT=8051
ARCHON_AGENTS_PORT=8052
ARCHON_UI_PORT=3737
HOST=localhost

# ==========================================
# Feature Flags
# ==========================================
# Enable AI agents service (requires more resources)
ARCHON_AGENTS_ENABLED=false

# Enable agent work orders (automated PR creation)
ARCHON_ENABLE_WORK_ORDERS=false

# Production mode (API proxy through UI port)
PROD=false

# ==========================================
# Nexus Router Integration
# ==========================================
# Route all LLM requests through Nexus Router
USE_NEXUS_ROUTER=true
NEXUS_ROUTER_URL=http://nexus-router:6000

# ==========================================
# Logging Configuration
# ==========================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
VITE_SHOW_DEVTOOLS=false  # Show React Query devtools

# ==========================================
# Optional: GitHub Integration
# ==========================================
# For agent work orders and PR automation
# Requires: repo + workflow scopes
GITHUB_PAT_TOKEN=ghp_...

# ==========================================
# Optional: Debug Logging
# ==========================================
LOGFIRE_TOKEN=...  # For Logfire debug logging

# ==========================================
# Network Configuration
# ==========================================
# Additional allowed hosts for CORS
VITE_ALLOWED_HOSTS=localhost,127.0.0.1,archon.localhost
