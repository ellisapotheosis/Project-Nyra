# Development container for Nyra project
# Based on Microsoft's devcontainer base image with additional tools

ARG NODE_VERSION=24.11.0
ARG PYTHON_VERSION=3.11

FROM mcr.microsoft.com/devcontainers/base:ubuntu-22.04

# Set build arguments
ARG NODE_VERSION
ARG PYTHON_VERSION

# Avoid prompts from apt
ENV DEBIAN_FRONTEND=noninteractive

# Update and install system dependencies
RUN apt-get update && apt-get install -y \
    # Essential build tools
    build-essential \
    curl \
    wget \
    git \
    ca-certificates \
    gnupg \
    lsb-release \
    software-properties-common \
    # Development tools
    vim \
    nano \
    jq \
    tree \
    htop \
    net-tools \
    sqlite3 \
    # Database clients
    postgresql-client \
    redis-tools \
    # Python dependencies
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    # Node.js dependencies
    nodejs \
    npm \
    # Additional utilities
    zip \
    unzip \
    tar \
    gzip \
    && rm -rf /var/lib/apt/lists/*

# Install Docker CLI (for Docker-in-Docker)
RUN curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null \
    && apt-get update \
    && apt-get install -y docker-ce-cli docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

# Create vscode user (if not exists)
RUN if ! id -u vscode > /dev/null 2>&1; then \
        groupadd --gid 1000 vscode \
        && useradd --uid 1000 --gid vscode --shell /bin/bash --create-home vscode \
        && echo 'vscode ALL=NOPASSWD: ALL' >> /etc/sudoers.d/50-vscode; \
    fi

# Switch to vscode user
USER vscode
WORKDIR /home/vscode

# Install Node.js via nvm
ENV NVM_DIR="/home/vscode/.nvm"
RUN curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.0/install.sh | bash \
    && bash -c "source $NVM_DIR/nvm.sh && nvm install $NODE_VERSION && nvm use $NODE_VERSION && nvm alias default $NODE_VERSION"

# Add nvm and node to PATH
ENV PATH="$NVM_DIR/versions/node/v$NODE_VERSION/bin:$PATH"

# Install global npm packages
RUN bash -c "source $NVM_DIR/nvm.sh && nvm use $NODE_VERSION && npm install -g \
    pnpm \
    yarn \
    nodemon \
    ts-node \
    typescript \
    @types/node \
    prettier \
    eslint"

# Install Python packages
RUN pip3 install --user --upgrade pip setuptools wheel

# Install Infisical CLI
RUN curl -1sLf 'https://dl.cloudsmith.io/public/infisical/infisical-cli/setup.deb.sh' | sudo -E bash \
    && sudo apt-get update \
    && sudo apt-get install -y infisical \
    && sudo rm -rf /var/lib/apt/lists/*

# Install GitHub CLI
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | sudo dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && sudo chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && sudo apt-get update \
    && sudo apt-get install gh -y \
    && sudo rm -rf /var/lib/apt/lists/*

# Create workspace directory
WORKDIR /workspace

# Set up shell environment
RUN echo 'export NVM_DIR="$HOME/.nvm"' >> ~/.bashrc \
    && echo '[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"' >> ~/.bashrc \
    && echo '[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"' >> ~/.bashrc \
    && echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.bashrc

# Configure git defaults (will be overridden by volume mounts)
RUN git config --global init.defaultBranch main \
    && git config --global core.autocrlf false \
    && git config --global core.eol lf \
    && git config --global pull.rebase false \
    && git config --global user.name "Nyra Developer" \
    && git config --global user.email "developer@nyra.local"

# Create common directories
RUN mkdir -p /workspace/{logs,cache,temp,config,scripts}

# Set proper permissions
RUN sudo chown -R vscode:vscode /workspace

# Default command
CMD ["/bin/bash"]