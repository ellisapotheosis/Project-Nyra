# Claude Flow MCP Server
FROM node:24.11.0-alpine AS base

# Install system dependencies
RUN apk add --no-cache \
    curl \
    git \
    bash \
    python3 \
    py3-pip \
    build-base \
    tini

# Create app user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S claude-flow -u 1001

# Set working directory
WORKDIR /app

# Install Claude Flow globally
RUN npm install -g claude-flow@alpha

# Create necessary directories
RUN mkdir -p {config,cache,.claude-flow,logs} && \
    chown -R claude-flow:nodejs /app

# Switch to app user
USER claude-flow

# Initialize Claude Flow with SPARC
RUN claude-flow init --sparc

# Copy configuration files
COPY --chown=claude-flow:nodejs config/ ./config/

# Expose MCP port
EXPOSE 8003

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8003/health || exit 1

# Use tini as entrypoint
ENTRYPOINT ["/sbin/tini", "--"]

# Start Claude Flow MCP server
CMD ["claude-flow", "mcp", "start", "--port", "8003", "--host", "0.0.0.0"]