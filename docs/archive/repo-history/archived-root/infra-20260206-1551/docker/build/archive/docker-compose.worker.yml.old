version: '3.8'

networks:
  nyra-net:
    driver: bridge
    ipam:
      config:
        - subnet: 172.20.0.0/16

volumes:
  twentycrm-data:
  postgres-twentycrm-data:
  n8n-data:
  dify-data:
  postgres-dify-data:
  redis-worker-data:
  ollama-data:
  neo4j-data:
  falkordb-data:
  prometheus-data:
  grafana-data:
  loki-data:

services:
  # Configuration varies by worker role
  # Worker 2 (RTX 3060): TwentyCRM, n8n, Dify, Redis, PostgreSQL
  # Worker 3 (RTX 5090): Ollama, Neo4j, FalkorDB, Weaviate
  # Worker 4 (RTX 3090 Ti): Prometheus, Grafana, Loki, Alertmanager

  # TwentyCRM - CRM System (Worker 2)
  twentycrm:
    image: twentycrm/twenty:latest
    container_name: twentycrm
    ports:
      - "3000:3000"
    environment:
      - DATABASE_URL=postgresql://twentycrm:${TWENTYCRM_PG_PASSWORD}@postgres-twentycrm:5432/twentycrm
      - REDIS_URL=redis://:${REDIS_PASSWORD}@redis-worker:6379
      - JWT_SECRET=${TWENTYCRM_JWT_SECRET}
      - APP_URL=http://${LAN_IP}:3000
      - STORAGE_TYPE=local
      - STORAGE_LOCAL_PATH=/app/data
    volumes:
      - twentycrm-data:/app/data
    networks:
      - nyra-net
    depends_on:
      - postgres-twentycrm
      - redis-worker
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
    profiles:
      - worker-2

  postgres-twentycrm:
    image: pgvector/pgvector:pg16
    container_name: postgres-twentycrm
    environment:
      - POSTGRES_DB=twentycrm
      - POSTGRES_USER=twentycrm
      - POSTGRES_PASSWORD=${TWENTYCRM_PG_PASSWORD}
    volumes:
      - postgres-twentycrm-data:/var/lib/postgresql/data
    networks:
      - nyra-net
    restart: unless-stopped
    profiles:
      - worker-2

  # n8n - Workflow Automation (Worker 2)
  n8n:
    image: n8nio/n8n:latest
    container_name: n8n
    ports:
      - "5678:5678"
    environment:
      - DB_TYPE=postgresdb
      - DB_POSTGRESDB_HOST=postgres-n8n
      - DB_POSTGRESDB_PORT=5432
      - DB_POSTGRESDB_DATABASE=n8n
      - DB_POSTGRESDB_USER=n8n
      - DB_POSTGRESDB_PASSWORD=${N8N_PG_PASSWORD}
      - N8N_BASIC_AUTH_ACTIVE=true
      - N8N_BASIC_AUTH_USER=${N8N_USER}
      - N8N_BASIC_AUTH_PASSWORD=${N8N_PASSWORD}
      - WEBHOOK_URL=http://${LAN_IP}:5678
      - GENERIC_TIMEZONE=America/New_York
    volumes:
      - n8n-data:/home/node/.n8n
    networks:
      - nyra-net
    depends_on:
      - postgres-n8n
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:5678/healthz"]
      interval: 30s
      timeout: 10s
      retries: 3
    profiles:
      - worker-2

  postgres-n8n:
    image: postgres:16-alpine
    container_name: postgres-n8n
    environment:
      - POSTGRES_DB=n8n
      - POSTGRES_USER=n8n
      - POSTGRES_PASSWORD=${N8N_PG_PASSWORD}
    volumes:
      - n8n-data:/var/lib/postgresql/data
    networks:
      - nyra-net
    restart: unless-stopped
    profiles:
      - worker-2

  # Dify - Chat UI (Worker 2)
  dify:
    image: langgenius/dify-api:latest
    container_name: dify-api
    ports:
      - "3001:5001"
    environment:
      - MODE=api
      - DB_USERNAME=dify
      - DB_PASSWORD=${DIFY_PG_PASSWORD}
      - DB_HOST=postgres-dify
      - DB_PORT=5432
      - DB_DATABASE=dify
      - REDIS_HOST=redis-worker
      - REDIS_PORT=6379
      - REDIS_PASSWORD=${REDIS_PASSWORD}
      - SECRET_KEY=${DIFY_SECRET_KEY}
      - LOG_LEVEL=${LOG_LEVEL:-INFO}
    volumes:
      - dify-data:/app/api/storage
    networks:
      - nyra-net
    depends_on:
      - postgres-dify
      - redis-worker
    restart: unless-stopped
    profiles:
      - worker-2

  dify-web:
    image: langgenius/dify-web:latest
    container_name: dify-web
    ports:
      - "3002:3000"
    environment:
      - NEXT_PUBLIC_API_URL=http://${LAN_IP}:3001
      - NEXT_PUBLIC_CONSOLE_URL=http://${LAN_IP}:3002
    networks:
      - nyra-net
    depends_on:
      - dify
    restart: unless-stopped
    profiles:
      - worker-2

  postgres-dify:
    image: pgvector/pgvector:pg16
    container_name: postgres-dify
    environment:
      - POSTGRES_DB=dify
      - POSTGRES_USER=dify
      - POSTGRES_PASSWORD=${DIFY_PG_PASSWORD}
    volumes:
      - postgres-dify-data:/var/lib/postgresql/data
    networks:
      - nyra-net
    restart: unless-stopped
    profiles:
      - worker-2

  # Redis (Worker 2)
  redis-worker:
    image: redis:7-alpine
    container_name: redis-worker
    ports:
      - "6379:6379"
    command: redis-server --requirepass ${REDIS_PASSWORD}
    volumes:
      - redis-worker-data:/data
    networks:
      - nyra-net
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "redis-cli", "--raw", "incr", "ping"]
      interval: 30s
      timeout: 10s
      retries: 3
    profiles:
      - worker-2

  # Ollama - Local LLM Inference (Worker 3)
  ollama:
    image: ollama/ollama:latest
    container_name: ollama
    ports:
      - "11434:11434"
    environment:
      - OLLAMA_HOST=0.0.0.0
      - OLLAMA_NUM_PARALLEL=4
      - OLLAMA_MAX_LOADED_MODELS=3
    volumes:
      - ollama-data:/root/.ollama
    networks:
      - nyra-net
    restart: unless-stopped
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
    profiles:
      - worker-3

  # Neo4j - Graph Database (Worker 3)
  neo4j:
    image: neo4j:5
    container_name: neo4j
    ports:
      - "7474:7474"
      - "7687:7687"
    environment:
      - NEO4J_AUTH=neo4j/${NEO4J_PASSWORD}
      - NEO4J_PLUGINS=["graph-data-science", "apoc"]
      - NEO4J_dbms_memory_heap_max__size=4G
      - NEO4J_dbms_memory_pagecache_size=2G
    volumes:
      - neo4j-data:/data
    networks:
      - nyra-net
    restart: unless-stopped
    profiles:
      - worker-3

  # FalkorDB - Knowledge Graph (Worker 3)
  falkordb:
    image: falkordb/falkordb:latest
    container_name: falkordb
    ports:
      - "6379:6379"
    volumes:
      - falkordb-data:/data
    networks:
      - nyra-net
    restart: unless-stopped
    profiles:
      - worker-3

  # Prometheus - Metrics (Worker 4)
  prometheus:
    image: prom/prometheus:latest
    container_name: prometheus
    ports:
      - "9090:9090"
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--storage.tsdb.retention.time=30d'
    volumes:
      - ../monitoring/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml
      - prometheus-data:/prometheus
    networks:
      - nyra-net
    restart: unless-stopped
    profiles:
      - worker-4

  # Grafana - Dashboards (Worker 4)
  grafana:
    image: grafana/grafana:latest
    container_name: grafana
    ports:
      - "3005:3000"
    environment:
      - GF_SECURITY_ADMIN_USER=${GRAFANA_USER}
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_PASSWORD}
      - GF_SERVER_ROOT_URL=http://${LAN_IP}:3005
    volumes:
      - ../monitoring/grafana/provisioning:/etc/grafana/provisioning
      - grafana-data:/var/lib/grafana
    networks:
      - nyra-net
    depends_on:
      - prometheus
    restart: unless-stopped
    profiles:
      - worker-4

  # Loki - Log Aggregation (Worker 4)
  loki:
    image: grafana/loki:latest
    container_name: loki
    ports:
      - "3100:3100"
    command: -config.file=/etc/loki/local-config.yaml
    volumes:
      - ../monitoring/loki/config/loki-config.yml:/etc/loki/local-config.yaml
      - loki-data:/loki
    networks:
      - nyra-net
    restart: unless-stopped
    profiles:
      - worker-4

  # Promtail - Log Shipper (Worker 4)
  promtail:
    image: grafana/promtail:latest
    container_name: promtail
    command: -config.file=/etc/promtail/config.yml
    volumes:
      - ../monitoring/promtail/config/promtail-config.yml:/etc/promtail/config.yml
      - /var/log:/var/log:ro
      - /var/lib/docker/containers:/var/lib/docker/containers:ro
    networks:
      - nyra-net
    depends_on:
      - loki
    restart: unless-stopped
    profiles:
      - worker-4

  # Alertmanager - Alerts (Worker 4)
  alertmanager:
    image: prom/alertmanager:latest
    container_name: alertmanager
    ports:
      - "9093:9093"
    command:
      - '--config.file=/etc/alertmanager/alertmanager.yml'
      - '--storage.path=/alertmanager'
    volumes:
      - ../monitoring/alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml
    networks:
      - nyra-net
    restart: unless-stopped
    profiles:
      - worker-4
