# ============================================================================
# Project Nyra - Production Stack - Docker Compose
# ============================================================================
# Production-optimized configuration with:
# - Strict resource limits
# - Security hardening
# - Comprehensive health checks
# - Automatic restart policies
# - Optimized logging
# - Network isolation
# - Secret management integration
# - Production-grade observability
#
# Usage:
#   docker compose -f docker-compose.prod.yml up -d
#   docker compose -f docker-compose.prod.yml ps
#
# With Infisical (REQUIRED for production):
#   infisical run --projectId="8374cea9-e5e8-4050-bda4-b91f25ab30ef" \
#     --env="prod" --path="/shared" -- docker compose -f docker-compose.prod.yml up -d
#
# WARNING: Never run production without proper secret management!
# ============================================================================

version: '3.8'

networks:
  nyra-network:
    driver: bridge
    ipam:
      config:
        - subnet: 172.28.0.0/16
    driver_opts:
      com.docker.network.bridge.name: nyra-prod
      com.docker.network.bridge.enable_ip_masquerade: "true"
      com.docker.network.bridge.enable_icc: "false"

services:
  # ==========================================================================
  # DATABASE LAYER - Production Configuration
  # ==========================================================================

  postgresql:
    image: postgres:16-alpine
    container_name: nyra-postgres-prod
    restart: always
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
      POSTGRES_MULTIPLE_DATABASES: ${LETTA_DB_NAME},${TWENTY_DB_NAME},${DIFY_DB_NAME},${N8N_DB_NAME}
      PGDATA: /var/lib/postgresql/data/pgdata
      POSTGRES_INITDB_ARGS: "-E UTF8 --locale=en_US.UTF-8"
    volumes:
      - postgres_prod_data:/var/lib/postgresql/data
      - ./scripts/postgres-init:/docker-entrypoint-initdb.d:ro
      - ./backups/postgres:/backups
    ports:
      - "127.0.0.1:${POSTGRES_PORT:-5432}:5432"
    networks:
      - nyra-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER}"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "10"
        compress: "true"
    deploy:
      resources:
        limits:
          cpus: '4.0'
          memory: 8G
        reservations:
          cpus: '2.0'
          memory: 4G
    security_opt:
      - no-new-privileges:true
    read_only: false
    tmpfs:
      - /tmp
      - /run

  redis:
    image: redis:7-alpine
    container_name: nyra-redis-prod
    restart: always
    command: >
      redis-server
      --requirepass ${REDIS_PASSWORD}
      --maxmemory ${REDIS_MAX_MEMORY:-4gb}
      --maxmemory-policy allkeys-lru
      --appendonly yes
      --appendfsync everysec
      --auto-aof-rewrite-percentage 100
      --auto-aof-rewrite-min-size 64mb
      --loglevel notice
      --protected-mode yes
      --bind 0.0.0.0
    volumes:
      - redis_prod_data:/data
      - ./backups/redis:/backups
    ports:
      - "127.0.0.1:${REDIS_PORT:-6379}:6379"
    networks:
      - nyra-network
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "${REDIS_PASSWORD}", "ping"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "10"
        compress: "true"
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 4G
        reservations:
          cpus: '1.0'
          memory: 2G
    security_opt:
      - no-new-privileges:true

  falkordb:
    image: falkordb/falkordb:latest
    container_name: nyra-falkordb-prod
    restart: always
    command: >
      redis-server
      --requirepass ${FALKORDB_PASSWORD}
      --appendonly yes
      --appendfsync everysec
      --maxmemory ${FALKORDB_MAX_MEMORY:-8gb}
      --maxmemory-policy noeviction
      --loglevel notice
    volumes:
      - falkordb_prod_data:/data
      - ./backups/falkordb:/backups
    ports:
      - "127.0.0.1:${FALKORDB_PORT:-6380}:6379"
    networks:
      - nyra-network
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "${FALKORDB_PASSWORD}", "ping"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "10"
        compress: "true"
    deploy:
      resources:
        limits:
          cpus: '4.0'
          memory: 8G
        reservations:
          cpus: '2.0'
          memory: 4G
    security_opt:
      - no-new-privileges:true

  qdrant:
    image: qdrant/qdrant:latest
    container_name: nyra-qdrant-prod
    restart: always
    environment:
      QDRANT__SERVICE__API_KEY: ${QDRANT_API_KEY}
      QDRANT__SERVICE__GRPC_PORT: 6334
      QDRANT__STORAGE__STORAGE_PATH: /qdrant/storage
      QDRANT__STORAGE__PERFORMANCE__OPTIMIZERS_NUMBER: 4
      QDRANT__SERVICE__MAX_REQUEST_SIZE_MB: 32
      QDRANT__LOG_LEVEL: INFO
    volumes:
      - qdrant_prod_data:/qdrant/storage
      - ./backups/qdrant:/backups
    ports:
      - "127.0.0.1:${QDRANT_PORT:-6333}:6333"
      - "127.0.0.1:6334:6334"
    networks:
      - nyra-network
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:6333/health"]
      interval: 30s
      timeout: 15s
      retries: 5
      start_period: 60s
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "10"
        compress: "true"
    deploy:
      resources:
        limits:
          cpus: '4.0'
          memory: 8G
        reservations:
          cpus: '2.0'
          memory: 4G
    security_opt:
      - no-new-privileges:true

  # ==========================================================================
  # ORCHESTRATION LAYER - Production Configuration
  # ==========================================================================

  claude-flow:
    image: nyra/claude-flow:${CLAUDE_FLOW_VERSION:-latest}
    container_name: nyra-claude-flow-prod
    restart: always
    working_dir: /app
    environment:
      NODE_ENV: production
      PORT: ${CLAUDE_FLOW_PORT:-9000}
      LOG_LEVEL: info
      DATABASE_URL: ${DATABASE_URL}
      REDIS_URL: ${REDIS_URL}
      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY}
      OPENROUTER_API_KEY: ${OPENROUTER_API_KEY}
      CLAUDE_FLOW_MODE: ${CLAUDE_FLOW_MODE:-dual-orchestrator}
      CLAUDE_FLOW_TELEMETRY_ENABLED: "true"
      CLAUDE_FLOW_PERFORMANCE_MODE: production
      CLAUDE_FLOW_AUTO_COMMIT: "false"
      CLAUDE_FLOW_HOOKS_ENABLED: "true"
      CLAUDE_FLOW_NEURAL_OPTIMIZATION: "true"
      GITHUB_TOKEN: ${GITHUB_TOKEN}
      GITHUB_REPO: ${GITHUB_REPO}
      GITHUB_OWNER: ${GITHUB_OWNER}
      # Production Node.js optimizations
      NODE_OPTIONS: "--max-old-space-size=4096 --max-http-header-size=16384"
    volumes:
      - claude_flow_prod_data:/app/data
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./logs/claude-flow:/app/logs
    ports:
      - "127.0.0.1:${CLAUDE_FLOW_PORT:-9000}:${CLAUDE_FLOW_PORT:-9000}"
    networks:
      - nyra-network
    depends_on:
      postgresql:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:${CLAUDE_FLOW_PORT:-9000}/health"]
      interval: 30s
      timeout: 15s
      retries: 5
      start_period: 90s
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "10"
        compress: "true"
    deploy:
      resources:
        limits:
          cpus: '4.0'
          memory: 4G
        reservations:
          cpus: '2.0'
          memory: 2G
    security_opt:
      - no-new-privileges:true

  archon-os:
    image: nyra/archon-os:${ARCHON_VERSION:-latest}
    container_name: nyra-archon-os-prod
    restart: always
    working_dir: /app
    environment:
      NODE_ENV: production
      PORT: ${ARCHON_PORT:-9001}
      LOG_LEVEL: info
      DATABASE_URL: ${DATABASE_URL}
      REDIS_URL: ${REDIS_URL}
      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY}
      ARCHON_MCP_PORT: ${ARCHON_MCP_PORT:-9002}
      ARCHON_TOPOLOGY: ${ARCHON_TOPOLOGY:-hierarchical}
      ARCHON_MAX_DEPTH: ${ARCHON_MAX_DEPTH:-5}
      ARCHON_PARALLEL_BRANCHES: ${ARCHON_PARALLEL_BRANCHES:-10}
      NODE_OPTIONS: "--max-old-space-size=4096"
    volumes:
      - archon_prod_data:/app/data
      - ./logs/archon-os:/app/logs
    ports:
      - "127.0.0.1:${ARCHON_PORT:-9001}:${ARCHON_PORT:-9001}"
      - "127.0.0.1:${ARCHON_MCP_PORT:-9002}:${ARCHON_MCP_PORT:-9002}"
    networks:
      - nyra-network
    depends_on:
      postgresql:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:${ARCHON_PORT:-9001}/health"]
      interval: 30s
      timeout: 15s
      retries: 5
      start_period: 90s
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "10"
        compress: "true"
    deploy:
      resources:
        limits:
          cpus: '4.0'
          memory: 4G
        reservations:
          cpus: '2.0'
          memory: 2G
    security_opt:
      - no-new-privileges:true

  nexus-router:
    image: nyra/nexus-router:${NEXUS_VERSION:-latest}
    container_name: nyra-nexus-router-prod
    restart: always
    working_dir: /app
    environment:
      NODE_ENV: production
      PORT: ${NEXUS_ROUTER_PORT:-8000}
      LOG_LEVEL: info
      MCP_PORT: ${NEXUS_ROUTER_MCP_PORT:-4001}
      REDIS_URL: ${REDIS_URL}

      # GPU Workers
      WORKER_5090_URL: ${WORKER_5090_URL}
      WORKER_5090_MODELS: ${WORKER_5090_MODELS}
      WORKER_3090_URL: ${WORKER_3090_URL}
      WORKER_3090_MODELS: ${WORKER_3090_MODELS}
      WORKER_3060_URL: ${WORKER_3060_URL}
      WORKER_3060_MODELS: ${WORKER_3060_MODELS}

      # Cloud Fallbacks
      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY}
      ANTHROPIC_MODEL: ${ANTHROPIC_MODEL}
      OPENROUTER_API_KEY: ${OPENROUTER_API_KEY}
      OPENROUTER_BASE_URL: ${OPENROUTER_BASE_URL}

      # Routing
      MODEL_ROUTING_STRATEGY: ${MODEL_ROUTING_STRATEGY:-cost-optimized}
      MODEL_ROUTING_PREFER_LOCAL: ${MODEL_ROUTING_PREFER_LOCAL:-true}
      MODEL_ROUTING_FALLBACK_CLOUD: ${MODEL_ROUTING_FALLBACK_CLOUD:-true}
      MODEL_ROUTING_COST_THRESHOLD: ${MODEL_ROUTING_COST_THRESHOLD:-0.10}

      NODE_OPTIONS: "--max-old-space-size=2048"
    volumes:
      - nexus_router_prod_data:/app/data
      - ./logs/nexus-router:/app/logs
    ports:
      - "127.0.0.1:${NEXUS_ROUTER_PORT:-8000}:${NEXUS_ROUTER_PORT:-8000}"
      - "127.0.0.1:${NEXUS_ROUTER_MCP_PORT:-4001}:${NEXUS_ROUTER_MCP_PORT:-4001}"
    networks:
      - nyra-network
    depends_on:
      - redis
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:${NEXUS_ROUTER_PORT:-8000}/health"]
      interval: 30s
      timeout: 15s
      retries: 5
      start_period: 60s
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "10"
        compress: "true"
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 2G
        reservations:
          cpus: '1.0'
          memory: 1G
    security_opt:
      - no-new-privileges:true

  # ==========================================================================
  # AI SERVICES LAYER - Production Configuration
  # ==========================================================================

  letta:
    image: letta/letta:latest
    container_name: nyra-letta-prod
    restart: always
    environment:
      LETTA_SERVER_PASSWORD: ${LETTA_SERVER_PASSWORD}
      LETTA_POSTGRES_URI: ${LETTA_POSTGRES_URI}
      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY}
      LETTA_LLM_ENDPOINT: http://nexus-router:${NEXUS_ROUTER_PORT:-8000}/v1
      LETTA_LOG_LEVEL: INFO
    volumes:
      - letta_prod_data:/root/.letta
      - ./logs/letta:/root/.letta/logs
    ports:
      - "127.0.0.1:8283:8283"
      - "127.0.0.1:8284:8284"
    networks:
      - nyra-network
    depends_on:
      postgresql:
        condition: service_healthy
      nexus-router:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8283/health"]
      interval: 30s
      timeout: 15s
      retries: 5
      start_period: 60s
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "10"
        compress: "true"
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 4G
        reservations:
          cpus: '1.0'
          memory: 2G
    security_opt:
      - no-new-privileges:true

  open-webui:
    image: ghcr.io/open-webui/open-webui:main
    container_name: nyra-open-webui-prod
    restart: always
    environment:
      DATABASE_URL: ${DATABASE_URL}
      OPENAI_API_BASE_URL: http://nexus-router:${NEXUS_ROUTER_PORT:-8000}/v1
      OPENAI_API_KEY: ${ANTHROPIC_API_KEY}
      WEBUI_SECRET_KEY: ${SESSION_SECRET}
      # Production security settings
      ENABLE_SIGNUP: "false"
      ENABLE_RAG: "true"
      ENABLE_IMAGE_GENERATION: "false"
      ENABLE_COMMUNITY_SHARING: "false"
      WEBUI_AUTH: "true"
      LOG_LEVEL: INFO
      # Rate limiting
      RATE_LIMIT_ENABLED: "true"
      RATE_LIMIT_REQUESTS: 100
      RATE_LIMIT_WINDOW: 60
    volumes:
      - open_webui_prod_data:/app/backend/data
    ports:
      - "${OPEN_WEBUI_PORT:-3210}:8080"
    networks:
      - nyra-network
    depends_on:
      postgresql:
        condition: service_healthy
      nexus-router:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/health"]
      interval: 30s
      timeout: 15s
      retries: 5
      start_period: 60s
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "10"
        compress: "true"
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 2G
        reservations:
          cpus: '1.0'
          memory: 1G
    security_opt:
      - no-new-privileges:true

  # ==========================================================================
  # OBSERVABILITY LAYER - Production Configuration
  # ==========================================================================

  prometheus:
    image: prom/prometheus:latest
    container_name: nyra-prometheus-prod
    restart: always
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--web.console.libraries=/etc/prometheus/console_libraries'
      - '--web.console.templates=/etc/prometheus/consoles'
      - '--storage.tsdb.retention.time=90d'
      - '--storage.tsdb.retention.size=50GB'
      - '--web.enable-lifecycle'
      - '--web.enable-admin-api'
    volumes:
      - ./observability/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./observability/prometheus-alerts.yml:/etc/prometheus/alerts/alerts.yml:ro
      - prometheus_prod_data:/prometheus
    ports:
      - "127.0.0.1:9090:9090"
    networks:
      - nyra-network
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:9090/-/healthy"]
      interval: 30s
      timeout: 10s
      retries: 5
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "10"
        compress: "true"
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 4G
        reservations:
          cpus: '1.0'
          memory: 2G
    security_opt:
      - no-new-privileges:true

  grafana:
    image: grafana/grafana:latest
    container_name: nyra-grafana-prod
    restart: always
    environment:
      GF_SECURITY_ADMIN_USER: ${GRAFANA_ADMIN_USER}
      GF_SECURITY_ADMIN_PASSWORD: ${GRAFANA_ADMIN_PASSWORD}
      GF_INSTALL_PLUGINS: grafana-piechart-panel,grafana-clock-panel
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_SERVER_ROOT_URL: ${GRAFANA_ROOT_URL}
      GF_AUTH_ANONYMOUS_ENABLED: "false"
      GF_SECURITY_ALLOW_EMBEDDING: "false"
      GF_SECURITY_COOKIE_SECURE: "true"
      GF_SECURITY_STRICT_TRANSPORT_SECURITY: "true"
      GF_LOG_LEVEL: info
    volumes:
      - ./observability/grafana-datasources.yml:/etc/grafana/provisioning/datasources/datasources.yml:ro
      - ./observability/dashboards:/etc/grafana/provisioning/dashboards:ro
      - grafana_prod_data:/var/lib/grafana
    ports:
      - "${GRAFANA_PORT:-3000}:3000"
    networks:
      - nyra-network
    depends_on:
      - prometheus
      - loki
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:3000/api/health"]
      interval: 30s
      timeout: 10s
      retries: 5
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "10"
        compress: "true"
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 2G
        reservations:
          cpus: '1.0'
          memory: 1G
    security_opt:
      - no-new-privileges:true

  loki:
    image: grafana/loki:latest
    container_name: nyra-loki-prod
    restart: always
    command: -config.file=/etc/loki/local-config.yaml
    volumes:
      - ./observability/loki-config.yml:/etc/loki/local-config.yaml:ro
      - loki_prod_data:/loki
    ports:
      - "127.0.0.1:3100:3100"
    networks:
      - nyra-network
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:3100/ready"]
      interval: 30s
      timeout: 10s
      retries: 5
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "10"
        compress: "true"
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 4G
        reservations:
          cpus: '1.0'
          memory: 2G
    security_opt:
      - no-new-privileges:true

  promtail:
    image: grafana/promtail:latest
    container_name: nyra-promtail-prod
    restart: always
    command: -config.file=/etc/promtail/config.yml
    volumes:
      - ./observability/promtail-config.yml:/etc/promtail/config.yml:ro
      - /var/log:/var/log:ro
      - /var/lib/docker/containers:/var/lib/docker/containers:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./logs:/app/logs:ro
    networks:
      - nyra-network
    depends_on:
      - loki
    logging:
      driver: "json-file"
      options:
        max-size: "50m"
        max-file: "5"
        compress: "true"
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 1G
        reservations:
          cpus: '0.5'
          memory: 512M
    security_opt:
      - no-new-privileges:true

  alertmanager:
    image: prom/alertmanager:latest
    container_name: nyra-alertmanager-prod
    restart: always
    command:
      - '--config.file=/etc/alertmanager/config.yml'
      - '--storage.path=/alertmanager'
      - '--data.retention=120h'
    volumes:
      - ./observability/alertmanager.yml:/etc/alertmanager/config.yml:ro
      - alertmanager_prod_data:/alertmanager
    ports:
      - "127.0.0.1:9093:9093"
    networks:
      - nyra-network
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:9093/-/healthy"]
      interval: 30s
      timeout: 10s
      retries: 5
    logging:
      driver: "json-file"
      options:
        max-size: "50m"
        max-file: "5"
        compress: "true"
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 1G
        reservations:
          cpus: '0.5'
          memory: 512M
    security_opt:
      - no-new-privileges:true

  node-exporter:
    image: prom/node-exporter:latest
    container_name: nyra-node-exporter-prod
    restart: always
    command:
      - '--path.procfs=/host/proc'
      - '--path.sysfs=/host/sys'
      - '--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)'
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro
    ports:
      - "127.0.0.1:9100:9100"
    networks:
      - nyra-network
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
        compress: "true"
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 256M
        reservations:
          cpus: '0.25'
          memory: 128M
    security_opt:
      - no-new-privileges:true

  cadvisor:
    image: gcr.io/cadvisor/cadvisor:latest
    container_name: nyra-cadvisor-prod
    restart: always
    privileged: true
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
    ports:
      - "127.0.0.1:8080:8080"
    networks:
      - nyra-network
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
        compress: "true"
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 512M
        reservations:
          cpus: '0.5'
          memory: 256M

volumes:
  postgres_prod_data:
    driver: local
  redis_prod_data:
    driver: local
  falkordb_prod_data:
    driver: local
  qdrant_prod_data:
    driver: local
  claude_flow_prod_data:
    driver: local
  archon_prod_data:
    driver: local
  nexus_router_prod_data:
    driver: local
  letta_prod_data:
    driver: local
  open_webui_prod_data:
    driver: local
  prometheus_prod_data:
    driver: local
  grafana_prod_data:
    driver: local
  loki_prod_data:
    driver: local
  alertmanager_prod_data:
    driver: local
