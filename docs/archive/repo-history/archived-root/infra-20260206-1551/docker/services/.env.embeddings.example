# Embedding Services Configuration
# Copy to .env.embeddings and customize

# ====================================
# ONNX Runtime Configuration
# ====================================

# Batch size for ONNX inference (default: 8)
ONNX_BATCH_SIZE=8

# Quantization mode: fp32, fp16, int8 (default: fp16)
ONNX_QUANTIZATION=fp16

# CUDA device ID (default: 0)
CUDA_VISIBLE_DEVICES=0

# ====================================
# Xenova/Transformers Configuration
# ====================================

# Embedding model to use (default: Xenova/all-MiniLM-L6-v2)
# Options:
#   - Xenova/all-MiniLM-L6-v2 (fast, 384d)
#   - Xenova/multilingual-e5-small (multilingual, 384d)
#   - Xenova/bge-small-en-v1.5 (quality, 384d)
XENOVA_MODEL=Xenova/all-MiniLM-L6-v2

# Batch size for Xenova embeddings (default: 32)
XENOVA_BATCH_SIZE=32

# ====================================
# Logging Configuration
# ====================================

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# ====================================
# Network Configuration
# ====================================

# LAN IP for external access (optional)
LAN_IP=192.168.1.100

# ====================================
# Resource Limits
# ====================================

# ONNX Runtime
# CPU cores: 2-4 (reserved-limit)
# Memory: 4G-8G (reserved-limit)
# GPU: 1 device required

# Xenova Transformers
# CPU cores: 1-2 (reserved-limit)
# Memory: 2G-4G (reserved-limit)
# GPU: Not required (WASM SIMD acceleration)

# ====================================
# Model Cache
# ====================================

# ONNX models shared with claude-flow
# Path: ../../.claude-flow/models (auto-created)

# Xenova models
# Path: xenova-models volume (auto-created)

# ====================================
# Performance Tuning
# ====================================

# ONNX Runtime optimization
# - Graph optimization: ORT_ENABLE_ALL
# - CUDA memory limit: 10GB
# - CUDNN algorithm search: EXHAUSTIVE

# Xenova Transformers optimization
# - WASM SIMD: Enabled
# - Model quantization: Enabled
# - Pooling strategy: mean
# - Normalization: Configurable per request

# ====================================
# Health Check Configuration
# ====================================

# Health check intervals (seconds)
# ONNX: 30s interval, 60s start period
# Xenova: 30s interval, 90s start period (model download)

# ====================================
# Integration URLs
# ====================================

# ONNX Runtime API (internal)
ONNX_API_URL=http://onnx-runtime:8001

# Xenova Embeddings API (internal)
XENOVA_API_URL=http://xenova-embeddings:8002

# ====================================
# Notes
# ====================================

# 1. These services run ONLY on orchestrator PC
# 2. GPU workers handle full LLM inference via Ollama
# 3. ONNX requires NVIDIA GPU with CUDA 12+
# 4. Xenova uses WASM SIMD (CPU-based, no GPU needed)
# 5. First startup may take 90-120 seconds for model downloads
# 6. Models are cached after first download
