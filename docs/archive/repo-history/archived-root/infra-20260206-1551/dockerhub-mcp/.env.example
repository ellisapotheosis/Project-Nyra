# Docker Hub MCP Server Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Docker Hub Credentials (REQUIRED)
# =============================================================================
# Get your access token from: https://hub.docker.com/settings/security
DOCKERHUB_USERNAME=your-username
DOCKERHUB_TOKEN=dckr_pat_your_access_token_here
DOCKERHUB_NAMESPACE=projectnyra

# =============================================================================
# Infisical Configuration (REQUIRED for production)
# =============================================================================
# Get these from your Infisical project settings
INFISICAL_PROJECT_ID=your-project-id
INFISICAL_TOKEN=your-service-token

# =============================================================================
# MCP Server Configuration
# =============================================================================
MCP_PORT=8007
MCP_HOST=0.0.0.0

# =============================================================================
# Nyra Environment
# =============================================================================
NYRA_ENVIRONMENT=development
NYRA_PC_ID=orchestrator

# =============================================================================
# Service Settings
# =============================================================================
LOG_LEVEL=info
CACHE_TTL=300
RATE_LIMIT=100
ENABLE_METRICS=true

# =============================================================================
# Advanced Configuration (Optional)
# =============================================================================
# Docker socket path (for local Docker operations)
# DOCKER_SOCKET=/var/run/docker.sock

# Health check interval (seconds)
# HEALTH_CHECK_INTERVAL=30

# Request timeout (milliseconds)
# REQUEST_TIMEOUT=30000
