# ============================================================================
# Golden Stack Environment Variables
# ============================================================================
# These should be stored in Infisical under /shared path
# and injected via: infisical run -- docker compose up -d
# ============================================================================

# RuVector PostgreSQL
RUVECTOR_POSTGRES_USER=claude
RUVECTOR_POSTGRES_PASSWORD=generate-secure-password-here
RUVECTOR_POSTGRES_DB=claude_flow
RUVECTOR_PORT=5433

# Redis
REDIS_PASSWORD=generate-secure-password-here
REDIS_MAX_MEMORY=2gb
REDIS_PORT=6380

# FalkorDB (Graph Database for Zep)
FALKORDB_PASSWORD=generate-secure-password-here
FALKORDB_MAX_MEMORY=4gb
FALKORDB_PORT=6381

# Zep MCP
ZEP_API_KEY=your-zep-api-key-here
ZEP_GRAPH_NAME=nyra_knowledge
ZEP_MCP_PORT=8000
ZEP_EMBEDDING_MODEL=text-embedding-3-small

# Archon Configuration
ARCHON_DB_USER=archon
ARCHON_DB_PASSWORD=generate-secure-password-here
ARCHON_DB_NAME=archon
ARCHON_API_PORT=8181
ARCHON_UI_PORT=3737
ARCHON_MCP_PORT=8051
ARCHON_JWT_SECRET=generate-jwt-secret-here
ARCHON_API_KEY=generate-api-key-here

# Supabase (for Archon)
SUPABASE_URL=your-supabase-url-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# OpenAI (for embeddings)
OPENAI_API_KEY=your-openai-api-key-here

# General
NODE_ENV=production
