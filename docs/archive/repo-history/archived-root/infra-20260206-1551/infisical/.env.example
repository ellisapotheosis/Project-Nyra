# ============================================================================
# Infisical Integration Example - Project Nyra
# ============================================================================
# This file shows how to configure Infisical integration for your environment.
# Copy values to actual .env files (which are gitignored).
#
# DO NOT commit real secrets to git!
# ============================================================================

# ============================================================================
# Infisical Project Configuration
# ============================================================================

# Project ID (unique to your Infisical project)
INFISICAL_PROJECT_ID=8374cea9-e5e8-4050-bda4-b91f25ab30ef

# Environment (dev, staging, prod)
INFISICAL_ENVIRONMENT=dev

# Infisical API URL (Cloud or self-hosted)
INFISICAL_API_URL=https://app.infisical.com

# ============================================================================
# Machine Identity (Universal Auth)
# ============================================================================

# Machine Identity Client ID
# Create via: Infisical Dashboard → Organization → Machine Identities
INFISICAL_CLIENT_ID=your-machine-identity-client-id-here

# Machine Identity Client Secret
# Keep this secret! Only store in secure locations.
INFISICAL_CLIENT_SECRET=your-machine-identity-client-secret-here

# ============================================================================
# Path Configuration
# ============================================================================

# Default path for secrets (typically /shared for orchestrator)
INFISICAL_PATH=/shared

# Worker-specific paths (uncomment for worker PCs)
# INFISICAL_PATH=/worker-5090
# INFISICAL_PATH=/worker-3090
# INFISICAL_PATH=/worker-3060

# ============================================================================
# Agent Configuration
# ============================================================================

# Auto-sync interval in seconds (default: 60)
INFISICAL_SYNC_INTERVAL=60

# Clear outputs on exit (security feature, default: false)
INFISICAL_CLEAR_ON_EXIT=false

# Log level (info, debug, error)
INFISICAL_LOG_LEVEL=info

# ============================================================================
# Usage Examples
# ============================================================================

# Option 1: Use Infisical Agent (recommended)
# docker-compose -f infra/infisical/docker-compose.infisical.yml up -d

# Option 2: Use Infisical CLI directly
# infisical run --projectId=$INFISICAL_PROJECT_ID --env=$INFISICAL_ENVIRONMENT --path=$INFISICAL_PATH -- docker-compose up -d

# Option 3: Export to .env file
# infisical secrets export --projectId=$INFISICAL_PROJECT_ID --env=$INFISICAL_ENVIRONMENT --path=$INFISICAL_PATH > .env

# ============================================================================
# Security Notes
# ============================================================================

# 1. NEVER commit this file with real secrets to git
# 2. Use Machine Identity (Universal Auth) for CI/CD and Docker
# 3. Rotate secrets regularly via Infisical Dashboard
# 4. Grant least-privilege access (read-only for most services)
# 5. Use separate Machine Identities for different environments
# 6. Store credentials in secure secret stores (not plain text files)

# ============================================================================
# Multi-Machine Setup
# ============================================================================

# Orchestrator PC (PC1):
#   - INFISICAL_PATH=/shared
#   - Has access to all paths for coordination

# Worker RTX 5090 (PC3):
#   - INFISICAL_PATH=/shared,/worker-5090
#   - Reads shared + worker-specific configs

# Worker RTX 3090 Ti (PC4):
#   - INFISICAL_PATH=/shared,/worker-3090
#   - Reads shared + worker-specific configs

# Worker RTX 3060 (PC2):
#   - INFISICAL_PATH=/shared,/worker-3060
#   - Reads shared + worker-specific configs
