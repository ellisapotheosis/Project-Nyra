# Infisical env file (copy to infisical.env)
#
# Infisical requires several secrets and config values.
# Refer to the official docs for the complete list.

# REQUIRED
ENCRYPTION_KEY=generate_a_32_char_random_key
AUTH_SECRET=generate_a_long_random_secret
SITE_URL=http://localhost:8085

# OPTIONAL (but common)
TELEMETRY_ENABLED=false

# If you want Prometheus metrics
OTEL_TELEMETRY_COLLECTION_ENABLED=false
OTEL_EXPORT_TYPE=prometheus

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
