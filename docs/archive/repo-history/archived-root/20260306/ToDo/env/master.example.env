# =============================================================================
# Project Nyra – Master Environment Configuration
#
# This file aggregates **all** known environment variables used across the
# Project‑Nyra ecosystem.  It acts as a master reference and should be
# customised via Infisical or your own secrets manager.  Comments describe
# the purpose of each variable; values should be replaced with real
# credentials or endpoints.  Unused variables can be left blank or removed.
#
# The variables are grouped into functional sections.  Some sections may
# apply only when certain modules (e.g. Letta, OpenMemory, Ruvector) are
# enabled.  You can safely leave those sections blank if you are not
# activating the corresponding feature.
# =============================================================================

############################################
##  Infisical / Secrets Management
############################################

# Infisical project & client identifiers.  Use these to fetch secrets
# directly from Infisical at runtime.  Leave empty if you are not
# using Infisical.
INFISICAL_PROJECT_ID=
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
# Which environment to load (e.g. dev, staging, production).
INFISICAL_ENVIRONMENT=
# Optional: Path within Infisical to scope secrets (e.g. /nyra/production).
INFISICAL_PATH=

############################################
##  Claude Flow Core Settings
############################################

# Sets the overall execution context.  Valid values: orchestrator,
# worker, agent.  Use 'orchestrator' on the main controller PC.
CLAUDE_FLOW_MODE=
# Node environment (production|development|test).
NODE_ENV=production
# Enable or disable Claude Flow features.
CLAUDE_FLOW_ENABLED=true
CLAUDE_FLOW_AUTO_COMMIT=
CLAUDE_FLOW_AUTO_PUSH=
CLAUDE_FLOW_HOOKS_ENABLED=
CLAUDE_FLOW_TELEMETRY_ENABLED=
CLAUDE_FLOW_REMOTE_EXECUTION=
CLAUDE_FLOW_GITHUB_INTEGRATION=
CLAUDE_FLOW_CHECKPOINT_ENABLED=
CLAUDE_FLOW_CHECKPOINTS_ENABLED=
CLAUDE_FLOW_MEMORY_PERSISTENCE=
CLAUDE_FLOW_NEURAL_OPTIMIZATION=
CLAUDE_FLOW_AUTO_LEARNING=
CLAUDE_FLOW_PERFORMANCE_MODE=
CLAUDE_FLOW_CACHE_ENABLED=
CLAUDE_FLOW_PARALLEL_PROCESSING=
CLAUDE_FLOW_AGENT_POOL=
CLAUDE_FLOW_MCP_MODE=
CLAUDE_FLOW_TRUTH_THRESHOLD=
CLAUDE_FLOW_VERIFY_MODE=
CLAUDE_FLOW_SECURITY_AUDIT=
# If true, automatically create GitHub releases on major improvements.
CREATE_GH_RELEASE=

############################################
##  Port Configuration
############################################

# Port Claude Flow UI or API listens on.
PORT=3000
# Host address for web bindings (0.0.0.0 or localhost).
HOST=0.0.0.0
# Proxy port used when starting Claude Flow’s OpenRouter proxy.
PROXY_PORT=8080
# Custom port for the Nexus router (if used).  Default 8765.
NEXUS_PORT=
# AgentDB local server port (if running as a separate service).
AGENTDB_PORT=
# QUIC synchronisation port for AgentDB distributed sync.
QUIC_SYNC_PORT=

############################################
##  Swarm, Hive Mind & Ruv Swarm
############################################

# Global swarm topology: mesh, star, hierarchical, adaptive.
SWARM_TOPOLOGY=mesh
# Maximum number of concurrently running agents.
MAX_AGENTS=
# Enable advanced rUv Swarm orchestration.
RUV_SWARM_ENABLED=
RUV_SWARM_MODE=
RUV_SWARM_TOPOLOGY=
RUV_SWARM_MAX_AGENTS=
RUV_SWARM_WASM_ENABLED=
RUV_SWARM_NEURAL_ENABLED=
RUV_SWARM_DAA_ENABLED=
RUV_SWARM_MEMORY_MODE=
# Enable Hive Mind consensus engine.
HIVE_MIND_ENABLED=
HIVE_MIND_QUEEN_TYPE=
HIVE_MIND_ENABLE_CONSENSUS=
# Settings for Agentic Flow (flow orchestrator within Claude Flow).
AGENTIC_FLOW_MAX_AGENTS=
AGENTIC_FLOW_TOPOLOGY=
AGENTIC_FLOW_MEMORY_ENABLED=

############################################
##  Memory & Database Backends
############################################

# === AgentDB (primary persistent memory) ===
AGENTDB_ENABLED=
AGENTDB_PATH=.agentdb/claude-flow.db
AGENTDB_VECTOR_ENABLED=
AGENTDB_QUANTIZATION=scalar
AGENTDB_CACHE_ENABLED=
AGENTDB_CACHE_SIZE=
AGENTDB_HNSW_M=
AGENTDB_HNSW_EF=
AGENTDB_LEARNING=
AGENTDB_LEARNING_ALGORITHM=
AGENTDB_REASONING=
AGENTDB_QUIC_SYNC=
AGENTDB_QUIC_PORT=
AGENTDB_QUIC_PEERS=
AGENTDB_AUTO_MIGRATE=
AGENTDB_FALLBACK_LEGACY=

# === ReasoningBank (legacy memory) ===
REASONINGBANK_ENABLED=
REASONINGBANK_DB_PATH=.swarm/memory.db
REASONINGBANK_K=
REASONINGBANK_MIN_CONFIDENCE=

# === Mem0 (personalisation memory) ===
MEM0_ENABLED=
MEM0_API_KEY=

# === Qdrant (vector database) ===
QDRANT_ENABLED=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL=

# === RuVector (distributed high‑perf vector DB) ===
RUVECTOR_ENABLED=
RUVECTOR_URL=
RUVECTOR_AUTH_KEY=
RUVECTOR_MODE=
RUVECTOR_CONSENSUS=
RUVECTOR_CONSENSUS_PEERS=
RUVECTOR_GNN_LAYERS=
RUVECTOR_QUANTIZATION=
RUV_FAST_NETWORKING=

# === LettaAI (agent memory manager) ===
LETTA_ENABLED=
LETTA_API_URL=
LETTA_API_KEY=
LETTA_MEMORY_MANAGER=

# === Graphiti + Neo4j/FalkorDB (graph memory) ===
GRAPHITI_ENABLED=
GRAPHITI_BACKEND=
GRAPHITI_URI=
GRAPHITI_USER=
GRAPHITI_PASSWORD=
# FalkorDB Graph Key (used if Graphiti backend set to falkordb).
FALKORDB_URL=
FALKORDB_GRAPH_KEY=

# === OpenMemory (local‑first memory) ===
OPENMEMORY_ENABLED=
OPENMEMORY_API_URL=
OPENMEMORY_MCP_ENABLED=

# === Flow Nexus & Supabase (cloud hybrid memory) ===
FLOW_NEXUS_ENABLED=
FLOW_NEXUS_URL=
FLOW_NEXUS_API_KEY=
FLOW_NEXUS_USER_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
N8N_PROTOCOL=

############################################
##  LLM Providers & Proxies
############################################

# Primary provider keys; set your API credentials here.  Only one provider is
# required, but you may configure multiple for dynamic routing.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
# Default model and provider; adjust to your preferred model family.
COMPLETION_MODEL=
PROVIDER=anthropic
# Use OpenRouter or ONNX for local inference.
USE_OPENROUTER=
USE_ONNX=

############################################
##  GPU & Worker Configuration
############################################

# Endpoints for local GPU workers (Ollama/vLLM).  List each worker’s URL.
GPU_WORKER_1_URL=
GPU_WORKER_2_URL=
GPU_WORKER_3_URL=
GPU_WORKER_DEFAULT_MODEL=
# vLLM or ONNX-specific settings (if applicable).
VLLM_MODEL=
ONNX_MODEL_PATH=

############################################
##  Cloud & External Services
############################################

# GitHub integration (for commit & PR management).
GITHUB_TOKEN=
GITHUB_CHECKPOINT_BRANCH=
GITHUB_MEMORY_BACKUP_GISTS=
GITHUB_AUTO_ISSUE_ON_ERROR=
GITHUB_PR_ON_MAJOR_IMPROVEMENT=
GITHUB_SYNC_LEARNINGS=

# Slack notifications
SLACK_WEBHOOK_URL=

# Email SMTP configuration
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=

# Twilio & voice communications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# SendGrid email
SENDGRID_API_KEY=

# Cloud provider (AWS/GCP/Azure) & storage
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# Clerk (authentication) and other SaaS providers
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
REPLICATE_API_KEY=

############################################
##  Database & Cache
############################################

# PostgreSQL for Claude Flow (persist tasks, state).
DATABASE_URL=
# Redis for caching and pub/sub.  Used by various components including
# FalkorDB if using redisgraph.
REDIS_URL=
# Neo4j standalone (if Graphiti backend = neo4j).
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
# Local file cache TTL and connection pool sizes.
CACHE_TTL=
CONNECTION_POOL_SIZE=

############################################
##  Security & Rate Limiting
############################################

JWT_SECRET=
ENCRYPTION_KEY=
ALLOWED_ORIGINS=
RATE_LIMIT_WINDOW=
RATE_LIMIT_MAX=

############################################
##  Monitoring & Observability
############################################

PROMETHEUS_PORT=
GRAFANA_ADMIN_PASSWORD=
LOG_RETENTION_DAYS=
METRICS_RETENTION_DAYS=
ENABLE_METRICS=
ENABLE_TRACING=

############################################
##  Other Feature Flags & Advanced
############################################

# Agent Booster and acceleration features
AGENT_BOOSTER_ENABLED=
# Nexus Router & Flow Nexus advanced routing
NEXUS_ROUTER_ENABLED=
NEXUS_ROUTER_URL=
NEXUS_ROUTER_PORT=
# Dify/Flowise/Other UIs (if part of your stack)
DIFY_ENABLED=
FLOWISE_ENABLED=
OPEN_WEBUI_ENABLED=
# Additional memory backends or connectors (MemOS/memorytensors) can be
# configured here when wrappers are implemented.
