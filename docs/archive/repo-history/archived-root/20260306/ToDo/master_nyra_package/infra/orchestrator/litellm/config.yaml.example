# LiteLLM routing configuration for Project Nyra
#
# This file defines how the orchestrator’s LiteLLM server routes incoming
# requests to your worker nodes.  Copy this file to `config.yaml` and replace
# the Tailscale IP addresses with the actual IPs assigned to each worker.
# For details on available options, see the LiteLLM documentation.

model_list:
  # ------------------------------------------------------------
  # Local workers (vLLM + LMCache)
  #
  # Each entry below corresponds to a model hosted on one of your
  # workers.  The `api_base` should point at the OpenAI‑compatible
  # endpoint exposed by vLLM (e.g. http://100.x.y.z:8000/v1) or
  # Ollama (http://100.x.y.z:11434).  No API key is required for
  # local models, so we use a dummy `sk-no-key-needed` value.

  - model_name: deepseek-v3-2
    litellm_params:
      model: openai/deepseek-v3-2
      api_base: http://TAILSCALE_IP_RTX5090:${VLLM_PORT_5090:-8000}/v1
      api_key: sk-no-key-needed

  - model_name: deepseek-7b
    litellm_params:
      model: openai/deepseek-7b
      api_base: http://TAILSCALE_IP_RTX3090TI:${VLLM_PORT_3090TI:-8000}/v1
      api_key: sk-no-key-needed

  - model_name: ollama-model
    litellm_params:
      model: ollama/llama3
      api_base: http://TAILSCALE_IP_RTX3060:${OLLAMA_PORT:-11434}

  # ------------------------------------------------------------
  # Remote providers (optional)
  #
  # Uncomment and configure the entries below if you want to fall
  # back to cloud providers (OpenAI, Anthropic, Cohere, etc.).  You
  # should set the appropriate API keys in your orchestrator’s
  # environment (.env) file and optionally restrict usage with
  # `models` or `max_input_tokens`.

  #- model_name: openai-gpt-5
  #  litellm_params:
  #    model: gpt-5-turbo
  #    api_base: https://api.openai.com/v1
  #    api_key: ${OPENAI_API_KEY}
  #    max_input_tokens: 32768

  #- model_name: anthropic-sonnet
  #  litellm_params:
  #    model: anthropic/sonnet
  #    api_base: https://api.anthropic.com/v1
  #    api_key: ${ANTHROPIC_API_KEY}

# Experimental: global retry/backoff settings
general_settings:
  max_retries: 2
  timeout: 120
  cache: true

# End of file