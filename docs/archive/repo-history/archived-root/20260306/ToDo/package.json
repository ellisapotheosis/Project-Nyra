{
  "name": "project-nyra",
  "version": "1.0.0",
  "description": "Comprehensive 4-PC distributed mortgage automation platform with AI orchestration",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "src/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspaces",
    "start": "npm run start --workspaces",
    "test": "npm run test --workspaces",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "clean": "npm run clean --workspaces && rm -rf dist node_modules",
    "orchestrator-up": "docker-compose up -d nexus-router claude-flow-orchestrator postgres redis qdrant prometheus grafana",
    "orchestrator-down": "docker-compose down",
    "workers-up": "docker-compose --profile workers up -d",
    "workers-down": "docker-compose --profile workers down",
    "oracle-up": "docker-compose --profile oracle up -d",
    "oracle-down": "docker-compose --profile oracle down",
    "health-check": "bash infra/scripts/health-check.sh",
    "port-discovery": "bash infra/scripts/port-discovery.sh",
    "tunnel-setup": "bash infra/scripts/tunnel-setup.sh",
    "tunnel-start": "cloudflared tunnel --config infra/cloudflared/config.yml run",
    "verify-connectivity": "bash infra/scripts/verify-connectivity.sh",
    "bootstrap": "make bootstrap",
    "db-init": "make db-init",
    "db-backup": "make db-backup"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "pino": "^8.0.0",
    "redis": "^4.6.0"
  },
  "keywords": [
    "mortgage",
    "automation",
    "AI",
    "lending",
    "crm",
    "distributed",
    "orchestration"
  ],
  "author": "Team Nyra",
  "license": "UNLICENSED"
}
