{
  // Settings for Claude Flow orchestrator.  Only variables that you might
  // change at runtime are defined here; all other secrets and service
  // endpoints should be provided via the environment (.env or Infisical).
  "env": {
    // Core execution mode: orchestrator, worker or agent.
    "CLAUDE_FLOW_MODE": "orchestrator",
    // Enable/disable key Claude Flow features on the fly.
    "CLAUDE_FLOW_AUTO_COMMIT": "true",
    "CLAUDE_FLOW_AUTO_PUSH": "true",
    "CLAUDE_FLOW_HOOKS_ENABLED": "true",
    "CLAUDE_FLOW_GITHUB_INTEGRATION": "true",
    "CLAUDE_FLOW_MEMORY_PERSISTENCE": "true",
    "CLAUDE_FLOW_NEURAL_OPTIMIZATION": "true",
    "CLAUDE_FLOW_CACHE_ENABLED": "true",
    "CLAUDE_FLOW_PARALLEL_PROCESSING": "true",
    "CLAUDE_FLOW_AGENT_POOL": "true",
    "CLAUDE_FLOW_MCP_MODE": "advanced",
    "CLAUDE_FLOW_TRUTH_THRESHOLD": "0.95",
    "CLAUDE_FLOW_VERIFY_MODE": "strict",
    "CLAUDE_FLOW_SECURITY_AUDIT": "true",
    // Maximum number of agents and tasks.  Increase or decrease
    // depending on your hardware and workload.
    "MAX_AGENTS": "100",
    "CLAUDE_FLOW_MAX_CONCURRENT_TASKS": "50",
    // Enable or disable distributed consensus features.
    "RUV_SWARM_ENABLED": "true",
    "HIVE_MIND_ENABLED": "true",
    // Memory backends: toggle features as required.
    "AGENTDB_ENABLED": "true",
    "AGENTDB_QUIC_SYNC": "true",
    "RUVECTOR_ENABLED": "true",
    "RUVECTOR_MODE": "distributed",
    // Agentic Flow & Hive Mind (co‑ordination engines)
    "AGENTIC_FLOW_MEMORY_ENABLED": "true",
    "HIVE_MIND_ENABLE_CONSENSUS": "true",
    // Logging and monitoring toggles.
    "ENABLE_METRICS": "true",
    "ENABLE_TRACING": "true",
    "LOG_LEVEL": "info"
  },
  "permissions": {
    "allowHttp": true,
    "allowFileSystem": true,
    "allowExternalProcesses": true,
    "allowAllTools": true,
    "allowBashExecution": true,
    "allowNetworkOperations": true,
    "allowDatabaseOperations": true,
    "requireConfirmation": false
  },
  "performance": {
    "maxAgents": 100,
    "maxConcurrentTasks": 50,
    "cacheTTL": 3600,
    "connectionPoolSize": 20
  },
  "memory": {
    "namespaces": ["hot", "working", "personal", "semantic", "graph"],
    "cache": {
      "enabled": true,
      "backend": "redis"
    }
  }
}