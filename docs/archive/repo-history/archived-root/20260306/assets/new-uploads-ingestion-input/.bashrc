# Volta Package Manager
export VOLTA_HOME="/c/Program Files/Volta"
export PATH="$VOLTA_HOME:$PATH"
export PATH="/c/Users/edane/AppData/Local/Volta/bin:$PATH"

# Disable volta update checks (requires admin permissions)
export VOLTA_FEATURE_PNPM=1
export VOLTA_INSTALL_DIR="$VOLTA_HOME"

# Node and npm should now work via volta
export NODE_PATH="/c/Users/edane/AppData/Local/Volta/bin"
