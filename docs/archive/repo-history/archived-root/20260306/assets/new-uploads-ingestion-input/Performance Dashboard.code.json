{
  "dashboard": "AIStack_Performance",
  "widgets": [
    {
      "type": "latency_heatmap",
      "sources": ["ArchGW", "AgentZero"],
      "refresh_rate": 2000
    },
    {
      "type": "memory_tier_breakdown",
      "providers": ["MemOS", "Neo4j", "LMcache"]
    },
    {
      "type": "agent_efficiency",
      "agents": ["PocketFlow", "Deepcoder-X3"],
      "metrics": ["tasks/sec", "error_rate"]
    },
    {
      "type": "evolution_progress",
      "components": ["EVOSeal", "smolsqlagent"],
      "metrics": ["learning_gain", "retention_rate"]
    }
  ],
  "alert_rules": [
    {
      "condition": "task_queue > 50",
      "action": "scale_up_pocketflow"
    },
    {
      "condition": "memory_pressure > 85%",
      "action": "purge_cold_tier"
    }
  ]
}