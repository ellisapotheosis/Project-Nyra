# RTX 5090 Worker Configuration
# High-performance reasoning model

WORKER_NAME=rtx-5090
TAILSCALE_IP=100.x.x.1

# vLLM Configuration
MODEL_NAME=deepseek-r1-distill-32b
MODEL_DTYPE=float16
GPU_MEMORY_UTIL=0.90
MAX_MODEL_LEN=4096
MODEL_CACHE_DIR=/mnt/models-5090

# Docker
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
