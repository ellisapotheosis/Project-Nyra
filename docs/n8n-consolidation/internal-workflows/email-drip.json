{
  "name": "Mortgage Email Drip Campaign",
  "nodes": [
    {
      "parameters": {},
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "mortgage-email-drip",
      "id": "webhook-trigger"
    },
    {
      "parameters": {
        "functionCode": "const lead = items[0].json;\nconst currentDay = lead.dayInSequence || 0;\n\nreturn [\n  {\n    json: {\n      ...lead,\n      dayInSequence: currentDay,\n      shouldSendEmail: currentDay <= 30\n    }\n  }\n];"
      },
      "name": "Check Sequence Day",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [450, 300],
      "id": "check-day"
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.dayInSequence}}",
              "operation": "equal",
              "value2": 0
            }
          ]
        }
      },
      "name": "Day 0 - Welcome",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 200],
      "id": "day-0"
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.dayInSequence}}",
              "operation": "equal",
              "value2": 3
            }
          ]
        }
      },
      "name": "Day 3 - Education",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 400],
      "id": "day-3"
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.dayInSequence}}",
              "operation": "equal",
              "value2": 7
            }
          ]
        }
      },
      "name": "Day 7 - Pre-Approval",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 600],
      "id": "day-7"
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "sendGridApi",
        "fromEmail": "mortgages@company.com",
        "toEmail": "={{$json.email}}",
        "subject": "Welcome to Your Mortgage Journey!",
        "emailType": "html",
        "message": "<h1>Welcome {{$json.firstName}}!</h1><p>Thank you for choosing us for your mortgage needs. We're excited to help you find the perfect home loan.</p><p>Here's what to expect:</p><ul><li>Personalized rate quotes</li><li>Expert guidance throughout the process</li><li>Fast pre-approval decisions</li></ul><p><a href='{{$json.portalUrl}}'>Access Your Portal</a></p>"
      },
      "name": "Send Welcome Email",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "position": [850, 200],
      "id": "send-welcome"
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "sendGridApi",
        "fromEmail": "mortgages@company.com",
        "toEmail": "={{$json.email}}",
        "subject": "Understanding Your Mortgage Options",
        "emailType": "html",
        "message": "<h1>Hi {{$json.firstName}},</h1><p>Let's explore the mortgage options available to you:</p><h2>Fixed-Rate Mortgages</h2><p>Consistent payments for the life of your loan.</p><h2>Adjustable-Rate Mortgages (ARM)</h2><p>Lower initial rates that adjust over time.</p><h2>FHA Loans</h2><p>Government-backed loans with lower down payments.</p><p><a href='{{$json.portalUrl}}/rates'>View Current Rates</a></p>"
      },
      "name": "Send Education Email",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "position": [850, 400],
      "id": "send-education"
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "sendGridApi",
        "fromEmail": "mortgages@company.com",
        "toEmail": "={{$json.email}}",
        "subject": "Get Pre-Approved in Minutes!",
        "emailType": "html",
        "message": "<h1>{{$json.firstName}}, Ready for Pre-Approval?</h1><p>Getting pre-approved shows sellers you're serious and helps you move quickly when you find the right home.</p><h3>What You'll Need:</h3><ul><li>2 years of tax returns</li><li>Recent pay stubs</li><li>Bank statements</li><li>Photo ID</li></ul><p><a href='{{$json.portalUrl}}/pre-approval'>Start Pre-Approval</a></p><p>Questions? Call us at (555) 123-4567</p>"
      },
      "name": "Send Pre-Approval Email",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "position": [850, 600],
      "id": "send-preapproval"
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.dayInSequence}}",
              "operation": "equal",
              "value2": 14
            }
          ]
        }
      },
      "name": "Day 14 - Document Prep",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 800],
      "id": "day-14"
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "sendGridApi",
        "fromEmail": "mortgages@company.com",
        "toEmail": "={{$json.email}}",
        "subject": "Document Checklist for Your Mortgage",
        "emailType": "html",
        "message": "<h1>Document Preparation Made Easy</h1><p>Hi {{$json.firstName}},</p><p>Let's get your documents ready for a smooth application process:</p><h3>Required Documents:</h3><ol><li>W-2 forms (last 2 years)</li><li>Tax returns (last 2 years)</li><li>Pay stubs (last 30 days)</li><li>Bank statements (last 2 months)</li><li>Government-issued ID</li></ol><p><a href='{{$json.portalUrl}}/documents'>Upload Documents Securely</a></p>"
      },
      "name": "Send Document Email",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "position": [850, 800],
      "id": "send-documents"
    },
    {
      "parameters": {
        "functionCode": "const lead = items[0].json;\nreturn [\n  {\n    json: {\n      leadId: lead.leadId,\n      email: lead.email,\n      dayInSequence: lead.dayInSequence + 1,\n      emailSent: true,\n      timestamp: new Date().toISOString()\n    }\n  }\n];"
      },
      "name": "Update Lead Status",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1050, 500],
      "id": "update-status"
    },
    {
      "parameters": {
        "url": "={{$env.API_BASE_URL}}/api/leads/{{$json.leadId}}/drip-status",
        "method": "PATCH",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={{ JSON.stringify($json) }}"
      },
      "name": "Update CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [1250, 500],
      "id": "update-crm"
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Check Sequence Day", "type": "main", "index": 0 }]]
    },
    "Check Sequence Day": {
      "main": [
        [
          { "node": "Day 0 - Welcome", "type": "main", "index": 0 },
          { "node": "Day 3 - Education", "type": "main", "index": 0 },
          { "node": "Day 7 - Pre-Approval", "type": "main", "index": 0 },
          { "node": "Day 14 - Document Prep", "type": "main", "index": 0 }
        ]
      ]
    },
    "Day 0 - Welcome": {
      "main": [[{ "node": "Send Welcome Email", "type": "main", "index": 0 }]]
    },
    "Day 3 - Education": {
      "main": [[{ "node": "Send Education Email", "type": "main", "index": 0 }]]
    },
    "Day 7 - Pre-Approval": {
      "main": [[{ "node": "Send Pre-Approval Email", "type": "main", "index": 0 }]]
    },
    "Day 14 - Document Prep": {
      "main": [[{ "node": "Send Document Email", "type": "main", "index": 0 }]]
    },
    "Send Welcome Email": {
      "main": [[{ "node": "Update Lead Status", "type": "main", "index": 0 }]]
    },
    "Send Education Email": {
      "main": [[{ "node": "Update Lead Status", "type": "main", "index": 0 }]]
    },
    "Send Pre-Approval Email": {
      "main": [[{ "node": "Update Lead Status", "type": "main", "index": 0 }]]
    },
    "Send Document Email": {
      "main": [[{ "node": "Update Lead Status", "type": "main", "index": 0 }]]
    },
    "Update Lead Status": {
      "main": [[{ "node": "Update CRM", "type": "main", "index": 0 }]]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["mortgage", "email", "drip-campaign"]
}
