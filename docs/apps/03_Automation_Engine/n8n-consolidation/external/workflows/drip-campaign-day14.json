{
  "name": "Drip Campaign - Day 14",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * *"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Schedule - Day 14",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT l.*, lc.created_at as campaign_start FROM leads l JOIN lead_campaigns lc ON l.id = lc.lead_id WHERE lc.status = 'active' AND DATE(lc.created_at) = CURRENT_DATE - INTERVAL '14 days' AND lc.day14_sent = false ORDER BY l.lead_score DESC"
      },
      "id": "fetch-day14-leads",
      "name": "Fetch Day 14 Leads",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "orchestrator_db",
          "name": "Orchestrator PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "operation": "sendSms",
        "from": "={{ $env.TWILIO_PHONE_NUMBER }}",
        "to": "={{ $json.phone }}",
        "message": "2-week milestone {{firstName}}! You're halfway through the typical approval timeline. What can we do to help you close faster?"
      },
      "id": "send-sms",
      "name": "Send Day 14 SMS",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        650,
        300
      ],
      "credentials": {
        "twilioApi": {
          "id": "twilio_account",
          "name": "Twilio Account"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM_EMAIL }}",
        "toEmail": "={{ $json.email }}",
        "subject": "🏁 2 Weeks In: Let's Accelerate Your Approval",
        "emailType": "html",
        "message": "<!DOCTYPE html><html><body style=\"font-family: Arial, sans-serif;\"><div style=\"max-width: 600px; margin: 0 auto;\"><div style=\"background: #667eea; color: white; padding: 30px; text-align: center;\"><h1>Day 14</h1><p>🏁 2 Weeks In: Let's Accelerate Your Approval</p></div><div style=\"padding: 30px;\"><p>Hi {{$json.first_name}},</p><p>This is day 14 of your mortgage journey. We're here to help you every step of the way!</p><a href=\"{{$env.CRM_URL}}/portal/{{$json.id}}\" style=\"display: inline-block; background: #667eea; color: white; padding: 15px 30px; text-decoration: none; border-radius: 5px; margin: 20px 0;\">Schedule Strategy Call</a></div></div></body></html>"
      },
      "id": "send-email",
      "name": "Send Day 14 Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        850,
        300
      ],
      "credentials": {
        "smtp": {
          "id": "smtp_account",
          "name": "SMTP Account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE lead_campaigns SET day14_sent = true, last_touchpoint = NOW() WHERE lead_id = $1",
        "additionalFields": {
          "queryParameters": "={{ JSON.stringify([$json.id]) }}"
        }
      },
      "id": "mark-day14-sent",
      "name": "Mark Day 14 Sent",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        1050,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "orchestrator_db",
          "name": "Orchestrator PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $env.CRM_API_URL }}/api/activities",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.CRM_API_KEY }}"
            }
          ]
        },
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ leadId: $json.id, type: 'drip-campaign', day: 14, theme: 'milestone', timestamp: new Date().toISOString() }) }}"
      },
      "id": "log-to-crm",
      "name": "Log Activity to CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        1250,
        300
      ]
    }
  ],
  "connections": {
    "Schedule - Day 14": {
      "main": [
        [
          {
            "node": "Fetch Day 14 Leads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Day 14 Leads": {
      "main": [
        [
          {
            "node": "Send Day 14 SMS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Day 14 SMS": {
      "main": [
        [
          {
            "node": "Send Day 14 Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Day 14 Email": {
      "main": [
        [
          {
            "node": "Mark Day 14 Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark Day 14 Sent": {
      "main": [
        [
          {
            "node": "Log Activity to CRM",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "id": "drip-day14",
      "name": "Day 14"
    },
    {
      "id": "milestone",
      "name": "milestone"
    }
  ],
  "meta": {
    "instanceId": "orchestrator-mini"
  }
}