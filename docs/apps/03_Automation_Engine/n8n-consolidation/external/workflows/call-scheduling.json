        "operation": "insert",
        "table": "scheduled_calls",
        "columns": "lead_id, loan_officer_id, scheduled_for, call_type, duration, status, calendly_link, created_at",
        "additionalFields": {
          "values": "={{ JSON.stringify([$items('process-call-request')[0].json.leadId, $json.loan_officer_id, $items('process-call-request')[0].json.scheduledFor, $items('process-call-request')[0].json.callType, $items('process-call-request')[0].json.duration, 'scheduled', $items('create-calendly-link')[0].json.booking_url, new Date().toISOString()]) }}"
        },
        "returnFields": "*"
      },
      "id": "create-call-record",
      "name": "Create Call Record",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [1250, 200],
      "credentials": {
        "postgres": {
          "id": "orchestrator_db",
          "name": "Orchestrator PostgreSQL"
        }
