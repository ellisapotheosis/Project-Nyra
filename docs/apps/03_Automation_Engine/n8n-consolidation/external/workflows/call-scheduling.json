    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/15 * * * *"
            }
          ]
        }
      },
      "id": "cron-check-reminders",
      "name": "Schedule - Check Reminders (Every 15min)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 600]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT sc.*, l.first_name, l.last_name, l.email, l.phone, lo.name as loan_officer_name FROM scheduled_calls sc JOIN leads l ON sc.lead_id = l.id JOIN loan_officers lo ON sc.loan_officer_id = lo.id WHERE sc.status = 'scheduled' AND sc.reminder_1hr_sent = false AND sc.scheduled_for <= NOW() + INTERVAL '1 hour' AND sc.scheduled_for > NOW()"
      },
      "id": "fetch-1hr-reminders",
      "name": "Fetch 1-Hour Reminders Due",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [450, 600],
