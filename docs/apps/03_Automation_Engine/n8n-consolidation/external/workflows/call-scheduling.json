    {
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM_EMAIL }}",
        "toEmail": "={{ $items('fetch-lead-details')[0].json.email }}",
        "subject": "Your Call is Scheduled with {{ $json.loan_officer_name }}",
        "emailType": "html",
        "message": "<!DOCTYPE html><html><body><div style=\"font-family: Arial; max-width: 600px; margin: 0 auto;\"><div style=\"background: #4f46e5; color: white; padding: 30px; text-align: center;\"><h1>📞 Call Confirmed!</h1></div><div style=\"padding: 30px;\"><h2>Hi {{ $items('fetch-lead-details')[0].json.first_name }},</h2><p>Great news! Your call with <strong>{{ $json.loan_officer_name }}</strong> is confirmed.</p><div style=\"background: #f0f9ff; border-left: 4px solid #0ea5e9; padding: 20px; margin: 20px 0;\"><h3>Call Details:</h3><ul><li><strong>Date & Time:</strong> {{ new Date($items('process-call-request')[0].json.scheduledFor).toLocaleString('en-US', { dateStyle: 'full', timeStyle: 'short' }) }}</li><li><strong>Duration:</strong> {{ $items('process-call-request')[0].json.duration }} minutes</li><li><strong>Type:</strong> {{ $items('process-call-request')[0].json.callType }}</li><li><strong>Officer:</strong> {{ $json.loan_officer_name }}</li><li><strong>Phone:</strong> {{ $json.loan_officer_phone }}</li></ul></div><p>You'll receive reminders 1 hour and 15 minutes before the call.</p><a href=\"{{ $items('create-calendly-link')[0].json.booking_url }}\" style=\"display: inline-block; background: #0ea5e9; color: white; padding: 15px 30px; text-decoration: none; border-radius: 5px; margin: 20px 0;\">Add to Calendar</a><h3>Prepare for Your Call:</h3><ul><li>Have your financial documents ready</li><li>List your questions</li><li>Know your homeownership goals</li></ul></div></div></body></html>"
      },
      "id": "send-confirmation-email",
      "name": "Send Confirmation Email to Lead",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1450, 200],
      "credentials": {
        "smtp": {
          "id": "smtp_account",
          "name": "SMTP Account"
        }
