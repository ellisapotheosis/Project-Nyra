{
  "name": "Call Scheduling & Reminders",
  "nodes": [
    {
      "parameters": {
        "path": "schedule-call",
        "options": {},
        "responseMode": "lastNode"
      },
      "id": "webhook-schedule-call",
      "name": "Webhook - Schedule Call Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "schedule-call-request"
    },
    {
      "parameters": {
        "functionCode": "// Process call scheduling request\nconst request = $input.item.json;\n\nconst callData = {\n  leadId: request.leadId || request.lead_id,\n  requestedBy: request.requestedBy || 'lead',\n  preferredDate: request.preferredDate || new Date(Date.now() + 24*60*60*1000).toISOString(),\n  preferredTime: request.preferredTime || '10:00',\n  timezone: request.timezone || 'America/New_York',\n  callType: request.callType || 'initial-consultation',\n  notes: request.notes || '',\n  priority: request.priority || 'normal',\n  duration: request.duration || 30,\n  status: 'pending'\n};\n\n// Calculate actual call datetime\nconst [hours, minutes] = callData.preferredTime.split(':');\nconst callDateTime = new Date(callData.preferredDate);\ncallDateTime.setHours(parseInt(hours), parseInt(minutes), 0, 0);\n\ncallData.scheduledFor = callDateTime.toISOString();\n\n// Add reminder times (1 hour before and 15 minutes before)\ncallData.reminderTimes = [\n  new Date(callDateTime.getTime() - 60*60*1000).toISOString(),\n  new Date(callDateTime.getTime() - 15*60*1000).toISOString()\n];\n\nreturn { json: callData };"
      },
      "id": "process-call-request",
      "name": "Process Call Request",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT l.*, lo.id as loan_officer_id, lo.name as loan_officer_name, lo.email as loan_officer_email, lo.phone as loan_officer_phone FROM leads l LEFT JOIN loan_officers lo ON lo.id = l.assigned_loan_officer WHERE l.id = $1",
        "additionalFields": {
          "queryParameters": "={{ JSON.stringify([$json.leadId]) }}"
        }
      },
      "id": "fetch-lead-details",
      "name": "Fetch Lead & Officer Details",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [650, 300],
      "credentials": {
        "postgres": {
          "id": "orchestrator_db",
          "name": "Orchestrator PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.loan_officer_id !== null }}",
              "operation": "equal",
              "value2": "={{ true }}"
            }
          ]
        }
      },
      "id": "check-officer-assigned",
      "name": "Check if Officer Assigned",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT lo.* FROM loan_officers lo WHERE lo.status = 'active' AND lo.current_lead_count < lo.max_lead_capacity ORDER BY lo.current_lead_count ASC, lo.performance_score DESC LIMIT 1"
      },
      "id": "assign-officer",
      "name": "Auto-Assign Loan Officer",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [1050, 400],
      "credentials": {
        "postgres": {
          "id": "orchestrator_db",
          "name": "Orchestrator PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE leads SET assigned_loan_officer = $1 WHERE id = $2 RETURNING *",
        "additionalFields": {
          "queryParameters": "={{ JSON.stringify([$json.id, $items('process-call-request')[0].json.leadId]) }}"
        }
      },
      "id": "update-lead-assignment",
      "name": "Update Lead Assignment",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [1250, 400],
      "credentials": {
        "postgres": {
          "id": "orchestrator_db",
