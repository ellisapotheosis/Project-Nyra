{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "description": "Advanced Claude Flow Options - Multi-Provider, Scaling, Security, and Enterprise Features",

  "env": {
    "_comment_providers": "=== Multi-Provider API Configuration ===",
    "CLAUDE_API_KEY": "${CLAUDE_API_KEY}",
    "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}",
    "OPENAI_API_KEY": "${OPENAI_API_KEY}",
    "GEMINI_API_KEY": "${GEMINI_API_KEY}",

    "_comment_claude_flow": "=== Claude Flow Core ===",
    "CLAUDE_FLOW_DEBUG": "true",
    "CLAUDE_FLOW_LOG_LEVEL": "info",
    "CLAUDE_FLOW_DATA_DIR": "./data/archon-os",
    "CLAUDE_FLOW_MAX_AGENTS": "50",
    "CLAUDE_FLOW_MEMORY_LIMIT": "2048",
    "CLAUDE_FLOW_TIMEOUT": "300000",
    "CLAUDE_FLOW_CONCURRENT_TASKS": "10",

    "_comment_scaling": "=== Auto-Scaling Configuration ===",
    "CLAUDE_FLOW_AUTO_SCALING": "true",
    "CLAUDE_FLOW_MIN_AGENTS": "2",
    "CLAUDE_FLOW_MAX_AGENTS_SCALING": "50",
    "CLAUDE_FLOW_SCALE_UP_THRESHOLD": "80",
    "CLAUDE_FLOW_SCALE_DOWN_THRESHOLD": "30",

    "_comment_memory": "=== Memory Backends ===",
    "MEMORY_BACKEND": "hybrid",
    "MEMORY_PRIMARY_TYPE": "sqlite",
    "MEMORY_PRIMARY_PATH": "./data/memory.db",
    "MEMORY_CACHE_TYPE": "redis",
    "MEMORY_CACHE_HOST": "localhost",
    "MEMORY_CACHE_PORT": "6379",
    "MEMORY_CACHE_TTL": "3600",
    "MEMORY_BACKUP_TYPE": "s3",
    "MEMORY_BACKUP_BUCKET": "archon-os-backup",
    "MEMORY_BACKUP_REGION": "us-east-1",

    "_comment_terminal": "=== Terminal Pooling ===",
    "TERMINAL_TYPE": "auto",
    "TERMINAL_POOL_SIZE": "3",
    "TERMINAL_RECYCLE_AFTER": "5",
    "TERMINAL_HEALTH_CHECK_INTERVAL": "30000",
    "TERMINAL_COMMAND_TIMEOUT": "180000",

    "_comment_security": "=== Security Features ===",
    "SECURITY_VALIDATE_INPUTS": "true",
    "SECURITY_SANITIZE_OUTPUTS": "true",
    "SECURITY_ENCRYPT_MEMORY": "true",
    "SECURITY_AUDIT_LOGGING": "true",

    "_comment_coordination": "=== Coordination & Fault Tolerance ===",
    "COORDINATION_MAX_RETRIES": "3",
    "COORDINATION_RETRY_DELAY": "1000",
    "COORDINATION_DEADLOCK_DETECTION": "true",
    "COORDINATION_RESOURCE_TIMEOUT": "30000",
    "COORDINATION_MESSAGE_TIMEOUT": "15000",
    "COORDINATION_CONFLICT_RESOLUTION": "crdt",

    "_comment_monitoring": "=== Performance Monitoring ===",
    "MONITORING_METRICS_ENABLED": "true",
    "MONITORING_TRACING_ENABLED": "true",
    "MONITORING_PROFILING_ENABLED": "false",
    "MONITORING_ALERT_CPU": "90",
    "MONITORING_ALERT_MEMORY": "85",
    "MONITORING_ALERT_DISK": "80"
  },

  "orchestrator": {
    "maxConcurrentAgents": 100,
    "taskQueueSize": 1000,
    "defaultTopology": "mesh",
    "autoScaling": true,
    "timeoutMs": 300000,
    "healthCheckInterval": 10000,
    "shutdownTimeout": 15000
  },

  "providers": {
    "anthropic": {
      "apiKey": "${ANTHROPIC_API_KEY}",
      "models": {
        "default": "claude-sonnet-4-5",
        "fast": "claude-3-haiku",
        "powerful": "claude-opus-4-5"
      },
      "temperature": 0.7,
      "maxTokens": 8192
    },
    "openai": {
      "apiKey": "${OPENAI_API_KEY}",
      "models": {
        "default": "gpt-4-turbo",
        "fast": "gpt-3.5-turbo",
        "powerful": "gpt-4"
      },
      "temperature": 0.7,
      "maxTokens": 4096
    },
    "gemini": {
      "apiKey": "${GEMINI_API_KEY}",
      "models": {
        "default": "gemini-pro",
        "powerful": "gemini-ultra"
      },
      "temperature": 0.7,
      "maxTokens": 4096
    }
  },

  "agentProfiles": {
    "development": {
      "agents": ["coder", "reviewer", "tester"],
      "defaultAgent": "coder",
      "topology": "mesh",
      "coordination": "democratic"
    },
    "web-development": {
      "agents": ["frontend-dev", "backend-dev", "fullstack-dev"],
      "topology": "hierarchical",
      "coordination": "leader-follower"
    },
    "architecture": {
      "agents": ["architect", "planner", "system-designer"],
      "topology": "centralized",
      "coordination": "expert-led"
    },
    "data-science": {
      "agents": ["ml-developer", "data-analyst", "python-specialist"],
      "topology": "mesh",
      "coordination": "collaborative"
    },
    "devops": {
      "agents": ["devops-engineer", "docker-specialist", "k8s-specialist"],
      "topology": "hierarchical",
      "coordination": "leader-follower"
    },
    "enterprise-security": {
      "agents": ["security-analyst", "penetration-tester", "compliance-checker"],
      "topology": "centralized",
      "coordination": "expert-led"
    }
  },

  "memory": {
    "backend": "hybrid",
    "primary": {
      "type": "sqlite",
      "path": "./data/memory.db",
      "compression": true,
      "cacheSizeMB": 512
    },
    "cache": {
      "type": "redis",
      "host": "localhost",
      "port": 6379,
      "ttl": 3600,
      "enabled": false
    },
    "backup": {
      "type": "s3",
      "bucket": "archon-os-backup",
      "region": "us-east-1",
      "enabled": false
    },
    "synchronization": {
      "strategy": "eventual-consistency",
      "conflictResolution": "crdt",
      "replicationFactor": 3
    },
    "retentionDays": 30,
    "indexingEnabled": true
  },

  "terminal": {
    "type": "auto",
    "poolSize": 3,
    "recycleAfter": 5,
    "healthCheckInterval": 30000,
    "commandTimeout": 180000
  },

  "swarm": {
    "defaultTopology": "mesh",
    "coordinationStrategy": "democratic",
    "faultTolerance": true,
    "loadBalancing": true
  },

  "security": {
    "validateInputs": true,
    "sanitizeOutputs": true,
    "encryptMemory": false,
    "auditLogging": true,
    "tlsEnabled": false
  },

  "performance": {
    "cacheEnabled": true,
    "compressionEnabled": true,
    "parallelExecution": true,
    "optimization": {
      "agentPooling": true,
      "connectionReuse": true,
      "batchProcessing": true,
      "asyncExecution": true
    },
    "resourceLimits": {
      "maxMemoryMB": 2048,
      "maxCpuPercent": 80
    },
    "monitoring": {
      "metricsEnabled": true,
      "tracingEnabled": true,
      "profilingEnabled": false,
      "alerting": {
        "cpu": 90,
        "memory": 85,
        "diskSpace": 80
      }
    },
    "scaling": {
      "autoScale": true,
      "minAgents": 2,
      "maxAgents": 50,
      "scaleUpThreshold": 80,
      "scaleDownThreshold": 30
    }
  },

  "coordination": {
    "maxRetries": 3,
    "retryDelay": 1000,
    "deadlockDetection": true,
    "resourceTimeout": 30000,
    "messageTimeout": 15000
  },

  "mcp": {
    "transport": "stdio",
    "port": 3000,
    "tlsEnabled": false
  },

  "logging": {
    "level": "info",
    "format": "json",
    "destination": "file",
    "path": "./logs/archon-os.log",
    "maxSizeMB": 100,
    "maxFiles": 10
  },

  "hooks": {
    "enabled": true,
    "autoFormat": true,
    "notifications": true,
    "preTaskHooks": ["backup", "validation"],
    "postTaskHooks": ["cleanup", "metrics"]
  }
}
