# ============================================================================
# MASTER CLAUDE FLOW ENVIRONMENT CONFIGURATION
# Project: Nyra - Multi-Agent AI Development Stack with Claude Flow
# ============================================================================

# === Core Claude Flow Configuration ===
NODE_ENV=development
CLAUDE_FLOW_DEBUG=true
CLAUDE_FLOW_LOG_LEVEL=info
CLAUDE_FLOW_DATA_DIR=./.archon-os/data
CLAUDE_FLOW_MEMORY_DIR=./.archon-os/memory
CLAUDE_FLOW_CONFIG_DIR=./.archon-os/config

# === Feature Flags ===
CLAUDE_FLOW_ENABLED=true
CLAUDE_FLOW_AUTO_COMMIT=true
CLAUDE_FLOW_AUTO_PUSH=false
CLAUDE_FLOW_HOOKS_ENABLED=true
CLAUDE_FLOW_TELEMETRY_ENABLED=true
CLAUDE_FLOW_REMOTE_EXECUTION=true
CLAUDE_FLOW_GITHUB_INTEGRATION=true
CLAUDE_FLOW_CHECKPOINTS_ENABLED=true
CLAUDE_FLOW_MEMORY_PERSISTENCE=true
CLAUDE_FLOW_NEURAL_OPTIMIZATION=true
CLAUDE_FLOW_AUTO_LEARNING=true
CLAUDE_FLOW_TRUTH_THRESHOLD=0.95
CLAUDE_FLOW_VERIFY_MODE=strict
CLAUDE_FLOW_SECURITY_AUDIT=true

# === MCP Integration ===
CLAUDE_FLOW_MCP_MODE=advanced
FLOW_NEXUS_ENABLED=true
MCP_PROTOCOL_VERSION=2025-06-18

# === Performance Configuration ===
CLAUDE_FLOW_MAX_AGENTS=100
CLAUDE_FLOW_MAX_CONCURRENT_TASKS=50
CLAUDE_FLOW_MEMORY_LIMIT=2048
CLAUDE_FLOW_CACHE_SIZE=512
CLAUDE_FLOW_WORKER_THREADS=8

# === Swarm Coordination ===
SWARM_TOPOLOGY=adaptive
MAX_AGENTS=100
SWARM_COORDINATION_PROTOCOL=mesh
SWARM_MEMORY_SHARED=true
SWARM_NEURAL_SYNC=true

# === ruvector Configuration ===
ruvector_ENABLED=true
ruvector_PATH=.ruvector/archon-os.db
ruvector_QUANTIZATION=scalar
ruvector_CACHE_SIZE=1000
ruvector_HNSW_M=16
ruvector_HNSW_EF=100
ruvector_LEARNING=true
ruvector_LEARNING_ALGORITHM=decision-transformer
ruvector_REASONING=true
ruvector_QUIC_SYNC=false
ruvector_QUIC_PORT=4433
ruvector_QUIC_PEERS=
ruvector_AUTO_MIGRATE=true
ruvector_FALLBACK_LEGACY=true

# === ReasoningBank Configuration ===
REASONINGBANK_ENABLED=true
REASONINGBANK_DB_PATH=.swarm/memory.db
REASONINGBANK_K=5
REASONINGBANK_MIN_CONFIDENCE=0.5
AGENTIC_FLOW_TRAINING=true

# === API Configuration ===
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENROUTER_API_KEY=${OPENROUTER_API_KEY}
OPENAI_API_KEY=${OPENAI_API_KEY}
GEMINI_API_KEY=${GEMINI_API_KEY}
COMPLETION_MODEL=claude-sonnet-4-5-20250929
PROVIDER=anthropic
USE_OPENROUTER=false
USE_ONNX=false

# === Flow Nexus Configuration ===
FLOW_NEXUS_URL=https://mcp-flow-nexus.ruv.io
N8N_PROTOCOL=https
FLOW_NEXUS_API_KEY=${FLOW_NEXUS_API_KEY}
FLOW_NEXUS_USER_ID=${FLOW_NEXUS_USER_ID}

# === Neural Network Configuration ===
NEURAL_OPTIMIZATION_ENABLED=true
NEURAL_LEARNING_RATE=0.001
NEURAL_UPDATE_FREQUENCY=100
NEURAL_ERROR_PREVENTION_THRESHOLD=0.85
NEURAL_PERFORMANCE_AUTO_TUNE=true

# === Memory & Persistence ===
MEMORY_AUTO_PERSIST=true
MEMORY_COMPRESSION=true
MEMORY_SYNC_INTERVAL=60
MEMORY_RETENTION_DAYS=90
MEMORY_BACKUP_TO_GITHUB=true
MEMORY_NAMESPACES=swarm,tasks,patterns,errors,optimizations,nyra

# === Checkpoint Configuration ===
CHECKPOINT_ENABLED=true
CHECKPOINT_INTERVAL=300
CHECKPOINT_AUTO_COMMIT=true
CHECKPOINT_MESSAGE_PREFIX="🔄 Auto-checkpoint:"
CHECKPOINT_INCLUDE_METRICS=true
CHECKPOINT_BRANCH_STRATEGY="checkpoint/{timestamp}"
CHECKPOINT_MAX_CHECKPOINTS=20

# === GitHub Integration ===
GITHUB_TOKEN=${GITHUB_TOKEN}
GITHUB_CHECKPOINT_BRANCH=checkpoints
GITHUB_MEMORY_BACKUP_GISTS=true
GITHUB_AUTO_ISSUE_ON_ERROR=false
GITHUB_PR_ON_MAJOR_IMPROVEMENT=false
GITHUB_SYNC_LEARNINGS=true

# === Database Configuration ===
DATABASE_URL=${DATABASE_URL:-sqlite:///.archon-os/data/archon-os.db}
REDIS_URL=${REDIS_URL:-redis://localhost:6379/0}
CACHE_TTL=3600
CONNECTION_POOL_SIZE=20

# === Security ===
JWT_SECRET=${JWT_SECRET}
ENCRYPTION_KEY=${ENCRYPTION_KEY}
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# === Monitoring & Observability ===
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}
LOG_RETENTION_DAYS=30
METRICS_RETENTION_DAYS=90

# === Notifications ===
SLACK_WEBHOOK_URL=${SLACK_WEBHOOK_URL}
EMAIL_SMTP_HOST=${EMAIL_SMTP_HOST:-smtp.gmail.com}
EMAIL_SMTP_PORT=${EMAIL_SMTP_PORT:-587}
EMAIL_SMTP_USER=${EMAIL_SMTP_USER}
EMAIL_SMTP_PASS=${EMAIL_SMTP_PASS}

# === Cloud Provider Configuration (Optional) ===
# AWS
AWS_REGION=${AWS_REGION:-us-west-2}
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
S3_BUCKET=${S3_BUCKET:-archon-os-backups}

# === Proxy Configuration (Optional) ===
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# === Agents Directory ===
AGENTS_DIR=./.archon-os/agents
PROXY_PORT=8080

# === Custom Configuration ===
AGENTS_CUSTOM_PATHS=./.archon-os/agents,./.claude/agents
HOOKS_CUSTOM_PATHS=./.archon-os/hooks,./.claude/hooks

# === Secrets Management (Infisical) ===
INFISICAL_PROJECT_ID=${INFISICAL_PROJECT_ID}
INFISICAL_CLIENT_ID=${INFISICAL_CLIENT_ID}
INFISICAL_CLIENT_SECRET=${INFISICAL_CLIENT_SECRET}
INFISICAL_ENVIRONMENT=dev
INFISICAL_PATH=/shared

# === Performance Targets ===
PERF_TARGET_COMMAND_EXECUTION=500
PERF_TARGET_MEMORY_OPERATIONS=100
PERF_TARGET_NEURAL_PREDICTIONS=50
