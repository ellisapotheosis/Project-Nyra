# Project Nyra - PC1 Orchestrator Environment Variables
# Copy this file to .env.pc1 and fill in your actual values

# ============================================================================
# LLM PROVIDER API KEYS
# ============================================================================

# Anthropic Claude API (Primary)
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# OpenRouter API (Cost-efficient fallback)
OPENROUTER_API_KEY=sk-or-YOUR_KEY_HERE

# Google Gemini API (Bulk operations)
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE

# ============================================================================
# GITHUB INTEGRATION
# ============================================================================

GITHUB_TOKEN=ghp_YOUR_TOKEN_HERE
GITHUB_USERNAME=your-username
GITHUB_REPO_OWNER=ellisapotheosis
GITHUB_REPO_NAME=project-nyra

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Grafana Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_please_very_secure_password

# Prometheus Retention
PROMETHEUS_RETENTION_DAYS=30

# Alertmanager Configuration
ALERTMANAGER_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/HERE
ALERTMANAGER_EMAIL_TO=alerts@ratehunter.net
ALERTMANAGER_EMAIL_FROM=monitoring@ratehunter.net

# ============================================================================
# NETWORKING
# ============================================================================

# Local Network Configuration
PC1_IP=10.0.0.1
PC2_IP=10.0.0.2
PC3_IP=10.0.0.3
PC4_IP=10.0.0.4

# Tailscale VPN
TAILSCALE_AUTH_KEY=tskey-YOUR_KEY_HERE
TAILSCALE_HOSTNAME=nyra-orchestrator

# Cloudflare Tunnels
CLOUDFLARE_TUNNEL_TOKEN=YOUR_TUNNEL_TOKEN_HERE
CLOUDFLARE_ZONE_ID=YOUR_ZONE_ID_HERE
CLOUDFLARE_API_TOKEN=YOUR_API_TOKEN_HERE

# ============================================================================
# NEXUS ROUTER CONFIGURATION
# ============================================================================

NEXUS_PORT=8000
NEXUS_ADMIN_PORT=4001
NEXUS_LOG_LEVEL=info

# ============================================================================
# CLAUDE FLOW CONFIGURATION
# ============================================================================

CLAUDE_FLOW_PORT=9000
CLAUDE_FLOW_UI_PORT=9001
CLAUDE_FLOW_LOG_LEVEL=debug

# ============================================================================
# ARCHON OS CONFIGURATION
# ============================================================================

ARCHON_PORT=9002
ARCHON_UI_PORT=9003
ARCHON_LOG_LEVEL=info

# ============================================================================
# SECURITY & SECRETS MANAGEMENT
# ============================================================================

# Infisical (Optional)
INFISICAL_PROJECT_ID=8374cea9-e5e8-4050-bda4-b91f25ab30ef
INFISICAL_CLIENT_ID=YOUR_CLIENT_ID_HERE
INFISICAL_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE

# Bitwarden (Optional)
BITWARDEN_CLIENT_ID=YOUR_CLIENT_ID_HERE
BITWARDEN_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE

# ============================================================================
# SYSTEM CONFIGURATION
# ============================================================================

# Node Environment
NODE_ENV=production

# Timezone
TZ=America/Los_Angeles

# ============================================================================
# EXTERNAL SERVICES (For Future Integration)
# ============================================================================

# Twilio (SMS/Voice)
TWILIO_ACCOUNT_SID=YOUR_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_AUTH_TOKEN_HERE
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid (Email)
SENDGRID_API_KEY=SG.YOUR_KEY_HERE
SENDGRID_FROM_EMAIL=noreply@ratehunter.net

# ============================================================================
# NOTES
# ============================================================================
# 1. Never commit .env.pc1 to version control
# 2. Keep API keys secure and rotate regularly
# 3. Use Infisical or Bitwarden for team secret management
# 4. Update GRAFANA_ADMIN_PASSWORD before deploying to production
