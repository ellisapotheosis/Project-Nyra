{
  "$schema": "https://unpkg.com/syncpack@13.0.4/dist/schema.json",
  "versionGroups": [
    {
      "label": "Use workspace protocol for internal packages",
      "dependencies": ["@nyra/**"],
      "dependencyTypes": ["prod", "dev"],
      "pinVersion": "workspace:*"
    },
    {
      "label": "Ensure React versions are consistent",
      "dependencies": ["react", "react-dom"],
      "packages": ["**"],
      "pinVersion": "^18.3.1"
    },
    {
      "label": "Ensure Next.js versions are consistent",
      "dependencies": ["next"],
      "packages": ["apps/**"],
      "pinVersion": "^15.1.7"
    },
    {
      "label": "Ensure TypeScript versions are consistent",
      "dependencies": ["typescript"],
      "packages": ["**"],
      "pinVersion": "^5.7.0"
    },
    {
      "label": "Ensure ESLint versions are consistent",
      "dependencies": ["eslint"],
      "packages": ["**"],
      "pinVersion": "^9.18.0"
    },
    {
      "label": "Ensure testing libraries are consistent",
      "dependencies": ["jest", "@types/jest", "ts-jest"],
      "packages": ["**"],
      "pinVersion": "^29.7.0"
    }
  ],
  "semverGroups": [
    {
      "label": "Use ~ for patch updates on build tools",
      "dependencies": ["turbo", "@turbo/**"],
      "packages": ["**"],
      "range": "~"
    },
    {
      "label": "Use ^ for minor updates on most packages",
      "dependencies": ["**"],
      "packages": ["**"],
      "range": "^"
    }
  ],
  "customTypes": {
    "engines": {
      "path": "engines",
      "strategy": "versionsByName"
    }
  },
  "semverRange": "^",
  "sortAz": [
    "contributors",
    "dependencies",
    "devDependencies",
    "peerDependencies",
    "keywords",
    "scripts"
  ],
  "sortFirst": [
    "name",
    "version",
    "description",
    "private",
    "author",
    "license",
    "repository",
    "keywords",
    "engines",
    "packageManager"
  ],
  "source": [
    "package.json",
    "apps/*/package.json",
    "services/*/package.json",
    "packages/*/package.json",
    "mcp-servers/*/package.json",
    "tools/*/package.json"
  ]
}
