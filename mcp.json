{
  "clients": {
    "desktop-commander": {
      "command": "C:\\Windows\\System32\\cmd.exe",
      "args": ["/c", "C:\\Program Files\\Git\\bin\\bash.exe", "--login", "-i"]
    }
  },
  "mcpServers": {
    "claude-flow": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@claude-flow/cli@latest", "mcp", "start"],
      "env": {
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_MEMORY_ENABLED": "true",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_NEURAL_ENABLED": "true",
        "CLAUDE_FLOW_GITHUB_ENABLED": "true",
        "CLAUDE_FLOW_AUTO_SPAWN": "true",
        "CLAUDE_FLOW_SESSION_MEMORY": "true",
        "CLAUDE_FLOW_MAX_AGENTS": "100",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid",
        "CLAUDE_FLOW_LOG_LEVEL": "info",
        "CLAUDE_FLOW_COORDINATION_ENABLED": "true",
        "CLAUDE_FLOW_PARALLEL_PROCESSING": "true",
        "CLAUDE_FLOW_TELEMETRY_ENABLED": "true"
      },
      "description": "Claude Flow V3 multi-agent orchestration with memory and neural learning"
    },
    "ruv-swarm": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "ruv-swarm@latest", "mcp", "start"],
      "env": {
        "RUV_SWARM_TOPOLOGY": "adaptive",
        "RUV_SWARM_MAX_AGENTS": "20",
        "RUV_SWARM_WASM_ENABLED": "true",
        "RUV_SWARM_NEURAL_ENABLED": "true",
        "RUV_SWARM_DAA_ENABLED": "true",
        "RUV_SWARM_MEMORY_MODE": "persistent"
      },
      "description": "Ruv Swarm enhanced coordination with WASM runtime"
    },
    "flow-nexus": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "flow-nexus@latest", "start"],
      "disabled": "${FLOW_NEXUS_DISABLED:true}",
      "description": "Flow Nexus cloud platform integration"
    },
    "hive-mind": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "hive-mind@latest", "start"],
      "disabled": "${HIVEMIND_DISABLED:true}",
      "description": "Hive Mind collective intelligence system"
    },
    "roo": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "roo@latest", "start"],
      "disabled": "${ROO_DISABLED:true}",
      "description": "Roo development assistant"
    },
    "codanna": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "codanna-mcp@latest", "start"],
      "disabled": "${CODANNA_DISABLED:false}",
      "description": "Codanna code analysis and suggestions"
    }
  }
}
