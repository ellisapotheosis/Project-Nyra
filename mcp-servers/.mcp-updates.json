{
  "note": "Add these entries to .mcp.json mcpServers section",
  "newServers": {
    "filesystem": {
      "command": "docker",
      "args": ["compose", "-f", "mcp-servers/implementations/FileSystemMCP/docker-compose.yml", "up", "-d"],
      "autoStart": false,
      "disabled": true,
      "description": "File system operations (consolidated from nyra-mcp)"
    },
    "github": {
      "command": "docker",
      "args": ["compose", "-f", "mcp-servers/implementations/GithubMCP/docker-compose.yml", "up", "-d"],
      "autoStart": false,
      "disabled": true,
      "description": "GitHub repository operations (consolidated from nyra-mcp)"
    },
    "docker-mcp": {
      "command": "uvx",
      "args": ["mcp-server-docker"],
      "autoStart": false,
      "disabled": true,
      "description": "Docker container management (consolidated from nyra-mcp)"
    },
    "infisical": {
      "command": "node",
      "args": ["mcp-servers/implementations/Infisical/run-infisical-mcp.ps1"],
      "autoStart": false,
      "disabled": true,
      "description": "Secrets management (consolidated from nyra-mcp)"
    },
    "kilo-code": {
      "command": "npm",
      "args": ["run", "mcp:i18n"],
      "cwd": "mcp-servers/implementations/KiloCodeMCP",
      "autoStart": false,
      "disabled": true,
      "description": "Internationalization tools (consolidated from nyra-mcp)"
    },
    "gemini": {
      "command": "npx",
      "args": ["@mgabr/gemini-mcp-server"],
      "autoStart": false,
      "disabled": true,
      "description": "Google Gemini AI integration (consolidated from nyra-mcp)"
    }
  }
}
