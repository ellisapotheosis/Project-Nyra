{
  "name": "@project-nyra/sequential-thinking-mcp",
  "version": "1.0.0",
  "description": "MCP server for sequential thinking and problem solving",
  "author": "Project Nyra",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sequential-thinking-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
