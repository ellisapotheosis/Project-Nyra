{
  "mcp": {
    "port": 8007,
    "host": "0.0.0.0",
    "protocol": "stdio"
  },
  "dockerhub": {
    "apiUrl": "https://hub.docker.com/v2",
    "registryUrl": "https://registry.hub.docker.com/v2",
    "namespace": "projectnyra",
    "defaultPageSize": 25,
    "maxPageSize": 100
  },
  "cache": {
    "enabled": true,
    "ttl": 300,
    "maxSize": 1000
  },
  "rateLimit": {
    "enabled": true,
    "maxRequests": 100,
    "windowMs": 60000
  },
  "logging": {
    "level": "info",
    "pretty": true,
    "file": "/app/logs/dockerhub-mcp.log"
  },
  "metrics": {
    "enabled": true,
    "endpoint": "/metrics"
  },
  "infisical": {
    "enabled": true,
    "path": "/nyra/dockerhub",
    "env": "production"
  }
}
