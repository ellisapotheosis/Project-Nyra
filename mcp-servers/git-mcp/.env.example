# Git MCP Server Environment Configuration

# Workspace path (default: ../../ - parent of mcp-servers)
WORKSPACE_PATH=../../

# Git user configuration
GIT_AUTHOR_NAME=MCP Git Server
GIT_AUTHOR_EMAIL=mcp@example.com
GIT_COMMITTER_NAME=MCP Git Server
GIT_COMMITTER_EMAIL=mcp@example.com

# Optional: Git credential helper
# GIT_CREDENTIAL_HELPER=store

# Optional: SSH key path for remote operations
# SSH_KEY_PATH=/path/to/ssh/key
