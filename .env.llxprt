# ============================================================
# .env.llxprt — LLxprt Tool Environment Template
# ============================================================
# Copy/source this on any PC that runs llxprt-code or jefe.
# On the ORCHESTRATOR PC:  add these to .env.orchestrator
# On WORKER PCs (5090 etc): add to their respective .env.host
#
# The run-llxprt-code.sh and run-llxprt-jefe.sh scripts
# set sensible defaults for everything below, so you only
# need to set values that differ from those defaults.
# ============================================================

# ── LLM Routing ─────────────────────────────────────────────
# Base URL of the Nexus Router.  On the orchestrator this is
# localhost; workers reach it over Tailscale.
# Default (scripts): http://orchestrator.trex-fiordland.ts.net:6000/v1
NYRA_NEXUS_BASE_URL=http://orchestrator.trex-fiordland.ts.net:6000/v1

# These three are aliases for the same URL (different tools use different vars)
OPENAI_BASE_URL=${NYRA_NEXUS_BASE_URL}
OPENAI_API_BASE=${NYRA_NEXUS_BASE_URL}
LLM_BASE_URL=${NYRA_NEXUS_BASE_URL}

# API key expected by llxprt-code (Nexus Router accepts any value)
# Default: local-key
OPENAI_API_KEY=local-key

# ── Model Selection ─────────────────────────────────────────
# Model routed through Nexus for local cluster inference
# Default: local-cluster
NYRA_LOCAL_CLUSTER_MODEL=local-cluster

# Model alias for remote OpenAI Codex via Nexus
# Default: remote/openai-codex
NYRA_REMOTE_OPENAI_MODEL=remote/openai-codex

# Model alias for remote Gemini via Nexus
# Default: remote/gemini-2.5-pro
NYRA_REMOTE_GEMINI_MODEL=remote/gemini-2.5-pro

# Active model used by run-llxprt-code.sh
# Default: local-cluster (set to one of the above or any nexus route)
NYRA_LLXPRT_MODEL=local-cluster

# Provider type passed to llxprt-code --provider flag
# Default: openai  (Nexus Router speaks the OpenAI API)
NYRA_LLXPRT_PROVIDER=openai

# ── npm Package Cache ────────────────────────────────────────
# Where llxprt-code is cached via npm exec --prefix
# Default: $HOME/.cache/nyra-llxprt-code
NYRA_LLXPRT_NPM_PREFIX=${HOME}/.cache/nyra-llxprt-code

# npm package name for llxprt-code
# Default: @vybestack/llxprt-code
NYRA_LLXPRT_PACKAGE=@vybestack/llxprt-code

# ── jefe (Rust binary) ───────────────────────────────────────
# Path to the cloned llxprt-jefe repo
# Default: <project-root>/external/llxprt-jefe
NYRA_LLXPRT_JEFE_DIR=${PWD}/external/llxprt-jefe

# Git remote for the jefe source
# Default: https://github.com/vybestack/llxprt-jefe.git
NYRA_LLXPRT_JEFE_REPO_URL=https://github.com/vybestack/llxprt-jefe.git

# ── Cloudflare Pages (used by jefe + grid for CF deploys) ───
# Cloudflare Pages project name (used by wrangler)
NYRA_CF_PROJECT_NAME=project-nyra

# The CF app dir used to resolve wrangler.toml and compatibility date
NYRA_CF_APP_DIR=${PWD}/apps/landing/ratehunter-landing

# Set by wrangler.toml; override only if deploying to a different date
# NYRA_CF_COMPATIBILITY_DATE=2026-03-06

# Cloudflare Pages environment (production | preview)
NYRA_CF_ENVIRONMENT=production

# ── SourceGit (optional, used by jefe for git UI) ───────────
# Path to the sourcegit binary.  Defaults to /usr/bin/sourcegit.
# Set this on each machine where sourcegit lives in a non-standard path.
# SOURCEGIT_CMD=/usr/bin/sourcegit
# LLXPRT_SOURCEGIT=${SOURCEGIT_CMD}

# ── Remote / SSH Aliases ─────────────────────────────────────
# SSH host alias for the machine that runs llxprt-code remotely
# Used by bootstrap-llxprt-stack.sh to verify remote setup
# Default: 5090
NYRA_HOST_5090=5090

# Project root path on the remote machine
# Default: /home/ellisapotheosis/repos/project-nyra
NYRA_REMOTE_PROJECT_ROOT=/home/ellisapotheosis/repos/project-nyra

# ── Next.js / CF Build Vars (forwarded to the remote shell) ─
NODE_ENV=production
NODE_VERSION=20
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_SITE_NAME=RateHunter
NEXT_PUBLIC_SITE_URL=project-nyra.pages.dev
