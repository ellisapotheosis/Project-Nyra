# Project Nyra — Oracle One-VM .env.example
# Fill values & store secrets in Infisical/Vaultwarden. Do NOT commit real secrets.

POSTGRES_USER=nyra
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=nyra

# TwentyCRM
TWENTY_PORT=3000
TWENTY_APP_URL=https://crm.ratehunter.net
TWENTY_DATABASE_URL=postgresql://nyra:REPLACE_ME@postgres:5432/twenty
TWENTY_REDIS_URL=redis://redis:6379
TWENTY_ENCRYPTION_KEY=REPLACE_ME
TWENTY_JWT_SECRET=REPLACE_ME

# Graphiti
GRAPHITI_HTTP_PORT=7474
GRAPH_BACKEND=falkordb
GRAPH_REDIS_URL=redis://falkordb:6379
NEO4J_PASSWORD=REPLACE_ME
NEO4J_AUTH=neo4j/REPLACE_ME
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j

# RuVector
RUVECTOR_PORT=8000
RUVECTOR_DATABASE_URL=postgresql://nyra:REPLACE_ME@postgres:5432/nyra_ai

# n8n
N8N_HOST=n8n.ratehunter.net
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://n8n.ratehunter.net/
N8N_TIMEZONE=America/Los_Angeles
N8N_DB_NAME=n8n
N8N_ENCRYPTION_KEY=REPLACE_ME
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=REPLACE_ME

# Activepieces
AP_PORT=8080
AP_DB_NAME=activepieces
AP_ENCRYPTION_KEY=REPLACE_ME
AP_JWT_SECRET=REPLACE_ME
AP_FRONTEND_URL=https://ap.ratehunter.net

# Moltbot/OpenClaw
MOLTBOT_PORT=18789
MOLTBOT_CONTROL_PORT=18790
CLAWDBOT_GATEWAY_TOKEN=REPLACE_ME
MEM0_API_KEY=

# Cloudflared (optional)
CLOUDFLARED_TUNNEL_TOKEN=REPLACE_ME
