# Example environment for the RTX 3060 worker (Ollama)

# Port on which Ollama listens for OpenAI‑compatible requests
OLLAMA_PORT=11434

# Comma‑separated list of models to preload on startup.  See
# https://ollama.ai/library for available models.  The default loads
# LLaMA 3, but you can specify multiple models (e.g. "llama3,phi3,gemma")
OLLAMA_MODELS=llama3

# How long Ollama should keep models in memory after the last request
OLLAMA_KEEP_ALIVE=24h

# Number of requests to serve concurrently.  Lower this if you hit GPU
# memory limits on a 3060 (12 GB VRAM).
OLLAMA_NUM_PARALLEL=2

# Maximum number of models to keep loaded in memory
OLLAMA_MAX_LOADED_MODELS=1