FROM node:20-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends git curl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY ./entrypoints/archon-wrapper.sh /usr/local/bin/archon-wrapper.sh
RUN chmod +x /usr/local/bin/archon-wrapper.sh
ENTRYPOINT ["/usr/local/bin/archon-wrapper.sh"]
