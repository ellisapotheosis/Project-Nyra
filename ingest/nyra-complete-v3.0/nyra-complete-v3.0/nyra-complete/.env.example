# Project Nyra Environment Variables Template
# Copy to .env and fill in your secrets

# ============================================================================
# GENERAL
# ============================================================================

ENVIRONMENT=development
LOG_LEVEL=info
DEBUG=false

# ============================================================================
# INFISICAL SECRETS MANAGEMENT
# ============================================================================

INFISICAL_API_URL=https://app.infisical.com
INFISICAL_TOKEN=your-infisical-machine-token-here
ORACLE_INFISICAL_TOKEN=your-oracle-infisical-token-here

# ============================================================================
# ANTHROPIC APIs
# ============================================================================

ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ============================================================================
# OPENROUTER (Fallback LLM)
# ============================================================================

OPENROUTER_API_KEY=your-openrouter-key-here

# ============================================================================
# GITHUB INTEGRATION
# ============================================================================

GITHUB_TOKEN=ghp_your-github-token-here
GITHUB_OWNER=your-github-org
GITHUB_REPO=ProjectNyra

# ============================================================================
# DATABASE (Postgres on Oracle)
# ============================================================================

# Format: postgres://user:pass@host:port/database
DATABASE_URL=postgres://postgres:change_me@oracle.trex-fiordland.ts.net:5432/twenty

POSTGRES_PASSWORD=your-secure-postgres-password-here
POSTGRES_USER=postgres
POSTGRES_DB=twenty

# ============================================================================
# REDIS
# ============================================================================

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password

# ============================================================================
# TAPIOCA/TWENTY CRM
# ============================================================================

TWENTY_API_TOKEN=your-twenty-crm-api-token
TWENTY_API_URL=https://crm.ratehunter.net

# ============================================================================
# ACTIVEPIECES (Workflow Engine)
# ============================================================================

ACTIVEPIECES_TOKEN=your-activepieces-api-token
ACTIVEPIECES_URL=https://workflows.ratehunter.net
ACTIVEPIECES_API_KEY=your-activepieces-api-key

# ============================================================================
# TWILIO (SMS)
# ============================================================================

TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# EMAIL (IMAP for lead ingestion)
# ============================================================================

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=your-app-password
IMAP_FOLDER=INBOX

# ============================================================================
# LEADMAILBOX (Lead provider)
# ============================================================================

LEADMAILBOX_API_KEY=your-leadmailbox-api-key
LEADMAILBOX_WEBHOOK_SECRET=your-webhook-secret

# ============================================================================
# SECURITY & JWT
# ============================================================================

JWT_SECRET=your-jwt-secret-min-32-chars-long-here
ENCRYPTION_KEY=your-encryption-key-32-chars-long-here

# ============================================================================
# OAUTH (Google for SSO)
# ============================================================================

GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://crm.ratehunter.net/auth/google/callback

# ============================================================================
# GITEA (Self-hosted Git)
# ============================================================================

GITEA_ADMIN_USERNAME=admin
GITEA_ADMIN_PASSWORD=your-gitea-admin-password
GITEA_RUNNER_TOKEN=your-gitea-runner-registration-token
GITEA_WEBHOOK_SECRET=your-gitea-webhook-secret

# ============================================================================
# LITELLM CONFIGURATION
# ============================================================================

LITELLM_API_KEY=your-litellm-api-key
LITELLM_API_BASE=http://localhost:4000
LITELLM_LOG_LEVEL=info

# ============================================================================
# MEM0 (Conversational Memory)
# ============================================================================

MEM0_API_URL=http://oracle.trex-fiordland.ts.net:5000
MEM0_API_KEY=your-mem0-api-key

# ============================================================================
# QUOTE ENGINE
# ============================================================================

QUOTE_ENGINE_URL=http://oracle.trex-fiordland.ts.net:8089
QUOTE_ENGINE_API_KEY=your-quote-engine-key

# ============================================================================
# TAILSCALE (Mesh VPN)
# ============================================================================

TAILSCALE_API_KEY=your-tailscale-api-key
TAILSCALE_NETWORK=trex-fiordland.ts.net
ORCHESTRATOR_TAILSCALE_IP=100.x.x.0
WORKER_5090_TAILSCALE_IP=100.x.x.1
WORKER_3090TI_TAILSCALE_IP=100.x.x.2
WORKER_3060_TAILSCALE_IP=100.x.x.3
ORACLE_TAILSCALE_IP=100.x.x.10

# ============================================================================
# CLOUDFLARE (DNS & Tunnels)
# ============================================================================

CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id

# ============================================================================
# DOCKER REGISTRY (if using private registry)
# ============================================================================

DOCKER_REGISTRY=docker.io
DOCKER_REGISTRY_USERNAME=your-docker-username
DOCKER_REGISTRY_PASSWORD=your-docker-password

# ============================================================================
# RATE LIMITS & COMPLIANCE
# ============================================================================

SMS_RATE_LIMIT=100  # per day per borrower
EMAIL_RATE_LIMIT=50  # per day per borrower
DNC_LIST_UPDATE_INTERVAL=3600  # seconds

# ============================================================================
# ORACLE CLOUD SPECIFIC
# ============================================================================

ORACLE_COMPARTMENT_ID=your-oracle-compartment-id
ORACLE_REGION=us-phoenix-1
ORACLE_AUTH_TOKEN=your-oracle-auth-token

# ============================================================================
# MONITORING & LOGGING
# ============================================================================

SENTRY_DSN=your-sentry-dsn
DATADOG_API_KEY=your-datadog-api-key
GRAFANA_API_KEY=your-grafana-api-key
