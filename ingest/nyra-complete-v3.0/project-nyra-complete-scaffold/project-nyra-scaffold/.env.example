# ===== PROJECT NYRA ENVIRONMENT =====
# Copy this to .env and fill in your actual values

# ===== ORACLE CLOUD CONFIGURATION =====
ORACLE_INFISICAL_TOKEN=sk_oracle_xxxxx
ORACLE_DATABASE_PASSWORD=change_me_oracle_db_password
ORACLE_REDIS_PASSWORD=change_me_oracle_redis_password
ORACLE_TwentyCRM_SECRET_KEY=change_me_twenty_crm_secret
ORACLE_ACTIVEPIECES_SECRET_KEY=change_me_activepieces_secret

# TwentyCRM
TWENTY_DB_URL=postgres://postgres:${ORACLE_DATABASE_PASSWORD}@postgres:5432/twenty
TWENTY_SERVER_URL=https://crm.ratehunter.net
TWENTY_ENABLE_DB_SSL=false

# Activepieces
ACTIVEPIECES_DB_URL=postgres://postgres:${ORACLE_DATABASE_PASSWORD}@postgres:5432/activepieces
ACTIVEPIECES_JWT_SECRET=${ORACLE_ACTIVEPIECES_SECRET_KEY}
ACTIVEPIECES_WEBHOOK_URL=https://workflows.ratehunter.net

# Gitea
GITEA_DB_PASSWD=gitea_pw_change_me
GITEA_ADMIN_USER=admin
GITEA_ADMIN_PASSWD=admin_pw_change_me

# ===== ORCHESTRATOR CONFIGURATION (Minisforum) =====
MACHINE_TYPE=orchestrator

# Nexus Router
NEXUS_PORT=6000
NEXUS_LOG_LEVEL=info

# LiteLLM
LITELLM_PORT=4000
LITELLM_LOG_LEVEL=INFO
LITELLM_BUDGET_ALERTS=true
LITELLM_DATABASE_URL=postgres://postgres:${ORCHESTRATOR_DATABASE_PASSWORD}@localhost:5432/litellm

# Claude-Flow
CLAUDE_FLOW_PORT=8080
CLAUDE_FLOW_API_KEY=${ANTHROPIC_API_KEY}
CLAUDE_FLOW_NEXUS_URL=http://localhost:6000

# OpenClaw (Mortgage Assistant Agent)
OPENCLAW_PORT=9000
OPENCLAW_MEM0_API_URL=http://oracle-mem0:9100
OPENCLAW_LITELLM_URL=http://localhost:4000
OPENCLAW_TWENTY_CRM_URL=https://crm.ratehunter.net

# Archon OS
ARCHON_PORT=4001
ARCHON_KNOWLEDGE_BASE=/data/archon-kb

# ===== WORKER CONFIGURATION =====
# These run on each GPU PC (RTX 5090, RTX 3090Ti, RTX 3060)

# vLLM (Workers 1 & 2)
VLLM_PORT=8000
VLLM_MODEL=mistral-7b
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_GPU_MEMORY_UTILIZATION=0.85

# Ollama (Worker 3 - RTX 3060)
OLLAMA_PORT=11434
OLLAMA_MODEL=mistral:7b

# ===== TAILSCALE CONFIGURATION =====
TAILSCALE_AUTHKEY=tskey-auth-xxxxx_DO_NOT_COMMIT
TAILSCALE_ADVERTISE_ROUTES=10.0.0.0/24,172.17.0.0/16,172.20.0.0/16

# ===== ANTHROPIC API =====
ANTHROPIC_API_KEY=sk-ant-xxxxx_DO_NOT_COMMIT

# ===== OPENROUTER (Fallback) =====
OPENROUTER_API_KEY=sk-or-xxxxx_DO_NOT_COMMIT

# ===== CLOUDFLARE TUNNELS =====
CLOUDFLARE_TUNNEL_TOKEN=xxxxx_DO_NOT_COMMIT
CLOUDFLARE_ZONE_ID=xxxxx
CLOUDFLARE_API_TOKEN=xxxxx_DO_NOT_COMMIT

# ===== INFISICAL =====
INFISICAL_TOKEN=sk_infisical_xxxxx_DO_NOT_COMMIT
INFISICAL_PROJECT_ID=proj_xxxxx
INFISICAL_ENVIRONMENT=prod

# ===== DOCKER REGISTRY (Optional) =====
DOCKER_REGISTRY_URL=docker.io
DOCKER_REGISTRY_USERNAME=your_docker_username
DOCKER_REGISTRY_PASSWORD=your_docker_password

# ===== LOGGING & MONITORING =====
LOG_LEVEL=info
DOCKER_LOG_DRIVER=json-file
DOCKER_LOG_MAX_SIZE=50m
DOCKER_LOG_MAX_FILE=3

# ===== DEBUG MODE =====
DEBUG=false
VERBOSE=false
