# ==============================================================================
# PROJECT NYRA - MASTER ENVIRONMENT CONFIGURATION
# ==============================================================================
# Complete environment variable template for all services
# Copy to .env and fill in your values
# CRITICAL: Never commit actual .env to git
# ==============================================================================

# ==============================================================================
# PHASE 0: PREFLIGHT - REQUIRED SETUP
# ==============================================================================

NODE_ENV=production
NYRA_ENVIRONMENT=production
NYRA_DEBUG=false

# ==============================================================================
# CORE SECRETS (Generate with: openssl rand -hex 32)
# ==============================================================================

JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32
API_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
HMAC_SECRET=change-me-generate-with-openssl-rand-hex-32

# Nexus Router
NEXUS_JWT_SECRET=change-me-nexus-jwt-secret-min-32-chars
NEXUS_ADMIN_TOKEN=change-me-nexus-admin-token

# ==============================================================================
# INFISICAL - SECRETS MANAGEMENT
# ==============================================================================

INFISICAL_PROJECT_ID=your-infisical-project-id
INFISICAL_ENVIRONMENT=production
INFISICAL_API_KEY=${INFISICAL_SERVICE_TOKEN}
INFISICAL_SERVICE_TOKEN=your-service-token
INFISICAL_MCP_TOKEN=your-mcp-token

# ==============================================================================
# CLOUD AI PROVIDERS (For fallback + hybrid routing)
# ==============================================================================

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter (Unified LLM access)
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (Optional, for o1/GPT-4 access)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# PostgreSQL (Orchestrator)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=nyra_admin
POSTGRES_PASSWORD=change-me-strong-password-32-chars
POSTGRES_ROOT_USER=postgres
POSTGRES_ROOT_PASSWORD=change-me-root-password
POSTGRES_DB=nyra_main
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_MULTIPLE_DATABASES="nyra_main nyra_auth nyra_analytics infisical twentycrm n8n dify"

# Database URLs (connection strings)
DATABASE_URL=postgresql://nyra_admin:${POSTGRES_PASSWORD}@postgres:5432/nyra_main
INFISICAL_DATABASE_URL=postgresql://nyra_admin:${POSTGRES_PASSWORD}@postgres:5432/infisical
TWENTYCRM_DATABASE_URL=postgresql://nyra_admin:${POSTGRES_PASSWORD}@postgres:5432/twentycrm
N8N_DATABASE_URL=postgresql://nyra_admin:${POSTGRES_PASSWORD}@postgres:5432/n8n
DIFY_DATABASE_URL=postgresql://nyra_admin:${POSTGRES_PASSWORD}@postgres:5432/dify

# Redis (Orchestrator)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password-32-chars
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_MAXMEMORY=4gb
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_DB=0

# MongoDB (Orchestrator)
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_USERNAME=admin
MONGODB_PASSWORD=change-me-mongodb-password
MONGODB_ROOT_USERNAME=admin
MONGODB_ROOT_PASSWORD=change-me-mongodb-root-password
MONGODB_INITDB_DATABASE=nyra
MONGODB_REPLICA_SET_NAME=rs0
MONGODB_CACHE_SIZE_GB=0.5

# Qdrant (Vector Database / AgentDB)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=change-me-qdrant-api-key
QDRANT_URL=http://qdrant:6333
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=100
QDRANT_MAX_SEARCH_THREADS=4

# ==============================================================================
# NEXUS ROUTER & MCP CONFIGURATION
# ==============================================================================

MCP_NEXUS_PORT=6000
MCP_NEXUS_HOST=0.0.0.0
NEXUS_REDIS_URL=${REDIS_URL}

# Worker URLs (local GPU inference)
WORKER_5090_URL=http://worker-5090.tail-net.ts.net:11434
WORKER_3090_URL=http://worker-3090.tail-net.ts.net:11434
WORKER_3060_URL=http://worker-3060.tail-net.ts.net:11434

# LiteLLM Configuration
LITELLM_PORT=8000
LITELLM_HOST=0.0.0.0
LITELLM_LOG_LEVEL=info
LITELLM_PROXY_REDIS_URL=${REDIS_URL}
LITELLM_MODEL_FALLBACK_ORDER="deepseek-r1,llama3.1,qwen2.5,codellama,gemini-flash"
LLM_STRATEGY=cost-optimized
LLM_LOCAL_WEIGHT=80
LLM_CLOUD_WEIGHT=20
LLM_TIMEOUT=60000

# ==============================================================================
# MCP SERVERS - CONFIGURATION
# ==============================================================================

# Graphiti (Knowledge Graph)
GRAPHITI_URL=http://graphiti-mcp:8000
GRAPHITI_ENABLED=true

# Mem0 (Memory Service)
MEM0_URL=http://mem0:5000
MEM0_API_KEY=change-me-mem0-api-key
MEM0_ENABLED=true

# Letta (Agent Framework)
LETTA_URL=http://letta:8283
LETTA_API_KEY=change-me-letta-api-key
LETTA_ENABLED=true

# Infisical MCP
INFISICAL_MCP_PORT=8006
INFISICAL_MCP_HOST=0.0.0.0
INFISICAL_MCP_ENABLED=true

# Docker Toolkit MCP
DOCKER_MCP_PORT=8811
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_MCP_ENABLED=true

# Composio (80+ Integrations)
COMPOSIO_API_KEY=change-me-composio-api-key
COMPOSIO_MCP_URL=http://composio-mcp:8086
COMPOSIO_ENABLED=true

# ==============================================================================
# CLAUDE FLOW V3 CONFIGURATION
# ==============================================================================

CLAUDE_FLOW_MODE=orchestrator
CLAUDE_FLOW_VERSION=3.0.0-alpha
CLAUDE_FLOW_TOPOLOGY=hierarchical-mesh
CLAUDE_FLOW_MAX_AGENTS=35
CLAUDE_FLOW_MAX_CONCURRENT_TASKS=25
CLAUDE_FLOW_WORKER_THREADS=8
CLAUDE_FLOW_MEMORY_LIMIT=2048
CLAUDE_FLOW_CACHE_SIZE=512
CLAUDE_FLOW_DAEMON_ENABLED=true
CLAUDE_FLOW_HOOKS_ENABLED=true
CLAUDE_FLOW_LOG_LEVEL=info
CLAUDE_FLOW_DEBUG=false

# Swarm Configuration
SWARM_TOPOLOGY=hierarchical-mesh
SWARM_MAX_AGENTS=35
SWARM_ROLE=coordinator
SWARM_AUTO_SCALE=true
SWARM_COORDINATION_PROTOCOL=mesh
SWARM_WORKERS=${WORKER_5090_URL},${WORKER_3090_URL},${WORKER_3060_URL}

# ==============================================================================
# TWENTYCRM CONFIGURATION (System of Record)
# ==============================================================================

TWENTYCRM_PORT=3001
TWENTYCRM_HOST=0.0.0.0
TWENTYCRM_DATABASE_URL=${TWENTYCRM_DATABASE_URL}
TWENTYCRM_REDIS_URL=${REDIS_URL}
TWENTYCRM_JWT_SECRET=change-me-twentycrm-jwt-secret-64-chars
TWENTYCRM_REFRESH_TOKEN_SECRET=change-me-refresh-token-secret-64-chars
TWENTYCRM_LOGIN_TOKEN_SECRET=change-me-login-token-secret-64-chars
TWENTYCRM_ACCESS_TOKEN_SECRET=change-me-access-token-secret-64-chars
TWENTYCRM_STORAGE_TYPE=local
TWENTYCRM_STORAGE_LOCAL_PATH=/app/storage
TWENTYCRM_TELEMETRY_ENABLED=false
TWENTYCRM_SIGN_UP_DISABLED=false
TWENTYCRM_LOG_LEVEL=info
TWENTYCRM_API_KEY=change-me-twentycrm-api-key

# ==============================================================================
# N8N WORKFLOW AUTOMATION
# ==============================================================================

N8N_PORT=5678
N8N_HOST=0.0.0.0
N8N_DATABASE_URL=${N8N_DATABASE_URL}
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key-32-chars
N8N_EXECUTION_MODE=queue
N8N_QUEUE_TYPE=redis
N8N_QUEUE_BULL_REDIS_URL=${REDIS_URL}
N8N_TIMEZONE=America/Los_Angeles
N8N_LOG_LEVEL=info
N8N_API_KEY=change-me-n8n-api-key
N8N_WEBHOOK_BASE_URL=https://n8n.ratehunter.net

# ==============================================================================
# ACTIVEPIECES WORKFLOW AUTOMATION
# ==============================================================================

ACTIVEPIECES_PORT=5000
ACTIVEPIECES_HOST=0.0.0.0
ACTIVEPIECES_API_KEY=change-me-activepieces-api-key
ACTIVEPIECES_ENABLED=true

# ==============================================================================
# DIFY - LLM APPLICATION PLATFORM
# ==============================================================================

DIFY_PORT=5001
DIFY_HOST=0.0.0.0
DIFY_DATABASE_URL=${DIFY_DATABASE_URL}
DIFY_REDIS_URL=${REDIS_URL}
DIFY_JWT_SECRET=change-me-dify-jwt-secret-64-chars
DIFY_API_KEY=change-me-dify-api-key
DIFY_ENABLED=true

# ==============================================================================
# CLOUDFLARE & TUNNELING
# ==============================================================================

# Cloudflare Tunnel (Cloudflared)
CLOUDFLARE_TUNNEL_ID=64fe03f2-9859-44ca-b0ab-e499d8464104
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-from-cloudflare-dash
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_TUNNEL_NAME=nyra-orchestrator
CLOUDFLARE_TUNNEL_LOGLEVEL=info
CLOUDFLARE_TUNNEL_METRICS=0.0.0.0:8080

# Cloudflare R2 (Object Storage - Optional)
CLOUDFLARE_R2_ACCOUNT_ID=${CLOUDFLARE_ACCOUNT_ID}
CLOUDFLARE_R2_ACCESS_KEY_ID=change-me-r2-access-key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=change-me-r2-secret-key
R2_BUCKET_NAME=nyra-crm-storage

# ==============================================================================
# EXTERNAL APIs & INTEGRATIONS
# ==============================================================================

# GitHub
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-github-org
GITHUB_REPO=Project-Nyra

# Slack
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SLACK_SIGNING_SECRET=change-me-slack-signing-secret

# Gmail / Google Workspace
GOOGLE_WORKSPACE_EMAIL=your-workspace-email@domain.com
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/google-service-account.json

# Twilio (SMS + Voice)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=change-me-twilio-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# SendGrid (Email)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS=noreply@ratehunter.net
EMAIL_FROM_NAME=Nyra Mortgage Platform

# LendingTree API
LENDINGTREE_API_KEY=change-me-lendingtree-api-key
LENDINGTREE_ENABLED=true

# FreeRateUpdate API
FREERATEUPDATE_API_KEY=change-me-freerateupdate-api-key
FREERATEUPDATE_ENABLED=true

# Rocket Mortgage API
ROCKET_MORTGAGE_API_KEY=change-me-rocket-mortgage-api-key
ROCKET_MORTGAGE_ENABLED=true

# LenderPrice API
LENDERPRICE_API_KEY=change-me-lenderprice-api-key
LENDERPRICE_ENABLED=true

# LeadMailbox
LEADMAILBOX_API_KEY=change-me-leadmailbox-api-key
LEADMAILBOX_ACCOUNT_ID=your-leadmailbox-account-id
LEADMAILBOX_ENABLED=true

# ==============================================================================
# MONITORING & OBSERVABILITY
# ==============================================================================

# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_HOST=0.0.0.0
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_RETENTION_DAYS=30

# Grafana
GRAFANA_PORT=3000
GRAFANA_HOST=0.0.0.0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
GRAFANA_ADMIN_EMAIL=admin@ratehunter.net
GRAFANA_PROVISIONING_PATH=/etc/grafana/provisioning

# Loki (Log Aggregation)
LOKI_PORT=3100
LOKI_HOST=0.0.0.0
LOKI_RETENTION_DAYS=7

# Jaeger (Distributed Tracing)
JAEGER_AGENT_PORT=6831
JAEGER_AGENT_HOST=localhost
JAEGER_QUERY_PORT=16686

# Sentry (Error Tracking)
SENTRY_ENABLED=false
SENTRY_DSN=change-me-sentry-dsn

# ==============================================================================
# GITEA - LOCAL GIT SERVER
# ==============================================================================

GITEA_PORT=3001
GITEA_DOMAIN=git.ratehunter.net
GITEA_ADMIN_USER=admin
GITEA_ADMIN_PASSWORD=change-me-gitea-password
GITEA_ADMIN_EMAIL=admin@ratehunter.net
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=change-me-gitea-db-password
GITEA_DB_NAME=gitea
GITEA_SECRET_KEY=change-me-secret-key-minimum-32-chars
GITEA_INTERNAL_TOKEN=change-me-internal-token-minimum-32-chars
GITEA_LOG_LEVEL=Info

# ==============================================================================
# SECURITY & COMPLIANCE
# ==============================================================================

# TCPA/TRID Compliance
TCPA_STOP_COMPLIANCE_ENABLED=true
TRID_DISCLOSURE_ENABLED=true
FAIR_LENDING_AUDIT_ENABLED=true
PII_LOGGING_ENABLED=true
PII_ENCRYPTION_ENABLED=true

# SSL/TLS
SSL_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/server.crt
SSL_KEY_PATH=/etc/ssl/private/server.key
SSL_VERIFY_PEER=true

# OAuth/OIDC
OAUTH_ENABLED=true
OAUTH_PROVIDER=keycloak
OAUTH_CLIENT_ID=nyra-orchestrator
OAUTH_CLIENT_SECRET=change-me-oauth-secret
OAUTH_REDIRECT_URI=http://localhost:8000/oauth/callback

# ==============================================================================
# PERFORMANCE TUNING
# ==============================================================================

# Connection Pooling
DB_CONNECTION_POOL_SIZE=50
DB_CONNECTION_TIMEOUT=10000
DB_IDLE_TIMEOUT=900000

# Caching
CACHE_TTL=3600
CACHE_ENABLED=true
CACHE_BACKEND=redis

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
RATE_LIMIT_BURST=10

# Request Timeout
REQUEST_TIMEOUT=30000

# ==============================================================================
# LOGGING & DEBUG
# ==============================================================================

LOG_LEVEL=info
LOG_FORMAT=json
DEBUG_MODE=false
VERBOSE_LOGGING=false
LOG_FILE_PATH=/app/logs

# Model-specific logging
VERBOSE_GPU_LOGGING=false
VERBOSE_VLLM_LOGGING=false
OLLAMA_DEBUG=false

# ==============================================================================
# TAILSCALE - MESH VPN
# ==============================================================================

TAILSCALE_ENABLED=true
TAILSCALE_AUTHKEY=tskey-auth-change-me
TAILSCALE_HOSTNAME=orchestrator
TAILSCALE_ADVERTISE_ROUTES=192.168.1.0/24
TAILSCALE_MCP_ENABLED=true

# ==============================================================================
# WORKER CONFIGURATION
# ==============================================================================

# PC2: RTX 3060 (Tier 3 - Fast Processing)
GPU_WORKER_3060_URL=${WORKER_3060_URL}
GPU_WORKER_3060_PRIORITY=3
GPU_WORKER_3060_MAX_CONCURRENT=2

# PC3: RTX 5090 (Tier 1 - Heavy Operations)
GPU_WORKER_5090_URL=${WORKER_5090_URL}
GPU_WORKER_5090_PRIORITY=1
GPU_WORKER_5090_MAX_CONCURRENT=4

# PC4: RTX 3090 Ti (Tier 2 - Analysis)
GPU_WORKER_3090_URL=${WORKER_3090_URL}
GPU_WORKER_3090_PRIORITY=2
GPU_WORKER_3090_MAX_CONCURRENT=3

# ==============================================================================
# ORACLE CLOUD - ALWAYS-ON SERVICES
# ==============================================================================

ORACLE_ENABLED=false  # Enable when deployed to Oracle Cloud
ORACLE_REGION=us-ashburn-1
ORACLE_COMPARTMENT_ID=your-oracle-compartment-id
ORACLE_TENANCY_OCID=your-oracle-tenancy-ocid

# ==============================================================================
# END OF ENVIRONMENT CONFIGURATION
# ==============================================================================

# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Edit with your values: nano .env (or your editor)
# 3. NEVER commit .env to git
# 4. Keep in Infisical for production
# 5. Validate with: make health-check
