# Claude Flow Environment Variables Example
# Copy to .env and fill in your values

# === API Keys (Required) ===
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# === Optional API Keys ===
OPENROUTER_API_KEY=sk-or-your-key-here
OPENAI_API_KEY=sk-your-key-here
GEMINI_API_KEY=your-key-here

# === GitHub Integration ===
GITHUB_TOKEN=ghp_your-token-here

# === Infisical Secrets Management ===
INFISICAL_PROJECT_ID=your-project-id
INFISICAL_CLIENT_ID=your-client-id
INFISICAL_CLIENT_SECRET=your-client-secret
INFISICAL_ENVIRONMENT=dev
INFISICAL_PATH=/shared

# === Database Configuration ===
DATABASE_URL=postgresql://user:password@localhost:5432/claude_flow
REDIS_URL=redis://localhost:6379/0

# === Cloud Provider (AWS Example) ===
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=claude-flow-backups

# === Security ===
JWT_SECRET=your-jwt-secret-256-bits-minimum
ENCRYPTION_KEY=your-encryption-key-256-bits-minimum

# === Notifications ===
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-email@example.com
EMAIL_SMTP_PASS=your-password

# === Flow Nexus Configuration ===
FLOW_NEXUS_API_KEY=your-flow-nexus-key
FLOW_NEXUS_USER_ID=your-user-id

# === Monitoring ===
GRAFANA_ADMIN_PASSWORD=your-secure-password
