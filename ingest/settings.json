{
  "_comment": "Optimized Claude Flow settings.json (runtime toggles only). Secrets + stable endpoints should be injected via Infisical/.env.",
  "env": {
    "CLAUDE_FLOW_MODE": "orchestrator",
    "NODE_ENV": "development",
    "LOG_LEVEL": "info",
    "MAX_AGENTS": "100",
    "CLAUDE_FLOW_MAX_CONCURRENT_TASKS": "50",
    "SWARM_TOPOLOGY": "mesh",
    "CLAUDE_FLOW_PERFORMANCE_MODE": "balanced",
    "CLAUDE_FLOW_ENABLED": "true",
    "CLAUDE_FLOW_HOOKS_ENABLED": "true",
    "CLAUDE_FLOW_TELEMETRY_ENABLED": "true",
    "CLAUDE_FLOW_GITHUB_INTEGRATION": "true",
    "CLAUDE_FLOW_CHECKPOINT_ENABLED": "true",
    "CLAUDE_FLOW_CHECKPOINTS_ENABLED": "true",
    "CLAUDE_FLOW_MEMORY_PERSISTENCE": "true",
    "CLAUDE_FLOW_NEURAL_OPTIMIZATION": "true",
    "CLAUDE_FLOW_CACHE_ENABLED": "true",
    "CLAUDE_FLOW_PARALLEL_PROCESSING": "true",
    "CLAUDE_FLOW_AGENT_POOL": "true",
    "CLAUDE_FLOW_AUTO_LEARNING": "true",
    "CREATE_GH_RELEASE": "false",
    "PROVIDER": "anthropic",
    "COMPLETION_MODEL": "anthropic/sonnet",
    "USE_OPENROUTER": "true",
    "USE_ONNX": "false",
    "AGENTDB_ENABLED": "true",
    "AGENTDB_VECTOR_ENABLED": "true",
    "AGENTDB_QUANTIZATION": "scalar",
    "AGENTDB_QUIC_SYNC": "true",
    "RUVECTOR_ENABLED": "true",
    "RUVECTOR_MODE": "distributed",
    "GRAPHITI_ENABLED": "true",
    "GRAPHITI_BACKEND": "neo4j",
    "QDRANT_ENABLED": "true",
    "OPENMEMORY_ENABLED": "true",
    "OPENMEMORY_MCP_ENABLED": "true",
    "MEM0_ENABLED": "true",
    "LETTA_ENABLED": "false",
    "LETTA_MCP_ENABLED": "false"
  },
  "permissions": {
    "allowHttp": true,
    "allowFileSystem": true,
    "allowExternalProcesses": false
  },
  "performance": {
    "maxAgents": 100,
    "maxConcurrentTasks": 50,
    "cacheTTLSeconds": 600,
    "connectionPoolSize": 20
  }
}