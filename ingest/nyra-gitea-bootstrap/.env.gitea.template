# Copy to .env.gitea (or let Setup-NYRA-Gitea.ps1 generate it)
# Lines starting with # are comments.

# === Must-set (only if you enable AI reviewer) ===
# OPENROUTER_API_KEY=REPLACE_ME

# === Machine identity ===
NYRA_MACHINE=orchestrator
NYRA_NETWORK=nyra-net

# === Gitea endpoints (what humans see in links) ===
GITEA_ROOT_URL=http://orchestrator:3100/
GITEA_DOMAIN=orchestrator
GITEA_SSH_DOMAIN=orchestrator
GITEA_WEB_PORT=3100
GITEA_SSH_PORT=2222

# === Database ===
GITEA_DB_PASS=REPLACE_ME

# === Admin bootstrap ===
GITEA_ADMIN_USER=apotheosis
GITEA_ADMIN_PASS=REPLACE_ME
GITEA_ADMIN_EMAIL=apotheosis@ratehunter.net

# === Tokens (generated by Setup-NYRA-Gitea.ps1) ===
GITEA_TOKEN=REPLACE_ME
GITEA_RUNNER_TOKEN=REPLACE_ME
WEBHOOK_SECRET=REPLACE_ME
WEBHOOK_AUTH_TOKEN=REPLACE_ME

# === AI reviewer ===
OPENAI_BASE_URL=https://openrouter.ai/api/v1
REVIEW_MODEL=anthropic/claude-3.5-sonnet
REVIEW_MAX_CHARS=18000
REVIEW_POST_AS_REVIEW=true
REVIEW_LABEL=ai-reviewed

# === Runner labels (optional) ===
GITEA_RUNNER_LABELS=docker:docker://alpine:3.19,linux:host

# === Cloudflared (optional profile: public) ===
CLOUDFLARED_TUNNEL_TOKEN=
