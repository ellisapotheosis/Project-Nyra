# Claude Flow V3 Alpha - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Infisical Secrets Management (Recommended for Production)
# =============================================================================
# Get your service token from: https://app.infisical.com
INFISICAL_TOKEN=st.xxx.xxx.xxx
INFISICAL_ENV=production                    # dev, staging, or production
INFISICAL_PATH=/nyra/claude-flow           # Path to secrets in Infisical

# =============================================================================
# API Keys (Required if not using Infisical)
# =============================================================================
# Anthropic Claude API Key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-xxx

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=xxx

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-xxx

# =============================================================================
# Claude Flow Configuration
# =============================================================================
# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# MCP Server Port (default: 3000)
MCP_PORT=3000

# Swarm Configuration
SWARM_TOPOLOGY=mesh                         # mesh, hierarchical, hierarchical-mesh
SWARM_MAX_AGENTS=8
SWARM_STRATEGY=balanced                     # balanced, adaptive, specialized

# Memory Backend (hybrid, agentdb, ruvector)
MEMORY_BACKEND=hybrid

# =============================================================================
# Nexus Router Integration (LLM Gateway)
# =============================================================================
# Nexus Router URL (runs on port 6000)
NEXUS_ROUTER_URL=http://nexus-router:6000

# Default provider (anthropic, openai, google, ollama)
DEFAULT_PROVIDER=anthropic

# Fallback providers (comma-separated)
FALLBACK_PROVIDERS=openai,google,ollama

# =============================================================================
# Memory System URLs (Service Discovery)
# =============================================================================
# AgentDB - HNSW Vector Database
AGENTDB_URL=http://agentdb:8080

# RuVector - Memory Optimization
RUVECTOR_URL=http://ruvector:8888

# Mem0 - Universal Memory Layer
MEM0_REST_URL=http://mem0:4321

# Letta (MemGPT) - Conversational Memory
LETTA_BASE_URL=http://letta:8283

# =============================================================================
# Feature Flags
# =============================================================================
# Enable/disable features
REASONINGBANK_ENABLED=true
HNSW_ENABLED=true
NEURAL_PATTERNS_ENABLED=true
HOOKS_ENABLED=true
DAEMON_ENABLED=true

# =============================================================================
# Docker Build Arguments (Optional)
# =============================================================================
# Version tag
VERSION=3.0.0-alpha

# Build timestamp (auto-generated in CI/CD)
BUILD_DATE=2026-01-22T00:00:00Z

# Git commit hash (auto-generated in CI/CD)
GIT_COMMIT=

# =============================================================================
# Nyra Services Integration (Optional)
# =============================================================================
# TwentyCRM
TWENTY_BASE_URL=http://twenty:3000

# n8n Workflow Automation
N8N_BASE_URL=http://n8n:5678

# Dify Chat UI
DIFY_BASE_URL=http://dify-api:5001

# =============================================================================
# Database Configuration (If using separate DB)
# =============================================================================
# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=claude_flow
POSTGRES_USER=claude_flow
POSTGRES_PASSWORD=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# Performance Tuning
# =============================================================================
# Node.js memory limits
NODE_OPTIONS=--max-old-space-size=4096

# Container resource limits (uncomment in docker-compose.yml)
# MEMORY_LIMIT=8G
# CPU_LIMIT=4.0
# MEMORY_RESERVATION=4G
# CPU_RESERVATION=2.0

# =============================================================================
# Security
# =============================================================================
# JWT secret for MCP server authentication
JWT_SECRET=

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=5000
RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# Monitoring & Observability
# =============================================================================
# Prometheus metrics port
METRICS_PORT=9090

# Enable metrics export
EXPORT_METRICS=true

# Alert thresholds
ALERT_ERROR_RATE=0.03
ALERT_RESPONSE_TIME=3000
ALERT_MEMORY_USAGE=0.85
ALERT_CPU_USAGE=0.90

# =============================================================================
# Local Development (Optional)
# =============================================================================
# LAN IP for webhook callbacks
LAN_IP=192.168.1.100

# Enable debug mode
DEBUG=false

# Hot reload (development only)
HOT_RELOAD=false

# =============================================================================
# Backup Configuration (Optional)
# =============================================================================
# Backup schedule (cron format)
BACKUP_SCHEDULE=0 2 * * *

# Backup retention (days)
BACKUP_RETENTION=30

# Backup destination
BACKUP_PATH=/backups
