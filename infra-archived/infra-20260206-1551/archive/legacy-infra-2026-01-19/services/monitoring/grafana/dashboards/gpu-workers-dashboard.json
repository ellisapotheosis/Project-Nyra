{
  "dashboard": {
    "title": "GPU Workers - Local Inference",
    "tags": ["gpu", "workers", "inference"],
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 1,
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "GPU Utilization %",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "gpu_utilization_percent",
            "legendFormat": "{{worker}} GPU {{gpu_id}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "Utilization", "min": 0, "max": 100},
          {"format": "short"}
        ]
      },
      {
        "id": 2,
        "title": "GPU Memory Usage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "gpu_memory_used_bytes / gpu_memory_total_bytes * 100",
            "legendFormat": "{{worker}} GPU {{gpu_id}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "Memory %", "min": 0, "max": 100},
          {"format": "short"}
        ]
      },
      {
        "id": 3,
        "title": "GPU Temperature",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "gpu_temperature_celsius",
            "legendFormat": "{{worker}} GPU {{gpu_id}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "celsius", "label": "Temperature"},
          {"format": "short"}
        ],
        "thresholds": [
          {
            "value": 80,
            "colorMode": "critical",
            "op": "gt",
            "fill": true,
            "line": true
          }
        ]
      },
      {
        "id": 4,
        "title": "GPU Power Draw",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "gpu_power_draw_watts",
            "legendFormat": "{{worker}} GPU {{gpu_id}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "watt", "label": "Power"},
          {"format": "short"}
        ]
      },
      {
        "id": 5,
        "title": "Inference Throughput (inferences/s)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "sum(rate(model_inference_total[5m])) by (worker)",
            "legendFormat": "{{worker}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Inferences/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 6,
        "title": "Inference Latency Distribution",
        "type": "heatmap",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "sum(rate(model_inference_duration_bucket[5m])) by (le)",
            "format": "heatmap",
            "legendFormat": "{{le}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 7,
        "title": "Worker Status",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "up{job=\"gpu-workers\"}",
            "instant": true,
            "format": "table",
            "refId": "A"
          },
          {
            "expr": "gpu_utilization_percent",
            "instant": true,
            "format": "table",
            "refId": "B"
          },
          {
            "expr": "gpu_memory_used_bytes / gpu_memory_total_bytes * 100",
            "instant": true,
            "format": "table",
            "refId": "C"
          },
          {
            "expr": "gpu_temperature_celsius",
            "instant": true,
            "format": "table",
            "refId": "D"
          }
        ],
        "transformations": [
          {
            "id": "merge",
            "options": {}
          },
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "__name__": true,
                "job": true
              },
              "renameByName": {
                "worker": "Worker",
                "Value #A": "Status",
                "Value #B": "GPU Util %",
                "Value #C": "Memory %",
                "Value #D": "Temp °C"
              }
            }
          }
        ]
      },
      {
        "id": 8,
        "title": "Model Load Time",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(model_load_duration_bucket[5m])) by (model, worker, le))",
            "legendFormat": "{{worker}} - {{model}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Load Time"},
          {"format": "short"}
        ]
      },
      {
        "id": 9,
        "title": "Total Workers Available",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 32},
        "targets": [
          {
            "expr": "count(up{job=\"gpu-workers\"} == 1)",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "orange", "value": 1},
                {"color": "green", "value": 2}
              ]
            }
          }
        }
      },
      {
        "id": 10,
        "title": "Average GPU Utilization",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 32},
        "targets": [
          {
            "expr": "avg(gpu_utilization_percent)",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent"
          }
        }
      },
      {
        "id": 11,
        "title": "Total GPU Memory (GB)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 32},
        "targets": [
          {
            "expr": "sum(gpu_memory_total_bytes) / 1024 / 1024 / 1024",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "decgbytes"
          }
        }
      },
      {
        "id": 12,
        "title": "Inferences (24h)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 32},
        "targets": [
          {
            "expr": "sum(increase(model_inference_total[24h]))",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area"
        }
      }
    ]
  }
}
