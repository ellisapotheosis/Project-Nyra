{
  "mcpServers": {
    "claude-flow": {
      "command": "cmd",
      "args": [
        "/c",
        "node",
        "C:\\Dev\\Projects\\Repos\\Project-Nyra\\submodules\\claude-flow\\cli.mjs",
        "mcp",
        "start"
      ],
      "type": "stdio",
      "env": {
        "NODE_ENV": "development",
        "DEBUG": "claude-flow:*"
      }
    },
    "archon": {
      "command": "cmd",
      "args": [
        "/c",
        "node",
        "C:\\Dev\\Projects\\Repos\\Project-Nyra\\submodules\\archon\\archon-ui-main\\server.js",
        "--dev"
      ],
      "type": "stdio",
      "env": {
        "NODE_ENV": "development",
        "DEBUG": "archon:*"
      }
    },
    "ruv-swarm": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "ruv-swarm@latest",
        "mcp",
        "start"
      ],
      "type": "stdio"
    },
    "flow-nexus": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "flow-nexus@latest",
        "mcp",
        "start"
      ],
      "type": "stdio"
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Dev\\Projects\\Repos\\Project-Nyra"
      ],
      "type": "stdio"
    },
    "git": {
      "command": "npx",
      "args": [
        "-y",
        "git-mcp-server"
      ],
      "type": "stdio",
      "env": {
        "GIT_WORKDIR": "C:\\Dev\\Projects\\Repos\\Project-Nyra"
      }
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "type": "stdio",
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "docker": {
      "command": "uvx",
      "args": [
        "mcp-server-docker"
      ],
      "type": "stdio"
    },
    "browser-use": {
      "command": "uvx",
      "args": [
        "browser-use",
        "--mcp"
      ],
      "type": "stdio"
    },
    "shell": {
      "command": "uvx",
      "args": [
        "mcp-server-shell"
      ],
      "type": "stdio"
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "type": "stdio"
    },
    "time": {
      "command": "uvx",
      "args": [
        "mcp-server-time",
        "--local-timezone=America/New_York"
      ],
      "type": "stdio"
    },
    "puppeteer": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ],
      "type": "stdio"
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "type": "stdio"
    },
    "bitwarden": {
      "command": "npx",
      "args": [
        "-y",
        "@bitwarden/mcp-server"
      ],
      "type": "stdio",
      "env": {
        "BW_SESSION": "${BW_SESSION}"
      }
    },
    "infisical": {
      "command": "npx",
      "args": [
        "-y",
        "@infisical/mcp"
      ],
      "type": "stdio",
      "env": {
        "INFISICAL_UNIVERSAL_AUTH_CLIENT_ID": "${INFISICAL_UNIVERSAL_AUTH_CLIENT_ID}",
        "INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET": "${INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET}"
      }
    },
    "mem0": {
      "command": "npx",
      "args": [
        "-y",
        "@mem0ai/mem0-mcp"
      ],
      "type": "stdio"
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "type": "stdio",
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "codanna": {
      "command": "npx",
      "args": [
        "-y",
        "@codanna/mcp"
      ],
      "type": "stdio"
    },
    "repo-docs": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-markdown"
      ],
      "type": "stdio"
    },
    "inception": {
      "command": "npx",
      "args": [
        "-y",
        "@tanevanwifferen/mcp-inception"
      ],
      "type": "stdio"
    }
  }
}
