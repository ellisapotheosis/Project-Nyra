# Project Nyra Environment Configuration Template
# Copy to .env and fill in values

# ===================================
# API KEYS
# ===================================
ANTHROPIC_API_KEY=sk-ant-api-xxxxx
OPENROUTER_API_KEY=sk-or-xxxxx
GOOGLE_GEMINI_API_KEY=xxxxx

# ===================================
# GITHUB
# ===================================
GITHUB_TOKEN=ghp_xxxxx

# ===================================
# TWILIO (SMS/CALL)
# ===================================
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=xxxxx
TWILIO_PHONE_NUMBER=+1xxxxx

# ===================================
# DATABASE PASSWORDS
# ===================================
LETTA_POSTGRES_PASSWORD=change_me_letta_pass
TWENTY_POSTGRES_PASSWORD=change_me_twenty_pass
DIFY_POSTGRES_PASSWORD=change_me_dify_pass

# ===================================
# SECRETS MANAGEMENT
# ===================================
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=xxxxx
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=xxxxx
BW_SESSION=xxxxx

# ===================================
# APPLICATION SECRETS
# ===================================
DIFY_SECRET_KEY=change_this_secret_key_to_random_string
N8N_PASSWORD=change_me_n8n_password
GRAFANA_PASSWORD=admin

# ===================================
# MEMORY & CONTEXT
# ===================================
CONTEXT7_API_KEY=xxxxx

# ===================================
# NEO4J
# ===================================
NEO4J_PASSWORD=nyra_neo4j_password_change_me

# ===================================
# APPLICATION URLS
# ===================================
NEXUS_URL=http://localhost:6000
QUOTE_ENGINE_URL=http://localhost:8001
CAMPAIGN_ENGINE_URL=http://localhost:8002
ORCHESTRATOR_URL=http://localhost:8010
MEM0_URL=http://localhost:4321
LETTA_URL=http://localhost:8283
TWENTY_CRM_URL=http://localhost:3000
N8N_URL=http://localhost:5678
DIFY_URL=http://localhost:3001

# ===================================
# ENVIRONMENT
# ===================================
NODE_ENV=development
DEBUG=claude-flow:*,archon:*
