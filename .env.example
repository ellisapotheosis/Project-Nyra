# =============================================================================
# Project-Nyra — shared topology and image pins
# =============================================================================
# Copy to `.env` (gitignored) or render from Infisical.
# Contains variable NAMES and SAFE NON-SECRET DEFAULTS ONLY.
# Never place a real or realistic-looking secret in this file.
#
# Per-host overlays: infra/env/oracle.env.example,
# infra/env/worker-rtx5090.env.example, infra/env/worker-rtx3090ti.env.example,
# infra/env/agent.env.example
# =============================================================================

NYRA_ENV=production

# --- Tailnet topology (verified live 2026-09-04) ------------------------------
TAILNET_DOMAIN=trex-fiordland.ts.net

ORACLE_TAILSCALE_IP=100.64.0.3
WORKER_RTX5090_TAILSCALE_IP=100.64.0.11
WORKER_RTX3090TI_TAILSCALE_IP=100.64.0.13

# There are exactly TWO active GPU workers. worker-rtx3060 (100.64.0.12) has
# been retired and sold. Do not reintroduce it.

# --- Control plane ------------------------------------------------------------
LITELLM_BASE_URL=http://100.64.0.3:4000
LITELLM_OPENAI_BASE_URL=http://100.64.0.3:4000/v1

OMNIROUTE_BASE_URL=http://127.0.0.1:20128
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Proxy exclusions ---------------------------------------------------------
# The Infisical Agent Proxy must NEVER be used for local vLLM calls, LMCache
# Redis, Tailscale control traffic, localhost, or intra-Docker traffic.
NO_PROXY=127.0.0.1,localhost,100.64.0.3,100.64.0.11,100.64.0.13,.trex-fiordland.ts.net,litellm,litellm-redis,lmcache-redis,omniroute
no_proxy=127.0.0.1,localhost,100.64.0.3,100.64.0.11,100.64.0.13,.trex-fiordland.ts.net,litellm,litellm-redis,lmcache-redis,omniroute

# =============================================================================
# IMAGE PINS — immutable digests only. Never a floating tag in production.
# =============================================================================
# Resolved on oracle-vps during the 2026-09-04 migration.
# LiteLLM v1.99.1 was verified to publish a linux/arm64 manifest, which Oracle
# (aarch64) requires.

LITELLM_IMAGE=ghcr.io/berriai/litellm@sha256:a53a7d3ffebede1925bd3ee8a21e4a7b9b63e2e68ec883af136edcccb6eeb82c
REDIS_IMAGE=redis@sha256:ff02b58f971e7d7d156a1267e283fcbbeee91773b6aa36c49dac28ecfe28eadf

# lmcache/vllm-openai:v0.3.9 - the LMCache-integrated vLLM distribution.
# PENDING VALIDATION: `vllm serve --help` has not been run against this image on
# a GPU host, so the exact CLI syntax in compose.yaml is unconfirmed. Validate
# before first production start. See docs/refactor/NYRA_REFACTOR_VALIDATION.md.
VLLM_IMAGE=lmcache/vllm-openai@sha256:cb0a7630e91a39dc67bfb2c3486fa6616c3b2f254592117df6e6fb712ffb8999

# OmniRoute currently runs from a LOCAL build on oracle-vps with no upstream
# version tag. Populate with the digest of the image you build and push.
OMNIROUTE_IMAGE=

# Only needed for the `agent-containerized` profile (CI/sandbox). Interactive
# development uses the host-native ClawTeam/OpenHarness installs instead.
CLAWTEAM_IMAGE=
OPENHARNESS_IMAGE=

# =============================================================================
# Runtime env file locations (rendered by the Infisical Agent, never committed)
# =============================================================================
NYRA_ORACLE_RUNTIME_ENV=./runtime-secrets/oracle.runtime.env
NYRA_AGENT_RUNTIME_ENV=./runtime-secrets/agent.runtime.env
