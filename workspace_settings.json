{
  "workspace": {
    "name": "Project-Nyra",
    "type": "monorepo",
    "root": "${PROJECT_ROOT}",
    "defaultBranch": "main",
    "gitEnabled": true
  },
  "editor": {
    "tabSize": 2,
    "insertSpaces": true,
    "detectIndentation": true,
    "trimTrailingWhitespace": true,
    "insertFinalNewline": true,
    "formatOnSave": true
  },
  "files": {
    "exclude": {
      "**/node_modules": true,
      "**/.git": true,
      "**/dist": true,
      "**/build": true,
      "**/.next": true,
      "**/__pycache__": true,
      "**/.venv": true,
      "**/.pytest_cache": true,
      "**/coverage": true,
      "**/.turbo": true,
      "**/data/memory": true,
      "**/logs": true
    },
    "watcherExclude": {
      "**/node_modules/**": true,
      "**/.git/objects/**": true,
      "**/dist/**": true,
      "**/build/**": true,
      "**/.next/**": true
    }
  },
  "search": {
    "exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/.next": true,
      "**/coverage": true,
      "**/data/memory": true,
      "**/logs": true
    },
    "followSymlinks": false
  },
  "typescript": {
    "tsdk": "node_modules/typescript/lib",
    "enablePromptMode": true,
    "preferences": {
      "importModuleSpecifier": "relative",
      "quotePreference": "single"
    }
  },
  "python": {
    "defaultInterpreterPath": ".venv/bin/python",
    "linting": {
      "enabled": true,
      "pylintEnabled": false,
      "flake8Enabled": true,
      "mypyEnabled": true
    },
    "formatting": {
      "provider": "black",
      "blackArgs": ["--line-length", "100"]
    },
    "testing": {
      "pytestEnabled": true,
      "unittestEnabled": false
    }
  },
  "claudeFlow": {
    "version": "3.0.0",
    "autoStartDaemon": true,
    "enableHooks": true,
    "enableWorkers": true,
    "memoryBackend": "hybrid",
    "hnswEnabled": true,
    "sonaEnabled": true,
    "flashAttentionEnabled": true,
    "swarmDefaults": {
      "topology": "hierarchical",
      "maxAgents": 8,
      "strategy": "specialized",
      "consensus": "raft"
    },
    "workerDefaults": {
      "autoDispatch": true,
      "priority": "normal",
      "background": true
    }
  },
  "git": {
    "autofetch": true,
    "confirmSync": false,
    "enableSmartCommit": true,
    "defaultCloneDirectory": "${PROJECT_ROOT}",
    "ignoreLimitWarning": true
  },
  "terminal": {
    "integrated": {
      "shell": {
        "windows": "pwsh.exe",
        "linux": "/bin/bash"
      },
      "env": {
        "CLAUDE_FLOW_CONFIG": "${PROJECT_ROOT}/archon-os.config.json",
        "NODE_ENV": "development"
      }
    }
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "ms-python.python",
      "ms-python.vscode-pylance",
      "bradlc.vscode-tailwindcss",
      "prisma.prisma",
      "redhat.vscode-yaml",
      "ms-azuretools.vscode-docker"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Install Dependencies",
        "type": "shell",
        "command": "pnpm install",
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Start Claude Flow Daemon",
        "type": "shell",
        "command": "npx @archon-os/cli@latest daemon start",
        "problemMatcher": [],
        "isBackground": true
      },
      {
        "label": "Run System Diagnostics",
        "type": "shell",
        "command": "npx @archon-os/cli@latest doctor --fix",
        "problemMatcher": []
      },
      {
        "label": "Initialize Swarm",
        "type": "shell",
        "command": "npx @archon-os/cli@latest swarm init --topology hierarchical --max-agents 8",
        "problemMatcher": []
      }
    ]
  }
}
