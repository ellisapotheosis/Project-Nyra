{
  "archonMcp": {
    "name": "Archon MCP",
    "version": "2.0.0",
    "description": "Advanced agent coordination and memory management system",
    "configuration": {
      "server": {
        "host": "localhost",
        "port": 8081,
        "protocol": "stdio+grpc",
        "maxConcurrentAgents": 50,
        "memoryLimit": "2GB"
      },
      "agentCoordination": {
        "patterns": {
          "hierarchical": {
            "enabled": true,
            "maxLevels": 5,
            "coordinatorRatio": 0.2
          },
          "mesh": {
            "enabled": true,
            "maxConnections": 10,
            "discoveryInterval": 5000
          },
          "swarm": {
            "enabled": true,
            "emergentBehavior": true,
            "consensusAlgorithm": "raft"
          }
        },
        "capabilities": {
          "dynamicSpawning": true,
          "loadBalancing": true,
          "faultTolerance": true,
          "adaptiveScaling": true
        }
      },
      "memorySystem": {
        "distributed": {
          "enabled": true,
          "replicationFactor": 3,
          "consistencyLevel": "eventual"
        },
        "persistence": {
          "backend": "sqlite+redis",
          "snapshotInterval": 300000,
          "compressionEnabled": true
        },
        "sharding": {
          "enabled": true,
          "strategy": "hash-based",
          "numberOfShards": 8
        },
        "caching": {
          "l1Cache": {
            "size": "512MB",
            "ttl": 300
          },
          "l2Cache": {
            "size": "2GB",
            "ttl": 3600
          }
        }
      },
      "taskOrchestration": {
        "workflows": {
          "sparc": {
            "enabled": true,
            "phases": ["specification", "pseudocode", "architecture", "refinement", "completion"],
            "parallelExecution": true
          },
          "mortgage": {
            "enabled": true,
            "stages": ["lead-capture", "qualification", "processing", "underwriting", "closing"],
            "automation": "high"
          },
          "gpu-compute": {
            "enabled": true,
            "scheduling": "priority-based",
            "resourceAllocation": "dynamic"
          }
        },
        "execution": {
          "concurrency": "high",
          "queueManagement": "priority-queue",
          "deadlockDetection": true,
          "circuitBreaker": true
        }
      },
      "performance": {
        "optimization": {
          "neuralNetworks": true,
          "patternRecognition": true,
          "predictiveScaling": true,
          "resourcePrediction": true
        },
        "metrics": {
          "collection": "real-time",
          "aggregation": "sliding-window",
          "alerting": "threshold-based"
        }
      },
      "integration": {
        "claudeFlow": {
          "enabled": true,
          "syncInterval": 1000,
          "memorySharing": true
        },
        "nexusRouter": {
          "enabled": true,
          "registration": "automatic",
          "healthReporting": true,
          "note": "Uses Nexus Router unified gateway (replaces MetaMCP per ADR-002)"
        },
        "nyraOrchestrator": {
          "enabled": true,
          "gpuCoordination": true,
          "workloadDistribution": true
        }
      }
    },
    "apis": {
      "agent": {
        "spawn": "/api/v1/agent/spawn",
        "list": "/api/v1/agent/list",
        "status": "/api/v1/agent/status",
        "terminate": "/api/v1/agent/terminate"
      },
      "memory": {
        "store": "/api/v1/memory/store",
        "retrieve": "/api/v1/memory/retrieve",
        "query": "/api/v1/memory/query",
        "sync": "/api/v1/memory/sync"
      },
      "orchestration": {
        "workflow": "/api/v1/orchestration/workflow",
        "task": "/api/v1/orchestration/task",
        "status": "/api/v1/orchestration/status"
      }
    }
  }
}