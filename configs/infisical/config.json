{
  "version": "1.0.0",
  "logLevel": "info",
  "vaultBackend": "infisical",
  "defaultProject": "project-nyra",
  "defaultEnvironment": "dev",
  "cacheEnabled": true,
  "cacheDuration": 300,
  "autoSync": true,
  "syncInterval": 600,
  "encryption": {
    "enabled": true,
    "algorithm": "aes-256-gcm"
  },
  "projects": {
    "project-nyra": {
      "environments": ["dev", "staging", "production"],
      "autoImport": true
    }
  }
}
