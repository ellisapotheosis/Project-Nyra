{
  "thinkingBudget": 32000,
  "model": "claude-sonnet-4-5",
  "temperature": 1.0,
  "maxTokens": 8192,
  "codeExecution": {
    "enabled": true,
    "timeout": 30000,
    "sandboxed": true
  },
  "mcp": {
    "enabled": true,
    "servers": {
      "claude-flow": {
        "command": "npx",
        "args": ["-y", "@claude-flow/cli@latest"],
        "env": {}
      },
      "desktop-commander": {
        "command": "npx",
        "args": ["-y", "desktop-commander"],
        "env": {}
      }
    }
  },
  "contextWindow": {
    "maxTokens": 200000,
    "reserveTokens": 10000
  },
  "features": {
    "autoCommit": false,
    "autoFormat": true,
    "linting": true,
    "typeChecking": true
  },
  "editor": {
    "fontSize": 14,
    "fontFamily": "Consolas, 'Courier New', monospace",
    "tabSize": 2,
    "insertSpaces": true
  }
}
