# ==============================================================================
# PROJECT NYRA - OPTIMAL ENVIRONMENT CONFIGURATION
# ==============================================================================
# Production-ready, security-hardened, performance-optimized configuration
# This is the recommended starting point for current repo state
#
# Generated: 2026-01-18
# Based on: Current infrastructure analysis and best practices
# Architecture: 4-PC distributed (orchestrator + 3 GPU workers)
# ==============================================================================

# ==============================================================================
# CORE PROJECT SETTINGS
# ==============================================================================
PROJECT_NAME=project-nyra
NODE_ENV=production
ENVIRONMENT=production
PROJECT_ENV=production
LOG_LEVEL=info
DEBUG=false
VERBOSE_LOGGING=false
APP_NAME=Project Nyra
APP_URL=https://ratehunter.net
APP_PORT=3000
API_PORT=8000

# Claude-Flow Mode
CLAUDE_FLOW_MODE=orchestrator  # Set to "worker" on GPU worker PCs

# ==============================================================================
# INFISICAL SECRETS MANAGEMENT (RECOMMENDED)
# ==============================================================================
INFISICAL_PROJECT_ID=8374cea9-e5e8-4050-bda4-b91f25ab30ef
INFISICAL_ENVIRONMENT=production
INFISICAL_PATH=/shared
# Note: Set INFISICAL_TOKEN via environment or runtime for production

# ==============================================================================
# AI/LLM API KEYS (REQUIRED)
# ==============================================================================
# Get these from respective platforms
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096

GOOGLE_API_KEY=your-google-key-here
GOOGLE_GEMINI_MODEL=gemini-2.0-flash-exp

OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_MODEL=deepseek/deepseek-r1
OPENROUTER_SITE_URL=https://ratehunter.net
OPENROUTER_SITE_NAME=Project Nyra

# ==============================================================================
# GPU WORKERS - 4PC DISTRIBUTED ARCHITECTURE
# ==============================================================================
LOCAL_LLM_ENABLED=true
LOCAL_LLM_PRIORITY=true
LOCAL_LLM_FALLBACK_TO_CLOUD=true

# PC2: RTX 3060 (Coding)
GPU_WORKER_3060_URL=http://worker-3060.tail-net.ts.net:11434
GPU_WORKER_3060_MODELS=codellama:34b-q8,qwen2.5:32b-q8,gemma2:27b
GPU_WORKER_3060_PRIORITY=3
GPU_WORKER_3060_MAX_CONCURRENT=2

# PC3: RTX 5090 (Large Models - PRIMARY)
GPU_WORKER_5090_URL=http://worker-5090.tail-net.ts.net:11434
GPU_WORKER_5090_MODELS=deepseek-r1:236b-q4,qwen2.5:72b-q8
GPU_WORKER_5090_PRIORITY=1
GPU_WORKER_5090_MAX_CONCURRENT=3

# PC4: RTX 3090 Ti (Analysis - SECONDARY)
GPU_WORKER_3090_URL=http://worker-3090.tail-net.ts.net:11434
GPU_WORKER_3090_MODELS=llama3.1:70b-q4,mistral-large:123b-q4
GPU_WORKER_3090_PRIORITY=2
GPU_WORKER_3090_MAX_CONCURRENT=2

# ==============================================================================
# NEXUS ROUTER - UNIFIED GATEWAY
# ==============================================================================
NEXUS_ROUTER_ENABLED=true
NEXUS_ROUTER_PORT=7000
NEXUS_URL=http://localhost:7000
NEXUS_JWT_SECRET=GENERATE_WITH_openssl_rand_-hex_32
NEXUS_ADMIN_TOKEN=GENERATE_WITH_openssl_rand_-hex_32
NEXUS_LOAD_BALANCING=least-loaded
NEXUS_HEALTH_CHECK_INTERVAL=30
NEXUS_FALLBACK_ENABLED=true
NEXT_PUBLIC_NEXUS_URL=http://localhost:7000

# Model Routing Strategy
MODEL_ROUTING_STRATEGY=cost-optimized
MODEL_ROUTING_PREFER_LOCAL=true
MODEL_ROUTING_FALLBACK_CLOUD=true

# ==============================================================================
# MEMORY SYSTEMS
# ==============================================================================

# RuVector - Distributed Vector Search
RUVECTOR_ENABLED=true
RUVECTOR_MODE=distributed
RUVECTOR_PORT=7000
RUVECTOR_CONSENSUS_PEERS=worker-5090.tail-net.ts.net:7890,worker-3090.tail-net.ts.net:7890,worker-3060.tail-net.ts.net:7890
RUVECTOR_CONSENSUS_PROTOCOL=raft
RUVECTOR_VECTOR_DIM=1536
RUVECTOR_INDEX_TYPE=hnsw
RUVECTOR_HNSW_M=16
RUVECTOR_HNSW_EF_CONSTRUCTION=200
RUVECTOR_DATA_DIR=/mnt/nyra-data/ruvector
RUVECTOR_BACKUP_ENABLED=true

# Letta - Agent Memory
LETTA_ENABLED=true
LETTA_API_URL=http://localhost:8283
LETTA_API_KEY=GENERATE_WITH_openssl_rand_-hex_32
LETTA_SERVER_PASS=GENERATE_STRONG_PASSWORD
LETTA_POSTGRES_URI=postgresql://letta:LETTA_PASSWORD@localhost:5432/letta
LETTA_CORE_MEMORY_SIZE=4000
LETTA_ARCHIVAL_MEMORY_ENABLED=true

# Graphiti + FalkorDB - Knowledge Graphs
GRAPHITI_ENABLED=true
GRAPHITI_BACKEND=falkordb
GRAPHITI_TEMPORAL_TRACKING=true
FALKORDB_ENABLED=true
FALKORDB_URL=redis://localhost:6379
FALKORDB_PASSWORD=GENERATE_WITH_openssl_rand_-hex_32
FALKORDB_GRAPH_NAME=nyra_knowledge_graph

# Mem0 + OpenMemory - User Personalization
MEM0_ENABLED=true
MEM0_SERVER_URL=http://localhost:8080
MEM0_API_KEY=GENERATE_WITH_openssl_rand_-hex_32
OPENMEMORY_ENABLED=true
OPENMEMORY_MCP_PORT=8081

# Qdrant - Vector Database
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=nyra_embeddings
QDRANT_VECTOR_SIZE=1536

# ==============================================================================
# DATABASES
# ==============================================================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GENERATE_WITH_openssl_rand_-hex_32
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nyra_production
DATABASE_URL=postgresql://nyra:NYRA_PASSWORD@localhost:5432/nyra

# Connection Pooling
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=GENERATE_WITH_openssl_rand_-hex_32
REDIS_MAX_MEMORY=4GB
REDIS_EVICTION_POLICY=allkeys-lru
REDIS_URL=redis://localhost:6380/0

# ==============================================================================
# AI PLATFORMS
# ==============================================================================

# Dify
DIFY_ENABLED=true
DIFY_API_URL=http://localhost:5001
DIFY_SECRET_KEY=GENERATE_WITH_openssl_rand_-hex_32
DIFY_ENCRYPTION_KEY=GENERATE_WITH_openssl_rand_-hex_32
DIFY_POSTGRES_PASSWORD=GENERATE_WITH_openssl_rand_-hex_32

# n8n
N8N_ENABLED=true
N8N_PORT=5678
N8N_URL=http://localhost:5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=GENERATE_STRONG_PASSWORD
N8N_ENCRYPTION_KEY=GENERATE_WITH_openssl_rand_-hex_32
N8N_POSTGRES_PASSWORD=GENERATE_WITH_openssl_rand_-hex_32

# Activepieces
ACTIVEPIECES_ENABLED=true
ACTIVEPIECES_PORT=8080
ACTIVEPIECES_API_KEY=GENERATE_WITH_openssl_rand_-hex_32
AP_ENCRYPTION_KEY=GENERATE_WITH_openssl_rand_-hex_32
AP_JWT_SECRET=GENERATE_WITH_openssl_rand_-hex_32

# TwentyCRM
TWENTY_ENABLED=true
TWENTY_PORT=3001
TWENTY_ACCESS_TOKEN_SECRET=GENERATE_WITH_openssl_rand_-hex_32
TWENTY_LOGIN_TOKEN_SECRET=GENERATE_WITH_openssl_rand_-hex_32
TWENTY_REFRESH_TOKEN_SECRET=GENERATE_WITH_openssl_rand_-hex_32
TWENTY_FILE_TOKEN_SECRET=GENERATE_WITH_openssl_rand_-hex_32

# ==============================================================================
# CLAUDE-FLOW ORCHESTRATION
# ==============================================================================
CLAUDE_FLOW_ENABLED=true
CLAUDE_FLOW_AUTO_COMMIT=true
CLAUDE_FLOW_AUTO_PUSH=false
CLAUDE_FLOW_HOOKS_ENABLED=true
CLAUDE_FLOW_MEMORY_PERSISTENCE=true
CLAUDE_FLOW_NEURAL_OPTIMIZATION=true
CLAUDE_FLOW_AUTO_LEARNING=true
CLAUDE_FLOW_PARALLEL_PROCESSING=true
CLAUDE_FLOW_TELEMETRY_ENABLED=true
CLAUDE_FLOW_PERFORMANCE_MODE=optimized

# ==============================================================================
# NETWORKING
# ==============================================================================

# Tailscale VPN
TAILSCALE_ENABLED=true
TAILSCALE_AUTH_KEY=YOUR_TAILSCALE_AUTH_KEY
TAILSCALE_HOSTNAME=orchestrator
TAILSCALE_ADVERTISE_ROUTES=192.168.1.0/24

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_ENABLED=true
CLOUDFLARE_TUNNEL_TOKEN=YOUR_CLOUDFLARE_TUNNEL_TOKEN

# Domains
DOMAIN=ratehunter.net
DOMAIN_API=api.ratehunter.net
DOMAIN_APP=app.ratehunter.net
DOMAIN_CRM=crm.ratehunter.net

# CORS
CORS_ALLOWED_ORIGINS=https://ratehunter.net,https://app.ratehunter.net,https://crm.ratehunter.net
CORS_ALLOW_CREDENTIALS=true

# ==============================================================================
# COMMUNICATION
# ==============================================================================

# Twilio
TWILIO_ENABLED=true
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+15551234567

# Email
SENDGRID_ENABLED=true
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=noreply@ratehunter.net
SENDGRID_FROM_NAME=RateHunter

# ==============================================================================
# MONITORING
# ==============================================================================

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

# Grafana
GRAFANA_ENABLED=true
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=GENERATE_STRONG_PASSWORD

# Sentry
SENTRY_ENABLED=true
SENTRY_DSN=YOUR_SENTRY_DSN
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ==============================================================================
# SECURITY
# ==============================================================================

# Encryption
ENCRYPTION_KEY=GENERATE_WITH_openssl_rand_-hex_32
ENCRYPTION_ALGORITHM=aes-256-gcm

# Sessions
SESSION_SECRET=GENERATE_WITH_openssl_rand_-hex_32
SESSION_MAX_AGE=86400
SESSION_SECURE=true

# JWT
JWT_SECRET=GENERATE_WITH_openssl_rand_-hex_32
JWT_EXPIRATION=7d

# ==============================================================================
# COMPLIANCE
# ==============================================================================

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_LEVEL=info
AUDIT_LOG_DESTINATION=/var/log/nyra/audit.log
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years for TRID compliance

# Data Encryption
DATA_ENCRYPTION_AT_REST=true
DATA_ENCRYPTION_IN_TRANSIT=true
PII_MASKING_ENABLED=true

# TRID Compliance
TRID_ENABLED=true
TRID_LOAN_ESTIMATE_DAYS=3
TRID_CLOSING_DISCLOSURE_DAYS=3

# ==============================================================================
# PERFORMANCE
# ==============================================================================

# Node.js Options
NODE_OPTIONS=--max-old-space-size=4096 --max-http-header-size=16384

# Caching
CACHE_TTL_DEFAULT=300
CACHE_TTL_QUOTES=60
CACHE_TTL_USER_SESSIONS=3600

# Rate Limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=30000

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================
FEATURE_AI_CHATBOT=true
FEATURE_DRIP_CAMPAIGNS=true
FEATURE_DOCUMENT_OCR=true
FEATURE_MULTI_LENDER_QUOTES=true
FEATURE_SWARM_ORCHESTRATION=true
FEATURE_MEMORY_SYSTEMS=true
FEATURE_NEURAL_OPTIMIZATION=true
FEATURE_AUTO_LEARNING=true

# ==============================================================================
# TELEMETRY (DISABLE FOR PRODUCTION)
# ==============================================================================
NEXT_TELEMETRY_DISABLED=1
TURBO_TELEMETRY_DISABLED=1

# ==============================================================================
# NOTES
# ==============================================================================
# - Replace all placeholder values with actual secrets
# - Use: openssl rand -hex 32 to generate secrets
# - For production, migrate to Infisical (see INFISICAL-MIGRATION.md)
# - Each PC should use appropriate .env.orchestrator-mini or .env.worker-* file
# - Never commit this file with real secrets to git
# - Test thoroughly before deploying to production
