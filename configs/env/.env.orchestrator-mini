# ==============================================================================
# PC1: ORCHESTRATOR-MINI (Ryzen 7 3700X, 16GB RAM)
# ==============================================================================
# Role: Primary orchestrator, databases, MCP servers, web services
# IP: 10.0.0.1 (Tailscale: orchestrator.tail-net.ts.net)
#
# Hardware: Ryzen 7 3700X (8C/16T), 16GB DDR4, 1TB NVMe
# OS: Windows 11 Pro
# Services: PostgreSQL, Redis, FalkorDB, Qdrant, Nexus Router, Dify, n8n,
#           TwentyCRM, Letta, Monitoring Stack
# ==============================================================================

# Project Settings
PROJECT_NAME=project-nyra
NODE_ENV=production
CLAUDE_FLOW_MODE=orchestrator  # This is the orchestrator
LOG_LEVEL=info

# ==============================================================================
# INFISICAL
# ==============================================================================
INFISICAL_PROJECT_ID=8374cea9-e5e8-4050-bda4-b91f25ab30ef
INFISICAL_ENVIRONMENT=production

# ==============================================================================
# AI/LLM API KEYS (Required)
# ==============================================================================
ANTHROPIC_API_KEY=                  # REQUIRED
GOOGLE_API_KEY=                     # REQUIRED
OPENROUTER_API_KEY=                 # REQUIRED

# ==============================================================================
# LOCAL GPU WORKERS (Connect to other PCs)
# ==============================================================================
LOCAL_LLM_ENABLED=true
LOCAL_LLM_PRIORITY=true
LOCAL_LLM_FALLBACK_TO_CLOUD=true

# PC2: Worker RTX 3060 (Coding Specialist)
GPU_WORKER_3060_URL=http://worker-3060.tail-net.ts.net:11434
GPU_WORKER_3060_MODELS=codellama:34b-q8,qwen2.5:32b-q8,gemma2:27b
GPU_WORKER_3060_PRIORITY=3

# PC3: Worker RTX 5090 (Large Model Reasoning)
GPU_WORKER_5090_URL=http://worker-5090.tail-net.ts.net:11434
GPU_WORKER_5090_MODELS=deepseek-r1:236b-q4,qwen2.5:72b-q8
GPU_WORKER_5090_PRIORITY=1

# PC4: Worker RTX 3090 Ti (Analysis)
GPU_WORKER_3090_URL=http://worker-3090.tail-net.ts.net:11434
GPU_WORKER_3090_MODELS=llama3.1:70b-q4,mistral-large:123b-q4
GPU_WORKER_3090_PRIORITY=2

# ==============================================================================
# NEXUS ROUTER (PC1 Host)
# ==============================================================================
NEXUS_ROUTER_ENABLED=true
NEXUS_ROUTER_PORT=7000
NEXUS_JWT_SECRET=                   # REQUIRED: openssl rand -hex 32
NEXUS_ADMIN_TOKEN=                  # REQUIRED: openssl rand -hex 32
NEXUS_LOAD_BALANCING=least-loaded
NEXUS_HEALTH_CHECK_INTERVAL=30

# ==============================================================================
# MEMORY SYSTEMS (PC1 Host)
# ==============================================================================

# RuVector - Distributed Vector Search
RUVECTOR_ENABLED=true
RUVECTOR_MODE=distributed
RUVECTOR_PORT=7000
RUVECTOR_CONSENSUS_PEERS=worker-5090.tail-net.ts.net:7890,worker-3090.tail-net.ts.net:7890,worker-3060.tail-net.ts.net:7890
RUVECTOR_VECTOR_DIM=1536
RUVECTOR_INDEX_TYPE=hnsw
RUVECTOR_DATA_DIR=/mnt/nyra-data/ruvector
RUVECTOR_BACKUP_ENABLED=true

# Letta - Agent Memory
LETTA_ENABLED=true
LETTA_API_URL=http://localhost:8283
LETTA_API_KEY=                      # REQUIRED: openssl rand -hex 32
LETTA_SERVER_PASS=                  # REQUIRED
LETTA_POSTGRES_URI=postgresql://letta:PASSWORD@localhost:5432/letta

# Graphiti + FalkorDB - Knowledge Graphs
GRAPHITI_ENABLED=true
GRAPHITI_BACKEND=falkordb
FALKORDB_ENABLED=true
FALKORDB_URL=redis://localhost:6379
FALKORDB_PASSWORD=                  # REQUIRED: openssl rand -hex 32

# Mem0 + OpenMemory - User Personalization
MEM0_ENABLED=true
MEM0_SERVER_URL=http://localhost:8080
MEM0_API_KEY=                       # REQUIRED: openssl rand -hex 32
OPENMEMORY_ENABLED=true
OPENMEMORY_MCP_PORT=8081

# Qdrant - Vector Database
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=nyra_embeddings

# ==============================================================================
# DATABASES (PC1 Host)
# ==============================================================================

# PostgreSQL - Primary Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=                  # REQUIRED: openssl rand -hex 32
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Application Users
NYRA_APP_USER=nyra_app_user
NYRA_APP_PASSWORD=                  # REQUIRED: openssl rand -hex 32
NYRA_AUTH_USER=nyra_auth_user
NYRA_AUTH_PASSWORD=                 # REQUIRED: openssl rand -hex 32

# Redis - Caching
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=                     # REQUIRED: openssl rand -hex 32
REDIS_MAX_MEMORY=4GB

# ==============================================================================
# AI PLATFORMS (PC1 Host)
# ==============================================================================

# Dify
DIFY_ENABLED=true
DIFY_API_URL=http://localhost:5001
DIFY_SECRET_KEY=                    # REQUIRED: openssl rand -hex 32
DIFY_ENCRYPTION_KEY=                # REQUIRED: openssl rand -hex 32
DIFY_POSTGRES_PASSWORD=             # REQUIRED: openssl rand -hex 32

# n8n
N8N_ENABLED=true
N8N_PORT=5678
N8N_BASIC_AUTH_PASSWORD=            # REQUIRED
N8N_ENCRYPTION_KEY=                 # REQUIRED: openssl rand -hex 32
N8N_POSTGRES_PASSWORD=              # REQUIRED: openssl rand -hex 32

# Activepieces
ACTIVEPIECES_ENABLED=true
ACTIVEPIECES_PORT=8080
ACTIVEPIECES_API_KEY=               # REQUIRED: openssl rand -hex 32
AP_ENCRYPTION_KEY=                  # REQUIRED: openssl rand -hex 32
AP_JWT_SECRET=                      # REQUIRED: openssl rand -hex 32

# TwentyCRM
TWENTY_ENABLED=true
TWENTY_PORT=3001
TWENTY_ACCESS_TOKEN_SECRET=         # REQUIRED: openssl rand -hex 32
TWENTY_LOGIN_TOKEN_SECRET=          # REQUIRED: openssl rand -hex 32
TWENTY_REFRESH_TOKEN_SECRET=        # REQUIRED: openssl rand -hex 32
TWENTY_FILE_TOKEN_SECRET=           # REQUIRED: openssl rand -hex 32

# ==============================================================================
# NETWORKING (PC1 Specific)
# ==============================================================================

# Tailscale
TAILSCALE_ENABLED=true
TAILSCALE_AUTH_KEY=                 # REQUIRED
TAILSCALE_HOSTNAME=orchestrator
TAILSCALE_ADVERTISE_ROUTES=192.168.1.0/24

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_ENABLED=true
CLOUDFLARE_TUNNEL_TOKEN_ORCHESTRATOR=  # REQUIRED

# ==============================================================================
# MONITORING (PC1 Host)
# ==============================================================================

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ENABLED=true
GRAFANA_PORT=3002
GRAFANA_ADMIN_PASSWORD=             # REQUIRED

# ==============================================================================
# RESOURCE LIMITS (16GB RAM)
# ==============================================================================
NODE_OPTIONS=--max-old-space-size=2048
DB_POOL_MAX=10
REDIS_MAX_MEMORY=4GB
MAX_CONCURRENT_REQUESTS=50

# ==============================================================================
# DOMAINS
# ==============================================================================
DOMAIN_PRIMARY=ratehunter.net
DOMAIN_API=api.ratehunter.net
APP_URL=https://ratehunter.net

# ==============================================================================
# COMPLIANCE
# ==============================================================================
AUDIT_LOG_ENABLED=true
AUDIT_LOG_DESTINATION=/var/log/nyra/audit.log
DATA_ENCRYPTION_AT_REST=true
PII_MASKING_ENABLED=true

# ==============================================================================
# Notes
# ==============================================================================
# - This PC orchestrates all services
# - Connects to workers via Tailscale mesh VPN
# - All databases hosted here
# - Resource-constrained: 16GB RAM total
