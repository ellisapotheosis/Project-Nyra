# ============================================================================
# RUVECTOR - DISTRIBUTED VECTOR SEARCH CONFIGURATION
# ============================================================================
# Ultra-fast distributed vector search system using Rust-based performance
# optimizations and WebAssembly for maximum throughput.
#
# System Architecture:
# - Orchestrator PC (Area51): Coordination and primary index
# - GPU Worker 5090: Vector index node + inference
# - GPU Worker 3090Ti: Vector index node + inference
# - GPU Worker 3060: Vector index node + inference
#
# Usage:
#   docker compose --env-file configs/env/ruvector.env up -d
#   infisical run --env ruvector -- docker compose up -d
# ============================================================================

# ----------------------------------------------------------------------------
# CORE CONFIGURATION
# ----------------------------------------------------------------------------

# Enable/disable RuVector service
RUVECTOR_ENABLED=true

# Operating mode: standalone, distributed, cluster
# - standalone: Single node, no replication
# - distributed: Multi-node with Raft consensus
# - cluster: Full cluster mode with sharding
RUVECTOR_MODE=distributed

# Node identification
RUVECTOR_NODE_ID=${HOSTNAME:-orchestrator}
RUVECTOR_NODE_NAME=${HOSTNAME:-orchestrator}
RUVECTOR_NODE_ROLE=coordinator  # coordinator, worker, hybrid

# Service binding
RUVECTOR_HOST=0.0.0.0
RUVECTOR_PORT=7890
RUVECTOR_GRPC_PORT=7891
RUVECTOR_ADMIN_PORT=7892

# ----------------------------------------------------------------------------
# CONSENSUS & CLUSTERING
# ----------------------------------------------------------------------------

# Consensus protocol: raft, gossip, none
# Raft: Strong consistency, leader election
# Gossip: Eventual consistency, peer-to-peer
RUVECTOR_CONSENSUS_PROTOCOL=raft

# Consensus peers (comma-separated host:port)
# Format: hostname:port,hostname:port,hostname:port
RUVECTOR_CONSENSUS_PEERS=worker-5090.tail-net.ts.net:7890,worker-3090.tail-net.ts.net:7890,worker-3060.tail-net.ts.net:7890

# Quorum size (minimum nodes for consensus)
# For 4 nodes: quorum=3 tolerates 1 failure
# For 3 nodes: quorum=2 tolerates 1 failure
RUVECTOR_CONSENSUS_QUORUM=2

# Raft-specific configuration
RUVECTOR_RAFT_ELECTION_TIMEOUT_MS=1500
RUVECTOR_RAFT_HEARTBEAT_INTERVAL_MS=500
RUVECTOR_RAFT_SNAPSHOT_INTERVAL=1000
RUVECTOR_RAFT_LOG_COMPACTION_THRESHOLD=10000

# Gossip-specific configuration (if using gossip protocol)
RUVECTOR_GOSSIP_INTERVAL_MS=1000
RUVECTOR_GOSSIP_FANOUT=3
RUVECTOR_GOSSIP_SUSPICION_TIMEOUT_MS=5000

# Cluster discovery
RUVECTOR_DISCOVERY_ENABLED=true
RUVECTOR_DISCOVERY_METHOD=static  # static, dns, consul, etcd
RUVECTOR_DISCOVERY_INTERVAL_MS=30000

# Node health checking
RUVECTOR_HEALTH_CHECK_INTERVAL_MS=10000
RUVECTOR_HEALTH_CHECK_TIMEOUT_MS=5000
RUVECTOR_HEALTH_CHECK_RETRIES=3

# ----------------------------------------------------------------------------
# VECTOR INDEX CONFIGURATION
# ----------------------------------------------------------------------------

# Vector dimensions (must match embedding model)
# 1536: OpenAI text-embedding-3-small, text-embedding-ada-002
# 768: sentence-transformers/all-MiniLM-L6-v2
# 384: sentence-transformers/all-MiniLM-L12-v2
RUVECTOR_VECTOR_DIM=1536

# Index type: hnsw, flat, ivfflat, pq
# - hnsw: Hierarchical Navigable Small World (recommended)
# - flat: Brute force, accurate but slow
# - ivfflat: Inverted file with flat compression
# - pq: Product Quantization for memory efficiency
RUVECTOR_INDEX_TYPE=hnsw

# Distance metric: cosine, euclidean, dot_product, manhattan
RUVECTOR_DISTANCE_METRIC=cosine

# ----------------------------------------------------------------------------
# HNSW INDEX PARAMETERS
# ----------------------------------------------------------------------------

# M: Number of bi-directional links per node
# Higher M = better recall, more memory, slower indexing
# Typical range: 16-64, default: 16
RUVECTOR_HNSW_M=16

# efConstruction: Size of dynamic candidate list during indexing
# Higher = better index quality, slower indexing
# Typical range: 100-500, default: 200
RUVECTOR_HNSW_EF_CONSTRUCTION=200

# efSearch: Size of dynamic candidate list during search
# Higher = better recall, slower search
# Typical range: 50-500, default: 100
RUVECTOR_HNSW_EF_SEARCH=100

# Maximum layers in HNSW graph
RUVECTOR_HNSW_MAX_LAYERS=5

# Layer multiplier for level generation
RUVECTOR_HNSW_LEVEL_MULTIPLIER=0.5

# ----------------------------------------------------------------------------
# QUANTIZATION (MEMORY OPTIMIZATION)
# ----------------------------------------------------------------------------

# Enable quantization for reduced memory usage
# Reduces vector precision to save 4-8x memory
RUVECTOR_QUANTIZATION_ENABLED=false

# Quantization type: scalar, product, binary
# - scalar: Scalar quantization (8-bit, 4-bit)
# - product: Product Quantization (PQ)
# - binary: Binary quantization (1-bit)
RUVECTOR_QUANTIZATION_TYPE=scalar

# Scalar quantization bits: 4, 8
RUVECTOR_QUANTIZATION_BITS=8

# Product Quantization parameters
RUVECTOR_PQ_SUBVECTORS=16
RUVECTOR_PQ_BITS_PER_SUBVECTOR=8

# Rescore with full precision vectors
RUVECTOR_QUANTIZATION_RESCORE=true
RUVECTOR_QUANTIZATION_RESCORE_TOP_K=100

# ----------------------------------------------------------------------------
# PERFORMANCE TUNING
# ----------------------------------------------------------------------------

# Batch size for bulk operations
RUVECTOR_BATCH_SIZE=1000
RUVECTOR_INDEX_BATCH_SIZE=5000
RUVECTOR_SEARCH_BATCH_SIZE=100

# Connection pooling
RUVECTOR_MAX_CONNECTIONS=100
RUVECTOR_MIN_CONNECTIONS=10
RUVECTOR_CONNECTION_TIMEOUT_MS=30000
RUVECTOR_CONNECTION_IDLE_TIMEOUT_MS=60000

# Thread pool configuration
RUVECTOR_WORKER_THREADS=0  # 0 = auto-detect CPU cores
RUVECTOR_INDEXING_THREADS=4
RUVECTOR_SEARCH_THREADS=8

# Memory management
RUVECTOR_CACHE_SIZE_MB=2048
RUVECTOR_MMAP_ENABLED=true
RUVECTOR_MMAP_PREFAULT=false
RUVECTOR_HUGE_PAGES_ENABLED=false

# Search optimization
RUVECTOR_SEARCH_TIMEOUT_MS=5000
RUVECTOR_PARALLEL_SEARCH=true
RUVECTOR_SEARCH_CACHE_ENABLED=true
RUVECTOR_SEARCH_CACHE_SIZE=10000
RUVECTOR_SEARCH_CACHE_TTL_SEC=300

# Index optimization
RUVECTOR_AUTO_OPTIMIZE=true
RUVECTOR_OPTIMIZE_INTERVAL_SEC=3600
RUVECTOR_OPTIMIZE_THRESHOLD=0.1  # 10% fragmentation

# ----------------------------------------------------------------------------
# PERSISTENCE & BACKUP
# ----------------------------------------------------------------------------

# Data directory (persistent storage)
RUVECTOR_DATA_DIR=/data/ruvector
RUVECTOR_INDEX_DIR=/data/ruvector/indices
RUVECTOR_WAL_DIR=/data/ruvector/wal
RUVECTOR_SNAPSHOT_DIR=/data/ruvector/snapshots

# Write-Ahead Log (WAL) for durability
RUVECTOR_WAL_ENABLED=true
RUVECTOR_WAL_SYNC_MODE=fsync  # fsync, fdatasync, none
RUVECTOR_WAL_SEGMENT_SIZE_MB=64
RUVECTOR_WAL_MAX_SEGMENTS=100

# Snapshots for faster recovery
RUVECTOR_SNAPSHOT_ENABLED=true
RUVECTOR_SNAPSHOT_INTERVAL_SEC=3600
RUVECTOR_SNAPSHOT_RETENTION=5
RUVECTOR_SNAPSHOT_COMPRESSION=zstd  # none, gzip, zstd, lz4

# Backup configuration
RUVECTOR_BACKUP_ENABLED=true
RUVECTOR_BACKUP_INTERVAL_SEC=86400  # Daily
RUVECTOR_BACKUP_RETENTION_DAYS=30
RUVECTOR_BACKUP_DESTINATION=/backups/ruvector
RUVECTOR_BACKUP_COMPRESSION=zstd
RUVECTOR_BACKUP_REMOTE_ENABLED=false
RUVECTOR_BACKUP_REMOTE_S3_BUCKET=
RUVECTOR_BACKUP_REMOTE_S3_PREFIX=ruvector-backups/

# Crash recovery
RUVECTOR_AUTO_RECOVERY=true
RUVECTOR_RECOVERY_PARALLELISM=4

# ----------------------------------------------------------------------------
# SYNCHRONIZATION
# ----------------------------------------------------------------------------

# Enable cross-node synchronization
RUVECTOR_SYNC_ENABLED=true

# Sync protocol: raft, quic, tcp, websocket
# QUIC: Low latency, efficient (recommended)
# TCP: Traditional, reliable
RUVECTOR_SYNC_PROTOCOL=quic

# Sync intervals
RUVECTOR_SYNC_INTERVAL_MS=1000
RUVECTOR_SYNC_BATCH_SIZE=1000
RUVECTOR_SYNC_COMPRESSION=true
RUVECTOR_SYNC_COMPRESSION_ALGORITHM=zstd

# Delta synchronization (only sync changes)
RUVECTOR_SYNC_DELTA_ENABLED=true
RUVECTOR_SYNC_DELTA_WINDOW_SEC=300

# Conflict resolution
RUVECTOR_SYNC_CONFLICT_RESOLUTION=last_write_wins  # last_write_wins, vector_clock, custom

# ----------------------------------------------------------------------------
# NETWORKING & SECURITY
# ----------------------------------------------------------------------------

# TLS/SSL configuration
RUVECTOR_TLS_ENABLED=false
RUVECTOR_TLS_CERT_FILE=/certs/ruvector.crt
RUVECTOR_TLS_KEY_FILE=/certs/ruvector.key
RUVECTOR_TLS_CA_FILE=/certs/ca.crt
RUVECTOR_TLS_VERIFY_CLIENT=false

# Authentication
RUVECTOR_AUTH_ENABLED=false
RUVECTOR_AUTH_TYPE=token  # token, jwt, mtls
RUVECTOR_AUTH_TOKEN=${RUVECTOR_AUTH_TOKEN:-}
RUVECTOR_JWT_SECRET=${RUVECTOR_JWT_SECRET:-}
RUVECTOR_JWT_ISSUER=ruvector
RUVECTOR_JWT_AUDIENCE=nyra

# API rate limiting
RUVECTOR_RATE_LIMIT_ENABLED=true
RUVECTOR_RATE_LIMIT_REQUESTS_PER_SEC=1000
RUVECTOR_RATE_LIMIT_BURST=2000

# CORS configuration
RUVECTOR_CORS_ENABLED=true
RUVECTOR_CORS_ALLOWED_ORIGINS=*
RUVECTOR_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE
RUVECTOR_CORS_ALLOWED_HEADERS=Content-Type,Authorization

# ----------------------------------------------------------------------------
# MONITORING & OBSERVABILITY
# ----------------------------------------------------------------------------

# Metrics export
RUVECTOR_METRICS_ENABLED=true
RUVECTOR_METRICS_PORT=9090
RUVECTOR_METRICS_FORMAT=prometheus  # prometheus, json, influx
RUVECTOR_METRICS_INTERVAL_SEC=15

# Logging configuration
RUVECTOR_LOG_LEVEL=info  # trace, debug, info, warn, error
RUVECTOR_LOG_FORMAT=json  # json, text, pretty
RUVECTOR_LOG_FILE=/var/log/ruvector/ruvector.log
RUVECTOR_LOG_MAX_SIZE_MB=100
RUVECTOR_LOG_MAX_BACKUPS=10
RUVECTOR_LOG_MAX_AGE_DAYS=30
RUVECTOR_LOG_COMPRESS=true

# Tracing (OpenTelemetry)
RUVECTOR_TRACING_ENABLED=false
RUVECTOR_TRACING_ENDPOINT=http://jaeger:14268/api/traces
RUVECTOR_TRACING_SERVICE_NAME=ruvector
RUVECTOR_TRACING_SAMPLE_RATE=0.1

# Health checks
RUVECTOR_HEALTH_CHECK_ENABLED=true
RUVECTOR_HEALTH_CHECK_PATH=/health
RUVECTOR_LIVENESS_CHECK_PATH=/live
RUVECTOR_READINESS_CHECK_PATH=/ready

# Performance profiling
RUVECTOR_PROFILING_ENABLED=false
RUVECTOR_PROFILING_PORT=6060
RUVECTOR_PROFILING_CPU=false
RUVECTOR_PROFILING_MEMORY=false

# ----------------------------------------------------------------------------
# INTEGRATION
# ----------------------------------------------------------------------------

# Redis integration (for caching and coordination)
RUVECTOR_REDIS_ENABLED=true
RUVECTOR_REDIS_URL=redis://localhost:6379
RUVECTOR_REDIS_PASSWORD=
RUVECTOR_REDIS_DB=0
RUVECTOR_REDIS_POOL_SIZE=10

# PostgreSQL integration (for metadata)
RUVECTOR_POSTGRES_ENABLED=false
RUVECTOR_POSTGRES_URL=postgresql://ruvector:ruvector@localhost:5432/ruvector
RUVECTOR_POSTGRES_POOL_SIZE=20

# Embedding service integration
RUVECTOR_EMBEDDING_SERVICE_ENABLED=false
RUVECTOR_EMBEDDING_SERVICE_URL=http://localhost:8001
RUVECTOR_EMBEDDING_SERVICE_API_KEY=
RUVECTOR_EMBEDDING_MODEL=text-embedding-3-small
RUVECTOR_EMBEDDING_DIMENSIONS=1536

# ----------------------------------------------------------------------------
# ADVANCED FEATURES
# ----------------------------------------------------------------------------

# Multi-tenancy
RUVECTOR_MULTI_TENANT_ENABLED=false
RUVECTOR_TENANT_ISOLATION=namespace  # namespace, index, cluster

# Filtering support
RUVECTOR_FILTERING_ENABLED=true
RUVECTOR_FILTERING_INDEX_ENABLED=true

# Hybrid search (vector + keyword)
RUVECTOR_HYBRID_SEARCH_ENABLED=false
RUVECTOR_HYBRID_SEARCH_WEIGHTS=0.7,0.3  # vector,keyword

# Semantic caching
RUVECTOR_SEMANTIC_CACHE_ENABLED=true
RUVECTOR_SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.95
RUVECTOR_SEMANTIC_CACHE_TTL_SEC=3600

# Approximate nearest neighbor acceleration
RUVECTOR_ANN_ACCELERATION=auto  # auto, avx2, avx512, neon, none

# WASM support for client-side search
RUVECTOR_WASM_ENABLED=false
RUVECTOR_WASM_BUILD_TARGET=wasm32-unknown-unknown

# ----------------------------------------------------------------------------
# EXPERIMENTAL FEATURES
# ----------------------------------------------------------------------------

# GPU acceleration (if available)
RUVECTOR_GPU_ENABLED=false
RUVECTOR_GPU_DEVICE=0
RUVECTOR_GPU_MEMORY_FRACTION=0.5

# Neural reranking
RUVECTOR_RERANKING_ENABLED=false
RUVECTOR_RERANKING_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RUVECTOR_RERANKING_TOP_K=100

# Incremental indexing
RUVECTOR_INCREMENTAL_INDEXING=true
RUVECTOR_INCREMENTAL_INDEX_BUFFER_SIZE=10000

# Dynamic shard allocation
RUVECTOR_DYNAMIC_SHARDING=false
RUVECTOR_SHARD_COUNT=1
RUVECTOR_SHARD_REPLICATION_FACTOR=2

# ----------------------------------------------------------------------------
# RESOURCE LIMITS
# ----------------------------------------------------------------------------

# Memory limits
RUVECTOR_MAX_MEMORY_GB=16
RUVECTOR_MAX_INDEX_SIZE_GB=100
RUVECTOR_MAX_VECTORS_PER_INDEX=10000000

# Request limits
RUVECTOR_MAX_BATCH_SIZE=10000
RUVECTOR_MAX_CONCURRENT_REQUESTS=1000
RUVECTOR_MAX_REQUEST_SIZE_MB=100

# Query limits
RUVECTOR_MAX_QUERY_VECTORS=100
RUVECTOR_MAX_RESULTS_PER_QUERY=1000
RUVECTOR_QUERY_TIMEOUT_SEC=30

# ----------------------------------------------------------------------------
# DEVELOPMENT & DEBUGGING
# ----------------------------------------------------------------------------

# Enable development mode (less strict, more verbose)
RUVECTOR_DEV_MODE=false

# Enable debug endpoints
RUVECTOR_DEBUG_ENDPOINTS_ENABLED=false

# Enable experimental features
RUVECTOR_EXPERIMENTAL_FEATURES=false

# Panic on errors (for debugging)
RUVECTOR_PANIC_ON_ERROR=false

# ----------------------------------------------------------------------------
# DOCKER SPECIFIC
# ----------------------------------------------------------------------------

# Container resource limits (for docker-compose)
RUVECTOR_DOCKER_CPU_LIMIT=2.0
RUVECTOR_DOCKER_CPU_RESERVATION=1.0
RUVECTOR_DOCKER_MEMORY_LIMIT=4G
RUVECTOR_DOCKER_MEMORY_RESERVATION=2G

# Volume mounts
RUVECTOR_DOCKER_DATA_VOLUME=ruvector_data
RUVECTOR_DOCKER_LOGS_VOLUME=ruvector_logs

# Network configuration
RUVECTOR_DOCKER_NETWORK=nyra-network
RUVECTOR_DOCKER_NETWORK_MODE=bridge

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
