# ==============================================================================
# PC3: WORKER-RTX5090 (RTX 5090 32GB, Primary Production LLM + vLLM)
# ==============================================================================
# Role: Primary production LLM worker (Ollama + vLLM), large model inference
# IP: 10.0.0.3 (Tailscale: worker-5090.tail-net.ts.net)
#
# Hardware: RTX 5090 32GB VRAM, High-end CPU, 64GB+ DDR5
# OS: Windows 11 Pro / Linux (WSL2)
# Services: Ollama, vLLM (for production), TensorRT-LLM
# Specialization: Large models (70B+), complex reasoning, production workloads
# Priority: HIGHEST (P1 routing)
# ==============================================================================

# Project Settings
PROJECT_NAME=project-nyra
NODE_ENV=production
CLAUDE_FLOW_MODE=worker  # This is a worker, not orchestrator
LOG_LEVEL=info

# ==============================================================================
# GPU CONFIGURATION
# ==============================================================================
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics

# ==============================================================================
# OLLAMA LOCAL LLM SERVER
# ==============================================================================
# Ollama runs on default port 11434
# Models loaded for this worker (32GB VRAM allows LARGE models):
# - deepseek-r1:236b-q4_K_M (DeepSeek R1 reasoning, 236B quantized)
# - qwen2.5:72b-instruct-q8_0 (Qwen 2.5 72B, high quality)
# - llama-3.1:70b-instruct-q8_0 (Llama 3.1 70B, reliable)

WORKER_5090_URL=http://0.0.0.0:11434
WORKER_5090_MODELS=deepseek-r1:236b-q4_K_M,qwen2.5:72b-instruct-q8_0
WORKER_5090_PRIMARY_USE=reasoning
WORKER_5090_MAX_CONCURRENT=3

# ==============================================================================
# VLLM SERVER (Production Inference)
# ==============================================================================
# vLLM provides 10-100x faster inference with continuous batching
# Runs on separate port for production workloads
VLLM_ENABLED=true
VLLM_PORT=8001
VLLM_HOST=0.0.0.0
VLLM_MODEL=deepseek-ai/DeepSeek-R1
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_ENFORCE_EAGER=false
VLLM_TRUST_REMOTE_CODE=true

# ==============================================================================
# ORCHESTRATOR CONNECTION
# ==============================================================================
# Connect to orchestrator for coordination
NEXUS_ROUTER_URL=http://orchestrator.tail-net.ts.net:7000
ORCHESTRATOR_URL=http://orchestrator.tail-net.ts.net:8010

# ==============================================================================
# RUVECTOR DISTRIBUTED PEER
# ==============================================================================
# This worker participates in distributed vector consensus
RUVECTOR_ENABLED=true
RUVECTOR_MODE=peer
RUVECTOR_PORT=7890
RUVECTOR_PEER_ID=worker-5090
RUVECTOR_LEADER=orchestrator.tail-net.ts.net:7000

# ==============================================================================
# NETWORKING
# ==============================================================================

# Tailscale
TAILSCALE_ENABLED=true
TAILSCALE_AUTH_KEY=                 # REQUIRED (same for all PCs)
TAILSCALE_HOSTNAME=worker-5090

# Cloudflare Tunnel (for dev UI access)
CLOUDFLARE_TUNNEL_ENABLED=true
CLOUDFLARE_TUNNEL_TOKEN_WORKER_RTX5090=  # REQUIRED
CLOUDFLARE_TUNNEL_LOGLEVEL=info
CLOUDFLARE_TUNNEL_METRICS=0.0.0.0:9126

# Docker Network
DOCKER_SUBNET_RTX5090=172.21.0.0/16

# ==============================================================================
# DEVELOPMENT UI PORTS
# ==============================================================================
WORKER_RTX5090_DEV_UI_PORT=8090
WORKER_RTX5090_GPU_MONITOR_PORT=9835
WORKER_RTX5090_JUPYTER_PORT=8888
WORKER_RTX5090_TENSORBOARD_PORT=6006
WORKER_RTX5090_VSCODE_PORT=8443

# ==============================================================================
# MONITORING
# ==============================================================================
# Local Prometheus node exporter + NVIDIA DCGM exporter
PROMETHEUS_NODE_EXPORTER_PORT=9100
NVIDIA_DCGM_EXPORTER_PORT=9400

# Send metrics to orchestrator
PROMETHEUS_REMOTE_WRITE_URL=http://orchestrator.tail-net.ts.net:9090/api/v1/write

# ==============================================================================
# RESOURCE LIMITS (32GB VRAM)
# ==============================================================================
# Ollama will auto-manage VRAM
# Can handle 3 concurrent requests with large models
MAX_CONCURRENT_REQUESTS=3
MAX_CONTEXT_LENGTH=32768
GPU_MEMORY_UTILIZATION=0.90  # Use 90% of VRAM

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================
# Worker-specific features
ENABLE_GPU_MONITORING=true
ENABLE_MODEL_PRELOADING=true
ENABLE_SMART_QUANTIZATION=true
ENABLE_VLLM_INFERENCE=true
ENABLE_TENSORRT_LLM=true

# ==============================================================================
# LOGGING
# ==============================================================================
LOG_LEVEL=info
LOG_FILE_PATH=/var/log/worker-5090.log

# ==============================================================================
# Notes
# ==============================================================================
# - Primary role: Large model inference (70B-236B parameters)
# - HIGHEST PRIORITY (P1) in routing - gets complex reasoning tasks first
# - 32GB VRAM allows q4_K_M quantization for 236B models
# - vLLM for production workloads (10-100x faster than Ollama)
# - Ollama for development/testing
# - Connects to orchestrator via Tailscale mesh VPN
# - Dev UI accessible via Cloudflare Tunnel
# - GPU monitoring via DCGM + Prometheus
# - TensorRT-LLM for ultra-fast inference (optional)
