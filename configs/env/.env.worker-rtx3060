# ==============================================================================
# PC2: WORKER-RTX3060 (RTX 3060 12GB, Development LLM)
# ==============================================================================
# Role: Development LLM worker (Ollama), coding-specialized models
# IP: 10.0.0.2 (Tailscale: worker-3060.tail-net.ts.net)
#
# Hardware: RTX 3060 12GB VRAM, Ryzen CPU, 32GB DDR4
# OS: Windows 11 Pro
# Services: Ollama (codellama, qwen2.5:32b, gemma2)
# Specialization: Code generation, small-medium models
# ==============================================================================

# Project Settings
PROJECT_NAME=project-nyra
NODE_ENV=production
CLAUDE_FLOW_MODE=worker  # This is a worker, not orchestrator
LOG_LEVEL=info

# ==============================================================================
# GPU CONFIGURATION
# ==============================================================================
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics

# ==============================================================================
# OLLAMA LOCAL LLM SERVER
# ==============================================================================
# Ollama runs on default port 11434
# Models loaded for this worker:
# - codellama:34b-instruct-q8_0 (Code generation)
# - qwen2.5:32b-instruct-q8_0 (General purpose, fits in 12GB)
# - gemma2:27b-instruct-q8_0 (Efficient reasoning)

WORKER_3060_URL=http://0.0.0.0:11434
WORKER_3060_MODELS=codellama:34b-instruct-q8_0,qwen2.5:32b-instruct-q8_0,gemma2:27b-instruct-q8_0
WORKER_3060_PRIMARY_USE=coding
WORKER_3060_MAX_CONCURRENT=2

# ==============================================================================
# ORCHESTRATOR CONNECTION
# ==============================================================================
# Connect to orchestrator for coordination
NEXUS_ROUTER_URL=http://orchestrator.tail-net.ts.net:7000
ORCHESTRATOR_URL=http://orchestrator.tail-net.ts.net:8010

# ==============================================================================
# RUVECTOR DISTRIBUTED PEER
# ==============================================================================
# This worker participates in distributed vector consensus
RUVECTOR_ENABLED=true
RUVECTOR_MODE=peer
RUVECTOR_PORT=7890
RUVECTOR_PEER_ID=worker-3060
RUVECTOR_LEADER=orchestrator.tail-net.ts.net:7000

# ==============================================================================
# NETWORKING
# ==============================================================================

# Tailscale
TAILSCALE_ENABLED=true
TAILSCALE_AUTH_KEY=                 # REQUIRED (same for all PCs)
TAILSCALE_HOSTNAME=worker-3060

# Cloudflare Tunnel (for dev UI access)
CLOUDFLARE_TUNNEL_ENABLED=true
CLOUDFLARE_TUNNEL_TOKEN_WORKER_RTX3060=  # REQUIRED
CLOUDFLARE_TUNNEL_LOGLEVEL=info
CLOUDFLARE_TUNNEL_METRICS=0.0.0.0:9126

# Docker Network
DOCKER_SUBNET_RTX3060=172.22.0.0/16

# ==============================================================================
# DEVELOPMENT UI PORTS
# ==============================================================================
WORKER_RTX3060_DEV_UI_PORT=8091
WORKER_RTX3060_GPU_MONITOR_PORT=9836
WORKER_RTX3060_VSCODE_PORT=8444
WORKER_RTX3060_MLFLOW_PORT=5000
WORKER_RTX3060_JUPYTER_PORT=8889

# ==============================================================================
# MONITORING
# ==============================================================================
# Local Prometheus node exporter + NVIDIA DCGM exporter
PROMETHEUS_NODE_EXPORTER_PORT=9100
NVIDIA_DCGM_EXPORTER_PORT=9400

# Send metrics to orchestrator
PROMETHEUS_REMOTE_WRITE_URL=http://orchestrator.tail-net.ts.net:9090/api/v1/write

# ==============================================================================
# RESOURCE LIMITS (12GB VRAM)
# ==============================================================================
# Ollama will auto-manage VRAM
# Max 2 concurrent requests to prevent OOM
MAX_CONCURRENT_REQUESTS=2
MAX_CONTEXT_LENGTH=32768

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================
# Worker-specific features
ENABLE_GPU_MONITORING=true
ENABLE_MODEL_PRELOADING=true
ENABLE_SMART_QUANTIZATION=true

# ==============================================================================
# LOGGING
# ==============================================================================
LOG_LEVEL=info
LOG_FILE_PATH=/var/log/worker-3060.log

# ==============================================================================
# Notes
# ==============================================================================
# - Primary role: Code generation and small-medium models
# - 12GB VRAM limits model size (q8_0 quantization for 32-34B models)
# - Ollama handles model loading/unloading automatically
# - Connects to orchestrator via Tailscale mesh VPN
# - Dev UI accessible via Cloudflare Tunnel
# - GPU monitoring via DCGM + Prometheus
