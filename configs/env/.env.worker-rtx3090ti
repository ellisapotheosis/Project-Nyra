# ==============================================================================
# PC4: WORKER-RTX3090TI (RTX 3090 Ti 24GB, Secondary Production + vLLM)
# ==============================================================================
# Role: Secondary production LLM worker (Ollama + vLLM), analysis models
# IP: 10.0.0.4 (Tailscale: worker-3090.tail-net.ts.net)
#
# Hardware: RTX 3090 Ti 24GB VRAM, High-end CPU, 64GB DDR4
# OS: Windows 11 Pro / Linux (WSL2)
# Services: Ollama, vLLM (for production)
# Specialization: Medium-large models (70B), analysis, secondary production
# Priority: HIGH (P2 routing)
# ==============================================================================

# Project Settings
PROJECT_NAME=project-nyra
NODE_ENV=production
CLAUDE_FLOW_MODE=worker  # This is a worker, not orchestrator
LOG_LEVEL=info

# ==============================================================================
# GPU CONFIGURATION
# ==============================================================================
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics

# ==============================================================================
# OLLAMA LOCAL LLM SERVER
# ==============================================================================
# Ollama runs on default port 11434
# Models loaded for this worker (24GB VRAM allows medium-large models):
# - llama-3.1:70b-instruct-q4_K_M (Llama 3.1 70B, reliable analysis)
# - mistral-large:123b-instruct-2407-q4_K_M (Mistral Large, 123B quantized)
# - qwen2.5:72b-instruct-q8_0 (Qwen 2.5 72B backup)

WORKER_3090_URL=http://0.0.0.0:11434
WORKER_3090_MODELS=llama3.1:70b-instruct-q4_K_M,mistral-large:123b-instruct-2407-q4_K_M
WORKER_3090_PRIMARY_USE=analysis
WORKER_3090_MAX_CONCURRENT=2

# ==============================================================================
# VLLM SERVER (Production Inference)
# ==============================================================================
# vLLM provides 10-100x faster inference with continuous batching
# Runs on separate port for production workloads
VLLM_ENABLED=true
VLLM_PORT=8001
VLLM_HOST=0.0.0.0
VLLM_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_ENFORCE_EAGER=false

# ==============================================================================
# ORCHESTRATOR CONNECTION
# ==============================================================================
# Connect to orchestrator for coordination
NEXUS_ROUTER_URL=http://orchestrator.tail-net.ts.net:7000
ORCHESTRATOR_URL=http://orchestrator.tail-net.ts.net:8010

# ==============================================================================
# RUVECTOR DISTRIBUTED PEER
# ==============================================================================
# This worker participates in distributed vector consensus
RUVECTOR_ENABLED=true
RUVECTOR_MODE=peer
RUVECTOR_PORT=7890
RUVECTOR_PEER_ID=worker-3090
RUVECTOR_LEADER=orchestrator.tail-net.ts.net:7000

# ==============================================================================
# NETWORKING
# ==============================================================================

# Tailscale
TAILSCALE_ENABLED=true
TAILSCALE_AUTH_KEY=                 # REQUIRED (same for all PCs)
TAILSCALE_HOSTNAME=worker-3090

# Cloudflare Tunnel (for dev UI access)
CLOUDFLARE_TUNNEL_ENABLED=true
CLOUDFLARE_TUNNEL_TOKEN_WORKER_RTX3090TI=  # REQUIRED
CLOUDFLARE_TUNNEL_LOGLEVEL=info
CLOUDFLARE_TUNNEL_METRICS=0.0.0.0:9126

# Docker Network
DOCKER_SUBNET_RTX3090TI=172.23.0.0/16

# ==============================================================================
# DEVELOPMENT UI PORTS
# ==============================================================================
WORKER_RTX3090TI_DEV_UI_PORT=8092
WORKER_RTX3090TI_GPU_MONITOR_PORT=9837
WORKER_RTX3090TI_JUPYTER_PORT=8890
WORKER_RTX3090TI_WANDB_PORT=8080
WORKER_RTX3090TI_TENSORBOARD_PORT=6007

# ==============================================================================
# MONITORING
# ==============================================================================
# Local Prometheus node exporter + NVIDIA DCGM exporter
PROMETHEUS_NODE_EXPORTER_PORT=9100
NVIDIA_DCGM_EXPORTER_PORT=9400

# Send metrics to orchestrator
PROMETHEUS_REMOTE_WRITE_URL=http://orchestrator.tail-net.ts.net:9090/api/v1/write

# ==============================================================================
# RESOURCE LIMITS (24GB VRAM)
# ==============================================================================
# Ollama will auto-manage VRAM
# Can handle 2 concurrent requests with large models
MAX_CONCURRENT_REQUESTS=2
MAX_CONTEXT_LENGTH=32768
GPU_MEMORY_UTILIZATION=0.90  # Use 90% of VRAM

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================
# Worker-specific features
ENABLE_GPU_MONITORING=true
ENABLE_MODEL_PRELOADING=true
ENABLE_SMART_QUANTIZATION=true
ENABLE_VLLM_INFERENCE=true

# ==============================================================================
# LOGGING
# ==============================================================================
LOG_LEVEL=info
LOG_FILE_PATH=/var/log/worker-3090.log

# ==============================================================================
# Notes
# ==============================================================================
# - Primary role: Analysis and medium-large models (70B-123B parameters)
# - SECONDARY PRIORITY (P2) in routing - handles analysis tasks
# - 24GB VRAM allows q4_K_M quantization for 70B-123B models
# - vLLM for production workloads (10-100x faster than Ollama)
# - Ollama for development/testing
# - Connects to orchestrator via Tailscale mesh VPN
# - Dev UI accessible via Cloudflare Tunnel
# - GPU monitoring via DCGM + Prometheus
# - Weights & Biases integration for experiment tracking
