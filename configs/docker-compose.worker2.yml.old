# Docker Compose - Worker 2 (Alienware Area-51 - RTX 5090)
# Specialization: Complex reasoning and large context tasks

version: '3.8'

services:
  # vLLM Model Server
  vllm:
    image: vllm/vllm-openai:latest
    container_name: nyra-worker2-vllm
    restart: unless-stopped
    ports:
      - "8000:8000"
    environment:
      - NVIDIA_VISIBLE_DEVICES=0
      - CUDA_VISIBLE_DEVICES=0
      - VLLM_WORKER_MULTIPROC_METHOD=spawn
      - VLLM_LOGGING_LEVEL=INFO
    volumes:
      - "vllm-models:/app/models"
      - "./config/worker2-rtx5090-config.yaml:/app/config.yaml"
      - "/dev/shm:/dev/shm"
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]
    shm_size: "8gb"
    command: [
      "--model", "/app/models/llama-3.1-70b-instruct",
      "--host", "0.0.0.0",
      "--port", "8000",
      "--gpu-memory-utilization", "0.9",
      "--max-model-len", "32768",
      "--max-num-seqs", "128",
      "--max-num-batched-tokens", "8192",
      "--enable-chunked-prefill",
      "--quantization", "bitsandbytes",
      "--load-format", "bitsandbytes"
    ]
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s
      timeout: 15s
      retries: 3
      start_period: 120s

  # LiteLLM Proxy for Worker 2
  litellm-proxy:
    image: ghcr.io/berriai/litellm:main-latest
    container_name: nyra-worker2-litellm
    restart: unless-stopped
    ports:
      - "4002:4000"
      - "8002:8002"
    environment:
      - LITELLM_MASTER_KEY=${LITELLM_MASTER_KEY}
      - DATABASE_URL=sqlite:///app/data/litellm_worker2.db
      - LITELLM_LOG=INFO
      - VLLM_API_BASE=http://vllm:8000
    volumes:
      - "./config/litellm-worker2.yaml:/app/config.yaml"
      - "litellm-data:/app/data"
    depends_on:
      - vllm
    command: ["--config", "/app/config.yaml", "--port", "4000", "--host", "0.0.0.0"]
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:4000/health"]
      interval: 30s
      timeout: 10s
      retries: 3

  # Advanced Model Manager for Worker 2
  model-manager:
    image: nyra/advanced-model-manager:latest
    container_name: nyra-worker2-model-manager
    restart: unless-stopped
    ports:
      - "8082:8080"
    environment:
      - WORKER_ID=worker2
      - GPU_TYPE=rtx_5090
      - VRAM_GB=32
      - VLLM_API_BASE=http://vllm:8000
      - SPECIALIZATION=reasoning
      - MODEL_ROTATION=true
      - QUANTIZATION_DYNAMIC=true
    volumes:
      - "./config/worker2-rtx5090-config.yaml:/app/config.yaml"
      - "vllm-models:/app/models"
      - "manager-data:/app/data"
      - "/tmp/hf_cache:/app/cache"
    depends_on:
      - vllm
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/health"]
      interval: 30s
      timeout: 10s
      retries: 3

  # Performance Monitor with GPU Metrics
  perf-monitor:
    image: nyra/advanced-perf-monitor:latest
    container_name: nyra-worker2-perf-monitor
    restart: unless-stopped
    ports:
      - "9002:9090"
    environment:
      - WORKER_ID=worker2
      - GPU_MONITORING=true
      - ADVANCED_METRICS=true
      - PROMETHEUS_PUSH_GATEWAY=http://orchestrator.nyra.local:9091
      - NVIDIA_SMI_MONITORING=true
    volumes:
      - "./config/worker2-rtx5090-config.yaml:/app/config.yaml"
      - "monitor-data:/app/data"
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9090/metrics"]
      interval: 30s
      timeout: 10s
      retries: 3

  # Cloudflared Tunnel
  cloudflared:
    image: cloudflare/cloudflared:latest
    container_name: nyra-worker2-cloudflared
    restart: unless-stopped
    environment:
      - TUNNEL_TOKEN=${CLOUDFLARE_WORKER2_TUNNEL_TOKEN}
    volumes:
      - "./config/cloudflared-worker2.yaml:/etc/cloudflared/config.yaml"
    command: ["tunnel", "--config", "/etc/cloudflared/config.yaml", "run", "nyra-worker2-tunnel"]
    depends_on:
      - litellm-proxy
    healthcheck:
      test: ["CMD", "cloudflared", "tunnel", "info", "nyra-worker2-tunnel"]
      interval: 60s
      timeout: 30s
      retries: 3

  # Enhanced Health Check Service
  health-check:
    image: nyra/enhanced-health-check:latest
    container_name: nyra-worker2-health
    restart: unless-stopped
    ports:
      - "8092:8080"
    environment:
      - WORKER_ID=worker2
      - CHECK_INTERVAL=30
      - ORCHESTRATOR_URL=http://orchestrator.nyra.local:8080
      - CONTEXT_LENGTH_TEST=true
      - MODEL_VALIDATION=true
    volumes:
      - "./config/worker2-rtx5090-config.yaml:/app/config.yaml"
    depends_on:
      - vllm
      - litellm-proxy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/health"]
      interval: 60s
      timeout: 15s
      retries: 3

  # Model Auto-downloader and Warmer
  model-warmer:
    image: nyra/advanced-model-warmer:latest
    container_name: nyra-worker2-model-warmer
    restart: unless-stopped
    environment:
      - WORKER_ID=worker2
      - VLLM_API_BASE=http://vllm:8000
      - WARM_SCHEDULE=0 7 * * *  # 7 AM daily
      - PRELOAD_CRITICAL=true
      - MODEL_ROTATION=true
      - QUANTIZATION_ON_DEMAND=true
    volumes:
      - "./config/worker2-rtx5090-config.yaml:/app/config.yaml"
      - "vllm-models:/app/models"
      - "warmer-data:/app/data"
      - "/tmp/hf_cache:/app/cache"
    depends_on:
      - vllm
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]

  # Redis Cache with Enhanced Features
  redis:
    image: redis:7-alpine
    container_name: nyra-worker2-redis
    restart: unless-stopped
    ports:
      - "6381:6379"
    volumes:
      - "redis-data:/data"
      - "./config/redis-worker2.conf:/usr/local/etc/redis/redis.conf"
    command: ["redis-server", "/usr/local/etc/redis/redis.conf", "--maxmemory", "2gb", "--maxmemory-policy", "allkeys-lru"]
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 3

  # Context Management Service
  context-manager:
    image: nyra/context-manager:latest
    container_name: nyra-worker2-context
    restart: unless-stopped
    ports:
      - "8093:8080"
    environment:
      - WORKER_ID=worker2
      - MAX_CONTEXT_LENGTH=32768
      - CONTEXT_OPTIMIZATION=true
      - REDIS_URL=redis://redis:6379
    volumes:
      - "./config/worker2-rtx5090-config.yaml:/app/config.yaml"
      - "context-data:/app/data"
    depends_on:
      - redis
      - vllm
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/health"]
      interval: 30s
      timeout: 10s
      retries: 3

  # Advanced Log Aggregator
  log-aggregator:
    image: fluent/fluent-bit:latest
    container_name: nyra-worker2-logs
    restart: unless-stopped
    volumes:
      - "./config/fluent-bit-worker2.conf:/fluent-bit/etc/fluent-bit.conf"
      - "/var/log:/var/log:ro"
      - "log-data:/app/logs"
    depends_on:
      - redis

volumes:
  vllm-models:
    driver: local
    driver_opts:
      type: none
      device: /app/models/worker2
      o: bind
  litellm-data:
    driver: local
  manager-data:
    driver: local
  monitor-data:
    driver: local
  warmer-data:
    driver: local
  context-data:
    driver: local
  redis-data:
    driver: local
  log-data:
    driver: local

networks:
  default:
    name: nyra-worker2
    driver: bridge
    ipam:
      config:
        - subnet: 172.22.0.0/16

  # Connect to orchestrator network
  orchestrator:
    external: true
    name: nyra-orchestrator