{
  "version": 1,
  "provider": "openai",
  "model": "anthropic/claude-sonnet-4.6",
  "modelParams": {
    "max_tokens": 8192,
    "temperature": 0.7
  },
  "ephemeralSettings": {
    "context-limit": 200000,
    "base-url": "https://openrouter.ai/api/v1",
    "auth-key-name": "openrouter",
    "streaming": "enabled"
  }
}
