{
  "version": 1,
  "type": "loadbalancer",
  "policy": "failover",
  "backends": [
    "claude-opus-4-8-xhigh",
    "codex-gpt-5-5-xhigh",
    "claude-sonnet-4-6-balanced",
    "gemini-3-1-pro-customtools",
    "cerebras-glm-4-7-agentic"
  ],
  "ephemeralSettings": {
    "failover_retry_count": 1,
    "failover_retry_delay_ms": 1000,
    "failover_status_codes": [
      429,
      500,
      502,
      503,
      504
    ],
    "failover_on_network_errors": true
  }
}
