{
  "version": 1,
  "provider": "openai",
  "model": "kimi-k2-thinking",
  "modelParams": {
    "max_tokens": 8192,
    "temperature": 1
  },
  "ephemeralSettings": {
    "context-limit": 200000,
    "base-url": "https://api.chutes.ai/v1",
    "auth-key-name": "chutes",
    "streaming": "enabled",
    "reasoning.enabled": true,
    "reasoning.includeInResponse": true,
    "reasoning.stripFromContext": "allButLast"
  }
}
