{
  "version": 1,
  "provider": "codex",
  "model": "gpt-5.3-codex",
  "ephemeralSettings": {
    "context-limit": 262000,
    "compression-threshold": 0.82,
    "max-prompt-tokens": 200000,
    "tool-output-max-items": 40,
    "tool-output-max-tokens": 36000,
    "tool-output-truncate-mode": "warn",
    "shell-default-timeout-seconds": 180,
    "shell-max-timeout-seconds": 1200,
    "task-default-timeout-seconds": 1200,
    "task-max-timeout-seconds": 3600,
    "prompt-caching": "24h",
    "reasoning.enabled": true,
    "reasoning.effort": "medium",
    "reasoning.includeInResponse": false,
    "reasoning.includeInContext": true,
    "reasoning.stripFromContext": "allButLast"
  }
}
