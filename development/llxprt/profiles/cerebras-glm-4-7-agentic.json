{
  "version": 1,
  "provider": "openai",
  "model": "zai-glm-4.7",
  "modelParams": {
    "max_tokens": 10000,
    "temperature": 1,
    "top_p": 0.95
  },
  "ephemeralSettings": {
    "context-limit": 131000,
    "base-url": "https://api.cerebras.ai/v1",
    "auth-key-name": "cerebras",
    "streaming": "enabled",
    "shell-replacement": true,
    "reasoning.enabled": true,
    "reasoning.includeInResponse": true,
    "reasoning.stripFromContext": "none"
  }
}
