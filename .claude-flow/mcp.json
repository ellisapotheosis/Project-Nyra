{
  "mcpServers": {
    "claude-flow": {
      "command": "npx",
      "args": ["-y", "claude-flow@alpha", "mcp", "start"],
      "env": {
        "CLAUDE_FLOW_MEMORY_ENABLED": "true",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_NEURAL_ENABLED": "true",
        "CLAUDE_FLOW_GITHUB_ENABLED": "true",
        "CLAUDE_FLOW_AUTO_SPAWN": "true",
        "CLAUDE_FLOW_SESSION_MEMORY": "true",
        "CLAUDE_FLOW_MAX_AGENTS": "10"
      },
      "description": "Claude Flow main orchestration MCP server"
    },
    "ruv-swarm": {
      "command": "npx",
      "args": ["-y", "ruv-swarm@latest", "mcp", "start"],
      "env": {
        "RUV_SWARM_TOPOLOGY": "adaptive",
        "RUV_SWARM_MAX_AGENTS": "20",
        "RUV_SWARM_WASM_ENABLED": "true",
        "RUV_SWARM_NEURAL_ENABLED": "true",
        "RUV_SWARM_DAA_ENABLED": "true",
        "RUV_SWARM_MEMORY_MODE": "persistent"
      },
      "description": "Ruv Swarm enhanced coordination with WASM"
    },
    "flow-nexus": {
      "command": "npx",
      "args": ["-y", "flow-nexus@latest", "mcp", "start"],
      "env": {
        "FLOW_NEXUS_API_URL": "${FLOW_NEXUS_API_URL}",
        "FLOW_NEXUS_API_KEY": "${FLOW_NEXUS_API_KEY}",
        "FLOW_NEXUS_USER_ID": "${FLOW_NEXUS_USER_ID}",
        "FLOW_NEXUS_SANDBOX_ENABLED": "true",
        "FLOW_NEXUS_NEURAL_ENABLED": "true"
      },
      "description": "Flow Nexus cloud platform integration"
    },
    "agentic-flow": {
      "command": "npx",
      "args": ["-y", "agentic-flow@latest", "mcp", "start"],
      "env": {
        "AGENTIC_FLOW_MAX_AGENTS": "15",
        "AGENTIC_FLOW_TOPOLOGY": "mesh",
        "AGENTIC_FLOW_MEMORY_ENABLED": "true"
      },
      "description": "Agentic Flow agent-based workflow coordination"
    },
    "agentdb": {
      "command": "npx",
      "args": ["-y", "agentdb@latest", "mcp", "start"],
      "env": {
        "AGENTDB_STORAGE_PATH": "./data/agentdb",
        "AGENTDB_VECTOR_ENABLED": "true",
        "AGENTDB_QUANTIZATION": "true",
        "AGENTDB_CACHE_ENABLED": "true"
      },
      "description": "AgentDB persistent vector database"
    },
    "agent-booster": {
      "command": "npx",
      "args": ["-y", "agent-booster@latest", "mcp", "start"],
      "env": {
        "AGENT_BOOSTER_OPTIMIZATION_ENABLED": "true",
        "AGENT_BOOSTER_CACHE_ENABLED": "true"
      },
      "description": "Agent Booster performance optimization"
    },
    "epic-sdk": {
      "command": "npx",
      "args": ["-y", "epic-sdk@latest", "mcp", "start"],
      "env": {
        "EPIC_SDK_API_KEY": "${EPIC_SDK_API_KEY}",
        "EPIC_SDK_FEATURES_ENABLED": "all"
      },
      "description": "Epic SDK development toolkit"
    },
    "gemini-mcp": {
      "command": "npx",
      "args": ["-y", "@google/generative-ai-mcp@latest", "start"],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}",
        "GEMINI_MODEL": "gemini-2.0-flash-thinking-exp-1219",
        "GEMINI_SAFETY_SETTINGS": "BLOCK_NONE",
        "GEMINI_MAX_TOKENS": "8192",
        "GEMINI_THINKING_MODE": "true",
        "GEMINI_REQUIRE_PERMISSION": "false",
        "GEMINI_AUTO_APPROVE_TOOLS": "true",
        "GEMINI_ALLOW_ALL_OPERATIONS": "true",
        "GEMINI_BYPASS_CONFIRMATIONS": "true",
        "GEMINI_TOOL_USE_UNRESTRICTED": "true"
      },
      "description": "Google Gemini MCP server with all permissions enabled"
    }
  }
}
