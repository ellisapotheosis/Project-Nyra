{
  "name": "Lead Nurturing Workflow",
  "nodes": [
    {
      "parameters": {},
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300],
      "id": "schedule-trigger",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      }
    },
    {
      "parameters": {
        "url": "={{$env.API_BASE_URL}}/api/leads/active",
        "method": "GET",
        "options": {}
      },
      "name": "Fetch Active Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [450, 300],
      "id": "fetch-leads"
    },
    {
      "parameters": {
        "functionCode": "const leads = items[0].json.leads;\nconst now = new Date();\n\nconst categorizedLeads = leads.map(lead => {\n  const lastContact = new Date(lead.lastContactDate);\n  const daysSinceContact = Math.floor((now - lastContact) / (1000 * 60 * 60 * 24));\n  \n  let score = lead.engagementScore || 50;\n  let category = 'warm';\n  \n  if (score >= 80) category = 'hot';\n  else if (score >= 60) category = 'warm';\n  else if (score >= 40) category = 'cool';\n  else category = 'cold';\n  \n  return {\n    json: {\n      ...lead,\n      daysSinceContact,\n      category,\n      score\n    }\n  };\n});\n\nreturn categorizedLeads;"
      },
      "name": "Score & Categorize Leads",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [650, 300],
      "id": "score-leads"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.category}}",
              "operation": "equal",
              "value2": "hot"
            }
          ]
        }
      },
      "name": "Hot Leads",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [850, 150],
      "id": "hot-leads"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.category}}",
              "operation": "equal",
              "value2": "warm"
            }
          ]
        }
      },
      "name": "Warm Leads",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [850, 300],
      "id": "warm-leads"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.category}}",
              "operation": "equal",
              "value2": "cool"
            }
          ]
        }
      },
      "name": "Cool Leads",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [850, 450],
      "id": "cool-leads"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.category}}",
              "operation": "equal",
              "value2": "cold"
            }
          ]
        }
      },
      "name": "Cold Leads",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [850, 600],
      "id": "cold-leads"
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "sendGridApi",
        "fromEmail": "mortgages@company.com",
        "toEmail": "={{$json.email}}",
        "subject": "Your Pre-Approval is Ready! Let's Close This Week",
        "emailType": "html",
        "message": "<h1>Great News, {{$json.firstName}}! 🎉</h1><p>You're pre-approved for up to ${{$json.preApprovalAmount}}!</p><p>Current rates are excellent. Let's schedule a call this week:</p><ul><li>30-Year Fixed: {{$json.rate30yr}}%</li><li>15-Year Fixed: {{$json.rate15yr}}%</li></ul><p><strong>Your loan officer:</strong> {{$json.loanOfficer}}</p><p><a href='{{$json.calendarUrl}}'>Schedule Call Now</a> | <a href='tel:{{$json.loanOfficerPhone}}'>Call Direct</a></p>"
      },
      "name": "Send Hot Lead Email",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "position": [1050, 150],
      "id": "send-hot-email"
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "sendGridApi",
        "fromEmail": "mortgages@company.com",
        "toEmail": "={{$json.email}}",
        "subject": "Next Steps in Your Mortgage Journey",
        "emailType": "html",
        "message": "<h1>Hi {{$json.firstName}},</h1><p>We noticed you've been exploring your mortgage options. Here's where you are:</p><ul><li>✅ Initial application started</li><li>⏳ Documents pending</li><li>📋 Pre-approval ready when you are</li></ul><p>Questions? Our team is here to help!</p><p><a href='{{$json.portalUrl}}'>Continue Application</a></p>"
      },
      "name": "Send Warm Lead Email",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "position": [1050, 300],
      "id": "send-warm-email"
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "sendGridApi",
        "fromEmail": "mortgages@company.com",
        "toEmail": "={{$json.email}}",
        "subject": "Still Thinking About Your Mortgage?",
        "emailType": "html",
        "message": "<h1>{{$json.firstName}}, We're Still Here! 👋</h1><p>We understand getting a mortgage is a big decision. Here are resources to help:</p><ul><li><a href='{{$json.blogUrl}}/mortgage-calculator'>Mortgage Calculator</a></li><li><a href='{{$json.blogUrl}}/first-time-buyers'>First-Time Buyer Guide</a></li><li><a href='{{$json.blogUrl}}/rates-explained'>Understanding Rates</a></li></ul><p>No pressure - just helpful information when you're ready.</p>"
      },
      "name": "Send Cool Lead Email",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "position": [1050, 450],
      "id": "send-cool-email"
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "sendGridApi",
        "fromEmail": "mortgages@company.com",
        "toEmail": "={{$json.email}}",
        "subject": "We Miss You! Special Rate Offer Inside",
        "emailType": "html",
        "message": "<h1>{{$json.firstName}}, We Have Great News!</h1><p>We'd love to help you achieve homeownership. For a limited time:</p><h2>Special Offer: 0.25% Rate Reduction</h2><p>Plus no application fees when you start this month!</p><p><a href='{{$json.portalUrl}}/special-offer'>Claim Your Offer</a></p><p><small>Offer expires in 14 days. Standard terms apply.</small></p>"
      },
      "name": "Send Re-Engagement Email",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "position": [1050, 600],
      "id": "send-cold-email"
    },
    {
      "parameters": {
        "url": "={{$env.API_BASE_URL}}/api/leads/{{$json.leadId}}/activity",
        "method": "POST",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={{ JSON.stringify({ type: 'nurture_email', category: $json.category, timestamp: new Date().toISOString() }) }}"
      },
      "name": "Log Activity",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [1250, 375],
      "id": "log-activity"
    },
    {
      "parameters": {
        "functionCode": "const results = items.map(item => ({\n  json: {\n    leadId: item.json.leadId,\n    email: item.json.email,\n    category: item.json.category,\n    emailSent: true,\n    timestamp: new Date().toISOString()\n  }\n}));\n\nreturn results;"
      },
      "name": "Aggregate Results",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1450, 375],
      "id": "aggregate-results"
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [[{ "node": "Fetch Active Leads", "type": "main", "index": 0 }]]
    },
    "Fetch Active Leads": {
      "main": [
        [{ "node": "Score & Categorize Leads", "type": "main", "index": 0 }]
      ]
    },
    "Score & Categorize Leads": {
      "main": [
        [
          { "node": "Hot Leads", "type": "main", "index": 0 },
          { "node": "Warm Leads", "type": "main", "index": 0 },
          { "node": "Cool Leads", "type": "main", "index": 0 },
          { "node": "Cold Leads", "type": "main", "index": 0 }
        ]
      ]
    },
    "Hot Leads": {
      "main": [[{ "node": "Send Hot Lead Email", "type": "main", "index": 0 }]]
    },
    "Warm Leads": {
      "main": [[{ "node": "Send Warm Lead Email", "type": "main", "index": 0 }]]
    },
    "Cool Leads": {
      "main": [[{ "node": "Send Cool Lead Email", "type": "main", "index": 0 }]]
    },
    "Cold Leads": {
      "main": [
        [{ "node": "Send Re-Engagement Email", "type": "main", "index": 0 }]
      ]
    },
    "Send Hot Lead Email": {
      "main": [[{ "node": "Log Activity", "type": "main", "index": 0 }]]
    },
    "Send Warm Lead Email": {
      "main": [[{ "node": "Log Activity", "type": "main", "index": 0 }]]
    },
    "Send Cool Lead Email": {
      "main": [[{ "node": "Log Activity", "type": "main", "index": 0 }]]
    },
    "Send Re-Engagement Email": {
      "main": [[{ "node": "Log Activity", "type": "main", "index": 0 }]]
    },
    "Log Activity": {
      "main": [[{ "node": "Aggregate Results", "type": "main", "index": 0 }]]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["mortgage", "lead-nurturing", "engagement"]
}
