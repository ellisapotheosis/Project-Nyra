{
  "name": "Lead Capture Webhook",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-capture",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-lead-capture",
      "name": "Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "lead-capture-nyra"
    },
    {
      "parameters": {
        "operation": "create",
        "table": "leads",
        "columns": "firstName,lastName,email,phone,loanAmount,propertyValue,creditScore,employmentStatus,leadSource",
        "options": {}
      },
      "id": "postgres-save-lead",
      "name": "Save to Database",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [450, 300],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "PostgreSQL - Letta"
        }
      }
    },
    {
      "parameters": {
        "url": "http://quote-engine:8001/quote",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "loan_amount",
              "value": "={{$json.loanAmount}}"
            },
            {
              "name": "property_value",
              "value": "={{$json.propertyValue}}"
            },
            {
              "name": "credit_score",
              "value": "={{$json.creditScore}}"
            },
            {
              "name": "employment_status",
              "value": "={{$json.employmentStatus}}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-generate-quote",
      "name": "Generate Quote",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [650, 300]
    },
    {
      "parameters": {
        "url": "http://campaign-engine:8002/leads",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "lead_id",
              "value": "={{$node['Save to Database'].json.id}}"
            },
            {
              "name": "email",
              "value": "={{$json.email}}"
            },
            {
              "name": "firstName",
              "value": "={{$json.firstName}}"
            },
            {
              "name": "campaign_type",
              "value": "welcome"
            }
          ]
        }
      },
      "id": "http-trigger-campaign",
      "name": "Trigger Welcome Campaign",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [850, 300]
    },
    {
      "parameters": {
        "fromEmail": "noreply@ratehunter.net",
        "toEmail": "={{$json.email}}",
        "subject": "Your Mortgage Quote is Ready!",
        "emailType": "html",
        "message": "<h2>Hello {{$json.firstName}},</h2><p>Thank you for your interest! We've generated a personalized mortgage quote for you.</p><p><strong>Loan Amount:</strong> ${{$json.loanAmount}}</p><p><strong>Estimated Rate:</strong> {{$node['Generate Quote'].json.rate}}%</p><p><a href=\"https://ratehunter.net/quote/{{$node['Save to Database'].json.id}}\">View Full Quote</a></p>"
      },
      "id": "email-send-quote",
      "name": "Send Quote Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1050, 300],
      "credentials": {
        "smtp": {
          "id": "2",
          "name": "SMTP - SendGrid"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\": true, \"leadId\": \"{{$node['Save to Database'].json.id}}\", \"quoteId\": \"{{$node['Generate Quote'].json.quote_id}}\"}",
        "options": {}
      },
      "id": "respond-to-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1250, 300]
    }
  ],
  "connections": {
    "Lead Webhook": {
      "main": [
        [
          {
            "node": "Save to Database",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save to Database": {
      "main": [
        [
          {
            "node": "Generate Quote",
            "type": "main",
            "index": 0
          },
          {
            "node": "Trigger Welcome Campaign",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Quote": {
      "main": [
        [
          {
            "node": "Send Quote Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Welcome Campaign": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Quote Email": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 1,
  "updatedAt": "2026-01-11T00:00:00.000Z",
  "versionId": "1"
}
