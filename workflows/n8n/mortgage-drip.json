{
  "name": "Mortgage Drip Campaign (n8n)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * *"
            }
          ]
        }
      },
      "name": "Daily Trigger (10 AM)",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://mortgage-crm:3000/api/leads",
        "options": {}
      },
      "name": "Fetch Qualified Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.status}}",
              "value2": "QUALIFIED"
            }
          ],
          "number": [
            {
              "value1": "={{$json.daysSinceLastContact}}",
              "operation": "largerEqual",
              "value2": 3
            }
          ]
        }
      },
      "name": "Filter: Needs Follow-up",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "fromEmail": "team@nyra.com",
        "toEmail": "={{$json.borrower.email}}",
        "subject": "Update on your Mortgage Application",
        "text": "Hi {{$json.borrower.firstName}},\n\nWe haven't heard from you in a few days. We wanted to check if you had any questions about the pre-approval process or the required documents.\n\nBest,\nNyra Mortgage Team"
      },
      "name": "Send Drip Email (SMTP/SendGrid)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [850, 200]
    },
    {
      "parameters": {
        "content": "Follow-up SMS: Hi {{$json.borrower.firstName}}, this is the Nyra Mortgage Team. Let us know if you need help with your application!",
        "to": "={{$json.borrower.phone}}"
      },
      "name": "Send SMS (Twilio)",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [850, 400]
    }
  ],
  "connections": {
    "Daily Trigger (10 AM)": {
      "main": [
        [
          {
            "node": "Fetch Qualified Leads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Qualified Leads": {
      "main": [
        [
          {
            "node": "Filter: Needs Follow-up",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter: Needs Follow-up": {
      "main": [
        [
          {
            "node": "Send Drip Email (SMTP/SendGrid)",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send SMS (Twilio)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
