# Core API keys
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-openai-...
GEMINI_API_KEY=AIza...          # Google AI Studio key
OPENROUTER_API_KEY=sk-or-...

# LiteLLM master key (used by Claude Code / Claude Flow as ANTHROPIC_AUTH_TOKEN)
LITELLM_MASTER_KEY=sk-nyra-litellm-master

# Optional Postgres / Redis if you later use full LiteLLM stack
POSTGRES_PASSWORD=nyra-litellm
REDIS_PASSWORD=nyra-litellm

# MetaMCP
METAMCP_APP_URL=http://localhost:12008

# ArchGW (if used as LAN router)
ARCHGW_HOST=0.0.0.0
ARCHGW_PORT=8088
