# Shared non-secret defaults for LAN environment.
# Copy to: infra\env\lan\shared\.env  (do NOT commit)
NYRA_ENV=lan
NYRA_DOMAIN=ratehunter.net

# ---- Core services ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nyra
POSTGRES_USER=nyra
POSTGRES_PASSWORD=CHANGEME_postgres

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGEME_redis

# ---- n8n (Flow Nexus) ----
N8N_HOST=n8n
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Los_Angeles

# The config you referenced for Flow Nexus
FLOW_NEXUS_URL=https://mcp-flow-nexus.ruv.io
MCP_PROTOCOL_VERSION=2025-06-18

# ---- Open WebUI ----
OPENWEBUI_PORT=3001
# If you use Ollama on workers, set this to your orchestrator-side LiteLLM/OpenAI-compatible gateway later.
OPENAI_API_BASE_URL=http://orchestrator-mini:4000/v1
OPENAI_API_KEY=CHANGEME_if_needed

# ---- LobeChat ----
LOBECHAT_PORT=3210
LOBECHAT_ACCESS_CODE=CHANGEME_lobe_access

# ---- Flowise ----
FLOWISE_PORT=3002
FLOWISE_USERNAME=admin
FLOWISE_PASSWORD=CHANGEME_flowise

# ---- Gitea ----
GITEA_PORT=3000
GITEA_SSH_PORT=2222

# ---- Claude / Anthropic ----
ANTHROPIC_API_KEY=CHANGEME_anthropic

# ---- Claude-Flow memory (ReasoningBank) ----
REASONINGBANK_ENABLED=true
REASONINGBANK_DB_PATH=./infra/state/reasoningbank.sqlite
REASONINGBANK_K=8
REASONINGBANK_MIN_CONFIDENCE=0.35

# ---- Observability (optional) ----
PROMETHEUS_PORT=9090
GRAFANA_PORT=3005
LOKI_PORT=3100
