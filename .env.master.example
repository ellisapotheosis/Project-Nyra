# ------------------ GLOBAL ------------------
NODE_ENV=development
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=
GITHUB_TOKEN=

# ------------------ METAMCP ------------------
APP_URL=http://localhost:12008
METAMCP_POSTGRES_PASSWORD=
METAMCP_AUTH_SECRET=

# ------------------ CASISTACK ------------------
MANAGER_PORT=3001
MCP_PROXY_MODE=unified
MCP_PROXY_TYPE=mcpo
PORT_RANGE_START=4200
PORT_RANGE_END=4300
# Must be an ABSOLUTE path to your Claude Desktop config; no '~' expansion in Compose
CLAUDE_CONFIG_ABSOLUTE_PATH=

# ------------------ MEMORY ------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
POSTGRES_USER=nyra
POSTGRES_PASSWORD=nyra
POSTGRES_DB=nyra

# ------------------ MCP SERVERS ------------------
# Filesystem MCP
NYRA_MOUNT_ROOT=
# Websearch MCP
WEBSEARCH_PROVIDER=brave
BRAVE_API_KEY=
# GitHub MCP
GITHUB_TOKEN=
# Activepieces MCP
ACTIVEPIECES_API_KEY=
# Elasticsearch MCP
ELASTIC_HOST=http://localhost:9200
ELASTIC_API_KEY=

# ------------------ INGESTION ------------------
NYRA_INGEST_PROFILE=default
NYRA_INGEST_TARGET=qdrant
NYRA_INGEST_INPUT=./docs

# ------------------ INFISICAL ------------------
INFISICAL_TOKEN=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev
INFISICAL_SITE_URL=https://app.infisical.com

# Optional live upsert during ingestion
NYRA_INGEST_DIRECT_QDRANT=0
