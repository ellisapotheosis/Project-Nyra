# ==============================================================================
# Project Nyra - Cloudflare Tunnel Tokens (Example)
# ==============================================================================
# This file shows the structure of Cloudflare tunnel configuration
# DO NOT commit actual tokens to git!
#
# To use:
#   1. Copy this file to .env.cloudflare
#   2. Fill in your actual tunnel tokens
#   3. Run: ./scripts/infisical/store-cloudflare-tokens.sh
#   4. Delete .env.cloudflare after tokens are stored in Infisical
# ==============================================================================

# Orchestrator Node
CLOUDFLARE_TUNNEL_TOKEN_ORCHESTRATOR=eyJhIjoiYWJjZGVmMTIzNDU2Nzg5MCIsInQiOiJhYmNkZWYxMjM0NTY3ODkwIiwicyI6ImFiY2RlZjEyMzQ1Njc4OTAifQ==
CLOUDFLARE_TUNNEL_NAME_ORCHESTRATOR=nyra-orchestrator
CLOUDFLARE_TUNNEL_ID_ORCHESTRATOR=12345678-1234-1234-1234-123456789012

# Worker Node - RTX 5090
CLOUDFLARE_TUNNEL_TOKEN_WORKER_RTX5090=eyJhIjoiZGVmZ2hpMTIzNDU2Nzg5MCIsInQiOiJkZWZnaGkxMjM0NTY3ODkwIiwicyI6ImRlZmdoaTEyMzQ1Njc4OTAifQ==
CLOUDFLARE_TUNNEL_NAME_WORKER_RTX5090=nyra-worker-rtx5090
CLOUDFLARE_TUNNEL_ID_WORKER_RTX5090=23456789-2345-2345-2345-234567890123

# Worker Node - RTX 3060
CLOUDFLARE_TUNNEL_TOKEN_WORKER_RTX3060=eyJhIjoiZ2hpamtsMTIzNDU2Nzg5MCIsInQiOiJnaGlqa2wxMjM0NTY3ODkwIiwicyI6ImdoaWprbDEyMzQ1Njc4OTAifQ==
CLOUDFLARE_TUNNEL_NAME_WORKER_RTX3060=nyra-worker-rtx3060
CLOUDFLARE_TUNNEL_ID_WORKER_RTX3060=34567890-3456-3456-3456-345678901234

# Worker Node - RTX 3090Ti
CLOUDFLARE_TUNNEL_TOKEN_WORKER_RTX3090TI=eyJhIjoiam5vcHFyMTIzNDU2Nzg5MCIsInQiOiJqbm9wcXIxMjM0NTY3ODkwIiwicyI6Impub3BxcjEyMzQ1Njc4OTAifQ==
CLOUDFLARE_TUNNEL_NAME_WORKER_RTX3090TI=nyra-worker-rtx3090ti
CLOUDFLARE_TUNNEL_ID_WORKER_RTX3090TI=45678901-4567-4567-4567-456789012345

# Optional: Cloudflare Account Settings
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_ZONE_ID=your_zone_id_here

# ==============================================================================
# IMPORTANT SECURITY NOTES
# ==============================================================================
# 1. This file (.env.cloudflare.example) is for documentation only
# 2. Never commit actual tokens to git
# 3. After storing tokens in Infisical, delete the .env.cloudflare file
# 4. Tokens shown above are examples and non-functional
# 5. Real tokens are 200+ characters long
# ==============================================================================

# How to get your tunnel tokens:
# 1. Install cloudflared: https://developers.cloudflare.com/cloudflare-one/connections/connect-apps/install-and-setup/
# 2. Login: cloudflared login
# 3. Create tunnel: cloudflared tunnel create nyra-orchestrator
# 4. Get token: cloudflared tunnel token nyra-orchestrator
# 5. Copy the long base64 string as your CLOUDFLARE_TUNNEL_TOKEN
