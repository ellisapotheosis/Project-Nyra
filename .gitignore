################################################################################
# Documentation Archive (docs/archive/)
# Purpose: Store obsolete but potentially recoverable files
################################################################################
# Track archive documentation and structure
!docs/archive/
!docs/archive/**/*.md
!docs/archive/**/.gitkeep

# Exclude build artifacts from archives
docs/archive/**/node_modules/
docs/archive/**/.next/
docs/archive/**/dist/
docs/archive/**/build/
docs/archive/**/*.log
docs/archive/**/*.tmp
docs/archive/**/*.old

# Exclude sensitive files that may have been archived
docs/archive/**/.env
docs/archive/**/.env.*
docs/archive/**/*.pem
docs/archive/**/*.key
docs/archive/**/*.db
bootstrap/

# Codanna local index/cache
.codanna/
.env.gitea
.env.infisical
.secrets/
gitea-setup-summary-*.md

# Memory database files (cross-PC persistent but too large for git)
.claude/memory/memory.db
.claude/memory/hnsw.index
.claude/memory/hnsw.metadata.json
