# Generated Docker Compose output with expanded secrets.
infra/hosts/oracle-vps/resolved_config.yml
# Infisical agent tokens — never commit
infra/hosts/**/.infisical-token
infra/hosts/**/infisical-agent.token
# Backup files in configs
infra/configs/**/*.backup-*
.secrets/
gitea-setup-summary-*.md

# Local external dependencies (git repos)
# external/ is NOT ignored — all subdirs are tracked by default.
# Explicit negations below protect against any future broad exclude rules:
!external/pocket-tts/
!external/pocket-tts-openai/
data/pockettts/
data/gitea/
data/gitea-db/

# llxprt local cache (npm prefix + jefe binary)
.llxprt/

