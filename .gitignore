# Commit only TEMPLATE.env.host; fill secrets locally after pull.
**/.env.host
# Per-host env files — secrets live here during Infisical migration
# Secrets
.env
.env.infisical
.env.*
!.env.example
!infra/env/TEMPLATE.env.host
# Oracle VPS live env (moved from infra/oracle/ to infra/env/)
