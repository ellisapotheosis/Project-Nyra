################################################################################
# Project Nyra .gitignore
# Tailored for private monorepo + Infisical secret injection
################################################################################

################################################################################
# Secrets, Environment Files & Credentials (NEVER COMMIT)
################################################################################
# Root & nested live env files
.env
.env.*
**/.env
**/.env.*
**/*.env

# Canonical host & shared live secret files (managed via Infisical)
/infra/hosts/shared.env
/infra/hosts/*/.env
/infra/hosts/*/.env.*
infra/env/secrets/
secrets/
.secrets/
credentials/

# Explicit leaked/legacy secret files
infra/docker-compose/.env.golden-stack-populated
infra-archived/infra-20260206-1551/docker-compose/.env.golden-stack-populated
nyra-configs/.env
config/env/.env.legacy
configs/env/.env.legacy

# Certificates & Private Keys
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx

# Re-include safe example & template files (must appear after ignore rules)
!/infra/hosts/shared.env.example
!/infra/hosts/hosts-shared.example.env
!/infra/shared-example.env
!infra/hosts/orchestrator/example.env
!infra/hosts/oracle-vps/example.env
!infra/hosts/worker-rtx5090/example.env
!infra/hosts/worker-rtx3090ti/example.env
!**/.env.example
!**/.env.*.example
!**/*.env.example
!**/*.example.env
!**/.env.template
!**/.env.*.template
!**/*.env.template
!**/*.template.env
!**/env.template
!**/*.tmpl

# Historical env backups & raw exports that may contain copied secrets
docs/**/env-backups/
docs/**/archived-root/
infra/cleanup_archive/
data/**/ratehunter-export/
data/gitea/
data/app-guidance/files/nyra-stack/

################################################################################
# Node.js, pnpm & Monorepo Build Artifacts
################################################################################
node_modules/
**/node_modules/
package-lock.json
yarn.lock
bun.lockb
bun.lock
!pnpm-lock.yaml
.pnp/
.pnp.js
.pnpm-store/
.pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
.yarn-integrity
.npm
npm-debug.log*

# Build outputs (anchored/scoped so !infra/docker/build/ works properly)
/build/
/dist/
**/dist/
**/out/
**/.next/
**/.nuxt/
**/.output/
**/.open-next/
*.tsbuildinfo
.turbo/
*.turbo.json

# Explicitly keep Docker build contexts
!infra/docker/build/
!infra/docker/build/**

################################################################################
# Python & Virtual Environments
################################################################################
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.installed.cfg
pip-wheel-metadata/
share/python-wheels/
PIPFILE.lock

# Root-anchored packaging dirs (prevents breaking apps/*/src/lib or packages/*/lib)
/develop-eggs/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/

# Virtual environments
.venv/
**/.venv/
venv/
**/venv/
ENV/
env/
env.bak/
venv.bak/

# Jupyter checkpoints (notebooks themselves are tracked)
.ipynb_checkpoints/
**/.ipynb_checkpoints/

################################################################################
# Rust
################################################################################
target/
**/target/
**/*.rs.bk

################################################################################
# Databases & Local State
################################################################################
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sql.gz

################################################################################
# Docker & Local Runtime Overrides
################################################################################
.docker/
.dockerignore.local
# Keep host-specific compose files tracked; only ignore untracked scratch overrides
docker-compose.local.yml

################################################################################
# Testing, Coverage & Logs
################################################################################
coverage/
**/coverage/
.nyc_output/
.coverage
htmlcov/
.pytest_cache/
**/.pytest_cache/
.jest/
junit.xml
test-results/
*.log
*.test.log
.eslintcache
.stylelintcache

################################################################################
# Archives, Backups & Migration Scratchpads
################################################################################
_backup/
*.backup
backup/
backups/
**/consolidation-temp/
**/consolidation-tmp/
consolidation-work/
**/migration-temp/
**/migration-staging/
**/.migration-cache/

# Keep _archive/ docs & structure tracked, ignore heavy artifacts & secrets inside
_archive/**/node_modules/
_archive/**/dist/
_archive/**/build/
_archive/**/.next/
_archive/**/.nuxt/
_archive/**/*.log
_archive/**/*.tmp
_archive/**/*.temp
_archive/**/.env
_archive/**/.env.*
_archive/**/*.pem
_archive/**/*.key
_archive/**/*.db
_archive/**/*.sqlite
_archive/**/*.db-journal

################################################################################
# IDE, Agent Configs & OS Files
################################################################################
# Track .vscode/ and .codex/ in private repo; ignore personal workspace/swap files
.idea/
*.swp
*.swo
*~
.classpath
*.sublime-project
*.sublime-workspace
/config.toml

# OS metadata & Windows artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
*:Zone.Identifier
*.tmp
*.temp
.cache/
.temp/
tmp/
temp/
*.bak
*.orig
*.rej

# Windows Reserved Filenames (Security)
**/nul
**/NUL
**/CON
**/PRN
**/AUX
**/COM[1-9]
**/LPT[1-9]

# ClawTeam runtime state
**/clawteam-state/
