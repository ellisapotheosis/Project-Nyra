node_modules/
**/node_modules/
package-lock.json
yarn.lock
!pnpm-lock.yaml
.pnp/
.pnp.js

################################################################################
# Build Outputs and Artifacts
################################################################################
dist/
build/
# Exception: Docker build directory should be tracked
!infra/docker/build/
out/
.next/
.nuxt/
.output/
*.log
*.tsbuildinfo
coverage/
.nyc_output/

################################################################################
# Environment Files and Secrets
################################################################################
.env
.env.*
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
.env.cloudflare
.env.gitea
.env.infisical
*.pem
*.key
*.cert
secrets/
.secrets/
credentials/
.letta/
.mempalace/
data/gitea/
data/app-guidance/files/nyra-stack/
infra/env/secrets/
infra/cloudflare/apply-results/
.infisical/
*.token
*.secret
*.secrets
*.secret.json
*infisical-cache*.json

# Host/runtime env files must stay local or come from Infisical.
**/.env
**/.env.*
**/*.env
!**/.env.example
!**/.env.*.example
!**/*.env.example
!**/*.example.env
!**/.env.template
!**/.env.*.template
!**/*.env.template
!**/*.template.env
!**/env.template
!**/*.tmpl

# Historical env backups and ingest archives can contain copied secrets.
docs/**/env-backups/
docs/**/archived-root/
infra/cleanup_archive/
data/**/ratehunter-export/

# Explicitly blocked leaked secret files (do not commit)
infra/docker-compose/.env.golden-stack-populated
infra-archived/infra-20260206-1551/docker-compose/.env.golden-stack-populated
nyra-configs/.env
config/env/.env.legacy
configs/env/.env.legacy

################################################################################
# IDE and Editor Files
################################################################################
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

################################################################################
# OS Files
################################################################################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Local Codex/CLI root config copy; canonical repo config lives under .codex/.
/config.toml

################################################################################
# Windows Reserved Filenames (Security)
################################################################################
**/nul
**/NUL
**/CON
**/PRN
**/AUX
**/COM[1-9]
**/LPT[1-9]

################################################################################
# Temporary and Cache Files
################################################################################
*.tmp
*.temp
.cache/
.temp/
tmp/
temp/
*.swp
*.bak

################################################################################
# Archive and Backup Directories
# Note: The _archive/ directory itself is tracked, but certain files within
# are excluded to prevent committing sensitive data from archived projects
################################################################################
# Exclude common build artifacts and dependencies in archives
_archive/**/node_modules/
_archive/**/dist/
_archive/**/build/
_archive/**/.next/
_archive/**/.nuxt/

# Exclude logs and temporary files in archives
_archive/**/*.log
_archive/**/*.tmp
_archive/**/*.temp

# Exclude environment and secret files in archives
_archive/**/.env
_archive/**/.env.*
_archive/**/*.pem
_archive/**/*.key

# Exclude database files in archives
_archive/**/*.db
_archive/**/*.sqlite
_archive/**/*.db-journal

# BUT: Keep the _archive directory structure and documentation
!_archive/
!_archive/**/README.md
!_archive/**/ARCHIVE-INFO.md
!_archive/**/.gitkeep

# Backup directories (completely excluded)
_backup/
*.backup
backup/
backups/

# Temporary consolidation files
**/consolidation-temp/
**/consolidation-tmp/
consolidation-work/

# Consolidation planning artifacts
**/migration-temp/
**/migration-staging/
**/.migration-cache/

# Workflow exports that may include credential metadata
**/*n8n-export*.json
**/*activepieces-export*.json


################################################################################
# Turborepo
################################################################################
.turbo/
.turbo
*.turbo.json


################################################################################
# Database Files
################################################################################
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sql.gz

