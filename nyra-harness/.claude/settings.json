{
  "permissions": {
    "allow": [
      "Bash(npx nyra-harness*)",
      "mcp__nyra-harness__*",
      "mcp__code_index__*",
      "Bash(npm test*)",
      "Bash(npm run*)",
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push*)",
      "Bash(rm -rf*)"
    ]
  },
  "mcpServers": {
    "nyra-harness": {
      "command": "npx",
      "args": ["-y", "nyra-harness@latest", "mcp", "start"]
    },
    "code_index": {
      "command": "npx",
      "args": ["-y", "nyra-harness@latest", "mcp", "index"]
    }
  }
}
