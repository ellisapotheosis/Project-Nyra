# transitional fallback for older deployments.
CRM_API_URL=https://api.projectnyra.com
CRM_API_KEY=replace-me
LEAD_CAPTURE_API_URL=https://api.projectnyra.com
LEAD_CAPTURE_API_KEY=replace-me
NEXT_PUBLIC_MARKETING_DEFAULT_THEME=apotheosis
NEXT_PUBLIC_ENABLE_MOTION=true
