{
  "name": "ratehunter-landing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:cf": "opennextjs-cloudflare build",
    "preview": "wrangler pages dev .open-next",
    "deploy": "wrangler pages deploy .open-next",
    "deploy:production": "wrangler pages deploy .open-next --branch=main",
    "deploy:preview": "wrangler pages deploy .open-next --branch=preview",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "jest --watch",
    "test:ci": "pnpm exec jest --ci --passWithNoTests || npx --yes jest@29 --ci --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "cf:login": "wrangler login",
    "cf:deploy": "npm run build:cf && npm run deploy"
  },
  "dependencies": {
    "next": "16.1.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.17.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.11",
    "@types/node": "^25",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.16",
    "eslint": "^10",
    "eslint-config-next": "14.2.18",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^4.2.2",
    "typescript": "^5",
    "wrangler": "^4.59.2"
  }
}
