# Environment Variables Template for RateHunter Landing Page
# Copy this file to .env.local for local development
# For production, set these in Cloudflare Pages dashboard

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://ratehunter.com
NEXT_PUBLIC_SITE_NAME=RateHunter

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=ratehunter.com

# API Keys (if needed)
# API_SECRET_KEY=your-secret-key-here

# Database (if needed)
# DATABASE_URL=postgresql://user:password@localhost:5432/ratehunter

# Email/Contact Form (if using)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# CONTACT_EMAIL=contact@ratehunter.com

# Feature Flags
# ENABLE_ANALYTICS=true
# ENABLE_PWA=true

# Development
NODE_ENV=development
