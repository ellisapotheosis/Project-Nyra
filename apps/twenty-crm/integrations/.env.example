# TwentyCRM Configuration
TWENTYCRM_API_URL=https://api.twenty.com/v1
TWENTYCRM_API_KEY=your_api_key_here
TWENTYCRM_WEBHOOK_SECRET=your_webhook_secret_here

# Sync Configuration
SYNC_INTERVAL_MINUTES=15
SYNC_BATCH_SIZE=100
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_MS=1000

# Conflict Resolution
CONFLICT_STRATEGY=timestamp_wins
# Options: timestamp_wins, source_wins, manual_review

# Health Monitoring
HEALTH_CHECK_INTERVAL_MINUTES=5
ALERT_EMAIL=admin@example.com

# Logging
LOG_LEVEL=info
# Options: error, warn, info, debug

# Server Configuration
PORT=3000
NODE_ENV=development
