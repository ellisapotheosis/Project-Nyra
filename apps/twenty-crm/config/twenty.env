# TwentyCRM Production Configuration
# Database Configuration
PG_DATABASE_URL=postgresql://twenty:twenty_password@twenty-db:5432/twenty

# Redis Configuration
REDIS_URL=redis://:redis_password@twenty-redis:6379

# App Configuration
SERVER_URL=http://localhost:3020
FRONT_BASE_URL=http://localhost:3020
PORT=3000

# Authentication & Security Secrets (CHANGE IN PRODUCTION!)
ACCESS_TOKEN_SECRET=nyra_access_token_secret_change_in_production
LOGIN_TOKEN_SECRET=nyra_login_token_secret_change_in_production
REFRESH_TOKEN_SECRET=nyra_refresh_token_secret_change_in_production
FILE_TOKEN_SECRET=nyra_file_token_secret_change_in_production

# Email Configuration
EMAIL_DRIVER=logger
EMAIL_FROM_ADDRESS=noreply@nyra.com
EMAIL_SYSTEM_ADDRESS=system@nyra.com

# File Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/storage

# External Integrations
SUPPORT_CHAT_ENABLED=false
TELEMETRY_ENABLED=false
CAPTCHA_DRIVER=none

# API Configuration
API_RATE_LIMITING_TTL=100
API_RATE_LIMITING_REQUEST_COUNT=100

# Features
DEBUG_MODE=false
SIGN_IN_PREFILLED=false
IS_MULTIWORKSPACE_ENABLED=false

# Nyra Integration
NYRA_NEXUS_ROUTER_URL=http://nexus-router:6000
NYRA_WEBHOOK_SECRET=nyra_webhook_secret_change_in_production
NYRA_INTEGRATION_ENABLED=true

# Calendar Integration (Optional)
CALENDAR_DRIVER=none

# Message Queue
MESSAGE_QUEUE_TYPE=redis

# Server Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3008,http://localhost:3000
