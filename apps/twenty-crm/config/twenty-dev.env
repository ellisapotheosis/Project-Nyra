# TwentyCRM Development Configuration
# Database Configuration
PG_DATABASE_URL=postgresql://twenty:twenty_dev_pass@twenty-db-dev:5432/twenty_dev

# Redis Configuration
REDIS_URL=redis://:redis_dev_pass@twenty-redis-dev:6379

# App Configuration
SERVER_URL=http://localhost:3021
FRONT_BASE_URL=http://localhost:3021
PORT=3000
NODE_ENV=development

# Development Secrets (FOR DEV ONLY!)
ACCESS_TOKEN_SECRET=dev_access_token_secret_for_development_only
LOGIN_TOKEN_SECRET=dev_login_token_secret_for_development_only
REFRESH_TOKEN_SECRET=dev_refresh_token_secret_for_development_only
FILE_TOKEN_SECRET=dev_file_token_secret_for_development_only

# Email Configuration (Logger for dev)
EMAIL_DRIVER=logger
EMAIL_FROM_ADDRESS=dev@nyra.local
EMAIL_SYSTEM_ADDRESS=system@nyra.local

# File Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/storage

# External Integrations (Disabled for dev)
SUPPORT_CHAT_ENABLED=false
TELEMETRY_ENABLED=false
CAPTCHA_DRIVER=none

# API Configuration (More permissive for dev)
API_RATE_LIMITING_TTL=1000
API_RATE_LIMITING_REQUEST_COUNT=1000

# Development Features
DEBUG_MODE=true
SIGN_IN_PREFILLED=true
IS_MULTIWORKSPACE_ENABLED=false

# Nyra Integration
NYRA_NEXUS_ROUTER_URL=http://localhost:6000
NYRA_WEBHOOK_SECRET=dev_webhook_secret_for_development_only
NYRA_INTEGRATION_ENABLED=true

# Development CORS (Allow all for dev)
CORS_ALLOWED_ORIGINS=http://localhost:3008,http://localhost:3000,http://localhost:3001,http://localhost:3021

# Logging
LOG_LEVEL=debug
