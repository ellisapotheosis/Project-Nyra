{
  "name": "Mortgage Lead Intake",
  "nodes": [
    {
      "parameters": {
        "path": "webhook-lead-intake",
        "options": {
          "rawBody": true
        },
        "responseMode": "lastNode",
        "responseData": "allEntries"
      },
      "id": "webhook-trigger",
      "name": "Webhook - Lead Capture",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "lead-intake-webhook"
    },
    {
      "parameters": {
        "functionCode": "// Validate and structure lead data\nconst leadData = $input.item.json;\n\n// Extract and validate required fields\nconst lead = {\n  firstName: leadData.firstName || leadData.first_name,\n  lastName: leadData.lastName || leadData.last_name,\n  email: leadData.email,\n  phone: leadData.phone || leadData.phoneNumber,\n  propertyValue: parseFloat(leadData.propertyValue) || 0,\n  loanAmount: parseFloat(leadData.loanAmount) || 0,\n  propertyType: leadData.propertyType || 'primary',\n  creditScore: leadData.creditScore || null,\n  source: leadData.source || 'website',\n  utmSource: leadData.utm_source,\n  utmMedium: leadData.utm_medium,\n  utmCampaign: leadData.utm_campaign,\n  capturedAt: new Date().toISOString(),\n  status: 'new'\n};\n\n// Validate email format\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nif (!emailRegex.test(lead.email)) {\n  throw new Error('Invalid email format');\n}\n\n// Validate phone format (basic)\nconst phoneRegex = /^[+]?[(]?[0-9]{3}[)]?[-\\s\\.]?[0-9]{3}[-\\s\\.]?[0-9]{4,6}$/;\nif (!phoneRegex.test(lead.phone)) {\n  throw new Error('Invalid phone format');\n}\n\n// Calculate loan-to-value ratio\nif (lead.propertyValue > 0) {\n  lead.ltvRatio = (lead.loanAmount / lead.propertyValue * 100).toFixed(2);\n}\n\n// Assign lead score based on initial data\nlead.leadScore = 50; // Base score\nif (lead.creditScore > 700) lead.leadScore += 20;\nif (lead.ltvRatio < 80) lead.leadScore += 15;\nif (lead.propertyType === 'primary') lead.leadScore += 10;\nif (lead.source === 'referral') lead.leadScore += 15;\n\nreturn { json: lead };"
      },
      "id": "validate-lead-data",
      "name": "Validate & Structure Lead",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.CRM_API_URL }}/api/leads",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.CRM_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "create-crm-lead",
      "name": "Create Lead in CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [650, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO lead_intake_log (lead_id, first_name, last_name, email, phone, source, status, created_at) VALUES ($1, $2, $3, $4, $5, $6, $7, NOW()) RETURNING *",
        "additionalFields": {
          "queryParameters": "={{ JSON.stringify([$json.id, $json.firstName, $json.lastName, $json.email, $json.phone, $json.source, $json.status]) }}"
        }
      },
      "id": "log-to-database",
      "name": "Log to Database",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [850, 300],
      "credentials": {
        "postgres": {
          "id": "orchestrator_db",
          "name": "Orchestrator PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.leadScore }}",
              "operation": "largerEqual",
              "value2": 75
            }
          ]
        }
      },
      "id": "check-lead-quality",
      "name": "Check Lead Quality",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.N8N_WORKFLOW_URL }}/webhook/high-priority-lead",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "trigger-high-priority",
      "name": "Trigger High-Priority Flow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "url": "={{ $env.N8N_WORKFLOW_URL }}/webhook/standard-lead",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
