        "options": {}
      },
      "id": "trigger-standard",
      "name": "Trigger Standard Flow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1250, 400]
    },
    {
      "parameters": {
        "operation": "sendSms",
        "from": "={{ $env.TWILIO_PHONE_NUMBER }}",
        "to": "={{ $json.phone }}",
        "message": "Hi {{ $json.firstName }}, thank you for your mortgage inquiry! We've received your information and will reach out within 1 hour. Reply STOP to opt out.",
        "options": {}
      },
      "id": "send-sms-confirmation",
      "name": "Send SMS Confirmation",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [1450, 300],
      "credentials": {
        "twilioApi": {
          "id": "twilio_account",
          "name": "Twilio Account"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM_EMAIL }}",
        "toEmail": "={{ $json.email }}",
        "subject": "Welcome! Your Mortgage Journey Starts Here",
        "emailType": "html",
        "message": "<!DOCTYPE html><html><body><h2>Welcome {{ $json.firstName }}!</h2><p>Thank you for choosing us for your mortgage needs. We've received your information and our expert loan officers will review it shortly.</p><p><strong>Next Steps:</strong></p><ul><li>You'll receive a call within 1 hour during business hours</li><li>Prepare your financial documents</li><li>Check your email for our document checklist</li></ul><p>Your reference number: {{ $json.id }}</p><p>Best regards,<br>The Mortgage Team</p></body></html>",
        "options": {}
      },
      "id": "send-email-confirmation",
      "name": "Send Email Confirmation",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1450, 500],
      "credentials": {
        "smtp": {
          "id": "smtp_account",
          "name": "SMTP Account"
        }
      }
    },
    {
      "parameters": {
        "errorMessage": "Lead intake failed: {{ $json.message }}"
      },
      "id": "error-handler",
      "name": "Error Handler",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [650, 100],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "sendSlackMessage",
        "channel": "#mortgage-leads",
        "text": "⚠️ Lead intake error: {{ $json.message }}\nLead: {{ $json.email }}",
        "otherOptions": {}
      },
      "id": "notify-error",
      "name": "Notify Team on Error",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [850, 100],
      "credentials": {
        "slackApi": {
          "id": "slack_workspace",
          "name": "Slack Workspace"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, leadId: $json.id, message: 'Lead captured successfully' }) }}"
      },
      "id": "webhook-response",
      "name": "Webhook Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1650, 300]
    }
  ],
