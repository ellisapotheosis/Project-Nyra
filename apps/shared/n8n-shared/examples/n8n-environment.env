# n8n Environment Configuration for TwentyCRM Integration
# Copy to .env and configure with your values

# ==============================================
# BASIC N8N CONFIGURATION
# ==============================================

# Port and Host Configuration
N8N_PORT=5678
N8N_HOST=0.0.0.0
N8N_PROTOCOL=http

# Webhook Configuration
N8N_WEBHOOK_URL=http://localhost:5678/webhook/
WEBHOOK_TUNNEL_URL=https://your-tunnel.ngrok.io/webhook/

# Editor Configuration
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_DISABLE_UI=false

# ==============================================
# DATABASE CONFIGURATION
# ==============================================

# PostgreSQL Configuration (recommended for production)
DB_TYPE=postgresdb
N8N_DB_HOST=postgres
N8N_DB_PORT=5432
N8N_DB_NAME=nyra
N8N_DB_USER=nyra
N8N_DB_PASSWORD=your_secure_db_password

# Alternative: SQLite (for development only)
# DB_TYPE=sqlite
# DB_SQLITE_DATABASE=/home/node/.n8n/database.sqlite

# ==============================================
# SECURITY & AUTHENTICATION
# ==============================================

# Encryption Key (REQUIRED - generate with: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=your_64_character_encryption_key_here

# Basic Authentication
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_secure_password

# Community Packages
N8N_COMMUNITY_PACKAGES_ENABLED=true

# ==============================================
# TWENTY CRM INTEGRATION
# ==============================================

# TwentyCRM Connection
TWENTY_CRM_URL=http://twenty-crm:3020
TWENTY_CRM_API_KEY=your_twenty_api_key_here
TWENTY_CRM_WORKSPACE_ID=default

# TwentyCRM Database (for direct queries if needed)
TWENTY_DB_HOST=twenty-db
TWENTY_DB_PORT=5433
TWENTY_DB_NAME=twenty
TWENTY_DB_USER=twenty
TWENTY_DB_PASSWORD=your_twenty_db_password

# ==============================================
# NYRA PLATFORM INTEGRATION
# ==============================================

# Nexus Router Integration
NEXUS_ROUTER_URL=http://nexus-router:6000
NEXUS_MCP_URL=http://nexus-router:8080

# Nyra Service URLs
QUOTE_ENGINE_URL=http://quote-engine:8001
CAMPAIGN_ENGINE_URL=http://campaign-engine:8002
LEAD_CAPTURE_URL=http://lead-capture-api:8003
SECURITY_SERVICE_URL=http://security-service:8090

# Admin Dashboard
ADMIN_DASHBOARD_URL=http://admin-dashboard:3008
ADMIN_API_KEY=your_admin_api_key

# ==============================================
# EMAIL CONFIGURATION
# ==============================================

# SMTP Configuration (SendGrid recommended)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key

# Email Settings
EMAIL_FROM_ADDRESS=noreply@nyra.com
EMAIL_FROM_NAME=Nyra Mortgage Platform

# ==============================================
# SMS CONFIGURATION (TWILIO)
# ==============================================

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# ==============================================
# EXTERNAL API INTEGRATIONS
# ==============================================

# Credit Bureau APIs
EXPERIAN_API_KEY=your_experian_api_key
EQUIFAX_API_KEY=your_equifax_api_key
TRANSUNION_API_KEY=your_transunion_api_key

# Rate Data Sources
FREDDIE_MAC_API_KEY=your_freddie_mac_api_key
FANNIE_MAE_API_KEY=your_fannie_mae_api_key

# Compliance Services
TRID_API_KEY=your_trid_api_key
HMDA_REPORTING_KEY=your_hmda_key

# ==============================================
# PERFORMANCE & EXECUTION SETTINGS
# ==============================================

# Execution Timeouts (in seconds)
N8N_EXECUTIONS_TIMEOUT=3600
N8N_EXECUTIONS_TIMEOUT_MAX=7200

# Data Retention (in hours)
N8N_EXECUTIONS_DATA_MAX_AGE=168
N8N_EXECUTIONS_DATA_PRUNE=true

# Concurrency Settings
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
N8N_BINARY_DATA_TTL=24

# Queue Mode (for high-volume processing)
QUEUE_BULL_REDIS_HOST=redis
QUEUE_BULL_REDIS_PORT=6379
QUEUE_BULL_REDIS_PASSWORD=your_redis_password

# ==============================================
# LOGGING & MONITORING
# ==============================================

# Log Configuration
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console

# Available levels: error, warn, info, verbose, debug, silly
N8N_LOG_FILE=/home/node/.n8n/logs/n8n.log

# Metrics and Monitoring
N8N_METRICS=true
N8N_METRICS_PREFIX=n8n_

# ==============================================
# TIMEZONE & LOCALIZATION
# ==============================================

# Timezone Configuration
GENERIC_TIMEZONE=America/New_York
TZ=America/New_York

# Locale Settings
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8

# ==============================================
# WORKFLOW SPECIFIC SETTINGS
# ==============================================

# Mortgage Specific Configuration
DEFAULT_LOAN_OFFICER_EMAIL=loanofficer@nyra.com
DEFAULT_COMPLIANCE_EMAIL=compliance@nyra.com
MORTGAGE_ADMIN_EMAIL=admin@nyra.com

# Lead Scoring Configuration
LEAD_SCORE_THRESHOLD_A=80
LEAD_SCORE_THRESHOLD_B=65
LEAD_SCORE_THRESHOLD_C=50

# Rate Alert Configuration
RATE_CHANGE_THRESHOLD=0.125
RATE_CHECK_INTERVAL_MINUTES=240

# ==============================================
# DEVELOPMENT & DEBUGGING
# ==============================================

# Development Mode
NODE_ENV=production
DEBUG_MODE=false

# Development URLs (override for local dev)
# TWENTY_CRM_URL=http://localhost:3021
# QUOTE_ENGINE_URL=http://localhost:8001
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/

# Debug Logging
# N8N_LOG_LEVEL=debug
# DEBUG=n8n*

# ==============================================
# DOCKER CONFIGURATION
# ==============================================

# Container Resource Limits
MEMORY_LIMIT=2g
CPU_LIMIT=1.0

# Volume Paths
N8N_DATA_PATH=./data/n8n
N8N_BACKUP_PATH=./backups/n8n

# ==============================================
# BACKUP & RECOVERY
# ==============================================

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# S3 Backup (optional)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
BACKUP_S3_BUCKET=nyra-n8n-backups

# ==============================================
# COMMUNITY NODES CONFIGURATION
# ==============================================

# Pre-installed Community Packages
N8N_EXTRA_PACKAGES=@linkedpromo/n8n-nodes-twenty @n8n-nodes/n8n-nodes-activepieces

# Custom Node Development
CUSTOM_NODES_PATH=/opt/nyra/custom-nodes
TEMPLATES_PATH=/opt/nyra/templates

# ==============================================
# PRODUCTION OVERRIDES
# ==============================================

# Production Settings (uncomment for production)
# N8N_BASIC_AUTH_ACTIVE=false  # Use proper authentication
# N8N_LOG_LEVEL=warn
# DEBUG_MODE=false
# N8N_DISABLE_UI=false  # Set to true to disable editor in production

# ==============================================
# HIGH AVAILABILITY SETTINGS
# ==============================================

# Queue Mode (for distributed execution)
# EXECUTIONS_MODE=queue
# QUEUE_BULL_REDIS_HOST=redis-cluster
# QUEUE_BULL_REDIS_PORT=6379

# Load Balancer Settings
# N8N_SKIP_WEBHOOK_DEREGISTRATION_SHUTDOWN=true

# ==============================================
# COMPLIANCE & SECURITY
# ==============================================

# Webhook Security
WEBHOOK_SECURITY_ENABLED=true
WEBHOOK_ALLOWED_ORIGINS=https://nyra.com,https://ratehunter.net

# Data Protection
PII_ENCRYPTION_ENABLED=true
AUDIT_LOG_ENABLED=true
RETENTION_POLICY_DAYS=2555  # 7 years for mortgage records

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_MINUTES=15

# ==============================================
# MORTGAGE COMPLIANCE SETTINGS
# ==============================================

# TILA/RESPA Configuration
TILA_DISCLOSURE_DAYS=3
RESPA_TIMELINE_DAYS=30
TRID_DISCLOSURE_ENABLED=true

# HMDA Reporting
HMDA_REPORTING_ENABLED=true
HMDA_LAR_SUBMISSION_ENABLED=true

# State Compliance
STATE_COMPLIANCE_ENABLED=true
NMLS_VALIDATION_ENABLED=true
