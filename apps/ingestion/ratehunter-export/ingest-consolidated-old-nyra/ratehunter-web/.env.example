# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001

# Analytics (Optional)
NEXT_PUBLIC_GA_TRACKING_ID=
NEXT_PUBLIC_GTM_ID=

# Feature Flags
NEXT_PUBLIC_ENABLE_CALCULATOR=true
NEXT_PUBLIC_ENABLE_CHAT=false

# Rate Provider API Keys (Backend only - never expose)
# These should only be in the backend .env
# RATE_PROVIDER_API_KEY=your_key_here
