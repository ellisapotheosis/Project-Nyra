{
  "manifest_version": 3,
  "name": "ChatGPT Automator + Tagger (NYRA)",
  "version": "2.1",
  "description": "CSP-safe popup, Linkwarden (hardcoded) with dedupe, Notion picker (content-side), panel persistence, Whisper WS test page, and site-permissions helper.",
  "permissions": [
    "storage",
    "activeTab",
    "downloads",
    "alarms",
    "notifications",
    "microphone",
    "tabs"
  ],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://files.oaiusercontent.com/*",
    "https://api.notion.com/*",
    "https://api.github.com/*",
    "https://cloud.linkwarden.app/*"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png",
    "256": "icon256.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "whisper-test/*"
      ],
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ]
    }
  ]
}