# OpenClaw internal proxy settings for apps/webapp/app
OPENCLAW_PUBLIC_BASE_URL=http://localhost:3401
OPENCLAW_CHAT_PATH=/v1/chat/completions
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_DEFAULT_MODEL=gpt-4o-mini
NYRA_CHAT_INTERNAL_PROXY_TOKEN=

# CRM bridge settings. The webapp checks these in order:
# 1. CRM_API_URL for the mortgage-crm bridge app
# 2. TWENTY_MCP_URL for the Twenty MCP bridge
# 3. TWENTY_CRM_URL + TWENTY_CRM_API_KEY for direct GraphQL reads
CRM_API_URL=http://localhost:3104
CRM_API_KEY=
TWENTY_MCP_URL=http://localhost:3022
TWENTY_CRM_URL=http://localhost:3020
TWENTY_CRM_API_KEY=

# Supabase auth/backend target for the broker webapp.
# Target shape: Supabase runs on the Oracle VPS, Cloudflare fronts only the HTTPS API/auth surface.
# Do not expose the Supabase Postgres port publicly.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.ratehunter.net
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
