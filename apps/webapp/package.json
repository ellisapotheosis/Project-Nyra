{
  "name": "@nyra/webapp",
  "version": "1.0.0",
  "description": "Nyra Web Application - Mortgage Services and UI",
  "private": true,
  "type": "module",
  "workspaces": [
    "mortgage-services",
    "mortgage-ui"
  ],
  "scripts": {
    "dev": "pnpm --parallel --filter './mortgage-*' dev",
    "dev:services": "pnpm --filter './mortgage-services' dev",
    "dev:ui": "pnpm --filter './mortgage-ui' dev",
    "build": "pnpm --filter './mortgage-*' build",
    "build:services": "pnpm --filter './mortgage-services' build",
    "build:ui": "pnpm --filter './mortgage-ui' build",
    "start": "pnpm --parallel --filter './mortgage-*' start",
    "start:services": "pnpm --filter './mortgage-services' start",
    "start:ui": "pnpm --filter './mortgage-ui' start",
    "lint": "pnpm --filter './mortgage-*' lint",
    "test": "pnpm --filter './mortgage-*' test",
    "clean": "rm -rf mortgage-services/.next mortgage-services/dist mortgage-ui/.next mortgage-ui/dist",
    "typecheck": "pnpm --filter './mortgage-*' typecheck"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  }
}
