# Cloudflare Pages Redirects
# Documentation: https://developers.cloudflare.com/pages/configuration/redirects/

# Redirect www to non-www (change if you prefer www)
# https://www.ratehunter.net/* https://ratehunter.net/:splat 301!

# Or redirect non-www to www (uncomment if you prefer www)
# https://ratehunter.net/* https://www.ratehunter.net/:splat 301!

# Common redirects for legacy URLs
# /old-page /new-page 301
# /pricing /plans 301

# Redirect to external contact form (if using external service)
# /contact https://forms.ratehunter.net/contact 302

# Redirect old paths
# /blog/* https://blog.ratehunter.net/:splat 301

# Force HTTPS (Cloudflare handles this automatically, but can be explicit)
# http://* https://:splat 301!

# 404 handling - Next.js handles this, but fallback
# /* /404.html 404
