# Enhanced n8n Dockerfile with TwentyCRM Nodes
# Optimized for Nyra mortgage platform integration

FROM n8nio/n8n:latest

# Switch to root for installations
USER root

# Build arguments for community packages
ARG N8N_EXTRA_PACKAGES=""
ARG N8N_TWENTY_NODES_GIT=""

# Update package manager and install dependencies
RUN apk update && apk add --no-cache \
    python3 \
    py3-pip \
    build-base \
    curl \
    git \
    && rm -rf /var/cache/apk/*

# Install community packages via npm
RUN if [ -n "$N8N_EXTRA_PACKAGES" ]; then \
        echo "Installing community packages: $N8N_EXTRA_PACKAGES" && \
        npm install -g $N8N_EXTRA_PACKAGES; \
    fi

# Install from git if specified (alternative method)
RUN if [ -n "$N8N_TWENTY_NODES_GIT" ]; then \
        echo "Installing from git: $N8N_TWENTY_NODES_GIT" && \
        npm install -g "$N8N_TWENTY_NODES_GIT"; \
    fi

# Install additional helpful packages for mortgage workflows
RUN npm install -g \
    # Date/time utilities for mortgage calculations
    moment \
    # CSV processing for lead imports
    csv-parser \
    # JSON validation for API integrations
    jsonschema \
    # HTTP client for external API calls
    axios

# Create directories for custom workflows and data
RUN mkdir -p \
    /opt/nyra/workflows \
    /opt/nyra/templates \
    /opt/nyra/custom-nodes \
    /backups \
    && chown -R node:node /opt/nyra /backups

# Copy custom node configurations (if any)
COPY --chown=node:node ./custom-nodes/* /opt/nyra/custom-nodes/ 2>/dev/null || true

# Set up health check script
RUN echo '#!/bin/sh\ncurl -f http://localhost:5678/health || exit 1' > /usr/local/bin/health-check.sh \
    && chmod +x /usr/local/bin/health-check.sh

# Switch back to node user for security
USER node

# Set working directory
WORKDIR /home/node

# Create n8n configuration directories
RUN mkdir -p \
    .n8n/nodes \
    .n8n/custom \
    .n8n/backups

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD /usr/local/bin/health-check.sh

# Expose n8n port
EXPOSE 5678

# Default command (can be overridden)
CMD ["n8n"]
