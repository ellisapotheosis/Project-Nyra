# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# TwentyCRM
TWENTY_CRM_API_URL=http://orchestrator:3000
TWENTY_CRM_API_KEY=your-api-key

# Activepieces
ACTIVEPIECES_API_URL=http://orchestrator:3001
ACTIVEPIECES_API_KEY=your-api-key

# Nexus Router
NEXUS_ROUTER_URL=http://orchestrator:7000
NEXUS_ROUTER_API_KEY=your-api-key

# Quote API
QUOTE_API_URL=http://orchestrator:4000

# OpenClaw Gateway
OPENCLAW_GATEWAY_URL=http://orchestrator:8888

# Twilio
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1234567890

# SendGrid
SENDGRID_API_KEY=your-api-key

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/nyra

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
ENVIRONMENT=development
