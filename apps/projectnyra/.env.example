# ==============================================================================
# Project Nyra - Webapp Environment Variables
# ==============================================================================
# This file defines the standard environment variables required for the
# Project Nyra broker command center (apps/projectnyra).
# ==============================================================================

# ── CORE API ENDPOINTS ────────────────────────────────────────────────────────
# Internal CRM API (Twenty CRM Integration Boundary)
CRM_API_URL=http://crm-api:4001
CRM_API_KEY=replace-me

# Lead Ingestion API
LEAD_INGESTION_API_URL=http://lead-ingestion:8080
LEAD_INGESTION_API_KEY=replace-me

# Campaign Engine API
CAMPAIGN_ENGINE_URL=http://campaign-engine:8020

# Quote API (Deterministic Mortgage Math - Python/FastAPI)
QUOTE_API_URL=http://quote-api:7070
QUOTE_API_SECRET=replace-me

# ── OPENCLAW ASSISTANT INTEGRATION ───────────────────────────────────────────
OPENCLAW_PUBLIC_BASE_URL=http://openclaw-gateway:8001
OPENCLAW_CHAT_PATH=/v1/chat/completions
OPENCLAW_GATEWAY_TOKEN=replace-me
OPENCLAW_DEFAULT_MODEL=replace-me-local-or-router-model
NYRA_CHAT_INTERNAL_PROXY_TOKEN=replace-me
NYRA_INTERNAL_API_RATE_LIMIT=60
NYRA_INTERNAL_PROXY_EXPOSE_UPSTREAM_BODY=false

# ── NEXUS / CONTROL PLANE STATUS ─────────────────────────────────────────────
# Server-side URLs are used by /api/nexus/status. NEXT_PUBLIC URLs are browser
# launch links only and must not contain credentials.
NEXUS_ROUTER_URL=http://nexus-router:6000
NEXT_PUBLIC_NEXUS_ROUTER_URL=https://nexus-router.projectnyra.com
LITELLM_PROXY_URL=http://litellm:4000
NEXT_PUBLIC_LITELLM_URL=https://litellm.projectnyra.com
GRAFBASE_URL=http://grafbase:4000
NEXT_PUBLIC_GRAFBASE_URL=https://grafbase.projectnyra.com
GRAFANA_URL=http://grafana:3000
NEXT_PUBLIC_GRAFANA_URL=https://grafana.projectnyra.com
OPENMEMORY_MCP_URL=http://openmemory-mcp:8765
MEM0_API_URL=http://mem0:5000
MEMOS_API_URL=http://memos-api:8001
QDRANT_URL=http://qdrant:6333
NEXUS_CONFIG_APPLY_ENABLED=false
LITELLM_MASTER_KEY=replace-me

# ── PUBLIC SERVICE URLS (FRONTEND LINKS) ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://app.projectnyra.com
NEXT_PUBLIC_ACTIVEPIECES_URL=https://active.projectnyra.com
NEXT_PUBLIC_N8N_URL=https://n8n.projectnyra.com
NEXT_PUBLIC_TWENTY_URL=https://twenty.projectnyra.com
NEXT_PUBLIC_OPENMEMORY_URL=https://memory.projectnyra.com
NEXT_PUBLIC_MEM0_API_URL=https://mem0.projectnyra.com
NEXT_PUBLIC_MEMOS_API_URL=https://memos.projectnyra.com
NEXT_PUBLIC_QDRANT_URL=https://qdrant.projectnyra.com
NEXT_PUBLIC_FALKORDB_URL=https://falkordb.projectnyra.com
NEXT_PUBLIC_PAPERCLIP_URL=https://paperclip.projectnyra.com
NEXT_PUBLIC_OPENCLAW_URL=https://openclaw.projectnyra.com
# Browser-safe WebSocket hub URL for Live Radar product events. Do not put
# bearer tokens in NEXT_PUBLIC_* values; protect the hostname with Access.
NEXT_PUBLIC_NYRA_WEBSOCKET_URL=wss://events.projectnyra.com

# ── SUPABASE AUTH/BACKEND ─────────────────────────────────────────────────────
# Target: Supabase runs on Oracle VPS, Cloudflare fronts HTTPS API/auth surface.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.projectnyra.com
# Supabase now calls this the publishable key. ANON_KEY remains supported for
# compatibility with the self-hosted Oracle stack.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_JWT_SECRET=replace-me

# ── ANALYTICS ────────────────────────────────────────────────────────────────
# Browser-safe Mixpanel project token. Do not place server-side secrets here.
NEXT_PUBLIC_MIXPANEL_TOKEN=replace-me

# ── TWENTY CRM SYSTEM OF RECORD ───────────────────────────────────────────────
TWENTY_CRM_URL=https://twenty.projectnyra.com
TWENTY_CRM_API_KEY=replace-me
TWENTY_MCP_URL=http://twenty-mcp:3100
TWENTY_API_KEY=replace-me
TWENTY_ACCESS_TOKEN=replace-me
TWENTY_APP_SECRET=replace-me
TWENTY_DB_USER=twenty
TWENTY_DB_PASSWORD=replace-me
TWENTY_DB_NAME=twenty

# ── FEATURE GATES ─────────────────────────────────────────────────────────────
NYRA_ENABLE_MOCKS=false
NEXT_PUBLIC_NYRA_DEMO_AUTH=false
