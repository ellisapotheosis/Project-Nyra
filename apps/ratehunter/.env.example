# Environment Variables Template for RateHunter Landing Page
# Copy this file to .env.local for local development
# For production, set these in Cloudflare Pages dashboard

# Site Configuration
NEXT_PUBLIC_SITE_NAME="RateHunter"
NEXT_PUBLIC_SITE_URL="https://ratehunter.net"
NODE_VERSION="20"

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=ratehunter.net

# API Keys (if needed)
# API_SECRET_KEY=your-secret-key-here

# Borrower chat endpoint exposed to the browser
# Defaults to the internal proxy route if omitted
# NEXT_PUBLIC_BORROWER_CHAT_ENDPOINT=/api/openclaw/chat

# Upstream OpenClaw borrower chat service for the server-side proxy route
# Keep internal assistant services on projectnyra.com; ratehunter.net stays
# landing-only.
# OPENCLAW_BORROWER_API_URL=https://openclaw-gateway.projectnyra.com/borrower/chat
# OPENCLAW_BORROWER_API_KEY=replace-me

# Legacy borrower chat names are still read for compatibility while older
# deployments are being retired.
# NEXT_PUBLIC_BORROWER_CHAT_API_URL=https://openclaw-gateway.projectnyra.com
# BORROWER_CHAT_API_URL=https://openclaw-gateway.projectnyra.com/borrower/chat

# Lead ingest webhook used by /api/leads/ingest
# N8N_INGEST_WEBHOOK_URL=https://n8n.projectnyra.com/webhook/ratehunter-leads

# Database (if needed)
# DATABASE_URL=postgresql://user:password@localhost:5432/ratehunter

# Email/Contact Form (if using)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# CONTACT_EMAIL=contact@ratehunter.net

# Feature Flags
# ENABLE_ANALYTICS=true
# ENABLE_PWA=true
# NYRA_ENABLE_MOCKS=false

# Cloudflare Pages deployment
# CLOUDFLARE_API_TOKEN=replace-me
# CLOUDFLARE_ACCOUNT_ID=replace-me

# Development
NODE_ENV=development
