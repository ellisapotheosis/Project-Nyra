{
  "name": "ratehunter-landing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build && node scripts/prepare-cloudflare-pages-output.mjs",
    "preview": "wrangler pages dev .open-next",
    "deploy": "wrangler pages deploy .open-next",
    "deploy:production": "wrangler pages deploy .open-next --branch=main",
    "deploy:preview": "wrangler pages deploy .open-next --branch=preview",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .open-next --ignore-pattern .next --max-warnings=0",
    "test": "jest --watch",
    "test:ci": "pnpm exec jest --ci --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "cf:login": "wrangler login",
    "cf:deploy": "npm run build:cf && npm run deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.7",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-dom": "18.3.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.19.11",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^8.60.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10",
    "eslint-config-next": "16.2.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.3.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6",
    "wrangler": "^4.96.0"
  }
}
