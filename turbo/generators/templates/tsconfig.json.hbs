{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
    {{#eq type "app"}}
    ,
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
    {{/eq}}
  },
  "include": [
    "src/**/*"
    {{#eq type "app"}}
    ,
    ".next/types/**/*.ts"
    {{/eq}}
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}
