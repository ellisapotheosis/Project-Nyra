{
  "name": "@nyra/{{dashCase name}}",
  "version": "0.0.0",
  "description": "{{description}}",
  "private": true,
  {{#eq type "app"}}
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^15.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.7.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.7"
  }
  {{/eq}}
  {{#eq type "service"}}
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/main.ts --dts",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "fastify": "^4.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.0.0",
    "tsup": "^8.0.0",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0"
  }
  {{/eq}}
  {{#eq type "package"}}
  "scripts": {
    "build": "tsup src/index.ts --dts",
    "dev": "tsup src/index.ts --dts --watch",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test": "jest"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.7.0",
    "tsup": "^8.0.0",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0"
  }
  {{/eq}}
  {{#eq type "mcp-server"}}
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --dts",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "type-check": "tsc --noEmit"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.0.0",
    "tsup": "^8.0.0",
    "eslint": "^9.18.0"
  }
  {{/eq}}
  {{#eq type "tool"}}
  "scripts": {
    "start": "node index.js"
  }
  {{/eq}}
}
