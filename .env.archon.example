# Copy to .env.archon and replace REPLACE_ME_* with Infisical-provided values.

# Core data plane
POSTGRES_DB=nyra
POSTGRES_USER=nyra
POSTGRES_PASSWORD=REPLACE_ME_POSTGRES_PASSWORD
POSTGRES_PORT=5432
REDIS_PASSWORD=REPLACE_ME_REDIS_PASSWORD
REDIS_PORT=6379

# LLM routing + keys
LITELLM_MASTER_KEY=REPLACE_ME_LITELLM_MASTER_KEY
OPENROUTER_API_KEY=REPLACE_ME_OPENROUTER_API_KEY
ANTHROPIC_API_KEY=REPLACE_ME_ANTHROPIC_API_KEY
OPENAI_API_KEY=REPLACE_ME_OPENAI_API_KEY
GOOGLE_API_KEY=REPLACE_ME_GOOGLE_API_KEY
GITHUB_TOKEN=REPLACE_ME_GITHUB_TOKEN
BRAVE_API_KEY=REPLACE_ME_BRAVE_API_KEY

# Archon service ports
NEXUS_ROUTER_PORT=7000
NEXUS_MCP_PORT=8080
NEXUS_METRICS_PORT=9091
ARCHON_OS_PORT=9001
ARCHON_SERVER_PORT=8181
ARCHON_MCP_PORT=8051
ARCHON_AGENTS_PORT=8052
AGENT_WORK_ORDERS_PORT=8053
ARCHON_UI_PORT=3737

# Archon runtime mode
ARCHON_ENV=production

# Infisical integration
INFISICAL_API_URL=https://app.infisical.com
INFISICAL_ENV=prod
INFISICAL_PROJECT_ID=REPLACE_ME_INFISICAL_PROJECT_ID
INFISICAL_TOKEN=REPLACE_ME_INFISICAL_TOKEN
INFISICAL_CLIENT_ID=REPLACE_ME_INFISICAL_CLIENT_ID
INFISICAL_CLIENT_SECRET=REPLACE_ME_INFISICAL_CLIENT_SECRET
